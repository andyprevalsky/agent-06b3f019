#!/usr/bin/env bash
# Block mac-app/ edits on non-Darwin hosts — we can't build, run, or test
# the Electron app off macOS (nvm/Node 20.10.0 + Vite main-process bundle +
# electron-builder all assume mac), so commits from Linux dev envs (Cord,
# CI sandboxes) must not touch mac-app/.
if [ "$(uname)" != "Darwin" ]; then
  STAGED_MAC=$(git diff --cached --name-only --diff-filter=ACMR | grep '^mac-app/' || true)
  if [ -n "$STAGED_MAC" ]; then
    echo "❌ pre-commit: mac-app/ changes are not allowed on $(uname) (mac-only)."
    echo "   Staged mac-app files:"
    echo "$STAGED_MAC" | sed 's/^/     /'
    echo ""
    echo "   Make these changes on a macOS host where you can build and test."
    exit 1
  fi
fi
