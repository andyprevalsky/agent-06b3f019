#!/bin/bash
set -e  # Exit on any error

echo "🧪 Running pre-commit tests..."
echo ""

# =============================================================================
# 1. Backend API Tests
# =============================================================================
echo "📡 Running backend API tests..."
echo "   Make sure the backend server is running on localhost:3001"
echo ""

# Check if server is running
if ! curl -s http://localhost:3001/health > /dev/null 2>&1; then
  echo "❌ Backend server not running on localhost:3001"
  echo "   Please start the server with:"
  echo "   cd back-end && npm run dev"
  echo ""
  exit 1
fi

# Run the API test suite
cd back-end && npm run test:api

if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Backend API tests failed. Commit aborted."
  echo "   Fix the failing tests before committing."
  echo ""
  exit 1
fi

echo ""
echo "✅ Backend API tests passed!"
echo ""

# =============================================================================
# 2. Agent Tools Tests
# =============================================================================
echo "🤖 Running agent tools tests..."
echo ""

# Navigate to agents directory
cd "$(git rev-parse --show-toplevel)/agents"

# Check if virtual environment exists
if [ ! -d "venv" ]; then
    echo "❌ Virtual environment not found at agents/venv"
    echo "   Create it with: cd agents && python -m venv venv && source venv/bin/activate && pip install -r requirements.txt"
    exit 1
fi

# Activate virtual environment
source venv/bin/activate

# Check if required dependencies are installed
if ! python -c "import openai" 2>/dev/null; then
    echo "❌ Required dependencies not installed"
    echo "   Install with: pip install -r requirements.txt"
    exit 1
fi

# Run the test suite
cd tests
if python run_all_tests.py; then
    echo ""
    echo "✅ Agent tools tests passed!"
    echo ""
else
    echo ""
    echo "❌ Agent tools tests failed. Commit aborted."
    echo "   Fix the failing tests before committing."
    echo ""
    exit 1
fi

# =============================================================================
# All Tests Passed!
# =============================================================================
echo "🎉 All tests passed! Proceeding with commit..."
echo ""
