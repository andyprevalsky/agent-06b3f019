generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Agent {
  id                        String          @id @default(uuid())
  userId                    String
  goal                      String
  progress                  Float           @default(0.0)
  status                    AgentStatus     @default(STARTING_UP)
  statusMessage             String?
  deletedAt                 DateTime?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  temporalWorkflowId        String?
  model                     String          @default("rose-labs/rose-1-ultra")
  contextSize               Int             @default(0)
  messageCount              Int             @default(0)
  tokenCount                Int             @default(0)
  tokensIn                  Int             @default(0)
  tokensOut                 Int             @default(0)
  parentAgentId             String?
  tokenInPriceMicrodollars  Int?
  tokenOutPriceMicrodollars Int?
  source                    AgentSource     @default(WEB)
  depth                     Int             @default(0)
  parentWorkflowId          String?
  reasoningMaxTokens        Int             @default(2048)
  responseSchema            Json?
  busId                     String?
  toolsInUse                String[]        @default([])
  structuredResponse        Json?
  proxyCity                 String?
  proxyCountry              String?
  proxyState                String?
  priceLimitCents           Int             @default(100)
  treeCostCents             Int             @default(0)
  ownCostCents              Float           @default(0)
  writeLockEnabled          Boolean         @default(true)
  fastModeCacheEnabled      Boolean         @default(false)
  isBenchmark               Boolean         @default(false)
  githubRepoUrl             String?
  parent                    Agent?          @relation("AgentHierarchy", fields: [parentAgentId], references: [id])
  children                  Agent[]         @relation("AgentHierarchy")
  tools                     AgentTool[]
  messages                  Message[]
  toolUsages                ToolUsage[]
  purchaseSpends            PurchaseSpend[]
  verifier                  Verifier?

  @@index([userId, deletedAt])
  @@index([createdAt])
  @@index([temporalWorkflowId])
  @@index([parentAgentId])
  @@index([parentAgentId, createdAt])
  @@index([busId])
}

model Tool {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  createdAt   DateTime    @default(now())
  agents      AgentTool[]
}

// Fast Mode aggressive cache. Record/replay store for third-party responses so a
// slow real run can be replayed instantly. Entries live forever (no TTL); re-record
// is a manual purge by goalHash. Writes only happen when Fast Mode is enabled.
// `value` holds JSON (LLM responses, search/fetch results, browser response metadata);
// `blobPath` references a Supabase storage object for large binary bodies.
model FastModeCacheEntry {
  key       String   @id
  kind      String // llm | browser_use | browser_http | web_search | web_fetch | file | anthropic | codex
  goalHash  String
  value     Json?
  blobPath  String?
  createdAt DateTime @default(now())

  @@index([goalHash])
  @@index([kind])
}

model AgentTool {
  agentId    String
  toolId     String
  assignedAt DateTime @default(now())
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tool       Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@id([agentId, toolId])
  @@index([agentId])
  @@index([toolId])
}

model Verifier {
  id        String       @id @default(uuid())
  agentId   String       @unique
  type      VerifierType @default(FLOAT_LLM_JUDGE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  agent     Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model Message {
  id          String      @id @default(uuid())
  agentId     String
  timestamp   DateTime    @default(now())
  text        String
  role        MessageRole
  createdAt   DateTime    @default(now())
  metadata    Json?
  filePointer Json?
  agent       Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, timestamp])
  @@index([createdAt])
}

model Waitlist {
  id           String    @id @default(uuid())
  name         String    @default("")
  email        String?   @unique
  phone        String?   @unique
  variant      String?
  referralCode String?   @map("referral_code")
  createdAt    DateTime  @default(now()) @map("created_at")
  invitedAt    DateTime? @map("invited_at")

  @@index([createdAt])
  @@index([email])
}

model GoalBlueprint {
  id        String   @id @default(uuid())
  userId    String
  title     String
  blueprint Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  embedding Json?
  metadata  Json?

  @@index([userId])
  @@index([createdAt])
}

model AgentAttentionRequest {
  id             String                     @id @default(cuid())
  userId         String
  agentId        String
  workflowId     String
  question       String
  userResponse   String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  imageUrl       String?
  metadata       Json?
  // Dedup identity for Gate requests (the Gate object rides in metadata.gate).
  // Multiple agents that hit the same gate collapse onto one PENDING
  // (userResponse IS NULL) request. A partial unique index in the migration
  // enforces this. See docs/plans/active/sms-onboarding-and-gates.md.
  gateKey        String?
  authAssistance UserAuthAssistanceRequest?

  @@index([updatedAt])
  @@index([userId])
  @@index([workflowId])
  @@index([userId, gateKey])
}

model ModelPricingCache {
  modelId                   String   @id
  tokenInPriceMicrodollars  Int
  tokenOutPriceMicrodollars Int
  cachedAt                  DateTime @default(now())
  expiresAt                 DateTime

  @@index([expiresAt])
}

model ToolUsage {
  id             String   @id @default(uuid())
  agentId        String?
  toolName       String
  totalCostCents Int
  usageItems     Json
  createdAt      DateTime @default(now())
  userId         String
  agent          Agent?   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([agentId])
  @@index([createdAt])
  @@index([toolName])
}

model ToolSideEffect {
  id            String   @id @default(uuid())
  operationKey  String   @unique
  operationType String
  status        String   @default("STARTED")
  externalId    String?
  request       Json?
  response      Json?
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([operationType])
  @@index([status])
  @@index([externalId])
}

model User {
  id                          String                      @id @default(uuid())
  userId                      String                      @unique
  name                        String?
  email                       String?
  addressLine1                String?
  addressLine2                String?
  city                        String?
  state                       String?
  postalCode                  String?
  country                     String?                     @default("United States")
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  inviteCode                  Int?                        @unique
  inviteCodeUses              Int                         @default(0)
  usedInviteCode              Int?
  offWaitlistAt               DateTime?
  encryptedPaymentInformation String?
  phone                       String?
  isAnonymous                 Boolean                     @default(false)
  onboardingCompletedAt       DateTime?
  imessageBridgeLastSeenAt    DateTime?
  systemName                  String?
  profilePicture              String?
  customSystemPrompt          String?
  voicePreferenceId           String?
  credits                     Credit[]
  subscriptions               Subscription?
  cookieBundles               CookieBundle[]
  steelSessionAuths           SteelSessionAuth[]
  mintedAccounts              MintedAccount[]
  passkeyCredentials          PasskeyCredential[]
  agentIdentity               AgentIdentity?
  agentPhoneMessages          AgentPhoneMessage[]
  authAssistanceRequests      UserAuthAssistanceRequest[]
  purchaseSpends              PurchaseSpend[]
  dataDocuments               UserDataDocument[]
  dataProviderSyncStates      UserDataProviderSyncState[]
  userSnapshot                UserSnapshot?
  userSnapshotRevisions       UserSnapshotRevision[]

  @@index([userId])
  @@index([inviteCode])
  @@index([usedInviteCode])
  @@index([isAnonymous])
}

model Credit {
  id             String    @id @default(uuid())
  userId         String
  amountCents    Int
  expirationDate DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([expirationDate])
}

model Subscription {
  id                   String   @id @default(uuid())
  userId               String   @unique
  subscriptionTier     Int
  stripeSubscriptionId String   @unique
  stripeCustomerId     String
  currentPeriodEnd     DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([stripeSubscriptionId])
}

model PurchaseSpend {
  id                    String                 @id @default(uuid())
  userId                String
  agentId               String?
  fingerprint           String
  canonicalFingerprint  String?
  cardId                String?
  merchant              String
  lineItemsJson         Json
  totalCents            Int
  status                PurchaseSpendStatus    @default(PENDING_APPROVAL)
  stripePaymentIntentId String?
  provider              String                 @default("agentcard")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  user                  User                   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  agent                 Agent?                 @relation(fields: [agentId], references: [id], onDelete: SetNull)
  walletFunding         PurchaseWalletFunding?

  // NOT unique: a user may legitimately re-buy the same cart. Idempotency for in-flight retries
  // is enforced in application logic (status checks + a Stripe idempotency key per purchase row)
  // plus the 24h reuse window — not a DB constraint.
  @@index([userId, fingerprint])
  @@index([userId, canonicalFingerprint])
  @@index([agentId])
  @@index([cardId])
  @@index([status])
  @@index([createdAt])
}

// Wallet-funding ledger for AgentCard purchases: tracks moving funds into the
// virtual card wallet and reclaiming them, with idempotency keys so Temporal
// retries don't double-fund/double-reclaim. One row per PurchaseSpend.
// (Baselined from prod on 2026-07-06 — the table pre-existed in prod with no
// committed schema/migration.)
model PurchaseWalletFunding {
  id                        String                      @id @default(uuid())
  purchaseId                String                      @unique
  userId                    String
  agentId                   String?
  provider                  String                      @default("agentcard")
  amountCents               Int
  currency                  String                      @default("usd")
  status                    PurchaseWalletFundingStatus @default(PENDING)
  providerTransferId        String?
  reclaimProviderTransferId String?
  idempotencyKey            String                      @unique
  reclaimIdempotencyKey     String?
  metadata                  Json?
  errorMessage              String?
  fundedAt                  DateTime?
  consumedAt                DateTime?
  reclaimedAt               DateTime?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  purchase                  PurchaseSpend               @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([status, createdAt])
  @@index([userId, status])
}

model BrowserContext {
  id               String                   @id @default(uuid())
  userId           String                   @unique
  contextId        String?                  @unique
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  sessions         BrowserSession[]
  providerProfiles BrowserProviderProfile[]

  @@index([userId])
  @@index([contextId])
}

model BrowserProviderProfile {
  id        String         @id @default(uuid())
  contextId String
  provider  String
  profileId String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  context   BrowserContext @relation(fields: [contextId], references: [id], onDelete: Cascade)

  @@unique([contextId, provider])
  @@unique([provider, profileId])
  @@index([contextId])
}

model BrowserProviderProxy {
  id        String   @id @default(uuid())
  provider  String
  proxyKey  String
  proxyId   String
  proxyType String
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, proxyKey])
  @@unique([provider, proxyId])
  @@index([provider])
}

model BrowserSession {
  id                    String               @id @default(uuid())
  contextId             String
  agentId               String
  sessionId             String               @unique
  status                BrowserSessionStatus @default(ACTIVE)
  debugUrl              String?
  startUrl              String?
  currentUrl            String?
  createdAt             DateTime             @default(now())
  closedAt              DateTime?
  wsUrl                 String?
  provider              String               @default("steel")
  injectedOrigins       Json?
  controlState          BrowserControlState  @default(AGENT)
  controlLeaseExpiresAt DateTime?
  // Model-driven IP rotation (rotate_ip tool). Count + current tier are keyed to
  // this stable row id (the browser sub-agent run), surviving session recycles so
  // the cap is authoritative across rotations. proxyTier: null → original session,
  // 'residential' | 'mobile' after a rotation. See docs/plans/active/rotate-ip-tool.md.
  proxyRotationCount    Int                  @default(0)
  proxyTier             String?
  context               BrowserContext       @relation(fields: [contextId], references: [id], onDelete: Cascade)

  @@index([contextId])
  @@index([agentId])
  @@index([sessionId])
  @@index([status])
}

model ClaudeCodeSession {
  id                       String                  @id @default(uuid())
  agentId                  String
  sandboxId                String                  @unique
  streamUrl                String?
  goal                     String
  status                   ClaudeCodeSessionStatus @default(ACTIVE)
  output                   String?
  createdAt                DateTime                @default(now())
  closedAt                 DateTime?
  // Credential tracking — set when the CLI is started with per-user/pool OAuth
  // credentials so closeClaudeCodeSession() can mark the right Integration as
  // rate-limited if the CLI output reports "You've hit your limit · resets X:XX (UTC)".
  claudeTokenSource        String?
  claudeTokenIntegrationId String?

  @@index([agentId])
  @@index([sandboxId])
  @@index([status])
}

model GithubRepoAccess {
  id        String   @id @default(uuid())
  userId    String
  repoUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, repoUrl])
  @@index([userId])
}

model MessageRecord {
  id         String         @id @default(uuid())
  personId   String
  channel    MessageChannel
  from       String
  to         String
  timestamp  DateTime
  message    String
  externalId String? // Platform-native message ID (Telegram msg.id, iMessage ROWID, WhatsApp key.id)
  createdAt  DateTime       @default(now())
  person     Person         @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, channel, externalId]) // Primary dedup: same message can't be inserted twice
  @@index([personId, channel])
  @@index([timestamp])
  @@index([personId, timestamp])
  @@index([channel, timestamp]) // Recent-inbound OTP relay: channel filter + time window
}

model Person {
  id                         String          @id @default(uuid())
  userId                     String
  firstName                  String
  lastName                   String
  age                        Int?
  location                   String?
  profession                 String?
  company                    String?
  title                      String?
  industry                   String?
  email                      String?
  phoneNumber                String?
  linkedinUrl                String?
  instagramHandle            String?
  facebookUrl                String?
  twitterHandle              String?
  embedding                  Json?
  emailAddresses             Json?           @default("[]")
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt
  communicationFrequency     String?
  contactStatus              String?
  currentBandwidth           String?
  estimatedNetWorthUsd       Float?
  estimatedWorldPowerRanking Int?
  interests                  Json?           @default("[]")
  networkOrientation         String?
  notes                      String?
  relation                   String?
  relationshipQuality        String?
  skills                     Json?           @default("[]")
  totalOnlineReach           Int?
  messagesExchanged          Int             @default(0)
  messageRecords             MessageRecord[]

  @@unique([userId, phoneNumber])
  @@index([userId])
  @@index([firstName])
  @@index([lastName])
  @@index([email])
  @@index([phoneNumber])
  @@index([profession])
  @@index([company])
  @@index([relation])
  @@index([communicationFrequency])
  @@index([currentBandwidth])
}

model Integration {
  id                   String                       @id @default(uuid())
  userId               String
  type                 IntegrationType
  name                 String
  status               IntegrationStatus            @default(NOT_CONNECTED)
  isActive             Boolean                      @default(false)
  lastSyncAt           DateTime?
  lastSuccessfulSyncAt DateTime?
  lastFailedSyncAt     DateTime?
  failureReason        String?
  config               Json?
  poolingEnabled       Boolean                      @default(false)
  rateLimitedUntil     DateTime?
  lastUsedAt           DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  emailCredentials     EmailIntegrationCredential[]
  plaidItems           PlaidItem[]

  @@unique([userId, name])
  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([poolingEnabled, rateLimitedUntil])
}

model ComputeTokenLineageLease {
  lineageKey    String    @id
  tokenType     String
  tokenSource   String
  tokenIdentity String
  userId        String?
  agentId       String?
  rootAgentId   String?
  assignedAt    DateTime  @default(now())
  lastUsedAt    DateTime  @default(now())
  releasedAt    DateTime?

  @@index([tokenType, tokenSource, tokenIdentity, releasedAt, lastUsedAt])
  @@index([agentId])
  @@index([rootAgentId])
}

model ComputeTokenFastCacheAffinity {
  affinityKey String   @id
  tokenType   String
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tokenType])
  @@index([userId])
}

model UserDataDocument {
  id              String                 @id @default(uuid())
  userId          String
  source          String
  externalId      String
  title           String
  content         String
  url             String?
  metadata        Json?                  @default("{}")
  contentHash     String
  sourceUpdatedAt DateTime?
  lastSeenAt      DateTime               @default(now())
  deletedAt       DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  user            User                   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  snapshotUpdates UserSnapshotRevision[]

  @@unique([userId, source, externalId])
  @@index([userId, source])
  @@index([userId, updatedAt])
  @@index([userId, source, deletedAt])
}

model UserDataProviderSyncState {
  id                   String    @id @default(uuid())
  userId               String
  source               String
  status               String    @default("NOT_CONNECTED")
  config               Json?     @default("{}")
  cursor               Json?     @default("{}")
  lastStartedAt        DateTime?
  lastSuccessfulSyncAt DateTime?
  lastError            String?
  nextSyncAt           DateTime?
  realtimeEnabled      Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, source])
  @@index([userId, status])
  @@index([nextSyncAt])
}

model UserSnapshot {
  id        String                 @id @default(uuid())
  userId    String                 @unique
  content   Json                   @default("{}")
  version   Int                    @default(1)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  user      User                   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  revisions UserSnapshotRevision[]

  @@index([userId])
}

model UserSnapshotRevision {
  id         String            @id @default(uuid())
  userId     String
  snapshotId String
  documentId String?
  source     String
  before     Json              @default("{}")
  after      Json              @default("{}")
  changes    Json?             @default("{}")
  model      String?
  promptKey  String?
  createdAt  DateTime          @default(now())
  user       User              @relation(fields: [userId], references: [userId], onDelete: Cascade)
  snapshot   UserSnapshot      @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  document   UserDataDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([snapshotId])
  @@index([documentId])
  @@index([source])
}

model EmailIntegrationCredential {
  id            String        @id @default(uuid())
  userId        String
  integrationId String
  provider      EmailProvider
  pkceVerifier  String?
  stateToken    String?
  accessToken   String?
  refreshToken  String?
  expiresAt     DateTime?
  scopes        String[]      @default([])
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  email         String?
  integration   Integration   @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, email])
  @@index([integrationId])
  @@index([userId, provider])
}

/// Plaid Item: one connected financial institution per user.
/// Holds the encrypted long-lived access token issued by Plaid after
/// successful Link exchange.
model PlaidItem {
  id                   String             @id @default(uuid())
  userId               String
  integrationId        String
  plaidItemId          String             @unique
  plaidInstitutionId   String?
  institutionName      String?
  /// Base64-encoded RSA-2048 + AES-256-GCM envelope wrapping the Plaid
  /// access_token. Encrypted on the backend at write time; decrypted only
  /// at the moment of a Plaid API call. See providers/plaidCredentials.ts.
  encryptedAccessToken String
  status               PlaidItemStatus    @default(ACTIVE)
  products             String[]           @default([])
  cursor               String?
  lastSyncAt           DateTime?
  lastWebhookAt        DateTime?
  errorCode            String?
  errorMessage         String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  disconnectedAt       DateTime?
  integration          Integration        @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  accounts             PlaidAccount[]
  transactions         PlaidTransaction[]

  @@index([userId])
  @@index([userId, status])
  @@index([integrationId])
}

/// Plaid Account: per-account metadata exposed by Plaid for a given Item.
/// Holds no balances or transactions; those are fetched on demand and not
/// persisted by this table.
model PlaidAccount {
  id                 String             @id @default(uuid())
  userId             String
  plaidItemId        String
  plaidAccountId     String             @unique
  name               String
  officialName       String?
  mask               String?
  type               String
  subtype            String?
  verificationStatus String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  disconnectedAt     DateTime?
  plaidItem          PlaidItem          @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)
  transactions       PlaidTransaction[]

  @@index([userId])
  @@index([plaidItemId])
}

/// Plaid Transaction: normalized, searchable transaction data from Plaid
/// Transactions Sync. Stores no raw Plaid payload.
model PlaidTransaction {
  id                      String               @id @default(uuid())
  userId                  String
  plaidItemId             String
  plaidAccountId          String
  plaidTransactionId      String               @unique
  plaidAccountExternalId  String
  date                    DateTime
  authorizedDate          DateTime?
  datetime                DateTime?
  authorizedDatetime      DateTime?
  name                    String
  merchantName            String?
  originalDescription     String?
  amount                  Decimal              @db.Decimal(18, 4)
  absoluteAmount          Decimal              @db.Decimal(18, 4)
  direction               TransactionDirection
  isoCurrencyCode         String?
  unofficialCurrencyCode  String?
  category                String[]             @default([])
  categoryId              String?
  personalFinanceCategory String?
  personalFinanceDetailed String?
  paymentChannel          String?
  locationSummary         String?
  pending                 Boolean              @default(false)
  pendingTransactionId    String?
  accountOwner            String?
  checkNumber             String?
  removedAt               DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  plaidItem               PlaidItem            @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)
  plaidAccount            PlaidAccount         @relation(fields: [plaidAccountId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, pending])
  @@index([userId, removedAt])
  @@index([plaidItemId])
  @@index([plaidAccountId])
  @@index([plaidAccountExternalId])
}

model RoseApiKey {
  id        String          @id @default(uuid())
  userId    String
  apiKey    String          @unique
  name      String?
  createdAt DateTime        @default(now())
  logs      RoseApiKeyLog[]

  @@index([userId])
  @@index([apiKey])
}

model RoseApiKeyLog {
  id        String     @id @default(uuid())
  apiKeyId  String
  userId    String
  input     Json
  output    Json
  costCents Int
  cotSteps  Int        @default(1)
  createdAt DateTime   @default(now())
  apiKey    RoseApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId])
  @@index([userId])
  @@index([createdAt])
}

model BenchmarkRun {
  id               String   @id @default(uuid())
  userId           String
  benchmarkName    String
  modelConfig      Json
  results          Json
  aggregateScore   Float
  totalCostCents   Int
  sampledQuestions Int
  durationSeconds  Int
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([benchmarkName])
  @@index([createdAt])
}

// Benchmark task definitions (the eval catalog). Source of truth for the
// in-app Benchmark Hub: seeded from agents/benchmarks/tasks.json at boot
// (insert-missing only), edited via the hub UI, and exported back to
// tasks.json by the hub run poller before dispatched runs so runners execute
// exactly what this table says.
model BenchmarkTask {
  name            String   @id
  title           String?
  prompt          String
  status          String? // ready | incomplete | null (legacy pre-eval-contract)
  bench           String? // rose-bench | pipeline-e2e
  runner          String?
  tags            String[] @default([])
  timeoutSeconds  Int?
  priceLimitCents Int?
  expectedTools   String[] @default([])
  minAgentCount   Int?
  isChatMode      Boolean  @default(false)
  environment     Json?
  evaluators      Json?
  source          Json?
  // Full original task object; forward-compat for runner-only fields the
  // hub does not model as columns (expected_tool_counts, attachment, ...).
  definition      Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedBy       String?

  @@index([bench])
  @@index([status])
}

// A hub-dispatched benchmark run: created by the UI, claimed and executed by
// the controller-side poller (scripts/run-bench-hub-poller), which streams
// progress back and links the uploaded run bundle when finished. Claiming is
// an atomic queued→running UPDATE so two pollers can never double-run.
model BenchmarkRunRequest {
  id          String    @id @default(uuid())
  taskNames   String[]
  simOn       String[]  @default([])
  status      String    @default("queued") // queued | running | completed | failed | cancelled
  // Claim scope: pollers only claim requests matching their scope. Unscoped
  // (null) = normal user dispatches, claimed by the default stack poller.
  // Tests dispatch with a private scope so they never race real pollers.
  scope       String?
  requestedBy String
  claimedBy   String? // poller identity (host:pid)
  claimedAt   DateTime?
  progress    Json? // latest report-card-ish snapshot from the poller
  runId       String? // hub run id once uploaded
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
}

