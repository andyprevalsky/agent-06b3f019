/// A connected provider account: the DURABLE identity a user links once.
///
/// This is the layer that replaces credential syncing. It holds the account
/// SESSION (e.g. claude.ai cookies), which is what mints compute grants -- so a
/// dead grant can never block its own replacement. It is also the only
/// user-visible state: `needs_reconnect` is what turns the FE chip amber.
///
/// The unique key is (userId, provider, accountId), mirroring
/// EmailIntegrationCredential's (userId, provider, email). That is deliberately
/// NOT (userId, provider): keying on the provider alone is exactly what limited
/// users to one Claude and one Codex account.
model ComputeAccountConnection {
  id                     String    @id @default(uuid())
  userId                 String
  /// "claude" | "codex"
  provider               String
  /// Provider-side account identifier (Anthropic account uuid / ChatGPT account_id).
  accountId              String
  /// Shown on the FE chip.
  accountEmail           String?
  /// RSA+AES envelope wrapping the account session (cookies). Never a token.
  encryptedSession       String?
  /// "connected" | "needs_reconnect"
  state                  String    @default("connected")
  /// When the underlying session expires (~28d for claude.ai, observed).
  sessionExpiresAt       DateTime?
  /// Why the connection was last marked unhealthy, for the chip tooltip.
  lastErrorReason        String?
  /// Mirrors Integration.poolingEnabled so grants minted from this account can
  /// serve the shared pool. Inherited from the user's existing compute
  /// integrations at connect time -- a user who already pools should not have to
  /// re-enable it per account.
  poolingEnabled         Boolean   @default(false)
  /// Explicit user choice, which beats the inherited default in both directions.
  poolingEnabledOverride Boolean?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  grants ComputeGrant[]

  @@unique([userId, provider, accountId])
  @@index([userId, provider])
  @@index([state])
}

/// A single compute grant: a DISPOSABLE lease derived from a connection.
///
/// Grants are minted freely and never shared between surfaces -- proven
/// necessary for both providers: a Claude refresh is single-use and revokes the
/// prior access token, and forked Codex lineages die within hours with
/// `refresh_token_reused`. Each surface therefore gets its own grant, and
/// recovery means minting a new one rather than repairing an old one.
///
/// There is intentionally NO unique constraint scoping grants per user or
/// provider: many accounts per user, and many grants over time per account
/// (history is kept so a revocation can be traced). "Exactly one active grant
/// per surface" is enforced transactionally in the repo layer, not by a
/// constraint, because Prisma cannot express a partial unique index.
model ComputeGrant {
  id                   String    @id @default(uuid())
  connectionId         String
  userId               String
  provider             String
  accountId            String
  /// Which surface owns this grant -- "cloud" | "local" | "sandbox".
  surface              String    @default("cloud")
  /// "setup_token" (Claude, 1y, no refresh) | "oauth_refresh" (Codex).
  grantType            String
  /// RSA+AES envelope wrapping the token material.
  encryptedCredentials String
  /// "active" | "dead"
  status               String    @default("active")
  /// Provider's reason when the grant was revoked, from the completion path.
  deadReason           String?
  /// Provider's own cooldown for THIS token. A rate limit is not death: the
  /// grant stays active and simply becomes unselectable until this passes, which
  /// is what stops a 429 from being mistaken for revocation and burning a mint.
  rateLimitedUntil     DateTime?
  /// Nominal expiry. A HINT only -- liveness is decided by real traffic, since
  /// setup-tokens have been observed dying well before their stated lifetime.
  expiresAt            DateTime?
  lastUsedAt           DateTime?
  mintedAt             DateTime  @default(now())
  diedAt               DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  connection ComputeAccountConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([userId, provider, status])
  @@index([status, rateLimitedUntil])
  @@index([connectionId, status])
  @@index([accountId])
  @@index([status, expiresAt])
}

