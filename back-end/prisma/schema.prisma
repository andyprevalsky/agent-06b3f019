  expiresUtc      BigInt?
  isSecure        Boolean  @default(false)
  isHttpOnly      Boolean  @default(false)
  browserSource   String
  syncedAt        DateTime @default(now()) @updatedAt
  creationUtc     BigInt?
  hasExpires      Boolean  @default(true)
  isPersistent    Boolean  @default(true)
  lastAccessUtc   BigInt?
  lastUpdateUtc   BigInt?
  priority        Int      @default(1)
  sameSite        Int      @default(-1)
  sourcePort      Int      @default(-1)
  sourceScheme    Int      @default(0)
  topFrameSiteKey String   @default("")
  browserProfile  String   @default("")

  @@unique([userId, domain, name, path, topFrameSiteKey, browserSource, browserProfile])
  @@index([userId])
  @@index([userId, domain])
  @@index([userId, browserSource, browserProfile])
}

