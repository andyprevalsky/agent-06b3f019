  poolingEnabled         Boolean                      @default(false)
  poolingEnabledOverride Boolean?
  rateLimitedUntil       DateTime?
  lastUsedAt             DateTime?
  /// Provider-side account identifier, so ONE user can hold several accounts of
  /// the same `name` (two Claude subscriptions, two ChatGPT ones). Legacy rows
  /// keep "" — which preserves their old (userId, name) uniqueness exactly.
  ///
  /// This column is what lifts the single-account limit WITHOUT touching the
  /// read path: `fetchComputeTokenForUser` and pooling keep querying by `name`
  /// and simply see more rows.
  accountId              String                       @default("")
  /// Shown on the FE chip.
