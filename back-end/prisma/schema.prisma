generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Agent {
  id                        String      @id @default(uuid())
  userId                    String
  goal                      String
  progress                  Float       @default(0.0)
  status                    AgentStatus @default(STARTING_UP)
  statusMessage             String?
  deletedAt                 DateTime?
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt
  temporalWorkflowId        String?
  model                     String      @default("rose-labs/rose-1-lite")
  contextSize               Int         @default(0)
  messageCount              Int         @default(0)
  tokenCount                Int         @default(0)
  tokensIn                  Int         @default(0)
  tokensOut                 Int         @default(0)
  parentAgentId             String?
  tokenInPriceMicrodollars  Int?
  tokenOutPriceMicrodollars Int?
  source                    AgentSource @default(WEB)
  depth                     Int         @default(0)
  parentWorkflowId          String?
  reasoningMaxTokens        Int         @default(2048)
  responseSchema            Json?
  structuredResponse        Json?
  busId                     String?
  toolsInUse                String[]    @default([])
  proxyCountry              String?     // Proxy geolocation from client IP (e.g., "US")
  proxyState                String?     // State abbreviation (e.g., "TX")
  proxyCity                 String?     // City name uppercase (e.g., "DALLAS")
  priceLimitCents           Int         @default(100)  // Price limit in cents (100 = $1.00)
  treeCostCents             Int         @default(0)   // Total subtree cost (own + all descendants)
  parent                    Agent?      @relation("AgentHierarchy", fields: [parentAgentId], references: [id])
  children                  Agent[]     @relation("AgentHierarchy")
  tools                     AgentTool[]
  messages                  Message[]
  toolUsages                ToolUsage[]
  verifier                  Verifier?

  @@index([userId, deletedAt])
  @@index([createdAt])
  @@index([temporalWorkflowId])
  @@index([parentAgentId])
  @@index([busId])
}

model Tool {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  createdAt   DateTime    @default(now())
  agents      AgentTool[]
}

model AgentTool {
  agentId    String
  toolId     String
  assignedAt DateTime @default(now())
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tool       Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@id([agentId, toolId])
  @@index([agentId])
  @@index([toolId])
}

model Verifier {
  id             String       @id @default(uuid())
  agentId        String       @unique
  type           VerifierType @default(FLOAT_LLM_JUDGE)
  llmJudgePrompt String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  agent          Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model Message {
  id          String      @id @default(uuid())
  agentId     String
  timestamp   DateTime    @default(now())
  text        String
  role        MessageRole
  createdAt   DateTime    @default(now())
  metadata    Json?
  filePointer Json?       // FilePointer for file attachment messages (stored in Supabase Storage)
  agent       Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, timestamp])
  @@index([createdAt])
}

model Waitlist {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  variant      String?
  referralCode String?  @map("referral_code")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([email])
}

model GoalBlueprint {
  id        String   @id @default(uuid())
  userId    String
  title     String
  blueprint Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  embedding Json?
  metadata  Json?

  @@index([userId])
  @@index([createdAt])
}

model AgentAttentionRequest {
  id           String   @id @default(cuid())
  userId       String
  agentId      String
  workflowId   String
  question     String
  userResponse String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  imageUrl     String?
  metadata     Json?

  @@index([updatedAt])
  @@index([userId])
  @@index([workflowId])
}

model ModelPricingCache {
  modelId                   String   @id
  tokenInPriceMicrodollars  Int
  tokenOutPriceMicrodollars Int
  cachedAt                  DateTime @default(now())
  expiresAt                 DateTime

  @@index([expiresAt])
}

model ToolUsage {
  id             String   @id @default(uuid())
  agentId        String?
  toolName       String
  totalCostCents Int
  usageItems     Json
  createdAt      DateTime @default(now())
  userId         String
  agent          Agent?   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([agentId])
  @@index([createdAt])
  @@index([toolName])
}

model User {
  id                          String        @id @default(uuid())
  userId                      String        @unique
  name                        String?
  addressLine1                String?
  addressLine2                String?
  city                        String?
  state                       String?
  postalCode                  String?
  country                     String?       @default("United States")
  createdAt                   DateTime      @default(now())
  updatedAt                   DateTime      @updatedAt
  inviteCode                  Int?          @unique
  inviteCodeUses              Int           @default(0)
  usedInviteCode              Int?
  encryptedPaymentInformation String?
  phone                       String?
  // Anonymous user field - tracks if user was created via Supabase signInAnonymously
  isAnonymous                 Boolean       @default(false)
  // Mac-app onboarding completion timestamp (null = not completed)
  onboardingCompletedAt       DateTime?
  credits                     Credit[]
  subscriptions               Subscription?

  @@index([userId])
  @@index([inviteCode])
  @@index([usedInviteCode])
  @@index([isAnonymous])
}

model Credit {
  id             String    @id @default(uuid())
  userId         String
  amountCents    Int
  expirationDate DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([expirationDate])
}

model Subscription {
  id                   String   @id @default(uuid())
  userId               String   @unique
  subscriptionTier     Int
  stripeSubscriptionId String   @unique
  stripeCustomerId     String
  currentPeriodEnd     DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([stripeSubscriptionId])
}

model BrowserContext {
  id        String           @id @default(uuid())
  userId    String           @unique
  contextId String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  sessions  BrowserSession[]

  @@index([userId])
  @@index([contextId])
}

model BrowserSession {
  id              String               @id @default(uuid())
  contextId       String
  agentId         String
  sessionId       String               @unique
  status          BrowserSessionStatus @default(ACTIVE)
  debugUrl        String?
  wsUrl           String?              // CDP WebSocket URL for browser-use
  currentUrl      String?
  injectedOrigins Json?                // Map of origin -> hash for localStorage injection tracking
  createdAt       DateTime             @default(now())
  closedAt        DateTime?
  context         BrowserContext       @relation(fields: [contextId], references: [id], onDelete: Cascade)

  @@index([contextId])
  @@index([agentId])
  @@index([sessionId])
  @@index([status])
}

model ClaudeCodeSession {
  id        String                  @id @default(uuid())
  agentId   String
  sandboxId String                  @unique
  streamUrl String?
  goal      String
  status    ClaudeCodeSessionStatus @default(ACTIVE)
  output    String?                 @db.Text // Full terminal output buffer, persisted on clean shutdown
  createdAt DateTime                @default(now())
  closedAt  DateTime?

  @@index([agentId])
  @@index([sandboxId])
  @@index([status])
}

model GithubRepoAccess {
  id        String   @id @default(uuid())
  userId    String
  repoUrl   String   // Full GitHub URL e.g. "https://github.com/org/repo"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, repoUrl])
  @@index([userId])
}

model MessageRecord {
  id        String         @id @default(uuid())
  personId  String
  channel   MessageChannel
  from      String
  to        String
  timestamp DateTime
  message   String
  createdAt DateTime       @default(now())
  person    Person         @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, channel])
  @@index([timestamp])
  @@index([personId, timestamp])
}

model Person {
  id                         String          @id @default(uuid())
  userId                     String
  firstName                  String
  lastName                   String
  age                        Int?
  location                   String?
  profession                 String?
  company                    String?
  title                      String?
  industry                   String?
  email                      String?
  phoneNumber                String?
  linkedinUrl                String?
  instagramHandle            String?
  facebookUrl                String?
  twitterHandle              String?
  embedding                  Json?
  emailAddresses             Json?           @default("[]")
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt
  communicationFrequency     String?
  contactStatus              String?
  currentBandwidth           String?
  estimatedNetWorthUsd       Float?
  estimatedWorldPowerRanking Int?
  interests                  Json?           @default("[]")
  networkOrientation         String?
  notes                      String?
  relation                   String?
  relationshipQuality        String?
  skills                     Json?           @default("[]")
  totalOnlineReach           Int?
  messagesExchanged          Int             @default(0)
  messageRecords             MessageRecord[]

  @@unique([userId, phoneNumber])
  @@index([userId])
  @@index([firstName])
  @@index([lastName])
  @@index([email])
  @@index([phoneNumber])
  @@index([profession])
  @@index([company])
  @@index([relation])
  @@index([communicationFrequency])
  @@index([currentBandwidth])
}

model Integration {
  id                   String                       @id @default(uuid())
  userId               String
  type                 IntegrationType
  name                 String
  status               IntegrationStatus            @default(NOT_CONNECTED)
  isActive             Boolean                      @default(false)
  lastSyncAt           DateTime?
  lastSuccessfulSyncAt DateTime?
  lastFailedSyncAt     DateTime?
  failureReason        String?
  config               Json?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  emailCredentials     EmailIntegrationCredential[]

  @@unique([userId, name])
  @@index([userId])
  @@index([type])
  @@index([status])
}

model EmailIntegrationCredential {
  id            String        @id @default(uuid())
  userId        String
  integrationId String
  provider      EmailProvider
  email         String?       // The connected email address - nullable during OAuth flow
  pkceVerifier  String?
  stateToken    String?
  accessToken   String?
  refreshToken  String?
  expiresAt     DateTime?
  scopes        String[]      @default([])
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  integration   Integration   @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, email])
  @@index([integrationId])
  @@index([userId, provider])
}

model RoseApiKey {
  id        String          @id @default(uuid())
  userId    String
  apiKey    String          @unique
  name      String?
  createdAt DateTime        @default(now())
  logs      RoseApiKeyLog[]

  @@index([userId])
  @@index([apiKey])
}

model RoseApiKeyLog {
  id        String     @id @default(uuid())
  apiKeyId  String
  userId    String
  input     Json
  output    Json
  costCents Int
  cotSteps  Int        @default(1)
  createdAt DateTime   @default(now())
  apiKey    RoseApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId])
  @@index([userId])
  @@index([createdAt])
}

model BenchmarkRun {
  id               String   @id @default(uuid())
  userId           String
  benchmarkName    String
  modelConfig      Json
  results          Json
  aggregateScore   Float
  totalCostCents   Int
  sampledQuestions Int
  durationSeconds  Int
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([benchmarkName])
  @@index([createdAt])
}

model RoseModelLatency {
  id         String   @id @default(uuid())
  model      String
  pool       String
  latencyMs  Int
  measuredAt DateTime @default(now())

  @@unique([model, pool])
  @@index([pool, measuredAt])
}

model RoseConversationModel {
  id             String   @id @default(uuid())
  conversationId String   @unique
  model          String
  pool           String
  createdAt      DateTime @default(now())

  @@index([conversationId])
}

model GoalHistory {
  id                        String       @id @default(uuid())
  originalAgentId           String
  userId                    String
  goal                      String
  status                    AgentStatus
  statusMessage             String?
  model                     String
  contextSize               Int
  messageCount              Int
  tokenCount                Int
  tokensIn                  Int
  tokensOut                 Int
  source                    AgentSource
  depth                     Int
  agentCreatedAt            DateTime
  agentUpdatedAt            DateTime
  agentDeletedAt            DateTime?
  archivedAt                DateTime     @default(now())

  @@index([userId])
  @@index([archivedAt])
  @@index([originalAgentId])
}

model SmsQueue {
  id           String   @id @default(uuid())
  userId       String   @unique // One active SMS per user
  agentId      String // Agent waiting for reply
  workflowId   String // To signal when reply arrives
  questionText String // The question sent
  messageSid   String? // Twilio message SID
  sentAt       DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([agentId])
}

model SmsQueuePending {
  id           String   @id @default(uuid())
  userId       String
  agentId      String
  workflowId   String
  questionText String
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([agentId])
}

enum AgentStatus {
  STARTING_UP
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
  OUT_OF_CREDITS
  COST_LIMIT_REACHED
}

enum AgentSource {
  WEB
  MAC_APP
  SMS
}

enum VerifierType {
  FLOAT_LLM_JUDGE
}

enum MessageRole {
  SYSTEM
  ASSISTANT
  USER
  TOOL
}

enum BrowserSessionStatus {
  ACTIVE
  CLOSED
  ERROR
  PAUSED
}

enum ClaudeCodeSessionStatus {
  ACTIVE
  COMPLETED
  CLOSED
  ERROR
}

enum MessageChannel {
  IMESSAGE
  WHATSAPP
  EMAIL
  TELEGRAM
  TWITTER
  INSTAGRAM_DM
  MESSENGER
}

enum IntegrationType {
  TOOL_SETUP
  DATA_SOURCE
}

enum IntegrationStatus {
  NOT_CONNECTED
  CONNECTED
  SYNCING
  SYNC_FAILED
  EXPIRED
}

enum EmailProvider {
  GMAIL
  YAHOO
}

// Temporary storage for batched localStorage uploads
// Each batch is stored separately, then merged on finalize
model PendingLocalStorageBatch {
  id         String   @id @default(uuid())
  userId     String
  uploadId   String   // Groups batches from same upload session
  batchIndex Int
  totalBatches Int
  data       Json     // { byOrigin: {...}, hashes: {...} }
  createdAt  DateTime @default(now())

  @@unique([userId, uploadId, batchIndex])
  @@index([userId, uploadId])
}

// Per-origin localStorage storage for efficient reads
// One row per origin allows O(1) lookup when injecting
model LocalStorageOrigin {
  id        String   @id @default(uuid())
  userId    String
  origin    String   // "https://google.com"
  entries   Json     // [{ key: "token", value: "..." }, ...]
  hash      String   // For cache invalidation
  updatedAt DateTime @updatedAt

  @@unique([userId, origin])
  @@index([userId])
}

// Per-origin IndexedDB storage
// Stores all databases + object stores + records for an origin
model IndexedDBOrigin {
  id        String   @id @default(uuid())
  userId    String
  origin    String   // "https://www.amazon.com"
  databases Json     // [{ name: "dbName", objectStores: [{ name: "storeName", records: [...] }] }]
  hash      String   // For cache invalidation
  updatedAt DateTime @updatedAt

  @@unique([userId, origin])
  @@index([userId])
}

// Per-origin permission grants from user's browser
// Used to make Steel sessions appear to have the same permissions
model BrowserPermission {
  id         String   @id @default(uuid())
  userId     String
  origin     String   // "https://www.amazon.com" or pattern "[*.]amazon.com"
  permission String   // "geolocation", "notifications", "camera", "microphone", etc.
  setting    Int      // 1=allow, 2=block (Chrome's content_settings values)
  syncedAt   DateTime @default(now()) @updatedAt

  @@unique([userId, origin, permission])
  @@index([userId])
}

// Per-origin Cache Storage metadata (cache names and URL indexes, not response bodies)
model CacheStorageOrigin {
  id        String   @id @default(uuid())
  userId    String
  origin    String   // "https://www.amazon.com"
  caches    Json     // [{ name: "cache-v1", urls: ["url1", "url2", ...] }, ...]
  hash      String   // For cache invalidation
  updatedAt DateTime @updatedAt

  @@unique([userId, origin])
  @@index([userId])
}

// Deduplicated cookie storage across all browsers
// When same cookie exists in multiple browsers, the one that expires latest wins
model Cookie {
  id              String   @id @default(uuid())
  userId          String
  domain          String   // Normalized host_key (e.g., ".google.com" -> "google.com")
  name            String   // Cookie name
  path            String   @default("/")
  value           String   // Decrypted cookie value
  expiresUtc      BigInt?  // Chromium timestamp (microseconds since 1601-01-01)
  isSecure        Boolean  @default(false)
  isHttpOnly      Boolean  @default(false)
  browserSource   String   // Which browser this came from (for debugging)
  syncedAt        DateTime @default(now()) @updatedAt
  // Additional Chrome cookie fields
  creationUtc     BigInt?  // When cookie was created
  topFrameSiteKey String?  // For partitioned cookies
  lastAccessUtc   BigInt?  // When cookie was last read
  hasExpires      Boolean  @default(true)
  isPersistent    Boolean  @default(true)
  priority        Int      @default(1) // 0=Low, 1=Medium, 2=High
  sameSite        Int      @default(-1) // -1=Unspecified, 0=None, 1=Lax, 2=Strict
  sourceScheme    Int      @default(0) // 0=Unset, 1=NonSecure, 2=Secure
  sourcePort      Int      @default(-1)
  lastUpdateUtc   BigInt?  // When cookie was last modified

  @@unique([userId, domain, name, path, topFrameSiteKey])
  @@index([userId])
  @@index([userId, domain])
}
