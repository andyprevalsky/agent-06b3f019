  @@unique([userId, site])
}

// One row per (browser task, site) the task forked from Root: the head
// revision it started from and the session's own auth fingerprint right after
// injection. Merge compares against this base and records its outcome here,
// so a retried close is idempotent.
model BrowserSiteFork {
  id               String         @id @default(uuid())
  userId           String
  browserSessionId String
  agentId          String
  site             String
  baseRevision     Int
  baseFingerprint  String
  baseAuthKeys     String[]       @default([])
  mergedRevision   Int?
  lastOutcome      String?
  forkedAt         DateTime       @default(now())
  mergedAt         DateTime?
  updatedAt        DateTime       @updatedAt
  browserSession   BrowserSession @relation(fields: [browserSessionId], references: [id], onDelete: Cascade)

  @@unique([browserSessionId, site])
  @@index([userId, agentId])
}

model SteelSessionAuth {
  id              String    @id @default(uuid())
  userId          String
  contextId       String
  authRealm       String
  authenticatedAt DateTime  @default(now())
  disabledAt      DateTime?
  disabledReason  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, contextId, authRealm])
}

model MintedAccount {
  id             String    @id @default(uuid())
  userId         String
  authRealm      String
  accountLabel   String
  disabledAt     DateTime?
  disabledReason String?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, authRealm])
}

// Cloud-custody passkey (Model A): a software-authenticator credential whose
// private key we hold encrypted at rest and re-inject into a CDP virtual
// authenticator at agent runtime. signCount is advanced via an ATOMIC block
// reservation at session start (never read-modify-write) so concurrent agent
// runs seed disjoint, strictly-increasing WebAuthn counter ranges — otherwise
// the relying party rejects duplicate counters as a cloned authenticator.
model PasskeyCredential {
  id                  String    @id @default(uuid())
  userId              String
  authRealm           String
  rpId                String
  credentialId        String
  encryptedPrivateKey String
  userHandle          String?
  signCount           BigInt    @default(0)
  origin              String?
  browserSource       String    @default("cdp_virtual")
  disabledAt          DateTime?
  disabledReason      String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt
  user                User      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, rpId, credentialId])
  @@index([userId])
  @@index([userId, authRealm])
}

model AgentIdentity {
  id                    String   @id @default(uuid())
  userId                String   @unique
  email                 String
  phone                 String?
  phoneProvider         String?
  phoneProviderAgentId  String?
  phoneProviderNumberId String?
  createdAt             DateTime @default(now())
  user                  User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([phone])
}

model AgentPhoneMessage {
  id               String   @id @default(uuid())
  userId           String
  externalId       String   @unique
  providerAgentId  String?
  providerNumberId String?
  from             String
  to               String
  body             String
  channel          String
  receivedAt       DateTime
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, receivedAt])
  @@index([to])
}

model UserAuthAssistanceRequest {
  id               String                @id
  agentId          String
  userId           String
  authRealm        String
  browserSessionId String?
  steelSessionId   String
  mode             String
  createdAt        DateTime              @default(now())
  completedAt      DateTime?
  user             User                  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  attentionRequest AgentAttentionRequest @relation(fields: [id], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([browserSessionId])
}

model AgentRunCredentialPropagation {
  agentId   String   @id
  createdAt DateTime @default(now())
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String
  feedback  String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

