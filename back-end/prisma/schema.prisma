model EmailIntegrationCredential {
  id               String        @id @default(uuid())
  userId           String
  integrationId    String
  provider         EmailProvider
  pkceVerifier     String?
  stateToken       String?
  accessToken      String?
  refreshToken     String?
  expiresAt        DateTime?
  scopes           String[]      @default([])
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  email            String?
  /// Per-ACCOUNT health, mirroring ComputeAccountConnection.state.
  ///
  /// Health has to live here rather than on Integration because one `gmail`
  /// Integration row fans out to N connected addresses: a dead refresh token on
  /// one address says nothing about the others. Rolling it up to the shared row
  /// (what we did before) both hid which account broke and marked working
  /// accounts as failed.
  ///
  /// "needs_reconnect" is terminal and user-visible -- it is what turns the FE
  /// chip amber, and it is only ever set for errors that re-consent can fix
  /// (invalid_grant and friends). Transient sync errors use "sync_failed" so a
  /// network blip never asks the user to re-authorize.
  state            String        @default("connected")
  /// Human-readable cause of the current non-connected state, for the chip tooltip.
  lastErrorReason  String?
  lastFailedSyncAt DateTime?
  integration      Integration   @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, email])
  @@index([integrationId])
  @@index([userId, provider])
}

/// Plaid Item: one connected financial institution per user.
/// Holds the encrypted long-lived access token issued by Plaid after
/// successful Link exchange.
model PlaidItem {
  id                   String             @id @default(uuid())
  userId               String
  integrationId        String
  plaidItemId          String             @unique
  plaidInstitutionId   String?
  institutionName      String?
  /// Base64-encoded RSA-2048 + AES-256-GCM envelope wrapping the Plaid
  /// access_token. Encrypted on the backend at write time; decrypted only
  /// at the moment of a Plaid API call. See providers/plaidCredentials.ts.
  encryptedAccessToken String
  status               PlaidItemStatus    @default(ACTIVE)
  products             String[]           @default([])
  cursor               String?
  lastSyncAt           DateTime?
  lastWebhookAt        DateTime?
  errorCode            String?
  errorMessage         String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  disconnectedAt       DateTime?
  integration          Integration        @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  accounts             PlaidAccount[]
  transactions         PlaidTransaction[]

  @@index([userId])
  @@index([userId, status])
  @@index([integrationId])
}

/// Plaid Account: per-account metadata exposed by Plaid for a given Item.
/// Holds no balances or transactions; those are fetched on demand and not
/// persisted by this table.
model PlaidAccount {
  id                 String             @id @default(uuid())
  userId             String
  plaidItemId        String
  plaidAccountId     String             @unique
  name               String
  officialName       String?
  mask               String?
  type               String
  subtype            String?
  verificationStatus String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  disconnectedAt     DateTime?
  plaidItem          PlaidItem          @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)
  transactions       PlaidTransaction[]

  @@index([userId])
  @@index([plaidItemId])
}

/// Plaid Transaction: normalized, searchable transaction data from Plaid
/// Transactions Sync. Stores no raw Plaid payload.
model PlaidTransaction {
  id                      String               @id @default(uuid())
  userId                  String
  plaidItemId             String
  plaidAccountId          String
  plaidTransactionId      String               @unique
  plaidAccountExternalId  String
  date                    DateTime
  authorizedDate          DateTime?
  datetime                DateTime?
  authorizedDatetime      DateTime?
  name                    String
  merchantName            String?
  originalDescription     String?
  amount                  Decimal              @db.Decimal(18, 4)
  absoluteAmount          Decimal              @db.Decimal(18, 4)
  direction               TransactionDirection
  isoCurrencyCode         String?
  unofficialCurrencyCode  String?
  category                String[]             @default([])
  categoryId              String?
  personalFinanceCategory String?
  personalFinanceDetailed String?
  paymentChannel          String?
  locationSummary         String?
  pending                 Boolean              @default(false)
  pendingTransactionId    String?
  accountOwner            String?
  checkNumber             String?
  removedAt               DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  plaidItem               PlaidItem            @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)
  plaidAccount            PlaidAccount         @relation(fields: [plaidAccountId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, pending])
  @@index([userId, removedAt])
  @@index([plaidItemId])
  @@index([plaidAccountId])
  @@index([plaidAccountExternalId])
}

