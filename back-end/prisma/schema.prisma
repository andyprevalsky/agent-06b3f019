model SmsSession {
  id             String   @id @default(uuid())
  userId         String   @unique
  messages       Json     @default("[]")
  // Monotonic per-user inbound-SMS counter. Its increment and the inbound
  // transcript append happen atomically before supervisor work starts. A run
  // re-checks it before every outbound send or queued-write commit.
  lastInboundSeq Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model SmsShortcode {
  id                 String   @id @default(uuid())
  code               String   @unique
  userId             String
  attentionRequestId String
  agentId            String
  workflowId         String
  createdAt          DateTime @default(now())
  expiresAt          DateTime

  @@index([code])
  @@index([userId])
  @@index([expiresAt])
}

// Singleton pointer to the Temporal task queue that NEW agent workflows route
// to — the current zero-downtime cutover "generation". Its value is
// `navi-agent-tasks@<surfaceHash>`, where surfaceHash is the replay-surface hash
// (scripts/agent_workflow_surface_hash.py). Read on every workflow start (cached
// in-process, ~5s TTL, so it is O(1) at 10k agents, not a per-start DB hit) and
// flipped atomically by the deploy cutover. When the row is ABSENT, callers fall
// back to the TEMPORAL_TASK_QUEUE env var — so this is fully backward-compatible
// and inert until the cutover writes it.
model AgentQueuePointer {
  id          String   @id @default("singleton")
  taskQueue   String
  surfaceHash String
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

// Planner memory: one row per finalized root trace bundle (written in the same
// finalize path that publishes the R2 manifest, so the table and the archive
// never drift). `criticalPath` is filled lazily on first retrieval (cache, no
// TTL): the worker reads the bundle, compresses the trajectory once, and
// stores the result here. Retrieval is one indexed FTS query per planner call.
model PlannerMemory {
  id                    String    @id
  userId                String?
  goal                  String
  benchmarkTaskName     String?
  rootStatus            String?
  passed                Boolean?
  worldModelMode        String    @default("real")
  agentCreatedAt        DateTime?
  archivedAt            DateTime  @default(now())
  criticalPath          Json?
  compressorVersion     String?
  compressedAt          DateTime?
  compressionLeaseId    String?
  compressionLeaseUntil DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  embedding PlannerMemoryEmbedding?

  @@index([benchmarkTaskName])
  @@index([userId])
  @@index([passed, archivedAt])
}

/// Semantic retrieval vector for one PlannerMemory row (voyage-4 embedding of
/// the goal). `model` holds the index version; `goalHash` + `model` make
/// re-embedding idempotent.
model PlannerMemoryEmbedding {
  plannerMemoryId String                      @id
  plannerMemory   PlannerMemory               @relation(fields: [plannerMemoryId], references: [id], onDelete: Cascade)
  model           String
  goalHash        String
  goalVector      Unsupported("vector(1024)")
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  @@index([model])
}

/// One immutable published `rose_user_ui` bundle for a user. Files live in
/// storage under `user-ui/<userId>/<id>/<path>`; `manifest` is the validated
/// `rose-ui.json`. `User.activeUiVersionId` points at the version the app renders.
model UserUiVersion {
  id                 String   @id @default(uuid())
  userId             String
  manifest           Json
  fileCount          Int
  totalBytes         Int
  createdAt          DateTime @default(now())
  /// Code agent whose session published this version (publish token `agt`);
  /// null for user/API-key publishes and rows from before L-APPS2.
  publishedByAgentId String?
  /// ClaudeCodeSession.id of that publish (publish token `tsk`); the Apps list
  /// resolves its code session from this task. Null like publishedByAgentId.
  publishedByTaskId  String?
  user               User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// One-time sign-in code for a Rose dev account's own code-agent preview
/// (Rose-in-Rose A1 follow-up, L-APPS2). Only the SHA-256 of the code is
/// stored. The first presentation burns it (redeemedAt), whatever the outcome;
/// expiry and the bound preview origin are checked after that. Backend-only
/// (service role); no client policy.
model PreviewHandoffCode {
  id         String    @id @default(uuid())
  codeHash   String    @unique
  userId     String
  taskId     String
  /// Preview origin resolved server-side from the task (scheme://host[:port]).
  origin     String
  expiresAt  DateTime
  redeemedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, expiresAt])
}

/// A Rose Mac app install that can run local code agents (C14). `id` is minted
/// and persisted by the Mac app; the first authenticated register binds it to a
/// user and it can never move to another user. Live connectivity is in-process
/// (the device's control WebSocket), not stored; `lastSeenAt` is informational.
/// Backend-only (service role).
model LocalDevice {
  id         String   @id
  userId     String
  name       String
  platform   String   @default("darwin")
  appVersion String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
}

/// Slack #errors incident owned by one Rose RCA root agent. One row per error
/// signature per fixed window, so an error storm creates one agent. `agentId`
/// is minted with the row and the agent is created with that id, which makes
/// Slack webhook retries idempotent. Backend-only (service role).
model SlackAutoRcaIncident {
  id              String    @id @default(uuid())
  signature       String
  windowStart     DateTime
  agentId         String    @unique
  ownerUserId     String
  slackChannel    String
  slackThreadTs   String
  occurrenceCount Int       @default(1)
  appendedCount   Int       @default(0)
  startNotifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([signature, windowStart])
}

/// Slack Events API delivery processed by the auto-RCA webhook. The primary
/// key dedupes Slack retries; (slackChannel, slackTs) maps an alert thread back
/// to its incident for reviewer feedback.
model SlackAutoRcaEvent {
  eventId      String   @id
  incidentId   String
  kind         String
  slackChannel String
  slackTs      String
  createdAt    DateTime @default(now())

  @@index([slackChannel, slackTs])
  @@index([incidentId])
}

/// A user's codebase ("Project"): the settings a code session needs to run it
/// plus its latest codebase-sync snapshot (rose-sync CLI / mac app). Secret-
/// bearing content (env files, linked config, git artifacts) is stored only as
/// credential envelopes (RSA-OAEP + AES-256-GCM, CLAUDE_CREDENTIAL_DECRYPTION_KEY).
model Project {
  id              String               @id @default(uuid())
  userId          String
  name            String
  repoUrl         String?
  defaultBranch   String               @default("main")
  startupScript   String?
  startupTimeoutS Int                  @default(120)
  autoWake        Boolean              @default(false)
  /// Per-project salt for content fingerprints (incremental re-sync).
  syncSalt        String
  /// Monotonic snapshot revision; bumped by every accepted sync.
  syncRevision    Int                  @default(0)
  lastSyncedAt    DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  user            User                 @relation(fields: [userId], references: [userId], onDelete: Cascade)
  envFiles        ProjectEnvFile[]
  syncSnapshot    ProjectSyncSnapshot?
  agents          Agent[]

  @@unique([userId, name])
  @@index([userId, updatedAt])
}

/// One secret-bearing file materialized into a project checkout with 0600
/// permissions. `variables` holds names/descriptions only (searchable); values
/// exist only inside `encryptedContent`.
model ProjectEnvFile {
  id               String   @id @default(uuid())
  projectId        String
  /// Repo-relative destination path.
  path             String
  description      String?
  /// "env" (dotenv) | "config" (other linked or secret config file)
  kind             String   @default("env")
  /// "managed" (project settings) | "sync" (codebase sync) | "declared" (awaiting sync)
  source           String   @default("managed")
  variables        Json     @default("[]")
  encryptedContent String?
  fingerprint      String?
  /// Original symlink target recorded by codebase sync (link structure only).
  linkTarget       String?
  sizeBytes        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
}

/// Latest codebase-sync snapshot of a project: non-secret manifest plus
/// encrypted git artifacts. One row per project, replaced by each revision.
model ProjectSyncSnapshot {
  projectId                 String   @id
  revision                  Int
  /// Non-secret: git remote/branch/head, symlinks, toolchain, setup hints, source.
  manifest                  Json
  encryptedGitBundle        String?
  gitBundleFingerprint      String?
  encryptedUncommittedPatch String?
  patchFingerprint          String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  project                   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
