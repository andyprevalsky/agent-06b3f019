generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  // Only extensions Prisma must create for `db push`; Supabase-managed ones stay unmanaged.
  extensions = [vector]
}

model Agent {
  id                               String                    @id @default(uuid())
  userId                           String
  goal                             String
  // Short sidebar label. Generated from the goal at spawn time, overridable by
  // the user via rename. Null falls back to `goal` in the UI.
  title                            String?
  // Non-null pins the agent to the top of the sidebar list.
  pinnedAt                         DateTime?
  progress                         Float                     @default(0.0)
  status                           AgentStatus               @default(STARTING_UP)
  statusMessage                    String?
  // Archive marker. Set by DELETE /api/agents/:id (soft delete); the sidebar's
  // archived view lists rows where this is non-null.
  deletedAt                        DateTime?
  createdAt                        DateTime                  @default(now())
  updatedAt                        DateTime                  @updatedAt
  temporalWorkflowId               String?
  temporalFirstExecutionRunId      String?
  workflowReplacementToken         String?
  workflowReplacementState         Json?
  staleTemporalWorkflowId          String?
  staleTemporalFirstExecutionRunId String?
  temporalWorkflowStartPending     Boolean                   @default(false)
  temporalWorkflowStartLeaseUntil  DateTime?
  temporalCleanupPending           Boolean                   @default(false)
  workflowIterationOffset          Int                       @default(0)
  workflowMaxIterations            Int?
  workflowContextGates             Json?
  workflowStartPhase               String?
  workflowTaskQueue                String?
  model                            String                    @default("rose-labs/rose-1-ultra")
  contextSize                      Int                       @default(0)
  messageCount                     Int                       @default(0)
  tokenCount                       Int                       @default(0)
  tokensIn                         Int                       @default(0)
  tokensOut                        Int                       @default(0)
  parentAgentId                    String?
  tokenInPriceMicrodollars         Int?
  tokenOutPriceMicrodollars        Int?
  source                           AgentSource               @default(WEB)
  depth                            Int                       @default(0)
  parentWorkflowId                 String?
  reasoningMaxTokens               Int                       @default(2048)
  responseSchema                   Json?
  busId                            String?
  toolsInUse                       String[]                  @default([])
  structuredResponse               Json?
  proxyCity                        String?
  proxyCountry                     String?
  proxyState                       String?
  priceLimitCents                  Int                       @default(100)
  treeCostCents                    Int                       @default(0)
  ownCostCents                     Float                     @default(0)
  writeLockEnabled                 Boolean                   @default(true)
  fastModeCacheEnabled             Boolean                   @default(true)
  worldModelMode                   String                    @default("real")
  memoryEnabled                    Boolean                   @default(true)
  isBenchmark                      Boolean                   @default(false)
  githubRepoUrl                    String?
  /// LocalDevice.id of the Rose Mac app that started this root agent (C14).
  /// Null for web/PWA/SMS roots and for sub-agents (they resolve it via busId).
  originDeviceId                   String?
  /// Owning Project (left-bar grouping, code-session workspace). Null = Home.
  /// Set on create (owner-validated) or inherited from the parent agent.
  projectId                        String?
  project                          Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent                           Agent?                    @relation("AgentHierarchy", fields: [parentAgentId], references: [id])
  children                         Agent[]                   @relation("AgentHierarchy")
  tools                            AgentTool[]
  messages                         Message[]
  toolUsages                       ToolUsage[]
  temporalWorkflowCleanups         TemporalWorkflowCleanup[]
  traceArchiveFinalization         TraceArchiveFinalization?
  purchaseSpends                   PurchaseSpend[]
  verifier                         Verifier?

  @@index([userId, deletedAt])
  @@index([createdAt])
  @@index([temporalWorkflowId])
  @@index([workflowReplacementToken])
  @@index([temporalWorkflowStartPending])
  @@index([temporalCleanupPending, id])
  @@index([parentAgentId])
  @@index([parentAgentId, createdAt])
  @@index([parentAgentId, worldModelMode, createdAt])
  @@index([busId])
  @@index([projectId])
}

model TemporalWorkflowCleanup {
  agentId             String
  workflowId          String
  firstExecutionRunId String?
  notBefore           DateTime
  leaseToken          String?
  leaseUntil          DateTime?
  attemptCount        Int       @default(0)
  lastError           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  agent               Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([agentId, workflowId])
  @@index([notBefore, agentId, workflowId])
  @@index([leaseUntil])
}

/// Durable outbox for root trace archives that must be finalized after a
/// soft-delete. The row is created in the same transaction as `Agent.deletedAt`
/// and removed only after the terminal R2 bundle is complete.
model TraceArchiveFinalization {
  rootAgentId  String    @id
  notBefore    DateTime
  leaseToken   String?
  leaseUntil   DateTime?
  attemptCount Int       @default(0)
  lastError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  agent        Agent     @relation(fields: [rootAgentId], references: [id], onDelete: Cascade)

  @@index([notBefore, rootAgentId])
  @@index([leaseUntil])
}

model Tool {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  createdAt   DateTime    @default(now())
  agents      AgentTool[]
}

// Fast Mode aggressive cache. Record/replay store for third-party responses so a
// slow real run can be replayed instantly. Entries live forever (no TTL); re-record
// is a manual purge by goalHash. Writes only happen when Fast Mode is enabled.
// `value` holds JSON (LLM responses, search/fetch results, browser response metadata);
// `blobPath` references a Supabase storage object for large binary bodies.
model FastModeCacheEntry {
  key       String   @id
  kind      String // llm | browser_use | browser_http | web_search | web_fetch | file | anthropic | codex
  goalHash  String
  value     Json?
  blobPath  String?
  createdAt DateTime @default(now())

  @@index([goalHash])
  @@index([kind])
}

model AgentTool {
  agentId    String
  toolId     String
  assignedAt DateTime @default(now())
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tool       Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@id([agentId, toolId])
  @@index([agentId])
  @@index([toolId])
}

model Verifier {
  id        String       @id @default(uuid())
  agentId   String       @unique
  type      VerifierType @default(FLOAT_LLM_JUDGE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  agent     Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model Message {
  id                 String      @id @default(uuid())
  agentId            String
  workflowGeneration String?
  timestamp          DateTime    @default(now())
  text               String
  role               MessageRole
  createdAt          DateTime    @default(now())
  metadata           Json?
  filePointer        Json?
  agent              Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, timestamp])
  @@index([agentId, workflowGeneration, timestamp])
  @@index([createdAt])
}

/// Search projection of live messages and finalized R2 trace bundles. Archive
/// rows deliberately have no FK to Message: archived traces remain searchable
/// after operational Agent/Message rows are purged.
model AgentTrajectorySearch {
  messageId   String   @id
  userId      String
  rootAgentId String
  agentId     String
  surface     String
  role        String
  createdAt   DateTime
  searchText  String
  agentGoal   String   @default("")
  agentTitle  String?
  archivePath String?
  traceKind   String   @default("message")

  @@index([userId, createdAt(sort: Desc), messageId(sort: Desc)])
  @@index([userId, rootAgentId, createdAt(sort: Desc), messageId(sort: Desc)], map: "AgentTrajectorySearch_user_root_time_idx")
  @@index([userId, role, traceKind, createdAt(sort: Desc), messageId(sort: Desc)], map: "AgentTrajectorySearch_user_role_kind_time_idx")
}

model Waitlist {
  id           String    @id @default(uuid())
  name         String    @default("")
  email        String?   @unique
  phone        String?   @unique
  variant      String?
  referralCode String?   @map("referral_code")
  createdAt    DateTime  @default(now()) @map("created_at")
  invitedAt    DateTime? @map("invited_at")

  @@index([createdAt])
  @@index([email])
}

model GoalBlueprint {
  id        String   @id @default(uuid())
  userId    String
  title     String
  blueprint Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  embedding Json?
  metadata  Json?

  @@index([userId])
  @@index([createdAt])
}

model AgentAttentionRequest {
  id             String                     @id @default(cuid())
  userId         String
  agentId        String
  workflowId     String
  question       String
  userResponse   String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  imageUrl       String?
  metadata       Json?
  // Dedup identity for Gate requests (the Gate object rides in metadata.gate).
  // Multiple agents that hit the same gate collapse onto one PENDING
  // (userResponse IS NULL) request. A partial unique index in the migration
  // enforces this. See docs/plans/active/sms-onboarding-and-gates.md.
  gateKey        String?
  authAssistance UserAuthAssistanceRequest?

  @@index([updatedAt])
  @@index([userId])
  @@index([workflowId])
  @@index([userId, gateKey])
}

model ModelPricingCache {
  modelId                   String   @id
  tokenInPriceMicrodollars  Int
  tokenOutPriceMicrodollars Int
  cachedAt                  DateTime @default(now())
  expiresAt                 DateTime

  @@index([expiresAt])
}

model ToolUsage {
  id                     String   @id @default(uuid())
  operationKey           String?  @unique
  agentId                String?
  toolName               String
  totalCostCents         Int
  usageItems             Json
  tokenCountCheckpoint   Int?
  tokensInCheckpoint     Int?
  tokensOutCheckpoint    Int?
  ownCostCheckpointCents Float?
  createdAt              DateTime @default(now())
  userId                 String
  agent                  Agent?   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([agentId])
  @@index([createdAt])
  @@index([toolName])
}

model ToolSideEffect {
  id            String   @id @default(uuid())
  operationKey  String   @unique
  operationType String
  status        String   @default("STARTED")
  externalId    String?
  request       Json?
  response      Json?
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([operationType])
  @@index([status])
  @@index([externalId])
}

/// One outbound phone call that the backend owns on Twilio. Each Vapi
/// assistant conversation is a segment; wait_for_human parks the Twilio call
/// on a backend media stream (no Vapi minutes) until a live person speaks.
model PhoneCallSession {
  id               String    @id @default(uuid())
  operationKey     String?
  agentId          String?
  userId           String?
  rootVapiCallId   String?   @unique
  activeVapiCallId String?
  twilioCallSid    String?   @unique
  phoneNumberId    String
  fromNumber       String
  toNumber         String
  /// dialing | connected | on_hold | reconnecting | ended
  state            String    @default("dialing")
  assistantConfig  Json
  segments         Json      @default("[]")
  holds            Json      @default("[]")
  endedReason      String?
  endedAt          DateTime?
  /// Bumped on every write; read-modify-write callers compare-and-set on it.
  version          Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([agentId])
}

model User {
  id                          String                      @id @default(uuid())
  userId                      String                      @unique
  name                        String?
  email                       String?
  deliveryRecipientName       String?
  addressLine1                String?
  addressLine2                String?
  city                        String?
  state                       String?
  postalCode                  String?
  country                     String?                     @default("United States")
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  inviteCode                  Int?                        @unique
  inviteCodeUses              Int                         @default(0)
  usedInviteCode              Int?
  offWaitlistAt               DateTime?
  encryptedPaymentInformation String?
  phone                       String?                     @unique
  isAnonymous                 Boolean                     @default(false)
  onboardingCompletedAt       DateTime?
  imessageBridgeLastSeenAt    DateTime?
  // Per-number WhatsApp deliverability for mirrored lifecycle notifications.
  // null = unknown (try once, learn); true = reachable (received an inbound WA
  // message or a send succeeded); false = not on WhatsApp / undeliverable (skip
  // WhatsApp sends so we don't hammer a number that can't receive).
  whatsappReachable           Boolean?
  systemName                  String?
  profilePicture              String?
  customSystemPrompt          String?
  voicePreferenceId           String?
  poolTokensByDefault         Boolean                     @default(false)
  credits                     Credit[]
  subscriptions               Subscription?
  cookieBundles               CookieBundle[]
  browserSiteStates           BrowserSiteState[]
  steelSessionAuths           SteelSessionAuth[]
  mintedAccounts              MintedAccount[]
  passkeyCredentials          PasskeyCredential[]
  agentIdentity               AgentIdentity?
  agentPhoneMessages          AgentPhoneMessage[]
  authAssistanceRequests      UserAuthAssistanceRequest[]
  purchaseSpends              PurchaseSpend[]
  dataDocuments               UserDataDocument[]
  dataProviderSyncStates      UserDataProviderSyncState[]
  userSnapshot                UserSnapshot?
  userSnapshotRevisions       UserSnapshotRevision[]
  /// Active published rose_user_ui version (UserUiVersion.id); null = stock UI.
  activeUiVersionId           String?
  uiVersions                  UserUiVersion[]
  localDevices                LocalDevice[]
  projects                    Project[]
  previewHandoffCodes         PreviewHandoffCode[]

  @@index([userId])
  @@index([inviteCode])
  @@index([usedInviteCode])
  @@index([isAnonymous])
}

model Credit {
  id             String    @id @default(uuid())
  userId         String
  amountCents    Int
  expirationDate DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([expirationDate])
}

model Subscription {
  id                   String   @id @default(uuid())
  userId               String   @unique
  subscriptionTier     Int
  stripeSubscriptionId String   @unique
  stripeCustomerId     String
  /// Which Stripe account minted this customer/subscription. Existing rows are
  /// sandbox (false); live Rose Labs Pro checkouts persist true so the billing
  /// portal can open against the matching account.
  stripeLivemode       Boolean  @default(false)
  currentPeriodEnd     DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([stripeSubscriptionId])
}

model PurchaseSpend {
  id                    String                 @id @default(uuid())
  userId                String
  agentId               String?
  fingerprint           String
  canonicalFingerprint  String?
  cardId                String?
  merchant              String
  lineItemsJson         Json
  totalCents            Int
  status                PurchaseSpendStatus    @default(PENDING_APPROVAL)
  stripeLivemode        Boolean                @default(false)
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  stripePaymentIntentId String?
  provider              String                 @default("agentcard")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  user                  User                   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  agent                 Agent?                 @relation(fields: [agentId], references: [id], onDelete: SetNull)
  walletFunding         PurchaseWalletFunding?

  // NOT unique: a user may legitimately re-buy the same cart. Idempotency for in-flight retries
  // is enforced in application logic (status checks + a Stripe idempotency key per purchase row)
  // plus the 24h reuse window — not a DB constraint.
  @@index([userId, fingerprint])
  @@index([userId, canonicalFingerprint])
  @@index([agentId])
  @@index([cardId])
  @@index([status])
  @@index([createdAt])
}

// Wallet-funding ledger for AgentCard purchases: tracks moving funds into the
// virtual card wallet and reclaiming them, with idempotency keys so Temporal
// retries don't double-fund/double-reclaim. One row per PurchaseSpend.
// (Baselined from prod on 2026-07-06 — the table pre-existed in prod with no
// committed schema/migration.)
model PurchaseWalletFunding {
  id                        String                      @id @default(uuid())
  purchaseId                String                      @unique
  userId                    String
  agentId                   String?
  provider                  String                      @default("agentcard")
  amountCents               Int
  currency                  String                      @default("usd")
  status                    PurchaseWalletFundingStatus @default(PENDING)
  providerTransferId        String?
  reclaimProviderTransferId String?
  idempotencyKey            String                      @unique
  reclaimIdempotencyKey     String?
  reclaimLeaseToken         String?
  metadata                  Json?
  errorMessage              String?
  fundedAt                  DateTime?
  consumedAt                DateTime?
  reclaimedAt               DateTime?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  purchase                  PurchaseSpend               @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([status, createdAt])
  @@index([userId, status])
}

model BrowserContext {
  id                     String                   @id @default(uuid())
  userId                 String                   @unique
  contextId              String?                  @unique
  preferredBrowserConfig Json?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  sessions               BrowserSession[]
  providerProfiles       BrowserProviderProfile[]

  @@index([userId])
  @@index([contextId])
}

model BrowserProviderProfile {
  id        String         @id @default(uuid())
  contextId String
  provider  String
  profileId String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  context   BrowserContext @relation(fields: [contextId], references: [id], onDelete: Cascade)

  @@unique([contextId, provider])
  @@unique([provider, profileId])
  @@index([contextId])
}

model BrowserProviderProxy {
  id        String   @id @default(uuid())
  provider  String
  proxyKey  String
  proxyId   String
  proxyType String
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, proxyKey])
  @@unique([provider, proxyId])
  @@index([provider])
}

model BrowserSession {
  id                     String               @id @default(uuid())
  contextId              String
  agentId                String
  sessionId              String               @unique
  status                 BrowserSessionStatus @default(ACTIVE)
  debugUrl               String?
  startUrl               String?
  currentUrl             String?
  createdAt              DateTime             @default(now())
  closedAt               DateTime?
  wsUrl                  String?
  provider               String               @default("steel")
  // Provider identity actually loaded by this session. BrowserContext provider
  // profiles are shared defaults and cannot identify concurrent isolated runs.
  providerProfileId      String?
  providerProfileSource  String?
  providerProfilePersist Boolean              @default(true)
  injectedOrigins        Json?
  controlState           BrowserControlState  @default(AGENT)
  controlLeaseExpiresAt  DateTime?
  // Model-driven IP rotation (rotate_ip tool). Count + current tier are keyed to
  // this stable row id (the browser sub-agent run), surviving session recycles so
  // the cap is authoritative across rotations. proxyTier: null → original session,
  // 'residential' | 'mobile' after a rotation. See docs/plans/active/rotate-ip-tool.md.
  proxyRotationCount     Int                  @default(0)
  proxyTier              String?
  // The managed Kernel proxy that actually resolved. Resume must keep its tier
  // and location specificity even if a more specific proxy becomes available.
  kernelProxySource      String?
  context                BrowserContext       @relation(fields: [contextId], references: [id], onDelete: Cascade)
  siteForks              BrowserSiteFork[]

  @@index([contextId])
  @@index([agentId])
  @@index([sessionId])
  @@index([status])
}

model ClaudeCodeSession {
  id                       String                  @id @default(uuid())
  agentId                  String
  // Not unique: a persistent CodeSession resumes the same paused sandbox for
  // every spawn, so several ClaudeCodeSession rows can share one sandbox.
  sandboxId                String
  streamUrl                String?
  goal                     String
  status                   ClaudeCodeSessionStatus @default(ACTIVE)
  output                   String?
  createdAt                DateTime                @default(now())
  closedAt                 DateTime?
  // Credential tracking — set when the CLI is started with per-user/pool OAuth
  // credentials so closeClaudeCodeSession() can mark the right Integration as
  // rate-limited if the CLI output reports "You've hit your limit · resets X:XX (UTC)".
  claudeTokenSource        String?
  claudeTokenIntegrationId String?
  /// Persistent code session this spawn attached to (null for legacy rows).
  codeSessionId            String?
  /// CLI this task ran ('claude' | 'codex'); null for legacy rows. Per task, so a
  /// usage-limit provider switch (C15) keeps each task's own provider.
  codeProvider             String?
  /// Question this code agent asked its spawning Rose agent ({message_id, question, at}).
  /// The spawn blocked on this task pauses the session and returns the question.
  awaitingParent           Json?
  /// Project restored into this session (runProjectStartup reads it on resume).
  projectId                String?

  @@index([agentId])
  @@index([sandboxId])
  @@index([status])
  @@index([codeSessionId])
}

/// Persistent code-agent workspace owned by one agent for one repo
/// (userId, ownerAgentId, repoKey). Every code-agent spawn by that agent
/// resumes its latest session: a paused sandbox when it survived, otherwise
/// the latest verified checkpoint under user/<userId>/code-sessions/<id>/<seq>/.
/// Branch model (docs/plans/active/code-agent-persistent-sessions.md §1b): a
/// root agent's branch is cut from the repo default branch; a sub-agent's is
/// cut from its parent's branch and merges back into it.
model CodeSession {
  id                  String    @id @default(uuid())
  userId              String
  rootAgentId         String
  /// Agent whose code-agent spawns work in this session's worktree.
  ownerAgentId        String
  repoUrl             String?
  /// repoUrl ?? '' so the scope lookup is one indexed equality.
  repoKey             String    @default("")
  codeProvider        String    @default("claude")
  /// ACTIVE (leased by a spawn) | PAUSED | RETIRED
  state               String    @default("ACTIVE")
  /// 'e2b' | 'local'
  sandboxKind         String?
  sandboxId           String?
  /// Local fallback only: the persistent session HOME on the backend host.
  homeDir             String?
  cliSessionId        String?
  /// Stable per tool call (Temporal retries of one spawn share it).
  leaseOwner          String?
  leaseExpiresAt      DateTime?
  latestCheckpointSeq Int       @default(0)
  nextCheckpointSeq   Int       @default(0)
  lastRepoFacts       Json?
  /// Branch this session works on (repo sessions only).
  branch              String?
  /// Ref the branch was cut from; null = the repo's default branch.
  baseBranch          String?
  /// Branch this one merges into; null = the repo's default branch.
  mergeTarget         String?
  /// The parent agent's session this branch was cut from (sub-agents).
  parentCodeSessionId String?
  lastActiveAt        DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  retiredAt           DateTime?

  @@index([userId, ownerAgentId, repoKey, lastActiveAt(sort: Desc)])
  @@index([userId, state, lastActiveAt])
}

/// "New agent in this branch": agentId works in the code session (worktree,
/// branch, CLI conversation) of sharedWithAgentId instead of its own.
model CodeSessionShare {
  agentId           String   @id
  userId            String
  sharedWithAgentId String
  createdAt         DateTime @default(now())

  @@index([sharedWithAgentId])
}

model GithubRepoAccess {
  id        String   @id @default(uuid())
  userId    String
  repoUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, repoUrl])
  @@index([userId])
}

model MessageRecord {
  id                 String         @id @default(uuid())
  personId           String
  channel            MessageChannel
  from               String
  to                 String
  timestamp          DateTime
  message            String
  externalId         String? // Platform-native message ID (Telegram msg.id, iMessage ROWID, WhatsApp key.id)
  googleAccountEmail String? // Source Gmail account for account-scoped deletion
  /// Provider-side account that synced this message (a Telegram user id, a
  /// WhatsApp linked phone), for account-scoped deletion. Null = the
  /// legacy/default account. Rows that carry it namespace `externalId` as
  /// "<sourceAccountId>:<native id>" so two accounts cannot collide on the dedup key.
  sourceAccountId    String?
  createdAt          DateTime       @default(now())
  person             Person         @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, channel, externalId]) // Primary dedup: same message can't be inserted twice
  @@index([personId, channel])
  @@index([timestamp])
  @@index([personId, timestamp])
  @@index([channel, timestamp]) // Recent-inbound OTP relay: channel filter + time window
  @@index([googleAccountEmail, createdAt])
}

model GoogleDataPurge {
  id              String    @id @default(uuid())
  userId          String
  email           String?
  /// Encrypted token kept only until Google confirms revocation.
  revocationToken String?
  requestedAt     DateTime  @default(now())
  claimedUntil    DateTime?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([processedAt, claimedUntil, requestedAt])
  @@index([userId, email])
}

model Person {
  id                         String          @id @default(uuid())
  userId                     String
  firstName                  String
  lastName                   String
  age                        Int?
  location                   String?
  profession                 String?
  company                    String?
  title                      String?
  industry                   String?
  email                      String?
  phoneNumber                String?
  linkedinUrl                String?
  instagramHandle            String?
  facebookUrl                String?
  twitterHandle              String?
  embedding                  Json?
  emailAddresses             Json?           @default("[]")
