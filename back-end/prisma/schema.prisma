// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")  // Session pooler (IPv4 compatible)
}

model Agent {
  id                 String          @id @default(uuid())
  userId             String          // Supabase user ID
  goal               String          @db.Text
  model              String          @default("google/gemini-2.5-flash") // LLM model driving this agent
  reasoningEffort    ReasoningEffort @default(low) // OpenRouter reasoning effort level
  progress           Float           @default(0.0) // 0.0 to 1.0
  status             AgentStatus     @default(STARTING_UP)
  statusMessage      String?         @db.Text
  temporalWorkflowId String?         // Links to Temporal workflow
  deletedAt          DateTime?       // Soft delete
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  
  // Metrics
  tokenCount         Int             @default(0) // Cumulative tokens used (total)
  tokensIn           Int             @default(0) // Input tokens (prompt)
  tokensOut          Int             @default(0) // Output tokens (completion)
  contextSize        Int             @default(0) // Current context window usage in tokens
  messageCount       Int             @default(0) // Total messages in context

  verifier  Verifier?
  tools     AgentTool[]
  messages  Message[]

  @@index([userId, deletedAt])
  @@index([createdAt])
  @@index([temporalWorkflowId])
}

model Tool {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())

  agents AgentTool[]
}

model AgentTool {
  agentId    String
  toolId     String
  assignedAt DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tool  Tool  @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@id([agentId, toolId])
  @@index([agentId])
  @@index([toolId])
}

model Verifier {
  id             String       @id @default(uuid())
  agentId        String       @unique
  type           VerifierType @default(FLOAT_LLM_JUDGE)
  llmJudgePrompt String       @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model Message {
  id        String      @id @default(uuid())
  agentId   String
  timestamp DateTime    @default(now())
  text      String      @db.Text
  role      MessageRole
  createdAt DateTime    @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, timestamp])
  @@index([createdAt])
}

enum AgentStatus {
  STARTING_UP
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
}

enum ReasoningEffort {
  off
  low
  medium
  high
}

enum VerifierType {
  FLOAT_LLM_JUDGE
}

enum MessageRole {
  SYSTEM
  ASSISTANT
  USER
  TOOL
}

model Waitlist {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  variant       String?
  referralCode  String?  @map("referral_code")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([email])
}

model GoalBlueprint {
  id        String   @id @default(uuid())
  userId    String   // Supabase user ID
  title     String   @db.Text // Goal description for similarity matching
  embedding Json?    // Pre-computed embedding vector for similarity search (openai/text-embedding-3-small)
  blueprint Json     // Complete execution trace
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([createdAt])
}

