    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "node-cache": "^5.1.2",
    "openai": "^4.63.0",
    "prisma": "^5.20.0",
    "stripe": "^17.3.1",
    "typescript": "^5.6.2",
    "zod": "^3.23.8"
