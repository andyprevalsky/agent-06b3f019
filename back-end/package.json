{
  "name": "navi-agent-backend",
  "version": "1.0.0",
  "description": "Agent Management Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "rm -f backend-logs.log && tsx watch src/server.ts 2>&1 | tee backend-logs.log",
    "dev:server": "rm -f backend-logs.log && tsx watch src/server.ts 2>&1 | tee backend-logs.log",
    "ngrok": "ngrok http 3001 --pooling-enabled",
    "kill:ngrok": "./scripts/kill-ngrok.sh",
    "build": "tsc && cp -r src/assets dist/assets",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "cleanup:all": "tsx scripts/cleanup-all-agents.ts",
    "cleanup:integrations": "tsx scripts/cleanup-integrations.ts",
    "clear:blueprints": "tsx scripts/clear-blueprints.ts",
    "getmessages:all": "tsx scripts/get-messages-all.ts",
    "backfill:pricing": "tsx scripts/backfill-agent-pricing.ts",
    "test:api": "tsx src/tests/api-test-suite.ts",
    "test:x402": "tsx src/tests/x402-e2e-test.ts",
    "test:all": "npm run test:api && npm run test:x402",
    "workers:check": "tsx scripts/query-temporal-workers.ts",
    "harbor:install": "echo 'Harbor installation: Install uv first (https://docs.astral.sh/uv/), then run: uv tool install harbor'",
    "harbor:check": "harbor --version || python3 -m harbor --version",
    "postinstall": "prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@browserbasehq/sdk": "^2.6.0",
    "@coinbase/cdp-sdk": "^1.40.0",
    "@coinbase/x402": "^0.7.3",
    "@prisma/client": "^5.20.0",
    "@supabase/supabase-js": "^2.76.1",
    "@temporalio/client": "^1.13.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.7.4",
    "adm-zip": "^0.5.16",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "e2b": "^2.11.1",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "multer": "^2.0.2",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "openai": "^4.63.0",
    "p-limit": "^7.2.0",
    "playwright": "^1.56.1",
    "prisma": "^5.20.0",
    "steel-sdk": "^0.16.0",
    "stripe": "^17.3.1",
    "typescript": "^5.6.2",
    "vcards-js": "^2.10.0",
    "x402-express": "^0.7.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@e2b/desktop": "^2.2.2",
    "@types/adm-zip": "^0.5.7",
    "@types/mime-types": "^3.0.1",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.1",
    "x402": "^0.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
