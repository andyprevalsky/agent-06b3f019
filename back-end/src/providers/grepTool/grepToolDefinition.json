          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Order messages in one agent_trajectories search. Defaults to newest_first. Ignored for other sources; display_order reports the order used.",
        "title": "Order"
      },
      "page_after": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "For the next page of one agent_trajectories search, pass the previous result's next_page_after path with the same query and order.",
        "title": "Page After"
      },
      "until": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Latest timestamp (ISO 8601) for each selected source whose filters accept until: agent_trajectories, transactions, documents, calendar, drive.",
        "title": "Until"
      },
