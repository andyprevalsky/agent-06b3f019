        "default": null,
        "description": "Agent trajectory root path/UUID searches its entire child tree; a child path narrows to that agent, and a message path to one message. An agent address in your tree (/root/outreach, as list_agents prints) scopes agent_network or agent_trajectories to that agent and every agent below it.",
        "title": "Trace Path"
      },
      "order": {
        "anyOf": [
