STRIPE_SECRET_KEY="sk_test_your-stripe-key-here"
# Must match /^price_[A-Za-z0-9]+$/ (the production bootstrap validator).
STRIPE_SUBSCRIPTION_PRICE_ID="price_1SoV6aJyWRw3Eb95N0jDMJIQ"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-signing-secret"
ADMIN_HEALTH_STRIPE_SECRET_KEY="sk_live_your-stripe-key-here"
ADMIN_HEALTH_STRIPE_ACCOUNT_ID="acct_your-live-stripe-account-id"
# Comma-separated Stripe charge/payment IDs omitted from company-health revenue.
ADMIN_HEALTH_STRIPE_EXCLUDED_CHARGE_IDS=""

# The /test_payment shop's own ACQUIRER key — the merchant side of a Rose purchase, kept apart
# from STRIPE_SECRET_KEY (billing: subscriptions, customers, personal purchase holds).
# Production must set this to a LIVE key: AgentCard refuses test_charge on live cards and Stripe
# test mode never reaches the card networks, so a live Rose-minted AgentCard can only be proven by
# a real acquirer authorization. STRIPE_SECRET_KEY must STAY test-mode until every production
# Subscription.stripeCustomerId is migrated — never flip the global key to fix a merchant problem.
# Unset in dev: /test_payment falls back to the billing key and logs a loud warning (test-mode
# rails, so only test-mode cards authorize). Production fails closed instead of falling back.
TEST_PAYMENT_MERCHANT_STRIPE_SECRET_KEY=""

# Amplitude read credentials for admin health funnel metrics
AMPLITUDE_API_KEY="your-amplitude-project-api-key"
AMPLITUDE_PROJECT_ID="your-amplitude-project-id"
AMPLITUDE_SECRET_KEY="your-amplitude-secret-key"

# Surge SMS (for sending SMS/MMS)
# Get these from: https://app.surge.app/
SURGE_API_KEY="sk_live_your-surge-api-key-here"
SURGE_ACCOUNT_ID="acct_your-surge-account-id-here"

# Outside NODE_ENV=production, Surge/WhatsApp/AgentPhone/Twilio Verify sends are
# mocked so dev stacks and tests never text real phones. Set to 1 to send for
# real from a local stack; benchmark stacks and PR previews ignore it.
# ALLOW_LIVE_MESSAGING=1

# AgentCard "for companies" — per-user OAuth 2.1 + PKCE + MCP.
# Lets the app issue/manage cards ON BEHALF OF each end user (cards isolated per
# (client, user)). A CONFIDENTIAL client is used: client_secret is sent on BOTH
# the token exchange and refresh. Never commit real secrets.
AGENTCARD_OAUTH_CLIENT_ID="your-agentcard-oauth-client-id"
AGENTCARD_OAUTH_CLIENT_SECRET="your-agentcard-oauth-client-secret"
# Public base URL of THIS backend (an ngrok tunnel in local dev). The OAuth
# redirect_uri is `${AGENTCARD_PUBLIC_URL}/api/agentcard/callback` and must match
# the client's registered redirect exactly.
AGENTCARD_PUBLIC_URL="https://your-tunnel.ngrok.app"
# Optional overrides (default to the live discovery values):
# AGENTCARD_MCP_URL="https://mcp.agentcard.sh/mcp"          # MCP resource (mandatory `resource` param)
# AGENTCARD_AUTH_SERVER_URL="https://mcp.agentcard.sh"      # OAuth issuer base
# AgentCard Organization MCP. API keys (`sk_*`) are retired for this surface.
# Create a confidential company client with:
# `agentcard companies credentials create --org <org-id> --name <name> --redirect-uri <url>`
# Purchases use these credentials to create hosted cardholder onboarding and
# company_flow cards.
AGENTCARD_ORG_OAUTH_CLIENT_ID="your-agentcard-org-oauth-client-id"
AGENTCARD_ORG_OAUTH_CLIENT_SECRET="acs_your-agentcard-org-client-secret"
# Organization MCP authenticates with the `acs_*` client secret as Bearer.
# Do not exchange it for a JWT — MCP rejects token-endpoint JWTs (`scope: api`).
# Optional direct bearer alternative (the same `acs_*` secret):
# AGENTCARD_ORG_MCP_ACCESS_TOKEN="acs_your-agentcard-org-client-secret"
# Optional hosted cardholder onboarding return URL. Defaults to
# `${AGENTCARD_PUBLIC_URL}/api/agentcard/onboarding/callback`.
# AGENTCARD_ONBOARDING_RETURN_URL="https://api.example.com/api/agentcard/onboarding/callback"
# AgentCard company-flow card mint polling:
# Keep this below the agents HTTP/activity timeouts so typed funding retries reach the workflow.
# AGENTCARD_COMPANY_FLOW_MAX_WAIT_MS=45000
# AGENTCARD_COMPANY_FLOW_RETRY_MS=2000
# Per-mint spend ceiling (cents). Default tracks the live AgentCard org-wallet
# available balance so company_flow cards cannot overdraw the float. Over-limit
# mints return 400 purchase_above_max_limit (tool error), not a subscribe gate.
# MAX_PURCHASE_CENTS=63288
# Production company-wallet monitoring. Sends one SMS per low-balance episode and
# re-arms after available balance recovers to the threshold.
# AGENTCARD_ORG_LOW_BALANCE_ALERT_PHONE="+15555550100"
AGENTCARD_ORG_LOW_BALANCE_THRESHOLD_CENTS=10000
AGENTCARD_ORG_WALLET_RELOAD_URL="https://app.agentcard.sh/org/your-org-id"
# AGENTCARD_ORG_WALLET_DEPOSIT_ADDRESS="0x..."
# DISABLE_AGENTCARD_ORG_WALLET_MONITOR="1"

# Coinbase CDP treasury — funds the AgentCard org wallet automatically.
# Flow: Coinbase CDP server wallet (USDC on Base) --transfer--> AgentCard org wallet.
# Triggered after each company_flow card mint debits the org wallet.
# Dedicated vars (falling back to CDP_API_KEY_ID/_SECRET/CDP_WALLET_SECRET) so the
# treasury key can rotate independently of x402 settlement auth.
# COINBASE_TREASURY_API_KEY_ID="organizations/<org>/apiKeys/<uuid>"   # or the bare uuid
# COINBASE_TREASURY_API_KEY_SECRET="base64-ed25519-private-key"
# No wallet secret needed: the rail sends via the Coinbase v2 API using the key's
# `Trade - Transfer` grant, not CDP server wallets (which additionally require
# completed business verification).
# COINBASE_TREASURY_NETWORK="base"                                    # or base-sepolia
# Auto top-up policy. DISABLED unless AGENTCARD_ORG_WALLET_AUTO_TOPUP_ENABLED=1.
# Below THRESHOLD, transfer enough to reach TARGET, clamped by MIN/MAX and a rolling
# 24h DAILY_CAP. Sandbox org wallets are never topped up.
# AGENTCARD_ORG_WALLET_AUTO_TOPUP_ENABLED="1"
# AGENTCARD_ORG_WALLET_TOPUP_THRESHOLD_CENTS=25000   # $250 floor
# AGENTCARD_ORG_WALLET_TOPUP_TARGET_CENTS=50000      # top up to $500
# AGENTCARD_ORG_WALLET_TOPUP_MIN_CENTS=1000
# AGENTCARD_ORG_WALLET_TOPUP_MAX_CENTS=50000
# AGENTCARD_ORG_WALLET_TOPUP_DAILY_CAP_CENTS=200000

# Brex Payments API — the fiat leg that refills the Coinbase treasury.
# Live host is platform.brexapis.com (api.brex.com also resolves).
# Required scopes: cash accounts read + transfers read/write.
#   GET  /v2/accounts/cash   -> balances (Primary checking / Vault / Treasury)
#   POST /v1/transfers       -> initiate an ACH/wire/book transfer
# BREX_API_TOKEN="bxt_your-brex-api-token"
# BREX_API_BASE_URL="https://platform.brexapis.com"

# Brex -> Coinbase fiat funding (the slow ACH/wire leg).
# HARD-DISABLED in code as of 2026-08-24 (broken rail was stacking transfers / burning cash).
# Setting COINBASE_FLOAT_REPLENISH_ENABLED=1 alone will NOT re-enable the demand-driven
# bank path; fiatPullEnabled() remains false until the rail is repaired and reviewed.
# The old hourly cron is not scheduled. Keep the flag at 0 in prod.
# BREX_COINBASE_COUNTERPARTY_ID="bkcp_..."   # Brex payment instrument for Coinbase
# Rail to send on: ACH | WIRE | SAME_DAY_ACH | CHECK. Defaults to WIRE.
# Cross-checked against the instrument's own type before every send; a mismatch is
# refused with brex_rail_mismatch rather than misrouted.
# BREX_TRANSFER_PROCESSING_TYPE="WIRE"
# BREX_ORIGINATING_ACCOUNT_ID="dpacc_..."   # defaults to highest-available account
# COINBASE_FLOAT_REPLENISH_ENABLED="0"

# Mintlify (API Documentation)
# Get your API key from: https://dashboard.mintlify.com/
MINTLIFY_API_KEY="mint_your-api-key-here"

# Plaid (bank account / financial data integration)
# Get keys from: https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID="your-plaid-client-id"
PLAID_SANDBOX_SECRET="your-plaid-sandbox-secret"
PLAID_PRODUCTION_SECRET="your-plaid-production-secret"
PLAID_ENV="sandbox"   # sandbox | production
PLAID_REDIRECT_URI="https://your-app.example.com/plaid-oauth-redirect"
PLAID_WEBHOOK_URL="https://your-backend.example.com/api/integrations/plaid/webhook"
DISABLE_PLAID_SYNC="0"

# Extra admin userIds (comma-separated) for NON-prod stacks only (e.g. the benchmark
# admin-bypass user). Leave UNSET in production — admins there are the two hardcoded IDs.
ADMIN_USER_IDS_EXTRA="00000000-0000-4000-8000-000000000105"

# Optional Lantern app-wide credential owner. Blank uses each requesting actor's
# own encrypted connection. A configured shared owner never falls back to actors.
# Internal machine authentication and an actor ID remain required.
LANTERN_PEOPLE_SHARED_USER_ID=""
