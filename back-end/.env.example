# Database
# Get this from: Supabase Dashboard → Project Settings → Database → Connection Pooling
# Use Transaction Pooler (port 6543) with pgbouncer=true for runtime queries
DATABASE_URL="postgresql://postgres.kzlurqihzaolhzsbkctf:[YOUR_PASSWORD]@aws-1-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase
# Your Supabase project URL
SUPABASE_URL="https://kzlurqihzaolhzsbkctf.supabase.co"
# Service role key for storage operations (Supabase Dashboard → Settings → API → service_role)
SUPABASE_SERVICE_KEY="your-supabase-service-role-key"

# OpenRouter API (for LLM)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."

# Backend API Key (for internal service-to-service calls)
# Generate a secure random string for production
BACKEND_API_KEY="your-secure-backend-api-key-here"

# Temporal Cloud (for workflow orchestration)
# Get these from: Temporal Cloud Dashboard → Namespace Settings
TEMPORAL_ADDRESS="us-east-1.aws.api.temporal.io:7233"
TEMPORAL_NAMESPACE="rose-labs-us-east-1.tch2n"
TEMPORAL_API_KEY="your-temporal-api-key-here"
TEMPORAL_TASK_QUEUE="navi-agent-tasks"

# Server Configuration
PORT=3001
NODE_ENV="development"
BACKEND_URL="http://localhost:3001"

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS="http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8081"

# Steel Browser API (for browser automation)
# Get your API key from: https://app.steel.dev/
STEEL_API_KEY="ste-your-api-key-here"

# E2B (for Claude Code and Codex Code sandboxes)
# Get your API key from: https://e2b.dev/
E2B_API_KEY="e2b_your-api-key-here"
E2B_CLAUDE_CODE_TEMPLATE_ID="your-template-id-here"
E2B_CODEX_CODE_TEMPLATE_ID="codex-code"
CODEX_CODE_MODEL="gpt-5.4"
ANTHROPIC_API_KEY="sk-ant-your-api-key-here"

# GitHub (for spawning Claude Code agents with repo access)
# PAT for rose-gh-agent user - enables repo cloning in Claude Code sandboxes
GITHUB_TOKEN="ghp_your-personal-access-token-here"

# Surge SMS (for sending SMS/MMS)
# Get these from: https://app.surge.app/
SURGE_API_KEY="sk_live_your-surge-api-key-here"
SURGE_ACCOUNT_ID="acct_your-surge-account-id-here"

# Mintlify (API Documentation)
# Get your API key from: https://dashboard.mintlify.com/
MINTLIFY_API_KEY="mint_your-api-key-here"
