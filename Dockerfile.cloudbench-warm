# Cloud-exclusive benchmark box — WARM / KEEP-ALIVE variant.
#
# Same baked dependencies as Dockerfile.cloudbench (Node + Python + Postgres +
# node_modules + agents venv), but the CMD is a keep-alive (`sleep infinity`)
# instead of running the benchmark on boot. The persistent machine built from
# this image boots IDLE and waits for SSH-triggered per-run scripts
# (scripts/cloudbench-run.sh, invoked by scripts/run-bench-cloud).
#
# Lifecycle contrast with the one-shot image:
#   - Dockerfile.cloudbench  → CMD runs the benchmark, machine destroyed per run.
#   - Dockerfile.cloudbench-warm → CMD idles; machine is START/STOPPED, never
#     destroyed per run. Rebuilt RARELY (only when deps change). Branch code +
#     the WMH model artifact live on a Fly VOLUME (/data), NOT in the image:
#       /data/repo         → git checkout of the branch under test (fast-synced)
#       /data/world-model  → cached WMH model artifact (built via --refresh-wmh)
#
# Why bake deps at build time: npm install + prisma generate + the agents venv
# (pip install, incl. the git+https world-model-harness dep and playwright) are
# slow. Baking them means a warm start only has to git-sync the branch and boot
# the stack — no dependency install on the per-run hot path.
#
# Why system Postgres (not Docker-in-Docker): DinD on Fly needs a privileged
# runtime and is fragile. run.sh detects the absence of a Docker daemon and uses
# its system-Postgres fallback (db "victoria", port 5432); we install the
# Postgres server + client here so that path just works.

# ── Base: Node 20 + Debian bookworm (ships Python 3.11.2) ──────────────────
FROM node:20-bookworm AS native-base

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    NODE_ENV=development

# ── System packages ───────────────────────────────────────────────────────
# postgresql/-client: system-Postgres fallback (run.sh path when no Docker).
# python3-venv/-dev + build-essential: agents venv + native pip builds
#   (eth-account/coincurve, etc.). git: the git+https world-model-harness dep
#   AND the per-run branch git-sync into /data/repo.
# curl/lsof/procps/net-tools/psmisc: run.sh health/port bookkeeping (lsof,
#   fuser, ps, kill). ca-certificates: TLS to Temporal Cloud/Supabase/R2/Rose.
# rsync: mirror the baked node_modules/venv into the volume checkout at /data/repo.
RUN apt-get update && apt-get install -y --no-install-recommends \
        postgresql \
        postgresql-client \
        python3 \
        python3-venv \
        python3-dev \
        build-essential \
        pkg-config \
        libpq-dev \
        git \
        rsync \
        curl \
        ca-certificates \
        lsof \
        procps \
        psmisc \
        net-tools \
        gosu \
    && rm -rf /var/lib/apt/lists/*

# Compile pgvector for the installed server; third-party binary/JIT packages can differ.
COPY scripts/cloudbench-install-pgvector.sh /tmp/rose-cloudbench-install-pgvector.sh
RUN bash /tmp/rose-cloudbench-install-pgvector.sh \
    && rm -f /tmp/rose-cloudbench-install-pgvector.sh \
    && rm -rf /var/lib/apt/lists/*

# Real isolated phone/payment benchmarks expose each per-machine frontend and
# backend callback route through its own random Cloudflare Quick Tunnel. Bake
# the agent into new warm images; cloudbench-run.sh also installs it as a
# compatibility fallback for already-provisioned warm snapshots.
RUN curl -fsSL \
        "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-$(dpkg --print-architecture).deb" \
        -o /tmp/cloudflared.deb \
    && apt-get install -y --no-install-recommends /tmp/cloudflared.deb \
    && rm -f /tmp/cloudflared.deb

# The documented fallback must also exist when a Quick Tunnel cannot route.
COPY scripts/cloudbench-install-ngrok.sh /tmp/rose-cloudbench-install-ngrok.sh
RUN bash /tmp/rose-cloudbench-install-ngrok.sh && rm -f /tmp/rose-cloudbench-install-ngrok.sh

# ── Non-root user that owns the repo + can drive the Postgres cluster ──────
# run.sh's system-Postgres fallback uses `su - postgres` / pg_ctlcluster; the
# per-run script runs those bits via sudo-less gosu as needed. The app itself
# runs as `rose`. Create /app owned by rose BEFORE WORKDIR/COPY so `npm install`
# (run as rose) can create /app/node_modules.
RUN useradd --create-home --shell /bin/bash rose \
    && mkdir -p /app \
    && chown rose:rose /app

WORKDIR /app

# Install directly in the final dependency layer. The shared Bash helper runs
# the unchanged JavaScript/Prisma and Python installers concurrently, joins both,
# and removes only npm package-download caches/logs before distribution. No large
# dependency or home trees are copied between stages.
FROM native-base AS runtime
USER rose
RUN mkdir -p back-end/prisma front-end agents
COPY --chown=rose:rose package*.json /app/
COPY --chown=rose:rose back-end/package.json back-end/package-lock.json /app/back-end/
COPY --chown=rose:rose front-end/package.json front-end/package-lock.json /app/front-end/
COPY --chown=rose:rose front-end/scripts /app/front-end/scripts
COPY --chown=rose:rose back-end/prisma /app/back-end/prisma
COPY --chown=rose:rose agents/requirements.txt /app/agents/requirements.txt
COPY --chown=rose:rose agents/vendor /app/agents/vendor
COPY --chown=rose:rose scripts/cloudbench-install-image-deps.sh /tmp/rose-cloudbench-install-image-deps.sh
RUN bash /tmp/rose-cloudbench-install-image-deps.sh

# Keep manifests/schema before installation and source last, so source-only
# changes do not invalidate installed dependencies. Local deps/secrets remain
# excluded by .dockerignore; the complete source still supplies donor fingerprints.
COPY --chown=rose:rose . /app
RUN bash /tmp/rose-cloudbench-install-image-deps.sh --verify-frontend
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# ── Keep-alive CMD ─────────────────────────────────────────────────────────
# The persistent machine boots IDLE and waits for SSH-triggered runs. Deps stay
# baked in /app; branch code + the cached WMH model live on the /data volume.
# The per-run work is driven entirely over SSH (scripts/cloudbench-run.sh), so
# the boot process just has to stay alive.
USER root
CMD ["bash", "-c", "exec sleep infinity"]
