+/**
+ * The first-party web origin a stored localStorage row restores into, or null.
+ * Mac clients before the storage-key framing fix dropped the key's first byte
+ * (`ttps://host`); repair only that exact loss. Partitioned third-party keys
+ * (`<origin>/^0<top-level-site>`) and extension/internal schemes have no
+ * first-party document to restore through.
+ */
+function restorableLocalStorageOrigin(storageKey: string): string | null {
+  const candidate = /^ttps?:\/\//.test(storageKey) ? `h${storageKey}` : storageKey;
+  try {
+    const url = new URL(candidate);
+    const web = url.protocol === 'https:' || url.protocol === 'http:';
+    return web && url.origin === candidate ? candidate : null;
+  } catch {
+    return null;
+  }
+}
