+/**
+ * rose-cli — config layer
+ */
+
+export const LOG_TAG = 'RoseCli';
+
+/** Renderer → main: (re)write the launcher if needed and return its path. */
+export const ENSURE_INSTALLED_CHANNEL = 'roseCli:ensureInstalled';
+
+/** The launcher, relative to the user's home. Never added to PATH or shell rc files. */
+export const LAUNCHER_RELATIVE = '.rose/bin/rose';
+export const LAUNCHER_MODE = 0o755;
+/** Mode for ~/.rose and ~/.rose/bin when the app creates them (existing dirs are left alone). */
+export const LAUNCHER_DIR_MODE = 0o700;
+
+/** Packaged layout: <resources>/rose-cli/bin/rose.mjs (package.json build.extraResources). */
+export const PACKAGED_CLI_DIR = 'rose-cli';
+/** Dev layout: <repo>/scripts/lib/rose-sync/bin/rose.mjs. */
+export const DEV_CLI_DIR = 'scripts/lib/rose-sync';
+export const CLI_ENTRY_RELATIVE = 'bin/rose.mjs';
+/** Compiled module dir (dist/main/main/domains/rose-cli) → repository root. */
+export const COMPILED_DIR_TO_REPO_ROOT = '../../../../../..';
+
+/** Import from this Mac (`rose import detect|scan|apply --json`). */
+export const PICK_FOLDER_CHANNEL = 'roseCli:pickProjectFolder';
+export const IMPORT_PROJECT_CHANNEL = 'roseCli:importProject';
+export const CANCEL_IMPORT_CHANNEL = 'roseCli:cancelImport';
+/** Main → renderer: one parsed stdout object per send, then the final exit. */
+export const IMPORT_EVENT_CHANNEL = 'roseCli:importEvent';
+export const PICK_FOLDER_TITLE = 'Choose a project to import';
+export const PICK_FOLDER_BUTTON = 'Import';
+
+/** Same format the backend mints (back-end/src/domains/projects/cliLoginService.ts). */
+export const LOGIN_CODE_PATTERN = /^rlc_[A-Za-z0-9_-]{32}$/;
+/** `import scan` reads the one-time code from here: argv is visible to every process (`ps`). */
+export const LOGIN_CODE_ENV = 'ROSE_LOGIN_CODE';
+export const IMPORT_AGENTS = ['codex', 'claude'] as const;
+export const IMPORT_MAX_PROJECT_CHARS = 200;
+export const IMPORT_MAX_URL_CHARS = 2_048;
+/** Bound on one stdout line and on the serialized apply plan (plans can be large). */
+export const IMPORT_MAX_JSON_CHARS = 16 * 1024 * 1024;
+/** SIGTERM first; SIGKILL the process group if it is still running after this. */
+export const IMPORT_CANCEL_GRACE_MS = 5_000;
+
+export const IMPORT_BUSY_ERROR = 'An import is already running on this Mac.';
+export const IMPORT_FAILED_MESSAGE = 'The import stopped before it finished.';
+export const IMPORT_CANCELED_MESSAGE = 'The import was canceled.';
diff --git a/mac-app/main/domains/rose-cli/repo.ts b/mac-app/main/domains/rose-cli/repo.ts
new file mode 100644
index 0000000000..e9c4f8a1db
--- /dev/null
+++ b/mac-app/main/domains/rose-cli/repo.ts
@@ -0,0 +1,122 @@
+/**
+ * rose-cli — repo layer (filesystem I/O only, no business logic).
+ */
+import { spawn } from 'child_process';
+import { randomBytes } from 'crypto';
+import fs from 'fs';
+import path from 'path';
+import { LAUNCHER_DIR_MODE, LAUNCHER_MODE } from './config';
+import type { ImportChild, ImportSpawnSpec, LauncherIo } from './types';
+
+function isNotFound(error: unknown): boolean {
+  return (
+    typeof error === 'object' &&
+    error !== null &&
+    (error as NodeJS.ErrnoException).code === 'ENOENT'
+  );
+}
+
+export async function pathExists(p: string): Promise<boolean> {
+  try {
+    await fs.promises.access(p, fs.constants.R_OK);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+export async function readLauncher(p: string): Promise<{ content: string; mode: number } | null> {
+  try {
+    const [content, stat] = await Promise.all([
+      fs.promises.readFile(p, 'utf8'),
+      fs.promises.stat(p),
+    ]);
+    return { content, mode: stat.mode & 0o777 };
+  } catch (error) {
+    if (isNotFound(error)) return null;
+    throw error;
+  }
+}
+
+/**
+ * Write a sibling temp file (exclusive create, so nothing pre-planted is
+ * followed), set 0755 explicitly (the umask may have cleared bits), then
+ * rename it over the launcher: a shell never sees a half-written `rose`.
+ */
+export async function writeLauncherAtomic(p: string, content: string): Promise<void> {
+  const dir = path.dirname(p);
+  await fs.promises.mkdir(dir, { recursive: true, mode: LAUNCHER_DIR_MODE });
+  const temp = path.join(
+    dir,
+    `.${path.basename(p)}.${process.pid}.${randomBytes(6).toString('hex')}.tmp`
+  );
+  try {
+    await fs.promises.writeFile(temp, content, { mode: LAUNCHER_MODE, flag: 'wx' });
+    await fs.promises.chmod(temp, LAUNCHER_MODE);
+    await fs.promises.rename(temp, p);
+  } catch (error) {
+    await fs.promises.rm(temp, { force: true });
+    throw error;
+  }
+}
+
+export const launcherIo: LauncherIo = {
+  exists: pathExists,
+  readLauncher,
+  writeLauncher: writeLauncherAtomic,
+};
+
+export async function isDirectory(p: string): Promise<boolean> {
+  try {
+    return (await fs.promises.stat(p)).isDirectory();
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * Start `rose import …` argv-style in its own process group (detached), so a
+ * cancel reaches the CLI and the coding agent it runs. stderr is drained and
+ * dropped (tool noise, possibly secrets); stdout arrives as UTF-8 text.
+ */
+export function spawnImport(spec: ImportSpawnSpec): ImportChild {
+  const child = spawn(spec.command, spec.args, {
+    cwd: spec.cwd,
+    env: spec.env,
+    detached: true,
+    stdio: [spec.stdin === null ? 'ignore' : 'pipe', 'pipe', 'pipe'],
+  });
+  const closeListeners: Array<(code: number | null) => void> = [];
+  let closed = false;
+  const finish = (code: number | null): void => {
+    if (closed) return;
+    closed = true;
+    for (const listener of closeListeners) listener(code);
+  };
+  child.once('error', () => finish(null));
+  child.once('close', (code) => finish(code));
+  child.stdout?.setEncoding('utf8');
+  child.stderr?.resume();
+  if (spec.stdin !== null && child.stdin !== null) {
+    child.stdin.on('error', () => undefined);
+    child.stdin.end(spec.stdin);
+  }
+  return {
+    onStdout: (listener) => {
+      child.stdout?.on('data', (chunk: string) => listener(chunk));
+    },
+    onClose: (listener) => {
+      closeListeners.push(listener);
+    },
+    kill: (signal) => {
+      if (closed) return;
+      const pid = child.pid;
+      try {
+        if (pid !== undefined && pid > 1) process.kill(-pid, signal);
+        else child.kill(signal);
+      } catch {
+        child.kill(signal);
+      }
+    },
+  };
+}
diff --git a/mac-app/main/domains/rose-cli/runtime.ts b/mac-app/main/domains/rose-cli/runtime.ts
new file mode 100644
index 0000000000..5bdc498023
--- /dev/null
+++ b/mac-app/main/domains/rose-cli/runtime.ts
@@ -0,0 +1,138 @@
+/**
+ * rose-cli — runtime layer (Electron wiring)
+ *
+ *   app ready ─► ensureInstalled() ─► ~/.rose/bin/rose (0755, atomic rename)
+ *                  ELECTRON_RUN_AS_NODE=1 exec '<app execPath>' '<resources>/rose-cli/bin/rose.mjs' "$@"
+ *                  rewritten on every start, so it follows a moved or translocated app
+ *   IPC: roseCli:ensureInstalled   → { success, path?, error? } (the web UI shows the path)
+ *        roseCli:pickProjectFolder → native folder picker → { canceled, path? }
+ *        roseCli:importProject     → ImportRunManager (serviceImport.ts) → { runId } | { error }
+ *        roseCli:cancelImport      → SIGTERM, then SIGKILL after a grace period
+ *   event: roseCli:importEvent (every window) — one per CLI stdout object, then exit
+ *
+ * Never edits the user's shell rc files or PATH.
+ */
+import { randomUUID } from 'crypto';
+import {
+  BrowserWindow,
+  app,
+  dialog,
+  ipcMain,
+  type OpenDialogOptions,
+  type WebContents,
+} from 'electron';
+import { logConsole, logConsoleError, logIpc } from '../../base/logger';
+import { getAugmentedEnv } from '../../base/shellEnv';
+import { getErrorMessage } from '../../../shared/utils/error';
+import {
+  CANCEL_IMPORT_CHANNEL,
+  ENSURE_INSTALLED_CHANNEL,
+  IMPORT_EVENT_CHANNEL,
+  IMPORT_PROJECT_CHANNEL,
+  LOG_TAG,
+  PICK_FOLDER_BUTTON,
+  PICK_FOLDER_CHANNEL,
+  PICK_FOLDER_TITLE,
+} from './config';
+import { isDirectory, launcherIo, spawnImport } from './repo';
+import { cliEntryPath, ensureLauncher, launcherPathFor } from './service';
+import { ImportRunManager, folderPickResult } from './serviceImport';
+import type {
+  LauncherTarget,
+  RoseCliFolderPickResult,
+  RoseCliImportEvent,
+  RoseCliInstallResult,
+} from './types';
+
+let started = false;
+
+function currentTarget(): LauncherTarget {
+  return {
+    launcherPath: launcherPathFor(app.getPath('home')),
+    execPath: process.execPath,
+    cliEntry: cliEntryPath({
+      isPackaged: app.isPackaged,
+      resourcesPath: process.resourcesPath,
+      moduleDir: __dirname,
+    }),
+  };
+}
+
+export async function ensureInstalled(): Promise<RoseCliInstallResult> {
+  let target: LauncherTarget;
+  try {
+    target = currentTarget();
+  } catch (error) {
+    return { success: false, error: `Could not locate the rose CLI: ${getErrorMessage(error)}` };
+  }
+  return await ensureLauncher(target, launcherIo);
+}
+
+function broadcastImportEvent(event: RoseCliImportEvent): void {
+  for (const window of BrowserWindow.getAllWindows()) {
+    if (!window.isDestroyed()) window.webContents.send(IMPORT_EVENT_CHANNEL, event);
+  }
+}
+
+const importRuns = new ImportRunManager({
+  isDirectory,
+  ensureLauncher: ensureInstalled,
+  env: getAugmentedEnv,
+  home: () => app.getPath('home'),
+  spawn: spawnImport,
+  emit: broadcastImportEvent,
+  newRunId: randomUUID,
+  setTimer: (fn, ms) => {
+    const timer = setTimeout(fn, ms);
+    return () => clearTimeout(timer);
+  },
+});
+
+async function pickProjectFolder(sender: WebContents): Promise<RoseCliFolderPickResult> {
+  const options: OpenDialogOptions = {
+    title: PICK_FOLDER_TITLE,
+    buttonLabel: PICK_FOLDER_BUTTON,
+    properties: ['openDirectory'],
+  };
+  const window = BrowserWindow.getFocusedWindow() ?? BrowserWindow.fromWebContents(sender);
+  try {
+    const picked =
+      window === null
+        ? await dialog.showOpenDialog(options)
+        : await dialog.showOpenDialog(window, options);
+    return folderPickResult(picked);
+  } catch (error) {
+    logConsoleError(LOG_TAG, 'Folder picker failed', error);
+    return { canceled: true };
+  }
+}
+
+function registerHandlers(): void {
+  ipcMain.handle(ENSURE_INSTALLED_CHANNEL, async () => {
+    logIpc('IN', ENSURE_INSTALLED_CHANNEL);
+    return await ensureInstalled();
+  });
+  ipcMain.handle(PICK_FOLDER_CHANNEL, async (event) => {
+    logIpc('IN', PICK_FOLDER_CHANNEL);
+    return await pickProjectFolder(event.sender);
+  });
+  ipcMain.handle(IMPORT_PROJECT_CHANNEL, async (_event, request: unknown) => {
+    logIpc('IN', IMPORT_PROJECT_CHANNEL);
+    return await importRuns.start(request);
+  });
+  ipcMain.handle(CANCEL_IMPORT_CHANNEL, (_event, runId: unknown) => {
+    logIpc('IN', CANCEL_IMPORT_CHANNEL);
+    importRuns.cancel(runId);
+  });
+}
+
+export function startRoseCli(): void {
+  if (started) return;
+  started = true;
+  registerHandlers();
+  app.on('before-quit', () => importRuns.cancelAll());
+  void ensureInstalled().then((result) => {
+    if (result.success) logConsole(LOG_TAG, `rose CLI launcher ready at ${result.path ?? ''}`);
+    else logConsoleError(LOG_TAG, result.error ?? 'rose CLI launcher install failed');
+  });
+}
diff --git a/mac-app/main/domains/rose-cli/service.ts b/mac-app/main/domains/rose-cli/service.ts
new file mode 100644
index 0000000000..3233a1d1c2
--- /dev/null
+++ b/mac-app/main/domains/rose-cli/service.ts
@@ -0,0 +1,84 @@
+/**
+ * rose-cli — service layer (pure logic; filesystem injected as LauncherIo)
+ *
+ *   ensureLauncher ─► CLI entry present? ─no─► { success: false, error }
+ *                    └► launcher text/mode current? ─no─► atomic write (0755)
+ *                    └► { success: true, path: ~/.rose/bin/rose }
+ *
+ * The launcher runs the app's own binary as Node on the bundled CLI, so it
+ * needs no npm, no global install and no PATH or shell rc edits.
+ */
+import path from 'path';
+import { getErrorMessage } from '../../../shared/utils/error';
+import {
+  CLI_ENTRY_RELATIVE,
+  COMPILED_DIR_TO_REPO_ROOT,
+  DEV_CLI_DIR,
+  LAUNCHER_MODE,
+  LAUNCHER_RELATIVE,
+  PACKAGED_CLI_DIR,
+} from './config';
+import type { LauncherIo, LauncherTarget, RoseCliInstallResult } from './types';
+
+/** POSIX single-quoted shell word: safe for spaces, quotes, `$`, newlines. */
+export function shellSingleQuote(value: string): string {
+  return `'${value.replace(/'/g, `'\\''`)}'`;
+}
+
+export function launcherPathFor(home: string): string {
+  return path.join(home, LAUNCHER_RELATIVE);
+}
+
+/** The bundled CLI entry: Resources/rose-cli when packaged, the repo checkout in dev. */
+export function cliEntryPath(params: {
+  isPackaged: boolean;
+  resourcesPath: string;
+  /** Directory of the compiled rose-cli module (dist/main/main/domains/rose-cli). */
+  moduleDir: string;
+}): string {
+  return params.isPackaged
+    ? path.join(params.resourcesPath, PACKAGED_CLI_DIR, CLI_ENTRY_RELATIVE)
+    : path.resolve(params.moduleDir, COMPILED_DIR_TO_REPO_ROOT, DEV_CLI_DIR, CLI_ENTRY_RELATIVE);
+}
+
+/** The `rose` launcher: the app's binary as Node on the bundled CLI, argv passed through. */
+export function buildLauncherScript(target: { execPath: string; cliEntry: string }): string {
+  const moved = `rose: the Rose app is no longer at ${target.execPath}. Open Rose once to repair this launcher.`;
+  return [
+    '#!/bin/sh',
+    '# rose CLI launcher. The Rose Mac app rewrites this file on every start so it',
+    '# always runs the CLI bundled with the installed app, wherever the app lives.',
+    `if [ ! -x ${shellSingleQuote(target.execPath)} ]; then`,
+    `  printf '%s\\n' ${shellSingleQuote(moved)} >&2`,
+    '  exit 127',
+    'fi',
+    `ELECTRON_RUN_AS_NODE=1 exec ${shellSingleQuote(target.execPath)} ${shellSingleQuote(target.cliEntry)} "$@"`,
+    '',
+  ].join('\n');
+}
+
+/** Write the launcher when it is missing, stale or not 0755; never throws. */
+export async function ensureLauncher(
+  target: LauncherTarget,
+  io: LauncherIo
+): Promise<RoseCliInstallResult> {
+  try {
+    if (!(await io.exists(target.cliEntry))) {
+      return {
+        success: false,
+        error: `This Rose app build is missing its rose CLI (${target.cliEntry}). Reinstall Rose from roselabs.ai.`,
+      };
+    }
+    const content = buildLauncherScript(target);
+    const current = await io.readLauncher(target.launcherPath);
+    if (current === null || current.content !== content || current.mode !== LAUNCHER_MODE) {
+      await io.writeLauncher(target.launcherPath, content);
+    }
+    return { success: true, path: target.launcherPath };
+  } catch (error) {
+    return {
+      success: false,
+      error: `Could not install the rose CLI at ${target.launcherPath}: ${getErrorMessage(error)}`,
+    };
+  }
+}
diff --git a/mac-app/main/domains/rose-cli/serviceImport.ts b/mac-app/main/domains/rose-cli/serviceImport.ts
new file mode 100644
index 0000000000..34233d9da6
--- /dev/null
+++ b/mac-app/main/domains/rose-cli/serviceImport.ts
@@ -0,0 +1,393 @@
+/**
+ * rose-cli — import service (pure logic; process, fs and IPC injected)
+ *
+ *   renderer request ─► validateImportRequest (folder is a dir, http(s) API,
+ *                       rlc_ login code) ─► buildImportInvocation (main-built argv)
+ *     ─► ensure launcher ─► spawn ~/.rose/bin/rose import <action> … --json
+ *          cwd = folder, login-shell PATH, apply plan on stdin (`--plan -`),
+ *          scan login code in ROSE_LOGIN_CODE (never argv: `ps` shows argv to everyone)
+ *     stdout ─► JsonLineParser ─► { ...object, runId } per line (malformed dropped)
+ *     close  ─► [generic error if non-zero and no CLI error] ─► { runId, event: 'exit', code }
+ *   One run at a time. cancel: SIGTERM the process group, SIGKILL after a grace period.
+ */
+import path from 'path';
+import { getErrorMessage } from '../../../shared/utils/error';
+import {
+  IMPORT_AGENTS,
+  IMPORT_BUSY_ERROR,
+  IMPORT_CANCELED_MESSAGE,
+  IMPORT_CANCEL_GRACE_MS,
+  IMPORT_FAILED_MESSAGE,
+  IMPORT_MAX_JSON_CHARS,
+  IMPORT_MAX_PROJECT_CHARS,
+  IMPORT_MAX_URL_CHARS,
+  LOGIN_CODE_ENV,
+  LOGIN_CODE_PATTERN,
+} from './config';
+import type {
+  ImportChild,
+  ImportInvocation,
+  ImportSpawnSpec,
+  RoseCliFolderPickResult,
+  RoseCliImportEvent,
+  RoseCliImportStartResult,
+  RoseCliInstallResult,
+  ValidImportRequest,
+} from './types';
+
+class ImportRequestError extends Error {}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+function hasControlCharacters(value: string): boolean {
+  for (const character of value) {
+    const code = character.charCodeAt(0);
+    if (code < 0x20 || code === 0x7f) return true;
+  }
+  return false;
+}
+
+async function checkFolder(
+  raw: unknown,
+  isDirectory: (p: string) => Promise<boolean>
+): Promise<string> {
+  if (typeof raw !== 'string' || !path.isAbsolute(raw) || raw.includes('\0')) {
+    throw new ImportRequestError('Choose a project folder on this Mac.');
+  }
+  const folder = path.resolve(raw);
+  if (!(await isDirectory(folder))) {
+    throw new ImportRequestError('That project folder does not exist on this Mac.');
+  }
+  return folder;
+}
+
+function checkApiUrl(raw: unknown): string {
+  const invalid = new ImportRequestError('The Rose API address must be an http(s) URL.');
+  if (typeof raw !== 'string' || raw.length > IMPORT_MAX_URL_CHARS) throw invalid;
+  let url: URL;
+  try {
+    url = new URL(raw);
+  } catch {
+    throw invalid;
+  }
+  if (url.protocol !== 'http:' && url.protocol !== 'https:') throw invalid;
+  return raw;
+}
+
+function checkLoginCode(raw: unknown): string {
+  if (typeof raw !== 'string' || !LOGIN_CODE_PATTERN.test(raw)) {
+    throw new ImportRequestError('The Rose sign-in code is invalid. Start the import again.');
+  }
+  return raw;
+}
+
+function optionalProject(raw: unknown): { project?: string } {
+  if (raw === undefined || raw === null) return {};
+  if (
+    typeof raw !== 'string' ||
+    raw.trim() === '' ||
+    raw.length > IMPORT_MAX_PROJECT_CHARS ||
+    hasControlCharacters(raw)
+  ) {
+    throw new ImportRequestError('The Rose project name is invalid.');
+  }
+  return { project: raw };
+}
+
+function optionalAgent(raw: unknown): { agent?: (typeof IMPORT_AGENTS)[number] } {
+  if (raw === undefined || raw === null) return {};
+  const agent = IMPORT_AGENTS.find((candidate) => candidate === raw);
+  if (agent === undefined) throw new ImportRequestError('Choose Claude Code or Codex.');
+  return { agent };
+}
+
+function checkPlan(raw: unknown): string {
+  const invalid = new ImportRequestError('The import plan is invalid. Scan the folder again.');
+  if (typeof raw !== 'object' || raw === null) throw invalid;
+  let json: string;
+  try {
+    json = JSON.stringify(raw);
+  } catch {
+    throw invalid;
+  }
+  if (json.length > IMPORT_MAX_JSON_CHARS) {
+    throw new ImportRequestError('The import plan is too large.');
+  }
+  return json;
+}
+
+async function parseRequest(
+  raw: unknown,
+  isDirectory: (p: string) => Promise<boolean>
+): Promise<ValidImportRequest> {
+  if (!isRecord(raw)) throw new ImportRequestError('Unsupported import request.');
+  if (raw.action === 'detect') return { action: 'detect' };
+  if (raw.action === 'scan') {
+    return {
+      action: 'scan',
+      folder: await checkFolder(raw.folder, isDirectory),
+      loginCode: checkLoginCode(raw.loginCode),
+      apiUrl: checkApiUrl(raw.apiUrl),
+      ...optionalProject(raw.project),
+      ...optionalAgent(raw.agent),
+    };
+  }
+  if (raw.action === 'apply') {
+    if (typeof raw.githubImport !== 'boolean') {
+      throw new ImportRequestError('Unsupported import request.');
+    }
+    return {
+      action: 'apply',
+      folder: await checkFolder(raw.folder, isDirectory),
+      planJson: checkPlan(raw.plan),
+      githubImport: raw.githubImport,
+      apiUrl: checkApiUrl(raw.apiUrl),
+    };
+  }
+  throw new ImportRequestError('Unsupported import action.');
+}
+
+/** A renderer request → a validated request (only known fields survive), or a readable error. */
+export async function validateImportRequest(
+  raw: unknown,
+  isDirectory: (p: string) => Promise<boolean>
+): Promise<{ request: ValidImportRequest } | { error: string }> {
+  try {
+    return { request: await parseRequest(raw, isDirectory) };
+  } catch (error) {
+    if (error instanceof ImportRequestError) return { error: error.message };
+    throw error;
+  }
+}
+
+/** The exact `rose` argv and run env for a validated request (never renderer-supplied). */
+export function buildImportInvocation(request: ValidImportRequest): ImportInvocation {
+  if (request.action === 'detect') {
+    return { args: ['import', 'detect', '--json'], env: {}, folder: null, stdin: null };
+  }
+  if (request.action === 'scan') {
+    return {
+      args: [
+        'import',
+        'scan',
+        '--dir',
+        request.folder,
+        ...(request.agent === undefined ? [] : ['--agent', request.agent]),
+        ...(request.project === undefined ? [] : ['--project', request.project]),
+        '--api',
+        request.apiUrl,
+        '--json',
+      ],
+      env: { [LOGIN_CODE_ENV]: request.loginCode },
+      folder: request.folder,
+      stdin: null,
+    };
+  }
+  return {
+    args: [
+      'import',
+      'apply',
+      '--dir',
+      request.folder,
+      '--plan',
+      '-',
+      ...(request.githubImport ? ['--github-import'] : []),
+      '--api',
+      request.apiUrl,
+      '--json',
+    ],
+    env: {},
+    folder: request.folder,
+    stdin: request.planJson,
+  };
+}
+
+/** The app's env (login-shell PATH) minus any inherited login code, plus this run's env. */
+export function importRunEnv(
+  base: NodeJS.ProcessEnv,
+  extra: Record<string, string>
+): NodeJS.ProcessEnv {
+  const env: NodeJS.ProcessEnv = { ...base };
+  delete env[LOGIN_CODE_ENV];
+  return { ...env, ...extra };
+}
+
+/** Native folder picker result → the renderer shape. */
+export function folderPickResult(picked: {
+  canceled: boolean;
+  filePaths: string[];
+}): RoseCliFolderPickResult {
+  const [folder] = picked.filePaths;
+  if (picked.canceled || folder === undefined || folder === '') return { canceled: true };
+  return { canceled: false, path: folder };
+}
+
+/** Splits stdout into lines and hands every JSON object line on; anything else is dropped. */
+export class JsonLineParser {
+  private buffer = '';
+  private skipping = false;
+  malformed = 0;
+
+  constructor(
+    private readonly onObject: (value: Record<string, unknown>) => void,
+    private readonly maxLineChars = IMPORT_MAX_JSON_CHARS
+  ) {}
+
+  push(chunk: string): void {
+    let text = chunk;
+    let newline = text.indexOf('\n');
+    while (newline !== -1) {
+      const line = this.buffer + text.slice(0, newline);
+      this.buffer = '';
+      if (this.skipping) this.skipping = false;
+      else this.handle(line);
+      text = text.slice(newline + 1);
+      newline = text.indexOf('\n');
+    }
+    if (this.skipping) return;
+    this.buffer += text;
+    if (this.buffer.length > this.maxLineChars) {
+      // An unbounded line would grow forever: drop it and resume at the next newline.
+      this.buffer = '';
+      this.skipping = true;
+      this.malformed += 1;
+    }
+  }
+
+  /** The process closed: a last line without a trailing newline still counts. */
+  end(): void {
+    if (!this.skipping && this.buffer !== '') this.handle(this.buffer);
+    this.buffer = '';
+    this.skipping = false;
+  }
+
+  private handle(line: string): void {
+    const trimmed = line.trim();
+    if (trimmed === '') return;
+    if (trimmed.length > this.maxLineChars) {
+      this.malformed += 1;
+      return;
+    }
+    try {
+      const value: unknown = JSON.parse(trimmed);
+      if (isRecord(value)) this.onObject(value);
+      else this.malformed += 1;
+    } catch {
+      this.malformed += 1;
+    }
+  }
+}
+
+export interface ImportRunDeps {
+  isDirectory: (p: string) => Promise<boolean>;
+  ensureLauncher: () => Promise<RoseCliInstallResult>;
+  /** The user's login-shell PATH (claude, codex, git, python3 resolve like in Terminal). */
+  env: () => NodeJS.ProcessEnv;
+  home: () => string;
+  spawn: (spec: ImportSpawnSpec) => ImportChild;
+  emit: (event: RoseCliImportEvent) => void;
+  newRunId: () => string;
+  /** Schedule `fn` after `ms`; returns a canceller. */
+  setTimer: (fn: () => void, ms: number) => () => void;
+}
+
+interface ActiveRun {
+  runId: string;
+  child: ImportChild;
+  sawError: boolean;
+  canceled: boolean;
+  cancelKillTimer: (() => void) | null;
+}
+
+/** At most one `rose import` process at a time; its stdout becomes renderer events. */
+export class ImportRunManager {
+  private active: ActiveRun | null = null;
+  private starting = false;
+
+  constructor(private readonly deps: ImportRunDeps) {}
+
+  async start(raw: unknown): Promise<RoseCliImportStartResult> {
+    if (this.active !== null || this.starting) return { error: IMPORT_BUSY_ERROR };
+    this.starting = true;
+    try {
+      const checked = await validateImportRequest(raw, this.deps.isDirectory);
+      if ('error' in checked) return checked;
+      const launcher = await this.deps.ensureLauncher();
+      if (!launcher.success || launcher.path === undefined) {
+        return { error: launcher.error ?? 'Could not install the rose CLI.' };
+      }
+      const invocation = buildImportInvocation(checked.request);
+      const runId = this.deps.newRunId();
+      const child = this.deps.spawn({
+        command: launcher.path,
+        args: invocation.args,
+        cwd: invocation.folder ?? this.deps.home(),
+        env: importRunEnv(this.deps.env(), invocation.env),
+        stdin: invocation.stdin,
+      });
+      this.attach(runId, child);
+      return { runId };
+    } catch (error) {
+      return { error: `Could not start the import: ${getErrorMessage(error)}` };
+    } finally {
+      this.starting = false;
+    }
+  }
+
+  cancel(runId: unknown): void {
+    const run = this.active;
+    if (run === null || run.runId !== runId || run.canceled) return;
+    run.canceled = true;
+    run.child.kill('SIGTERM');
+    run.cancelKillTimer = this.deps.setTimer(
+      () => run.child.kill('SIGKILL'),
+      IMPORT_CANCEL_GRACE_MS
+    );
+  }
+
+  /** App quit: stop whatever is running. */
+  cancelAll(): void {
+    if (this.active !== null) this.cancel(this.active.runId);
+  }
+
+  private attach(runId: string, child: ImportChild): void {
+    const run: ActiveRun = {
+      runId,
+      child,
+      sawError: false,
+      canceled: false,
+      cancelKillTimer: null,
+    };
+    this.active = run;
+    const lines = new JsonLineParser((value) => this.forward(run, value));
+    child.onStdout((chunk) => lines.push(chunk));
+    child.onClose((code) => {
+      lines.end();
+      this.finish(run, code);
+    });
+  }
+
+  private forward(run: ActiveRun, value: Record<string, unknown>): void {
+    // `exit` is the main process's own final event; the CLI cannot end a run early.
+    if (value.event === 'exit') return;
+    if (value.event === 'error') run.sawError = true;
+    this.deps.emit({ ...value, runId: run.runId });
+  }
+
+  private finish(run: ActiveRun, code: number | null): void {
+    run.cancelKillTimer?.();
+    run.cancelKillTimer = null;
+    if (this.active === run) this.active = null;
+    if (code !== 0 && !run.sawError) {
+      this.deps.emit({
+        runId: run.runId,
+        event: 'error',
+        message: run.canceled ? IMPORT_CANCELED_MESSAGE : IMPORT_FAILED_MESSAGE,
+        ...(run.canceled ? { canceled: true } : {}),
+      });
+    }
+    this.deps.emit({ runId: run.runId, event: 'exit', code });
+  }
+}
