+def persisted_explore_tool_evidence(messages: List[Dict[str, Any]], task_id: str) -> List[str]:
+    """Recover only completed evidence tools from one explore task's durable messages."""
+    evidence: List[str] = []
+    for message in messages:
+        metadata = message.get("metadata") or {}
+        if not isinstance(metadata, dict) or metadata.get("taskId") != task_id:
+            continue
+        if message.get("role") != "TOOL" or metadata.get("toolStatus") != "FINISHED":
+            continue
+        tool_name = metadata.get("toolName")
+        if tool_name not in _EXPLORE_EVIDENCE_TOOLS:
+            continue
+        raw = str(message.get("text") or "").strip()
+        # Older workers did not stamp fullToolEvidence. Their tool-manager
+        # messages can still be distinguished from 500-character UI copies.
+        if metadata.get("fullToolEvidence") is not True and len(raw) <= EXPLORE_MESSAGE_TRUNCATE_LEN:
+            continue
+        if "**Result:**" not in raw:
+            continue
+        result = raw.split("**Result:**", 1)[1].strip()
+        if result and _has_usable_tool_evidence(result):
+            evidence.append(f"[{tool_name}] {result}")
+    return evidence
+
+
+@activity.defn
+async def fetch_persisted_explore_evidence_activity(
+    agent_id: str, task_id: str, since: Optional[str] = None
+) -> Dict[str, Any]:
+    """Return the task's saved research when its activity exceeds the parent wait."""
+    activity.heartbeat("Fetching persisted explore evidence")
+    data = await _fetch_agent_data_impl(agent_id, since=since)
+    evidence = persisted_explore_tool_evidence(data.get("messages") or [], task_id)
+    # This result enters the parent LLM's tool context. Keep complete tool
+    # output here; the existing UI-only wrap-up budget must not cut citations
+    # or answers from model-visible evidence.
+    result = "\n\n".join(evidence)
+    if not result:
+        return {
+            "status": "failed",
+            "error_reason": "Explore research exceeded its wait budget without saved tool evidence.",
+            "result": "",
+            "tool_call_results": [],
+        }
+    return {"status": "completed", "result": result, "tool_call_results": evidence}
+
+
