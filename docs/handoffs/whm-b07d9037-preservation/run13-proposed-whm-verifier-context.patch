+async def test_run_verifier_world_mode_keeps_real_temporal_payload_unchanged():
+    """Only non-real modes append the trailing optional activity argument."""
+    import inspect
+    from temporalio.converter import DefaultPayloadConverter
+    from helpers.llm import check_progress
+    from loop.run_agent import _run_verifier
+
+    context = [{"role": "USER", "text": "Inspect source"}]
+    expected_real_args = [context, "VERIFY", "rose-flash", None, None, "verifier_execute", "a",
+                          None, None, None, None, None, None, None, None, None, None, None, False, None, 0]
+    converter = DefaultPayloadConverter()
+    expected_real_payloads = converter.to_payloads(expected_real_args)
+    for mode in ("real", "simulate", "shadow"):
+        calls = []
+
+        async def execute_activity(_fn, args=None, **_kwargs):
+            calls.append(args)
+            return {"score": 0.5, "reasoning": "partial", "structured_response": None, "usage": {}}
+
+        async def prompt():
+            return "VERIFY"
+
+        await _run_verifier(
+            execute_activity=execute_activity, context=context, verifier_prompt_generator=prompt,
+            model="rose-flash", agent_id="a", task_id=None, post_message=None,
+            **({"world_model_mode": mode} if mode != "real" else {}),
+        )
+        args = calls[0]
+        assert args == expected_real_args + ([] if mode == "real" else [mode])
+        payloads = converter.to_payloads(args)
+        assert [p.SerializeToString(deterministic=True) for p in payloads[:21]] == [
+            p.SerializeToString(deterministic=True) for p in expected_real_payloads
+        ]
+        bound = inspect.signature(check_progress).bind(*args)
+        bound.apply_defaults()
+        assert bound.arguments["world_model_mode"] == mode
+
