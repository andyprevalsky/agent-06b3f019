+async def test_check_progress_whm_keeps_user_requests_without_changing_real_scope():
+    """WHM workflow mode retains genuine USER requests in execute judging."""
+    import workflows.agent_workflow as workflow_module
+    from helpers.llm import check_progress
+
+    original_goal = "Inspect the assigned source. If unavailable, report the blocker."
+    follow_up = "Keep the inspection read-only."
+    context = [
+        {"role": "USER", "text": original_goal, "timestamp": "2026-01-01T00:00:00Z"},
+        {"role": "TOOL", "text": "Initialized", "timestamp": "2026-01-01T00:00:01Z",
+         "metadata": {"toolName": "agent_init", "toolStatus": "FINISHED"}},
+        {"role": "USER", "text": follow_up, "timestamp": "2026-01-01T00:00:02Z",
+         "metadata": {"phase": "PLAN"}},
+        {"role": "TOOL", "text": "Source unavailable", "timestamp": "2026-01-01T00:00:03Z",
+         "metadata": {"toolName": "spawn_agent", "toolStatus": "FINISHED", "phase": "EXECUTE"}},
+        {"role": "TOOL", "text": "Planning-only result", "timestamp": "2026-01-01T00:00:04Z",
+         "metadata": {"toolName": "spawn_agent", "toolStatus": "FINISHED", "phase": "PLAN"}},
+    ]
+    for mode in ("real", "simulate", "shadow"):
+        captured_messages = []
+
+        async def capture(messages, *_args, **_kwargs):
+            captured_messages.extend(messages)
+            return {"score": 0.5, "reasoning": "partial"}, {"prompt_tokens": 0, "completion_tokens": 0, "total_tokens": 0}
+
+        async def run_phase(**kwargs):
+            return await check_progress(
+                context=context, verifier_system_prompt="VERIFY", call_site="verifier_execute", **kwargs
+            )
+
+        instance = workflow_module.AgentWorkflow()
+        instance.world_model_mode = mode
+        instance._resume_pending_tools = AsyncMock(return_value=None)
+        with patch("temporalio.activity.heartbeat"), patch("helpers.llm._call_llm_verifier", capture), patch.object(workflow_module, "run_agent", run_phase):
+            result = await instance._run_agent_turns()
+
+        rendered = "\n".join(m["content"] for m in captured_messages if isinstance(m.get("content"), str))
+        assert rendered.count(original_goal) == (0 if mode == "real" else 1)
+        assert rendered.count(follow_up) == (0 if mode == "real" else 1)
+        assert "Source unavailable" in rendered
+        assert "Initialized" not in rendered
+        assert "Planning-only result" not in rendered
+        assert result["score"] == 0.5
 
 
