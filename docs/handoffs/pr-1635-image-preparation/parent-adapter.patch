diff --git a/scripts/deploy_test_private_source.py b/scripts/deploy_test_private_source.py
new file mode 100644
index 000000000..080ecab20
--- /dev/null
+++ b/scripts/deploy_test_private_source.py
@@ -0,0 +1,342 @@
+"""Read-only parent admission for an independently prepared fleet source.
+
+cycle/debt seals -> native prepare verifier -> versioned manifest -> captured fleet base.
+Historical cleanup and financial outcomes remain owned by their original audits.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import runpy
+
+SCHEMA = 'parent-private-source-v1'
+PROTECTED = {'683e47df5094d8': 'vol_vwnym366kn7k8mmv',
+             '811d632f2650e8': 'vol_r1jde9donnx2mn9r'}
+CUSTODY = runpy.run_path(str(Path(__file__).with_name('cloudbench-explicit-idle-admission.py')))
+HISTORY = ('reconciled_owners', 'failures', 'native_maintenance',
+           'historical_no_retry_custody', 'historical_custody_history',
+           'historical_custody_import', 'historical_custody_transfers',
+           'completed_local_custody_history', 'private_source_preparations')
+FIELDS = {'schema', 'source', 'gate', 'plan_digest', 'debt_sha256', 'history_sha256',
+          'protected_resources', 'artifacts', 'helper_sha256', 'image_ref',
+          'node_fingerprint', 'python_fingerprint'}
+
+
+def need(ok, label):
+    if not ok:
+        raise ValueError('private source admission: ' + label)
+
+
+def digest(value):
+    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(',', ':'),
+                                     allow_nan=False).encode()).hexdigest()
+
+
+def history_digest(state):
+    return digest({key: state.get(key) for key in HISTORY})
+
+
+def sealed_file(record, context):
+    need(isinstance(record, dict) and set(record) == {'path', 'sha256'}, 'artifact fields')
+    path = Path(record['path'])
+    need(path.is_absolute() and path.resolve() == path and path.is_relative_to(context)
+         and path.is_file() and not path.is_symlink(), 'artifact custody')
+    raw = CUSTODY['read'](path, limit=8 * 1024 * 1024)
+    need(hashlib.sha256(raw).hexdigest() == record['sha256'], 'artifact bytes')
+    return path
+
+
+def validate_binding(state, entries, root):
+    """Source admission only; caller must retain all historical native audits."""
+    root = Path(root)
+    value = state.get('private_source_binding')
+    need(isinstance(value, dict) and set(value) == FIELDS and value['schema'] == SCHEMA,
+         'binding schema')
+    need(value['source'] == state['source'] == state['plan']['source']
+         and value['plan_digest'] == state['plan_digest'] == digest(state['plan']), 'source/plan')
+    gates = [g for g in state['plan']['gates'] if g['name'] == value['gate']]
+    need(len(gates) == 1 and gates[0].get('native_cloud') is True, 'native gate')
+    expected = [e for e in state.get('reconciled_owners', {}).values()
+                if e.get('gate') == value['gate'] and e.get('purpose') == 'isolated-validation']
+    need(entries and len({e['token'] for e in entries}) == len(entries)
+         and sorted(entries, key=lambda e: e['token']) == sorted(expected, key=lambda e: e['token'])
+         and value['debt_sha256'] == digest(sorted(entries, key=lambda e: e['token']))
+         and value['history_sha256'] == history_digest(state), 'complete preserved history')
+    need(all(e.get('cleanup_complete') is False and e.get('credit_granted') is False
+             and e.get('obligations_preserved') is True for e in entries), 'debt outcomes')
+    protected = value['protected_resources']
+    need(isinstance(protected, dict) and protected == PROTECTED, 'protected resource binding')
+    artifacts = value['artifacts']
+    need(isinstance(artifacts, dict) and set(artifacts) == {'request', 'result', 'manifest', 'build', 'intent'}, 'native artifacts')
+    paths = {k: sealed_file(v, root / '.context') for k, v in artifacts.items()}
+    intent = json.loads(paths['intent'].read_bytes())
+    records = state.get('private_source_preparations', [])
+    need(isinstance(records, list) and len([r for r in records if r.get('intent') == artifacts['intent']
+         and r.get('result') == artifacts['result']]) == 1, 'cycle pre-effect anchor missing')
+    need(intent.get('schema') == 'parent-private-source-intent-v1'
+         and intent['source'] == value['source'] and intent['gate'] == value['gate']
+         and intent['plan_digest'] == value['plan_digest'] and intent['debt_sha256'] == value['debt_sha256']
+         and intent['request'] == artifacts['request'] and intent['helper_sha256'] == value['helper_sha256'],
+         'original parent preparation intent')
+    need(records[-1] == {'intent': artifacts['intent'], 'result': artifacts['result']}, 'last native preparation')
+    previous = dict(state)
+    if len(records) > 1:
+        previous['private_source_preparations'] = records[:-1]
+    else:
+        previous.pop('private_source_preparations', None)
+    need(intent['history_sha256'] == history_digest(previous), 'pre-effect original history changed')
+    for row in records:
+        need(set(row) == {'intent', 'result'}, 'unfinished native preparation')
+        sealed_file(row['intent'], root / '.context')
+        sealed_file(row['result'], root / '.context')
+    origin_path = sealed_file(intent['origin'], root / '.context')
+    origin = json.loads(origin_path.read_bytes())
+    result = json.loads(paths['result'].read_bytes())
+    need(result.get('origin') == intent['origin'] and origin.get('schema') == 'cloudbench-prepare-source-origin-v1'
+         and origin['request'] == artifacts['request'] and origin['source_ref'] == value['source']['head']
+         and origin['helper_sha256'] == value['helper_sha256'] and origin['nonce'] == intent['nonce']
+         and origin['output'] == intent['output'] and origin['producer']['pid'] > 1
+         and origin['producer']['birth'] and origin['producer']['argv_sha256']
+         and intent['producer_cmdline_sha256'] and origin['dependencies'] == intent['dependencies'],
+         'native origin/result chain')
+    helper = root / 'scripts/cloudbench-prepare-source.py'
+    need(helper.is_file() and not helper.is_symlink() and helper.resolve() == helper
+         and hashlib.sha256(helper.read_bytes()).hexdigest() == value['helper_sha256'], 'native verifier source')
+    library = runpy.run_path(str(helper))
+    verifier = library.get('verify_prepared_source')
+    need(callable(verifier), 'native verifier API unavailable')
+    manifest = verifier(paths['request'], paths['result'], paths['manifest'],
+                        source_ref=value['source']['head'], image_ref=value['image_ref'],
+                        node_fingerprint=value['node_fingerprint'],
+                        python_fingerprint=value['python_fingerprint'])
+    # The native verifier establishes request/lease/guest/snapshot authority.
+    # The parent independently binds those exact bytes to its preserved debt.
+    request = json.loads(paths['request'].read_bytes())
+    validate_transport(request, value['source'], root)
+    need(request.get('protected_resources') == protected, 'native protected resources')
+    need(request.get('build') == artifacts['build'], 'native build receipt binding')
+    from cloudbench_maintenance import image_build
+    image_build(paths['build'], value['image_ref'], root, state['source'])
+    source = runpy.run_path(str(root / 'scripts/cloudbench-source.py'))
+    raw = paths['manifest'].read_bytes()
+    need(manifest == source['manifest'](raw), 'native/versioned manifest disagreement')
+    need(manifest.get('version') == 2 and manifest.get('lease_protocol') == 'cloudbench-source-lease-v1'
+         and re.fullmatch('[0-9a-f]{32}', manifest.get('creation_nonce', '')) is not None,
+         'versioned source consumer protocol required')
+    need(isinstance(request.get('guest_env_sha256'), dict)
+         and manifest.get('guest_env_sha256') == request['guest_env_sha256'], 'requested guest environment')
+    need(manifest['shared_machine_id'] == '683e47df5094d8'
+         and manifest['shared_volume_id'] == protected['683e47df5094d8'], 'shared base identity')
+    excluded = dict(protected)
+    for entry in entries:
+        for mid, vid in entry['excluded_resources'].items():
+            need(mid not in excluded or excluded[mid] == vid, 'conflicting resource provenance')
+            excluded[mid] = vid
+    need(manifest['machine_id'] not in excluded and manifest['volume_id'] not in excluded.values(),
+         'source aliases excluded debt resource')
+    need(manifest['image_digest'] == value['image_ref'].rsplit('@', 1)[-1]
+         and manifest['node_fingerprint'] == value['node_fingerprint']
+         and manifest['python_fingerprint'] == value['python_fingerprint'], 'source image/dependencies')
+    # Re-read every sealed input after executing the owning verifier.
+    for key, record in artifacts.items():
+        need(sealed_file(record, root / '.context') == paths[key], 'native artifacts changed')
+    return manifest
+
+
+def bind_request(state, entries, request, root):
+    validate_binding(state, entries, root)
+    value = state['private_source_binding']
+    need(request['source'] == value['source'] and request['gate'] == value['gate']
+         and isinstance(request['token'], str) and re.fullmatch('[0-9a-f]{32}', request['token'])
+         and request['token'] not in {e['token'] for e in entries}, 'new consumer identity')
+    request['private_source_binding'] = {'sha256': digest(value), 'request_token': request['token']}
+
+
+def request_manifest(request, root):
+    from deploy_test_cycle import read
+    locator = Path(request.get('custody_state', ''))
+    need(locator.is_absolute() and locator.resolve() == locator and not locator.is_symlink()
+         and locator.is_relative_to(root / '.context') and locator.name == 'cycle.json', 'cycle locator')
+    state = read(locator)
+    value = state.get('private_source_binding')
+    need(request.get('private_source_binding') == {'sha256': digest(value), 'request_token': request['token']}
+         and request['source'] == state['source'] and request['gate'] == value['gate'], 'consumer binding')
+    entries = [e for e in state.get('reconciled_owners', {}).values()
+               if e.get('gate') == request['gate'] and e.get('purpose') == 'isolated-validation']
+    candidate = dict(request)
+    bind_request(state, entries, candidate, root)
+    # Re-run the existing ancestry and native debt audit, including all old failures.
+    from deploy_test_native_cleanup import inherited_native_sources
+    need(set(inherited_native_sources(state, entries, _historical_only=True)) == set(), 'historical audit')
+    return validate_binding(state, entries, root)
+
+
+def environment(request, root, directory):
+    manifest = request_manifest(request, root)
+    source = runpy.run_path(str(root / 'scripts/cloudbench-source.py'))
+    path = directory / 'private-source-manifest.json'
+    raw = source['canonical'](manifest)
+    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o400)
+    with os.fdopen(fd, 'wb') as stream:
+        stream.write(raw)
+        stream.flush()
+        os.fsync(stream.fileno())
+    return {'CLOUDBENCH_SOURCE_MANIFEST': str(path)}
+
+
+def verify_fleet(request, root, fleet):
+    manifest = request_manifest(request, root)
+    source = runpy.run_path(str(root / 'scripts/cloudbench-source.py'))
+    expected = hashlib.sha256(source['canonical'](manifest)).hexdigest()
+    for path in (fleet / 'source-manifest.json', fleet / 'teardown-ownership/source-manifest.json'):
+        need(path.is_file() and not path.is_symlink()
+             and hashlib.sha256(path.read_bytes()).hexdigest() == expected, 'fleet captured source')
+    from deploy_test_native_cleanup import fields
+    meta = fields((fleet / 'teardown-ownership/meta').read_bytes())
+    need(meta.get('source_manifest_sha256') == expected, 'fleet source provenance')
+
+
+def prepare_cycle(state, plan, root, state_path, operation):
+    """Called only by the cycle CLI while its existing exclusive lock is held."""
+    import sys
+    from deploy_test_cycle import source, write, read
+    root = Path(root)
+    def sync_cycle():
+        write(state_path, state)
+        fd = os.open(state_path.parent, os.O_RDONLY | os.O_DIRECTORY)
+        try:
+            os.fsync(fd)
+        finally:
+            os.close(fd)
+    need(operation.get('schema') == 'parent-private-source-operation-v1', 'operation schema')
+    need(source(root) == state['source'] == plan['source'] and plan == state['plan']
+         and digest(plan) == state['plan_digest'] and state.get('ready') is False
+         and state.get('phase') == 'needs-focused-plan', 'frozen failed cycle')
+    need(state_path.resolve() == state_path and state_path.is_relative_to(root / '.context')
+         and not state_path.is_symlink() and state_path.name == 'cycle.json', 'physical cycle')
+    need(Path(sys.argv[0]).resolve() == root / 'scripts/deploy_test_cycle.py'
+         and len(sys.argv) > 1 and sys.argv[1] == 'prepare-private-source', 'original cycle producer')
+    locks = [fd for fd in Path('/proc/self/fd').iterdir()
+             if fd.resolve() == state_path.parent / 'lock'
+             and 'FLOCK  ADVISORY  WRITE' in Path('/proc/self/fdinfo', fd.name).read_text()]
+    need(len(locks) == 1, 'original cycle exclusive lock')
+    entries = [e for e in state.get('reconciled_owners', {}).values()
+               if e.get('gate') == operation['gate'] and e.get('purpose') == 'isolated-validation']
+    from deploy_test_native_cleanup import inherited_native_sources
+    need(entries and inherited_native_sources(state, entries, _historical_only=True) == {}, 'historical native audit')
+    records = state.get('private_source_preparations', [])
+    need(all('result' in row for row in records), 'unfinished private preparation retained')
+    request_path = sealed_file(operation['request'], root / '.context')
+    request = read(request_path)
+    validate_transport(request, state['source'], root)
+    need(request['source_ref'] == state['source']['head'], 'exact parent requested source')
+    helper = root / 'scripts/cloudbench-prepare-source.py'
+    need(helper.resolve() == helper and not helper.is_symlink()
+         and hashlib.sha256(helper.read_bytes()).hexdigest() == operation['helper_sha256'], 'operation helper source')
+    library = runpy.run_path(str(helper))
+    library['read_request'](request_path)  # Native ownership/build/schema checks, no API construction.
+    build_path = sealed_file(request['build'], root / '.context')
+    from cloudbench_maintenance import image_build
+    image_build(build_path, request['image_ref'], root, state['source'])
+    output = Path(operation['output'])
+    need(output.is_absolute() and output.resolve() == output and output.is_relative_to(root / '.context')
+         and not output.exists() and not output.is_symlink(), 'fresh operation output')
+    prior_history = history_digest(state)
+    pointer = None
+
+    def anchor(origin_path):
+        nonlocal pointer
+        need(pointer is None and origin_path == output / 'origin.json', 'single original origin')
+        raw = origin_path.read_bytes(); origin = json.loads(raw)
+        need(origin.get('schema') == 'cloudbench-prepare-source-origin-v1'
+             and origin['producer'] == dict(pid=os.getpid(), birth=runpy.run_path(str(root / 'scripts/process-identity.py'))['linux_identity'](os.getpid()),
+                 argv_sha256=hashlib.sha256(Path('/proc/self/cmdline').read_bytes()).hexdigest())
+             and origin['request'] == operation['request'] and origin['nonce'] == request['nonce']
+             and origin['source_ref'] == state['source']['head'] and origin['output'] == str(output)
+             and origin['helper_sha256'] == operation['helper_sha256']
+             and origin['dependencies'] == library['dependency_seals'](), 'genuine native origin')
+        need(read(state_path) == state and source(root) == state['source'], 'cycle changed before native effects')
+        intent = dict(schema='parent-private-source-intent-v1', source=state['source'],
+            gate=operation['gate'], plan_digest=state['plan_digest'], debt_sha256=digest(sorted(entries,key=lambda e:e['token'])),
+            history_sha256=prior_history, origin=dict(path=str(origin_path),sha256=hashlib.sha256(raw).hexdigest()),
+            request=operation['request'], helper_sha256=operation['helper_sha256'],
+            output=str(output), nonce=request['nonce'], dependencies=origin['dependencies'],
+            producer_cmdline_sha256=hashlib.sha256(Path('/proc/self/cmdline').read_bytes()).hexdigest())
+        intent_path = output / 'parent-intent.json'
+        library['save'](intent_path, intent)
+        pointer = {'intent': {'path': str(intent_path), 'sha256': hashlib.sha256(intent_path.read_bytes()).hexdigest()}}
+        records.append(pointer)
+        state['private_source_preparations'] = records
+        sync_cycle()  # Durable BEFORE returning to the first native provider effect.
+
+    import signal
+    def interrupted(signum, frame):
+        raise InterruptedError('private source preparation interrupted')
+    handlers = {sig: signal.signal(sig, interrupted) for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)}
+    try:
+        library['prepare'](request_path, output, before_effects=anchor)
+    finally:
+        for sig, handler in handlers.items():
+            signal.signal(sig, handler)
+        if pointer is not None and (output / 'result.json').is_file():
+            pointer['result'] = dict(path=str(output / 'result.json'),
+                                     sha256=hashlib.sha256((output / 'result.json').read_bytes()).hexdigest())
+            sync_cycle()
+    need(pointer is not None and 'result' in pointer, 'native result missing; original intent retained')
+    binding = dict(schema=SCHEMA, source=state['source'], gate=operation['gate'], plan_digest=state['plan_digest'],
+        debt_sha256=digest(sorted(entries,key=lambda e:e['token'])), history_sha256=history_digest(state),
+        protected_resources=request['protected_resources'], helper_sha256=operation['helper_sha256'],
+        image_ref=request['image_ref'], node_fingerprint=request['node_fingerprint'], python_fingerprint=request['python_fingerprint'],
+        artifacts=dict(request=operation['request'], result=pointer['result'], build=request['build'],
+            manifest=dict(path=str(output / 'source-manifest.json'),
+                          sha256=hashlib.sha256((output / 'source-manifest.json').read_bytes()).hexdigest()),
+            intent=pointer['intent']))
+    candidate = {**state, 'private_source_binding': binding}
