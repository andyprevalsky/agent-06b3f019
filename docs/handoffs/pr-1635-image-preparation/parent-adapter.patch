+def validate_transport(request, expected_source, root):
+    """Reuse the parent producer's exact base+patch+two-index tree contract."""
+    import tempfile
+    import subprocess
+    from deploy_test_cloud import source_transport_environment
+    value = request.get('transport')
+    need(isinstance(value, dict) and value.get('source') == expected_source
+         and value.get('token') == request['nonce'] and value.get('workspace_root') == str(root),
+         'exact parent source transport')
+    path = Path(value['patch'])
+    need(path.resolve() == path and path.is_relative_to(root / '.context') and not path.is_symlink()
+         and json.loads(path.with_name('source-transport.json').read_bytes()) == value, 'canonical source transport seal')
+    source_transport_environment(value)  # Existing immutable patch hash check.
+    trees = []
+    with tempfile.TemporaryDirectory(dir=root / '.context') as temp:
+        for kind in ('replay', 'workspace'):
+            env = {**os.environ, 'GIT_INDEX_FILE': str(Path(temp) / kind)}
+            def git(*args):
+                return subprocess.check_output(['git', '-c', 'core.filemode=true', *args],
+                                               cwd=root, env=env).strip().decode()
+            git('read-tree', value['base_sha'])
+            if kind == 'replay' and value['workspace_patch_sha256'] != 'none':
+                git('apply', '--cached', '--binary', str(path))
+            if kind == 'workspace':
+                git('add', '--all', '--', '.', ':(exclude)agents/benchmarks/history/*.jsonl')
+            trees.append(git('write-tree'))
+    need(trees[0] == trees[1] == value['replayed_tree'], 'exact parent source reconstruction')
+
+
+def prepare_transport(state, plan, root, operation):
+    from deploy_test_cloud import prepare_source_transport
+    from deploy_test_cycle import source
+    need(operation.get('schema') == 'parent-private-source-transport-v1'
+         and source(root) == state['source'] == plan['source'] and state['plan'] == plan
+         and digest(plan) == state['plan_digest'], 'frozen source transport inputs')
+    directory = Path(operation['output'])
+    need(directory.is_absolute() and directory.resolve() == directory
+         and directory.is_relative_to(root / '.context') and not directory.exists(), 'fresh transport output')
+    need(re.fullmatch('[a-f0-9]{32}', operation['nonce']), 'transport nonce')
+    directory.mkdir(mode=0o700)
+    return prepare_source_transport({'source': state['source'], 'token': operation['nonce']}, root, directory)
