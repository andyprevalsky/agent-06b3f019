{
  "redirects": [
    {
      "source": "/subscribe",
      "destination": "https://buy.stripe.com/test_5kQcN64tX2PccvS6dM9ws00",
      "permanent": false
    },
    {
      "source": "/open-agent",
      "has": [
        {
          "type": "query",
          "key": "agent-id",
          "value": "(?<agentId>.*)"
        }
      ],
      "destination": "/?agent-id=:agentId",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/version.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/research/:slug", "destination": "/api/og/research?slug=:slug" },
    { "source": "/((?!.*\\.).*)", "destination": "/index.html" }
  ]
}
