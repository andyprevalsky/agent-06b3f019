# Build context trimming for Dockerfile.cloudbench.
# Deps are installed fresh inside the image; heavy/generated/secret dirs are
# excluded so the remote build context upload stays small and no secrets leak
# into image layers.

# Generated workspace lock is not a stable image dependency input.
# Keep the committed backend/frontend lockfiles in the context.
/package-lock.json

# Dependencies (reinstalled in-image)
node_modules
**/node_modules
agents/venv
**/venv
**/__pycache__
**/*.pyc

# Generated / per-run state
.context
**/.context
.llm-dumps
**/.llm-dumps
agents/benchmarks/runs
# Archived span metrics are controller history, not image build inputs. Keep
# current metrics and task selection history available in the baked source.
agents/benchmarks/history/span_durations.*.jsonl
**/dist
**/dist-ssr
**/.next
**/build

# Git history (not needed at runtime; the git+https pip dep clones separately)
.git

# Logs
*.log
**/*.log
agents/navi-worker-log.txt

# Local env / secrets — injected as Fly secrets, never baked into the image
# (include suffixed variants like .env.local / .env.production at every depth)
.env
.env.*
**/.env
**/.env.*
.cloud-env

# Editor / OS
.DS_Store
.vscode
.idea

# Reference repos (read-only research material, large)
claude-code-src
openclaw
hermes-agent
codex
prime-agent
kimi-code

# Media / decks
pitch-deck
*.mov
*.mp4
