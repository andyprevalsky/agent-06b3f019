 _TOOL_OPERATION = "execute_tool"
+MEASURED_ELAPSED_MS_ATTRIBUTE = "exp.tool.elapsed_ms"
+
+
+def measured_elapsed_ms(span: TraceSpan) -> int | None:
+    """Return a tool result span's explicit measured duration in milliseconds.
+
+    Span start/end clocks may be ingestion ordering slots, so only an explicit
+    nonnegative integer attribute recorded from the original source clocks counts.
+    """
+    value = span.attributes.get(MEASURED_ELAPSED_MS_ATTRIBUTE)
+    if type(value) is int and value >= 0:
+        return value
+    return None
+
+
