# Temporal Cloud Configuration (required)
# Get these from: Temporal Cloud Dashboard → Namespace Settings
TEMPORAL_API_KEY="your-temporal-api-key-here"
TEMPORAL_NAMESPACE="rose-labs-us-east-1.tch2n"
TEMPORAL_ADDRESS="us-east-1.aws.api.temporal.io:7233"
TASK_QUEUE="navi-agent-tasks"

# Backend API Configuration (required)
# Must match BACKEND_API_KEY in back-end/.env
BACKEND_API_URL="http://localhost:3001"
BACKEND_API_KEY="your-secure-backend-api-key-here"

# OpenRouter API for LLM (required)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."
# Dedicated paid GPT fallback for Rose, tried before Anthropic/OpenRouter.
GPT_API_KEY="sk-proj-..."

# Serper API for web search (required)
# Get your API key from: https://serper.dev/api-key
SERPER_API_KEY="your-serper-api-key-here"

# Firecrawl API for web_fetch (required)
# Replaces Parallel AI /v1beta/extract for the web_fetch tool.
# Get your API key from: https://www.firecrawl.dev/
FIRECRAWL_API_KEY="fc-..."

# Twilio for SMS (optional - only needed if using send_sms tool)
# Get these from: Twilio Console → Account Info
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Worker Configuration (optional)
HEALTH_CHECK_PORT=8080
LOG_LEVEL="INFO"
ENVIRONMENT="development"

# Browser session provider. Must match the backend setting for usage attribution.
BROWSER_PROVIDER="kernel" # kernel | steel

# SuperMemory (cross-agent memory persistence)
SUPERMEMORY_API_KEY="your-supermemory-api-key-here"

# Worker Concurrency (optional - defaults are good for most cases)
MAX_CONCURRENT_ACTIVITIES=500
MAX_CONCURRENT_WORKFLOWS=200
MAX_CACHED_WORKFLOWS=100
# Task poller counts: low values cause multi-second activity dispatch stalls
# under parallel agent load (benchmarks, concurrent users). Prod uses 5 per
# machine with 2+ machines; local single-worker needs ~10 to match.
MAX_CONCURRENT_ACTIVITY_TASK_POLLERS=10
MAX_CONCURRENT_WORKFLOW_TASK_POLLERS=10

# Plaid (bank account / financial data integration)
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SANDBOX_SECRET=your-plaid-sandbox-secret
PLAID_PRODUCTION_SECRET=your-plaid-production-secret
PLAID_ENV=sandbox
