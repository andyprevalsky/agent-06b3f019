#!/usr/bin/env bash
set -eo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR/agents"

# Use the agents venv interpreter so subprocesses (run_benchmark.py) inherit the full
# dependency set — notably boto3 for R2 world-model/trace-archive reads under --simulate.
# The system/asdf python may lack these. Fall back to PATH python3/python if the venv
# is absent. Prefer python3: many cloud images ship python3 without a `python`
# symlink (bare `exec python` exits 127).
PY=""
if [ -x "venv/bin/python" ]; then
    PY="venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
    PY="python3"
elif command -v python >/dev/null 2>&1; then
    PY="python"
else
    echo "❌ No Python interpreter found (venv/bin/python, python3, or python)." >&2
    exit 127
fi

if [[ "${1:-}" == "list" || "${1:-}" == "--list" ]]; then
    exec "$PY" -u benchmarks/run_benchmark.py --list
fi

if [[ "${1:-}" == "eval" || "${1:-}" == "eval-suite" ]]; then
    shift
    exec "$PY" -u benchmarks/local.py --eval-suite "$@"
fi

# --local opts out to the local isolated stack (backend + worker + WMH + Postgres
# on THIS machine). Without it, a benchmark run defaults to CLOUD.
if [[ "${1:-}" == "--local" ]]; then
    shift
    exec "$PY" -u benchmarks/local.py "$@"
fi

# --single-box is DISABLED: it ran every task directly on the ONE shared warm
# box, which is NOT parallel-safe — two worktrees collide on the same machine and
# whichever stops it kills the other's in-flight run. The default fleet path
# already isolates each bench on its own cloned machine, so a single bench is
# just `run-bench <task>`. (run-bench-cloud enforces the same guard directly.)
if [[ "${1:-}" == "--single-box" ]]; then
    echo "❌ --single-box is disabled: running benches on the shared warm box is not parallel-safe." >&2
    echo "   Use the default per-bench isolated fleet (clones a dedicated machine per bench):" >&2
    echo "       bash scripts/run-bench <task...>" >&2
    exit 2
fi

# DEFAULT: per-bench ISOLATED cloud fleet. Every bench gets its OWN Fly machine
# (own backend + Postgres + Temporal queue + WMH), starting at one machine and
# autoscaling with prod's params scoped to that bench's queue. The whole run is
# shown in ONE aggregated batch dashboard (auto-opened) covering ALL benches.
# Sim is per-bench and OFF by default — pass --sim-on <a,b> to enable it.
exec bash "$ROOT_DIR/scripts/run-bench-fleet" "$@"
