#!/usr/bin/env bash
set -eo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR/agents"

# Use the agents venv interpreter so subprocesses (run_benchmark.py) inherit the full
# dependency set — notably boto3 for R2 world-model/trace-archive reads under --simulate.
# The system/asdf python may lack these. Fall back to PATH python if the venv is absent.
PY="python"
if [ -x "venv/bin/python" ]; then
    PY="venv/bin/python"
fi

if [[ "${1:-}" == "list" || "${1:-}" == "--list" ]]; then
    exec "$PY" -u benchmarks/run_benchmark.py --list
fi

if [[ "${1:-}" == "eval" || "${1:-}" == "eval-suite" ]]; then
    shift
    exec "$PY" -u benchmarks/local.py --eval-suite "$@"
fi

# --local opts out to the local isolated stack (backend + worker + WMH + Postgres
# on THIS machine). Without it, a benchmark run defaults to CLOUD — the warm Fly
# box (run-bench-cloud), serving the cached WMH, nothing on the laptop.
if [[ "${1:-}" == "--local" ]]; then
    shift
    exec "$PY" -u benchmarks/local.py "$@"
fi

# DEFAULT: cloud-exclusive run on the warm Fly box.
exec bash "$ROOT_DIR/scripts/run-bench-cloud" "$@"
