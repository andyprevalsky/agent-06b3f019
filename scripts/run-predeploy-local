#!/usr/bin/env bash
# Run the catalog's Pre-Deploy/smoke group on the LOCAL isolated benchmark stack
# (per-run backend + worker + WMH + Postgres on this machine, concurrency capped at 2) and
# require every task to pass. This is the DEFAULT pre-deploy smoke path: the shared
# cloud fleet (`run-predeploy-cloud`) leaks paid Fly machines when killed and is
# frequently rate-limited / volume-capacity-starved, so local is the reliable gate.
#
# Task set comes from `agents/benchmarks/select_predeploy_benches.py` — existing
# smoke always runs; last-3-eligibility-pass gate applies only to added floor
# canaries / path extras (predeploy/worktree attempts do not count), then
# category floor + path-triggered depth, hard capped at 20. Identical selection
# to `run-predeploy-cloud`, so the two paths cannot drift. `run-bench --local`
# exits non-zero unless every requested task passes, so this script IS the gate.
#
# Usage:
#   scripts/run-predeploy-local            # run the selected predeploy set locally
#   scripts/run-predeploy-local --list     # print the selected task set and exit
#   scripts/run-predeploy-local --history  # print task + end-to-end timing history
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"
METRICS_SCRIPT="$ROOT_DIR/agents/benchmarks/predeploy_metrics.py"
SELECTOR_SCRIPT="$ROOT_DIR/agents/benchmarks/select_predeploy_benches.py"
LOGGED_COMMAND="$ROOT_DIR/scripts/run_logged_command.py"
HISTORY_FILE="$ROOT_DIR/agents/benchmarks/history/task_durations.jsonl"
RUN_ROOT="$ROOT_DIR/.context/predeploy-runs"
PREDEPLOY_BENCH_CAP="${PREDEPLOY_BENCH_CAP:-20}"
# Hard ceiling — launchers document a max of 20; refuse env overrides that
# would silently expand the predeploy set beyond the scream budget.
if [ "$PREDEPLOY_BENCH_CAP" -gt 20 ]; then
    echo "⚠️  PREDEPLOY_BENCH_CAP=$PREDEPLOY_BENCH_CAP exceeds hard ceiling 20; clamping to 20" >&2
    PREDEPLOY_BENCH_CAP=20
fi

# Prints the human selection report to stdout, then yields selected names on
# stdout after the machine delimiter. Callers that need names-only use --list.
read_predeploy_selection() {
    local format="${1:-names-and-report}"
    PREDEPLOY_BENCH_CAP="$PREDEPLOY_BENCH_CAP" \
        python3 "$SELECTOR_SCRIPT" \
            --catalog "$ROOT_DIR/agents/benchmarks/tasks.json" \
            --surface local \
            --cap "$PREDEPLOY_BENCH_CAP" \
            --format "$format" \
            --repo-root "$ROOT_DIR"
}

read_predeploy_tasks() {
    read_predeploy_selection names
}

PREDEPLOY_TASKS=()
SELECTION_REPORT=""
if [ "${1:-}" = "--list" ] || [ "${1:-}" = "--history" ]; then
    while IFS= read -r task; do
        [ -n "$task" ] && PREDEPLOY_TASKS+=("$task")
    done < <(read_predeploy_tasks)
else
    SELECTION_OUTPUT="$(read_predeploy_selection names-and-report)"
    printf '%s\n' "$SELECTION_OUTPUT"
    SELECTION_REPORT="$SELECTION_OUTPUT"
    while IFS= read -r task; do
        [ -n "$task" ] && PREDEPLOY_TASKS+=("$task")
    done < <(
        printf '%s\n' "$SELECTION_OUTPUT" \
            | sed -n '/^---PREDEPLOY_BENCH_NAMES---$/,/^---END_PREDEPLOY_BENCH_NAMES---$/p' \
            | sed '1d;$d'
    )
fi
[ "${#PREDEPLOY_TASKS[@]}" -gt 0 ] || { echo "no predeploy benchmark tasks selected" >&2; exit 1; }
if [ "${#PREDEPLOY_TASKS[@]}" -ge "$PREDEPLOY_BENCH_CAP" ]; then
    echo "🚨 PREDEPLOY BENCH COUNT AT HARD CAP: ${#PREDEPLOY_TASKS[@]}/$PREDEPLOY_BENCH_CAP" >&2
fi

# Whether ANY selected smoke task actually exercises Codex (gpt_code). The
# per-task compute-token seed (seed-local.ts) is strict on a usable gpt_code
# integration by default so real Codex regressions surface. But when the entire
# selected set is Codex-free, an externally rate-limited / quota-exhausted Codex
# integration (a third-party billing state we don't control) must NOT block the
# smoke gate — the claude tokens the selected tasks DO need still sync fine. In
# that case we opt into the harness's sanctioned SEED_ALLOW_MISSING_GPT_CODE=1
# path (same flag run-agentcard-lifecycle-task.sh uses for its Codex-free run).
# The instant a Codex-using task re-enters the smoke set this flips back to
# strict, so Codex coverage is never silently dropped.
smoke_set_uses_codex() {
    python3 - "$ROOT_DIR/agents/benchmarks/tasks.json" "${PREDEPLOY_TASKS[@]}" <<'PY'
import json
import sys

catalog_path = sys.argv[1]
selected = set(sys.argv[2:])
with open(catalog_path) as handle:
    tasks = json.load(handle)
for task in tasks:
    if task.get("name") not in selected:
        continue
    blob = json.dumps(task).lower()
    if "codex" in blob or "gpt_code" in blob or "gpt-code" in blob:
        print("1")
        break
else:
    print("0")
PY
}

LOCAL_CONCURRENCY="${PREDEPLOY_LOCAL_CONCURRENCY:-2}"

if [ "${1:-}" = "--list" ]; then
    printf '%s\n' "${PREDEPLOY_TASKS[@]}"
    exit 0
fi
if [ "${1:-}" = "--history" ]; then
    python3 "$METRICS_SCRIPT" history \
        --history-file "$HISTORY_FILE" \
        --run-root "$RUN_ROOT" \
        --concurrency "$LOCAL_CONCURRENCY" \
        "${PREDEPLOY_TASKS[@]}"
    exit 0
fi
if [ "$#" -ne 0 ]; then
    echo "usage: scripts/run-predeploy-local [--list|--history]" >&2
    exit 2
fi

SCHEDULED_TASKS=()
while IFS= read -r task; do
    [ -n "$task" ] && SCHEDULED_TASKS+=("$task")
done < <(
    python3 "$METRICS_SCRIPT" order \
        --history-file "$HISTORY_FILE" \
        "${PREDEPLOY_TASKS[@]}"
)
[ "${#SCHEDULED_TASKS[@]}" -eq "${#PREDEPLOY_TASKS[@]}" ] || {
    echo "pre-deploy scheduler changed the task count" >&2
    exit 1
}

if [ "$(smoke_set_uses_codex)" = "0" ]; then
    export SEED_ALLOW_MISSING_GPT_CODE=1
    echo "ℹ️  Smoke set is Codex-free — tolerating a missing/rate-limited gpt_code integration (SEED_ALLOW_MISSING_GPT_CODE=1)."
else
    # A Codex-using smoke set MUST enforce a usable gpt_code integration. Clear any
    # value inherited from the caller's environment so it can never leave a
    # Codex-using run permissively passing without the required credential.
    unset SEED_ALLOW_MISSING_GPT_CODE
fi

echo "🧪 Pre-Deploy smoke (LOCAL isolated stack) — ${#PREDEPLOY_TASKS[@]} tasks: ${PREDEPLOY_TASKS[*]}"
echo "Schedule (longest recent median first, concurrency $LOCAL_CONCURRENCY): ${SCHEDULED_TASKS[*]}"

# `run-bench --local` spins up the per-run isolated stack, runs the tasks, and
# exits non-zero unless ALL requested tasks pass.
#
# Concurrency defaults to 2 because cloud/history-derived task budgets assume
# agents make steady progress, while the local stack shares one host across its
# backend, worker, WMH, Postgres, and browser processes. Running the full smoke
# set at once can starve those services and turn useful work into false timeout
# failures. PREDEPLOY_LOCAL_CONCURRENCY remains an emergency/debug override.
# Longest-recent-median-first ordering minimizes the capped schedule's idle tail.
# Claude Code task correctness remains a hard deploy smoke gate, but its
# repeatable prompt-cache telemetry floor is deploy-approved warn-only because
# the external Claude Code auth/runtime path can legitimately produce no reusable
# cache reads while the task itself succeeds.
PREDEPLOY_RUN_ID="${PREDEPLOY_RUN_ID:-$(date -u +%Y%m%d-%H%M%S)-$$}"
[[ "$PREDEPLOY_RUN_ID" =~ ^[A-Za-z0-9._-]+$ ]] \
    && [ "$PREDEPLOY_RUN_ID" != "." ] \
    && [ "$PREDEPLOY_RUN_ID" != ".." ] || {
    echo "invalid pre-deploy run id: $PREDEPLOY_RUN_ID" >&2
    exit 2
}
ARTIFACT_DIR="$RUN_ROOT/$PREDEPLOY_RUN_ID"
RUNNER_LOG="$ARTIFACT_DIR/runner.log"
SUMMARY_PATH="$ARTIFACT_DIR/summary.json"
# Inside a deploy (an isolated deploy worktree, ROSE_DEPLOY_WORKTREE=1, or the
# explicit PREDEPLOY_PARK_LEDGERS=1) the benchmark ledger rows this run records
# are parked under .context instead of being appended to the tracked
# agents/benchmarks/history/*.jsonl files: a tracked-ledger write while smoke
# runs changes this lane's own --reuse-passed fingerprint ("deploy inputs
# changed while smoke ran") and the exact-worktree fingerprint of every lane
# admitted after it. The rows themselves are unchanged (same writers, same
# bytes); `python3 scripts/benchmark-history-latest-only.py --apply-parked
# <park dir> --write` replays them into the tracked ledgers when the deploy
# publishes its history. Reads (timeout derivation, the canary history gate)
# keep the tracked ledgers. An explicit BENCHMARK_HISTORY_PARK_DIR is honoured
# as-is, and the printed publish command names the directory actually used so
# a custom park is never left behind by the default replay.
if [ -n "${BENCHMARK_HISTORY_PARK_DIR:-}" ] \
    || [ "${ROSE_DEPLOY_WORKTREE:-0}" = "1" ] \
    || [ "${PREDEPLOY_PARK_LEDGERS:-0}" = "1" ]; then
    BENCHMARK_HISTORY_PARK_DIR="${BENCHMARK_HISTORY_PARK_DIR:-$ROOT_DIR/.context/deploy-ledger-park}"
    mkdir -p "$BENCHMARK_HISTORY_PARK_DIR"
    export BENCHMARK_HISTORY_PARK_DIR
    echo "📦 Benchmark ledger rows are parked in $BENCHMARK_HISTORY_PARK_DIR; publish them with: python3 scripts/benchmark-history-latest-only.py --base origin/main --apply-parked \"$BENCHMARK_HISTORY_PARK_DIR\" --write"
fi
STARTED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
STARTED_EPOCH="$(python3 -c 'import time; print(time.time())')"
GIT_SHA="$(git rev-parse HEAD)"
mkdir -p "$ARTIFACT_DIR"

record_summary() {
    exit_code="$1"
    finished_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    finished_epoch="$(python3 -c 'import time; print(time.time())')"
    record_args=(
        record
        --output "$SUMMARY_PATH"
        --run-id "$PREDEPLOY_RUN_ID"
        --started-at "$STARTED_AT"
        --finished-at "$finished_at"
        --started-epoch "$STARTED_EPOCH"
        --finished-epoch "$finished_epoch"
        --exit-code "$exit_code"
        --concurrency "$LOCAL_CONCURRENCY"
        --git-sha "$GIT_SHA"
        --runner-log "$RUNNER_LOG"
    )
    for task in "${PREDEPLOY_TASKS[@]}"; do
        record_args+=(--task "$task")
    done
    for task in "${SCHEDULED_TASKS[@]}"; do
        record_args+=(--schedule-task "$task")
    done
    python3 "$METRICS_SCRIPT" "${record_args[@]}" || {
        echo "warning: could not write pre-deploy summary" >&2
    }
    echo "Pre-deploy artifacts: $ARTIFACT_DIR"
}
trap 'record_summary $?' EXIT

set +e
SUPERVISOR_PID=""
SIGNAL_EXIT=0
PENDING_SIGNAL=""
# TERM/INT/HUP must reach nested run_logged_command + run-bench, not just the
# batch-wrapper subshell. The supervisor is launched in its own process group.
signal_supervisor() {
    local signal_name="$1"
    if [ -z "$SUPERVISOR_PID" ]; then
        return 0
    fi
    if ! kill -0 "$SUPERVISOR_PID" 2>/dev/null; then
        return 0
    fi
    kill -s "$signal_name" -- "-$SUPERVISOR_PID" 2>/dev/null \
        || kill -s "$signal_name" "$SUPERVISOR_PID" 2>/dev/null || true
}

forward_signal() {
    signal_name="$1"
    signal_exit="$2"
    SIGNAL_EXIT="$signal_exit"
    trap - HUP INT TERM
    if [ -n "$SUPERVISOR_PID" ]; then
        PENDING_SIGNAL=""
        signal_supervisor "$signal_name"
        wait "$SUPERVISOR_PID" 2>/dev/null || true
    else
        PENDING_SIGNAL="$signal_name"
    fi
}
trap 'forward_signal HUP 129' HUP
trap 'forward_signal INT 130' INT
trap 'forward_signal TERM 143' TERM

# Split the smoke set so Tokyo/other FM-off tasks stay on the isolated local
# cache, while demo_cache:on tasks (test-mass-agent-run-0) read the shared July
# cache with write-through disabled. One shared stack would either empty-cache
# the OAi replay or let Andy write-through poison prod.
LOCAL_CACHE_TASKS=()
SHARED_CACHE_TASKS=()
while IFS= read -r task; do
    [ -n "$task" ] || continue
    cache_mode="$(
        python3 - "$ROOT_DIR/agents/benchmarks/tasks.json" "$task" <<'PY'
import json
import sys

name = sys.argv[2]
with open(sys.argv[1]) as handle:
    tasks = json.load(handle)
for task in tasks:
    if task.get("name") == name:
        print("on" if task.get("demo_cache", task.get("fast_cache")) == "on" else "off")
        break
else:
    print("off")
PY
    )"
    if [ "$cache_mode" = "on" ]; then
        SHARED_CACHE_TASKS+=("$task")
    else
        LOCAL_CACHE_TASKS+=("$task")
    fi
done < <(printf '%s\n' "${SCHEDULED_TASKS[@]}")

shared_fast_mode_cache_url() {
    # Prefer the explicit key. Remounts often drop it while leaving prod
    # DATABASE_URL — same derivation scripts/run.sh uses for the July cache.
    local url
    url="$(grep -E '^FAST_MODE_CACHE_DATABASE_URL=' "$ROOT_DIR/back-end/.env" 2>/dev/null \
        | head -1 | cut -d= -f2- | tr -d '"' | tr -d "'")"
    if [ -z "$url" ]; then
        url="$(grep -E '^DATABASE_URL=' "$ROOT_DIR/back-end/.env" 2>/dev/null \
            | head -1 | cut -d= -f2- | tr -d '"' | tr -d "'")"
        case "$url" in
            *localhost*|*127.0.0.1*) url="" ;;
        esac
    fi
    printf '%s' "$url"
}

run_smoke_batch() {
    local cache_mode="$1"
    shift
    local -a batch=("$@")
    [ "${#batch[@]}" -gt 0 ] || return 0
    echo "🧪 Pre-Deploy smoke batch ($cache_mode cache): ${batch[*]}"
    # This launcher promises a per-run isolated stack. Do not let a caller's remote
    # cache override—or run.sh's shared-cache default—turn startup into a production
    # pooler dependency. run.sh creates the same cache schema in this run's local DB.
    unset FAST_MODE_CACHE_DATABASE_URL DEMO_CACHE_DATABASE_URL
    if [ "$cache_mode" = "shared" ]; then
        FAST_MODE_CACHE_DATABASE_URL="$(shared_fast_mode_cache_url)"
        export FAST_MODE_CACHE_DATABASE_URL
        [ -n "$FAST_MODE_CACHE_DATABASE_URL" ] || {
            echo "FAST_MODE_CACHE_DATABASE_URL is required for demo_cache:on smoke tasks" >&2
            return 2
        }
        FAST_MODE_CACHE_DISABLE_WRITE_THROUGH=1 \
        BENCHMARK_SKIP_WMH_BUILD=1 \
        BENCHMARK_CLAUDE_CODE_CACHE_RATCHET_WARN_ONLY=1 \
        BENCHMARK_ALLOW_CLAUDE_CODE_CREDENTIAL_SKIP=1 \
        BENCHMARK_COMPUTE_TOKEN_TYPE=claude \
        BENCHMARK_ATTEMPT_SUITE=predeploy \
        BENCHMARK_COUNTS_FOR_DEPLOY_ELIGIBILITY=0 \
        python3 "$LOGGED_COMMAND" "$RUNNER_LOG" -- \
            bash "$ROOT_DIR/scripts/run-bench" --local "${batch[@]}" \
            --max-concurrency "$LOCAL_CONCURRENCY"
        return $?
    fi
    # Seeded prod users can have Fast Mode on. If the create body omits
    # fast_mode_cache_enabled, local-cache smokes inherit that default.
    # Pin the flag off for this batch only; shared/demo_cache:on tasks
    # keep Fast Mode. This does not change oss-pinned tasks
    # (browser-biometrics-webdecoy uses rose-1-oss / OpenRouter).
    FAST_MODE_CACHE_USE_LOCAL=1 \
    BENCHMARK_FAST_MODE_CACHE=0 \
    BENCHMARK_SKIP_WMH_BUILD=1 \
    BENCHMARK_CLAUDE_CODE_CACHE_RATCHET_WARN_ONLY=1 \
    BENCHMARK_ALLOW_CLAUDE_CODE_CREDENTIAL_SKIP=1 \
    BENCHMARK_COMPUTE_TOKEN_TYPE=claude \
    BENCHMARK_ATTEMPT_SUITE=predeploy \
    BENCHMARK_COUNTS_FOR_DEPLOY_ELIGIBILITY=0 \
    python3 "$LOGGED_COMMAND" "$RUNNER_LOG" -- \
        bash "$ROOT_DIR/scripts/run-bench" --local "${batch[@]}" \
        --max-concurrency "$LOCAL_CONCURRENCY"
}

# Infra-fix /deploy must not hard-require a usable Claude Code pool token:
# when the sole pooled OAuth credential is rate-limited, Claude Code smoke
# tasks become the deploy-approved loud SKIP instead of failing the whole
# compute-token sync / preflight. Fleet/cloud require-pass does NOT set this.
# Monitor mode puts the background supervisor in its own process group so
# signal_supervisor can TERM the wrapper, run_logged_command, and run-bench.
set -m
(
    run_smoke_batch local "${LOCAL_CACHE_TASKS[@]}"
    local_ec=$?
    [ "$local_ec" -eq 0 ] || exit "$local_ec"
    run_smoke_batch shared "${SHARED_CACHE_TASKS[@]}"
) &
SUPERVISOR_PID=$!
set +m
if [ -n "$PENDING_SIGNAL" ]; then
    pending_signal="$PENDING_SIGNAL"
    PENDING_SIGNAL=""
    signal_supervisor "$pending_signal"
fi
wait "$SUPERVISOR_PID"
RUN_EXIT=$?
if [ "$SIGNAL_EXIT" -ne 0 ]; then
    RUN_EXIT="$SIGNAL_EXIT"
fi
trap - HUP INT TERM
set -e
exit "$RUN_EXIT"
