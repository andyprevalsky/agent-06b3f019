HYDRATED_WARM_DEPS_STATE=""
warm_deps_recorded_state() {
    # A sibling checkout can replace the shared legacy slot after discovery.
    # Keep this fleet's verified receipt through selection and preflight.
    if [ -n "${HYDRATED_WARM_DEPS_STATE:-}" ]; then
        printf '%s\n' "$HYDRATED_WARM_DEPS_STATE"
    else
        cat "$WARM_DEPS_STATE_FILE"
    fi
}
hydrate_warm_deps_state() {
    local node_fp py_fp shared_state temporary
    node_fp="$(cloudbench_node_dependency_fingerprint "$ROOT_DIR")" || return 0
    py_fp="$(cloudbench_manifest_fingerprint "$ROOT_DIR" "${CLOUDBENCH_PYTHON_MANIFESTS[@]}")" || return 0
    if shared_state="$(printf '{"machines":%s,"snapshots":%s}' "$warm_json" "$SNAPSHOTS_JSON" \
        | cloudbench_warm_deps_state_from_inventory "$APP" "$WARM_ID" "$VOL_ID" "$node_fp" "$py_fp")"; then
        HYDRATED_WARM_DEPS_STATE="$shared_state"
        temporary="$WARM_DEPS_STATE_FILE.tmp.$$"
        if printf '%s\n' "$shared_state" > "$temporary" && mv "$temporary" "$WARM_DEPS_STATE_FILE"; then
            echo "🧾 restored proven donor dependency snapshot for this checkout"
        else
            rm -f "$temporary"
            echo "⚠️  could not cache donor dependency proof locally; using this fleet's verified receipt" >&2
        fi
    fi
    return 0
}
configured_warm_snapshot_inventory() {
    python3 -I -S -B - "$CLOUDBENCH_WARM_SNAPSHOT_INVENTORY_FILE" \
        "${CLOUDBENCH_WARM_SNAPSHOT_INVENTORY_SHA256:-}" "$GIT_COMMON_DIR" "$MACHINE_NAME" <<'PYCONFIG'
import hashlib, json, os, re, stat, sys
try:
    path, digest, common, machine = sys.argv[1:]
    if not re.fullmatch(r"[0-9a-f]{64}", digest):
        raise ValueError("required digest")
    if not re.fullmatch(r"[A-Za-z0-9._-]+", machine):
        raise ValueError("machine name")
    expected = os.path.join(common, "cloudbench-warm-snapshot-inventory." + machine + ".json")
    if path != expected or os.path.realpath(common) != common or os.path.realpath(path) != path:
        raise ValueError("proof path")
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    with os.fdopen(fd, "rb") as stream:
        before = os.fstat(stream.fileno())
        if not stat.S_ISREG(before.st_mode) or before.st_uid != os.geteuid() or before.st_mode & 0o077 or before.st_size > 2097152:
            raise ValueError("proof file authority")
        data = stream.read(2097153)
        after = os.fstat(stream.fileno())
    fields = lambda v: (v.st_dev, v.st_ino, v.st_size, v.st_mtime_ns, v.st_uid, v.st_mode)
    if fields(before) != fields(after) or fields(after) != fields(os.lstat(path)):
        raise ValueError("proof file changed")
    if hashlib.sha256(data).hexdigest() != digest:
        raise ValueError("proof digest")
    value = json.loads(data)
    if not isinstance(value, list) or any(not isinstance(row, dict) for row in value):
        raise ValueError("proof inventory type")
    ids = [row.get("id") for row in value]
    if any(not isinstance(identity, str) or not identity for identity in ids) or len(set(ids)) != len(ids):
        raise ValueError("proof snapshot identities")
    sys.stdout.buffer.write(data)
except (OSError, ValueError, TypeError) as error:
    print("configured snapshot inventory refused (" + type(error).__name__ + ")", file=sys.stderr)
    raise SystemExit(75)
PYCONFIG
}
# Fly's snapshot listing intermittently answers a valid but empty list for minutes at a time (measured 2026-11-07:
# eight of nine concurrent reads, then healthy again), and with several controllers one of them can spend a short
# retry budget inside that window and take the whole campaign down with its infra stop. Retry for minutes (about four
# with jitter) before concluding that the donor has no usable snapshot.
# Sets SNAPSHOTS_JSON (the last valid listing, empty when no read was valid) and SNAPSHOT_LIST_ATTEMPTS_USED.
list_donor_snapshots() {
    local attempt candidate max_attempts=12 pause
    SNAPSHOTS_JSON=""
    SNAPSHOT_LIST_ATTEMPTS_USED=0
    for attempt in $(seq 1 "$max_attempts"); do
        SNAPSHOT_LIST_ATTEMPTS_USED="$attempt"
        candidate="$(FLY volume snapshots list "$VOL_ID" -a "$APP" --json 2>/dev/null || true)"
        if printf '%s' "$candidate" | python3 -c 'import json,sys; sys.exit(0 if isinstance(json.load(sys.stdin), list) else 1)' 2>/dev/null; then
            SNAPSHOTS_JSON="$candidate"
            # Fly can briefly return a valid but empty/still-hydrating list
            # while older completed snapshots exist. A valid JSON response is
            # not enough to conclude that the donor has no usable snapshot.
            if [ -n "$(printf '%s' "$SNAPSHOTS_JSON" | python3 "$SNAPSHOT_SELECTOR_SCRIPT" 2>/dev/null || true)" ]; then
                return 0
            fi
        fi
        if [ "$attempt" != "$max_attempts" ]; then
            pause=$(( attempt * 5 ))
            [ "$pause" -le 30 ] || pause=30
            sleep $(( pause + RANDOM % 4 ))
        fi
    done
    return 0
}
