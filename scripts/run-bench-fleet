BENCHES=()
SIM_ON_CSV=""

bench_needs_large_primary() {  # bench_needs_large_primary <task>
    # An infra probe boots the isolated stack and emits DONE without executing
    # the sampled task or its bundled frontend/browser workload. Use the
    # proven default primary shape so preflight can borrow the stopped 20GB
    # pool instead of restoring legacy 40GB warm volumes for task names that
    # would need 8GB only during real execution. Real benches keep their
    # catalog-specific shape below.
    [ "${INFRA_PROBE:-0}" = "1" ] && return 1
    local browser_task
    for browser_task in "${CATALOG_BROWSER_REQUIRED_TASKS[@]:-}"; do
        [ "$browser_task" = "$1" ] && return 0
    done
    case "$1" in
        # On smoke-inclusive 10-wide slices these 4GB/2-CPU guests held
        # the synchronized barrier for several extra minutes under sustained
        # CPU pressure. The large primary only changes VM resources, not the
        # task or evaluator, and reuses the same pool volume.
        planner-memory-blue-bottle-on|image-handling|wait-for-trigger|agent-payment-test-shop|agent-payment-idempotent-abandonment|agent-payment-abandonment|agent-payment-setup-resume|gate-subscription-card-mint|gate-kyc-card-mint|browser-*)
            return 0
            ;;
    esac
    return 1
}

bench_declares_fanout() {  # bench_declares_fanout <task>; catalog min_agent_count
    [ "${INFRA_PROBE:-0}" = "1" ] && return 1
    local fanout_task
    for fanout_task in "${CATALOG_FANOUT_TASKS[@]:-}"; do
        [ "$fanout_task" = "$1" ] && return 0
    done
    return 1
}

bench_uses_shared_demo_cache() {  # bench_uses_shared_demo_cache <task>; catalog demo_cache: on
    [ "${INFRA_PROBE:-0}" = "1" ] && return 1
    local demo_task
    for demo_task in "${CATALOG_DEMO_TASKS[@]:-}"; do
        [ "$demo_task" = "$1" ] && return 0
    done
    return 1
}

primary_vm_size_for_bench() {  # primary_vm_size_for_bench <task>
    if [ "${INFRA_PROBE:-0}" != "1" ] && bench_simulates "$1"; then
        printf '%s\n' "$FLEET_SIM_VM_SIZE"
    elif bench_declares_fanout "$1"; then
        printf '%s\n' "$FLEET_FANOUT_VM_SIZE"
    elif bench_needs_large_primary "$1"; then
        printf '%s\n' "$FLEET_BUNDLED_FRONTEND_VM_SIZE"
    else
        printf '%s\n' "$FLEET_PRIMARY_VM_SIZE"
    fi
}

primary_vm_memory_for_bench() {  # primary_vm_memory_for_bench <task>
    if [ "${INFRA_PROBE:-0}" != "1" ] && bench_simulates "$1"; then
        printf '%s\n' "$FLEET_SIM_VM_MEMORY"
    elif bench_declares_fanout "$1"; then
        printf '%s\n' "$FLEET_FANOUT_VM_MEMORY"
    elif bench_needs_large_primary "$1"; then
        printf '%s\n' "$FLEET_BUNDLED_FRONTEND_VM_MEMORY"
    else
        printf '%s\n' "$FLEET_PRIMARY_VM_MEMORY"
    fi
}

bench_uses_default_pool_shape() {  # <task>; pool claim eligibility
    # Opt-in proof optimization: a stopped 20GB pool Machine may be resized
    # during its boot-config update for an 8GB task. The exact same volume and
    # benchmark bytes are reused; the next pool preflight retains an admitted
    # large shape so another browser task can claim it directly. Capacity
    # still accounts for the task's
    # requested (larger) VM size in enforce_app_capacity_guard.
    if [ "${CLOUDBENCH_POOL_DYNAMIC_VM_SHAPE:-0}" = "1" ] \
        && bench_needs_large_primary "$1"; then
        return 0
    fi
    [ "$(primary_vm_size_for_bench "$1")" = "$FLEET_PRIMARY_VM_SIZE" ] \
        && [ "$(primary_vm_memory_for_bench "$1")" = "$FLEET_PRIMARY_VM_MEMORY" ]
}

shared_cpu_units_for_vm_size() {  # shared_cpu_units_for_vm_size <vm-size>
    local vm_size="$1" units
    case "$vm_size" in
        shared-cpu-*)
            units="${vm_size##*-}"
            units="${units%x}"
            case "$units" in ''|*[!0-9]*) printf '%s\n' 2 ;; *) printf '%s\n' "$units" ;; esac
            ;;
        *)
            printf '%s\n' 0
            ;;
    esac
}
