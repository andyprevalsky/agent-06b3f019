#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# run-bench-fleet — per-bench ISOLATED cloud benchmarks.
#
# Each bench task gets its OWN isolated resources: a dedicated Fly machine cloned
# from the warm box (own backend + Postgres + Temporal queue + WMH), starting at
# one machine per bench. Concurrency = one machine per bench (the n=1,2,4,… rungs
# of the validation ladder), each an independent bubble — no shared stack, no
# cross-bench interference.
#
# Sim is per-bench: every bench defaults to REAL (world model OFF). Pass
# --sim-on <csv> to turn the world-model simulator ON for specific benches.
#
# This is the DEFAULT cloud-bench path (scripts/run-bench delegates here). Autoscaling
# is mandatory and the whole run is shown in ONE aggregated batch dashboard,
# served on the central hub (no browser window is opened — view runs in the
# in-app Benchmarks tab, or open the printed URL manually).
#
# CONCURRENT WORKSTREAMS: fleets from different workspaces/worktrees run in
# parallel by design — each fleet only forks the warm source's immutable
# snapshot and only ever mutates machines it created (ledger + name scoped).
# The run path is READ-ONLY against shared app state: it VERIFIES the
# app-level env secrets exist and never stages them. The only serialization
# left is one controller per workspace (local lock). Refreshing the shared
# prod-aligned env is an explicit maintenance op:
#   bash scripts/run-bench-cloud --refresh-secrets
#
# Usage:
#   bash scripts/run-bench <bench> [<bench>...] [flags]        # via the common entry
#   bash scripts/run-bench-fleet spawn-sub-agents parallel-tool-calls
#   bash scripts/run-bench-fleet order-doordash-dinner --sim-on order-doordash-dinner
#
# Flags:
#   --sim-on <a,b>     comma list of benches to run with the WMH simulator ON
#                      (default: all benches REAL / world model OFF)
#   --ref <sha|branch> code ref to check out on each clone (default: HEAD)
#   --dash-base <port> aggregated batch dashboard port; bench i viewer = base+(i+1)*20
#                      (default CONDUCTOR_PORT+5764 → 8765 on the standard 3001 workspace,
#                       so concurrent workspaces get non-colliding hubs)
#   --keep-clones      do NOT destroy the per-bench machines on exit (debugging)
#   --foreground       keep the controller in the launching session (tests/debugging);
#                      paid fleet runs detach by default so EXIT cleanup survives it
#   --wait             detach for lifecycle safety, but wait for and return the
#                      controller's exact exit status (durable supervisors)
#   --recover-stale-owner <32-hex-token>
#                      internal exact-owner recovery after forced cancellation
#   --timeout <s>      per-bench ceiling passed to run-bench-cloud (default 3600)
#   --autoscale-max N  per-bench ceiling including the primary; must be >=2
#                      (default 15 = prod MAX_MACHINES)
#   --infra-probe      fleet substrate canary: bring-up + barrier + DONE without
#                      run_benchmark / LLM; implies --strict-barrier
#   --skip-autoscaler  skip mandatory per-bench worker autoscalers (DEMO $0
#                      concurrency probes; same post-DONE /metrics race as
#                      --infra-probe). Does NOT imply --strict-barrier.
#   --strict-barrier   fail closed on any barrier exclusion or timeout (default
#                      barrier is tolerant for wide capability fleets)
#
# Infra canary preflight (runtime guarantee for /descend fleets):
#   Every capability fleet (including single-bench outcome-proof reruns)
#   refuses to provision until a recent `scripts/run-fleet-infra-canary`
#   PASS stamp exists under `.context/fleet-infra-canary.last-pass` (TTL
#   FLEET_INFRA_CANARY_TTL_SECONDS, default 3600). Stale/missing stamps run
#   N=FLEET_INFRA_CANARY_PREFLIGHT_N (default 2) automatically and fail closed
#   on INFRA. Skipped only for --infra-probe, CLOUDBENCH_FAKE_DIR, recover/pool
#   ops, or CLOUDBENCH_SKIP_INFRA_CANARY_PREFLIGHT=1.
#
# Prereq: a warm box exists (bash scripts/run-bench-cloud --setup).
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

# Python normally writes sibling __pycache__ entries while importing modules.
# This controller executes imports from its content-sealed script snapshot, so
# even a valid cache write would mutate the attested bundle and make later
# child verification fail. Inherit this through every controller child before
# the first snapshot consumer; never weaken the manifest by excluding bytecode.
export PYTHONDONTWRITEBYTECODE=1

# The first shell owns a published snapshot before entering its immutable copy.
# Source that copy in the same process so its already-armed signal/EXIT guards
# stay active while Bash parses the second entrypoint. A fresh `exec bash`
# resets caught signals and recreates a small sole-owner teardown gap.
if [ -n "${CLOUDBENCH_SCRIPT_SNAPSHOT:-}" ] \
    && [ "${CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_MODE:-borrow}" = "owner" ] \
    && [ -n "${CLOUDBENCH_TEST_SCRIPT_SNAPSHOT_ENTRY_READY:-}" ]; then
    : > "$CLOUDBENCH_TEST_SCRIPT_SNAPSHOT_ENTRY_READY"
    while [ ! -e "${CLOUDBENCH_TEST_SCRIPT_SNAPSHOT_ENTRY_RELEASE:-}" ]; do
        sleep 0.05
    done
fi

# Script snapshots are local resources too.  The original snapshot guard put
# their only `rm -rf` inside the paid-resource cleanup installed thousands of
# lines later, so every help/config/catalog exit before that trap leaked one.
# Fence deletion with a per-invocation token, PID birth identity, and one
# fcntl-serialized marker transition. An externally supplied snapshot is
# borrowed, never deleted, and claim/cleanup cannot validate stale ownership
# on opposite sides of a recursive delete.
SCRIPT_SNAPSHOT_OWNER_HELPER="cloudbench-script-snapshot.py"
SCRIPT_SNAPSHOT_PENDING_SIGNAL=""
SCRIPT_SNAPSHOT_HANDOFF_PENDING=0
SCRIPT_SNAPSHOT_ALLOW_TRANSFER=0
SCRIPT_SNAPSHOT_HANDOFF_OWNER_FILE=""
SCRIPT_SNAPSHOT_HANDOFF_STATUS_FILE=""
SCRIPT_SNAPSHOT_CREATE_RESULT_FILE=""
SCRIPT_SNAPSHOT_CREATE_ADOPTION_FILE=""
SCRIPT_SNAPSHOT_EXPECTED_PATH=""
SCRIPT_SNAPSHOT_CREATOR_PID=""
SCRIPT_SNAPSHOT_CREATOR_PID_START=""

# Runs before lib/cloudbench-env.sh is sourced; must produce the same identity
# as cloudbench_pid_start_time (boot-relative /proc start tick on Linux).
script_snapshot_current_pid_start() {
    local boot_id="" stat_line=""
    local -a fields=()
    if [ -r /proc/self/stat ]; then
        { IFS= read -r boot_id < /proc/sys/kernel/random/boot_id; } 2>/dev/null || return 0
        { IFS= read -r stat_line < "/proc/$$/stat"; } 2>/dev/null || return 0
        case "$stat_line" in *') '*) ;; *) return 0 ;; esac
        read -r -a fields <<< "${stat_line##*) }"
        [ -n "$boot_id" ] && [ "${#fields[@]}" -gt 19 ] || return 0
        case "${fields[19]}" in ''|*[!0-9]*) return 0 ;; esac
        printf 'proc-start:%s:%s\n' "$boot_id" "${fields[19]}"
        return 0
    fi
    ps -p $$ -o lstart= 2>/dev/null | awk '{$1=$1; print}'
}

claim_script_snapshot_ownership() {
    local owner_start
    owner_start="$(script_snapshot_current_pid_start)"
    [ -n "$owner_start" ] || return 1
    python3 "$CLOUDBENCH_SCRIPT_SNAPSHOT/$SCRIPT_SNAPSHOT_OWNER_HELPER" claim \
        --path "$CLOUDBENCH_SCRIPT_SNAPSHOT" \
        --temp-root "${TMPDIR:-/tmp}" \
        --token "$CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_TOKEN" \
        --pid "$$" --pid-start "$owner_start" \
        --previous-pid "$CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_PID" \
        --previous-pid-start "$CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_PID_START" \
        >/dev/null || return 1
    CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_MODE="owner"
    CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_PID="$$"
    CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_PID_START="$owner_start"
    export CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_MODE \
        CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_PID \
        CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_PID_START
}

cleanup_owned_script_snapshot() {
    local owner_start current_start
    local -a cleanup_args
    [ "${CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_MODE:-borrow}" = "owner" ] || return 0
    [ -e "${CLOUDBENCH_SCRIPT_SNAPSHOT:-}" ] || return 0
    # Prefer the birth identity sealed at claim/create time. Re-querying ps(1)
    # at EXIT can disagree with the marker under load even for the same PID,
    # which then blocks exact snapshot removal after an otherwise-green fleet.
    owner_start="${CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_PID_START:-}"
    current_start="$(script_snapshot_current_pid_start)"
    if [ -z "$owner_start" ]; then
        owner_start="$current_start"
    elif [ -n "$current_start" ] && [ "$current_start" != "$owner_start" ]; then
        echo "❌ script snapshot owner birth drifted from sealed identity" >&2
        return 1
    fi
    [ -n "$owner_start" ] || return 1
    cleanup_args=(
        cleanup
        --path "$CLOUDBENCH_SCRIPT_SNAPSHOT"
        --temp-root "${TMPDIR:-/tmp}"
        --token "$CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_TOKEN"
        --pid "$$"
        --pid-start "$owner_start"
    )
    [ "$SCRIPT_SNAPSHOT_ALLOW_TRANSFER" = "1" ] && cleanup_args+=(--allow-transfer)
    python3 "$CLOUDBENCH_SCRIPT_SNAPSHOT/$SCRIPT_SNAPSHOT_OWNER_HELPER" \
        "${cleanup_args[@]}" >/dev/null || {
            echo "FATAL: could not remove the exact owned script snapshot" >&2
            return 1
        }
}

wait_for_script_snapshot_claim() {
    local handoff_seconds handoff_attempts outcome_status
    handoff_seconds="${CLOUDBENCH_SCRIPT_SNAPSHOT_HANDOFF_SECONDS:-30}"
    case "$handoff_seconds" in ''|*[!0-9]*|0) handoff_seconds=30 ;; esac
    handoff_attempts=$((handoff_seconds * 10))
    for _ in $(seq 1 "$handoff_attempts"); do
        if [ ! -e "$CLOUDBENCH_SCRIPT_SNAPSHOT" ]; then
            return 0
        fi
        python3 "$CLOUDBENCH_SCRIPT_SNAPSHOT/$SCRIPT_SNAPSHOT_OWNER_HELPER" check-armed \
            --path "$CLOUDBENCH_SCRIPT_SNAPSHOT" \
            --temp-root "${TMPDIR:-/tmp}" \
            --token "$CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_TOKEN" \
            --previous-pid "$$" \
            --previous-pid-start "$CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_PID_START" \
            >/dev/null 2>&1
        outcome_status=$?
        case "$outcome_status" in
            0) return 0 ;;
            11)
                echo "FATAL: detached fleet died while claiming its script snapshot" >&2
                return 1
                ;;
            # A short-lived detached controller can claim, arm, and clean its
            # snapshot between polls. Absence is therefore a completed local
            # lifecycle; tracked --wait still reports its exact run status.
            12) return 0 ;;
            # The owner may remove the snapshot after the existence check but
            # before Python opens the helper inside it. Python exits 2 for the
            # missing file; confirm the directory is gone before accepting it.
            2) [ ! -e "$CLOUDBENCH_SCRIPT_SNAPSHOT" ] && return 0; return 1 ;;
            10) ;;
            *) return 1 ;;
        esac
        sleep 0.1
    done
    python3 "$CLOUDBENCH_SCRIPT_SNAPSHOT/$SCRIPT_SNAPSHOT_OWNER_HELPER" cancel-claim \
        --path "$CLOUDBENCH_SCRIPT_SNAPSHOT" \
        --temp-root "${TMPDIR:-/tmp}" \
        --token "$CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_TOKEN" \
        --previous-pid "$$" \
        --previous-pid-start "$CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_PID_START" \
        >/dev/null 2>&1
    outcome_status=$?
    case "$outcome_status" in
        0|12) return 0 ;;
        11|13) ;;
        14)
            for _ in $(seq 1 100); do
                [ ! -e "$CLOUDBENCH_SCRIPT_SNAPSHOT" ] && break
                python3 "$CLOUDBENCH_SCRIPT_SNAPSHOT/$SCRIPT_SNAPSHOT_OWNER_HELPER" check-armed \
                    --path "$CLOUDBENCH_SCRIPT_SNAPSHOT" \
                    --temp-root "${TMPDIR:-/tmp}" \
                    --token "$CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_TOKEN" \
                    --previous-pid "$$" \
                    --previous-pid-start "$CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_PID_START" \
                    >/dev/null 2>&1
                outcome_status=$?
                case "$outcome_status" in 11|12) break ;; 1) break ;; esac
                sleep 0.1
            done
            ;;
    esac
    echo "FATAL: detached fleet did not claim its script snapshot" >&2
    return 1
}

reconcile_transferred_script_snapshot() {
    local outcome_status
    [ "${CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_MODE:-borrow}" = "borrow" ] || return 0
    [ -e "${CLOUDBENCH_SCRIPT_SNAPSHOT:-}" ] || return 0
    python3 "$ROOT_DIR/scripts/$SCRIPT_SNAPSHOT_OWNER_HELPER" check-armed \
        --path "$CLOUDBENCH_SCRIPT_SNAPSHOT" \
        --temp-root "${TMPDIR:-/tmp}" \
        --token "$CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_TOKEN" \
        --previous-pid "$$" \
        --previous-pid-start "$CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_PID_START" \
        >/dev/null 2>&1
    outcome_status=$?
    case "$outcome_status" in
        11|12) return 0 ;;
        *)
            echo "FATAL: detached fleet completed while its script snapshot owner remained live" >&2
            return 1
            ;;
    esac
}

terminate_script_snapshot_handoff_group() {
    local owner_file="$SCRIPT_SNAPSHOT_HANDOFF_OWNER_FILE"
    local status_file="$SCRIPT_SNAPSHOT_HANDOFF_STATUS_FILE"
    local pid pid_start pgid group_token group_state deadline drain_seconds
    [ -n "$owner_file" ] || return 0
    if [ ! -s "$owner_file" ]; then
        rm -f "$owner_file" "$owner_file".tmp.* 2>/dev/null || return 1
        if [ -n "$status_file" ]; then
            rm -f "$status_file" "$status_file".tmp.* 2>/dev/null || return 1
        fi
        return 0
    fi
    pid="$(cloudbench_tracked_owner_value "$owner_file" pid)"
    pid_start="$(cloudbench_tracked_owner_value "$owner_file" pid_start)"
    pgid="$(cloudbench_tracked_owner_value "$owner_file" pgid)"
    group_token="$(cloudbench_tracked_owner_value "$owner_file" group_token)"
    case "$pid:$pgid" in ''|*[!0-9:]*|:*|*:) return 1 ;; esac
    [ "$pid" = "$pgid" ] && [ -n "$pid_start" ] || return 1
    [ "${#group_token}" -eq 32 ] || return 1
    case "$group_token" in *[!0-9a-f]*) return 1 ;; esac

    # The tracked detacher keeps this exact session leader alive as an identity
    # anchor until its process group drains. Never infer ownership from a bare,
    # reusable numeric PGID.
    cloudbench_pid_matches_start "$pid" "$pid_start" || return 1

    drain_seconds="${CLOUDBENCH_SCRIPT_SNAPSHOT_HANDOFF_DRAIN_SECONDS:-10}"
    case "$drain_seconds" in ''|*[!0-9]*|0) drain_seconds=10 ;; esac
    kill -s TERM -- "-$pgid" 2>/dev/null || true
    deadline=$((SECONDS + drain_seconds))
    group_state="$(cloudbench_process_group_state "$pgid")"
    while [ "$group_state" = "live" ] && [ "$SECONDS" -lt "$deadline" ]; do
        sleep 0.1 || true
        group_state="$(cloudbench_process_group_state "$pgid")"
    done
    [ "$group_state" != "unknown" ] || return 1
    if [ "$group_state" = "live" ]; then
        # The persistent leader is the authorization fence for escalation.
        # If it vanished or its PID was reused, retain the snapshot/rendezvous
        # for audit rather than signaling an unrelated numeric process group.
        if ! cloudbench_pid_matches_start "$pid" "$pid_start"; then
            group_state="$(cloudbench_process_group_state "$pgid")"
            if [ "$group_state" != "absent" ] \
                || cloudbench_pid_exists "$pid"; then
                return 1
            fi
        else
            kill -s KILL -- "-$pgid" 2>/dev/null || true
            deadline=$((SECONDS + 10))
            group_state="$(cloudbench_process_group_state "$pgid")"
            while [ "$group_state" = "live" ] && [ "$SECONDS" -lt "$deadline" ]; do
                sleep 0.1 || true
                group_state="$(cloudbench_process_group_state "$pgid")"
            done
        fi
    fi
    [ "$group_state" = "absent" ] || return 1
    cloudbench_pid_exists "$pid" && return 1
    rm -f "$owner_file" "$owner_file".tmp.* 2>/dev/null || return 1
    if [ -n "$status_file" ]; then
        rm -f "$status_file" "$status_file".tmp.* 2>/dev/null || return 1
    fi
    return 0
}

abort_script_snapshot_handoff() {
    SCRIPT_SNAPSHOT_HANDOFF_PENDING=0
    if terminate_script_snapshot_handoff_group; then
        return 0
    fi
    # Never delete code beneath a detached process whose exact group could not
    # be proven drained. Refuse local cleanup and retain the bundle for audit.
    CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_MODE="borrow"
    return 1
}

cleanup_owned_script_snapshot_on_exit() {
    local ec=$?
    trap - EXIT
    trap '' HUP INT TERM
    stop_script_snapshot_creator || ec=1
    if [ "$SCRIPT_SNAPSHOT_HANDOFF_PENDING" = "1" ]; then
        # The tracked detacher returns only after publishing its owner record or
        # after synchronously reaping an unpublished session. On the latter
        # path there is no claimant to wait 30 seconds for during signal EXIT.
        if [ -s "$SCRIPT_SNAPSHOT_HANDOFF_OWNER_FILE" ]; then
            wait_for_script_snapshot_claim || true
        fi
        abort_script_snapshot_handoff || ec=1
    fi
    cleanup_owned_script_snapshot || ec=1
    if [ -n "$SCRIPT_SNAPSHOT_CREATE_RESULT_FILE" ]; then
        rm -f "$SCRIPT_SNAPSHOT_CREATE_RESULT_FILE" \
            "$SCRIPT_SNAPSHOT_CREATE_RESULT_FILE".tmp.* 2>/dev/null || ec=1
    fi
    if [ -n "$SCRIPT_SNAPSHOT_CREATE_ADOPTION_FILE" ]; then
        rm -f "$SCRIPT_SNAPSHOT_CREATE_ADOPTION_FILE" \
            "$SCRIPT_SNAPSHOT_CREATE_ADOPTION_FILE".tmp.* 2>/dev/null || ec=1
    fi
    exit "$ec"
}

script_snapshot_creator_running() {
    local job_pid
    [ -n "$SCRIPT_SNAPSHOT_CREATOR_PID" ] || return 1
    for job_pid in $(jobs -pr); do
        [ "$job_pid" = "$SCRIPT_SNAPSHOT_CREATOR_PID" ] && return 0
    done
    return 1
}

stop_script_snapshot_creator() {
    local deadline
    [ -n "$SCRIPT_SNAPSHOT_CREATOR_PID" ] || return 0
    if script_snapshot_creator_running; then
        if [ -n "$SCRIPT_SNAPSHOT_CREATOR_PID_START" ] \
            && cloudbench_pid_matches_start \
                "$SCRIPT_SNAPSHOT_CREATOR_PID" "$SCRIPT_SNAPSHOT_CREATOR_PID_START"; then
            kill -s TERM "$SCRIPT_SNAPSHOT_CREATOR_PID" 2>/dev/null || true
        else
            # It is still our unreaped direct child, so its PID cannot have
            # been reused. Refuse a numeric-PID signal when birth identity was
            # not captured; the helper also notices this parent's eventual exit.
            return 1
        fi
        deadline=$((SECONDS + 5))
        while script_snapshot_creator_running \
            && [ "$SECONDS" -lt "$deadline" ]; do
            sleep 0.05 || true
        done
        if script_snapshot_creator_running; then
            if cloudbench_pid_matches_start \
                "$SCRIPT_SNAPSHOT_CREATOR_PID" "$SCRIPT_SNAPSHOT_CREATOR_PID_START"; then
                kill -s KILL "$SCRIPT_SNAPSHOT_CREATOR_PID" 2>/dev/null || true
            else
                return 1
            fi
        fi
    fi
    wait "$SCRIPT_SNAPSHOT_CREATOR_PID" 2>/dev/null || true
    SCRIPT_SNAPSHOT_CREATOR_PID=""
    SCRIPT_SNAPSHOT_CREATOR_PID_START=""
    return 0
}

cleanup_script_snapshot_creation_on_exit() {
    local ec=$?
    trap - EXIT
    trap '' HUP INT TERM
    if stop_script_snapshot_creator; then
        if [ -n "$SCRIPT_SNAPSHOT_EXPECTED_PATH" ] \
            && ! python3 "$ROOT_DIR/scripts/$SCRIPT_SNAPSHOT_OWNER_HELPER" recover-create \
                --path "$SCRIPT_SNAPSHOT_EXPECTED_PATH" \
                --temp-root "${TMPDIR:-/tmp}" \
                --token "$CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_TOKEN" \
                --pid "$$" --pid-start "$(script_snapshot_current_pid_start)" \
                >/dev/null; then
            ec=1
        fi
    else
        ec=1
    fi
    rm -f "$SCRIPT_SNAPSHOT_CREATE_RESULT_FILE" \
        "$SCRIPT_SNAPSHOT_CREATE_RESULT_FILE".tmp.* \
        "$SCRIPT_SNAPSHOT_CREATE_ADOPTION_FILE" \
        "$SCRIPT_SNAPSHOT_CREATE_ADOPTION_FILE".tmp.* 2>/dev/null || ec=1
    exit "$ec"
}

arm_script_snapshot_exit_guard() {
    trap cleanup_owned_script_snapshot_on_exit EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
}

defer_script_snapshot_initialization_signals() {
    SCRIPT_SNAPSHOT_PENDING_SIGNAL=""
    trap 'SCRIPT_SNAPSHOT_PENDING_SIGNAL=HUP' HUP
    trap 'SCRIPT_SNAPSHOT_PENDING_SIGNAL=INT' INT
    trap 'SCRIPT_SNAPSHOT_PENDING_SIGNAL=TERM' TERM
}

replay_deferred_script_snapshot_signal() {
    case "$SCRIPT_SNAPSHOT_PENDING_SIGNAL" in
        HUP) exit 129 ;;
        INT) exit 130 ;;
        TERM) exit 143 ;;
    esac
}

if [ -z "${CLOUDBENCH_SCRIPT_SNAPSHOT:-}" ]; then
    enter_script_snapshot() {
        local snapshot_status
        # shellcheck source=/dev/null
        source "$CLOUDBENCH_SCRIPT_SNAPSHOT/run-bench-fleet" "$@"
        snapshot_status=$?
        exit "$snapshot_status"
    }
fi

if [ -n "${CLOUDBENCH_SCRIPT_SNAPSHOT:-}" ]; then
    case "${CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_MODE:-borrow}" in
        owner)
            arm_script_snapshot_exit_guard
            ;;
        claim)
            defer_script_snapshot_initialization_signals
            if [ -n "${CLOUDBENCH_TEST_SCRIPT_SNAPSHOT_BEFORE_CLAIM_READY:-}" ]; then
                printf '%s\n' "$$" > "$CLOUDBENCH_TEST_SCRIPT_SNAPSHOT_BEFORE_CLAIM_READY"
                while [ -z "$SCRIPT_SNAPSHOT_PENDING_SIGNAL" ] \
                    && [ ! -e "${CLOUDBENCH_TEST_SCRIPT_SNAPSHOT_BEFORE_CLAIM_RELEASE:-}" ]; do
                    sleep 0.05
                done
            fi
            claim_script_snapshot_ownership || {
                echo "FATAL: detached fleet could not claim its script snapshot" >&2
                exit 1
            }
            if [ -n "${CLOUDBENCH_TEST_SCRIPT_SNAPSHOT_CLAIMED_READY:-}" ]; then
                printf '%s\n' "$$" > "$CLOUDBENCH_TEST_SCRIPT_SNAPSHOT_CLAIMED_READY"
                while [ -z "$SCRIPT_SNAPSHOT_PENDING_SIGNAL" ] \
                    && [ ! -e "${CLOUDBENCH_TEST_SCRIPT_SNAPSHOT_CLAIMED_RELEASE:-}" ]; do
                    sleep 0.05
                done
            fi
            arm_script_snapshot_exit_guard
            owner_start="$(script_snapshot_current_pid_start)"
            python3 "$CLOUDBENCH_SCRIPT_SNAPSHOT/$SCRIPT_SNAPSHOT_OWNER_HELPER" arm \
                --path "$CLOUDBENCH_SCRIPT_SNAPSHOT" \
                --temp-root "${TMPDIR:-/tmp}" \
                --token "$CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_TOKEN" \
                --pid "$$" --pid-start "$owner_start" >/dev/null || exit 1
            replay_deferred_script_snapshot_signal
            if [ -n "${CLOUDBENCH_TEST_SCRIPT_SNAPSHOT_ARMED_READY:-}" ]; then
                printf '%s\n' "$$" > "$CLOUDBENCH_TEST_SCRIPT_SNAPSHOT_ARMED_READY"
                while [ ! -e "${CLOUDBENCH_TEST_SCRIPT_SNAPSHOT_ARMED_RELEASE:-}" ]; do
                    sleep 0.05
                done
            fi
            if [ -n "${CLOUDBENCH_TEST_SCRIPT_SNAPSHOT_EXIT_AFTER_CLAIM:-}" ]; then
                exit "$CLOUDBENCH_TEST_SCRIPT_SNAPSHOT_EXIT_AFTER_CLAIM"
            fi
            ;;
        borrow) ;;
        *)
            echo "FATAL: invalid script snapshot ownership mode" >&2
            exit 2
            ;;
    esac
fi

# First entry must derive ROOT_DIR from this script's path. A leaked
# CLOUDBENCH_FLEET_ROOT from a parent agent shell (or prior controller) would
# otherwise silently retarget ownership ledgers into a foreign worktree while
# still executing this checkout's sealed snapshot bytes.
if [ -z "${CLOUDBENCH_SCRIPT_SNAPSHOT:-}" ]; then
    ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
else
    ROOT_DIR="${CLOUDBENCH_FLEET_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
fi
cd "$ROOT_DIR" || exit 1
# shellcheck source=lib/cloudbench-env.sh
source "${CLOUDBENCH_SCRIPT_SNAPSHOT:-$ROOT_DIR/scripts/lib}/cloudbench-env.sh"
# Injected $GITHUB_TOKEN is often an invalid github_pat_. Overwrite process env
# and local .env so children inherit the working hosts.yml / insteadOf token.
cloudbench_export_controller_github_token \
  "$ROOT_DIR/agents/.env" \
  "$ROOT_DIR/back-end/.env" \
  || echo "WARN: controller GITHUB_TOKEN export failed; fetch-ref still uses cloudbench_controller_github_token" >&2

# ── Run from a script SNAPSHOT, never the live checkout ─────────────────────
# bash reads scripts lazily from disk: editing run-bench-fleet/run-bench-cloud
# while a controller is mid-run shifts bytes under the interpreter and kills a
# healthy fleet with a parse error (observed: 28 provisioned boxes torn down by
# "syntax error near unexpected token 'fi'" after an in-flight edit). Enter an
# immutable per-invocation copy so the working tree stays editable.
if [ -z "${CLOUDBENCH_SCRIPT_SNAPSHOT:-}" ]; then
    if ! CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_TOKEN="$(python3 -c 'import secrets; print(secrets.token_hex(16))')" \
        || [ -z "$CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_TOKEN" ]; then
        echo "FATAL: could not create the fleet script snapshot owner token" >&2
        exit 1
    fi
    # Shell traps do not protect an external mktemp hit by the same process-group
    # signal. The helper owns directory creation through marker + result
    # publication and defers those signals itself, so every failure before the
    # shell learns the exact path removes the directory inside one process.
    defer_script_snapshot_initialization_signals
    owner_start="$(script_snapshot_current_pid_start)"
    if [ -z "$owner_start" ]; then
        replay_deferred_script_snapshot_signal
        echo "FATAL: could not resolve the fleet script snapshot owner identity" >&2
        exit 1
    fi
    SCRIPT_SNAPSHOT_CREATE_RESULT_FILE="${TMPDIR:-/tmp}/.cloudbench-script-snapshot-create.$$.$CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_TOKEN"
    SCRIPT_SNAPSHOT_CREATE_ADOPTION_FILE="${TMPDIR:-/tmp}/.cloudbench-script-snapshot-adopt.$$.$CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_TOKEN"
    snapshot_temp_root="$(cd "${TMPDIR:-/tmp}" 2>/dev/null && pwd -P)"
    if [ -z "$snapshot_temp_root" ]; then
        echo "FATAL: could not resolve the fleet script snapshot temp root" >&2
        exit 1
    fi
    SCRIPT_SNAPSHOT_EXPECTED_PATH="$snapshot_temp_root/cloudbench-scripts.$CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_TOKEN"
    if [ -e "$SCRIPT_SNAPSHOT_EXPECTED_PATH" ]; then
        echo "FATAL: fleet script snapshot token path already exists" >&2
        exit 1
    fi
    trap cleanup_script_snapshot_creation_on_exit EXIT
    python3 "$ROOT_DIR/scripts/$SCRIPT_SNAPSHOT_OWNER_HELPER" create \
        --path "$SCRIPT_SNAPSHOT_EXPECTED_PATH" \
        --temp-root "${TMPDIR:-/tmp}" \
        --token "$CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_TOKEN" \
        --pid "$$" --pid-start "$owner_start" >/dev/null &
    SCRIPT_SNAPSHOT_CREATOR_PID=$!
    SCRIPT_SNAPSHOT_CREATOR_PID_START="$(cloudbench_pid_start_time "$SCRIPT_SNAPSHOT_CREATOR_PID")"
    creation_deadline=$((SECONDS + 30))
    while [ ! -s "$SCRIPT_SNAPSHOT_CREATE_RESULT_FILE" ]; do
        if [ -n "$SCRIPT_SNAPSHOT_PENDING_SIGNAL" ]; then
            stop_script_snapshot_creator || true
            replay_deferred_script_snapshot_signal
        fi
        if ! script_snapshot_creator_running; then
            wait "$SCRIPT_SNAPSHOT_CREATOR_PID" 2>/dev/null
            create_status=$?
            SCRIPT_SNAPSHOT_CREATOR_PID=""
            SCRIPT_SNAPSHOT_CREATOR_PID_START=""
            replay_deferred_script_snapshot_signal
            echo "FATAL: could not create and publish the fleet script snapshot (exit=$create_status)" >&2
            exit 1
        fi
        if [ "$SECONDS" -ge "$creation_deadline" ]; then
            stop_script_snapshot_creator || true
            echo "FATAL: fleet script snapshot creator did not publish its path" >&2
            exit 1
        fi
        sleep 0.01 || true
    done
    helper_pending_signal=""
    if ! {
        IFS= read -r CLOUDBENCH_SCRIPT_SNAPSHOT
        IFS= read -r helper_pending_signal
    } < "$SCRIPT_SNAPSHOT_CREATE_RESULT_FILE"; then
        echo "FATAL: fleet script snapshot helper result is unreadable" >&2
        exit 1
    fi
    if [ "$CLOUDBENCH_SCRIPT_SNAPSHOT" != "$SCRIPT_SNAPSHOT_EXPECTED_PATH" ]; then
        echo "FATAL: fleet script snapshot helper published the wrong owned path" >&2
        exit 1
    fi
    CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_MODE="owner"
    CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_PID="$$"
    CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_PID_START="$owner_start"
    export CLOUDBENCH_SCRIPT_SNAPSHOT CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_TOKEN \
        CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_MODE CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_PID \
        CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_PID_START CLOUDBENCH_FLEET_ROOT="$ROOT_DIR"
    # The helper still owns rollback until it validates this acknowledgement.
    # Arm the shell first, so every error after adopting the path has an exact
    # owner on both sides of the acknowledgement boundary.
    arm_script_snapshot_exit_guard
    if ! python3 "$CLOUDBENCH_SCRIPT_SNAPSHOT/$SCRIPT_SNAPSHOT_OWNER_HELPER" adopt \
        --path "$CLOUDBENCH_SCRIPT_SNAPSHOT" \
        --temp-root "${TMPDIR:-/tmp}" \
        --token "$CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_TOKEN" \
        --pid "$$" --pid-start "$owner_start" >/dev/null; then
        echo "FATAL: could not acknowledge the fleet script snapshot owner" >&2
        exit 1
    fi
    wait "$SCRIPT_SNAPSHOT_CREATOR_PID" 2>/dev/null
    create_status=$?
    SCRIPT_SNAPSHOT_CREATOR_PID=""
    SCRIPT_SNAPSHOT_CREATOR_PID_START=""
    if [ "$create_status" -ne 0 ]; then
        echo "FATAL: fleet script snapshot creator rejected owner adoption (exit=$create_status)" >&2
        exit 1
    fi
    if [ -z "$SCRIPT_SNAPSHOT_PENDING_SIGNAL" ] && [ -n "$helper_pending_signal" ]; then
        SCRIPT_SNAPSHOT_PENDING_SIGNAL="${helper_pending_signal#SIG}"
    fi
    replay_deferred_script_snapshot_signal
    if [ "${CLOUDBENCH_TEST_SCRIPT_SNAPSHOT_FAIL_COPY:-0}" = "1" ] \
        || ! cp "$ROOT_DIR/scripts/run-bench-fleet" \
       "$ROOT_DIR/scripts/run-bench-cloud" \
       "$ROOT_DIR/scripts/cloudbench-boot.sh" \
       "$ROOT_DIR/scripts/cloudbench-run.sh" \
       "$ROOT_DIR/scripts/cloudbench-worker.sh" \
       "$ROOT_DIR/scripts/cloudbench-fetch-ref.sh" \
       "$ROOT_DIR/scripts/cloudbench-sync-deps.sh" \
       "$ROOT_DIR/scripts/cloudbench-sync-prisma-client.sh" \
       "$ROOT_DIR/scripts/cloudbench-current-run-artifact.py" \
       "$ROOT_DIR/scripts/cloudbench-prepare-patch.sh" \
       "$ROOT_DIR/scripts/cloudbench-status-server.py" \
       "$ROOT_DIR/scripts/cloudbench-benchmark-target.py" \
       "$ROOT_DIR/scripts/cloudbench_catalog.py" \
       "$ROOT_DIR/scripts/cloudbench-port-lease.py" \
       "$ROOT_DIR/scripts/cloudbench-machine-readiness.py" \
       "$ROOT_DIR/scripts/cloudbench-select-snapshot.py" \
       "$ROOT_DIR/scripts/cloudbench-aggregate-runs.py" \
       "$ROOT_DIR/scripts/cloudbench_execution_provenance.py" \
       "$ROOT_DIR/scripts/cloudbench_result.py" \
       "$ROOT_DIR/scripts/lib/cloudbench-env.sh" \
       "$ROOT_DIR/scripts/lib/cloudbench-seed-budget.sh" \
       "$ROOT_DIR/scripts/lib/cloudbench-app-env-lock.sh" \
       "$ROOT_DIR/scripts/lib/cloudbench-github-token.sh" \
       "$CLOUDBENCH_SCRIPT_SNAPSHOT/"; then
        echo "FATAL: could not populate the fleet script snapshot" >&2
        exit 1
    fi
    # Seal the dependency bundle only after every interpreter/helper byte is in
    # place. Runtime ownership metadata changes during handoff and is therefore
    # deliberately outside the content manifest; controller dependencies are
    # not. Every child re-verifies this manifest before staging guest code.
    if ! python3 "$CLOUDBENCH_SCRIPT_SNAPSHOT/cloudbench_execution_provenance.py" snapshot \
        --snapshot-dir "$CLOUDBENCH_SCRIPT_SNAPSHOT" \
        --output "$CLOUDBENCH_SCRIPT_SNAPSHOT/cloudbench-controller-snapshot-manifest.json"; then
        echo "FATAL: could not seal the fleet script snapshot" >&2
        exit 1
    fi
    if [ "${CLOUDBENCH_TEST_SCRIPT_SNAPSHOT_FAIL_RESULT_REMOVE:-0}" = "1" ] \
        || ! rm -f "$SCRIPT_SNAPSHOT_CREATE_RESULT_FILE" \
            "$SCRIPT_SNAPSHOT_CREATE_RESULT_FILE".tmp.* \
            "$SCRIPT_SNAPSHOT_CREATE_ADOPTION_FILE" \
            "$SCRIPT_SNAPSHOT_CREATE_ADOPTION_FILE".tmp.* 2>/dev/null; then
        echo "FATAL: could not remove the fleet script snapshot creation rendezvous" >&2
        exit 1
    fi
    SCRIPT_SNAPSHOT_CREATE_RESULT_FILE=""
    SCRIPT_SNAPSHOT_CREATE_ADOPTION_FILE=""
    SCRIPT_SNAPSHOT_EXPECTED_PATH=""
    enter_script_snapshot "$@"
fi

# Bash 3.2 preserves an inherited export attribute when a shell variable is
# reassigned (including through `local`). Provider inventory is unbounded JSON;
# never let a caller's generic exported name turn one of these internal buffers
# into exec environment and trigger E2BIG in Python, sed, sleep, or Fly itself.
export -n inventory machines machines_json warm_json POOL_INVENTORY_JSON SNAPSHOTS_JSON 2>/dev/null || true

RUN_BENCH_CLOUD_BIN="$CLOUDBENCH_SCRIPT_SNAPSHOT/run-bench-cloud"
AUTOSCALER_PORT_LEASE_HELPER="$CLOUDBENCH_SCRIPT_SNAPSHOT/cloudbench-port-lease.py"
MACHINE_READINESS_SCRIPT="$CLOUDBENCH_SCRIPT_SNAPSHOT/cloudbench-machine-readiness.py"
SNAPSHOT_SELECTOR_SCRIPT="$CLOUDBENCH_SCRIPT_SNAPSHOT/cloudbench-select-snapshot.py"
AGGREGATE_RUNS_SCRIPT="$CLOUDBENCH_SCRIPT_SNAPSHOT/cloudbench-aggregate-runs.py"
EXECUTION_PROVENANCE_SCRIPT="$CLOUDBENCH_SCRIPT_SNAPSHOT/cloudbench_execution_provenance.py"
CONTROLLER_SNAPSHOT_MANIFEST="$CLOUDBENCH_SCRIPT_SNAPSHOT/cloudbench-controller-snapshot-manifest.json"
CLOUDBENCH_RESULT_SCRIPT="$CLOUDBENCH_SCRIPT_SNAPSHOT/cloudbench_result.py"

APP="navi-whisper-lux-bench"
REGION="${CLOUDBENCH_REGION:-iad}"
MACHINE_NAME="cloudbench-warm"
VOLUME_NAME="cloudbench_data"
# The warm maintenance source is intentionally roomy (shared-cpu-4x/8GB), but
# inheriting that shape across 37 primaries consumed 148 CPU units. With prod's
# observed 16 active units, Fly rejected the 37th at its 160-unit overcommit
# governor. Fly caps shared-cpu-2x at 4GB, while converting the entire stopped
# pool to performance-1x/8GB exhausts the org's performance-CPU reservation
# before all 37 machines are configured. The valid fleet-wide shape is
# shared-cpu-2x/4GB: 74 running CPU units at full concurrency, below the
# observed ceiling, with no performance reservation dependency. Worker-only
# clones mirror prod's performance-1x/2GB shape.
FLEET_PRIMARY_VM_SIZE="${CLOUDBENCH_FLEET_PRIMARY_VM_SIZE:-shared-cpu-2x}"
FLEET_PRIMARY_VM_MEMORY="${CLOUDBENCH_FLEET_PRIMARY_VM_MEMORY:-4096}"
# A small subset of benchmarks runs the test-payment frontend bundled inside
# the primary VM. The Vite production build exceeds the default 4GB guest's
# physical memory during chunk rendering, so only those primaries use a larger
# shape. Keep the stopped pool at the capacity-safe default; bundled-frontend
# tasks bypass the pool and clone fresh with this shape.
FLEET_BUNDLED_FRONTEND_VM_SIZE="${CLOUDBENCH_FLEET_BUNDLED_FRONTEND_VM_SIZE:-shared-cpu-4x}"
FLEET_BUNDLED_FRONTEND_VM_MEMORY="${CLOUDBENCH_FLEET_BUNDLED_FRONTEND_VM_MEMORY:-8192}"
FLEET_WORKER_VM_SIZE="${CLOUDBENCH_FLEET_WORKER_VM_SIZE:-performance-1x}"
FLEET_WORKER_VM_MEMORY="${CLOUDBENCH_FLEET_WORKER_VM_MEMORY:-2048}"
FLEET_WORKER_HEALTH_PORT="${CLOUDBENCH_WORKER_HEALTH_PORT:-3103}"
WARM_PARKED_VM_SIZE="${CLOUDBENCH_WARM_PARKED_VM_SIZE:-shared-cpu-1x}"
WARM_PARKED_VM_MEMORY="${CLOUDBENCH_WARM_PARKED_VM_MEMORY:-2048}"
# Every run lands in its OWN dir under the runs-root; the central hub (one
# persistent dashboard on DASH_BASE) scans the runs-root so ALL runs show up and
# each is clickable at /run/<id>/. Runs never clobber each other.
RUNS_ROOT="${CLOUDBENCH_RUNS_ROOT:-$ROOT_DIR/.context/fleet/runs}"
case "$RUNS_ROOT" in /*) ;; *) RUNS_ROOT="$ROOT_DIR/$RUNS_ROOT" ;; esac
RUN_ID="$(date +%Y%m%d-%H%M%S)-$$"
BARRIER_RELEASE_TOKEN="${CLOUDBENCH_BARRIER_TOKEN:-$(python3 -c 'import secrets; print(secrets.token_urlsafe(32))')}"
export CLOUDBENCH_BARRIER_TOKEN="$BARRIER_RELEASE_TOKEN"
FLEET_DIR="$RUNS_ROOT/$RUN_ID"
TAINTED_POOL_FILE="$FLEET_DIR/tainted-pool.ids"
HUB_CTX_DIR="$RUNS_ROOT/_hub"
# One controller lock per workspace by default. Concurrent one-task fleets on
# the SAME workspace (DEMO lane / campaign_cap=N) must set
# CLOUDBENCH_CONTROLLER_LOCK_NAME to a distinct basename so they do not
# serialize on local_lock_busy — pool claims are already atomic across
# controllers, and each fleet owns only the machines it creates.
_CLOUDBENCH_LOCK_BASENAME="${CLOUDBENCH_CONTROLLER_LOCK_NAME:-cloudbench-controller.lock}"
case "$_CLOUDBENCH_LOCK_BASENAME" in
    ''|.*|*/*|*\\*|*[!A-Za-z0-9._-]*)
        echo "FATAL: CLOUDBENCH_CONTROLLER_LOCK_NAME must be a simple basename (got: ${_CLOUDBENCH_LOCK_BASENAME})" >&2
        exit 2
        ;;
esac
LOCK_DIR="$ROOT_DIR/.context/$_CLOUDBENCH_LOCK_BASENAME"
unset _CLOUDBENCH_LOCK_BASENAME
HUB_UPLOAD_HELPER="$ROOT_DIR/agents/benchmarks/hub_upload.py"
INHERITED_HUB_RUN_ID="${BENCHMARK_HUB_PARENT_RUN_ID:-}"
SELF_MANAGED_HUB_RUN="0"
CENTRAL_HUB_OWNER_FILE=""

# ── Args ─────────────────────────────────────────────────────────────────────
BENCHES=()
SIM_ON_CSV=""

bench_needs_bundled_frontend_primary() {  # bench_needs_bundled_frontend_primary <task>
    case "$1" in
        agent-payment-test-shop|agent-payment-idempotent-abandonment|agent-payment-abandonment|agent-payment-setup-resume|gate-subscription-card-mint|gate-kyc-card-mint)
            return 0
            ;;
    esac
    return 1
}

primary_vm_size_for_bench() {  # primary_vm_size_for_bench <task>
    if bench_needs_bundled_frontend_primary "$1"; then
        printf '%s\n' "$FLEET_BUNDLED_FRONTEND_VM_SIZE"
    else
        printf '%s\n' "$FLEET_PRIMARY_VM_SIZE"
    fi
}

primary_vm_memory_for_bench() {  # primary_vm_memory_for_bench <task>
    if bench_needs_bundled_frontend_primary "$1"; then
        printf '%s\n' "$FLEET_BUNDLED_FRONTEND_VM_MEMORY"
    else
        printf '%s\n' "$FLEET_PRIMARY_VM_MEMORY"
    fi
}

shared_cpu_units_for_vm_size() {  # shared_cpu_units_for_vm_size <vm-size>
    local vm_size="$1" units
    case "$vm_size" in
        shared-cpu-*)
            units="${vm_size##*-}"
            units="${units%x}"
            case "$units" in ''|*[!0-9]*) printf '%s\n' 2 ;; *) printf '%s\n' "$units" ;; esac
            ;;
        *)
            printf '%s\n' 0
            ;;
    esac
}
BENCH_REF=""
# Per-workspace hub port: the hub scans THIS workspace's runs-root, so two
# workspaces must not share a port (the second would adopt the first's hub and
# never see its own runs). CONDUCTOR_PORT=3001 → 8765 (the historical default).
DASH_BASE="${CLOUDBENCH_DASH_BASE:-$(( ${CONDUCTOR_PORT:-3001} + 5764 ))}"
KEEP_CLONES="0"
RUN_TIMEOUT="3600"
AUTOSCALE_MAX="15"      # prod MAX_MACHINES; per-bench ceiling of worker machines
AUTOSCALE_POLL="10"     # seconds between desired-count reads off the box /metrics
# A compute-only benchmark worker cannot observe controller-owned clones, so
# its absolute desired count falls back to its local count whenever the prod
# policy makes a hold-steady decision. Require a stable low target before
# treating it as a revocation of queue-ready capacity.
AUTOSCALE_SCALE_DOWN_CONFIRM_SECONDS="${CLOUDBENCH_AUTOSCALE_SCALE_DOWN_CONFIRM_SECONDS:-60}"
AUTOSCALER_STARTUP_WAIT_SECONDS="${CLOUDBENCH_AUTOSCALER_STARTUP_WAIT_SECONDS:-600}"
WORKER_STAGE_ATTEMPTS="${CLOUDBENCH_WORKER_STAGE_ATTEMPTS:-40}"
WORKER_READY_TIMEOUT="${CLOUDBENCH_WORKER_READY_TIMEOUT:-300}"
# One failed staging attempt can consume five 20s provider calls, watchdog
# teardown, and retry sleep when a dirty patch is present. Keep the terminal
# drain budget tied to that bounded lifecycle so child completion cannot kill a
# legitimately in-flight worker before its own failure/ready outcome is due.
WORKER_STAGE_ATTEMPT_WALL_SECONDS="120"
AUTOSCALER_FINALIZATION_WAIT_SECONDS="${CLOUDBENCH_AUTOSCALER_FINALIZATION_WAIT_SECONDS:-}"
SYNCHRONIZED_START="${CLOUDBENCH_SYNCHRONIZED_START:-1}"
CONTROLLER_RETRY_SECONDS="${CLOUDBENCH_CONTROLLER_RETRY_SECONDS:-10}"
PROVISION_POOL=""       # --provision-pool N: pre-provision N stopped clones (current image) then exit
INFRA_PROBE="${CLOUDBENCH_INFRA_PROBE:-0}"
SKIP_AUTOSCALER="${CLOUDBENCH_SKIP_AUTOSCALER:-0}"
STRICT_BARRIER="${CLOUDBENCH_STRICT_BARRIER:-0}"
RECOVER_STALE_ONLY="0"
RECOVER_OWNER_TOKEN=""
GIT_COMMON_DIR="$(git rev-parse --git-common-dir 2>/dev/null || echo "$ROOT_DIR/.git")"
case "$GIT_COMMON_DIR" in /*) ;; *) GIT_COMMON_DIR="$ROOT_DIR/$GIT_COMMON_DIR" ;; esac
GIT_COMMON_DIR="$(cd "$GIT_COMMON_DIR" 2>/dev/null && pwd -P)" || {
    echo "❌ could not canonicalize the shared git ownership root" >&2
    exit 1
}
POOL_WORKSPACE_KEY="$(printf '%s' "$(basename "$ROOT_DIR")" | tr -c 'a-zA-Z0-9._-' '-')"
POOL_IDS_FILE="$GIT_COMMON_DIR/cloudbench-pools/$POOL_WORKSPACE_KEY.ids"
POOL_META_FILE="$POOL_IDS_FILE.deps"
POOL_IDS_LOCK="$POOL_IDS_FILE.lock"
LEGACY_POOL_IDS_FILE="$ROOT_DIR/.context/cloudbench-pool.ids"
POOL_CLAIMS_DIR="$GIT_COMMON_DIR/cloudbench-pool-claims"
ORIG_ARGS=("$@")
# Paid fleet ownership must outlive the shell/tool session that launched it.
# A foreground run can be terminated without an EXIT trap (for example when an
# agent exec cell is reclaimed), stranding every machine and volume. Keep
# foreground mode as an explicit test/debug opt-out only.
DETACH="1"
WAIT_FOR_DETACHED="0"
# Ephemeral clone ownership must outlive a disposable Conductor workspace and
# the controller process itself. Each fleet writes one registry under the shared
# git-common dir; per-clone records are independent files so concurrent
# autoscalers cannot clobber one another's name→ID handoff.
FLEET_OWNERSHIP_ROOT="$GIT_COMMON_DIR/cloudbench-fleet-ownership"
FLEET_AUDIT_ROOT="$GIT_COMMON_DIR/cloudbench-fleet-audits"
FLEET_OWNER_HOST="$(hostname 2>/dev/null || uname -n)"
# Fleet registry, capacity, and inventory-lock records keep the edge-trimmed
# lstart spelling where /proc is unavailable, so a live macOS owner written by
# an older controller still reads as alive in the shared git-common registry.
fleet_pid_start_time() {
    if [ -r /proc/self/stat ]; then
        cloudbench_pid_start_time "$1"
        return
    fi
    ps -p "$1" -o lstart= 2>/dev/null | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
}

fleet_pid_matches_start() {  # <pid> <recorded-identity>
    local actual_start
    [ -n "$2" ] || return 1
    case "$2" in
        proc-start:*)
            cloudbench_pid_matches_start "$1" "$2"
            return
            ;;
    esac
    actual_start="$(ps -p "$1" -o lstart= 2>/dev/null | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    [ -n "$actual_start" ] && [ "$actual_start" = "$2" ]
}

FLEET_OWNER_PID_START="$(fleet_pid_start_time $$)"
if [ -n "${CLOUDBENCH_FLEET_OWNER_TOKEN:-}" ]; then
    FLEET_OWNER_TOKEN="$CLOUDBENCH_FLEET_OWNER_TOKEN"
elif [ "${CLOUDBENCH_TEST_FLEET_OWNER_TOKEN+x}" = "x" ]; then
    FLEET_OWNER_TOKEN="$CLOUDBENCH_TEST_FLEET_OWNER_TOKEN"
else
    FLEET_OWNER_TOKEN="$(python3 -c 'import uuid; print(uuid.uuid4().hex)')"
fi
case "$FLEET_OWNER_TOKEN" in
    [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
    *) echo "❌ invalid fleet owner token" >&2; exit 1 ;;
esac
FLEET_REGISTRY_DIR="$FLEET_OWNERSHIP_ROOT/$FLEET_OWNER_TOKEN"
FLEET_REGISTRY_PUBLISHED=0
# Capacity admission is host-wide, not workspace-local.  Conductor worktrees
# have distinct .context directories, so a workspace lock cannot prevent two
# controllers from admitting against the same Fly inventory snapshot.  Keep
# short durable reservations under the host temp root; fcntl serializes their
# read/prune/write transaction and owner PID birth identity makes crash recovery
# safe against PID reuse.
CAPACITY_RESERVATION_ROOT="${CLOUDBENCH_CAPACITY_RESERVATION_ROOT:-${TMPDIR:-/tmp}/rose-cloudbench-capacity-$APP}"
CAPACITY_RESERVATION_TOKEN="$FLEET_OWNER_TOKEN-primary"
CAPACITY_RESERVATION_PUBLISHED=0
CLEANUP_DISK_RESERVE_FILE="$FLEET_REGISTRY_DIR/cleanup-disk-reserve"
while [ $# -gt 0 ]; do
    case "$1" in
        --detach)         DETACH="1"; shift ;;
        --wait)           DETACH="1"; WAIT_FOR_DETACHED="1"; shift ;;
        --foreground)     DETACH="0"; WAIT_FOR_DETACHED="0"; shift ;;
        --recover-stale-owner)
            RECOVER_STALE_ONLY="1"; DETACH="0"; WAIT_FOR_DETACHED="0"
            RECOVER_OWNER_TOKEN="${2:-}"; shift 2
            ;;
        --sim-on)         SIM_ON_CSV="${2:-}"; shift 2 ;;
        --ref)            BENCH_REF="${2:-}"; shift 2 ;;
        --dash-base)      DASH_BASE="${2:-}"; shift 2 ;;
        --keep-clones)    KEEP_CLONES="1"; shift ;;
        --timeout)        RUN_TIMEOUT="${2:-}"; shift 2 ;;
        --autoscale-max)
            AUTOSCALE_MAX="${2:-}"
            if [ "$#" -ge 2 ]; then shift 2; else shift; fi
            ;;
        --provision-pool) PROVISION_POOL="${2:-}"; shift 2 ;;   # one-time: create N stopped clones, then exit
        --infra-probe)    INFRA_PROBE="1"; STRICT_BARRIER="1"; shift ;;
        --skip-autoscaler) SKIP_AUTOSCALER="1"; shift ;;
        --strict-barrier) STRICT_BARRIER="1"; shift ;;
        -h|--help)        sed -n '2,55p' "${BASH_SOURCE[0]}"; exit 0 ;;
        --*)              echo "❌ Unknown flag: $1" >&2; exit 2 ;;
        *)                # Split each positional token on whitespace so a single
                          # space-joined arg ("a b c") still yields multiple
                          # benches. Bench names are [a-z0-9-] and never contain
                          # spaces, so this is lossless — and it guards the common
                          # footgun of passing an unquoted variable from zsh (the
                          # default interactive shell here), which does NOT
                          # word-split, collapsing `run-bench $LIST` into one bench.
                          for _tok in $1; do BENCHES+=("$_tok"); done
                          shift ;;
    esac
done
if [ "${CLOUDBENCH_TEST_FLEET_OWNER_TOKEN+x}" != "x" ]; then
    case "$FLEET_OWNER_TOKEN" in
        [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
        *) echo "❌ fleet owner token must be exactly 32 lowercase hex characters" >&2; exit 2 ;;
    esac
fi
if [ "$RECOVER_STALE_ONLY" = "1" ]; then
    case "$RECOVER_OWNER_TOKEN" in
        [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
        *) echo "❌ --recover-stale-owner requires exactly 32 lowercase hex characters" >&2; exit 2 ;;
    esac
fi
if [ "$WAIT_FOR_DETACHED" = "1" ]; then
    case "${CLOUDBENCH_DETACHED_RECOVERY_SECONDS:-120}" in
        ''|*[!0-9]*|0)
            echo "❌ CLOUDBENCH_DETACHED_RECOVERY_SECONDS must be a positive integer" >&2
            exit 2
            ;;
    esac
fi
case "$AUTOSCALE_MAX" in
    ''|*[!0-9]*)
        echo "❌ --autoscale-max must be an integer of at least 2" >&2
        exit 2
        ;;
esac
if [ "$AUTOSCALE_MAX" -lt 2 ]; then
    echo "❌ --autoscale-max must be an integer of at least 2" >&2
    exit 2
fi
case "$AUTOSCALE_SCALE_DOWN_CONFIRM_SECONDS" in
    ''|*[!0-9]*|0)
        echo "❌ CLOUDBENCH_AUTOSCALE_SCALE_DOWN_CONFIRM_SECONDS must be a positive integer" >&2
        exit 2
        ;;
esac
case "$AUTOSCALER_STARTUP_WAIT_SECONDS" in
    ''|*[!0-9]*)
        echo "❌ CLOUDBENCH_AUTOSCALER_STARTUP_WAIT_SECONDS must be a non-negative integer" >&2
        exit 2
        ;;
esac
case "$WORKER_STAGE_ATTEMPTS" in
    ''|*[!0-9]*|0)
        echo "❌ CLOUDBENCH_WORKER_STAGE_ATTEMPTS must be a positive integer" >&2
        exit 2
        ;;
esac
case "$WORKER_READY_TIMEOUT" in
    ''|*[!0-9]*|0)
        echo "❌ CLOUDBENCH_WORKER_READY_TIMEOUT must be a positive integer" >&2
        exit 2
        ;;
esac
if [ -z "$AUTOSCALER_FINALIZATION_WAIT_SECONDS" ]; then
    AUTOSCALER_FINALIZATION_WAIT_SECONDS=$((
        WORKER_STAGE_ATTEMPTS * WORKER_STAGE_ATTEMPT_WALL_SECONDS \
        + WORKER_READY_TIMEOUT + 60
    ))
fi
case "$AUTOSCALER_FINALIZATION_WAIT_SECONDS" in
    ''|*[!0-9]*)
        echo "❌ CLOUDBENCH_AUTOSCALER_FINALIZATION_WAIT_SECONDS must be a non-negative integer" >&2
        exit 2
        ;;
esac
case "$FLEET_WORKER_HEALTH_PORT" in
    ''|*[!0-9]*|0) echo "❌ CLOUDBENCH_WORKER_HEALTH_PORT must be a positive integer" >&2; exit 2 ;;
esac
[ "$FLEET_WORKER_HEALTH_PORT" -le 65535 ] \
    || { echo "❌ CLOUDBENCH_WORKER_HEALTH_PORT must be at most 65535" >&2; exit 2; }
# Dedupe bench names (preserve first-seen order). Each bench gets ONE isolated
# machine keyed on $FLEET_DIR/$bench, so a duplicate name (e.g. a duplicate
# catalog entry) would share an out-dir/machine and trip the isolation guard
# ("machine … allocated twice"), aborting the whole batch. A duplicate is
# meaningless anyway — you can't isolate two runs of the same name — so run it
# once and warn.
if [ "${#BENCHES[@]}" -ge 1 ]; then
    _seen_benches=" "
    _deduped_benches=()
    for _b in "${BENCHES[@]}"; do
        case "$_seen_benches" in
            *" $_b "*) echo "⚠️  duplicate bench '$_b' — running once (can't isolate two runs of the same name)" >&2 ;;
            *) _deduped_benches+=("$_b"); _seen_benches="$_seen_benches$_b " ;;
        esac
    done
    BENCHES=("${_deduped_benches[@]}")
fi

# --provision-pool and exact stale-owner recovery take no bench args; everything
# else needs at least one bench.
[ -n "$PROVISION_POOL" ] || true
[ -n "$PROVISION_POOL" ] || [ "$RECOVER_STALE_ONLY" = "1" ] \
    || [ "${#BENCHES[@]}" -ge 1 ] \
    || { echo "usage: run-bench-fleet <bench> [<bench>...] [--sim-on a,b] [--ref X]  |  --provision-pool N" >&2; exit 2; }

# Validate the whole runnable batch before detaching, resolving Fly credentials,
# or touching provider state. Besides rejecting typos without provisioning paid
# machines, one catalog read gives launch a stable per-task mode snapshot instead
# of reparsing mutable catalog files after every machine has already been cloned.
_catalog_modes_for_batch() {
    CATALOG_PATH="$ROOT_DIR/agents/benchmarks/tasks.json" \
    CATALOG_MODULE_DIR="$CLOUDBENCH_SCRIPT_SNAPSHOT" \
    python3 - "$@" <<'PY'
import os
import sys
from pathlib import Path

sys.path.insert(0, os.environ["CATALOG_MODULE_DIR"])
from cloudbench_catalog import CatalogError, get_task_metadata

try:
    rows = get_task_metadata(Path(os.environ["CATALOG_PATH"]), sys.argv[1:])
except CatalogError as exc:
    print(f"catalog preflight failed: {exc}", file=sys.stderr)
    raise SystemExit(1)

for row in rows:
    world_model_mode = str(row.get("world_model_mode") or "").lower()
    print("simulate" if world_model_mode == "simulate" else "real")
PY
}

CATALOG_MODES=()
if [ "$RECOVER_STALE_ONLY" != "1" ] && [ -z "$PROVISION_POOL" ]; then
    if ! catalog_modes_output="$(_catalog_modes_for_batch "${BENCHES[@]}")"; then
        echo "❌ benchmark catalog preflight failed before Fly provisioning" >&2
        exit 1
    fi
    while IFS= read -r catalog_mode; do
        [ -n "$catalog_mode" ] || continue
        case "$catalog_mode" in
            real|simulate) CATALOG_MODES+=("$catalog_mode") ;;
            *) echo "❌ benchmark catalog returned invalid world-model mode: $catalog_mode" >&2; exit 1 ;;
        esac
    done <<< "$catalog_modes_output"
    if [ "${#CATALOG_MODES[@]}" -ne "${#BENCHES[@]}" ]; then
        echo "❌ benchmark catalog preflight returned ${#CATALOG_MODES[@]}/${#BENCHES[@]} task modes" >&2
        exit 1
    fi
fi

[ "$RECOVER_STALE_ONLY" = "1" ] \
    || { [ -z "$BENCH_REF" ] && BENCH_REF="$(git rev-parse HEAD 2>/dev/null || echo '')"; }
canonicalize_bench_ref() {
    local requested="$1" resolved
    # A fresh remote clone cannot fetch an abbreviated object ID because Git
    # servers advertise refs, not arbitrary short SHAs. Canonicalize every ref
    # the controller can resolve locally; preserve remote-only branch/tag names.
    if resolved="$(git rev-parse --verify "${requested}^{commit}" 2>/dev/null)"; then
        printf '%s' "$resolved"
    else
        printf '%s' "$requested"
    fi
}
if [ "$RECOVER_STALE_ONLY" != "1" ]; then
    BENCH_REF="$(canonicalize_bench_ref "$BENCH_REF")"
    REQUESTED_BENCH_REF="$BENCH_REF"
    if ! BENCH_REF="$(cloudbench_fetchable_ref "$ROOT_DIR" "$BENCH_REF" \
        "$([ "${CLOUDBENCH_SKIP_LOCAL_PATCH:-0}" = "1" ] && printf 0 || printf 1)")"; then
        exit 1
    fi
fi

# --detach: re-exec THIS invocation in its own session before acquiring any
# lock or machine, so the controller (and its cleanup traps) survive the
# launching terminal/agent session dying mid-run. The surviving process owns
# the controller lock, the clones, and the teardown.
if [ "$DETACH" = "1" ]; then
    DETACH_ARGS=()
    for a in "${ORIG_ARGS[@]}"; do
        case "$a" in
            --detach|--wait|--foreground) ;;
            *) DETACH_ARGS+=("$a") ;;
        esac
    done
    mkdir -p "$RUNS_ROOT"
    DETACH_LOG="$RUNS_ROOT/detached-$RUN_ID.log"
    DETACH_OWNER="$RUNS_ROOT/detached-$RUN_ID.owner"
    SCRIPT_SNAPSHOT_HANDOFF_OWNER_FILE="$DETACH_OWNER"
    detached_snapshot_mode="borrow"
    if [ "${CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_MODE:-borrow}" = "owner" ]; then
        detached_snapshot_mode="claim"
        SCRIPT_SNAPSHOT_ALLOW_TRANSFER=1
        SCRIPT_SNAPSHOT_HANDOFF_PENDING=1
    fi
    if [ "$WAIT_FOR_DETACHED" = "1" ]; then
        # The waiting supervisor can disappear without taking the paid fleet
        # with it. A session-owned wrapper records the controller's exact exit
        # atomically; while the supervisor is alive this preserves synchronous
        # Hub snapshot/final-upload semantics.
        DETACH_STATUS="$RUNS_ROOT/detached-$RUN_ID.status"
        SCRIPT_SNAPSHOT_HANDOFF_STATUS_FILE="$DETACH_STATUS"
        rm -f "$DETACH_STATUS" "$DETACH_OWNER" \
            "$DETACH_STATUS".tmp.* "$DETACH_OWNER".tmp.* 2>/dev/null || true
        if ! cloudbench_detach_reexec_tracked "$DETACH_OWNER" "$DETACH_LOG" \
            env CLOUDBENCH_FLEET_OWNER_TOKEN="$FLEET_OWNER_TOKEN" \
                CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_MODE="$detached_snapshot_mode" bash -c '
status_file="$1"
shift
status=1
write_status() {
    status_tmp="${status_file}.tmp.$$"
    printf "%s\n" "$status" > "$status_tmp" &&
        mv "$status_tmp" "$status_file"
}
trap write_status EXIT
trap "status=129; exit 129" HUP
trap "status=130; exit 130" INT
trap "status=143; exit 143" TERM
"$@"
status=$?
exit "$status"
' cloudbench-detached-wait "$DETACH_STATUS" \
            bash "${BASH_SOURCE[0]}" "${DETACH_ARGS[@]}" --foreground; then
            abort_script_snapshot_handoff || true
            echo "FATAL: could not launch the detached fleet controller" >&2
            exit 1
        fi
    else
        rm -f "$DETACH_OWNER" "$DETACH_OWNER".tmp.* 2>/dev/null || true
        if ! cloudbench_detach_reexec_tracked "$DETACH_OWNER" "$DETACH_LOG" \
            env CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_MODE="$detached_snapshot_mode" \
                bash "${BASH_SOURCE[0]}" "${DETACH_ARGS[@]}" --foreground; then
            abort_script_snapshot_handoff || true
            echo "FATAL: could not launch the detached fleet controller" >&2
            exit 1
        fi
    fi
    if [ "$detached_snapshot_mode" = "claim" ]; then
        if ! wait_for_script_snapshot_claim; then
            abort_script_snapshot_handoff || true
            exit 1
        fi
        CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_MODE="borrow"
        SCRIPT_SNAPSHOT_HANDOFF_PENDING=0
    fi
    echo "🛰️  fleet controller detached (own session; survives launcher exit)"
    echo "    log: tail -f $DETACH_LOG"
    if [ "$WAIT_FOR_DETACHED" = "1" ]; then
        echo "⏳ waiting for detached fleet completion..."
        if cloudbench_wait_tracked_detached "$DETACH_OWNER" "$DETACH_STATUS" \
            env CLOUDBENCH_SCRIPT_SNAPSHOT= \
                CLOUDBENCH_SCRIPT_SNAPSHOT_OWNER_MODE=borrow \
                bash "$ROOT_DIR/scripts/run-bench-fleet" \
                    --recover-stale-owner "$FLEET_OWNER_TOKEN"; then
            DETACH_EXIT=0
        else
            DETACH_EXIT=$?
        fi
        if [ "$detached_snapshot_mode" = "claim" ] \
            && ! reconcile_transferred_script_snapshot; then
            DETACH_EXIT=1
        fi
        echo "🛰️  detached fleet completed (exit=$DETACH_EXIT)"
        exit "$DETACH_EXIT"
    fi
    rm -f "$DETACH_OWNER" "$DETACH_OWNER".tmp.* 2>/dev/null || true
    exit 0
fi

# A synchronized child begins polling before the controller has finished
# provisioning the remaining machines. Give the remote barrier the full
# per-benchmark timeout, then add that barrier budget to the child's outer
# polling ceiling so benchmark execution still receives RUN_TIMEOUT seconds
# after every isolated stack is ready.
per_box_barrier_wait_seconds() {
    local first_run_stack_wait pre_stack_allowance
    if [ -n "${CLOUDBENCH_PER_BOX_BARRIER_WAIT_SECONDS:-}" ]; then
        printf '%s\n' "$CLOUDBENCH_PER_BOX_BARRIER_WAIT_SECONDS"
        return
    fi
    first_run_stack_wait="${CLOUDBENCH_FIRST_RUN_STACK_WAIT_SECONDS:-2160}"
    pre_stack_allowance="${CLOUDBENCH_PRE_STACK_WAIT_SECONDS:-600}"
    case "$first_run_stack_wait:$pre_stack_allowance" in
        *[!0-9:]*|:*|*:)
            echo "invalid cold bootstrap barrier budget" >&2
            return 2
            ;;
    esac
    printf '%s\n' "$((first_run_stack_wait + pre_stack_allowance))"
}

# Cold first-boot budget: a freshly-cloned guest has no cached seed dump and
# does a full production DB sync (~19 min for the ecommerce/browser slice) that
# only gets slower as N stacks contend on the sync concurrently. 2160s (= 1800s
# + 20% headroom) keeps a slow-but-healthy stack from being excluded at the
# start barrier. A cached dump still makes healthy startup fast, but cannot
# shorten this ceiling because run.sh may reject it or fall back after restore.
FIRST_RUN_STACK_WAIT_SECONDS="${CLOUDBENCH_FIRST_RUN_STACK_WAIT_SECONDS:-2160}"
PER_BOX_BARRIER_WAIT_SECONDS="$(per_box_barrier_wait_seconds)" || exit 2
START_BARRIER_WAIT_SECONDS="${CLOUDBENCH_START_BARRIER_WAIT_SECONDS:-$RUN_TIMEOUT}"
BOOT_UPDATE_CAPACITY_WAIT_SECONDS="${CLOUDBENCH_BOOT_UPDATE_CAPACITY_WAIT_SECONDS:-1200}"
BOOT_CONFIG_BARRIER_WAIT_SECONDS="${CLOUDBENCH_BOOT_CONFIG_BARRIER_WAIT_SECONDS:-1800}"
for seconds in "$RUN_TIMEOUT" "$FIRST_RUN_STACK_WAIT_SECONDS" "$PER_BOX_BARRIER_WAIT_SECONDS" "$START_BARRIER_WAIT_SECONDS" "$BOOT_UPDATE_CAPACITY_WAIT_SECONDS" "$BOOT_CONFIG_BARRIER_WAIT_SECONDS"; do
    case "$seconds" in
        ''|*[!0-9]*) echo "❌ benchmark and barrier timeouts must be positive integers" >&2; exit 2 ;;
    esac
    [ "$seconds" -gt 0 ] \
        || { echo "❌ benchmark and barrier timeouts must be positive integers" >&2; exit 2; }
done
if [ "$BOOT_CONFIG_BARRIER_WAIT_SECONDS" -le "$BOOT_UPDATE_CAPACITY_WAIT_SECONDS" ]; then
    echo "❌ boot config barrier must outlive the provider-capacity recovery budget" >&2
    exit 2
fi
# The global barrier cannot expire before a legitimate cold guest's per-box
# budget. This clamps an undersized default or override to the shared contract.
if [ "$START_BARRIER_WAIT_SECONDS" -lt "$PER_BOX_BARRIER_WAIT_SECONDS" ]; then
    START_BARRIER_WAIT_SECONDS="$PER_BOX_BARRIER_WAIT_SECONDS"
fi
case "$CONTROLLER_RETRY_SECONDS" in
    ''|*[!0-9]*|0) echo "❌ CLOUDBENCH_CONTROLLER_RETRY_SECONDS must be a positive integer" >&2; exit 2 ;;
esac
CHILD_RUN_TIMEOUT="$RUN_TIMEOUT"
if [ "$SYNCHRONIZED_START" = "1" ]; then
    CHILD_RUN_TIMEOUT=$((RUN_TIMEOUT + START_BARRIER_WAIT_SECONDS))
fi

# ── flyctl + token (mirror run-bench-cloud) ─────────────────────────────────
if ! command -v flyctl >/dev/null 2>&1; then
    if [ -x "$HOME/.fly/bin/flyctl" ]; then export PATH="$HOME/.fly/bin:$PATH"; else
        echo "❌ flyctl not found on PATH." >&2; exit 1; fi
fi
resolve_fly_token() {
    # Prefer a real bench token. Cloud/agent shells sometimes inject a stub
    # FLY_BENCH_API_TOKEN (len≪20) that shadows FLY_API_TOKEN and then fails
    # every machines list with token validation 401 — refuse stubs.
    if [ -n "${FLY_BENCH_API_TOKEN:-}" ] && [ "${#FLY_BENCH_API_TOKEN}" -ge 20 ]; then
        echo "$FLY_BENCH_API_TOKEN"
        return
    fi
    if [ -n "${FLY_BENCH_API_TOKEN:-}" ]; then
        echo "⚠️  ignoring stub FLY_BENCH_API_TOKEN (len=${#FLY_BENCH_API_TOKEN}); falling back" >&2
    fi
    local cfg="$HOME/.fly/config.yml"
    if [ -f "$cfg" ]; then
        local t; t="$(grep -E '^access_token:' "$cfg" 2>/dev/null | head -1 | sed 's/^access_token:[[:space:]]*//; s/^["'\'']//; s/["'\'']$//')"
        [ -n "$t" ] && { echo "$t"; return; }
    fi
    if [ -n "${FLY_API_TOKEN:-}" ]; then echo "$FLY_API_TOKEN"; return; fi
    grep -E '^FLY_API_TOKEN=' agents/.env 2>/dev/null | head -1 | cut -d= -f2- | sed 's/^["'\'']//; s/["'\'']$//'
}
FLY_API_TOKEN="$(resolve_fly_token)"
[ -n "${FLY_API_TOKEN:-}" ] || { echo "❌ No Fly auth token found." >&2; exit 1; }
export FLY_API_TOKEN
FLY() { flyctl "$@"; }

# ── ONE shared inventory stream for every read-only poller ──────────────────
# A single controller-owned loop reads Fly's Machines/Volumes APIs and publishes
# an atomic, keyed per-machine index. Hot consumers read one tiny record instead
# of issuing N provider calls or parsing an N-machine array in each of N children.
# Provider load stays O(1) and local index work stays O(N) at fleet width.
# Mutating paths that need post-write freshness (reap verification, pool claims)
# intentionally stay live and bounded.
MACHINES_SNAPSHOT="$FLEET_DIR/machines.json"
VOLUMES_SNAPSHOT="$FLEET_DIR/volumes.json"
INVENTORY_INDEX="$FLEET_DIR/inventory"
SNAPSHOT_POLL="${CLOUDBENCH_SNAPSHOT_POLL_SECONDS:-5}"
SNAPSHOT_REFRESH_TIMEOUT="${CLOUDBENCH_SNAPSHOT_REFRESH_TIMEOUT_SECONDS:-30}"
INVENTORY_REFRESH_LOCK="$FLEET_DIR/machines-refresh.lock"
INVENTORY_WAIT_FIFO="$FLEET_DIR/inventory-refresh.wait"
INVENTORY_MAX_STALE_SECONDS="${CLOUDBENCH_INVENTORY_MAX_STALE_SECONDS:-$((SNAPSHOT_REFRESH_TIMEOUT * 5 + 30))}"
INVENTORY_CLOCK_EPOCH="$(date +%s)"
INVENTORY_CLOCK_SECONDS="$SECONDS"

_refresh_inventory_snapshot_unlocked() {
    local suffix machines_tmp volumes_tmp
    suffix="${BASHPID:-$$}.$RANDOM"
    machines_tmp="$MACHINES_SNAPSHOT.tmp.$suffix"
    volumes_tmp="$VOLUMES_SNAPSHOT.tmp.$suffix"
    if ! fly_with_timeout "$SNAPSHOT_REFRESH_TIMEOUT" \
            machines list -a "$APP" --json > "$machines_tmp" \
        || [ ! -s "$machines_tmp" ]; then
        rm -f "$machines_tmp" "$volumes_tmp"
        return 1
    fi
    if ! fly_with_timeout "$SNAPSHOT_REFRESH_TIMEOUT" \
            volumes list -a "$APP" --json > "$volumes_tmp" \
        || [ ! -s "$volumes_tmp" ]; then
        rm -f "$machines_tmp" "$volumes_tmp"
        return 1
    fi
    if ! python3 "$MACHINE_READINESS_SCRIPT" --publish-index \
            "$machines_tmp" "$volumes_tmp" "$INVENTORY_INDEX"; then
        rm -f "$machines_tmp" "$volumes_tmp"
        return 1
    fi
    mv "$machines_tmp" "$MACHINES_SNAPSHOT"
    mv "$volumes_tmp" "$VOLUMES_SNAPSHOT"
}

inventory_refresh_wait_tick() {
    # A read timeout on a read/write FIFO is a Bash builtin wait: no child
    # process per clone-name waiter while another publisher owns the lock.
    [ -p "$INVENTORY_WAIT_FIFO" ] || return 1
    exec 19<> "$INVENTORY_WAIT_FIFO" || return 1
    IFS= read -r -t 1 -u 19 _inventory_wait_value || true
    exec 19>&-
}

inventory_refresh_lock_acquire() {  # inventory_refresh_lock_acquire [prior-generation]
    # Publish complete ownership metadata as an atomic hard link. A SIGKILL can
    # leave either no lock or a complete lock file, never the metadata-less
    # directory window that previously outlived the waiter budget.
    local lock="$INVENTORY_REFRESH_LOCK" prior="${1:-}" candidate=""
    local owner_pid="" owner_start="" token="" initialized=0 current
    local status lock_host lock_pid key value wait_seconds deadline
    wait_seconds="${CLOUDBENCH_SNAPSHOT_REFRESH_WAIT_SECONDS:-$((SNAPSHOT_REFRESH_TIMEOUT * 3 + 5))}"
    case "$wait_seconds" in
        ''|*[!0-9]*) return 1 ;;
    esac
    deadline=$((SECONDS + wait_seconds))
    while :; do
        if [ -n "$prior" ]; then
            current="$(machines_snapshot_identity)"
            if [ "$current" != "$prior" ]; then
                [ -n "$candidate" ] && rm -f "$candidate"
                return 2
            fi
        fi

        if [ ! -e "$lock" ]; then
            if [ "$initialized" = "0" ]; then
                owner_pid="${BASHPID:-$$}"
                owner_start="$(fleet_pid_start_time "$owner_pid")"
                [ -n "$owner_start" ] || return 1
                token="$owner_pid.$RANDOM.$RANDOM.$SECONDS"
                candidate="$lock.candidate.$owner_pid.$RANDOM"
                {
                    printf 'host=%s\n' "$FLEET_OWNER_HOST"
                    printf 'pid=%s\n' "$owner_pid"
                    printf 'pid_start=%s\n' "$owner_start"
                    printf 'token=%s\n' "$token"
                } > "$candidate" || { rm -f "$candidate"; return 1; }
                initialized=1
            fi
            if ln "$candidate" "$lock" 2>/dev/null; then
                rm -f "$candidate"
                INVENTORY_REFRESH_LOCK_TOKEN="$token"
                export CLOUDBENCH_INVENTORY_REFRESH_LOCK="$lock"
                export CLOUDBENCH_INVENTORY_REFRESH_LOCK_TOKEN="$token"
                return 0
            fi
        fi

        lock_host=""; lock_pid=""
        if [ -f "$lock" ]; then
            while IFS='=' read -r key value; do
                case "$key" in host) lock_host="$value" ;; pid) lock_pid="$value" ;; esac
            done < "$lock"
        fi
        if [ -n "$lock_host" ] && [ "$lock_host" != "$FLEET_OWNER_HOST" ]; then
            [ -n "$candidate" ] && rm -f "$candidate"
            echo "❌ inventory refresh lock belongs to another host" >&2
            return 1
        fi
        case "$lock_pid" in
            ''|*[!0-9]*) status=1 ;;
            *) kill -0 "$lock_pid" 2>/dev/null && status=0 || status=1 ;;
        esac
        if [ "$status" = "1" ]; then
            if python3 "$MACHINE_READINESS_SCRIPT" --recover-lock "$lock"; then
                continue
            else
                status=$?
                [ "$status" -eq 1 ] || {
                    [ -n "$candidate" ] && rm -f "$candidate"
                    echo "❌ unsafe inventory refresh lock recovery" >&2
                    return 1
                }
            fi
        fi
        if [ "$SECONDS" -ge "$deadline" ]; then
            [ -n "$candidate" ] && rm -f "$candidate"
            echo "❌ timed out waiting for the serialized inventory refresh" >&2
            return 1
        fi
        inventory_refresh_wait_tick || {
            [ -n "$candidate" ] && rm -f "$candidate"
            return 1
        }
    done
}

inventory_refresh_lock_release() {
    local lock="$INVENTORY_REFRESH_LOCK" owner_pid
    owner_pid="${BASHPID:-$$}"
    [ "$(registry_meta_value "$lock" host)" = "$FLEET_OWNER_HOST" ] \
        && [ "$(registry_meta_value "$lock" pid)" = "$owner_pid" ] \
        && fleet_pid_matches_start "$owner_pid" "$(registry_meta_value "$lock" pid_start)" \
        && [ "$(registry_meta_value "$lock" token)" = "${INVENTORY_REFRESH_LOCK_TOKEN:-}" ] \
        || return 1
    rm -f "$lock"
    unset INVENTORY_REFRESH_LOCK_TOKEN
    unset CLOUDBENCH_INVENTORY_REFRESH_LOCK CLOUDBENCH_INVENTORY_REFRESH_LOCK_TOKEN
}

refresh_inventory_snapshot() {
    local status=0
    inventory_refresh_lock_acquire || return 1
    _refresh_inventory_snapshot_unlocked || status=$?
    inventory_refresh_lock_release || return 1
    return "$status"
}

machines_snapshot_loop() {
    local backoff=0
    while :; do
        if refresh_inventory_snapshot; then
            backoff=0
        else
            # rate-limited/transient API failure: back off (bounded) and keep
            # serving the last good index rather than hammering the API.
            backoff=$(( backoff < 30 ? backoff + SNAPSHOT_POLL : 30 ))
        fi
        sleep $(( SNAPSHOT_POLL + backoff + (RANDOM % 3) ))
    done
}

start_machines_snapshot_loop() {
    [ -n "${SNAPSHOT_LOOP_PID:-}" ] && kill -0 "$SNAPSHOT_LOOP_PID" 2>/dev/null \
        && return 0
    SNAPSHOT_LOOP_TOKEN="${SNAPSHOT_LOOP_TOKEN:-$RANDOM.$RANDOM.$$.${SECONDS}}"
    export CLOUDBENCH_INVENTORY_PUBLISHER_TOKEN="$SNAPSHOT_LOOP_TOKEN"
    export CLOUDBENCH_INVENTORY_MAX_STALE_SECONDS="$INVENTORY_MAX_STALE_SECONDS"
    if [ -e "$INVENTORY_WAIT_FIFO" ] && [ ! -p "$INVENTORY_WAIT_FIFO" ]; then
        echo "❌ invalid inventory refresh wait path" >&2
        return 1
    fi
    [ -p "$INVENTORY_WAIT_FIFO" ] || mkfifo "$INVENTORY_WAIT_FIFO" || return 1
    if ! refresh_inventory_snapshot; then
        echo "❌ shared inventory snapshot did not initialize" >&2
        return 1
    fi
    machines_snapshot_loop & SNAPSHOT_LOOP_PID=$!
    SNAPSHOT_LOOP_PID_START="$(fleet_pid_start_time "$SNAPSHOT_LOOP_PID")"
    if [ -z "$SNAPSHOT_LOOP_PID_START" ]; then
        kill "$SNAPSHOT_LOOP_PID" 2>/dev/null || true
        SNAPSHOT_LOOP_PID=""
        return 1
    fi
}

inventory_index_healthy() {
    local pid="${SNAPSHOT_LOOP_PID:-}" expected_token="${SNAPSHOT_LOOP_TOKEN:-}"
    local key value publisher_token="" valid_until="" now
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    [ -n "$expected_token" ] && [ -s "$INVENTORY_INDEX/current/health" ] || return 1
    while IFS='=' read -r key value; do
        case "$key" in
            publisher_token) publisher_token="$value" ;;
            valid_until) valid_until="$value" ;;
        esac
    done < "$INVENTORY_INDEX/current/health"
    case "$valid_until" in ''|*[!0-9]*) return 1 ;; esac
    [ "$publisher_token" = "$expected_token" ] || return 1
    now=$((INVENTORY_CLOCK_EPOCH + SECONDS - INVENTORY_CLOCK_SECONDS))
    [ "$valid_until" -ge "$now" ]
}

_fresh_snapshot_or() {  # _fresh_snapshot_or <snapshot-file> <live-cmd...>
    # Once shared mode starts, every consumer either reads the last good snapshot
    # or fails closed. A stale/missing snapshot must never fan out into one live
    # provider request per child during the exact rate-limit condition we absorb.
    local f="$1"; shift
    if [ -n "${SNAPSHOT_LOOP_PID:-}" ]; then
        inventory_index_healthy || return 1
        [ -s "$f" ] || return 1
        cat "$f"
        return 0
    fi
    "$@" 2>/dev/null
}
fleet_machines_json() { _fresh_snapshot_or "$MACHINES_SNAPSHOT" FLY machines list -a "$APP" --json; }
fleet_volumes_json()  { _fresh_snapshot_or "$VOLUMES_SNAPSHOT" FLY volumes list -a "$APP" --json; }

machines_snapshot_identity() {
    local key value generation="missing"
    [ -s "$INVENTORY_INDEX/current/health" ] || { printf '%s' "$generation"; return; }
    while IFS='=' read -r key value; do
        [ "$key" = "generation" ] && generation="$value"
    done < "$INVENTORY_INDEX/current/health"
    printf '%s' "$generation"
}

refresh_machines_snapshot_after() {  # refresh_machines_snapshot_after <prior-identity>
    # Clone output very rarely omits the target id. All exceptional resolvers
    # coalesce behind one bounded refresh. The lock carries a process-start
    # identity so a SIGKILLed owner can never wedge every later refresh.
    local prior="$1" current status=0
    current="$(machines_snapshot_identity)"
    [ "$current" != "$prior" ] && return 0
    if inventory_refresh_lock_acquire "$prior"; then
        :
    else
        status=$?
        [ "$status" = "2" ] && return 0
        return 1
    fi
    current="$(machines_snapshot_identity)"
    if [ "$current" = "$prior" ]; then
        _refresh_inventory_snapshot_unlocked || status=$?
    fi
    inventory_refresh_lock_release || return 1
    return "$status"
}

inventory_machine_record_path() {  # inventory_machine_record_path <id>
    case "$1" in ''|*[!A-Za-z0-9._-]*) return 1 ;; esac
    printf '%s' "$INVENTORY_INDEX/current/machines/$1"
}

inventory_machine_field() {  # inventory_machine_field <id> <field>
    local path key value
    inventory_index_healthy || return 1
    path="$(inventory_machine_record_path "$1")" || return 1
    [ -s "$path" ] || return 1
    while IFS='=' read -r key value; do
        [ "$key" = "$2" ] && { printf '%s' "$value"; return 0; }
    done < "$path"
    return 1
}

inventory_machine_exists() {
    local path
    inventory_index_healthy || return 1
    path="$(inventory_machine_record_path "$1")" || return 1
    [ -s "$path" ]
}

inventory_machine_id_for_name() {
    case "$1" in ''|*[!A-Za-z0-9._-]*) return 1 ;; esac
    inventory_index_healthy || return 1
    [ -s "$INVENTORY_INDEX/current/names/$1" ] || return 1
    IFS= read -r REPLY < "$INVENTORY_INDEX/current/names/$1"
    printf '%s' "$REPLY"
}

# A clone ID is allocated before its snapshot-backed volume becomes mountable.
# Keep every clone start behind the same storage lifecycle contract as the
# per-benchmark child runner.
machine_storage_ready() {  # machine_storage_ready <id>
    [ "$(inventory_machine_field "$1" storage_ready 2>/dev/null || true)" = "1" ]
}

machine_storage_failed() {  # machine_storage_failed <id>
    [ "$(inventory_machine_field "$1" storage_failed 2>/dev/null || true)" = "1" ]
}

snapshot_machine_state() {  # snapshot_machine_state <id>; 0=state, 1=absent, 2=unsafe
    inventory_machine_field "$1" state
}

is_sim_on() { case ",$SIM_ON_CSV," in *",$1,"*) return 0 ;; esac; return 1; }

# Print EXACTLY what code the run will execute on the box: the ref (HEAD), whether
# it is on origin (unpushed commits never reach the box), and the uncommitted diff
# that is shipped as a patch. Also stashed to $UNIFIED_DIR for the dashboard header.
print_code_provenance() {
    local branch head_sha head_sub pushed dirtystat untracked_count
    branch="$(git -C "$ROOT_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
    head_sha="$(git -C "$ROOT_DIR" rev-parse --short HEAD 2>/dev/null || echo '?')"
    head_sub="$(git -C "$ROOT_DIR" log -1 --pretty=%s 2>/dev/null || echo '')"
    if git -C "$ROOT_DIR" branch -r --contains HEAD 2>/dev/null | grep -q origin/; then
        pushed="on origin ✓"
    elif [ "$REQUESTED_BENCH_REF" != "$BENCH_REF" ]; then
        pushed="not on origin; complete workspace is packaged on fetchable base $BENCH_REF"
    else
        pushed="⚠ NOT on origin — unpushed commits will NOT run on the box (only uncommitted changes ship)"
    fi
    echo "════════════════════ CODE UNDER TEST ════════════════════"
    echo "  branch : $branch"
    echo "  ref    : $BENCH_REF  ($head_sha $head_sub)"
    if [ "$REQUESTED_BENCH_REF" != "$BENCH_REF" ]; then
        echo "  local  : $REQUESTED_BENCH_REF (complete delta ships on fetchable base)"
    fi
    echo "  pushed : $pushed"
    untracked_count=0
    while IFS= read -r relative_path; do
        case "$relative_path" in
            agents/benchmarks/history/*.jsonl) continue ;;
        esac
        untracked_count=$((untracked_count + 1))
    done < <(git -C "$ROOT_DIR" ls-files --others --exclude-standard)
    if [ "${CLOUDBENCH_SKIP_LOCAL_PATCH:-0}" = "1" ]; then
        echo "  diff   : local changes intentionally excluded (running committed $head_sha exactly)"
        CODE_SUMMARY="$branch@$head_sha (pinned; local patch excluded)"
    elif [ "$REQUESTED_BENCH_REF" = "$BENCH_REF" ] \
         && ! cloudbench_worktree_has_changes "$ROOT_DIR"; then
        echo "  diff   : clean working tree (running committed $head_sha exactly)"
        CODE_SUMMARY="$branch@$head_sha (clean)"
    else
        dirtystat="$(git -C "$ROOT_DIR" diff --shortstat "$BENCH_REF" -- . ":(exclude)agents/benchmarks/history/*.jsonl" 2>/dev/null | sed 's/^ *//')"
        echo "  diff   : DIRTY — shipped as a patch on top of $BENCH_REF: $dirtystat, $untracked_count untracked"
        git -C "$ROOT_DIR" diff --stat "$BENCH_REF" -- . ":(exclude)agents/benchmarks/history/*.jsonl" 2>/dev/null | sed 's/^/           /' | tail -30
        while IFS= read -r relative_path; do
            case "$relative_path" in
                agents/benchmarks/history/*.jsonl) continue ;;
            esac
            printf '           + %s\n' "$relative_path"
        done < <(git -C "$ROOT_DIR" ls-files --others --exclude-standard) | tail -30
        CODE_SUMMARY="$branch@$head_sha +patch($dirtystat, $untracked_count untracked)"
    fi
    echo "══════════════════════════════════════════════════════════"
}

# Destroy a machine RELIABLY. A clone still in Fly's 'created'/provisioning state
# no-ops a `--force` destroy (and then auto-starts later → a money-burning
# zombie), so retry across the transition; last resort, stop then destroy.
machine_volume_id_from_json() {  # machine_volume_id_from_json <machine_id>; JSON on stdin
    MID="$1" python3 -c '
import json, os, sys
try:
    machines = json.load(sys.stdin)
except (TypeError, ValueError, json.JSONDecodeError):
    raise SystemExit(2)
if not isinstance(machines, list):
    raise SystemExit(2)
matches = [m for m in machines if isinstance(m, dict) and m.get("id") == os.environ["MID"]]
if len(matches) != 1:
    raise SystemExit(1 if not matches else 2)
mounts = (matches[0].get("config") or {}).get("mounts") or []
volume_ids = [m.get("volume") for m in mounts if isinstance(m, dict) and m.get("volume")]
if len(volume_ids) != 1 or not isinstance(volume_ids[0], str):
    raise SystemExit(2)
print(volume_ids[0])
'
}

machine_volume_id() {  # machine_volume_id <machine_id> → its mounted volume id (or empty)
    FLY machines list -a "$APP" --json 2>/dev/null \
        | machine_volume_id_from_json "$1" 2>/dev/null || true
}

volume_inventory_contains_id() {  # <volume-id>; 0=present, 1=authoritatively absent, 2=unknown
    local vol="$1" inventory
    inventory="$(FLY volumes list -a "$APP" --json 2>/dev/null)" || return 2
    python3 -c '
import json
import sys

try:
    volumes = json.load(sys.stdin)
except (TypeError, ValueError, json.JSONDecodeError):
    raise SystemExit(2)
if not isinstance(volumes, list):
    raise SystemExit(2)
for volume in volumes:
    if not isinstance(volume, dict) or not isinstance(volume.get("id"), str) or not volume["id"]:
        raise SystemExit(2)
raise SystemExit(0 if any(volume["id"] == sys.argv[1] for volume in volumes) else 1)
' "$vol" <<< "$inventory"
}

reap_volume() {  # reap_volume <volume_id> — destroy a clone's forked volume
    local vol="$1" i inventory_rc absent_streak=0
    [ -n "$vol" ] || return 0
    if [ -n "${WARM_VOLUME_ID:-}" ] && [ "$vol" = "$WARM_VOLUME_ID" ]; then
        echo "  ❌ refusing to destroy warm source volume $vol" >&2
        return 1
    fi
    # The mutation command's exit status proves only whether Fly accepted the
    # request, and a SINGLE absent listing is not proof either: Fly transiently
    # omits a volume that is mid-destroy and restores it to `created` when the
    # destroy does not complete. On 2026-09-08 that made an aborted lane record
    # vol_r1j2q9mx2y5dod3r as destroyed-verified-absent while it kept billing.
    # Require two CONSECUTIVE authoritative absences separated by a settle
    # delay, and re-issue the destroy whenever the exact ID is seen again.
    for i in 1 2 3 4 5 6; do
        if [ "$absent_streak" -eq 0 ]; then
            FLY volumes destroy "$vol" -a "$APP" --yes >/dev/null 2>&1 || true
        fi
        if volume_inventory_contains_id "$vol"; then
            inventory_rc=0
        else
            inventory_rc=$?
        fi
        if [ "$inventory_rc" -eq 1 ]; then
            absent_streak=$((absent_streak + 1))
            [ "$absent_streak" -ge 2 ] && return 0
        else
            absent_streak=0
        fi
        sleep 3
    done
    echo "  ⚠️ could not destroy volume $vol — exact-owner recovery retained: flyctl volumes destroy $vol -a $APP" >&2
    return 1
}

reap_machine() {  # reap_machine <id> [diagnostic-log] [exact-volume-id]
    local id="$1" diagnostic_log="${2:-}" vol="${3:-}" i machines="" command_rc=0
    [ -n "$id" ] || return 0
    if [ -n "${WARM_ID:-}" ] && [ "$id" = "$WARM_ID" ]; then
        echo "  ❌ refusing to destroy warm source machine $id" >&2
        return 1
    fi
    # `machine destroy` never destroys the clone's forked volume — it leaks and
    # bills forever (a single day once leaked 42 × 20GB). Resolve the volume
    # BEFORE the machine disappears; destroy it after the machine is confirmed
    # gone.
    [ -n "$vol" ] || vol="$(machine_volume_id "$id")"
    if [ -n "$diagnostic_log" ]; then
        printf '[%s] cleanup started for worker %s (volume=%s)\n' \
            "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || printf unknown)" \
            "$id" "${vol:-unknown}" >> "$diagnostic_log" 2>/dev/null || true
    fi
    for i in 1 2 3 4 5; do
        if [ -n "$diagnostic_log" ]; then
            printf '[%s] destroy attempt %s/5\n' \
                "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || printf unknown)" "$i" \
                >> "$diagnostic_log" 2>/dev/null || true
            if FLY machine destroy --force "$id" -a "$APP" \
                >/dev/null 2>> "$diagnostic_log"; then
                command_rc=0
            else
                command_rc=$?
            fi
            printf '[%s] destroy %s rc=%s\n' \
                "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || printf unknown)" \
                "$([ "$command_rc" = 0 ] && printf succeeded || printf failed)" "$command_rc" \
                >> "$diagnostic_log" 2>/dev/null || true
        else
            FLY machine destroy --force "$id" -a "$APP" >/dev/null 2>&1 || true
        fi

        command_rc=0
        if [ -n "$diagnostic_log" ]; then
            if machines="$(FLY machines list -a "$APP" --json 2>> "$diagnostic_log")"; then
                command_rc=0
            else
                command_rc=$?
            fi
        elif machines="$(FLY machines list -a "$APP" --json 2>/dev/null)"; then
            command_rc=0
        else
            command_rc=$?
        fi
        if [ "$command_rc" != "0" ]; then
            if [ -n "$diagnostic_log" ]; then
                printf '[%s] machine list failed rc=%s; presence remains unknown\n' \
                    "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || printf unknown)" \
                    "$command_rc" >> "$diagnostic_log" 2>/dev/null || true
            fi
            sleep 3
            continue
        fi
        if ! printf '%s' "$machines" | grep -q "\"$id\""; then
            if [ -n "$diagnostic_log" ]; then
                printf '[%s] worker absent after destroy attempt %s/5\n' \
                    "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || printf unknown)" "$i" \
                    >> "$diagnostic_log" 2>/dev/null || true
            fi
            reap_volume "$vol"
            return $?
        fi
        if [ -n "$diagnostic_log" ]; then
            printf '[%s] worker still present after destroy attempt %s/5\n' \
                "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || printf unknown)" "$i" \
                >> "$diagnostic_log" 2>/dev/null || true
        fi
        if [ "$i" = 3 ]; then
            if [ -n "$diagnostic_log" ]; then
                if FLY machine stop "$id" -a "$APP" >/dev/null 2>> "$diagnostic_log"; then
                    command_rc=0
                else
                    command_rc=$?
                fi
                printf '[%s] stop fallback %s rc=%s\n' \
                    "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || printf unknown)" \
                    "$([ "$command_rc" = 0 ] && printf succeeded || printf failed)" "$command_rc" \
                    >> "$diagnostic_log" 2>/dev/null || true
            else
                FLY machine stop "$id" -a "$APP" >/dev/null 2>&1 || true
            fi
        fi
        sleep 3
    done

    command_rc=0
    if [ -n "$diagnostic_log" ]; then
        if machines="$(FLY machines list -a "$APP" --json 2>> "$diagnostic_log")"; then
            command_rc=0
        else
            command_rc=$?
        fi
    elif machines="$(FLY machines list -a "$APP" --json 2>/dev/null)"; then
        command_rc=0
    else
        command_rc=$?
    fi
    if [ "$command_rc" != "0" ]; then
        if [ -n "$diagnostic_log" ]; then
            printf '[%s] final machine list failed rc=%s; refusing to forget worker\n' \
                "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || printf unknown)" \
                "$command_rc" >> "$diagnostic_log" 2>/dev/null || true
        fi
        return 1
    fi
    if printf '%s' "$machines" | grep -q "\"$id\""; then
        if [ -n "$diagnostic_log" ]; then
            printf '[%s] worker remained present after all destroy attempts\n' \
                "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || printf unknown)" \
                >> "$diagnostic_log" 2>/dev/null || true
        fi
        echo "  ⚠️ could not destroy machine $id — check: flyctl machines list -a $APP" >&2
        return 1
    fi
    reap_volume "$vol"
}

registry_meta_value() {  # registry_meta_value <meta-file> <key>
    local meta="$1" key="$2"
    sed -n "s/^${key}=//p" "$meta" 2>/dev/null | head -1
}

fleet_registry_init() {
    local staging="$FLEET_OWNERSHIP_ROOT/.$FLEET_OWNER_TOKEN.tmp.$$"
    local tmp_meta="$staging/meta.tmp.$$" meta="$staging/meta"
    case "$FLEET_OWNER_TOKEN" in ''|*[!0-9a-f]*) return 1 ;; esac
    [ "${#FLEET_OWNER_TOKEN}" -eq 32 ] || return 1
    case "$FLEET_OWNER_HOST" in ''|*=*|*$'\n'*) return 1 ;; esac
    case "$FLEET_OWNER_PID_START" in ''|*=*|*$'\n'*) return 1 ;; esac
    case "$$" in ''|*[!0-9]*) return 1 ;; esac
    [ -n "$RUN_ID" ] && [ -n "$APP" ] || return 1
    case "$FLEET_TEARDOWN_OWNERSHIP_DIR:$OWNED_CLONES_FILE:$OWNED_CLONE_NAMES_FILE" in
        *$'\n'*) return 1 ;;
    esac
    mkdir -p "$FLEET_OWNERSHIP_ROOT" || return 1
    rm -rf "$staging"
    mkdir -p "$staging/clones" || return 1
    {
        printf 'version=2\n'
        printf 'app=%s\n' "$APP"
        printf 'fleet_owner_token=%s\n' "$FLEET_OWNER_TOKEN"
        printf 'host=%s\n' "$FLEET_OWNER_HOST"
        printf 'pid=%s\n' "$$"
        printf 'pid_start=%s\n' "$FLEET_OWNER_PID_START"
        printf 'run_id=%s\n' "$RUN_ID"
        printf 'workspace_root=%s\n' "$ROOT_DIR"
        printf 'runs_root=%s\n' "$RUNS_ROOT"
        printf 'audit_dir=%s\n' "$FLEET_TEARDOWN_OWNERSHIP_DIR"
        printf 'owned_ids_file=%s\n' "$OWNED_CLONES_FILE"
        printf 'owned_names_file=%s\n' "$OWNED_CLONE_NAMES_FILE"
        # Every newly published owner starts fail-closed. A SIGKILL at any
        # later allocation/guest-start boundary must leave a successor without
        # authority to stop or destroy the exact machine.
        printf 'cleanup_policy=retain\n'
    } > "$tmp_meta" || { rm -rf "$staging"; return 1; }
    mv "$tmp_meta" "$meta" || { rm -rf "$staging"; return 1; }
    : > "$staging/guest-cleanup-unconfirmed" \
        || { rm -rf "$staging"; return 1; }
    [ "$(registry_meta_value "$meta" version)" = "2" ] \
        && [ "$(registry_meta_value "$meta" app)" = "$APP" ] \
        && [ "$(registry_meta_value "$meta" fleet_owner_token)" = "$FLEET_OWNER_TOKEN" ] \
        && [ "$(registry_meta_value "$meta" host)" = "$FLEET_OWNER_HOST" ] \
        && [ "$(registry_meta_value "$meta" pid)" = "$$" ] \
        && [ "$(registry_meta_value "$meta" pid_start)" = "$FLEET_OWNER_PID_START" ] \
        && [ "$(registry_meta_value "$meta" run_id)" = "$RUN_ID" ] \
        && [ "$(registry_meta_value "$meta" runs_root)" = "$RUNS_ROOT" ] \
        && [ "$(registry_meta_value "$meta" audit_dir)" = "$FLEET_TEARDOWN_OWNERSHIP_DIR" ] \
        || { rm -rf "$staging"; return 1; }
    # Hidden staging directories are ignored by recovery scans. Publish the
    # complete registry in one rename so concurrent controllers never observe
    # a clones directory without its owner metadata.
    if [ -e "$FLEET_REGISTRY_DIR" ] || ! mv "$staging" "$FLEET_REGISTRY_DIR"; then
        rm -rf "$staging"
        return 1
    fi
    if [ -d "$FLEET_REGISTRY_DIR/clones" ] \
        && [ "$(registry_meta_value "$FLEET_REGISTRY_DIR/meta" pid_start)" = "$FLEET_OWNER_PID_START" ]; then
        FLEET_REGISTRY_PUBLISHED=1
        return 0
    fi
    return 1
}

fleet_registry_retain_unconfirmed_guest() {
    local meta="$FLEET_REGISTRY_DIR/meta" temporary="$FLEET_REGISTRY_DIR/meta.tmp.$$"
    [ "$FLEET_REGISTRY_PUBLISHED" = "1" ] || return 0
    [ -f "$meta" ] || return 1
    # Write the sentinel before changing policy. Even a forced/stale reaper must
    # refuse this exact ledger until an operator has recovered guest cleanup.
    : > "$FLEET_REGISTRY_DIR/guest-cleanup-unconfirmed" || return 1
    awk '
        BEGIN { replaced = 0 }
        /^cleanup_policy=/ { print "cleanup_policy=retain"; replaced = 1; next }
        { print }
        END { if (!replaced) exit 1 }
    ' "$meta" > "$temporary" || { rm -f "$temporary"; return 1; }
    mv "$temporary" "$meta" || return 1
    [ "$(registry_meta_value "$meta" cleanup_policy)" = "retain" ]
}

fleet_registry_confirm_guest_teardown() {
    local meta="$FLEET_REGISTRY_DIR/meta" temporary="$FLEET_REGISTRY_DIR/meta.tmp.$$"
    local expected_policy=retain
    [ "$FLEET_REGISTRY_PUBLISHED" = "1" ] || return 0
    [ -f "$meta" ] && [ -e "$FLEET_REGISTRY_DIR/guest-cleanup-unconfirmed" ] || return 1
    if [ "$KEEP_CLONES" != "1" ]; then
        expected_policy=reap
        # Change the policy first. If the controller dies before sentinel
        # removal, every stale/current reap path still refuses this owner.
        awk '
            BEGIN { replaced = 0 }
            /^cleanup_policy=/ { print "cleanup_policy=reap"; replaced = 1; next }
            { print }
            END { if (!replaced) exit 1 }
        ' "$meta" > "$temporary" || { rm -f "$temporary"; return 1; }
        mv "$temporary" "$meta" || return 1
    fi
    [ "$(registry_meta_value "$meta" cleanup_policy)" = "$expected_policy" ] || return 1
    # Removal is the sole transition out of quarantine and occurs only after
    # every token-bound guest acknowledgement has already been observed.
    rm -f "$FLEET_REGISTRY_DIR/guest-cleanup-unconfirmed" || return 1
    [ ! -e "$FLEET_REGISTRY_DIR/guest-cleanup-unconfirmed" ]
}

fleet_registry_record_name() {  # fleet_registry_record_name <clone-name>
    local clone_name="$1" source_id="${2:-}" record="$FLEET_REGISTRY_DIR/clones/$1" tmp="$FLEET_REGISTRY_DIR/clones/$1.tmp.$$"
    case "$clone_name" in cloudbench-[a-zA-Z0-9._-]*) ;; *) return 1 ;; esac
    case "$source_id" in ''|*[!0-9a-f]*) return 1 ;; esac
    [ -d "$FLEET_REGISTRY_DIR/clones" ] || return 1
    fleet_audit_record_fresh_clone "$clone_name" "$source_id" "" "" ownership-pending \
        || return 1
    if printf 'name=%s\n' "$clone_name" > "$tmp" \
        && mv "$tmp" "$record" \
        && [ "$(registry_meta_value "$record" name)" = "$clone_name" ]; then
        return 0
    fi
    rm -f "$tmp"
    fleet_audit_update_fresh_clone "$clone_name" "" "" not-allocated-verified || true
    return 1
}

fleet_audit_record_fresh_clone() {  # <clone-name> <source-id-or-empty> <machine-id-or-empty> <volume-id-or-empty> <disposition>
    local clone_name="$1" source_id="$2" id="$3" volume_id="$4" disposition="$5"
    local record="$FLEET_TEARDOWN_OWNERSHIP_DIR/fresh/$1" tmp="$FLEET_TEARDOWN_OWNERSHIP_DIR/fresh/$1.tmp.${BASHPID:-$$}"
    local prior_source="" prior_id="" prior_volume_id="" prior_disposition="" record_existed=0
    local expected expected_tmp id_index id_index_tmp
    case "$clone_name" in cloudbench-[a-zA-Z0-9._-]*) ;; *) return 1 ;; esac
    case "$source_id" in ''|*[!0-9a-f]*) return 1 ;; esac
    case "$id" in *[!0-9a-f]*) return 1 ;; esac
    case "$volume_id" in *[!a-zA-Z0-9_-]*) return 1 ;; esac
    case "$disposition" in
        ownership-pending|owned|transfer-pending-stopped|destroyed-verified-absent|not-allocated-verified|transferred-to-pool-stopped) ;;
        *) return 1 ;;
    esac
    [ -d "${record%/*}" ] && [ ! -L "${record%/*}" ] \
        && [ -d "$FLEET_TEARDOWN_OWNERSHIP_DIR/expected-fresh" ] \
        && [ ! -L "$FLEET_TEARDOWN_OWNERSHIP_DIR/expected-fresh" ] \
        && [ -d "$FLEET_TEARDOWN_OWNERSHIP_DIR/by-machine-id" ] \
        && [ ! -L "$FLEET_TEARDOWN_OWNERSHIP_DIR/by-machine-id" ] || return 1
    expected="$FLEET_TEARDOWN_OWNERSHIP_DIR/expected-fresh/$clone_name"
    expected_tmp="$expected.tmp.${BASHPID:-$$}"
    if [ -f "$expected" ]; then
        [ "$(registry_meta_value "$expected" source_machine_id)" = "$source_id" ] \
            || { [ -z "$source_id" ] && source_id="$(registry_meta_value "$expected" source_machine_id)"; }
        [ "$(registry_meta_value "$expected" source_machine_id)" = "$source_id" ] || return 1
    else
        [ -n "$source_id" ] && [ "$disposition" = "ownership-pending" ] || return 1
        {
            printf 'clone_name=%s\n' "$clone_name"
            printf 'source_machine_id=%s\n' "$source_id"
        } > "$expected_tmp" && mv "$expected_tmp" "$expected" \
            || { rm -f "$expected_tmp"; return 1; }
    fi
    if [ -f "$record" ]; then
        record_existed=1
        prior_source="$(registry_meta_value "$record" source_machine_id)"
        prior_id="$(registry_meta_value "$record" machine_id)"
        prior_volume_id="$(registry_meta_value "$record" volume_id)"
        prior_disposition="$(registry_meta_value "$record" disposition)"
        [ -z "$source_id" ] && source_id="$prior_source"
        [ -z "$prior_source" ] || [ "$source_id" = "$prior_source" ] || return 1
        [ -z "$prior_id" ] || [ -z "$id" ] || [ "$id" = "$prior_id" ] || return 1
        [ -z "$prior_volume_id" ] || [ -z "$volume_id" ] \
            || [ "$volume_id" = "$prior_volume_id" ] || return 1
        [ -n "$id" ] || id="$prior_id"
        [ -n "$volume_id" ] || volume_id="$prior_volume_id"
    fi
    [ -n "$source_id" ] || return 1
    case "$disposition:$id:$volume_id" in
        ownership-pending::|not-allocated-verified::) ;;
        owned:*:*|destroyed-verified-absent:*:*) [ -n "$volume_id" ] || return 1 ;;
        transfer-pending-stopped:*:*|transferred-to-pool-stopped:*:*)
            [ -n "$id" ] && [ -n "$volume_id" ] || return 1 ;;
        *) return 1 ;;
    esac
    if [ "$record_existed" = "1" ]; then
        case "$prior_disposition:$disposition" in
            ownership-pending:owned|ownership-pending:not-allocated-verified|ownership-pending:destroyed-verified-absent|owned:owned|owned:destroyed-verified-absent|owned:transfer-pending-stopped|transfer-pending-stopped:transferred-to-pool-stopped|transfer-pending-stopped:destroyed-verified-absent|destroyed-verified-absent:destroyed-verified-absent|not-allocated-verified:not-allocated-verified|transferred-to-pool-stopped:transferred-to-pool-stopped|transferred-to-pool-stopped:destroyed-verified-absent) ;;
            *) return 1 ;;
        esac
    else
        [ "$disposition" = "ownership-pending" ] || return 1
    fi
    if [ -n "$id" ]; then
        id_index="$FLEET_TEARDOWN_OWNERSHIP_DIR/by-machine-id/$id"
        id_index_tmp="$id_index.tmp.${BASHPID:-$$}"
        if [ -e "$id_index" ]; then
            [ "$(cat "$id_index" 2>/dev/null)" = "$clone_name" ] || return 1
        else
            printf '%s\n' "$clone_name" > "$id_index_tmp" \
                && mv "$id_index_tmp" "$id_index" \
                || { rm -f "$id_index_tmp"; return 1; }
        fi
    fi
    {
        printf 'version=1\n'
        printf 'fleet_owner_token=%s\n' "$FLEET_OWNER_TOKEN"
        printf 'run_id=%s\n' "$RUN_ID"
        printf 'app=%s\n' "$APP"
        printf 'clone_name=%s\n' "$clone_name"
        printf 'source=fresh-clone\n'
        printf 'source_machine_id=%s\n' "$source_id"
        printf 'machine_id=%s\n' "$id"
        printf 'volume_id=%s\n' "$volume_id"
        printf 'disposition=%s\n' "$disposition"
    } > "$tmp" && mv "$tmp" "$record" || { rm -f "$tmp"; return 1; }
    [ "$(registry_meta_value "$record" fleet_owner_token)" = "$FLEET_OWNER_TOKEN" ] \
        && [ "$(registry_meta_value "$record" run_id)" = "$RUN_ID" ] \
        && [ "$(registry_meta_value "$record" clone_name)" = "$clone_name" ] \
        && [ "$(registry_meta_value "$record" source_machine_id)" = "$source_id" ] \
        && [ "$(registry_meta_value "$record" disposition)" = "$disposition" ] \
        || return 1
}

fleet_audit_update_fresh_clone() {  # <clone-name> <machine-id-or-empty> <volume-id-or-empty> <disposition>
    local clone_name="$1" id="$2" volume_id="$3" disposition="$4"
    local record="$FLEET_TEARDOWN_OWNERSHIP_DIR/fresh/$1" source_id
    [ -f "$record" ] || return 1
    source_id="$(registry_meta_value "$record" source_machine_id)"
    fleet_audit_record_fresh_clone "$clone_name" "$source_id" "$id" "$volume_id" "$disposition"
}

fleet_audit_update_registry_clone() {  # <registry> <clone-name> <id-or-empty> <volume-or-empty> <disposition>
    local registry="$1" clone_name="$2" id="$3" volume_id="$4" disposition="$5"
    local meta version audit_dir owner run_id app record source_id recorded_id recorded_volume tmp
    local original_runs_root workspace_root owned_ids_file owned_names_file
    meta="$registry/meta"
    version="$(registry_meta_value "$meta" version)"
    # Registries created before durable audit v2 remain recoverable, but only
    # v2 claims an original-run manifest that must be updated fail-closed.
    [ "$version" = "2" ] || return 0
    [ ! -L "$registry" ] && [ ! -L "$meta" ] || return 1
    audit_dir="$(registry_meta_value "$meta" audit_dir)"
    owner="${registry##*/}"
    run_id="$(registry_meta_value "$meta" run_id)"
    app="$(registry_meta_value "$meta" app)"
    workspace_root="$(registry_meta_value "$meta" workspace_root)"
    original_runs_root="$(registry_meta_value "$meta" runs_root)"
    owned_ids_file="$(registry_meta_value "$meta" owned_ids_file)"
    owned_names_file="$(registry_meta_value "$meta" owned_names_file)"
    [ "$(registry_meta_value "$meta" fleet_owner_token)" = "$owner" ] || return 1
    case "$clone_name" in cloudbench-[a-zA-Z0-9._-]*) ;; *) return 1 ;; esac
    python3 - "$registry" "$meta" "$workspace_root" "$original_runs_root" \
        "$run_id" "$audit_dir" "$owned_ids_file" "$owned_names_file" \
        "$clone_name" "$FLEET_AUDIT_ROOT" "$owner" "$id" "$volume_id" \
        "$disposition" "$app" <<'PY' || return 1
import os
import re
import sys
from pathlib import Path

(registry, meta, workspace, runs_root, run_id, audit, owned_ids,
 owned_names, clone_name, trusted_audit_root, owner) = map(Path, sys.argv[1:12])
machine_id, volume_id, disposition, app = sys.argv[12:16]
expected_audit = trusted_audit_root / owner.name
if (
    not workspace.is_absolute() or not runs_root.is_absolute() or not audit.is_absolute()
    or audit != expected_audit
    or owned_ids != expected_audit / "owned-clones.ids"
    or owned_names != expected_audit / "owned-clones.names"
    or meta != registry / "meta"
):
    raise SystemExit(1)
if (
    os.path.normpath(str(workspace)) != str(workspace)
    or os.path.normpath(str(runs_root)) != str(runs_root)
):
    raise SystemExit(1)
if (
    str(clone_name) != clone_name.name
    or not re.fullmatch(r"cloudbench-[A-Za-z0-9._-]+", clone_name.name)
    or str(run_id) != run_id.name
    or not re.fullmatch(r"[A-Za-z0-9._-]+", run_id.name)
    or str(owner) != owner.name
    or not re.fullmatch(r"[0-9a-f]{32}", owner.name)
):
    raise SystemExit(1)
if machine_id and not re.fullmatch(r"[0-9a-f]+", machine_id):
    raise SystemExit(1)
if volume_id and not re.fullmatch(r"[A-Za-z0-9_-]+", volume_id):
    raise SystemExit(1)
if disposition not in {"owned", "destroyed-verified-absent", "not-allocated-verified"}:
    raise SystemExit(1)
if disposition == "owned" and (not machine_id or not volume_id):
    raise SystemExit(1)
record_path = audit / "fresh" / clone_name.name
fields = {}
for raw in meta.read_text().splitlines():
    key, separator, value = raw.partition("=")
    if not separator or key in fields:
        raise SystemExit(1)
    fields[key] = value
if set(fields) != {
    "version", "app", "fleet_owner_token", "host", "pid", "pid_start",
    "run_id", "workspace_root", "runs_root", "audit_dir", "owned_ids_file",
    "owned_names_file", "cleanup_policy",
}:
    raise SystemExit(1)
for path in (trusted_audit_root, audit, audit / "meta",
             audit / "fresh", audit / "expected-fresh", audit / "by-machine-id"):
    try:
        if path.is_symlink():
            raise SystemExit(1)
    except OSError:
        raise SystemExit(1)
if (
    trusted_audit_root.resolve() != trusted_audit_root
    or audit.resolve() != audit
):
    raise SystemExit(1)

nofollow = getattr(os, "O_NOFOLLOW", 0)
directory = getattr(os, "O_DIRECTORY", 0)
root_fd = os.open(trusted_audit_root, os.O_RDONLY | directory | nofollow)
try:
    audit_fd = os.open(owner.name, os.O_RDONLY | directory | nofollow, dir_fd=root_fd)
    try:
        fresh_fd = os.open("fresh", os.O_RDONLY | directory | nofollow, dir_fd=audit_fd)
        expected_fd = os.open("expected-fresh", os.O_RDONLY | directory | nofollow, dir_fd=audit_fd)
        index_fd = os.open("by-machine-id", os.O_RDONLY | directory | nofollow, dir_fd=audit_fd)
        try:
            def read_at(parent_fd, name):
                fd = os.open(name, os.O_RDONLY | nofollow, dir_fd=parent_fd)
                try:
                    return os.read(fd, 65536).decode()
                finally:
                    os.close(fd)

            audit_meta = {}
            for raw in read_at(audit_fd, "meta").splitlines():
                key, separator, value = raw.partition("=")
                if not separator or key in audit_meta:
                    raise SystemExit(1)
                audit_meta[key] = value
            if (
                audit_meta.get("fleet_owner_token") != owner.name
                or audit_meta.get("run_id") != run_id.name
                or audit_meta.get("app") != app
            ):
                raise SystemExit(1)

            expected_fields = {}
            for raw in read_at(expected_fd, clone_name.name).splitlines():
                key, separator, value = raw.partition("=")
                if not separator or key in expected_fields:
                    raise SystemExit(1)
                expected_fields[key] = value
            if set(expected_fields) != {"clone_name", "source_machine_id"} or (
                expected_fields["clone_name"] != clone_name.name
                or not re.fullmatch(r"[0-9a-f]+", expected_fields["source_machine_id"])
            ):
                raise SystemExit(1)
            prior = {
                "version": "1", "fleet_owner_token": owner.name,
                "run_id": run_id.name, "app": app, "clone_name": clone_name.name,
                "source": "fresh-clone",
                "source_machine_id": expected_fields["source_machine_id"],
                "machine_id": "", "volume_id": "", "disposition": "ownership-pending",
            }
            try:
                prior_raw = read_at(fresh_fd, clone_name.name)
            except FileNotFoundError:
                prior_raw = ""
            if prior_raw:
                prior = {}
                for raw in prior_raw.splitlines():
                    key, separator, value = raw.partition("=")
                    if not separator or key in prior:
                        raise SystemExit(1)
                    prior[key] = value
            required_record = {
                "version", "fleet_owner_token", "run_id", "app", "clone_name",
                "source", "source_machine_id", "machine_id", "volume_id", "disposition",
            }
            if set(prior) != required_record or any((
                prior["version"] != "1", prior["fleet_owner_token"] != owner.name,
                prior["run_id"] != run_id.name, prior["app"] != app,
                prior["clone_name"] != clone_name.name, prior["source"] != "fresh-clone",
                prior["source_machine_id"] != expected_fields["source_machine_id"],
            )):
                raise SystemExit(1)
            if prior["machine_id"] and machine_id and prior["machine_id"] != machine_id:
                raise SystemExit(1)
            if prior["volume_id"] and volume_id and prior["volume_id"] != volume_id:
                raise SystemExit(1)
            if disposition == "owned" and prior["disposition"] not in {
                "ownership-pending", "owned"
            }:
                raise SystemExit(1)
            machine_id = machine_id or prior["machine_id"]
            volume_id = volume_id or prior["volume_id"]
            if disposition == "not-allocated-verified" and (machine_id or volume_id):
                raise SystemExit(1)
            if disposition == "destroyed-verified-absent" and not volume_id:
                raise SystemExit(1)
            if machine_id:
                try:
                    if read_at(index_fd, machine_id).strip() != clone_name.name:
                        raise SystemExit(1)
                except FileNotFoundError:
                    idx_tmp = f".{machine_id}.tmp.{os.getpid()}"
                    idx_fd = os.open(idx_tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | nofollow,
                                     0o644, dir_fd=index_fd)
                    try:
                        os.write(idx_fd, f"{clone_name.name}\n".encode())
                        os.fsync(idx_fd)
                    finally:
                        os.close(idx_fd)
                    os.rename(idx_tmp, machine_id, src_dir_fd=index_fd, dst_dir_fd=index_fd)
                    os.fsync(index_fd)
            updated = dict(prior)
            updated["machine_id"] = machine_id
            updated["volume_id"] = volume_id
            updated["disposition"] = disposition
            payload = "".join(f"{key}={value}\n" for key, value in updated.items()).encode()
            temporary = f".{clone_name.name}.tmp.{os.getpid()}"
            tmp_fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | nofollow,
                             0o644, dir_fd=fresh_fd)
            try:
                os.write(tmp_fd, payload)
                os.fsync(tmp_fd)
            finally:
                os.close(tmp_fd)
            os.rename(temporary, clone_name.name, src_dir_fd=fresh_fd, dst_dir_fd=fresh_fd)
            os.fsync(fresh_fd)
        finally:
            os.close(index_fd)
            os.close(expected_fd)
            os.close(fresh_fd)
    finally:
        os.close(audit_fd)
finally:
    os.close(root_fd)
PY
}

fleet_audit_update_fresh_clone_by_id() {  # <machine-id> <disposition>
    local id="$1" disposition="$2" record clone_name volume_id
    case "$id" in ''|*[!0-9a-f]*) return 1 ;; esac
    clone_name="$(cat "$FLEET_TEARDOWN_OWNERSHIP_DIR/by-machine-id/$id" 2>/dev/null)"
    case "$clone_name" in cloudbench-[a-zA-Z0-9._-]*) ;; *) return 1 ;; esac
    record="$FLEET_TEARDOWN_OWNERSHIP_DIR/fresh/$clone_name"
    [ -f "$record" ] || return 1
    [ "$(registry_meta_value "$record" machine_id)" = "$id" ] || return 1
    volume_id="$(registry_meta_value "$record" volume_id)"
    fleet_audit_update_fresh_clone "$clone_name" "$id" "$volume_id" "$disposition"
}

fleet_audit_record_pool_machine() {  # <machine-id> <volume-id> <disposition>
    local id="$1" volume_id="$2" disposition="$3"
    local record="$FLEET_TEARDOWN_OWNERSHIP_DIR/pool/$1" tmp="$FLEET_TEARDOWN_OWNERSHIP_DIR/pool/$1.tmp.${BASHPID:-$$}"
    local pool_meta_sha256 recorded_pool_meta_sha256
    local baseline_override="${CLOUDBENCH_POOL_AUDIT_BASELINE_OVERRIDE:-}"
    case "$id" in ''|*[!0-9a-f]*) return 1 ;; esac
    case "$volume_id" in ''|*[!a-zA-Z0-9_-]*) return 1 ;; esac
    case "$disposition" in
        claimed|returned-stopped-claim-released|destroyed-removed-from-pool) ;;
        *) return 1 ;;
    esac
    mkdir -p "${record%/*}" || return 1
    local prior_disposition=""
    if [ -f "$record" ]; then
        [ "$(registry_meta_value "$record" volume_id)" = "$volume_id" ] || return 1
        prior_disposition="$(registry_meta_value "$record" disposition)"
        case "$prior_disposition:$disposition" in
            claimed:returned-stopped-claim-released|claimed:destroyed-removed-from-pool|returned-stopped-claim-released:returned-stopped-claim-released|returned-stopped-claim-released:destroyed-removed-from-pool|destroyed-removed-from-pool:destroyed-removed-from-pool) ;;
            *) return 1 ;;
        esac
    else
        [ "$disposition" = "claimed" ] \
            || { [ -n "$baseline_override" ] \
                && { [ "$disposition" = "returned-stopped-claim-released" ] \
                    || [ "$disposition" = "destroyed-removed-from-pool" ]; }; } \
            || return 1
    fi
    if [ -f "$POOL_META_FILE" ]; then
        pool_meta_sha256="$(cloudbench_env_sha256 "$POOL_META_FILE")" || return 1
    else
        pool_meta_sha256=""
    fi
    if [ -f "$record" ]; then
        recorded_pool_meta_sha256="$(registry_meta_value "$record" pool_meta_sha256)"
        [ "$(registry_meta_value "$record" pool_ledger_file)" = "$POOL_IDS_FILE" ] \
            && [ "$(registry_meta_value "$record" pool_meta_file)" = "$POOL_META_FILE" ] \
            || return 1
        if [ "$disposition" = "destroyed-removed-from-pool" ]; then
            pool_meta_sha256="$recorded_pool_meta_sha256"
        else
            [ -n "$pool_meta_sha256" ] || return 1
            [ "$recorded_pool_meta_sha256" = "$pool_meta_sha256" ] || return 1
        fi
    fi
    if [ ! -f "$record" ] && [ -n "$baseline_override" ]; then
        case "$baseline_override" in
            *[!0-9a-f]*) return 1 ;;
        esac
        [ "${#baseline_override}" -eq 64 ] || return 1
        pool_meta_sha256="$baseline_override"
    fi
    [ -n "$pool_meta_sha256" ] || return 1
    if [ "$disposition" = "destroyed-removed-from-pool" ]; then
        ! grep -Fxq "$id" "$POOL_IDS_FILE" 2>/dev/null || return 1
    else
        [ -f "$POOL_IDS_FILE" ] && grep -Fxq "$id" "$POOL_IDS_FILE" 2>/dev/null \
            || return 1
    fi
    {
        printf 'version=1\n'
        printf 'fleet_owner_token=%s\n' "$FLEET_OWNER_TOKEN"
        printf 'run_id=%s\n' "$RUN_ID"
        printf 'app=%s\n' "$APP"
        printf 'source=borrowed-pool\n'
        printf 'machine_id=%s\n' "$id"
        printf 'volume_id=%s\n' "$volume_id"
        printf 'pool_ledger_file=%s\n' "$POOL_IDS_FILE"
        printf 'pool_meta_file=%s\n' "$POOL_META_FILE"
        printf 'pool_meta_sha256=%s\n' "$pool_meta_sha256"
        printf 'disposition=%s\n' "$disposition"
    } > "$tmp" && mv "$tmp" "$record" || { rm -f "$tmp"; return 1; }
    [ "$(registry_meta_value "$record" fleet_owner_token)" = "$FLEET_OWNER_TOKEN" ] \
        && [ "$(registry_meta_value "$record" run_id)" = "$RUN_ID" ] \
        && [ "$(registry_meta_value "$record" machine_id)" = "$id" ] \
        && [ "$(registry_meta_value "$record" volume_id)" = "$volume_id" ] \
        && [ "$(registry_meta_value "$record" disposition)" = "$disposition" ]
}

fleet_audit_update_recovered_pool_machine() {  # <claim> <terminal-disposition>
    local claim="$1" disposition="$2" id="${1##*/}" owner audit record
    local run_id volume_id ledger meta_file save_audit save_owner save_run
    local save_pool_ids save_pool_meta save_pool_lock rc=0
    owner="$(registry_meta_value "$claim" fleet_owner_token)"
    audit="$FLEET_AUDIT_ROOT/$owner"
    record="$audit/pool/$id"
    run_id="$(registry_meta_value "$record" run_id)"
    [ -n "$run_id" ] || run_id="$(registry_meta_value "$audit/meta" run_id)"
    volume_id="$(registry_meta_value "$record" volume_id)"
    [ -n "$volume_id" ] || volume_id="$(registry_meta_value "$claim" volume_id)"
    ledger="$(registry_meta_value "$record" pool_ledger_file)"
    [ -n "$ledger" ] || ledger="$(registry_meta_value "$claim" pool_ledger_file)"
    meta_file="$(registry_meta_value "$record" pool_meta_file)"
    [ -n "$meta_file" ] || meta_file="$(registry_meta_value "$claim" pool_meta_file)"
    python3 - "$claim" "$record" "$FLEET_AUDIT_ROOT" "$owner" "$id" \
        "$GIT_COMMON_DIR" "$APP" <<'PY' || return 1
import re
import sys
from pathlib import Path

def die(message):
    print(f"exact pool-audit validate failed: {message}", file=sys.stderr)
    raise SystemExit(1)

claim, record, audit_root, owner_raw, machine_id, common, app = sys.argv[1:]
claim = Path(claim); record = Path(record); audit_root = Path(audit_root)
common = Path(common); owner = Path(owner_raw)
if not re.fullmatch(r"[0-9a-f]{32}", owner_raw) or not re.fullmatch(r"[0-9a-f]+", machine_id):
    die(f"owner/machine id format owner={owner_raw!r} machine_id={machine_id!r}")
expected_audit = audit_root / owner.name
if record != expected_audit / "pool" / machine_id:
    die(f"record path mismatch record={record} expected={expected_audit / 'pool' / machine_id}")
for path in (audit_root, expected_audit, claim, expected_audit / "meta"):
    if path.is_symlink():
        die(f"symlink refused: {path}")
def fields(path):
    if not path.is_file():
        die(f"missing field file: {path}")
    result = {}
    for raw in path.read_text().splitlines():
        if not raw.strip():
            continue
        key, separator, value = raw.partition("=")
        if not separator or key in result:
            die(f"bad field line in {path}: {raw!r}")
        result[key] = value
    return result
claim_fields = fields(claim)
basic_claim = {"host", "pid", "pid_start", "fleet_owner_token", "cleanup_state"}
rich_claim = basic_claim | {
    "machine_id", "volume_id", "pool_ledger_file", "pool_meta_file", "pool_meta_sha256",
}
if set(claim_fields) not in (basic_claim, rich_claim):
    die(f"claim keys {sorted(claim_fields)} not basic/rich")
audit_meta = fields(expected_audit / "meta")
token_ok = audit_meta.get("fleet_owner_token") == owner_raw
app_ok = audit_meta.get("app") == app
run_id = audit_meta.get("run_id", "")
run_ok = bool(re.fullmatch(r"[A-Za-z0-9._-]+", run_id))
if not (token_ok and app_ok and run_ok):
    die(
        "audit meta mismatch "
        f"owner_raw={owner_raw!r} token={audit_meta.get('fleet_owner_token')!r} "
        f"token_ok={token_ok} app={audit_meta.get('app')!r} expected_app={app!r} "
        f"app_ok={app_ok} app_hex={(audit_meta.get('app') or '').encode().hex()} "
        f"expected_app_hex={app.encode().hex()} "
        f"run_id={run_id!r} run_ok={run_ok} "
        f"claim_head={claim.read_text()[:240]!r} meta_head={ (expected_audit / 'meta').read_text()[:240]!r}"
    )
if record.exists():
    if record.is_symlink():
        die(f"symlink refused: {record}")
    pool = fields(record)
else:
    if set(claim_fields) != rich_claim:
        die("missing pool audit requires rich claim fields")
    pool = {
        "version": "1", "fleet_owner_token": owner_raw,
        "run_id": audit_meta["run_id"], "app": app, "source": "borrowed-pool",
        "machine_id": machine_id, "volume_id": claim_fields["volume_id"],
        "pool_ledger_file": claim_fields["pool_ledger_file"],
        "pool_meta_file": claim_fields["pool_meta_file"],
        "pool_meta_sha256": claim_fields["pool_meta_sha256"], "disposition": "claimed",
    }
required = {
    "version", "fleet_owner_token", "run_id", "app", "source", "machine_id",
    "volume_id", "pool_ledger_file", "pool_meta_file", "pool_meta_sha256", "disposition",
}
if set(pool) != required:
    die(f"pool keys {sorted(pool)} != {sorted(required)}")
if (
    claim_fields["fleet_owner_token"] != owner_raw
    or claim_fields["cleanup_state"] != "owned" or pool["version"] != "1"
    or pool["fleet_owner_token"] != owner_raw or pool["app"] != app
    or pool["source"] != "borrowed-pool" or pool["machine_id"] != machine_id
    or not re.fullmatch(r"[A-Za-z0-9_-]+", pool["volume_id"])
    or not re.fullmatch(r"[A-Za-z0-9._-]+", pool["run_id"])
    or not re.fullmatch(r"[0-9a-f]{64}", pool["pool_meta_sha256"])
):
    die(
        "pool identity/source mismatch "
        f"cleanup={claim_fields.get('cleanup_state')!r} source={pool.get('source')!r} "
        f"pool_app={pool.get('app')!r} expected_app={app!r} "
        f"volume={pool.get('volume_id')!r} run_id={pool.get('run_id')!r} "
        f"sha={pool.get('pool_meta_sha256')!r}"
    )
if set(claim_fields) == rich_claim and any(
    claim_fields[key] != pool[key]
    for key in ("machine_id", "volume_id", "pool_ledger_file", "pool_meta_file", "pool_meta_sha256")
):
    mismatched = [
        key for key in ("machine_id", "volume_id", "pool_ledger_file", "pool_meta_file", "pool_meta_sha256")
        if claim_fields[key] != pool[key]
    ]
    die(f"claim/pool field mismatch on {mismatched}")
ledger = Path(pool["pool_ledger_file"])
meta = Path(pool["pool_meta_file"])
pool_root = common / "cloudbench-pools"
if not ledger.is_absolute():
    die(f"ledger is not absolute: {ledger}")
# Compare canonical parents so a non-pwd -P claim path still matches the
# controller's pwd -P GIT_COMMON_DIR (symlink / bind-mount drift).
try:
    ledger_parent = ledger.parent.resolve()
    pool_root_resolved = pool_root.resolve()
except OSError as exc:
    die(f"could not resolve ledger/pool_root: {exc}")
if ledger_parent != pool_root_resolved and ledger.parent != pool_root:
    die(
        f"ledger parent {ledger.parent} (resolved {ledger_parent}) != "
        f"pool_root {pool_root} (resolved {pool_root_resolved}) "
        f"(GIT_COMMON_DIR={common})"
    )
if not re.fullmatch(r"[A-Za-z0-9._-]+\.ids", ledger.name):
    die(f"ledger name rejected: {ledger.name!r}")
if meta != Path(f"{ledger}.deps") and meta.resolve() != Path(f"{ledger}.deps").resolve():
    die(f"meta path {meta} != {ledger}.deps")
if ledger.is_symlink() or meta.is_symlink():
    die(f"ledger/meta symlink refused ledger={ledger} meta={meta}")
PY
    [ "$disposition" = "validate-only" ] && return 0
    [ ! -L "$audit/pool" ] || return 1
    mkdir -p "$audit/pool" || return 1
    save_audit="$FLEET_TEARDOWN_OWNERSHIP_DIR"; save_owner="$FLEET_OWNER_TOKEN"
    save_run="$RUN_ID"; save_pool_ids="$POOL_IDS_FILE"; save_pool_meta="$POOL_META_FILE"
    save_pool_lock="$POOL_IDS_LOCK"
    FLEET_TEARDOWN_OWNERSHIP_DIR="$audit"; FLEET_OWNER_TOKEN="$owner"; RUN_ID="$run_id"
    POOL_IDS_FILE="$ledger"; POOL_META_FILE="$meta_file"; POOL_IDS_LOCK="$ledger.lock"
    if [ -f "$record" ]; then
        fleet_audit_record_pool_machine "$id" "$volume_id" "$disposition" || rc=$?
    else
        CLOUDBENCH_POOL_AUDIT_BASELINE_OVERRIDE="$(registry_meta_value \
            "$claim" pool_meta_sha256)" \
            fleet_audit_record_pool_machine "$id" "$volume_id" "$disposition" || rc=$?
    fi
    FLEET_TEARDOWN_OWNERSHIP_DIR="$save_audit"; FLEET_OWNER_TOKEN="$save_owner"
    RUN_ID="$save_run"; POOL_IDS_FILE="$save_pool_ids"; POOL_META_FILE="$save_pool_meta"
    POOL_IDS_LOCK="$save_pool_lock"
    return "$rc"
}

fleet_audit_update_recovered_transfer() {  # <claim> <terminal-disposition>
    local claim="$1" disposition="$2" id="${1##*/}" owner audit clone record
    local source_id volume_id run_id ledger meta_file save_audit save_owner save_run rc=0
    local save_pool_ids save_pool_meta
    owner="$(registry_meta_value "$claim" fleet_owner_token)"
    audit="$FLEET_AUDIT_ROOT/$owner"
    clone="$(registry_meta_value "$claim" clone_name)"
    record="$audit/fresh/$clone"
    source_id="$(registry_meta_value "$record" source_machine_id)"
    volume_id="$(registry_meta_value "$claim" volume_id)"
    run_id="$(registry_meta_value "$record" run_id)"
    ledger="$(registry_meta_value "$claim" pool_ledger_file)"
    meta_file="$(registry_meta_value "$claim" pool_meta_file)"
    python3 - "$claim" "$record" "$audit/by-machine-id/$id" \
        "$FLEET_AUDIT_ROOT" "$owner" "$id" "$GIT_COMMON_DIR" "$APP" <<'PY' || return 1
import hashlib
import re
import sys
from pathlib import Path

claim, record, index, audit_root, owner, machine_id, common, app = sys.argv[1:]
claim = Path(claim); record = Path(record); index = Path(index)
audit_root = Path(audit_root); common = Path(common)
if not re.fullmatch(r"[0-9a-f]{32}", owner) or not re.fullmatch(r"[0-9a-f]+", machine_id):
    raise SystemExit(1)
def fields(path):
    if path.is_symlink() or not path.is_file():
        raise SystemExit(1)
    result = {}
    for raw in path.read_text().splitlines():
        key, separator, value = raw.partition("=")
        if not separator or key in result:
            raise SystemExit(1)
        result[key] = value
    return result
c = fields(claim)
required_claim = {
    "host", "pid", "pid_start", "fleet_owner_token", "cleanup_state", "transfer_state",
    "machine_id", "clone_name", "volume_id", "pool_ledger_file", "pool_meta_file",
    "pool_meta_sha256",
}
if set(c) != required_claim or any((
    c["fleet_owner_token"] != owner, c["cleanup_state"] != "owned",
    c["transfer_state"] != "pending", c["machine_id"] != machine_id,
    re.fullmatch(r"cloudbench-[A-Za-z0-9._-]+", c["clone_name"]) is None,
    re.fullmatch(r"[A-Za-z0-9_-]+", c["volume_id"]) is None,
    re.fullmatch(r"[0-9a-f]{64}", c["pool_meta_sha256"]) is None,
)):
    raise SystemExit(1)
expected_audit = audit_root / owner
if record != expected_audit / "fresh" / c["clone_name"] or index.read_text().strip() != c["clone_name"]:
    raise SystemExit(1)
f = fields(record)
if any((
    f.get("fleet_owner_token") != owner, f.get("app") != app,
    f.get("source") != "fresh-clone", f.get("clone_name") != c["clone_name"],
    f.get("machine_id") != machine_id, f.get("volume_id") != c["volume_id"],
)):
    raise SystemExit(1)
ledger = Path(c["pool_ledger_file"]); meta = Path(c["pool_meta_file"])
pool_root = common / "cloudbench-pools"
if (
    ledger.parent != pool_root or not re.fullmatch(r"[A-Za-z0-9._-]+\.ids", ledger.name)
    or meta != Path(f"{ledger}.deps") or ledger.is_symlink() or meta.is_symlink()
):
    raise SystemExit(1)
PY
    [ "$disposition" = "validate-only" ] && return 0
    save_audit="$FLEET_TEARDOWN_OWNERSHIP_DIR"; save_owner="$FLEET_OWNER_TOKEN"; save_run="$RUN_ID"
    save_pool_ids="$POOL_IDS_FILE"; save_pool_meta="$POOL_META_FILE"
    FLEET_TEARDOWN_OWNERSHIP_DIR="$audit"; FLEET_OWNER_TOKEN="$owner"; RUN_ID="$run_id"
    POOL_IDS_FILE="$ledger"; POOL_META_FILE="$meta_file"
    if [ "$disposition" = "transferred-to-pool-stopped" ]; then
        fleet_audit_record_pool_handoff "$claim" "$clone" "$id" "$volume_id" || rc=$?
    fi
    [ "$rc" = "0" ] \
        && fleet_audit_record_fresh_clone "$clone" "$source_id" "$id" "$volume_id" "$disposition" \
        || rc=$?
    FLEET_TEARDOWN_OWNERSHIP_DIR="$save_audit"; FLEET_OWNER_TOKEN="$save_owner"; RUN_ID="$save_run"
    POOL_IDS_FILE="$save_pool_ids"; POOL_META_FILE="$save_pool_meta"
    return "$rc"
}

fleet_audit_record_pool_handoff() {  # <transfer-claim> <clone-name> <machine-id> <volume-id>
    local claim="$1" clone_name="$2" id="$3" volume_id="$4" claim_sha256
    local handoff_dir="$FLEET_TEARDOWN_OWNERSHIP_DIR/pool-handoffs"
    local record="$handoff_dir/$clone_name" tmp="$handoff_dir/$clone_name.tmp.${BASHPID:-$$}"
    local ledger meta_file baseline
    case "$clone_name" in cloudbench-*) ;; *) return 1 ;; esac
    case "$clone_name" in *[!a-zA-Z0-9._-]*) return 1 ;; esac
    case "$id" in ''|*[!0-9a-f]*) return 1 ;; esac
    case "$volume_id" in ''|*[!a-zA-Z0-9_-]*) return 1 ;; esac
    [ -f "$claim" ] && [ ! -L "$claim" ] || return 1
    [ "$(registry_meta_value "$claim" fleet_owner_token)" = "$FLEET_OWNER_TOKEN" ] \
        && [ "$(registry_meta_value "$claim" transfer_state)" = pending ] \
        && [ "$(registry_meta_value "$claim" machine_id)" = "$id" ] \
        && [ "$(registry_meta_value "$claim" clone_name)" = "$clone_name" ] \
        && [ "$(registry_meta_value "$claim" volume_id)" = "$volume_id" ] || return 1
    ledger="$(registry_meta_value "$claim" pool_ledger_file)"
    meta_file="$(registry_meta_value "$claim" pool_meta_file)"
    baseline="$(registry_meta_value "$claim" pool_meta_sha256)"
    [ "$ledger" = "$POOL_IDS_FILE" ] && [ "$meta_file" = "$POOL_META_FILE" ] \
        && [ "$meta_file" = "$ledger.deps" ] || return 1
    case "$baseline" in *[!0-9a-f]*) return 1 ;; esac
    [ "${#baseline}" -eq 64 ] || return 1
    claim_sha256="$(cloudbench_env_sha256 "$claim")" || return 1
    case "$claim_sha256" in *[!0-9a-f]*) return 1 ;; esac
    [ "${#claim_sha256}" -eq 64 ] || return 1
    [ -d "$handoff_dir" ] || mkdir "$handoff_dir" || return 1
    [ ! -L "$handoff_dir" ] || return 1
    if [ -f "$record" ]; then
        [ "$(registry_meta_value "$record" fleet_owner_token)" = "$FLEET_OWNER_TOKEN" ] \
            && [ "$(registry_meta_value "$record" run_id)" = "$RUN_ID" ] \
            && [ "$(registry_meta_value "$record" clone_name)" = "$clone_name" ] \
            && [ "$(registry_meta_value "$record" machine_id)" = "$id" ] \
            && [ "$(registry_meta_value "$record" volume_id)" = "$volume_id" ] \
            && [ "$(registry_meta_value "$record" claim_sha256)" = "$claim_sha256" ] \
            || return 1
        return 0
    fi
    {
        printf 'version=1\n'
        printf 'fleet_owner_token=%s\n' "$FLEET_OWNER_TOKEN"
        printf 'run_id=%s\n' "$RUN_ID"
        printf 'app=%s\n' "$APP"
        printf 'source=fresh-to-pool\n'
        printf 'clone_name=%s\n' "$clone_name"
        printf 'machine_id=%s\n' "$id"
        printf 'volume_id=%s\n' "$volume_id"
        printf 'pool_ledger_file=%s\n' "$ledger"
        printf 'pool_meta_file=%s\n' "$meta_file"
        printf 'pool_meta_sha256=%s\n' "$baseline"
        printf 'claim_sha256=%s\n' "$claim_sha256"
        printf 'linearization=terminal-record-before-exact-claim-release\n'
    } > "$tmp" && mv "$tmp" "$record" || { rm -f "$tmp"; return 1; }
    [ "$(registry_meta_value "$record" claim_sha256)" = "$claim_sha256" ]
}

fleet_audit_finalize_provider_teardown() {
    local hub_disposition hub_owner_file hub_owner_token
    local hub_pid hub_pid_start hub_argv_sha256
    local shared_only="${FLEET_AUDIT_SHARED_ONLY:-0}"
    local shared_only_reason="${FLEET_AUDIT_SHARED_ONLY_REASON:-}"
    local tmp="$FLEET_TEARDOWN_OWNERSHIP_DIR/meta.tmp.$$"
    find "$FLEET_TEARDOWN_OWNERSHIP_DIR/expected-fresh" -mindepth 1 -maxdepth 1 \
        -type f -exec basename {} \; | LC_ALL=C sort \
        > "$OWNED_CLONE_NAMES_FILE.tmp.$$" \
        && mv "$OWNED_CLONE_NAMES_FILE.tmp.$$" "$OWNED_CLONE_NAMES_FILE" \
        || { rm -f "$OWNED_CLONE_NAMES_FILE.tmp.$$"; return 1; }
    find "$FLEET_TEARDOWN_OWNERSHIP_DIR/by-machine-id" -mindepth 1 -maxdepth 1 \
        -type f -exec basename {} \; | LC_ALL=C sort \
        > "$OWNED_CLONES_FILE.tmp.$$" \
        && mv "$OWNED_CLONES_FILE.tmp.$$" "$OWNED_CLONES_FILE" \
        || { rm -f "$OWNED_CLONES_FILE.tmp.$$"; return 1; }
    python3 - "$FLEET_TEARDOWN_OWNERSHIP_DIR" "$OWNED_CLONE_NAMES_FILE" \
        "$OWNED_CLONES_FILE" "$FLEET_OWNER_TOKEN" "$RUN_ID" "$APP" \
        "$POOL_CLAIMS_DIR" "$GIT_COMMON_DIR" <<'PY' \
        || return 1
import hashlib
import re
import sys
from pathlib import Path

audit, names_path, ids_path = map(Path, sys.argv[1:4])
owner, run_id, app = sys.argv[4:7]
claims_dir = Path(sys.argv[7])
git_common = Path(sys.argv[8])

def lines(path: Path):
    values = [line for line in path.read_text().splitlines() if line]
    if len(values) != len(set(values)):
        raise SystemExit(1)
    return values

def record(path: Path, required):
    if not path.is_file() or path.is_symlink():
        raise SystemExit(1)
    fields = {}
    for raw in path.read_text().splitlines():
        key, separator, value = raw.partition("=")
        if not separator or key in fields:
            raise SystemExit(1)
        fields[key] = value
    if set(fields) != set(required):
        raise SystemExit(1)
    return fields

expected_names = set(lines(names_path))
expected_ids = set(lines(ids_path))
if any(not re.fullmatch(r"cloudbench-[A-Za-z0-9._-]+", name) for name in expected_names):
    raise SystemExit(1)
if any(not re.fullmatch(r"[0-9a-f]+", machine_id) for machine_id in expected_ids):
    raise SystemExit(1)
expected_records = {}
for path in (audit / "expected-fresh").iterdir():
    fields = record(path, {"clone_name", "source_machine_id"})
    if (
        path.name != fields["clone_name"] or path.name in expected_records
        or not re.fullmatch(r"cloudbench-[A-Za-z0-9._-]+", path.name)
        or not re.fullmatch(r"[0-9a-f]+", fields["source_machine_id"])
    ):
        raise SystemExit(1)
    expected_records[path.name] = fields["source_machine_id"]
if set(expected_records) != expected_names:
    raise SystemExit(1)

fresh_required = {
    "version", "fleet_owner_token", "run_id", "app", "clone_name", "source",
    "source_machine_id", "machine_id", "volume_id", "disposition",
}
fresh = {}
machine_to_name = {}
transferred_names = set()
for path in (audit / "fresh").iterdir():
    fields = record(path, fresh_required)
    name = fields["clone_name"]
    machine_id = fields["machine_id"]
    volume_id = fields["volume_id"]
    disposition = fields["disposition"]
    if (
        path.name != name or name in fresh or fields["version"] != "1"
        or fields["fleet_owner_token"] != owner or fields["run_id"] != run_id
        or fields["app"] != app or fields["source"] != "fresh-clone"
        or not re.fullmatch(r"[0-9a-f]+", fields["source_machine_id"])
        or expected_records.get(name) != fields["source_machine_id"]
        or disposition not in {"destroyed-verified-absent", "not-allocated-verified", "transferred-to-pool-stopped"}
    ):
        raise SystemExit(1)
    if disposition == "not-allocated-verified":
        if machine_id or volume_id:
            raise SystemExit(1)
    elif disposition == "transferred-to-pool-stopped" and (not machine_id or not volume_id):
        raise SystemExit(1)
    elif disposition == "destroyed-verified-absent" and not volume_id:
        raise SystemExit(1)
    if volume_id and not re.fullmatch(r"[A-Za-z0-9_-]+", volume_id):
        raise SystemExit(1)
    if machine_id:
        if not re.fullmatch(r"[0-9a-f]+", machine_id) or machine_id in machine_to_name:
            raise SystemExit(1)
        machine_to_name[machine_id] = name
    if disposition == "transferred-to-pool-stopped":
        transferred_names.add(name)
    fresh[name] = fields
if set(fresh) != expected_names or set(machine_to_name) != expected_ids:
    raise SystemExit(1)

index = {}
for path in (audit / "by-machine-id").iterdir():
    if not path.is_file() or path.is_symlink() or not re.fullmatch(r"[0-9a-f]+", path.name):
        raise SystemExit(1)
    name = path.read_text().strip()
    if not name or "\n" in name or path.name in index:
        raise SystemExit(1)
    index[path.name] = name
if index != machine_to_name:
    raise SystemExit(1)

handoff_required = {
    "version", "fleet_owner_token", "run_id", "app", "source", "clone_name",
    "machine_id", "volume_id", "pool_ledger_file", "pool_meta_file",
    "pool_meta_sha256", "claim_sha256", "linearization",
}
handoffs = set()
handoff_dir = audit / "pool-handoffs"
if handoff_dir.exists():
    if handoff_dir.is_symlink() or not handoff_dir.is_dir():
        raise SystemExit(1)
    for path in handoff_dir.iterdir():
        fields = record(path, handoff_required)
        name = fields["clone_name"]
        prior = fresh.get(name, {})
        ledger = Path(fields["pool_ledger_file"])
        meta = Path(fields["pool_meta_file"])
        if (
            path.name != name or name in handoffs or name not in transferred_names
            or fields["version"] != "1" or fields["fleet_owner_token"] != owner
            or fields["run_id"] != run_id or fields["app"] != app
            or fields["source"] != "fresh-to-pool"
            or fields["machine_id"] != prior.get("machine_id")
            or fields["volume_id"] != prior.get("volume_id")
            or not ledger.is_absolute() or ledger.parent != git_common / "cloudbench-pools"
            or not re.fullmatch(r"[A-Za-z0-9._-]+\.ids", ledger.name)
            or meta != Path(f"{ledger}.deps")
            or not re.fullmatch(r"[0-9a-f]{64}", fields["pool_meta_sha256"])
            or not re.fullmatch(r"[0-9a-f]{64}", fields["claim_sha256"])
            or fields["linearization"] != "terminal-record-before-exact-claim-release"
        ):
            raise SystemExit(1)
        handoffs.add(name)
if handoffs != transferred_names:
    raise SystemExit(1)

pool_required = {
    "version", "fleet_owner_token", "run_id", "app", "source",
    "machine_id", "volume_id", "pool_ledger_file", "pool_meta_file",
    "pool_meta_sha256", "disposition",
}
seen_pool = set()
pool_dir = audit / "pool"
if pool_dir.exists():
    for path in pool_dir.iterdir():
        fields = record(path, pool_required)
        machine_id = fields["machine_id"]
        if (
            path.name != machine_id or machine_id in seen_pool
            or fields["version"] != "1" or fields["fleet_owner_token"] != owner
            or fields["run_id"] != run_id or fields["app"] != app
            or fields["source"] != "borrowed-pool"
            or not re.fullmatch(r"[0-9a-f]+", machine_id)
            or not re.fullmatch(r"[A-Za-z0-9_-]+", fields["volume_id"])
            or not re.fullmatch(r"[0-9a-f]{64}", fields["pool_meta_sha256"])
            or fields["disposition"] not in {
                "returned-stopped-claim-released", "destroyed-removed-from-pool"
            }
        ):
            raise SystemExit(1)
        ledger = Path(fields["pool_ledger_file"])
        pool_meta = Path(fields["pool_meta_file"])
        if (
            not ledger.is_absolute()
            or ledger.parent != git_common / "cloudbench-pools"
            or not re.fullmatch(r"[A-Za-z0-9._-]+\.ids", ledger.name)
            or pool_meta != Path(f"{ledger}.deps")
        ):
            raise SystemExit(1)
        seen_pool.add(machine_id)
if claims_dir.is_dir():
    for path in claims_dir.iterdir():
        if not path.is_file() or path.is_symlink():
            continue
        fields = {}
        for raw in path.read_text().splitlines():
            key, separator, value = raw.partition("=")
            if separator and key not in fields:
                fields[key] = value
        if fields.get("fleet_owner_token") == owner:
            raise SystemExit(1)
PY
    if [ "$shared_only" = "1" ]; then
        [ "$shared_only_reason" = "original-worktree-deleted" ] || return 1
        # The live worktree (and therefore its owner-file pathname) is gone.
        # Preserve the exact immutable hub identity captured before launch;
        # never dereference or signal through that now-unavailable path.
        hub_disposition="$(registry_meta_value \
            "$FLEET_TEARDOWN_OWNERSHIP_DIR/meta" hub_disposition)"
        hub_owner_file="$(registry_meta_value \
            "$FLEET_TEARDOWN_OWNERSHIP_DIR/meta" hub_owner_file)"
        hub_owner_token="$(registry_meta_value \
            "$FLEET_TEARDOWN_OWNERSHIP_DIR/meta" hub_owner_token)"
        hub_pid="$(registry_meta_value "$FLEET_TEARDOWN_OWNERSHIP_DIR/meta" hub_pid)"
        hub_pid_start="$(registry_meta_value \
            "$FLEET_TEARDOWN_OWNERSHIP_DIR/meta" hub_pid_start)"
        hub_argv_sha256="$(registry_meta_value \
            "$FLEET_TEARDOWN_OWNERSHIP_DIR/meta" hub_argv_sha256)"
        case "$hub_disposition" in
            not-applicable) ;;
            retained-exact-owner-transfer-required)
                case "$hub_owner_token" in ''|*[!0-9a-f]*) return 1 ;; esac
                [ "${#hub_owner_token}" -eq 32 ] && [ -n "$hub_owner_file" ] \
                    && [ -n "$hub_pid" ] && [ -n "$hub_pid_start" ] \
                    && [ -n "$hub_argv_sha256" ] || return 1
                ;;
            *) return 1 ;;
        esac
    elif [ -n "$CENTRAL_HUB_OWNER_FILE" ]; then
        cloudbench_central_hub_owner_matches "$DASH_BASE" "$RUNS_ROOT" \
            "$ROOT_DIR" "$CENTRAL_HUB_OWNER_FILE" || return 1
        hub_disposition="retained-exact-owner-transfer-required"
        hub_owner_file="$CENTRAL_HUB_OWNER_FILE"
        hub_owner_token="$(cloudbench_tracked_owner_value "$hub_owner_file" owner_token)"
        hub_pid="$(cloudbench_tracked_owner_value "$hub_owner_file" pid)"
        hub_pid_start="$(cloudbench_tracked_owner_value "$hub_owner_file" pid_start)"
        hub_argv_sha256="$(cloudbench_tracked_owner_value "$hub_owner_file" argv_sha256)"
    elif [ -n "$PROVISION_POOL" ]; then
        hub_disposition="not-applicable"
        hub_owner_file=""
        hub_owner_token=""
        hub_pid=""
        hub_pid_start=""
        hub_argv_sha256=""
    else
        return 1
    fi
    {
        printf 'version=1\n'
        printf 'fleet_owner_token=%s\n' "$FLEET_OWNER_TOKEN"
        printf 'run_id=%s\n' "$RUN_ID"
        printf 'app=%s\n' "$APP"
        printf 'workspace_root=%s\n' "$ROOT_DIR"
        printf 'status=provider-teardown-verified\n'
        printf 'hub_disposition=%s\n' "$hub_disposition"
        printf 'hub_owner_file=%s\n' "$hub_owner_file"
        printf 'hub_owner_token=%s\n' "$hub_owner_token"
        printf 'hub_pid=%s\n' "$hub_pid"
        printf 'hub_pid_start=%s\n' "$hub_pid_start"
        printf 'hub_argv_sha256=%s\n' "$hub_argv_sha256"
    } > "$tmp" && mv "$tmp" "$FLEET_TEARDOWN_OWNERSHIP_DIR/meta" \
        || { rm -f "$tmp"; return 1; }
    if [ "$shared_only" = "1" ]; then
        {
            printf 'status=run-local-unavailable-because-worktree-deleted\n'
            printf 'intended_path=%s/teardown-ownership\n' "$FLEET_DIR"
            printf 'hub_recovery_authority=%s/meta\n' "$FLEET_TEARDOWN_OWNERSHIP_DIR"
        } > "$FLEET_TEARDOWN_OWNERSHIP_DIR/run-local-disposition" || return 1
    fi
    find "$FLEET_TEARDOWN_OWNERSHIP_DIR" -type f -exec chmod a-w {} + \
        || return 1
    [ "$(registry_meta_value "$FLEET_TEARDOWN_OWNERSHIP_DIR/meta" status)" \
        = "provider-teardown-verified" ] || return 1
    if [ "$shared_only" = "1" ]; then
        # With no run-local destination, this shared token directory is also
        # the exact Hub transfer/termination authority. Freeze directories as
        # well as files so removing the provider registry does not erase that
        # independently durable PID-birth/argv/root record.
        find "$FLEET_TEARDOWN_OWNERSHIP_DIR" -depth -type d -exec chmod a-w {} + \
            || return 1
        return 0
    fi
    # The shared audit is the crash-recovery WAL. Acceptance evidence is an
    # immutable, self-contained run artifact so later shared-root maintenance
    # cannot erase or silently change the teardown proof.
    python3 - "$FLEET_TEARDOWN_OWNERSHIP_DIR" "$FLEET_DIR" <<'PY'
import hashlib
import os
import shutil
import stat
import sys
import tempfile
from pathlib import Path

source = Path(sys.argv[1])
run_dir = Path(sys.argv[2])
target = run_dir / "teardown-ownership"

def digest_tree(root):
    digest = hashlib.sha256()
    for path in sorted(root.rglob("*"), key=lambda item: str(item.relative_to(root))):
        if path.is_symlink() or not (path.is_dir() or path.is_file()):
            raise SystemExit(1)
        if path.is_file() and path.name != "source-audit":
            relative = str(path.relative_to(root)).encode()
            payload = path.read_bytes()
            digest.update(len(relative).to_bytes(8, "big"))
            digest.update(relative)
            digest.update(len(payload).to_bytes(8, "big"))
            digest.update(payload)
    return digest.hexdigest()

source_digest = digest_tree(source)
if target.exists():
    binding = target / "source-audit"
    expected = f"path={source}\nsha256={source_digest}\n"
    if target.is_symlink() or not target.is_dir() or binding.read_text() != expected:
        raise SystemExit(1)
    if digest_tree(target) != source_digest:
        raise SystemExit(1)
    raise SystemExit(0)
if run_dir.is_symlink() or not run_dir.is_dir():
    raise SystemExit(1)
stage = Path(tempfile.mkdtemp(prefix=".teardown-ownership.", dir=run_dir))
try:
    for entry in source.iterdir():
        destination = stage / entry.name
        if entry.is_symlink():
            raise SystemExit(1)
        if entry.is_dir():
            shutil.copytree(entry, destination, symlinks=True)
        elif entry.is_file():
            shutil.copy2(entry, destination, follow_symlinks=False)
        else:
            raise SystemExit(1)
    (stage / "source-audit").write_text(f"path={source}\nsha256={source_digest}\n")
    if digest_tree(stage) != source_digest:
        raise SystemExit(1)
    for path in stage.rglob("*"):
        mode = stat.S_IMODE(path.stat(follow_symlinks=False).st_mode)
        os.chmod(path, mode & ~0o222, follow_symlinks=False)
    os.chmod(stage, stat.S_IMODE(stage.stat().st_mode) & ~0o222)
    os.rename(stage, target)
    directory_fd = os.open(run_dir, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)
finally:
    if stage.exists():
        shutil.rmtree(stage)
PY
}

fleet_audit_finalize_recovered_registry() {  # <v2-registry>
    local registry="$1" meta="$1/meta" audit_dir original_run original_owner
    local original_root original_runs original_app owned_ids owned_names hub_owner hub_disposition
    local save_audit save_run save_owner save_root save_runs save_ids save_names
    local save_hub save_dash save_provision save_fleet_dir rc=0 workspace_available=1
    local save_shared_only save_shared_reason
    [ "$(registry_meta_value "$meta" version)" = "2" ] || return 0
    original_owner="${registry##*/}"
    original_run="$(registry_meta_value "$meta" run_id)"
    original_root="$(registry_meta_value "$meta" workspace_root)"
    original_runs="$(registry_meta_value "$meta" runs_root)"
    original_app="$(registry_meta_value "$meta" app)"
    audit_dir="$(registry_meta_value "$meta" audit_dir)"
    owned_ids="$(registry_meta_value "$meta" owned_ids_file)"
    owned_names="$(registry_meta_value "$meta" owned_names_file)"
    case "$original_run" in ''|*[!a-zA-Z0-9._-]*) return 1 ;; esac
    [ "$audit_dir" = "$FLEET_AUDIT_ROOT/$original_owner" ] \
        && [ "$owned_ids" = "$audit_dir/owned-clones.ids" ] \
        && [ "$owned_names" = "$audit_dir/owned-clones.names" ] \
        && [ "$(registry_meta_value "$audit_dir/meta" fleet_owner_token)" = "$original_owner" ] \
        || return 1
    if [ ! -e "$original_root" ]; then
        workspace_available=0
        python3 - "$original_root" "$original_runs" "$original_run" \
            "$audit_dir/meta" "$original_owner" "$original_app" <<'PY' || return 1
import os
import re
import sys
from pathlib import Path

workspace, runs, run_id, audit_meta, owner, app = sys.argv[1:]
workspace = Path(workspace); runs = Path(runs); audit_meta = Path(audit_meta)
if (
    not workspace.is_absolute() or workspace.exists() or not runs.is_absolute()
    or os.path.normpath(str(workspace)) != str(workspace)
    or os.path.normpath(str(runs)) != str(runs)
    or os.path.commonpath((str(workspace / ".context"), str(runs)))
       != str(workspace / ".context")
    or not re.fullmatch(r"[A-Za-z0-9._-]+", run_id)
    or not re.fullmatch(r"[0-9a-f]{32}", owner)
):
    raise SystemExit(1)
fields = {}
for raw in audit_meta.read_text().splitlines():
    key, separator, value = raw.partition("=")
    if not separator or key in fields:
        raise SystemExit(1)
    fields[key] = value
if (
    fields.get("fleet_owner_token") != owner or fields.get("run_id") != run_id
    or fields.get("app") != app or fields.get("workspace_root") != str(workspace)
    or fields.get("status") not in {"incomplete", "provider-teardown-verified"}
):
    raise SystemExit(1)
PY
    else
        python3 - "$original_root" "$original_runs" "$original_run" "$GIT_COMMON_DIR" <<'PY' \
            || return 1
import os
import subprocess
import sys
from pathlib import Path

workspace, runs, run_id, trusted_common = map(Path, sys.argv[1:5])
if not workspace.is_absolute() or not runs.is_absolute() or str(run_id) != run_id.name:
    raise SystemExit(1)
try:
    workspace_real = workspace.resolve(strict=True)
    context_real = (workspace_real / ".context").resolve(strict=True)
    runs_real = runs.resolve(strict=True)
    common_raw = subprocess.check_output(
        ["git", "-C", str(workspace_real), "rev-parse", "--git-common-dir"],
        text=True,
        stderr=subprocess.DEVNULL,
    ).strip()
    toplevel = Path(subprocess.check_output(
        ["git", "-C", str(workspace_real), "rev-parse", "--show-toplevel"],
        text=True,
        stderr=subprocess.DEVNULL,
    ).strip()).resolve(strict=True)
    common = Path(common_raw)
    if not common.is_absolute():
        common = workspace_real / common
    common = common.resolve(strict=True)
    trusted = trusted_common.resolve(strict=True)
except (OSError, RuntimeError, subprocess.CalledProcessError):
    raise SystemExit(1)
if (
    workspace != workspace_real or workspace_real != toplevel or runs != runs_real or common != trusted
    or os.path.commonpath((str(context_real), str(runs_real))) != str(context_real)
):
    raise SystemExit(1)
target = runs_real / run_id.name
if target.resolve(strict=True) != target or target.is_symlink() or not target.is_dir():
    raise SystemExit(1)
PY
    fi
    hub_owner="$(registry_meta_value "$audit_dir/meta" hub_owner_file)"
    hub_disposition="$(registry_meta_value "$audit_dir/meta" hub_disposition)"
    save_audit="${FLEET_TEARDOWN_OWNERSHIP_DIR:-}"; save_run="$RUN_ID"
    save_owner="$FLEET_OWNER_TOKEN"; save_root="$ROOT_DIR"; save_runs="$RUNS_ROOT"
    save_ids="${OWNED_CLONES_FILE:-}"; save_names="${OWNED_CLONE_NAMES_FILE:-}"
    save_hub="$CENTRAL_HUB_OWNER_FILE"; save_dash="$DASH_BASE"; save_provision="$PROVISION_POOL"
    save_fleet_dir="$FLEET_DIR"
    save_shared_only="${FLEET_AUDIT_SHARED_ONLY:-}"
    save_shared_reason="${FLEET_AUDIT_SHARED_ONLY_REASON:-}"
    FLEET_TEARDOWN_OWNERSHIP_DIR="$audit_dir"; RUN_ID="$original_run"
    FLEET_OWNER_TOKEN="$original_owner"; ROOT_DIR="$original_root"; RUNS_ROOT="$original_runs"
    FLEET_DIR="$original_runs/$original_run"
    OWNED_CLONES_FILE="$owned_ids"; OWNED_CLONE_NAMES_FILE="$owned_names"
    CENTRAL_HUB_OWNER_FILE="$hub_owner"
    if [ "$workspace_available" = "0" ]; then
        FLEET_AUDIT_SHARED_ONLY=1
        FLEET_AUDIT_SHARED_ONLY_REASON=original-worktree-deleted
    else
        FLEET_AUDIT_SHARED_ONLY=0
        FLEET_AUDIT_SHARED_ONLY_REASON=""
    fi
    if [ -n "$hub_owner" ]; then
        DASH_BASE="$(registry_meta_value "$hub_owner" port)"
        PROVISION_POOL=""
    elif [ "$hub_disposition" = "not-applicable" ]; then
        PROVISION_POOL=1
    else
        rc=1
    fi
    [ "$rc" = "0" ] && fleet_audit_finalize_provider_teardown || rc=1
    FLEET_TEARDOWN_OWNERSHIP_DIR="$save_audit"; RUN_ID="$save_run"
    FLEET_OWNER_TOKEN="$save_owner"; ROOT_DIR="$save_root"; RUNS_ROOT="$save_runs"
    OWNED_CLONES_FILE="$save_ids"; OWNED_CLONE_NAMES_FILE="$save_names"
    CENTRAL_HUB_OWNER_FILE="$save_hub"; DASH_BASE="$save_dash"; PROVISION_POOL="$save_provision"
    FLEET_DIR="$save_fleet_dir"
    FLEET_AUDIT_SHARED_ONLY="$save_shared_only"
    FLEET_AUDIT_SHARED_ONLY_REASON="$save_shared_reason"
    return "$rc"
}

registry_record_machine_identity() {  # registry_record_machine_identity <record> <clone-name> <machine-id> <volume-id>
    local record="$1" clone_name="$2" id="$3" volume_id="$4"
    local clones_dir registry root
    case "$clone_name" in cloudbench-[a-zA-Z0-9._-]*) ;; *) return 1 ;; esac
    case "$id" in ''|*[!0-9a-f]*) return 1 ;; esac
    case "$volume_id" in ''|*[!a-zA-Z0-9_-]*) return 1 ;; esac
    root="${FLEET_OWNERSHIP_ROOT%/}"
    clones_dir="${record%/*}"
    registry="${clones_dir%/*}"
    [ "$record" = "$registry/clones/$clone_name" ] \
        && [ "$clones_dir" = "$registry/clones" ] \
        && [ "${registry%/*}" = "$root" ] \
        && [ -d "$root" ] && [ ! -L "$root" ] \
        && [ -d "$registry" ] && [ ! -L "$registry" ] \
        && [ -d "$clones_dir" ] && [ ! -L "$clones_dir" ] \
        && [ -f "$record" ] && [ ! -L "$record" ] || return 1
    # Validate the existing recovery authority before promoting the audit. A
    # name-only or one-field-partial record is repairable; a conflicting value,
    # duplicate key, extra field, symlink, or non-regular inode is not.
    python3 - "$record" "$clone_name" "$id" "$volume_id" <<'PY' || return 1
import os
import stat
import sys

path, clone_name, machine_id, volume_id = sys.argv[1:]
metadata = os.lstat(path)
if not stat.S_ISREG(metadata.st_mode):
    raise SystemExit(1)
fields = {}
with open(path, encoding="utf-8") as handle:
    payload = handle.read(65537)
    if len(payload) > 65536:
        raise SystemExit(1)
    for raw in payload.splitlines():
        key, separator, value = raw.partition("=")
        if not separator or key in fields:
            raise SystemExit(1)
        fields[key] = value
if set(fields) - {"name", "id", "volume_id"} or fields.get("name") != clone_name:
    raise SystemExit(1)
if fields.get("id", machine_id) != machine_id:
    raise SystemExit(1)
if fields.get("volume_id", volume_id) != volume_id:
    raise SystemExit(1)
PY
    # The original owner's shared audit is the WAL. Promote it first; if this
    # process dies before registry publication, audit reconciliation repairs the
    # still-name-only record. The inverse order stranded the first successor on
    # its own unrelated audit context after a post-clone SIGKILL.
    fleet_audit_update_registry_clone "$registry" "$clone_name" "$id" "$volume_id" owned \
        || return 1
    # Deterministic fail-closed crash-window injection for the audit WAL test.
    # Returning here leaves no ambiguous state: recovery must rebuild the still
    # incomplete registry record from the exact original-owner audit.
    if [ "${CLOUDBENCH_TEST_MODE:-0}" = "1" ] \
        && [ "${CLOUDBENCH_TEST_FAIL_IDENTITY_AFTER_AUDIT:-0}" = "1" ]; then
        return 75
    fi
    python3 - "$root" "${registry##*/}" "$clone_name" "$id" "$volume_id" <<'PY'
import os
import stat
import sys

root, owner, clone_name, machine_id, volume_id = sys.argv[1:]
nofollow = getattr(os, "O_NOFOLLOW", 0)
directory = getattr(os, "O_DIRECTORY", 0)
root_fd = os.open(root, os.O_RDONLY | directory | nofollow)
temporary = f".{clone_name}.identity.{os.getpid()}"
try:
    registry_fd = os.open(owner, os.O_RDONLY | directory | nofollow, dir_fd=root_fd)
    try:
        clones_fd = os.open("clones", os.O_RDONLY | directory | nofollow, dir_fd=registry_fd)
        try:
            existing = os.stat(clone_name, dir_fd=clones_fd, follow_symlinks=False)
            if not stat.S_ISREG(existing.st_mode):
                raise SystemExit(1)
            payload = (
                f"name={clone_name}\n"
                f"id={machine_id}\n"
                f"volume_id={volume_id}\n"
            ).encode()
            fd = os.open(
                temporary,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL | nofollow,
                0o644,
                dir_fd=clones_fd,
            )
            try:
                with os.fdopen(fd, "wb", closefd=False) as handle:
                    handle.write(payload)
                    handle.flush()
                    os.fsync(handle.fileno())
            finally:
                os.close(fd)
            os.rename(temporary, clone_name, src_dir_fd=clones_fd, dst_dir_fd=clones_fd)
            os.fsync(clones_fd)
        finally:
            try:
                os.unlink(temporary, dir_fd=clones_fd)
            except FileNotFoundError:
                pass
            os.close(clones_fd)
    finally:
        os.close(registry_fd)
finally:
    os.close(root_fd)
PY
}

fleet_registry_record_id() {  # fleet_registry_record_id <clone-name> <machine-id> <volume-id>
    local clone_name="$1" id="$2" volume_id="$3"
    local record="$FLEET_REGISTRY_DIR/clones/$1"
    [ -f "$record" ] || return 1
    registry_record_machine_identity "$record" "$clone_name" "$id" "$volume_id"
}

fleet_registry_record_volume() {  # fleet_registry_record_volume <clone-name> <volume-id>
    local clone_name="$1" volume_id="$2"
    local record="$FLEET_REGISTRY_DIR/clones/$1" tmp="$FLEET_REGISTRY_DIR/clones/$1.tmp.$$"
    case "$clone_name" in cloudbench-[a-zA-Z0-9._-]*) ;; *) return 1 ;; esac
    case "$volume_id" in ''|*[!a-zA-Z0-9_-]*) return 1 ;; esac
    [ -f "$record" ] || return 1
    [ "$(registry_meta_value "$record" name)" = "$clone_name" ] || return 1
    {
        printf 'name=%s\n' "$clone_name"
        printf 'volume_id=%s\n' "$volume_id"
    } > "$tmp" \
        && mv "$tmp" "$record" \
        && [ "$(registry_meta_value "$record" name)" = "$clone_name" ] \
        && [ "$(registry_meta_value "$record" volume_id)" = "$volume_id" ] \
        && fleet_audit_update_fresh_clone "$clone_name" "" "$volume_id" owned \
        || { rm -f "$tmp"; return 1; }
}

fleet_registry_volume_for_id() {  # fleet_registry_volume_for_id <machine-id>
    local id="$1" record clone_name recorded_id volume_id found=""
    for record in "$FLEET_REGISTRY_DIR"/clones/*; do
        [ -f "$record" ] || continue
        recorded_id="$(registry_meta_value "$record" id)"
        [ "$recorded_id" = "$id" ] || continue
        [ -z "$found" ] || return 1
        clone_name="$(registry_meta_value "$record" name)"
        volume_id="$(registry_meta_value "$record" volume_id)"
        if [ -z "$volume_id" ]; then
            volume_id="$(machine_volume_id "$id")"
            [ -n "$volume_id" ] \
                && registry_record_machine_identity "$record" "$clone_name" "$id" "$volume_id" \
                || return 1
        fi
        found="$volume_id"
    done
    [ -n "$found" ] || return 1
    printf '%s' "$found"
}

fleet_registry_release_id() {  # fleet_registry_release_id <machine-id>
    local id="$1" record recorded_id rc=0
    for record in "$FLEET_REGISTRY_DIR"/clones/*; do
        [ -f "$record" ] || continue
        recorded_id="$(registry_meta_value "$record" id)"
        if [ "$recorded_id" = "$id" ] && ! rm -f "$record"; then
            rc=1
        fi
    done
    return "$rc"
}

fleet_registry_release_exact_clone() {  # <clone-name> <machine-id>; O(1)
    local clone_name="$1" id="$2" record="$FLEET_REGISTRY_DIR/clones/$1"
    case "$clone_name" in
        cloudbench-*) ;;
        *) return 1 ;;
    esac
    case "$clone_name" in *[!a-zA-Z0-9._-]*) return 1 ;; esac
    case "$id" in ''|*[!0-9a-f]*) return 1 ;; esac
    [ -f "$record" ] && [ ! -L "$record" ] \
        && [ "$(registry_meta_value "$record" name)" = "$clone_name" ] \
        && [ "$(registry_meta_value "$record" id)" = "$id" ] \
        || return 1
    rm -f "$record" && [ ! -e "$record" ]
}

fleet_registry_release_name() {  # fleet_registry_release_name <clone-name>
    local clone_name="$1" record="$FLEET_REGISTRY_DIR/clones/$1"
    [ -f "$record" ] || return 0
    [ "$(registry_meta_value "$record" name)" = "$clone_name" ] || return 1
    rm -f "$record"
}

clone_failure_definitively_unallocated() {  # stdin/arg: fly clone stderr
    # Only errors emitted before volume creation prove that the provider owns
    # no resource for this attempt. All later errors retain exact ownership.
    case "$1" in
        *"failed to create volume:"*) return 0 ;;
        *) return 1 ;;
    esac
}

clone_failure_owned_volume_id() {  # <clone-status> <combined-output>; exact ID or empty
    local clone_status="$1" output="$2" volume_id suffix candidate_count error_count timed_out
    # A watchdog timeout is ambiguous even if flyctl emitted this rejection
    # before hanging. Only the provider command's ordinary error exit and one
    # complete rejection line in the normal flyctl progress transcript are
    # sufficient attribution evidence.
    [ "$clone_status" = 1 ] || return 0

    read -r candidate_count error_count timed_out <<EOF
$(printf '%s\n' "$output" | awk '
    index($0, "failed to launch VM: insufficient resources to create new machine with existing volume") { candidates++ }
    /^[[:space:]]*Error:/ { errors++ }
    index(tolower($0), "timed out") { timed_out=1 }
    END { print candidates + 0, errors + 0, timed_out + 0 }
')
EOF
    [ "$candidate_count" = 1 ] && [ "$error_count" = 1 ] && [ "$timed_out" = 0 ] || return 0
    volume_id="$(printf '%s\n' "$output" \
        | sed -nE "s/^[[:space:]]*Error: failed to launch VM: insufficient resources to create new machine with existing volume ['\"](vol_[a-zA-Z0-9]+)['\"]([[:space:]]+\\(Request ID: [a-zA-Z0-9]+(-[a-zA-Z0-9]+)+\\))?[[:space:]]*$/\1/p")"
    # Multiple matching lines are ambiguous, and provider volume IDs have one
    # vol_ prefix followed only by alphanumerics. Anything else is not proof.
    case "$volume_id" in vol_*) suffix="${volume_id#vol_}" ;; *) return 0 ;; esac
    case "$suffix" in ''|*[!a-zA-Z0-9]*) return 0 ;; esac
    printf '%s' "$volume_id"
}

registry_owner_alive() {  # registry_owner_alive <meta-file>; 0=alive, 1=dead, 2=other host/invalid
    local meta="$1" host pid expected_start
    host="$(registry_meta_value "$meta" host)"
    pid="$(registry_meta_value "$meta" pid)"
    expected_start="$(registry_meta_value "$meta" pid_start)"
    [ -n "$host" ] && [ -n "$pid" ] && [ -n "$expected_start" ] || return 2
    [ "$host" = "$FLEET_OWNER_HOST" ] || return 2
    case "$pid" in ''|*[!0-9]*) return 2 ;; esac
    fleet_pid_matches_start "$pid" "$expected_start"
}

available_stopped_pool_machine_count() {  # <provider-machines-json>
    # A stopped pool Machine is already present in provider inventory.  It
    # consumes one physical Machine slot but no active shared CPU, so admission
    # must not add it a second time as a fresh primary.  Count only this
    # workspace's verified, unclaimed, stopped pool entries; reconcile_pool has
    # already recovered stale claims before this function runs.
    [ -z "${PROVISION_POOL:-}" ] || { printf '0'; return 0; }
    [ -s "${POOL_IDS_FILE:-}" ] || { printf '0'; return 0; }
    printf '%s' "$1" \
        | POOL_FILE="$POOL_IDS_FILE" CLAIMS_DIR="${POOL_CLAIMS_DIR:-}" python3 -c '
import json
import os
import re
import sys

try:
    machines = json.load(sys.stdin)
    if not isinstance(machines, list) or any(not isinstance(item, dict) for item in machines):
        raise ValueError("invalid provider inventory")
    states = dict()
    for machine in machines:
        machine_id = machine.get("id")
        if isinstance(machine_id, str) and machine_id:
            states[machine_id] = machine.get("state")
    with open(os.environ["POOL_FILE"], encoding="utf-8") as handle:
        pool_ids = list(dict.fromkeys(line.strip() for line in handle if line.strip()))
    claims_dir = os.environ.get("CLAIMS_DIR", "")
    available = 0
    for machine_id in pool_ids:
        # Keep this byte-for-byte equivalent to the claim_pool_machine shell
        # contract (`case "$id" in *[!0-9a-f]*) continue`).
        if re.fullmatch(r"[0-9a-f]+", machine_id) is None:
            continue
        claimed = bool(claims_dir) and os.path.exists(os.path.join(claims_dir, machine_id))
        if states.get(machine_id) == "stopped" and not claimed:
            available += 1
    print(available)
except (OSError, TypeError, ValueError, json.JSONDecodeError) as exc:
    print(f"pool capacity classification failed: {exc}", file=sys.stderr)
    raise SystemExit(1)
'
}

capacity_reserve_slots() {  # <token> <machines> <shared> <machine-ceiling> <shared-ceiling> <current-machines> <current-shared> <kind>
    # One fcntl transaction prunes reservations whose exact same-host owner is
    # dead, sums every live workstream's pending slots, performs admission, and
    # atomically publishes this owner.  The reservation survives workspace
    # deletion and SIGKILL; the next controller recovers it by PID birth identity.
    local token="$1" machine_slots="$2" shared_units="$3"
    local machine_ceiling="$4" shared_ceiling="$5"
    local current_machines="$6" current_shared="$7" kind="$8"
    local fleet_owner_token="${FLEET_OWNER_TOKEN:-${token%%-*}}"
    local fleet_ownership_root="${FLEET_OWNERSHIP_ROOT:-/nonexistent/cloudbench-fleet-ownership}"
    python3 - "$CAPACITY_RESERVATION_ROOT" "$token" "$APP" \
        "$FLEET_OWNER_HOST" "$$" "$FLEET_OWNER_PID_START" "$RUN_ID" \
        "$fleet_owner_token" "$fleet_ownership_root" \
        "$machine_slots" "$shared_units" "$machine_ceiling" "$shared_ceiling" \
        "$current_machines" "$current_shared" "$kind" <<'PY'
import fcntl
import os
import re
import subprocess
import sys
import tempfile

(root, token, app, host, pid, pid_start, run_id, fleet_owner_token,
 fleet_ownership_root, machine_slots,
 shared_units, machine_ceiling, shared_ceiling, current_machines,
 current_shared, kind) = sys.argv[1:]

def fail(message):
    print("ERROR", message.replace("\n", " "))
    raise SystemExit(2)

if not re.fullmatch(r"[A-Za-z0-9._-]+", token):
    fail("invalid capacity reservation token")
try:
    pid_number = int(pid)
    numeric = [int(value) for value in (
        machine_slots, shared_units, machine_ceiling, shared_ceiling,
        current_machines, current_shared,
    )]
except ValueError:
    fail("non-integer capacity reservation input")
(machine_slots_number, shared_units_number, machine_ceiling_number,
 shared_ceiling_number, current_machines_number, current_shared_number) = numeric
if pid_number < 1 or min(numeric) < 0:
    fail("negative capacity reservation input")
if machine_ceiling_number < 1 or shared_ceiling_number < 1:
    fail("capacity ceilings must be positive")
if not host or not pid_start or "\n" in host or "\n" in pid_start:
    fail("invalid capacity reservation owner identity")
if not re.fullmatch(r"[0-9a-f]{32}", fleet_owner_token):
    fail("invalid capacity reservation fleet owner")

reservations = os.path.join(root, "reservations")
os.makedirs(reservations, exist_ok=True)
lock_path = os.path.join(root, "admission.lock")
with open(lock_path, "a+", encoding="utf-8") as lock_handle:
    fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX)
    reserved_machines = 0
    reserved_shared = 0
    for name in sorted(os.listdir(reservations)):
        if name.startswith("."):
            continue
        path = os.path.join(reservations, name)
        if not os.path.isfile(path) or not re.fullmatch(r"[A-Za-z0-9._-]+", name):
            fail(f"malformed capacity reservation entry: {name}")
        try:
            fields = dict(
                line.rstrip("\n").split("=", 1)
                for line in open(path, encoding="utf-8")
                if "=" in line
            )
            required = ("version", "app", "host", "pid", "pid_start", "run_id",
                        "token", "machine_slots", "shared_units", "kind")
            if any(key not in fields for key in required):
                raise ValueError("missing metadata")
            if fields["version"] != "1" or fields["app"] != app or fields["token"] != name:
                raise ValueError("identity mismatch")
            if fields["host"] != host:
                raise ValueError("reservation belongs to another host")
            owner_pid = int(fields["pid"])
            owner_start = fields["pid_start"]
            record_owner_token = fields.get("fleet_owner_token", "")
            record_machines = int(fields["machine_slots"])
            record_shared = int(fields["shared_units"])
            if owner_pid < 1 or record_machines < 0 or record_shared < 0:
                raise ValueError("invalid numeric metadata")
            if record_owner_token and (
                re.fullmatch(r"[0-9a-f]{32}", record_owner_token) is None
                or not name.startswith(f"{record_owner_token}-")
            ):
                raise ValueError("invalid fleet owner linkage")
        except (OSError, TypeError, ValueError) as exc:
            fail(f"malformed capacity reservation {name}: {exc}")
        if owner_start.startswith("proc-start:"):
            try:
                with open("/proc/sys/kernel/random/boot_id", encoding="utf-8") as handle:
                    boot_id = handle.read().strip()
                with open(f"/proc/{owner_pid}/stat", encoding="utf-8", errors="replace") as handle:
                    stat = handle.read()
                stat_fields = stat[stat.rfind(")") + 2 :].split()
                actual_start = (
                    f"proc-start:{boot_id}:{stat_fields[19]}"
                    if boot_id and len(stat_fields) > 19 else ""
                )
            except OSError:
                actual_start = ""
            owner_live = bool(actual_start) and actual_start == owner_start
        else:
            probe = subprocess.run(
                ["ps", "-p", str(owner_pid), "-o", "lstart="],
                text=True,
                capture_output=True,
                check=False,
            )
            actual_start = probe.stdout.strip()
            owner_live = probe.returncode == 0 and bool(actual_start) and actual_start == owner_start
        if not owner_live:
            cleanup_unconfirmed = bool(record_owner_token) and os.path.exists(
                os.path.join(
                    fleet_ownership_root,
                    record_owner_token,
                    "guest-cleanup-unconfirmed",
                )
            )
            if not cleanup_unconfirmed:
                os.unlink(path)
                continue
        if name == token:
            if owner_pid != pid_number or owner_start != pid_start:
                fail(f"capacity reservation token collision: {name}")
            continue
        reserved_machines += record_machines
        reserved_shared += record_shared

    projected_machines = current_machines_number + reserved_machines + machine_slots_number
    projected_shared = current_shared_number + reserved_shared + shared_units_number
    if projected_machines > machine_ceiling_number:
        print("DENY_MACHINE", reserved_machines, reserved_shared,
              projected_machines, projected_shared)
        raise SystemExit(1)
    if projected_shared > shared_ceiling_number:
        print("DENY_SHARED", reserved_machines, reserved_shared,
              projected_machines, projected_shared)
        raise SystemExit(1)

    destination = os.path.join(reservations, token)
    fd, temporary = tempfile.mkstemp(prefix=f".{token}.", dir=reservations, text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write("version=1\n")
            handle.write(f"app={app}\n")
            handle.write(f"host={host}\n")
            handle.write(f"pid={pid_number}\n")
            handle.write(f"pid_start={pid_start}\n")
            handle.write(f"run_id={run_id}\n")
            handle.write(f"token={token}\n")
            handle.write(f"fleet_owner_token={fleet_owner_token}\n")
            handle.write(f"machine_slots={machine_slots_number}\n")
            handle.write(f"shared_units={shared_units_number}\n")
            handle.write(f"kind={kind}\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, destination)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    print("OK", reserved_machines, reserved_shared, projected_machines, projected_shared)
PY
}

capacity_release_reservation() {  # <token>
    local token="$1"
    python3 - "$CAPACITY_RESERVATION_ROOT" "$token" "$APP" \
        "$FLEET_OWNER_HOST" "$$" "$FLEET_OWNER_PID_START" <<'PY'
import fcntl
import os
import re
import sys

root, token, app, host, pid, pid_start = sys.argv[1:]
if not re.fullmatch(r"[A-Za-z0-9._-]+", token):
    raise SystemExit(1)
reservations = os.path.join(root, "reservations")
if not os.path.isdir(reservations):
    raise SystemExit(0)
with open(os.path.join(root, "admission.lock"), "a+", encoding="utf-8") as lock_handle:
    fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX)
    path = os.path.join(reservations, token)
    if not os.path.exists(path):
        raise SystemExit(0)
    try:
        fields = dict(
            line.rstrip("\n").split("=", 1)
            for line in open(path, encoding="utf-8")
            if "=" in line
        )
    except OSError:
        raise SystemExit(1)
    expected = (fields.get("version") == "1" and fields.get("app") == app
                and fields.get("host") == host and fields.get("pid") == pid
                and fields.get("pid_start") == pid_start and fields.get("token") == token)
    if not expected:
        raise SystemExit(1)
    os.unlink(path)
PY
}

capacity_release_owner_reservations() {
    # Normal teardown also sweeps an interrupted autoscaler child reservation.
    # Remove only records carrying this controller's exact PID birth identity.
    python3 - "$CAPACITY_RESERVATION_ROOT" "$APP" "$FLEET_OWNER_HOST" \
        "$$" "$FLEET_OWNER_PID_START" "$FLEET_OWNER_TOKEN-" <<'PY'
import fcntl
import os
import sys

root, app, host, pid, pid_start, prefix = sys.argv[1:]
reservations = os.path.join(root, "reservations")
if not os.path.isdir(reservations):
    raise SystemExit(0)
with open(os.path.join(root, "admission.lock"), "a+", encoding="utf-8") as lock_handle:
    fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX)
    for name in os.listdir(reservations):
        if not name.startswith(prefix):
            continue
        path = os.path.join(reservations, name)
        try:
            fields = dict(
                line.rstrip("\n").split("=", 1)
                for line in open(path, encoding="utf-8")
                if "=" in line
            )
        except OSError:
            raise SystemExit(1)
        expected = (fields.get("version") == "1" and fields.get("app") == app
                    and fields.get("host") == host and fields.get("pid") == pid
                    and fields.get("pid_start") == pid_start and fields.get("token") == name)
        if not expected:
            raise SystemExit(1)
        os.unlink(path)
PY
}

capacity_release_stale_owner_reservations() {  # <owner-meta> <token-prefix>
    local meta="$1" token_prefix="$2"
    local target_pid target_pid_start target_host
    target_pid="$(registry_meta_value "$meta" pid)"
    target_pid_start="$(registry_meta_value "$meta" pid_start)"
    target_host="$(registry_meta_value "$meta" host)"
    python3 - "$CAPACITY_RESERVATION_ROOT" "$APP" "$target_host" \
        "$target_pid" "$target_pid_start" "$token_prefix" <<'PY'
import fcntl
import os
import sys

root, app, host, pid, pid_start, prefix = sys.argv[1:]
reservations = os.path.join(root, "reservations")
if not os.path.isdir(reservations):
    raise SystemExit(0)
with open(os.path.join(root, "admission.lock"), "a+", encoding="utf-8") as lock_handle:
    fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX)
    for name in os.listdir(reservations):
        if not name.startswith(prefix):
            continue
        path = os.path.join(reservations, name)
        try:
            fields = dict(
                line.rstrip("\n").split("=", 1)
                for line in open(path, encoding="utf-8")
                if "=" in line
            )
        except OSError:
            raise SystemExit(1)
        expected = (
            fields.get("version") == "1"
            and fields.get("app") == app
            and fields.get("host") == host
            and fields.get("pid") == pid
            and fields.get("pid_start") == pid_start
            and fields.get("token") == name
        )
        if not expected:
            raise SystemExit(1)
        os.unlink(path)
PY
}

registry_resolve_name() {  # registry_resolve_name <clone-name>; 0=found, 1=absent, 2=unsafe read
    local clone_name="$1" deadline result status
    deadline=$((SECONDS + ${CLOUDBENCH_CLONE_LOOKUP_SECONDS:-10}))
    while :; do
        result="$(FLY machines list -a "$APP" --json 2>/dev/null \
            | TARGET_NAME="$clone_name" python3 -c '
import json, os, sys
try:
    machines = json.load(sys.stdin)
except (TypeError, ValueError):
    raise SystemExit(2)
if not isinstance(machines, list) or any(not isinstance(machine, dict) for machine in machines):
    raise SystemExit(2)
matches = [machine.get("id") for machine in machines
           if machine.get("name") == os.environ["TARGET_NAME"] and machine.get("id")]
if len(matches) == 1:
    print(matches[0])
elif not matches:
    raise SystemExit(1)
else:
    raise SystemExit(2)
' 2>/dev/null)"
        status=$?
        [ "$status" -eq 0 ] && { printf '%s' "$result"; return 0; }
        [ "$status" -eq 2 ] && return 2
        [ "$SECONDS" -ge "$deadline" ] && return 1
        sleep 1
    done
}

registry_machine_details() {  # registry_machine_details <id>; 0="state name", 1=absent, 2=unsafe read
    local id="$1"
    FLY machines list -a "$APP" --json 2>/dev/null | MACHINE_ID="$id" python3 -c '
import json, os, sys
try:
    machines = json.load(sys.stdin)
except (TypeError, ValueError):
    raise SystemExit(2)
if not isinstance(machines, list) or any(not isinstance(machine, dict) for machine in machines):
    raise SystemExit(2)
matches = [machine for machine in machines if machine.get("id") == os.environ["MACHINE_ID"]]
if not matches:
    raise SystemExit(1)
if len(matches) != 1:
    raise SystemExit(2)
state = matches[0].get("state")
name = matches[0].get("name")
if not isinstance(state, str) or not state or not isinstance(name, str) or not name:
    raise SystemExit(2)
print(state, name)
'
}

registry_runner_count() {  # registry_runner_count <started-machine-id>; exact integer or non-zero
    local id="$1" output count remote_command escaped_command
    # flyctl executes the -C payload directly rather than through a shell. The
    # owner probe uses an assignment, command substitution, a pipeline, and a
    # printf, so make the interpreter boundary explicit and pass one safely
    # escaped script argument to bash -c.
    remote_command="CLOUDBENCH_OWNER_PROBE=1; n=\$(pgrep -f '/data/[c]loudbench-run.sh|/tmp/[r]b.sh|benchmarks/[r]un_benchmark.py|scripts/[r]un.sh --benchmark|/tmp/[r]bw.sh|/data/[c]loudbench-worker.sh|agents/[w]orker.py' 2>/dev/null | wc -l | tr -d ' '); printf 'CLOUDBENCH_RUNNER_COUNT=%s\\n' \"\$n\""
    printf -v escaped_command '%q' "$remote_command"
    output="$(FLY ssh console -a "$APP" --machine "$id" -q -C \
        "bash -c $escaped_command" 2>/dev/null)" || return 1
    count="$(printf '%s\n' "$output" | sed -n 's/^CLOUDBENCH_RUNNER_COUNT=//p' | tail -1)"
    case "$count" in ''|*[!0-9]*) return 1 ;; esac
    printf '%s' "$count"
}

registry_record_is_stale_phantom() {  # <record-file>; 0 = absent long enough to be a confirmed phantom
    # A name-only clone record that is STILL absent from Fly is either a real
    # clone lagging provider visibility (seconds–minutes) or a request that never
    # materialized (a permanent phantom). Only elapsed time tells them apart, so a
    # record is a confirmed phantom only once it has outlived any plausible
    # visibility gap. Default TTL (900s) is far beyond CLOUDBENCH_CLONE_LOOKUP_SECONDS
    # (20s) + Fly list eventual-consistency, so a lagging clone is never discarded.
    local record="$1" ttl now mt
    ttl="${CLOUDBENCH_PHANTOM_RECORD_TTL_SECONDS:-900}"
    case "$ttl" in ''|*[!0-9]*) ttl=900 ;; esac
    now="$(date +%s)"
    mt="$(stat -c %Y "$record" 2>/dev/null || stat -f %m "$record" 2>/dev/null || echo "$now")"
    [ $(( now - mt )) -ge "$ttl" ]
}

registry_record_is_stale_pre_volume_id() {  # <record-file>; 0 = old enough for provider absence proof
    # Exact volume attribution was added after the first durable ownership
    # registry format shipped. A dead controller can therefore leave a record
    # with name+machine ID but no volume ID. If teardown already removed both,
    # retaining that record forever blocks every successor fleet.
    #
    # Do not trust a fresh provider absence: a clone and its forked volume can
    # still be crossing Fly's visibility boundary. The default is much longer
    # than the exact lookup deadline.
    local record="$1" ttl now mt
    ttl="${CLOUDBENCH_LEGACY_VOLUME_RECORD_TTL_SECONDS:-3600}"
    case "$ttl" in ''|*[!0-9]*) ttl=3600 ;; esac
    now="$(date +%s)"
    mt="$(stat -c %Y "$record" 2>/dev/null || stat -f %m "$record" 2>/dev/null || echo "$now")"
    [ $(( now - mt )) -ge "$ttl" ]
}

registry_retire_absent_stale_pre_volume_records() {  # <registry-dir>
    local registry="$1" record clone_name id volume_id candidate=0 ttl confirm_seconds
    local volumes_first machines_first volumes_second machines_second retired proof_status
    for record in "$registry"/clones/*; do
        [ -f "$record" ] || continue
        id="$(registry_meta_value "$record" id)"
        volume_id="$(registry_meta_value "$record" volume_id)"
        if [ -n "$id" ] && [ -z "$volume_id" ] \
            && registry_record_is_stale_pre_volume_id "$record"; then
            candidate=1
            break
        fi
    done
    [ "$candidate" = "1" ] || return 0

    # Read volumes before machines in each sample. If a machine disappears
    # during the pair, a still-attached volume then points at an absent machine
    # and blocks retirement. Reading in the opposite order could incorrectly
    # treat that detach-propagation window as a healthy live neighbor.
    volumes_first="$(FLY volumes list -a "$APP" --json 2>/dev/null)" || return 2
    machines_first="$(FLY machines list -a "$APP" --json 2>/dev/null)" || return 2
    confirm_seconds="${CLOUDBENCH_LEGACY_ABSENCE_CONFIRM_SECONDS:-5}"
    case "$confirm_seconds" in ''|*[!0-9]*) confirm_seconds=5 ;; esac
    [ "$confirm_seconds" -gt 0 ] && sleep "$confirm_seconds"
    volumes_second="$(FLY volumes list -a "$APP" --json 2>/dev/null)" || return 2
    machines_second="$(FLY machines list -a "$APP" --json 2>/dev/null)" || return 2
    ttl="${CLOUDBENCH_LEGACY_VOLUME_RECORD_TTL_SECONDS:-3600}"
    case "$ttl" in ''|*[!0-9]*) ttl=3600 ;; esac

    retired="$(
        python3 - "$registry" "$VOLUME_NAME" "${WARM_VOLUME_ID:-}" "$ttl" \
            3< <(printf '%s' "$volumes_first") \
            4< <(printf '%s' "$machines_first") \
            5< <(printf '%s' "$volumes_second") \
            6< <(printf '%s' "$machines_second") <<'PY'
import json
import os
import re
import sys
import time

registry, volume_name, warm_volume_id, ttl_raw = sys.argv[1:]
ttl = int(ttl_raw)


def load_list(fd):
    try:
        value = json.load(os.fdopen(fd, encoding="utf-8"))
    except (OSError, TypeError, ValueError):
        raise SystemExit(2)
    if not isinstance(value, list) or any(not isinstance(item, dict) for item in value):
        raise SystemExit(2)
    return value


def machine_identity(items):
    ids = set()
    names = set()
    for item in items:
        machine_id = item.get("id")
        name = item.get("name")
        if not isinstance(machine_id, str) or not machine_id:
            raise SystemExit(2)
        if not isinstance(name, str) or not name:
            raise SystemExit(2)
        ids.add(machine_id)
        names.add(name)
    return ids, names


def unsafe_clone_volume_exists(items, live_machine_ids):
    for item in items:
        volume_id = item.get("id")
        name = item.get("name")
        attached = item.get("attached_machine_id")
        if not isinstance(volume_id, str) or not volume_id:
            raise SystemExit(2)
        if not isinstance(name, str) or not name:
            raise SystemExit(2)
        if attached is not None and not isinstance(attached, str):
            raise SystemExit(2)
        if name != volume_name or volume_id == warm_volume_id:
            continue
        if not attached or attached not in live_machine_ids:
            return True
    return False


volumes_first = load_list(3)
machines_first = load_list(4)
volumes_second = load_list(5)
machines_second = load_list(6)
machine_ids_first, machine_names_first = machine_identity(machines_first)
machine_ids_second, machine_names_second = machine_identity(machines_second)
if unsafe_clone_volume_exists(volumes_first, machine_ids_first):
    raise SystemExit(3)
if unsafe_clone_volume_exists(volumes_second, machine_ids_second):
    raise SystemExit(3)

now = time.time()
for entry in sorted(os.scandir(os.path.join(registry, "clones")), key=lambda item: item.name):
    if not entry.is_file(follow_symlinks=False):
        continue
    try:
        fields = {}
        with open(entry.path, encoding="utf-8") as handle:
            for raw in handle:
                key, separator, value = raw.rstrip("\n").partition("=")
                if separator and key not in fields:
                    fields[key] = value
        clone_name = fields.get("name", "")
        machine_id = fields.get("id", "")
        volume_id = fields.get("volume_id", "")
        age = now - entry.stat(follow_symlinks=False).st_mtime
    except OSError:
        raise SystemExit(2)
    if volume_id or age < ttl:
        continue
    if not re.fullmatch(r"cloudbench-[A-Za-z0-9._-]+", clone_name):
        continue
    if not re.fullmatch(r"[0-9a-f]+", machine_id):
        continue
    if machine_id in machine_ids_first or machine_id in machine_ids_second:
        continue
    if clone_name in machine_names_first or clone_name in machine_names_second:
        continue
    try:
        os.unlink(entry.path)
    except OSError:
        raise SystemExit(2)
    print(clone_name)
PY
    )"
    proof_status=$?
    [ "$proof_status" -eq 3 ] && return 3
    [ "$proof_status" -eq 0 ] || return 2
    while IFS= read -r clone_name; do
        [ -n "$clone_name" ] || continue
        echo "🧹 retiring stale pre-volume-ID clone record '$clone_name' (two provider samples prove machine/name and orphan volume absent)"
    done <<< "$retired"
}

recover_registry_audit_only_fresh() {  # <v2-registry>; repair audit-before-registry crash window
    local registry="$1" owner="${1##*/}" meta="$1/meta" audit expected fresh
    local clone_name source_id disposition id volume_id resolved record
    [ "$(registry_meta_value "$meta" version)" = "2" ] || return 0
    case "$owner" in ''|*[!0-9a-f]*) return 1 ;; esac
    [ "${#owner}" -eq 32 ] || return 1
    audit="$(registry_meta_value "$meta" audit_dir)"
    [ "$audit" = "$FLEET_AUDIT_ROOT/$owner" ] \
        && [ ! -L "$audit" ] && [ -d "$audit/expected-fresh" ] \
        && [ ! -L "$audit/expected-fresh" ] && [ -d "$audit/fresh" ] \
        && [ ! -L "$audit/fresh" ] \
        && [ "$(registry_meta_value "$audit/meta" fleet_owner_token)" = "$owner" ] \
        && [ "$(registry_meta_value "$audit/meta" app)" = "$APP" ] || return 1
    for expected in "$audit"/expected-fresh/*; do
        [ -f "$expected" ] && [ ! -L "$expected" ] || continue
        clone_name="${expected##*/}"
        case "$clone_name" in cloudbench-*) ;; *) return 1 ;; esac
        case "$clone_name" in *[!a-zA-Z0-9._-]*) return 1 ;; esac
        [ "$(registry_meta_value "$expected" clone_name)" = "$clone_name" ] || return 1
        source_id="$(registry_meta_value "$expected" source_machine_id)"
        case "$source_id" in ''|*[!0-9a-f]*) return 1 ;; esac
        fresh="$audit/fresh/$clone_name"
        [ -f "$fresh" ] && [ ! -L "$fresh" ] \
            && [ "$(registry_meta_value "$fresh" fleet_owner_token)" = "$owner" ] \
            && [ "$(registry_meta_value "$fresh" clone_name)" = "$clone_name" ] \
            && [ "$(registry_meta_value "$fresh" source_machine_id)" = "$source_id" ] \
            || return 1
        disposition="$(registry_meta_value "$fresh" disposition)"
        case "$disposition" in
            destroyed-verified-absent|not-allocated-verified|transferred-to-pool-stopped)
                continue
                ;;
            transfer-pending-stopped)
                # Pool handoff publishes this audit transition before releasing
                # its exact fresh-clone registry record and publishes the final
                # handoff after that unlink. Crashes on either side of the unlink
                # must flow to recover_exact_pool_claims; neither an existing
                # regular record nor its absence is an identity gap to repair.
                # A substituted special inode remains malformed authority.
                if [ -e "$registry/clones/$clone_name" ] \
                    || [ -L "$registry/clones/$clone_name" ]; then
                    [ -f "$registry/clones/$clone_name" ] \
                        && [ ! -L "$registry/clones/$clone_name" ] || return 1
                fi
                continue
                ;;
            owned)
                id="$(registry_meta_value "$fresh" machine_id)"
                volume_id="$(registry_meta_value "$fresh" volume_id)"
                ;;
            ownership-pending)
                resolved="$(registry_resolve_name "$clone_name")"
                case $? in
                    0)
                        id="$resolved"
                        volume_id="$(machine_volume_id "$id")"
                        [ -n "$volume_id" ] || return 1
                        ;;
                    1)
                        if registry_record_is_stale_phantom "$fresh"; then
                            fleet_audit_update_registry_clone "$registry" "$clone_name" "" "" \
                                not-allocated-verified || return 1
                            echo "🧹 terminalized audit-only phantom '$clone_name' after authoritative absence"
                            continue
                        fi
                        echo "❌ audit-only clone '$clone_name' is not provider-visible yet; retaining recovery authority" >&2
                        return 1
                        ;;
                    *) return 1 ;;
                esac
                ;;
            *) return 1 ;;
        esac
        case "$id" in ''|*[!0-9a-f]*) return 1 ;; esac
        case "$volume_id" in ''|*[!a-zA-Z0-9_-]*) return 1 ;; esac
        record="$registry/clones/$clone_name"
        if [ ! -e "$record" ] && [ ! -L "$record" ]; then
            # The shared audit is already exact ownership authority. Publish a
            # name-only recovery record first, then use the same audit-first
            # identity transaction as every other path. Any interruption remains
            # retryable from the owned audit without guessing provider identity.
            fleet_audit_update_registry_clone \
                "$registry" "$clone_name" "$id" "$volume_id" owned || return 1
            python3 - "$FLEET_OWNERSHIP_ROOT" "$owner" "$clone_name" <<'PY' || return 1
import os
import sys

root, owner, clone_name = sys.argv[1:]
nofollow = getattr(os, "O_NOFOLLOW", 0)
directory = getattr(os, "O_DIRECTORY", 0)
root_fd = os.open(root, os.O_RDONLY | directory | nofollow)
try:
    registry_fd = os.open(owner, os.O_RDONLY | directory | nofollow, dir_fd=root_fd)
    try:
        clones_fd = os.open("clones", os.O_RDONLY | directory | nofollow, dir_fd=registry_fd)
        try:
            fd = os.open(
                clone_name,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL | nofollow,
                0o644,
                dir_fd=clones_fd,
            )
            try:
                with os.fdopen(fd, "wb", closefd=False) as handle:
                    handle.write(f"name={clone_name}\n".encode())
                    handle.flush()
                    os.fsync(handle.fileno())
            finally:
                os.close(fd)
            os.fsync(clones_fd)
        finally:
            os.close(clones_fd)
    finally:
        os.close(registry_fd)
finally:
    os.close(root_fd)
PY
        fi
        [ -f "$record" ] && [ ! -L "$record" ] || return 1
        registry_record_machine_identity "$record" "$clone_name" "$id" "$volume_id" \
            || return 1
        echo "🧭 recovered audit-only clone ownership $id (name=$clone_name)"
    done
}

reap_registry_clones() {  # reap_registry_clones <registry-dir> <current|stale|forced>
    local registry="${1%/}" root="${FLEET_OWNERSHIP_ROOT%/}" mode="$2"
    local record clone_name id volume_id resolved details detail_status state
    local actual_name runner_count unresolved=0
    local legacy_batch_status=0 registry_version
    [ "$registry" != "$root" ] \
        && [ "${registry%/*}" = "$root" ] \
        || { echo "❌ refusing non-child fleet registry cleanup path: $registry" >&2; return 1; }
    if [ -e "$registry/guest-cleanup-unconfirmed" ]; then
        echo "❌ refusing to destroy fleet machines whose guest cleanup is unconfirmed: $registry" >&2
        return 1
    fi
    [ -d "$registry/clones" ] || return 0
    registry_version="$(registry_meta_value "$registry/meta" version)"
    if [ "$mode" = "stale" ] && [ "$registry_version" != "2" ]; then
        if registry_retire_absent_stale_pre_volume_records "$registry"; then
            legacy_batch_status=0
        else
            legacy_batch_status=$?
        fi
        if [ "$legacy_batch_status" -ne 0 ] && [ "$legacy_batch_status" -ne 3 ]; then
            echo "❌ could not establish a safe batched pre-volume-ID absence proof; refusing to provision" >&2
            return 1
        fi
    fi
    for record in "$registry"/clones/*; do
        [ -f "$record" ] || continue
        clone_name="$(registry_meta_value "$record" name)"
        id="$(registry_meta_value "$record" id)"
        volume_id="$(registry_meta_value "$record" volume_id)"
        [ -n "$clone_name" ] || { echo "❌ malformed fleet clone ownership record: $record" >&2; return 1; }
        case "$volume_id" in *[!a-zA-Z0-9_-]*) echo "❌ malformed fleet volume ownership record: $record" >&2; return 1 ;; esac
        if [ -z "$id" ]; then
            resolved="$(registry_resolve_name "$clone_name")"
            case $? in
                0)
                    id="$resolved"
                    ;;
                1)
                    if [ -n "$volume_id" ]; then
                        # A failed clone can create a volume without a Machine.
                        # Its provider-returned ID in this exact-owner record is
                        # sufficient cleanup authority; global inventory is not.
                        echo "🧹 reaping fleet-owned volume $volume_id (name=$clone_name; no machine allocated)"
                        reap_volume "$volume_id" || return 1
                        fleet_audit_update_registry_clone "$registry" "$clone_name" "" "$volume_id" \
                            destroyed-verified-absent || return 1
                        rm -f "$record"
                        continue
                    fi
                    # A successful Fly clone request may become list-visible only
                    # after our lookup deadline. For the CURRENT (live-owner)
                    # registry the name-only ledger is the sole durable ownership
                    # proof during that gap, so keep it and fail closed — a
                    # late-visible clone must not be orphaned while a successor
                    # provisions another fleet.
                    #
                    # For a STALE registry the owner is already PROVEN DEAD
                    # (registry_owner_alive returned dead before we got here). Such
                    # a name-only record is retained fail-closed while it is still
                    # young enough to be a real clone lagging provider visibility
                    # (Scenario 7) — orphaning that would leak a paid machine. But
                    # once it has been absent far longer than any visibility gap it
                    # is a confirmed phantom whose request never materialized, and
                    # keeping it permanently blocks EVERY future run on this host
                    # (observed: a finished neighbor fleet's dead-owner registry
                    # with a ~45-min-old phantom aborted all provisioning, run after
                    # run). Discard only the aged-out phantom; a fresh gap or an
                    # unsafe read (resolve==2, the '*' arm) still fails closed.
                    if [ "$mode" = "stale" ] && registry_record_is_stale_phantom "$record"; then
                        echo "🧹 discarding aged-out phantom name-only clone '$clone_name' (absent from Fly > ${CLOUDBENCH_PHANTOM_RECORD_TTL_SECONDS:-900}s; owner proven dead)"
                        fleet_audit_update_registry_clone "$registry" "$clone_name" "" "" \
                            not-allocated-verified || return 1
                        rm -f "$record"
                        continue
                    fi
                    echo "❌ owned clone name '$clone_name' is not provider-visible yet; retaining ownership and refusing to provision" >&2
                    # This record must keep the overall cleanup fail-closed, but
                    # it is independent of later records whose exact machine IDs
                    # are already proven. Returning here leaked every known clone
                    # sorted after one young name-only record. Retain this record,
                    # continue reaping those known IDs, then report failure.
                    unresolved=1
                    continue
                    ;;
                *) echo "❌ ambiguous/unreadable stale clone name '$clone_name'; refusing to provision" >&2; return 1 ;;
            esac
        fi
        case "$id" in ''|*[!0-9a-f]*) echo "❌ malformed fleet machine ownership record: $record" >&2; return 1 ;; esac
        if [ -n "${WARM_ID:-}" ] && [ "$id" = "$WARM_ID" ]; then
            echo "❌ ownership registry points at warm source machine $id; refusing cleanup" >&2
            return 1
        fi
        if [ "$legacy_batch_status" -eq 3 ] && [ -z "$volume_id" ] \
            && registry_record_is_stale_pre_volume_id "$record"; then
            echo "❌ stale pre-volume-ID record '$clone_name' remains unresolved because a clone volume is unattached or points at an absent machine" >&2
            unresolved=1
            continue
        fi
        details="$(registry_machine_details "$id")"
        detail_status=$?
        if [ "$detail_status" -eq 1 ]; then
            if [ -z "$volume_id" ]; then
                echo "❌ owned fleet machine $id disappeared before exact volume ownership was durable; retaining record" >&2
                unresolved=1
                continue
            fi
            reap_volume "$volume_id" || return 1
            fleet_audit_update_registry_clone "$registry" "$clone_name" "$id" "$volume_id" \
                destroyed-verified-absent || return 1
            rm -f "$record"
            continue
        fi
        [ "$detail_status" -eq 0 ] || { echo "❌ could not verify owned fleet machine $id; refusing to provision" >&2; return 1; }
        state="$(printf '%s' "$details" | awk '{print $1}')"
        actual_name="$(printf '%s' "$details" | awk '{print $2}')"
        if [ "$actual_name" != "$clone_name" ]; then
            echo "❌ machine identity mismatch for $id ($actual_name != $clone_name); refusing cleanup" >&2
            return 1
        fi
        if [ -z "$volume_id" ]; then
            volume_id="$(machine_volume_id "$id")"
            if [ -z "$volume_id" ] \
                || ! registry_record_machine_identity "$record" "$clone_name" "$id" "$volume_id"; then
                echo "❌ owned fleet machine $id has no durable exact volume attribution; retaining record" >&2
                unresolved=1
                continue
            fi
        fi
        if [ "$mode" = "stale" ]; then
            case "$state" in
                stopped) : ;;
                started)
                    runner_count="$(registry_runner_count "$id")" || {
                        echo "❌ refusing to reap stale fleet machine $id: runner probe unreadable" >&2
                        return 1
                    }
                    if [ "$runner_count" != "0" ]; then
                        echo "❌ refusing to reap stale fleet machine $id: runner count=$runner_count" >&2
                        return 1
                    fi
                    ;;
                *)
                    echo "❌ refusing to reap stale fleet machine $id in transitional/unknown state '$state'" >&2
                    return 1
                    ;;
            esac
            echo "🧹 reaping stale fleet machine $id (name=$clone_name, state=$state, dead owner proven)"
        else
            echo "🧹 destroying fleet-owned clone $id (name=$clone_name)"
        fi
        reap_machine "$id" "" "$volume_id" || return 1
        # Machine inventory can disappear before its volume destroy becomes
        # visible. The durable per-owner volume ID is the exact retry authority;
        # never fall back to an app-global unattached-volume sweep.
        reap_volume "$volume_id" || return 1
        fleet_audit_update_registry_clone "$registry" "$clone_name" "$id" "$volume_id" \
            destroyed-verified-absent || return 1
        rm -f "$record"
    done
    [ "$unresolved" = "0" ]
}

fleet_registry_remove_if_empty() {  # fleet_registry_remove_if_empty <registry-dir>
    local registry="${1%/}" root="${FLEET_OWNERSHIP_ROOT%/}" record
    [ "$registry" != "$root" ] \
        && [ "${registry%/*}" = "$root" ] \
        || { echo "❌ refusing to remove non-child fleet registry path: $registry" >&2; return 1; }
    [ -d "$registry/clones" ] || { rm -rf "$registry"; return 0; }
    for record in "$registry"/clones/*; do
        [ -f "$record" ] && return 0
    done
    rm -rf "$registry"
}

acquire_registry_recovery_lock() {  # acquire_registry_recovery_lock <registry-dir>
    local registry="$1" lock="$1/recovery-lock" tmp
    for _ in $(seq 1 30); do
        [ -d "$registry" ] || return 2
        if mkdir "$lock" 2>/dev/null; then
            tmp="$lock/meta.tmp.$$"
            {
                printf 'host=%s\n' "$FLEET_OWNER_HOST"
                printf 'pid=%s\n' "$$"
                printf 'pid_start=%s\n' "$FLEET_OWNER_PID_START"
            } > "$tmp" && mv "$tmp" "$lock/meta" && return 0
            # Metadata write/rename failed after mkdir — tear the partial lock
            # down so we (or a waiter) can retry instead of spinning on a lock
            # dir with no provable owner.
            rm -rf "$lock"
        fi
        if [ -f "$lock/meta" ]; then
            registry_owner_alive "$lock/meta"
            case $? in
                0) sleep 1; continue ;;
                1) rm -rf "$lock"; continue ;;
                *) echo "❌ cannot prove stale recovery lock ownership for $registry" >&2; return 1 ;;
            esac
        fi
        sleep 1
    done
    echo "❌ timed out waiting for stale fleet recovery lock: $registry" >&2
    return 1
}

reserve_cleanup_disk_space() {
    # The controller can run for hours while sibling workspaces generate coverage,
    # dependencies, and trace archives. Keep one physically allocated local file
    # that teardown releases before invoking asdf/flyctl, so a mid-run ENOSPC does
    # not strand paid machines merely because those CLIs need shell temporaries.
    #
    # The reserve itself must not consume the controller's last usable space:
    # snapshot verification, patch construction, Fly's config lock, and status
    # publication all need small local writes before cleanup. Scale the requested
    # reserve down on a constrained host while preserving both an unreserved
    # operating headroom and a physically allocated cleanup floor. If both cannot
    # fit, fail before the first provider mutation.
    local reserve_mb="${CLOUDBENCH_CLEANUP_DISK_RESERVE_MB:-512}"
    local headroom_mb="${CLOUDBENCH_CONTROLLER_DISK_HEADROOM_MB:-256}"
    local minimum_mb="${CLOUDBENCH_MIN_CLEANUP_DISK_RESERVE_MB:-32}"
    local available_kb available_mb maximum_reserve_mb allocated_mb remaining_kb remaining_mb
    case "$reserve_mb" in ''|*[!0-9]*) return 1 ;; esac
    case "$headroom_mb" in ''|*[!0-9]*) return 1 ;; esac
    case "$minimum_mb" in ''|*[!0-9]*|0) return 1 ;; esac
    [ "$reserve_mb" -ge 1 ] && [ "$reserve_mb" -le 4096 ] || return 1
    [ "$headroom_mb" -le 16384 ] || return 1
    [ "$minimum_mb" -le 4096 ] || return 1
    [ "$minimum_mb" -le "$reserve_mb" ] || minimum_mb="$reserve_mb"

    available_kb="$(df -Pk "$(dirname "$CLEANUP_DISK_RESERVE_FILE")" 2>/dev/null \
        | awk 'END { print $4 }')" || return 1
    case "$available_kb" in ''|*[!0-9]*) return 1 ;; esac
    available_mb=$((available_kb / 1024))
    maximum_reserve_mb=$((available_mb - headroom_mb))
    [ "$maximum_reserve_mb" -ge "$minimum_mb" ] || return 1
    allocated_mb="$reserve_mb"
    [ "$allocated_mb" -le "$maximum_reserve_mb" ] \
        || allocated_mb="$maximum_reserve_mb"

    rm -f "$CLEANUP_DISK_RESERVE_FILE" 2>/dev/null || return 1
    if ! dd if=/dev/zero of="$CLEANUP_DISK_RESERVE_FILE" \
        bs=1048576 count="$allocated_mb" conv=fsync >/dev/null 2>&1; then
        rm -f "$CLEANUP_DISK_RESERVE_FILE" 2>/dev/null || true
        return 1
    fi
    # A sibling controller or unrelated process can allocate between the
    # inventory read and this fsync. Validate the actual post-allocation floor;
    # on a race, release our exact file and fail before provider mutation.
    remaining_kb="$(df -Pk "$(dirname "$CLEANUP_DISK_RESERVE_FILE")" 2>/dev/null \
        | awk 'END { print $4 }')" || {
        rm -f "$CLEANUP_DISK_RESERVE_FILE" 2>/dev/null || true
        return 1
    }
    case "$remaining_kb" in
        ''|*[!0-9]*)
            rm -f "$CLEANUP_DISK_RESERVE_FILE" 2>/dev/null || true
            return 1
            ;;
    esac
    remaining_mb=$((remaining_kb / 1024))
    if [ "$remaining_mb" -lt "$headroom_mb" ]; then
        rm -f "$CLEANUP_DISK_RESERVE_FILE" 2>/dev/null || true
        return 1
    fi
    if [ "$allocated_mb" -lt "$reserve_mb" ]; then
        echo "⚠️  cleanup reserve scaled to ${allocated_mb}MB to preserve ${headroom_mb}MB controller headroom" >&2
    fi
}

release_cleanup_disk_reserve() {  # [exact reserve path for a proven-dead registry]
    local reserve_file="${1:-${CLEANUP_DISK_RESERVE_FILE:-}}"
    [ -n "$reserve_file" ] || return 0
    rm -f "$reserve_file" 2>/dev/null || return 1
}

reap_orphaned_fleet_proxies() {
    # A controller reaps its `flyctl proxy` (WireGuard data-plane) children via an
    # EXIT trap — but SIGKILL / a laptop sleep-crash bypasses that trap, orphaning
    # the proxies to init (ppid 1). They tunnel to long-dead machines yet hold FDs
    # and WireGuard sessions forever; left unreaped they accumulate across days
    # (observed: 100+ two-day-old orphans) until new runs' data-plane tunnels can't
    # connect (all status proxies http 000, the relay freezes, the start barrier
    # never sees readiness). Reap ONLY app-scoped proxies whose parent is dead
    # (ppid == 1). Conductor's Linux workspace runtime is a process subreaper, so
    # descendants orphaned inside a cloud workspace are adopted by that runtime
    # instead of PID 1. Treat only those two known adopter boundaries as orphan
    # proof; a concurrently running fleet's proxy has a run-bench-cloud parent
    # and is never touched (rule 27).
    local pids pid ppid command parent_command
    pids="$(
        ps -o pid=,ppid=,command= -ax 2>/dev/null \
            | while read -r pid ppid command; do
                case " $command " in
                    *"flyctl proxy"*" -a $APP "*) ;;
                    *) continue ;;
                esac
                if [ "$ppid" = "1" ]; then
                    printf '%s\n' "$pid"
                    continue
                fi
                parent_command="$(ps -o command= -p "$ppid" 2>/dev/null || true)"
                case "$parent_command" in
                    *conductor-workspace-host-runtime*) printf '%s\n' "$pid" ;;
                esac
            done
    )" || return 0
    [ -n "$pids" ] || return 0
    printf '%s\n' "$pids" | while read -r pid; do [ -n "$pid" ] && kill -TERM "$pid" 2>/dev/null; done
    sleep 1
    printf '%s\n' "$pids" | while read -r pid; do [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null; done
    local n; n="$(printf '%s\n' "$pids" | grep -c .)"
    echo "🧹 reaped $n orphaned data-plane proxy tunnel(s) leaked by a dead controller"
}

reconcile_stale_fleet_registries() {
    local registry meta version app policy host owner_status recovery_lock_status unresolved=0
    mkdir -p "$FLEET_OWNERSHIP_ROOT"
    for registry in "$FLEET_OWNERSHIP_ROOT"/*; do
        [ -d "$registry" ] || continue
        [ "$registry" = "$FLEET_REGISTRY_DIR" ] && continue
        meta="$registry/meta"
        version="$(registry_meta_value "$meta" version)"
        app="$(registry_meta_value "$meta" app)"
        policy="$(registry_meta_value "$meta" cleanup_policy)"
        host="$(registry_meta_value "$meta" host)"
        { [ "$version" = "1" ] || [ "$version" = "2" ]; } \
            && [ "$app" = "$APP" ] && [ -n "$host" ] || {
            echo "❌ malformed fleet ownership registry $registry; refusing to provision" >&2
            unresolved=1
            continue
        }
        [ "$policy" = "retain" ] && continue
        if [ "$policy" != "reap" ]; then
            echo "❌ unknown cleanup policy '$policy' in $registry" >&2
            unresolved=1
            continue
        fi
        # A local git-common registry can positively disprove only same-host
        # process ownership. Other-host records remain untouched and still count
        # against the app capacity guard.
        [ "$host" = "$FLEET_OWNER_HOST" ] || continue
        registry_owner_alive "$meta"
        owner_status=$?
        [ "$owner_status" -eq 0 ] && continue
        if [ "$owner_status" -ne 1 ]; then
            echo "❌ invalid controller identity in $registry" >&2
            unresolved=1
            continue
        fi
        release_cleanup_disk_reserve "$registry/cleanup-disk-reserve" || {
            echo "❌ could not release stale fleet cleanup reserve in $registry" >&2
            unresolved=1
            continue
        }
        acquire_registry_recovery_lock "$registry"
        recovery_lock_status=$?
        [ "$recovery_lock_status" -eq 2 ] && continue
        if [ "$recovery_lock_status" -ne 0 ]; then
            unresolved=1
            continue
        fi
        echo "🧭 recovering stale fleet registry $(basename "$registry") (same-host controller identity is dead)"
        if ! recover_registry_audit_only_fresh "$registry" \
            || ! reap_registry_clones "$registry" stale; then
            rm -rf "$registry/recovery-lock"
            # Registries are independent ownership scopes. Preserve this one
            # and keep the overall startup fail-closed, but continue cleaning
            # later registries whose exact IDs and dead owners can be proven.
            unresolved=1
            continue
        fi
        if ! recover_exact_pool_claims "$meta"; then
            rm -rf "$registry/recovery-lock"
            unresolved=1
            continue
        fi
        if ! fleet_audit_finalize_recovered_registry "$registry"; then
            rm -rf "$registry/recovery-lock"
            unresolved=1
            continue
        fi
        rm -rf "$registry/recovery-lock"
        fleet_registry_remove_if_empty "$registry" || unresolved=1
    done
    [ "$unresolved" = "0" ]
}

# Every claim-path mutation for one machine is serialized by one persistent
# inode below .locks/.  The lock file is deliberately never unlinked: removing
# and recreating a lock pathname would reproduce the same ABA split-brain that
# this transaction closes.  Different machine IDs never contend on one lock.
pool_claim_fs_transaction() {  # <publish-ordinary|publish-transfer|release|mark-unconfirmed> ...
    python3 - "$@" <<'PY'
import fcntl
import hashlib
import os
import re
import secrets
import stat
import sys
from pathlib import Path

MAX_CLAIM_BYTES = 64 * 1024
operation = sys.argv[1]
claim = Path(sys.argv[2])
machine_id = sys.argv[3]
if (
    not claim.is_absolute()
    or claim.name != machine_id
    or not re.fullmatch(r"[0-9a-f]+", machine_id)
):
    raise SystemExit(1)

nofollow = getattr(os, "O_NOFOLLOW", 0)
directory = getattr(os, "O_DIRECTORY", 0)
parent_fd = os.open(claim.parent, os.O_RDONLY | directory | nofollow)
locks_fd = -1
lock_fd = -1

def clean_value(value):
    return "\n" not in value and "=" not in value

def write_all(fd, payload):
    view = memoryview(payload)
    while view:
        view = view[os.write(fd, view):]

def read_claim_locked():
    try:
        fd = os.open(machine_id, os.O_RDONLY | nofollow, dir_fd=parent_fd)
    except (FileNotFoundError, OSError):
        raise SystemExit(1)
    try:
        opened = os.fstat(fd)
        if not stat.S_ISREG(opened.st_mode):
            raise SystemExit(1)
        chunks = []
        size = 0
        while True:
            chunk = os.read(fd, 8192)
            if not chunk:
                break
            size += len(chunk)
            if size > MAX_CLAIM_BYTES:
                raise SystemExit(1)
            chunks.append(chunk)
        payload = b"".join(chunks)
    finally:
        os.close(fd)
    try:
        current = os.stat(machine_id, dir_fd=parent_fd, follow_symlinks=False)
    except (FileNotFoundError, OSError):
        raise SystemExit(1)
    if (
        not stat.S_ISREG(current.st_mode)
        or (opened.st_dev, opened.st_ino) != (current.st_dev, current.st_ino)
    ):
        raise SystemExit(1)
    return payload, opened

def parse_exact_owner(payload, digest, host, pid, pid_start, owner):
    if not re.fullmatch(r"[0-9a-f]{64}", digest):
        raise SystemExit(1)
    if (
        not clean_value(host)
        or not re.fullmatch(r"[0-9]+", pid)
        or not clean_value(pid_start)
        or (owner and not re.fullmatch(r"[0-9a-f]{32}", owner))
        or hashlib.sha256(payload).hexdigest() != digest
    ):
        raise SystemExit(1)
    try:
        lines = payload.decode("utf-8").splitlines()
    except UnicodeDecodeError:
        raise SystemExit(1)
    fields = {}
    for line in lines:
        if "=" not in line:
            raise SystemExit(1)
        key, value = line.split("=", 1)
        if not key or key in fields:
            raise SystemExit(1)
        fields[key] = value
    if (
        fields.get("host") != host
        or fields.get("pid") != pid
        or fields.get("pid_start") != pid_start
        or fields.get("fleet_owner_token", "") != owner
        or ("machine_id" in fields and fields["machine_id"] != machine_id)
    ):
        raise SystemExit(1)

try:
    try:
        os.mkdir(".locks", 0o700, dir_fd=parent_fd)
        os.fsync(parent_fd)
    except FileExistsError:
        pass
    lock_root = os.stat(".locks", dir_fd=parent_fd, follow_symlinks=False)
    if not stat.S_ISDIR(lock_root.st_mode):
        raise SystemExit(1)
    locks_fd = os.open(".locks", os.O_RDONLY | directory | nofollow, dir_fd=parent_fd)
    lock_name = f"{machine_id}.lock"
    lock_fd = os.open(
        lock_name,
        os.O_RDWR | os.O_CREAT | nofollow,
        0o600,
        dir_fd=locks_fd,
    )
    lock_stat = os.fstat(lock_fd)
    if not stat.S_ISREG(lock_stat.st_mode):
        raise SystemExit(1)
    os.fsync(locks_fd)
    fcntl.flock(lock_fd, fcntl.LOCK_EX)

    if operation in ("publish-ordinary", "publish-transfer"):
        if operation == "publish-ordinary":
            if len(sys.argv) != 12:
                raise SystemExit(1)
            volume_id, host, pid, pid_start, owner, ledger, meta, baseline = sys.argv[4:]
            clone_line = ""
            transfer_line = ""
            temporary_kind = "claim"
        else:
            if len(sys.argv) != 13:
                raise SystemExit(1)
            clone_name, volume_id, host, pid, pid_start, owner, ledger, meta, baseline = sys.argv[4:]
            if not re.fullmatch(r"cloudbench-[A-Za-z0-9._-]+", clone_name):
                raise SystemExit(1)
            clone_line = f"clone_name={clone_name}\n"
            transfer_line = "transfer_state=pending\n"
            temporary_kind = "transfer"
        if (
            not re.fullmatch(r"[A-Za-z0-9_-]+", volume_id)
            or not re.fullmatch(r"[0-9]+", pid)
            or not re.fullmatch(r"[0-9a-f]{32}", owner)
            or not re.fullmatch(r"[0-9a-f]{64}", baseline)
            or any(not clean_value(value) for value in (host, pid_start, ledger, meta))
        ):
            raise SystemExit(1)
        payload = (
            f"host={host}\npid={pid}\npid_start={pid_start}\n"
            f"fleet_owner_token={owner}\ncleanup_state=owned\n{transfer_line}"
            f"machine_id={machine_id}\n{clone_line}volume_id={volume_id}\n"
            f"pool_ledger_file={ledger}\npool_meta_file={meta}\n"
            f"pool_meta_sha256={baseline}\n"
        ).encode()
        temporary = f".{machine_id}.{temporary_kind}.{secrets.token_hex(16)}"
        temporary_fd = -1
        try:
            temporary_fd = os.open(
                temporary,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL | nofollow,
                0o600,
                dir_fd=parent_fd,
            )
            write_all(temporary_fd, payload)
            os.fsync(temporary_fd)
            os.close(temporary_fd)
            temporary_fd = -1
            os.link(
                temporary,
                machine_id,
                src_dir_fd=parent_fd,
                dst_dir_fd=parent_fd,
                follow_symlinks=False,
            )
            os.fsync(parent_fd)
        finally:
            if temporary_fd >= 0:
                os.close(temporary_fd)
            try:
                os.unlink(temporary, dir_fd=parent_fd)
                os.fsync(parent_fd)
            except FileNotFoundError:
                pass
    elif operation in ("release", "mark-unconfirmed"):
        if len(sys.argv) != 9:
            raise SystemExit(1)
        digest, host, pid, pid_start, owner = sys.argv[4:]
        payload, opened = read_claim_locked()
        parse_exact_owner(payload, digest, host, pid, pid_start, owner)
        # Re-stat after validation and immediately before mutation. Writers and
        # removers of this machine share this lock, so the pathname cannot cross
        # an old-inode -> absent -> successor-inode ABA boundary here.
        current = os.stat(machine_id, dir_fd=parent_fd, follow_symlinks=False)
        if (opened.st_dev, opened.st_ino) != (current.st_dev, current.st_ino):
            raise SystemExit(1)
        if operation == "release":
            os.unlink(machine_id, dir_fd=parent_fd)
            os.fsync(parent_fd)
        else:
            replacement = (
                f"host={host}\npid={pid}\npid_start={pid_start}\n"
                f"fleet_owner_token={owner}\ncleanup_state=unconfirmed\n"
            ).encode()
            temporary = f".{machine_id}.unconfirmed.{secrets.token_hex(16)}"
            temporary_fd = -1
            try:
                temporary_fd = os.open(
                    temporary,
                    os.O_WRONLY | os.O_CREAT | os.O_EXCL | nofollow,
                    0o600,
                    dir_fd=parent_fd,
                )
                write_all(temporary_fd, replacement)
                os.fsync(temporary_fd)
                os.close(temporary_fd)
                temporary_fd = -1
                os.replace(
                    temporary,
                    machine_id,
                    src_dir_fd=parent_fd,
                    dst_dir_fd=parent_fd,
                )
                os.fsync(parent_fd)
            finally:
                if temporary_fd >= 0:
                    os.close(temporary_fd)
                try:
                    os.unlink(temporary, dir_fd=parent_fd)
                    os.fsync(parent_fd)
                except FileNotFoundError:
                    pass
    else:
        raise SystemExit(1)
finally:
    if lock_fd >= 0:
        os.close(lock_fd)
    if locks_fd >= 0:
        os.close(locks_fd)
    os.close(parent_fd)
PY
}

pool_claim_release_exact() {  # <claim> <digest> <owner-token> <host> <pid> <pid-start>
    local claim_path="$1" claim_digest="$2" expected_token="$3" expected_host="$4"
    local expected_pid="$5" expected_start="$6" id="${1##*/}"
    case "$id" in ''|*[!0-9a-f]*) return 1 ;; esac
    pool_claim_fs_transaction release "$claim_path" "$id" "$claim_digest" \
        "$expected_host" "$expected_pid" "$expected_start" "$expected_token"
}

recover_one_exact_pool_claim() {  # <claim> <owner-token> <host> <pid> <pid-start>
    local claim_path="$1" expected_token="$2" expected_host="$3" expected_pid="$4"
    local expected_start="$5" id="${1##*/}" transfer_state volume_id ledger
    local st presence mounted claim_digest disposition recorded_baseline current_baseline
    case "$id" in ''|*[!0-9a-f]*) return 1 ;; esac
    [ -f "$claim_path" ] && [ ! -L "$claim_path" ] || return 1
    claim_digest="$(cloudbench_env_sha256 "$claim_path")" || return 1
    [ "$(registry_meta_value "$claim_path" fleet_owner_token)" = "$expected_token" ] \
        && [ "$(registry_meta_value "$claim_path" host)" = "$expected_host" ] \
        && [ "$(registry_meta_value "$claim_path" pid)" = "$expected_pid" ] \
        && [ "$(registry_meta_value "$claim_path" pid_start)" = "$expected_start" ] \
        || return 1
    transfer_state="$(registry_meta_value "$claim_path" transfer_state)"
    if [ -n "$transfer_state" ]; then
        [ "$transfer_state" = "pending" ] || return 1
        fleet_audit_update_recovered_transfer "$claim_path" validate-only || return 1
        volume_id="$(registry_meta_value "$claim_path" volume_id)"
        ledger="$(registry_meta_value "$claim_path" pool_ledger_file)"
    else
        fleet_audit_update_recovered_pool_machine "$claim_path" validate-only || {
            echo "❌ dead-claimed pool machine $id failed exact audit validation" >&2
            echo "   claim=$claim_path" >&2
            echo "   GIT_COMMON_DIR=$GIT_COMMON_DIR APP=$APP FLEET_AUDIT_ROOT=$FLEET_AUDIT_ROOT" >&2
            echo "   claim contents:" >&2
            sed 's/^/     /' "$claim_path" 2>/dev/null >&2 || true
            echo "   pool audit:" >&2
            sed 's/^/     /' "$FLEET_AUDIT_ROOT/$(registry_meta_value \
                "$claim_path" fleet_owner_token)/pool/$id" 2>/dev/null >&2 || true
            echo "   audit meta:" >&2
            sed 's/^/     /' "$FLEET_AUDIT_ROOT/$(registry_meta_value \
                "$claim_path" fleet_owner_token)/meta" 2>/dev/null >&2 || true
            return 1
        }
        volume_id="$(registry_meta_value "$FLEET_AUDIT_ROOT/$(registry_meta_value \
            "$claim_path" fleet_owner_token)/pool/$id" volume_id)"
        [ -n "$volume_id" ] || volume_id="$(registry_meta_value "$claim_path" volume_id)"
        ledger="$(registry_meta_value "$FLEET_AUDIT_ROOT/$(registry_meta_value \
            "$claim_path" fleet_owner_token)/pool/$id" pool_ledger_file)"
        [ -n "$ledger" ] || ledger="$(registry_meta_value "$claim_path" pool_ledger_file)"
    fi
    recorded_baseline="$(registry_meta_value "$claim_path" pool_meta_sha256)"
    [ -n "$recorded_baseline" ] || recorded_baseline="$(registry_meta_value \
        "$FLEET_AUDIT_ROOT/$expected_token/pool/$id" pool_meta_sha256)"
    current_baseline="$(cloudbench_env_sha256 "${ledger}.deps" 2>/dev/null)" || current_baseline=""
    if [ ! -f "$ledger" ] || [ -z "$current_baseline" ] \
        || [ "$recorded_baseline" != "$current_baseline" ]; then
        [ "$(cloudbench_env_sha256 "$claim_path")" = "$claim_digest" ] || return 1
        reap_machine "$id" "" "$volume_id" || {
            echo "❌ dead-claimed pool machine $id could not be destroyed during baseline recovery" >&2
            return 1
        }
        if grep -Fxq "$id" "$ledger" 2>/dev/null; then
            pool_ledger_remove_id_from "$ledger" "$id" || return 1
        fi
        if [ -n "$transfer_state" ]; then
            fleet_audit_update_recovered_transfer "$claim_path" \
                destroyed-verified-absent || return 1
        else
            fleet_audit_update_recovered_pool_machine "$claim_path" \
                destroyed-removed-from-pool || return 1
        fi
        [ "$(cloudbench_env_sha256 "$claim_path")" = "$claim_digest" ] || return 1
        pool_claim_release_exact "$claim_path" "$claim_digest" "$expected_token" \
            "$expected_host" "$expected_pid" "$expected_start"
        return
    fi

    # Inventory reads can transiently fail under concurrent fake/provider load.
    # Retry a bounded number of times before fail-closed; a single presence=2
    # must not strand a dead-owner claim after we already announced recovery.
    presence=2
    st=""
    for _ in $(seq 1 "${CLOUDBENCH_POOL_INVENTORY_RETRY_ATTEMPTS:-5}"); do
        st="$(pool_machine_state "$id")"
        presence=$?
        [ "$presence" -ne 2 ] && break
        sleep 0.2
    done
    if [ "$presence" -eq 2 ]; then
        echo "❌ dead-claimed pool machine $id inventory unreadable during recovery" >&2
        return 1
    fi
    if [ "$presence" -eq 0 ] && [ "$st" != "stopped" ]; then
        [ "$(cloudbench_env_sha256 "$claim_path")" = "$claim_digest" ] || return 1
        FLY machine stop "$id" -a "$APP" >/dev/null 2>&1 || true
        for _ in $(seq 1 "${CLOUDBENCH_POOL_STOP_ATTEMPTS:-30}"); do
            st="$(pool_machine_state "$id")"
            presence=$?
            [ "$presence" -eq 0 ] && [ "$st" = "stopped" ] && break
            [ "$presence" -eq 1 ] && break
            [ "$presence" -eq 0 ] || {
                echo "❌ dead-claimed pool machine $id inventory unreadable while stopping" >&2
                return 1
            }
            sleep 2
        done
    fi
    if [ "$presence" -eq 0 ] && [ "$st" = "stopped" ]; then
        [ "$(cloudbench_env_sha256 "$claim_path")" = "$claim_digest" ] || return 1
        mounted="$(machine_volume_id "$id")"
        if [ -z "$mounted" ]; then
            # Fall back to the claim/audit volume when the provider omits mounts
            # on a stopped inventory row; the sealed claim remains authoritative.
            mounted="$volume_id"
        fi
        [ "$mounted" = "$volume_id" ] && grep -Fxq "$id" "$ledger" 2>/dev/null \
            || {
                echo "❌ dead-claimed pool machine $id stopped without matching volume/ledger proof" >&2
                return 1
            }
        if [ -n "$transfer_state" ]; then
            disposition="$(registry_meta_value "$FLEET_AUDIT_ROOT/$(registry_meta_value \
                "$claim_path" fleet_owner_token)/fresh/$(registry_meta_value \
                "$claim_path" clone_name)" disposition)"
            case "$disposition" in
                transfer-pending-stopped)
                    fleet_audit_update_recovered_transfer "$claim_path" \
                        transferred-to-pool-stopped || return 1
                    ;;
                transferred-to-pool-stopped) ;;
                *) return 1 ;;
            esac
        else
            fleet_audit_update_recovered_pool_machine "$claim_path" \
                returned-stopped-claim-released || return 1
        fi
    elif [ "$presence" -eq 1 ]; then
        # Absence is not a successful pool return. The original manifest's exact
        # volume is still cleanup authority; only provider-confirmed absence of
        # both resources plus ledger removal permits a destroyed disposition.
        [ "$(cloudbench_env_sha256 "$claim_path")" = "$claim_digest" ] || return 1
        reap_volume "$volume_id" || return 1
        if grep -Fxq "$id" "$ledger" 2>/dev/null; then
            pool_ledger_remove_id_from "$ledger" "$id" || return 1
        fi
        if [ -n "$transfer_state" ]; then
            fleet_audit_update_recovered_transfer "$claim_path" \
                destroyed-verified-absent || return 1
        else
            fleet_audit_update_recovered_pool_machine "$claim_path" \
                destroyed-removed-from-pool || return 1
        fi
    else
        echo "❌ dead-claimed pool machine $id left recovery in unresolved state (presence=$presence state=${st:-})" >&2
        return 1
    fi
    [ "$(cloudbench_env_sha256 "$claim_path")" = "$claim_digest" ] || return 1
    pool_claim_release_exact "$claim_path" "$claim_digest" "$expected_token" \
        "$expected_host" "$expected_pid" "$expected_start"
}

recover_exact_pool_claims() {  # <dead-owner-meta>
    local meta="$1" target_host target_pid target_start target_token target_registry version claim_path id
    local claim_host claim_pid claim_start st presence cleanup_status claim_token claim_digest
    target_host="$(registry_meta_value "$meta" host)"
    target_pid="$(registry_meta_value "$meta" pid)"
    target_start="$(registry_meta_value "$meta" pid_start)"
    target_token="$(registry_meta_value "$meta" fleet_owner_token)"
    target_registry="${meta%/meta}"
    version="$(registry_meta_value "$meta" version)"
    [ -n "$target_host" ] && [ -n "$target_pid" ] && [ -n "$target_start" ] || return 1
    mkdir -p "$POOL_CLAIMS_DIR" || return 1
    for claim_path in "$POOL_CLAIMS_DIR"/*; do
        [ -f "$claim_path" ] || continue
        claim_host="$(registry_meta_value "$claim_path" host)"
        claim_pid="$(registry_meta_value "$claim_path" pid)"
        claim_start="$(registry_meta_value "$claim_path" pid_start)"
        [ "$claim_host" = "$target_host" ] \
            && [ "$claim_pid" = "$target_pid" ] \
            && [ "$claim_start" = "$target_start" ] \
            || continue
        id="${claim_path##*/}"
        case "$id" in ''|*[!0-9a-f]*) return 1 ;; esac
        claim_token="$(registry_meta_value "$claim_path" fleet_owner_token)"
        if [ "$version" = "2" ]; then
            [ "${target_registry##*/}" = "$target_token" ] || return 1
            [ "$claim_token" = "$target_token" ] || return 1
        fi
        if pool_claim_cleanup_unconfirmed "$claim_path"; then
            echo "❌ refusing exact recovery of pool machine $id: guest cleanup is unconfirmed" >&2
            return 1
        else
            cleanup_status=$?
            [ "$cleanup_status" -eq 1 ] || {
                echo "❌ malformed cleanup ownership in pool claim $id" >&2
                return 1
            }
        fi
        if [ "$version" = "2" ]; then
            echo "↩️  reconciling exact dead-owner pool claim $id"
            recover_one_exact_pool_claim "$claim_path" "$target_token" \
                "$target_host" "$target_pid" "$target_start" || return 1
            continue
        fi
        echo "↩️  force-stopping legacy exact dead-owner pool claim $id"
        FLY machine stop "$id" -a "$APP" >/dev/null 2>&1 || true
        st=""
        for _ in $(seq 1 "${CLOUDBENCH_POOL_STOP_ATTEMPTS:-30}"); do
            st="$(pool_machine_state "$id")"
            presence=$?
            if [ "$presence" -eq 0 ] && [ "$st" = "stopped" ]; then
                break
            fi
            # Legacy v1 claims predate exact volume/audit capture. Preserve the
            # compatibility path; all v2 claims use fail-closed exact recovery.
            [ "$presence" -eq 1 ] && { st="absent"; break; }
            sleep 2
        done
        [ "$st" = "stopped" ] || [ "$st" = "absent" ] || {
            echo "❌ exact dead-owner pool machine $id did not verify stopped" >&2
            return 1
        }
        claim_digest="$(cloudbench_env_sha256 "$claim_path")" || return 1
        claim_token="$(registry_meta_value "$claim_path" fleet_owner_token)"
        pool_claim_release_exact "$claim_path" "$claim_digest" "$claim_token" \
            "$claim_host" "$claim_pid" "$claim_start" || return 1
    done
}

recover_exact_stale_fleet_owner() {  # <32-hex-owner-token>
    local token="$1" registry="$FLEET_OWNERSHIP_ROOT/$1" meta orphan_audit
    local version app policy host owner_status recovery_lock_status
    case "$token" in ''|*[!0-9a-f]*) return 1 ;; esac
    [ "${#token}" -eq 32 ] || return 1
    if [ ! -d "$registry" ]; then
        # Older cleanup ordering could remove the registry before sealing its
        # shared WAL. Absence is success only when no audit exists or that
        # exact audit is already terminal; an incomplete orphan must never be
        # silently omitted from recovery.
        orphan_audit="$FLEET_AUDIT_ROOT/$token"
        [ -e "$orphan_audit" ] || return 0
        [ -d "$orphan_audit" ] && [ ! -L "$orphan_audit" ] \
            && [ "$(registry_meta_value "$orphan_audit/meta" fleet_owner_token)" = "$token" ] \
            && [ "$(registry_meta_value "$orphan_audit/meta" status)" \
                = "provider-teardown-verified" ] && return 0
        echo "❌ exact owner $token has an incomplete shared audit but no recovery registry" >&2
        return 1
    fi
    [ "${registry%/*}" = "${FLEET_OWNERSHIP_ROOT%/}" ] || return 1
    meta="$registry/meta"
    version="$(registry_meta_value "$meta" version)"
    app="$(registry_meta_value "$meta" app)"
    policy="$(registry_meta_value "$meta" cleanup_policy)"
    host="$(registry_meta_value "$meta" host)"
    { [ "$version" = "1" ] || [ "$version" = "2" ]; } \
        && [ "$app" = "$APP" ] \
        && [ "$policy" = "reap" ] && [ "$host" = "$FLEET_OWNER_HOST" ] || {
        echo "❌ exact stale-owner registry identity is unsafe: $registry" >&2
        return 1
    }
    registry_owner_alive "$meta"
    owner_status=$?
    [ "$owner_status" -eq 1 ] || {
        echo "❌ exact stale-owner recovery requires a proven-dead same-host controller" >&2
        return 1
    }
    release_cleanup_disk_reserve "$registry/cleanup-disk-reserve" || return 1
    acquire_registry_recovery_lock "$registry"
    recovery_lock_status=$?
    [ "$recovery_lock_status" -eq 2 ] && return 0
    [ "$recovery_lock_status" -eq 0 ] || return 1
    echo "🧭 force-recovering exact cancelled fleet owner $token"
    # The supervising waiter already proved the entire controller process group
    # drained. Unlike generic successor recovery, this exact cancellation path
    # must not preserve a remote runner: cancellation explicitly owns and reaps
    # every machine in this token's durable ledger.
    if ! recover_registry_audit_only_fresh "$registry" \
        || ! reap_registry_clones "$registry" forced \
        || ! recover_exact_pool_claims "$meta" \
        || ! capacity_release_stale_owner_reservations "$meta" "$token-" \
        || ! fleet_audit_finalize_recovered_registry "$registry"; then
        rm -rf "$registry/recovery-lock"
        return 1
    fi
    rm -rf "$registry/recovery-lock"
    fleet_registry_remove_if_empty "$registry"
}

# ── Pre-provisioned pool: stopped clones (current image) claimed on demand ───
# A claimed pool machine skips the ~300s volume fork (its volume is already
# forked). It still git-fetches the ref + applies the patch on claim, so it runs
# the CURRENT branch code — the baked image only supplies deps. Stopped pool
# machines cost $0 compute (volumes only) between runs.
machine_id_for_clone_name() {  # machine_id_for_clone_name <name> <absolute-seconds-deadline>
    local target_name="$1" deadline="$2" match prior_snapshot
    prior_snapshot=""
    declare -F machines_snapshot_identity >/dev/null && prior_snapshot="$(machines_snapshot_identity)"
    while :; do
        # This is the post-mutation fallback for clone output that omitted an
        # authoritative target id.  Coalesce one fresh API read into the shared
        # snapshot; the normal clone-output path does not call this at all.
        if declare -F refresh_machines_snapshot_after >/dev/null; then
            if ! refresh_machines_snapshot_after "$prior_snapshot"; then
                if [ "$SECONDS" -ge "$deadline" ]; then
                    echo "❌ unresolved clone name '$target_name' after inventory refresh failure" >&2
                    return 1
                fi
                prior_snapshot="$(machines_snapshot_identity)"
                sleep 1
                continue
            fi
        fi
        match="$(inventory_machine_id_for_name "$target_name" 2>/dev/null || true)"
        if [ -n "$match" ]; then
            printf '%s' "$match"
            return 0
        fi
        if [ "$SECONDS" -ge "$deadline" ]; then
            echo "❌ unresolved clone name '$target_name'; inspect with: flyctl machines list -a $APP --json" >&2
            return 1
        fi
        declare -F machines_snapshot_identity >/dev/null && prior_snapshot="$(machines_snapshot_identity)"
        sleep 1
    done
}

# Run `FLY <args>` under a hard wall-clock ceiling, echoing its combined output.
# `flyctl machine clone` has been observed to hang indefinitely on a stalled Fly
# API call (even with --detach), which freezes the whole sequential provisioning
# loop and starves the synchronized barrier. Backgrounding FLY (a function → its
# flyctl child is a grandchild of this subshell) lets a watchdog reap the child
# by parent (pkill -P) on timeout; returns 142 so the caller's retry loop treats
# a hang exactly like any other transient clone failure. Portable (no `timeout`).
fly_with_timeout() {  # fly_with_timeout <seconds> <FLY args...>
    local secs="$1"; shift
    local out; out="$(mktemp)"
    FLY "$@" >"$out" 2>&1 &
    local pid=$! waited=0 rc
    while kill -0 "$pid" 2>/dev/null; do
        if [ "$waited" -ge "$secs" ]; then
            pkill -TERM -P "$pid" 2>/dev/null || true
            kill -TERM "$pid" 2>/dev/null || true
            sleep 2
            pkill -KILL -P "$pid" 2>/dev/null || true
            kill -KILL "$pid" 2>/dev/null || true
            wait "$pid" 2>/dev/null || true
            cat "$out"; rm -f "$out"
            return 142
        fi
        sleep 1; waited=$((waited + 1))
    done
    wait "$pid"; rc=$?
    cat "$out"; rm -f "$out"
    return "$rc"
}

worker_ledger_lock_acquire() {  # worker_ledger_lock_acquire <bench-output-dir>
    local lock="$1/worker-clones.ids.lock" owner="$1/worker-clones.ids.lock/owner"
    local attempts="${WORKER_LEDGER_LOCK_ATTEMPTS:-100}" delay="${WORKER_LEDGER_LOCK_RETRY_SECONDS:-0.1}"
    local stale_seconds="${WORKER_LEDGER_LOCK_STALE_SECONDS:-300}"
    local self_pid="${BASHPID:-$$}" token now observed owner_pid owner_token owner_started age
    case "$attempts" in ''|*[!0-9]*|0) echo "❌ invalid worker ledger lock attempts" >&2; return 1 ;; esac
    case "$stale_seconds" in ''|*[!0-9]*) echo "❌ invalid worker ledger stale timeout" >&2; return 1 ;; esac
    token="$self_pid.$(date +%s).$RANDOM"
    for _ in $(seq 1 "$attempts"); do
        if mkdir "$lock" 2>/dev/null; then
            now="$(date +%s)"
            if ! printf '%s %s %s\n' "$self_pid" "$token" "$now" > "$owner"; then
                rmdir "$lock" 2>/dev/null || true
                return 1
            fi
            WORKER_LEDGER_LOCK_TOKEN="$token"
            return 0
        fi

        # Recover only an old lock whose owning process is definitely gone. The observed owner
        # record is compared again before removal so a successor can never delete a newer lock.
        observed="$(cat "$owner" 2>/dev/null || true)"
        owner_pid=""; owner_token=""; owner_started=""
        if [ -n "$observed" ]; then
            read -r owner_pid owner_token owner_started < "$owner" 2>/dev/null || true
        else
            owner_started="$(stat -c %Y "$lock" 2>/dev/null || stat -f %m "$lock" 2>/dev/null || true)"
        fi
        now="$(date +%s)"
        case "$owner_started" in ''|*[!0-9]*) owner_started="$now" ;; esac
        age=$((now - owner_started))
        if [ "$age" -ge "$stale_seconds" ] \
            && { [ -z "$owner_pid" ] || ! kill -0 "$owner_pid" 2>/dev/null; } \
            && [ "$(cat "$owner" 2>/dev/null || true)" = "$observed" ]; then
            rm -f "$owner" 2>/dev/null || true
            rmdir "$lock" 2>/dev/null || true
            continue
        fi
        sleep "$delay"
    done
    echo "❌ timed out acquiring worker ledger lock: $lock" >&2
    return 75
}

worker_ledger_lock_release() {  # worker_ledger_lock_release <bench-output-dir>
    local lock="$1/worker-clones.ids.lock" owner="$1/worker-clones.ids.lock/owner"
    local expected="${WORKER_LEDGER_LOCK_TOKEN:-}" owner_pid actual owner_started
    [ -n "$expected" ] || return 1
    read -r owner_pid actual owner_started < "$owner" 2>/dev/null || return 1
    [ "$actual" = "$expected" ] || return 1
    rm -f "$owner" || return 1
    rmdir "$lock" || return 1
    WORKER_LEDGER_LOCK_TOKEN=""
}

clone_machine_target() {  # clone_machine_target <ownership-ledger> [source-id] [vm-size] [memory-mb]
    local ledger="$1" source_id="${2:-$WARM_ID}"
    local vm_size="${3:-${FLEET_PRIMARY_VM_SIZE:-shared-cpu-2x}}" vm_memory="${4:-${FLEET_PRIMARY_VM_MEMORY:-4096}}"
    local clone_out clone_status target_id target_name target_volume diagnostic_log names_ledger deadline
    local storage_deadline
    local attempt max_attempts retry_delay clone_timeout
    # Fly API throttles (resource_exhausted/429) and clone-from-snapshot can lose a create-volume→launch-VM race
    # ("failed to launch VM: volume not found") or leaves the new machine
    # momentarily unlistable — both transient, both fatal to a synchronized
    # 28-wide barrier if a single clone aborts the batch. Retry with backoff
    # (fresh name per attempt; the names-ledger keeps every attempted name so
    # teardown reaps any machine that did materialize — no new leak path).
    max_attempts="${CLOUDBENCH_CLONE_MAX_ATTEMPTS:-${CLOUDBENCH_CLONE_ATTEMPTS:-5}}"
    retry_delay="${CLOUDBENCH_CLONE_RETRY_SECONDS:-8}"
    # Bound each clone so a hung Fly API call can't freeze the whole loop. A real
    # clone-from-snapshot + --detach returns well under this; 25min+ = hung.
    clone_timeout="${CLOUDBENCH_CLONE_TIMEOUT_SECONDS:-240}"
    mkdir -p "$(dirname "$ledger")"
    names_ledger="${ledger%.ids}.names"
    diagnostic_log="${ledger%.ids}.log"
    attempt=1
    while :; do
        target_volume=""
        target_name="cloudbench-$(python3 -c 'import uuid; print(uuid.uuid4().hex[:24])')"
        # Record the provider target name durably BEFORE asking Fly to allocate,
        # so a successor can bind a late-appearing machine to this dead fleet even
        # if this process is SIGKILLed mid-clone (survives workspace deletion).
        if ! fleet_registry_record_name "$target_name" "$source_id"; then
            echo "❌ could not persist durable ownership for clone name '$target_name'; refusing provider allocation" >&2
            return 1
        fi
        printf '%s\n' "$target_name" >> "$names_ledger"
        clone_out="$(fly_with_timeout "$clone_timeout" machine clone "$source_id" -a "$APP" \
            --from-snapshot "$SNAP_ID" --region "$REGION" --name "$target_name" \
            --vm-size "$vm_size" --vm-memory "$vm_memory" --detach 2>&1)"
        clone_status=$?
        {
            printf 'clone name=%s source=%s status=%s attempt=%s/%s\n' \
                "$target_name" "$source_id" "$clone_status" "$attempt" "$max_attempts"
            printf '%s\n' "$clone_out"
        } >> "$diagnostic_log"

        # `flyctl machine clone` normally returns the authoritative id in this
        # stable line. Parse it directly: at fleet width this removes 30
        # redundant Machines API list calls from the provision critical path.
        target_id="$(printf '%s\n' "$clone_out" \
            | sed -nE 's/^[[:space:]]*Machine ([0-9a-f]+) has been created[.][.][.]$/\1/p' \
            | tail -1)"
        case "$target_id" in ''|*[!0-9a-f]*) target_id="" ;; esac
        if [ -z "$target_id" ]; then
            deadline=$((SECONDS + ${CLOUDBENCH_CLONE_LOOKUP_SECONDS:-20}))
            target_id="$(machine_id_for_clone_name "$target_name" "$deadline")" || target_id=""
        fi
        if [ "$clone_status" -ne 0 ] && [ -z "$target_id" ]; then
            target_volume="$(clone_failure_owned_volume_id "$clone_status" "$clone_out")"
            if [ -n "$target_volume" ]; then
                # Fly can create the forked volume and then reject VM launch.
                # Persist the exact provider-returned ID before deletion so an
                # interrupted cleanup remains recoverable by this owner only.
                if ! fleet_registry_record_volume "$target_name" "$target_volume"; then
                    echo "❌ could not persist exact owned volume $target_volume for failed clone '$target_name'" >&2
                    return 1
                fi
                if ! reap_volume "$target_volume"; then
                    echo "❌ failed clone volume $target_volume could not be reaped; retaining exact ownership" >&2
                    return 1
                fi
                fleet_audit_update_fresh_clone "$target_name" "" "$target_volume" \
                    destroyed-verified-absent || return 1
                fleet_registry_release_name "$target_name" || return 1
                grep -Fxv "$target_name" "$names_ledger" > "$names_ledger.tmp" 2>/dev/null || true
                mv "$names_ledger.tmp" "$names_ledger"
            fi
        fi
        if [ "$clone_status" -ne 0 ] && [ -z "$target_id" ] \
            && [ -z "$target_volume" ] \
            && clone_failure_definitively_unallocated "$clone_out"; then
            # The provider explicitly rejected this attempt before allocating a
            # Machine, and the bounded name lookup also found none. Release only
            # this attempt's name record so a later successful retry does not
            # leave a phantom registry that blocks every future controller.
            fleet_audit_update_fresh_clone "$target_name" "" "" \
                not-allocated-verified || return 1
            fleet_registry_release_name "$target_name" || return 1
            grep -Fxv "$target_name" "$names_ledger" > "$names_ledger.tmp" 2>/dev/null || true
            mv "$names_ledger.tmp" "$names_ledger"
        fi
        # Fix-from-the-start for the name-only orphan: an AMBIGUOUS clone failure
        # (non-zero/timed-out, but not a recognized "definitively unallocated"
        # error) that yields no id would otherwise retain its name record forever.
        # That id-less orphan later aborts teardown/reconciliation on a single
        # transient Fly-list read (the `*) return 1` reap arm) and leaks every
        # already-id'd sibling. So resolve the reserved name AUTHORITATIVELY before
        # retrying with a fresh name: bind the id if a machine did materialize, and
        # RELEASE the reservation only on a definite "absent" (Fly list succeeded,
        # zero matches). An unsafe/ambiguous read (resolve==2) stays fail-closed so
        # a genuinely late-appearing clone is never orphaned.
        #
        # Skip the absent→not-allocated-verified transition when this attempt
        # already cleaned via the owned-volume path (insufficient-resources after
        # volume create → destroyed-verified-absent). That disposition cannot
        # legally move to not-allocated-verified; re-auditing here used to abort
        # the retry loop after attempt 1 and surface as "unresolved clone name"
        # / "provisioning failed (no machine)" under capacity pressure.
        if [ -z "$target_id" ]; then
            local reconciled_id reconcile_status already_cleaned=0
            if ! grep -Fxq "$target_name" "$names_ledger" 2>/dev/null; then
                already_cleaned=1
            fi
            if [ "$already_cleaned" -eq 0 ]; then
                reconciled_id="$(registry_resolve_name "$target_name")"; reconcile_status=$?
                case "$reconcile_status" in
                    0) target_id="$reconciled_id" ;;
                    1) fleet_audit_update_fresh_clone "$target_name" "" "" \
                           not-allocated-verified || return 1
                       fleet_registry_release_name "$target_name" || return 1
                       grep -Fxv "$target_name" "$names_ledger" > "$names_ledger.tmp" 2>/dev/null || true
                       mv "$names_ledger.tmp" "$names_ledger" ;;
                    *) : ;;
                esac
            fi
        fi
        if [ -n "$target_id" ] && [ "$target_id" != "$source_id" ] && [ "$target_id" != "$WARM_ID" ]; then
            # A machine ID alone is not sufficient teardown authority: Fly
            # removes the mount metadata with the machine, while a failed
            # volume destroy can keep billing. Keep the durable record
            # name-only until the exact forked volume is visible, then publish
            # machine + volume atomically before any path may destroy it.
            storage_deadline=$((SECONDS + ${CLOUDBENCH_CLONE_STORAGE_READY_SECONDS:-600}))
            target_volume=""
            while [ -z "$target_volume" ]; do
                target_volume="$(machine_volume_id "$target_id")"
                [ -n "$target_volume" ] && break
                if [ "$SECONDS" -ge "$storage_deadline" ]; then
                    echo "❌ clone $target_id volume identity was not visible within the provisioning deadline; retaining name ownership" >&2
                    return 1
                fi
                sleep 2
            done
            if ! fleet_registry_record_id "$target_name" "$target_id" "$target_volume"; then
                echo "❌ could not persist provider ID $target_id and volume $target_volume; name ownership remains for teardown" >&2
                return 1
            fi
            if ! worker_ledger_lock_acquire "$(dirname "$ledger")"; then
                echo "❌ could not lock clone ownership ledger for $target_id" >&2
                return 1
            fi
            if ! grep -Fxq "$target_id" "$ledger" 2>/dev/null \
                && ! printf '%s\n' "$target_id" >> "$ledger"; then
                worker_ledger_lock_release "$(dirname "$ledger")" || true
                return 1
            fi
            worker_ledger_lock_release "$(dirname "$ledger")" || return 1
            grep -Fxv "$target_name" "$names_ledger" > "$names_ledger.tmp" 2>/dev/null || true
            mv "$names_ledger.tmp" "$names_ledger"
        else
            target_id=""
        fi
        # An authoritative ID is success even when flyctl itself timed out or
        # returned non-zero after allocation. Retrying here would provision a
        # duplicate clone despite already owning the recovered target.
        if [ -n "$target_id" ]; then
            # A successful Fly clone response only proves that the Machine
            # object was allocated. Snapshot restoration continues
            # asynchronously and can already be terminal `failed` while the
            # Machine remains `created`. Never publish that unusable target to
            # the boot-config barrier: reap it under this run's durable
            # ownership and spend the next bounded clone attempt instead.
            while ! machine_storage_ready "$target_id"; do
                if machine_storage_failed "$target_id"; then
                    printf 'clone id=%s snapshot storage entered terminal failed state\n' \
                        "$target_id" >> "$diagnostic_log"
                    if ! reap_machine "$target_id" "" "$target_volume"; then
                        echo "❌ failed snapshot clone $target_id could not be reaped; retaining ownership and refusing another allocation" >&2
                        return 1
                    fi
                    reap_volume "$target_volume" || return 1
                    fleet_audit_update_fresh_clone "$target_name" "$target_id" "$target_volume" \
                        destroyed-verified-absent || return 1
                    fleet_registry_release_id "$target_id" || return 1
                    grep -Fxv "$target_id" "$ledger" > "$ledger.tmp.$$" 2>/dev/null || true
                    mv "$ledger.tmp.$$" "$ledger"
                    clone_out="$clone_out
Error: snapshot storage entered terminal failed state"
                    clone_status=75
                    target_id=""
                    break
                fi
                if [ "$SECONDS" -ge "$storage_deadline" ]; then
                    echo "❌ clone $target_id snapshot storage was not mountable within the provisioning deadline; retaining ownership" >&2
                    return 1
                fi
                sleep 2
            done
            if [ -n "$target_id" ]; then
                # Storage readiness proves the forked volume is now visible.
                # Refresh the exact per-owner volume attribution before handing
                # the machine to any caller; forced recovery never sweeps
                # unattached volumes belonging to neighboring workstreams.
                if ! fleet_registry_record_id "$target_name" "$target_id" "$target_volume"; then
                    echo "❌ clone $target_id became storage-ready without durable volume ownership" >&2
                    return 1
                fi
                printf '%s' "$target_id"
                return 0
            fi
        fi
        if [ "$attempt" -ge "$max_attempts" ]; then
            echo "❌ Fly clone did not return a distinct authoritative target after $attempt attempt(s) (last name=$target_name, source=$source_id, status=$clone_status)" >&2
            printf '%s\n' "$clone_out" | sed 's/^/   /' >&2
            return 1
        fi
        # Exponential backoff + jitter. Fly returns `resource_exhausted: rate limit
        # exceeded` on clone/create-volume when the fleet fires N clones at once; a
        # FIXED short delay makes every retry land back inside the SAME saturation
        # window, so a few clones exhaust their attempts and drop out of the batch
        # (an infra loss, not a benchmark verdict — it silently shrinks coverage).
        # Backing off exponentially with jitter lets a rate-limited clone outlast
        # the burst instead of giving up.
        local this_delay cap="${CLOUDBENCH_CLONE_RETRY_MAX_SECONDS:-90}"
        this_delay=$(( retry_delay * (1 << (attempt - 1)) ))
        [ "$this_delay" -gt "$cap" ] && this_delay="$cap"
        this_delay=$(( this_delay + (RANDOM % 5) ))
        echo "⏳ transient clone failure (attempt $attempt/$max_attempts, status=$clone_status); retrying in ${this_delay}s ..." >&2
        sleep "$this_delay"
        attempt=$((attempt + 1))
    done
}

pool_ledger_lock_acquire() {  # serialize read-modify-write of the shared pool ledger
    # Concurrent provisioners each rewrite POOL_IDS_FILE with tmp+mv; without a
    # lock the later rename silently drops the earlier appender's ID, releasing
    # that machine from fleet ownership with no durable ledger entry. mkdir is an
    # atomic cross-process gate on the shared git-common filesystem.
    local lock="$POOL_IDS_LOCK" tmp
    for _ in $(seq 1 100); do
        if mkdir "$lock" 2>/dev/null; then
            tmp="$lock/meta.tmp.$$"
            {
                printf 'host=%s\n' "$FLEET_OWNER_HOST"
                printf 'pid=%s\n' "$$"
                printf 'pid_start=%s\n' "$FLEET_OWNER_PID_START"
            } > "$tmp" && mv "$tmp" "$lock/meta" && return 0
            rm -rf "$lock"
        fi
        # Break a same-host lock whose owner is provably dead so a crashed
        # provisioner cannot wedge the ledger forever.
        if [ -f "$lock/meta" ]; then
            registry_owner_alive "$lock/meta"
            [ $? -eq 1 ] && { rm -rf "$lock"; continue; }
        fi
        sleep 0.1
    done
    echo "❌ timed out acquiring pool ledger lock: $lock" >&2
    return 1
}

pool_ledger_lock_release() { rm -rf "$POOL_IDS_LOCK"; }

pool_ledger_record_id() {  # pool_ledger_record_id <machine-id>; atomic + verified + serialized
    local id="$1" tmp="$POOL_IDS_FILE.tmp.$$" rc=0
    case "$id" in ''|*[!0-9a-f]*) return 1 ;; esac
    pool_ledger_lock_acquire || return 1
    if [ ! -f "$POOL_IDS_FILE" ]; then
        rc=1
    elif ! {
        grep -Fxv "$id" "$POOL_IDS_FILE" 2>/dev/null || true
        printf '%s\n' "$id"
    } > "$tmp"; then
        rm -f "$tmp"
        rc=1
    elif ! mv "$tmp" "$POOL_IDS_FILE" \
        || [ ! -f "$POOL_IDS_FILE" ] \
        || ! grep -Fxq "$id" "$POOL_IDS_FILE"; then
        rm -f "$tmp"
        rc=1
    fi
    pool_ledger_lock_release
    return "$rc"
}

pool_ledger_remove_id() {  # pool_ledger_remove_id <machine-id>; atomic + verified + serialized
    local id="$1" tmp="$POOL_IDS_FILE.tmp.$$" rc=0
    case "$id" in ''|*[!0-9a-f]*) return 1 ;; esac
    pool_ledger_lock_acquire || return 1
    if [ ! -f "$POOL_IDS_FILE" ]; then
        rc=1
    elif ! grep -Fxv "$id" "$POOL_IDS_FILE" > "$tmp" 2>/dev/null; then
        # grep returns 1 when removing the only line, which is still a valid
        # empty pool ledger.
        : > "$tmp"
    fi
    if [ "$rc" = "0" ] && { ! mv "$tmp" "$POOL_IDS_FILE" \
        || grep -Fxq "$id" "$POOL_IDS_FILE" 2>/dev/null; }; then
        rm -f "$tmp"
        rc=1
    fi
    pool_ledger_lock_release
    return "$rc"
}

pool_ledger_remove_id_from() {  # <exact-pool-ledger> <machine-id>
    local ledger="$1" id="$2" save_ids="$POOL_IDS_FILE" save_lock="$POOL_IDS_LOCK" rc=0
    python3 - "$ledger" "$GIT_COMMON_DIR/cloudbench-pools" <<'PY' || return 1
import re
import sys
from pathlib import Path
ledger, root = map(Path, sys.argv[1:])
if (
    not ledger.is_absolute() or ledger.parent != root
    or not re.fullmatch(r"[A-Za-z0-9._-]+\.ids", ledger.name)
    or ledger.is_symlink() or not ledger.is_file()
):
    raise SystemExit(1)
PY
    POOL_IDS_FILE="$ledger"; POOL_IDS_LOCK="$ledger.lock"
    pool_ledger_remove_id "$id" || rc=$?
    POOL_IDS_FILE="$save_ids"; POOL_IDS_LOCK="$save_lock"
    return "$rc"
}

pool_machine_guest_corruption_signature() {  # <fleet-child.log>
    local log="$1"
    # One application process can legitimately segfault. Multiple unrelated
    # image utilities failing with different memory-access signals on one guest
    # is a high-confidence corrupt VM/rootfs/runtime signature.
    grep -aEq 'Bus error.*[[:space:]]fuser([[:space:]]|$)' "$log" 2>/dev/null \
        && grep -aEq 'Segmentation fault.*[[:space:]]dropdb([[:space:]]|$)' "$log" 2>/dev/null
}

record_tainted_claimed_pool_machines() {
    local j src id log
    for j in "${!CHILD_OUT[@]}"; do
        log="${CHILD_OUT[$j]}/remote-logs/cloudbench-driver.log"
        [ -f "$log" ] || log="${CHILD_OUT[$j]}/fleet-child.log"
        pool_machine_guest_corruption_signature "$log" || continue
        read -r src id < "${CHILD_OUT[$j]}/.cid" 2>/dev/null || true
        [ "$src" = "pool" ] && [ -n "$id" ] || continue
        grep -Fxq "$id" "$TAINTED_POOL_FILE" 2>/dev/null \
            || printf '%s\n' "$id" >> "$TAINTED_POOL_FILE"
        echo "☣️  [${CHILD_BENCH[$j]}] quarantining corrupt pool machine $id (fuser SIGBUS + dropdb SIGSEGV)" >&2
    done
}

provision_pool_slot() {  # provision_pool_slot <slot> <total>
    local i="$1" n="$2" id ready=0 st="" slot_ledger claim_path clone_name volume_id
    local claim_digest
    slot_ledger="$FLEET_DIR/pool-provision-$i.ids"
    if ! id="$(clone_machine_target "$slot_ledger")" || [ -z "$id" ]; then
        echo "  [$i/$n] ⚠ clone failed"
        return 1
    fi
    echo "  [$i/$n] created $id"
    for _ in $(seq 1 90); do
        st="$(snapshot_machine_state "$id")" || st=""
        if printf '%s' "$st" | grep -qiE '^(started|stopped)$'; then
            ready=1
            break
        fi
        if machine_storage_ready "$id"; then
            FLY machine start "$id" -a "$APP" >/dev/null 2>&1 || true
        fi
        sleep 5
    done
    if [ "$ready" != "1" ]; then
        echo "  ⚠ $id never became startable"
        return 1
    fi
    FLY machine stop "$id" -a "$APP" >/dev/null 2>&1 || true
    for _ in $(seq 1 "${CLOUDBENCH_POOL_STOP_ATTEMPTS:-30}"); do
        if st="$(snapshot_machine_state "$id")" && [ "$st" = "stopped" ]; then
            break
        fi
        sleep 2
    done
    if [ "$st" != "stopped" ]; then
        echo "  ⚠ $id did not verify stopped; retaining fleet ownership for teardown" >&2
        return 1
    fi
    # clone_machine_target removes its transient attempted-name ledger after it
    # binds an allocated Machine ID. Resolve the name from the durable O(1)
    # audit index instead; reading the emptied transient ledger here made every
    # successful provision silently drop out before ownership transfer.
    clone_name="$(cat "$FLEET_TEARDOWN_OWNERSHIP_DIR/by-machine-id/$id" 2>/dev/null)"
    case "$clone_name" in
        cloudbench-[a-zA-Z0-9._-]*) ;;
        *) echo "  ⚠ missing exact audit clone-name index for $id; retaining fleet ownership" >&2
           return 1 ;;
    esac
    case "$clone_name" in
        *[!a-zA-Z0-9._-]*)
            echo "  ⚠ invalid audit clone-name index for $id; retaining fleet ownership" >&2
            return 1 ;;
    esac
    volume_id="$(registry_meta_value "$FLEET_REGISTRY_DIR/clones/$clone_name" volume_id)"
    case "$volume_id" in
        ''|*[!a-zA-Z0-9_-]*)
            echo "  ⚠ missing exact registry volume for $id; retaining fleet ownership" >&2
            return 1 ;;
    esac
    claim_path="$POOL_CLAIMS_DIR/$id"
    # Make the prospective pool member unavailable before it becomes visible
    # in the shared ledger. This exact owner claim bridges every crash boundary
    # until registry release and the terminal audit transition both succeed.
    if ! write_pool_transfer_claim "$claim_path" "$id" "$clone_name" "$volume_id"; then
        echo "  ⚠ failed to install transfer claim for $id; retaining fleet ownership" >&2
        return 1
    fi
    claim_digest="$(cloudbench_env_sha256 "$claim_path")" || return 1
    if ! pool_ledger_record_id "$id"; then
        echo "  ⚠ failed to persist $id in durable pool ledger; retaining fleet ownership for teardown" >&2
        pool_claim_release_exact "$claim_path" "$claim_digest" "$FLEET_OWNER_TOKEN" \
            "$FLEET_OWNER_HOST" "$$" "$FLEET_OWNER_PID_START" || true
        return 1
    fi
    if ! fleet_audit_update_fresh_clone "$clone_name" "$id" "" transfer-pending-stopped; then
        echo "  ⚠ failed to persist $id pending ownership transfer; retaining exact claim" >&2
        if pool_ledger_remove_id "$id"; then
            pool_claim_release_exact "$claim_path" "$claim_digest" "$FLEET_OWNER_TOKEN" \
                "$FLEET_OWNER_HOST" "$$" "$FLEET_OWNER_PID_START" || true
        fi
        return 1
    fi
    if ! fleet_registry_release_exact_clone "$clone_name" "$id"; then
        echo "  ⚠ failed to release $id registry ownership; retaining exact transfer claim" >&2
        return 1
    fi
    if ! fleet_audit_record_pool_handoff "$claim_path" "$clone_name" "$id" "$volume_id"; then
        echo "  ⚠ failed to seal $id exact pool handoff; retaining exact transfer claim" >&2
        return 1
    fi
    if ! fleet_audit_update_fresh_clone "$clone_name" "$id" "" transferred-to-pool-stopped; then
        echo "  ⚠ failed to terminalize $id pool transfer; retaining exact transfer claim" >&2
        return 1
    fi
    pool_claim_release_exact "$claim_path" "$claim_digest" "$FLEET_OWNER_TOKEN" \
        "$FLEET_OWNER_HOST" "$$" "$FLEET_OWNER_PID_START" || return 1
    rm -f "$slot_ledger" "${slot_ledger%.ids}.names" || return 1
    echo "  ✅ pooled (stopped): $id"
}

provision_pool() {  # provision_pool <N> — create N stopped clones concurrently
    local n="$1" i pid failed=0
    local -a pool_pids=()
    mkdir -p "$(dirname "$POOL_IDS_FILE")" \
        || { echo "❌ could not initialize durable pool ledger $POOL_IDS_FILE" >&2; return 1; }
    if [ -e "$POOL_IDS_FILE" ]; then
        [ -f "$POOL_IDS_FILE" ] \
            || { echo "❌ durable pool ledger is not a regular file: $POOL_IDS_FILE" >&2; return 1; }
    else
        : > "$POOL_IDS_FILE" \
            || { echo "❌ could not initialize durable pool ledger $POOL_IDS_FILE" >&2; return 1; }
    fi
    # Publish the immutable dependency baseline before any concurrent slot can
    # transfer out of the fresh-clone registry. Each pending claim captures its
    # exact path and digest for crash recovery.
    printf '%s %s %s\n' "$CURRENT_NODE_FP" "$CURRENT_PY_FP" "$SNAP_ID" \
        > "$POOL_META_FILE.tmp.$$" \
        && mv "$POOL_META_FILE.tmp.$$" "$POOL_META_FILE" \
        || return 1
    echo "🏊 Provisioning pool of $n stopped machines (image = warm $WARM_ID, snapshot $SNAP_ID, region $REGION)..."
    echo "⏳ cloning, provisioning, and stopping all pool slots concurrently..."
    for i in $(seq 1 "$n"); do
        provision_pool_slot "$i" "$n" &
        pid=$!
        pool_pids+=("$pid")
        PROVISION_PIDS+=("$pid")
        sleep "${CLOUDBENCH_CLONE_LAUNCH_STAGGER_SECONDS:-0.4}"
    done
    for pid in "${pool_pids[@]}"; do
        wait "$pid" || failed=1
    done
    # Every provision child is reaped. Drop stale numeric PIDs immediately so
    # a later controller cleanup cannot signal an unrelated PID-reuse occupant.
    PROVISION_PIDS=()
    echo "✅ pool ready: $(grep -c . "$POOL_IDS_FILE" 2>/dev/null || echo 0) machines → $POOL_IDS_FILE"
    [ "$failed" = "0" ]
}

CLAIMED_POOL_FILE="$FLEET_DIR/claimed-pool.ids"
UNAVAILABLE_POOL_IDS=()
# A claim records host + PID birth identity, not PID alone: PID reuse must never
# authorize stopping a live pool machine or make a dead claim look current. It
# also links to the durable fleet registry so a successor can see an
# unconfirmed-cleanup sentinel even if SIGKILL lands before the claim rewrite.
write_pool_claim() {  # <claim-path> <machine-id> <volume-id>; atomic no-clobber
    local claim_path="$1" id="$2" volume_id="$3" pool_meta_sha256
    case "$id" in ''|*[!0-9a-f]*) return 1 ;; esac
    case "$volume_id" in ''|*[!a-zA-Z0-9_-]*) return 1 ;; esac
    [ -f "$POOL_IDS_FILE" ] && [ -f "$POOL_META_FILE" ] || return 1
    pool_meta_sha256="$(cloudbench_env_sha256 "$POOL_META_FILE")" || return 1
    pool_claim_fs_transaction publish-ordinary "$claim_path" "$id" "$volume_id" \
        "$FLEET_OWNER_HOST" "$$" "$FLEET_OWNER_PID_START" "$FLEET_OWNER_TOKEN" \
        "$POOL_IDS_FILE" "$POOL_META_FILE" "$pool_meta_sha256"
}

write_pool_transfer_claim() {  # <claim-path> <machine-id> <clone-name> <volume-id>; atomic no-clobber
    local claim_path="$1" id="$2" clone_name="$3" volume_id="$4" pool_meta_sha256
    case "$id" in ''|*[!0-9a-f]*) return 1 ;; esac
    case "$clone_name" in cloudbench-*) ;; *) return 1 ;; esac
    case "$clone_name" in *[!a-zA-Z0-9._-]*) return 1 ;; esac
    case "$volume_id" in ''|*[!a-zA-Z0-9_-]*) return 1 ;; esac
    # Require the immutable deps baseline, not the ids ledger itself. The claim
    # is installed before pool_ledger_record_id precisely so a sabotaged or
    # raced ledger file still leaves an exact transfer claim for teardown; the
    # ledger path is recorded as text and validated when the append runs.
    [ -f "$POOL_META_FILE" ] || return 1
    pool_meta_sha256="$(cloudbench_env_sha256 "$POOL_META_FILE")" || return 1
    pool_claim_fs_transaction publish-transfer "$claim_path" "$id" "$clone_name" \
        "$volume_id" "$FLEET_OWNER_HOST" "$$" "$FLEET_OWNER_PID_START" \
        "$FLEET_OWNER_TOKEN" "$POOL_IDS_FILE" "$POOL_META_FILE" "$pool_meta_sha256"
}

pool_claim_owned_by_current() {  # pool_claim_owned_by_current <claim-path>
    local claim_path="$1"
    [ "$(registry_meta_value "$claim_path" host)" = "$FLEET_OWNER_HOST" ] \
        && [ "$(registry_meta_value "$claim_path" pid)" = "$$" ] \
        && [ "$(registry_meta_value "$claim_path" pid_start)" = "$FLEET_OWNER_PID_START" ]
}

pool_transfer_claim_registry_contains_id() {  # <claim-path> <machine-id>
    local claim_path="$1" id="$2" token registry record clone_name
    token="$(registry_meta_value "$claim_path" fleet_owner_token)"
    case "$token" in ''|*[!0-9a-f]*) return 2 ;; esac
    [ "${#token}" -eq 32 ] || return 2
    registry="$FLEET_OWNERSHIP_ROOT/$token"
    [ "${registry%/*}" = "${FLEET_OWNERSHIP_ROOT%/}" ] || return 2
    clone_name="$(registry_meta_value "$claim_path" clone_name)"
    case "$clone_name" in cloudbench-*) ;; *) return 2 ;; esac
    case "$clone_name" in *[!a-zA-Z0-9._-]*) return 2 ;; esac
    record="$registry/clones/$clone_name"
    [ -e "$record" ] || return 1
    [ -f "$record" ] && [ ! -L "$record" ] \
        && [ "$(registry_meta_value "$record" name)" = "$clone_name" ] \
        && [ "$(registry_meta_value "$record" id)" = "$id" ] || return 2
    return 0
}

reconcile_current_pool_transfer_claims() {
    local claim_path id clone_name record disposition volume_id claim_digest
    for claim_path in "$POOL_CLAIMS_DIR"/*; do
        [ -f "$claim_path" ] || continue
        [ "$(registry_meta_value "$claim_path" transfer_state)" = "pending" ] || continue
        [ "$(registry_meta_value "$claim_path" fleet_owner_token)" = "$FLEET_OWNER_TOKEN" ] \
            || continue
        claim_digest="$(cloudbench_env_sha256 "$claim_path")" || return 1
        id="$(registry_meta_value "$claim_path" machine_id)"
        [ "${claim_path##*/}" = "$id" ] || return 1
        if pool_transfer_claim_registry_contains_id "$claim_path" "$id"; then
            return 1
        elif [ $? -ne 1 ]; then
            return 1
        fi
        clone_name="$(cat "$FLEET_TEARDOWN_OWNERSHIP_DIR/by-machine-id/$id" 2>/dev/null)"
        record="$FLEET_TEARDOWN_OWNERSHIP_DIR/fresh/$clone_name"
        [ -f "$record" ] && [ "$(registry_meta_value "$record" machine_id)" = "$id" ] \
            || return 1
        disposition="$(registry_meta_value "$record" disposition)"
        volume_id="$(registry_meta_value "$record" volume_id)"
        if [ "$disposition" = "transferred-to-pool-stopped" ]; then
            pool_claim_release_exact "$claim_path" "$claim_digest" "$FLEET_OWNER_TOKEN" \
                "$FLEET_OWNER_HOST" "$$" "$FLEET_OWNER_PID_START" || return 1
            continue
        fi
        case "$disposition" in owned|transfer-pending-stopped|destroyed-verified-absent) ;; *) return 1 ;; esac
        reap_machine "$id" "" "$volume_id" || return 1
        pool_ledger_remove_id "$id" || return 1
        if [ "$disposition" != "destroyed-verified-absent" ]; then
            fleet_audit_update_fresh_clone "$clone_name" "$id" "$volume_id" \
                destroyed-verified-absent || return 1
        fi
        pool_claim_release_exact "$claim_path" "$claim_digest" "$FLEET_OWNER_TOKEN" \
            "$FLEET_OWNER_HOST" "$$" "$FLEET_OWNER_PID_START" || return 1
    done
}

reconcile_current_pool_claims() {
    local claim_path token
    for claim_path in "$POOL_CLAIMS_DIR"/*; do
        [ -f "$claim_path" ] || continue
        [ -z "$(registry_meta_value "$claim_path" transfer_state)" ] || continue
        token="$(registry_meta_value "$claim_path" fleet_owner_token)"
        [ "$token" = "$FLEET_OWNER_TOKEN" ] || continue
        recover_one_exact_pool_claim "$claim_path" "$FLEET_OWNER_TOKEN" \
            "$FLEET_OWNER_HOST" "$$" "$FLEET_OWNER_PID_START" || return 1
    done
}

# 0=quarantined, 1=ordinary/legacy claim, 2=malformed linked claim. Both the
# per-claim bit and its linked registry sentinel are authoritative: the latter
# closes the crash window between fleet retention and the claim rewrite.
pool_claim_cleanup_unconfirmed() {  # <claim-path>
    local claim_path="$1" cleanup_state owner_token registry
    cleanup_state="$(registry_meta_value "$claim_path" cleanup_state)"
    owner_token="$(registry_meta_value "$claim_path" fleet_owner_token)"
    [ "$cleanup_state" = "unconfirmed" ] && return 0
    if [ -z "$cleanup_state" ] && [ -z "$owner_token" ]; then
        return 1
    fi
    [ "$cleanup_state" = "owned" ] || return 2
    case "$owner_token" in ''|*[!0-9a-f]*) return 2 ;; esac
    [ "${#owner_token}" -eq 32 ] || return 2
    registry="$FLEET_OWNERSHIP_ROOT/$owner_token"
    [ "${registry%/*}" = "${FLEET_OWNERSHIP_ROOT%/}" ] || return 2
    [ -e "$registry/guest-cleanup-unconfirmed" ] && return 0
    return 1
}

pool_claim_mark_cleanup_unconfirmed() {  # <claim-path>
    local claim_path="$1" claim_digest id="${1##*/}"
    [ -f "$claim_path" ] && [ ! -L "$claim_path" ] || return 1
    claim_digest="$(cloudbench_env_sha256 "$claim_path")" || return 1
    pool_claim_fs_transaction mark-unconfirmed "$claim_path" "$id" "$claim_digest" \
        "$FLEET_OWNER_HOST" "$$" "$FLEET_OWNER_PID_START" "$FLEET_OWNER_TOKEN" \
        || return 1
    pool_claim_cleanup_unconfirmed "$claim_path"
}

# Self-heal a same-host dead claim only after proving the remote runner is idle.
# Live/other-host owners remain unavailable; an unreadable or busy dead claim
# blocks provisioning rather than risking interruption or compounding spend.
pool_machine_state_from_json() {  # pool_machine_state_from_json <id>; JSON on stdin
    local id="$1"
    MACHINE_ID="$id" python3 -c '
import json, os, sys
try:
    machines = json.load(sys.stdin)
except (TypeError, ValueError):
    raise SystemExit(2)
if not isinstance(machines, list) or any(not isinstance(machine, dict) for machine in machines):
    raise SystemExit(2)
machine = next((item for item in machines if item.get("id") == os.environ["MACHINE_ID"]), None)
if machine is None:
    raise SystemExit(1)
state = machine.get("state")
if not isinstance(state, str) or not state:
    raise SystemExit(2)
print(state)
'
}
pool_machine_state() {  # pool_machine_state <id>: prints state; 1=absent, 2=invalid read
    local id="$1" machines
    export -n machines 2>/dev/null || true
    machines="$(FLY machines list -a "$APP" --json 2>/dev/null)" || return 2
    printf '%s' "$machines" | pool_machine_state_from_json "$id"
}

POOL_INVENTORY_JSON=""
reconcile_pool() {
    local pool_file id st presence claim_path claim_host claim_pid claim_start claim_token
    local owner_status runner_count machines cleanup_status claim_digest
    export -n machines POOL_INVENTORY_JSON 2>/dev/null || true
    # Normal reconciliation is one shared inventory read, not one Machines-API
    # list per pooled box. Only the rare stop-and-recover branch re-reads live
    # state for the single machine being changed.
    machines="$(FLY machines list -a "$APP" --json 2>/dev/null)" || {
        echo "❌ could not read pool inventory before refresh" >&2
        return 1
    }
    POOL_INVENTORY_JSON="$machines"
    for pool_file in "$GIT_COMMON_DIR"/cloudbench-pools/*.ids; do
      [ -f "$pool_file" ] || continue
      while read -r id; do
        [ -n "$id" ] || continue
        st="$(printf '%s' "$machines" | pool_machine_state_from_json "$id")"
        presence=$?
        [ "$presence" -eq 1 ] && continue
        [ "$presence" -eq 0 ] || { echo "❌ could not read pool machine $id before refresh" >&2; return 1; }
        [ "$st" = "stopped" ] && continue
        case "$st" in
            created|replacing|started|starting|stopping)
                claim_path="$POOL_CLAIMS_DIR/$id"
                if [ -f "$claim_path" ]; then
                    claim_digest="$(cloudbench_env_sha256 "$claim_path")" || return 1
                    if pool_claim_cleanup_unconfirmed "$claim_path"; then
                        UNAVAILABLE_POOL_IDS+=("$id")
                        echo "  ↪️  pool machine $id is $st; leaving cleanup-quarantined claim untouched"
                        continue
                    else
                        cleanup_status=$?
                        [ "$cleanup_status" -eq 1 ] || {
                            echo "❌ pool machine $id has malformed cleanup ownership; refusing to provision" >&2
                            return 1
                        }
                    fi
                    claim_host="$(registry_meta_value "$claim_path" host)"
                    claim_pid="$(registry_meta_value "$claim_path" pid)"
                    claim_start="$(registry_meta_value "$claim_path" pid_start)"
                    claim_token="$(registry_meta_value "$claim_path" fleet_owner_token)"
                    registry_owner_alive "$claim_path"
                    owner_status=$?
                    if [ "$owner_status" -eq 0 ]; then
                        UNAVAILABLE_POOL_IDS+=("$id")
                        echo "  ↪️  pool machine $id is $st; leaving live claim owner untouched"
                        continue
                    fi
                    if [ "$owner_status" -eq 2 ]; then
                        if [ -n "$claim_host" ] && [ "$claim_host" != "$FLEET_OWNER_HOST" ]; then
                            UNAVAILABLE_POOL_IDS+=("$id")
                            echo "  ↪️  pool machine $id is $st; leaving other-host claim untouched"
                            continue
                        fi
                        echo "❌ pool machine $id has an invalid same-host claim; refusing to provision" >&2
                        return 1
                    fi
                    [ "$st" = "started" ] || {
                        echo "❌ dead-claimed pool machine $id is transitional ($st); refusing to provision" >&2
                        return 1
                    }
                    runner_count="$(registry_runner_count "$id")" || {
                        echo "❌ dead-claimed pool machine $id runner probe unreadable; refusing to provision" >&2
                        return 1
                    }
                    [ "$runner_count" = "0" ] || {
                        echo "❌ dead-claimed pool machine $id still has runner count=$runner_count; refusing to provision" >&2
                        return 1
                    }
                    echo "↩️  recovering dead-claimed idle pool machine $id"
                    if [ -n "$claim_token" ]; then
                        recover_one_exact_pool_claim "$claim_path" "$claim_token" \
                            "$claim_host" "$claim_pid" "$claim_start" || return 1
                    else
                        # Legacy claims contain no audit linkage. Preserve their
                        # historical stop-and-release behavior; every new claim
                        # is exact-audit-bound above.
                        FLY machine stop "$id" -a "$APP" >/dev/null 2>&1 || true
                        for _ in $(seq 1 "${CLOUDBENCH_POOL_STOP_ATTEMPTS:-30}"); do
                            if st="$(pool_machine_state "$id")" && [ "$st" = "stopped" ]; then
                                break
                            fi
                            sleep 2
                        done
                        [ "$st" = "stopped" ] || return 1
                        pool_claim_release_exact "$claim_path" "$claim_digest" "" \
                            "$claim_host" "$claim_pid" "$claim_start" || return 1
                    fi
                    continue
                fi
                UNAVAILABLE_POOL_IDS+=("$id")
                echo "  ↪️  pool machine $id is $st without a verifiable claim; leaving untouched"
                continue
                ;;
            *)
            echo "❌ pool machine $id has unsafe pre-refresh state '$st'" >&2
            return 1
        esac
      done < "$pool_file"
    done
}

pool_machine_shape_from_json() {  # pool_machine_shape_from_json <id>; JSON on stdin
    local id="$1"
    MACHINE_ID="$id" python3 -c '
import json, os, sys
try: machines = json.load(sys.stdin) or []
except Exception: raise SystemExit(2)
machine = next((m for m in machines if m.get("id") == os.environ["MACHINE_ID"]), None)
if not machine: raise SystemExit(1)
guest = (machine.get("config") or {}).get("guest") or {}
print(machine.get("state") or "", guest.get("cpu_kind") or "", guest.get("cpus") or "", guest.get("memory_mb") or "")
'
}

resize_pool_machine() {  # resize_pool_machine <id>
    local id="$1" attempt log
    log="$FLEET_DIR/pool-resize-$id.log"
    for attempt in $(seq 1 "${CLOUDBENCH_POOL_RESIZE_ATTEMPTS:-5}"); do
        if fly_with_timeout "${CLOUDBENCH_POOL_RESIZE_TIMEOUT_SECONDS:-90}" \
            machine update "$id" -a "$APP" --vm-size "$FLEET_PRIMARY_VM_SIZE" \
            --vm-memory "$FLEET_PRIMARY_VM_MEMORY" --skip-start --yes > "$log" 2>&1; then
            return 0
        fi
        sleep $((attempt * 3))
    done
    echo "❌ could not resize stopped pool machine $id to $FLEET_PRIMARY_VM_SIZE/${FLEET_PRIMARY_VM_MEMORY}MB" >&2
    tail -20 "$log" 2>/dev/null | sed 's/^/   /' >&2 || true
    return 1
}

normalize_current_pool_shape() {
    local id shape state kind cpus memory failed=0 inventory
    local target_kind="shared" target_cpus
    local -a resize_ids=() resize_pids=()
    export -n inventory POOL_INVENTORY_JSON 2>/dev/null || true
    [ -f "$POOL_IDS_FILE" ] || return 0
    target_cpus="$(printf '%s' "$FLEET_PRIMARY_VM_SIZE" | sed -nE 's/.*-([0-9]+)x$/\1/p')"
    case "$FLEET_PRIMARY_VM_SIZE" in performance-*) target_kind="performance" ;; esac
    [ -n "$target_cpus" ] || { echo "❌ invalid fleet primary VM size: $FLEET_PRIMARY_VM_SIZE" >&2; return 1; }
    inventory="$POOL_INVENTORY_JSON"
    [ -n "$inventory" ] || inventory="$(FLY machines list -a "$APP" --json 2>/dev/null)" || return 1
    while read -r id; do
        [ -n "$id" ] || continue
        shape="$(printf '%s' "$inventory" | pool_machine_shape_from_json "$id")" || continue
        read -r state kind cpus memory <<< "$shape"
        [ "$state" = "stopped" ] || continue
        if [ "$kind" != "$target_kind" ] || [ "$cpus" != "$target_cpus" ] \
            || [ "$memory" != "$FLEET_PRIMARY_VM_MEMORY" ]; then
            resize_ids+=("$id")
        fi
    done < "$POOL_IDS_FILE"
    [ "${#resize_ids[@]}" -gt 0 ] || return 0
    echo "🧮 resizing ${#resize_ids[@]} stopped pool machine(s) to capacity-safe $FLEET_PRIMARY_VM_SIZE/${FLEET_PRIMARY_VM_MEMORY}MB..."
    mkdir -p "$FLEET_DIR"
    for id in "${resize_ids[@]}"; do
        resize_pool_machine "$id" &
        resize_pids+=("$!")
        if [ "${#resize_pids[@]}" -ge "${CLOUDBENCH_POOL_RESIZE_CONCURRENCY:-8}" ]; then
            for _pid in "${resize_pids[@]}"; do wait "$_pid" || failed=1; done
            resize_pids=()
        fi
    done
    for _pid in "${resize_pids[@]}"; do wait "$_pid" || failed=1; done
    [ "$failed" = "0" ] || return 1
    inventory="$(FLY machines list -a "$APP" --json 2>/dev/null)" || return 1
    for id in "${resize_ids[@]}"; do
        shape="$(printf '%s' "$inventory" | pool_machine_shape_from_json "$id")" || return 1
        read -r state kind cpus memory <<< "$shape"
        if [ "$state" != "stopped" ] || [ "$kind" != "$target_kind" ] \
            || [ "$cpus" != "$target_cpus" ] || [ "$memory" != "$FLEET_PRIMARY_VM_MEMORY" ]; then
            echo "❌ pool machine $id shape verification failed: $shape" >&2
            return 1
        fi
    done
    POOL_INVENTORY_JSON="$inventory"
    echo "✅ pool shape verified: $FLEET_PRIMARY_VM_SIZE/${FLEET_PRIMARY_VM_MEMORY}MB"
}
claim_pool_machine() {  # echo a claimed stopped pool machine id (or '' if none free)
    [ -f "$POOL_IDS_FILE" ] || return 0
    local id volume_id claim_path owner_status claim_host claim_pid claim_start claim_token cleanup_status
    local claim_digest
    mkdir -p "$POOL_CLAIMS_DIR" "$(dirname "$CLAIMED_POOL_FILE")"
    while read -r id; do
        [ -n "$id" ] || continue
        case "$id" in *[!0-9a-f]*) continue ;; esac
        case " ${UNAVAILABLE_POOL_IDS[*]:-} " in *" $id "*) continue ;; esac
        grep -Fxq "$id" "$CLAIMED_POOL_FILE" 2>/dev/null && continue
        claim_path="$POOL_CLAIMS_DIR/$id"
        if [ -f "$claim_path" ]; then
            if [ "$(registry_meta_value "$claim_path" transfer_state)" = "pending" ]; then
                claim_host="$(registry_meta_value "$claim_path" host)"
                registry_owner_alive "$claim_path"
                owner_status=$?
                if [ "$owner_status" -eq 0 ]; then
                    continue
                fi
                if [ "$owner_status" -ne 1 ] || [ "$claim_host" != "$FLEET_OWNER_HOST" ]; then
                    echo "  ⚠️  unverifiable pool transfer claim for $id; leaving unavailable" >&2
                    continue
                fi
                pool_transfer_claim_registry_contains_id "$claim_path" "$id"
                cleanup_status=$?
                if [ "$cleanup_status" -eq 0 ]; then
                    echo "  ↪️  pool machine $id remains under stale fleet registry ownership" >&2
                    continue
                fi
                if [ "$cleanup_status" -ne 1 ]; then
                    echo "  ⚠️  malformed pool transfer claim for $id; leaving unavailable" >&2
                    continue
                fi
                # Registry release committed before the provisioner died. The
                # audit+claim bridge must terminalize before availability.
                claim_pid="$(registry_meta_value "$claim_path" pid)"
                claim_start="$(registry_meta_value "$claim_path" pid_start)"
                claim_token="$(registry_meta_value "$claim_path" fleet_owner_token)"
                recover_one_exact_pool_claim "$claim_path" "$claim_token" \
                    "$claim_host" "$claim_pid" "$claim_start" || continue
                continue
            fi
            if pool_claim_cleanup_unconfirmed "$claim_path"; then
                echo "  ↪️  pool machine $id remains quarantined pending guest cleanup recovery" >&2
                continue
            else
                cleanup_status=$?
                [ "$cleanup_status" -eq 1 ] || {
                    echo "  ⚠️  malformed cleanup ownership for pool claim $id; leaving unavailable" >&2
                    continue
                }
            fi
            claim_host="$(registry_meta_value "$claim_path" host)"
            claim_pid="$(registry_meta_value "$claim_path" pid)"
            claim_start="$(registry_meta_value "$claim_path" pid_start)"
            claim_token="$(registry_meta_value "$claim_path" fleet_owner_token)"
            registry_owner_alive "$claim_path"
            owner_status=$?
            [ "$owner_status" -eq 0 ] && continue
            if [ "$owner_status" -eq 1 ]; then
                if [ -n "$claim_token" ]; then
                    recover_one_exact_pool_claim "$claim_path" "$claim_token" \
                        "$claim_host" "$claim_pid" "$claim_start" || continue
                fi
                # Recovery is a separate availability transition. Never claim
                # the same ID in this iteration or unlink an unaudited legacy
                # claim; a subsequent inventory pass can admit the exact box.
                continue
            fi
            if [ "$owner_status" -eq 2 ]; then
                # An other-host or malformed claim is not ours to steal.
                [ -n "$claim_host" ] || echo "  ⚠️  invalid pool claim for $id; leaving unavailable" >&2
                continue
            fi
        fi
        # reconcile_pool already proved every eligible ledger machine stopped,
        # and pool creation proved its snapshot volume startable. Re-reading
        # machine+volume state for every one of 30 claims recreates the API burst
        # pooling is meant to eliminate. The atomic claim file is the only state
        # transition here; run-bench-cloud's update/start activates the box once.
        # claim_pool_machine is called through command substitution, so shell
        # arrays mutate in a subshell. Claim files are the cross-subshell and
        # cross-workspace ownership source of truth; creation is ATOMIC
        # (noclobber) so concurrent controllers can never claim the same
        # machine — the loser just moves on to the next candidate.
        volume_id="$(printf '%s' "$POOL_INVENTORY_JSON" \
            | machine_volume_id_from_json "$id" 2>/dev/null)" || volume_id=""
        if [ -z "$volume_id" ] || ! write_pool_claim "$claim_path" "$id" "$volume_id"; then
            echo "  ⚠️  pool machine $id has no durable exact teardown-manifest record; leaving it unclaimed" >&2
            continue
        fi
        claim_digest="$(cloudbench_env_sha256 "$claim_path")" || {
            echo "  ⚠️  pool machine $id claim digest is unreadable; retaining exact claim" >&2
            continue
        }
        if ! fleet_audit_record_pool_machine "$id" "$volume_id" claimed; then
            pool_claim_release_exact "$claim_path" "$claim_digest" "$FLEET_OWNER_TOKEN" \
                "$FLEET_OWNER_HOST" "$$" "$FLEET_OWNER_PID_START" || true
            echo "  ⚠️  pool machine $id has no durable exact teardown-manifest record; leaving it unclaimed" >&2
            continue
        fi
        if ! printf '%s\n' "$id" >> "$CLAIMED_POOL_FILE"; then
            recover_one_exact_pool_claim "$claim_path" "$FLEET_OWNER_TOKEN" \
                "$FLEET_OWNER_HOST" "$$" "$FLEET_OWNER_PID_START" || true
            continue
        fi
        printf '%s' "$id"; return 0
    done < "$POOL_IDS_FILE"
}

# ── One controller lock PER WORKSPACE (children run with --no-lock) ─────────
# Deliberately workspace-local: concurrent fleets from OTHER workspaces are
# supported (each owns only the machines it creates and never mutates shared
# app state), so no cross-workspace or cross-host lease is taken here.
if ! cloudbench_controller_lock_acquire_wait \
    "$LOCK_DIR" "${CLOUDBENCH_CONTROLLER_RETRY_SECONDS:-10}"; then
    echo "❌ Cloud benchmark controller lock failed." >&2
    exit 1
fi

if [ "$RECOVER_STALE_ONLY" = "1" ]; then
    recovery_status=0
    warm_pair="$(FLY machines list -a "$APP" --json 2>/dev/null | MN="$MACHINE_NAME" python3 -c '
import json
import os
import sys

try:
    machines = json.load(sys.stdin)
except (TypeError, ValueError, json.JSONDecodeError):
    raise SystemExit(2)
matches = [
    machine for machine in machines
    if isinstance(machine, dict) and machine.get("name") == os.environ["MN"]
]
if len(matches) != 1 or not isinstance(matches[0].get("id"), str):
    raise SystemExit(2)
mounts = (matches[0].get("config") or {}).get("mounts") or []
volume_id = mounts[0].get("volume") if mounts and isinstance(mounts[0], dict) else ""
if not isinstance(volume_id, str) or not volume_id:
    raise SystemExit(2)
print(matches[0]["id"], volume_id)
')" || recovery_status=1
    if [ "$recovery_status" = "0" ]; then
        WARM_ID="$(printf '%s' "$warm_pair" | awk '{print $1}')"
        WARM_VOLUME_ID="$(printf '%s' "$warm_pair" | awk '{print $2}')"
        [ -n "$WARM_ID" ] && [ -n "$WARM_VOLUME_ID" ] || recovery_status=1
    fi
    if [ "$recovery_status" = "0" ] \
        && ! recover_exact_stale_fleet_owner "$RECOVER_OWNER_TOKEN"; then
        recovery_status=1
    fi
    reap_orphaned_fleet_proxies || true
    cloudbench_controller_lock_release "$LOCK_DIR"
    if [ "$recovery_status" = "0" ]; then
        echo "✅ exact stale fleet ownership reconciled: $RECOVER_OWNER_TOKEN"
    else
        echo "❌ exact stale fleet ownership recovery failed: $RECOVER_OWNER_TOKEN" >&2
    fi
    exit "$recovery_status"
fi

# ── Fire-time visibility: the run card exists from the moment the fleet is
# fired (status=starting + explicit phase), and the central hub is serving it
# BEFORE any preflight/heal/provisioning — a run waiting on a snapshot or heal
# is visibly "starting", never invisible. The live aggregator overwrites this
# card once real per-bench results flow.
write_startup_card() {  # write_startup_card <phase-text>
    mkdir -p "$FLEET_DIR/_batch"
    STARTUP_BENCHES="${BENCHES[*]:-}" PHASE="$1" CARD_RUN_ID="$RUN_ID" \
    python3 - "$FLEET_DIR/_batch/report-card.json" <<'PY'
import json, os, sys
benches = os.environ.get("STARTUP_BENCHES", "").split()
phase = os.environ["PHASE"]
card = {
    "run_id": os.environ["CARD_RUN_ID"],
    "status": "starting",
    "phase": phase,
    "summary": {"total": len(benches), "passed": 0, "failed": 0,
                "status": f"starting: {phase}"},
    "tasks": [{"name": b, "status": "starting", "phase": phase} for b in benches],
    "per_task": [{"name": b, "status": "starting", "phase": phase} for b in benches],
}
json.dump(card, open(sys.argv[1], "w"), indent=1)
PY
}
start_central_hub() {
    local preferred_dash_base selected_dash_base attempt launch_pid wait_attempt
    local owner_file owner_token existing_owner
    mkdir -p "$HUB_CTX_DIR"
    preferred_dash_base="$DASH_BASE"
    for attempt in $(seq 1 20); do
        selected_dash_base="$(cloudbench_select_central_hub_port "$preferred_dash_base" "$RUNS_ROOT")" || return 1
        if [ "$selected_dash_base" != "$DASH_BASE" ]; then
            echo "⚠️  central hub port :$DASH_BASE is foreign or busy; using :$selected_dash_base without stopping its owner"
            DASH_BASE="$selected_dash_base"
        fi
        if cloudbench_central_hub_matches "$DASH_BASE" "$RUNS_ROOT"; then
            existing_owner="$(cloudbench_central_hub_owner_for \
                "$DASH_BASE" "$RUNS_ROOT" "$ROOT_DIR" 2>/dev/null || true)"
            if [ -n "$existing_owner" ]; then
                CENTRAL_HUB_OWNER_FILE="$existing_owner"
                UNIFIED_DASH_PID="$(cloudbench_tracked_owner_value \
                    "$existing_owner" pid)"
                echo "📊 reusing the exact-owned central hub already open on :$DASH_BASE (no new window)"
                echo "🖥️  local benchmark diagnostics: http://localhost:$DASH_BASE/ — run visible as STARTING"
                return 0
            fi
            # A matching HTTP payload without a birth-identified owner record
            # is not kill/reuse authority. Leave it untouched and move on.
            echo "⚠️  central hub on :$DASH_BASE has no exact owner proof; leaving it untouched"
            preferred_dash_base=$((DASH_BASE + 1))
            continue
        fi

        # The hub intentionally outlives this controller. A plain background job
        # remains in the controller's terminal session and receives SIGHUP when a
        # PTY-backed launcher closes, which leaves every terminal open-agent link
        # dead. Re-exec it in its own session and have that process publish the PID
        # it retains across exec. The server writes a unique, immutable owner
        # record only after bind; a pre-bind crash remains explicitly incomplete.
        owner_token="$(python3 -c 'import secrets; print(secrets.token_hex(16))')" \
            || return 1
        owner_file="$HUB_CTX_DIR/agent-link-server.$DASH_BASE.$owner_token.owner"
        cloudbench_detach_reexec "$HUB_CTX_DIR/hub.log" \
            python3 "$ROOT_DIR/agents/benchmarks/agent_link_server.py" \
                --root "$RUNS_ROOT" --host 127.0.0.1 --port "$DASH_BASE" \
                --repo-root "$ROOT_DIR" --context-dir "$HUB_CTX_DIR" \
                --frontend-dir "$ROOT_DIR/front-end" --hub-runs-dir "$RUNS_ROOT" \
                --preferred-archive-port "$((DASH_BASE + 200))" \
                --owner-file "$owner_file" --owner-token "$owner_token"
        launch_pid=""
        for wait_attempt in $(seq 1 50); do
            existing_owner="$(cloudbench_central_hub_owner_for \
                "$DASH_BASE" "$RUNS_ROOT" "$ROOT_DIR" 2>/dev/null || true)"
            if [ -n "$existing_owner" ]; then
                CENTRAL_HUB_OWNER_FILE="$existing_owner"
                UNIFIED_DASH_PID="$(cloudbench_tracked_owner_value \
                    "$existing_owner" pid)"
                echo "🖥️  local benchmark diagnostics: http://localhost:$DASH_BASE/ — run visible as STARTING"
                return 0
            fi
            launch_pid="$(cloudbench_tracked_owner_value "$owner_file" pid)"
            [ -z "$launch_pid" ] || kill -0 "$launch_pid" 2>/dev/null || break
            sleep 0.1
        done

        # A concurrent launch may have won the bind race. Never signal a PID
        # whose immutable owner+endpoint proof did not validate; its failed
        # bind exits naturally, and the next pass adopts the exact winner.
        UNIFIED_DASH_PID=""
    done
    echo "❌ failed to bind or reuse a central benchmark hub after 20 attempts" >&2
    return 1
}
require_central_hub_visibility() {
    local attempt page
    for attempt in $(seq 1 "${CLOUDBENCH_HUB_VISIBILITY_ATTEMPTS:-30}"); do
        page="$(curl --noproxy '*' -fsS --max-time 2 "http://127.0.0.1:$DASH_BASE/" 2>/dev/null || true)"
        if printf '%s' "$page" | grep -Fq "$RUN_ID"; then
            echo "✅ central hub registration verified: run=$RUN_ID"
            return 0
        fi
        if [ -n "${UNIFIED_DASH_PID:-}" ] && ! kill -0 "$UNIFIED_DASH_PID" 2>/dev/null; then
            break
        fi
        sleep 0.2
    done
    echo "❌ benchmark run is not visible in the central hub; refusing to continue invisibly (run=$RUN_ID, hub=http://127.0.0.1:$DASH_BASE/)" >&2
    return 1
}
require_in_app_hub_visibility() {
    local hub_url hub_api_key active_run_id
    hub_url="${BENCHMARK_HUB_UPLOAD_URL:-https://navi-j9a9.onrender.com}"
    hub_api_key="${BENCHMARK_HUB_API_KEY:-${BACKEND_API_KEY:-}}"
    if [ -z "$hub_api_key" ]; then
        hub_api_key="$(grep -E '^BACKEND_API_KEY=' "$ROOT_DIR/back-end/.env" 2>/dev/null | head -1 | cut -d= -f2- | tr -d '"')"
    fi
    [ -n "$hub_api_key" ] || {
        echo "❌ BACKEND_API_KEY is required to register benchmark runs in the in-app Hub" >&2
        echo "   looked in: \$BENCHMARK_HUB_API_KEY, \$BACKEND_API_KEY, $ROOT_DIR/back-end/.env" >&2
        if [ ! -e "$ROOT_DIR/back-end/.env" ]; then
            # A plain `git worktree add` copies no credentials, so the fleet used
            # to burn a full launch before dying here with no way to tell that
            # the worktree was simply never provisioned.
            echo "   cause: $ROOT_DIR/back-end/.env does not exist — this worktree was never provisioned." >&2
            echo "   fix:   bash scripts/prepare-deploy-worktree.sh --worktree $ROOT_DIR --source <controller-workspace>" >&2
        fi
        return 1
    }
    export BENCHMARK_HUB_UPLOAD_URL="$hub_url"
    export BENCHMARK_HUB_API_KEY="$hub_api_key"
    if [ -n "$INHERITED_HUB_RUN_ID" ]; then
        active_run_id="$INHERITED_HUB_RUN_ID"
        python3 "$HUB_UPLOAD_HELPER" --verify-visible "$active_run_id" || return 1
    else
        active_run_id="$RUN_ID"
        python3 "$HUB_UPLOAD_HELPER" \
            --require-visible "$FLEET_DIR/_batch/report-card.json" \
            --run-id "$active_run_id" --source direct-cloud-fleet || return 1
        SELF_MANAGED_HUB_RUN="1"
    fi
    # Every per-machine run belongs to this already-visible aggregate. Child
    # run_benchmark.py processes must not create duplicate one-task Hub rows.
    export BENCHMARK_HUB_PARENT_RUN_ID="$active_run_id"
    echo "📊 Mac app Benchmark Hub: run=$active_run_id"
}
if [ -z "$PROVISION_POOL" ]; then
    mkdir -p "$FLEET_DIR"
    write_startup_card "controller starting"
    start_central_hub || exit 1
fi

case "$RUN_ID" in ''|*[!a-zA-Z0-9._-]*) echo "❌ invalid fleet run ID" >&2; exit 1 ;; esac
[ "$FLEET_DIR" = "$RUNS_ROOT/$RUN_ID" ] || {
    echo "❌ invalid fleet run directory" >&2
    exit 1
}
mkdir -p "$RUNS_ROOT" || { echo "❌ could not initialize fleet runs root" >&2; exit 1; }
python3 - "$ROOT_DIR" "$RUNS_ROOT" <<'PY' || {
import os
import sys
from pathlib import Path
workspace, runs = map(Path, sys.argv[1:])
try:
    workspace = workspace.resolve(strict=True)
    context = (workspace / ".context").resolve(strict=True)
    runs = runs.resolve(strict=True)
except (OSError, RuntimeError):
    raise SystemExit(1)
if os.path.commonpath((str(context), str(runs))) != str(context):
    raise SystemExit(1)
PY
    echo "❌ fleet runs root must be a canonical directory under this worktree's .context" >&2
    exit 1
}
if [ ! -e "$FLEET_DIR" ]; then
    mkdir "$FLEET_DIR" || { echo "❌ could not initialize fleet run directory" >&2; exit 1; }
fi
[ -d "$FLEET_DIR" ] && [ ! -L "$FLEET_DIR" ] || {
    echo "❌ refusing unsafe fleet run directory" >&2
    exit 1
}

FLEET_TEARDOWN_OWNERSHIP_DIR="$FLEET_AUDIT_ROOT/$FLEET_OWNER_TOKEN"
if [ -L "$FLEET_AUDIT_ROOT" ]; then
    echo "❌ refusing symlinked fleet audit root: $FLEET_AUDIT_ROOT" >&2
    exit 1
fi
if [ ! -e "$FLEET_AUDIT_ROOT" ]; then
    mkdir "$FLEET_AUDIT_ROOT" 2>/dev/null || [ -d "$FLEET_AUDIT_ROOT" ] || {
        echo "❌ could not initialize shared fleet audit root" >&2
        exit 1
    }
fi
[ -d "$FLEET_AUDIT_ROOT" ] && [ ! -L "$FLEET_AUDIT_ROOT" ] || {
    echo "❌ shared fleet audit root is not a safe directory" >&2
    exit 1
}
[ ! -e "$FLEET_TEARDOWN_OWNERSHIP_DIR" ] \
    && [ ! -L "$FLEET_TEARDOWN_OWNERSHIP_DIR" ] || {
        echo "❌ refusing pre-existing fleet audit owner path" >&2
        exit 1
    }
audit_staging="$(mktemp -d "$FLEET_AUDIT_ROOT/.staging-$FLEET_OWNER_TOKEN.XXXXXXXX")" \
    || { echo "❌ could not create private fleet audit staging directory" >&2; exit 1; }
chmod 700 "$audit_staging" \
    && mkdir "$audit_staging/fresh" "$audit_staging/expected-fresh" \
        "$audit_staging/by-machine-id" "$audit_staging/pool-handoffs" || {
        rm -rf -- "$audit_staging"
        echo "❌ could not initialize durable fleet teardown manifest" >&2
        exit 1
    }
OWNED_CLONES_FILE="$audit_staging/owned-clones.ids"
OWNED_CLONE_NAMES_FILE="$audit_staging/owned-clones.names"
: > "$OWNED_CLONES_FILE" || {
    rm -rf -- "$audit_staging"
    echo "❌ could not initialize durable owned-clone ledger" >&2
    exit 1
}
: > "$OWNED_CLONE_NAMES_FILE" || {
    rm -rf -- "$audit_staging"
    echo "❌ could not initialize durable owned-clone name ledger" >&2
    exit 1
}
{
    printf 'version=1\n'
    printf 'fleet_owner_token=%s\n' "$FLEET_OWNER_TOKEN"
    printf 'run_id=%s\n' "$RUN_ID"
    printf 'app=%s\n' "$APP"
    printf 'workspace_root=%s\n' "$ROOT_DIR"
    printf 'status=incomplete\n'
    if [ -n "$CENTRAL_HUB_OWNER_FILE" ]; then
        printf 'hub_disposition=retained-exact-owner-transfer-required\n'
        printf 'hub_owner_file=%s\n' "$CENTRAL_HUB_OWNER_FILE"
        printf 'hub_owner_token=%s\n' \
            "$(cloudbench_tracked_owner_value "$CENTRAL_HUB_OWNER_FILE" owner_token)"
        printf 'hub_pid=%s\n' \
            "$(cloudbench_tracked_owner_value "$CENTRAL_HUB_OWNER_FILE" pid)"
        printf 'hub_pid_start=%s\n' \
            "$(cloudbench_tracked_owner_value "$CENTRAL_HUB_OWNER_FILE" pid_start)"
        printf 'hub_argv_sha256=%s\n' \
            "$(cloudbench_tracked_owner_value "$CENTRAL_HUB_OWNER_FILE" argv_sha256)"
    else
        printf 'hub_disposition=not-applicable\n'
        printf 'hub_owner_file=\n'
        printf 'hub_owner_token=\n'
        printf 'hub_pid=\n'
        printf 'hub_pid_start=\n'
        printf 'hub_argv_sha256=\n'
    fi
} > "$audit_staging/meta" \
    || {
        rm -rf -- "$audit_staging"
        echo "❌ could not publish durable fleet teardown manifest identity" >&2
        exit 1
    }
python3 - "$FLEET_AUDIT_ROOT" "${audit_staging##*/}" "$FLEET_OWNER_TOKEN" <<'PY' || {
import os
import re
import sys

root, staging, owner = sys.argv[1:4]
if not re.fullmatch(r"[0-9a-f]{32}", owner):
    raise SystemExit(1)
if not staging.startswith(f".staging-{owner}.") or "/" in staging:
    raise SystemExit(1)
nofollow = getattr(os, "O_NOFOLLOW", 0)
directory = getattr(os, "O_DIRECTORY", 0)
root_fd = os.open(root, os.O_RDONLY | directory | nofollow)
try:
    os.stat(staging, dir_fd=root_fd, follow_symlinks=False)
    try:
        os.stat(owner, dir_fd=root_fd, follow_symlinks=False)
    except FileNotFoundError:
        pass
    else:
        raise SystemExit(1)
    os.rename(staging, owner, src_dir_fd=root_fd, dst_dir_fd=root_fd)
    os.fsync(root_fd)
finally:
    os.close(root_fd)
PY
    rm -rf -- "$audit_staging"
    echo "❌ could not atomically publish durable fleet teardown manifest" >&2
    exit 1
}
OWNED_CLONES_FILE="$FLEET_TEARDOWN_OWNERSHIP_DIR/owned-clones.ids"
OWNED_CLONE_NAMES_FILE="$FLEET_TEARDOWN_OWNERSHIP_DIR/owned-clones.names"
printf '%s\n' "$FLEET_TEARDOWN_OWNERSHIP_DIR" \
    > "$FLEET_DIR/teardown-ownership.path.tmp.$$" \
    && mv "$FLEET_DIR/teardown-ownership.path.tmp.$$" \
        "$FLEET_DIR/teardown-ownership.path" || {
        echo "❌ could not publish the fleet teardown manifest pointer" >&2
        exit 1
    }
if [ -z "$PROVISION_POOL" ]; then
    require_central_hub_visibility || exit 1
    require_in_app_hub_visibility || exit 1
fi
LOCAL_PROCESS_TEARDOWN_FAILED=0
AUTOSCALER_PIDS=()
PROVISION_PIDS=()
CHILD_PIDS=()
CHILD_EXIT_CODES=()
CHILD_OUT=()
CHILD_BENCH=()
CHILD_MODE=()
CHILD_PORT=()
CHILD_MACHINE=()

cloudbench_confirm_guest_shutdowns() {
    local deadline j out port status_code marker_tmp failed=0
    local -a pending_indices next_pending_indices
    pending_indices=()
    next_pending_indices=()
    [ "${#CHILD_OUT[@]}" -gt 0 ] || return 0
    deadline=$((SECONDS + ${CLOUDBENCH_CHILD_TERM_SECONDS:-30}))

    # Request every guest first so cancellation/archive/provider cleanup runs in
    # parallel across the fleet. The local status proxies are still alive here;
    # terminating CHILD_PIDS first destroys the only machine-pinned data plane.
    for j in "${!CHILD_OUT[@]}"; do
        out="${CHILD_OUT[$j]}"
        [ -e "$out/guest-shutdown.confirmed" ] && continue
        port="$(cat "$out/status-proxy.port" 2>/dev/null || true)"
        case "$port" in
            ''|*[!0-9]*)
                # A child whose boot config was never applied never started a
                # guest, so no acknowledgement can ever exist. Treating that as
                # an unconfirmed cleanup quarantined the owner permanently: the
                # policy never left `retain`, --recover-stale-owner refused it,
                # and the clone kept running with no sanctioned cleanup path.
                # No acknowledgement marker is fabricated - nothing was cleaned,
                # because nothing ever ran.
                if [ -s "$out/boot-config-unapplied" ] \
                    && [ ! -e "$out/cloudbench-run.json" ]; then
                    echo "ℹ️  [${CHILD_BENCH[$j]:-unknown}] boot config was never applied; no guest cleanup is owed"
                    continue
                fi
                echo "❌ [${CHILD_BENCH[$j]:-unknown}] no status proxy for guest cleanup acknowledgement" >&2
                failed=1
                continue
                ;;
        esac
        status_code="$(curl --noproxy '*' -sS --max-time 3 -o /dev/null -w '%{http_code}' \
            -X POST -H "Authorization: Bearer $CLOUDBENCH_BARRIER_TOKEN" \
            "http://127.0.0.1:$port/shutdown" 2>/dev/null || true)"
        case "$status_code" in
            204)
                marker_tmp="$out/guest-shutdown.confirmed.tmp.$$"
                if ! printf '%s\n' "$RUN_ID" > "$marker_tmp"; then
                    rm -f -- "$marker_tmp" 2>/dev/null || true
                    echo "❌ [${CHILD_BENCH[$j]:-unknown}] could not write guest cleanup confirmation marker" >&2
                    failed=1
                elif ! mv "$marker_tmp" "$out/guest-shutdown.confirmed"; then
                    rm -f -- "$marker_tmp" 2>/dev/null || true
                    echo "❌ [${CHILD_BENCH[$j]:-unknown}] could not publish guest cleanup confirmation marker" >&2
                    failed=1
                fi
                ;;
            # A configured guest persists its shutdown request before the
            # driver-PID ownership fence can return 409. Preserve that possible
            # in-progress state and let /shutdown-health provide the only
            # cleanup verdict.
            202|409) pending_indices+=("$j") ;;
            *)
                echo "❌ [${CHILD_BENCH[$j]:-unknown}] guest cleanup request failed (HTTP ${status_code:-transport-error})" >&2
                failed=1
                ;;
        esac
    done

    while [ "${#pending_indices[@]}" -gt 0 ] && [ "$SECONDS" -le "$deadline" ]; do
        next_pending_indices=()
        for j in "${pending_indices[@]}"; do
            out="${CHILD_OUT[$j]}"
            port="$(cat "$out/status-proxy.port" 2>/dev/null || true)"
            status_code="$(curl --noproxy '*' -sS --max-time 2 -o /dev/null -w '%{http_code}' \
                -H "Authorization: Bearer $CLOUDBENCH_BARRIER_TOKEN" \
                "http://127.0.0.1:$port/shutdown-health" 2>/dev/null || true)"
            if [ "$status_code" = "204" ]; then
                marker_tmp="$out/guest-shutdown.confirmed.tmp.$$"
                if ! printf '%s\n' "$RUN_ID" > "$marker_tmp"; then
                    rm -f -- "$marker_tmp" 2>/dev/null || true
                    echo "❌ [${CHILD_BENCH[$j]:-unknown}] could not write guest cleanup confirmation marker" >&2
                    failed=1
                elif ! mv "$marker_tmp" "$out/guest-shutdown.confirmed"; then
                    rm -f -- "$marker_tmp" 2>/dev/null || true
                    echo "❌ [${CHILD_BENCH[$j]:-unknown}] could not publish guest cleanup confirmation marker" >&2
                    failed=1
                fi
            elif [ "$status_code" = "500" ]; then
                echo "❌ [${CHILD_BENCH[$j]:-unknown}] guest exited without cleanup acknowledgement" >&2
                failed=1
            else
                next_pending_indices+=("$j")
            fi
        done
        if [ "${next_pending_indices[0]+set}" = "set" ]; then
            pending_indices=("${next_pending_indices[@]}")
        else
            pending_indices=()
        fi
        [ "${#pending_indices[@]}" -eq 0 ] || sleep 0.25
    done
    if [ "${#pending_indices[@]}" -gt 0 ]; then
        echo "❌ ${#pending_indices[@]} guest(s) did not acknowledge browser/session cleanup; retaining provider ownership" >&2
        failed=1
    fi
    if [ "$failed" = "0" ]; then
        echo "✅ every guest acknowledged browser/session cleanup before fleet machine teardown"
    fi
    return "$failed"
}

cleanup() {
    local result_ec=$? ec teardown_failed="${LOCAL_PROCESS_TEARDOWN_FAILED:-0}"
    local id claim_path st presence machines round stop_pid pool_volume_id guest_shutdown_failed=0
    local claim_digest
    local -a claimed_pool_ids pending_pool_ids next_pending_pool_ids stop_pids
    ec="$result_ec"
    export -n machines 2>/dev/null || true
    claimed_pool_ids=()
    pending_pool_ids=()
    next_pending_pool_ids=()
    stop_pids=()
    # The poller and terminal can deliver TERM to the same process group. Do not
    # let a second signal interrupt teardown after the EXIT trap has begun.
    trap - EXIT
    trap '' HUP INT TERM
    release_cleanup_disk_reserve || { ec=1; teardown_failed=1; }
    # Both auxiliary loops sleep in child processes. Killing only their Bash
    # roots reparents the current sleep into the detached controller group, so
    # the wrapper can publish status while that owned group is still live.
    # Capture each complete tree before TERM and reap the waitable roots before
    # provider cleanup or the detached status rendezvous can complete.
    if ! cloudbench_terminate_tree_and_wait "${CLOUDBENCH_CHILD_TERM_SECONDS:-30}" \
        "${UNIFIED_AGG_PID:-}" "${SNAPSHOT_LOOP_PID:-}"; then
        echo "❌ an owned aggregator/snapshot process survived local teardown" >&2
        ec=1
        teardown_failed=1
    fi
    UNIFIED_AGG_PID=""
    SNAPSHOT_LOOP_PID=""
    [ -n "${INVENTORY_WAIT_FIFO:-}" ] && rm -f "$INVENTORY_WAIT_FIFO" 2>/dev/null || true
    # Do NOT kill the central hub (UNIFIED_DASH_PID): it is THE one persistent
    # dashboard — shared across every run, carrying the user's open tab, resolving
    # "open agent" from local run data long after teardown. The next fleet run
    # REUSES it (never rebinds/kills it), so exactly one hub ever runs.
    if ! cloudbench_confirm_guest_shutdowns; then
        guest_shutdown_failed=1
    elif ! fleet_registry_confirm_guest_teardown; then
        echo "❌ could not persist confirmed guest-cleanup ownership transition" >&2
        guest_shutdown_failed=1
    fi
    if [ "$guest_shutdown_failed" = "1" ]; then
        KEEP_CLONES=1
        ec=1
        teardown_failed=1
        if ! fleet_registry_retain_unconfirmed_guest; then
            echo "❌ could not persist fail-closed guest-cleanup ownership policy" >&2
        fi
        if [ -s "$CLAIMED_POOL_FILE" ]; then
            while read -r id; do
                [ -n "$id" ] || continue
                claim_path="$POOL_CLAIMS_DIR/$id"
                if ! pool_claim_mark_cleanup_unconfirmed "$claim_path"; then
                    echo "❌ could not quarantine exact pool claim $id; linked fleet sentinel remains authoritative" >&2
                fi
            done < "$CLAIMED_POOL_FILE"
        fi
    fi
    if ! cloudbench_terminate_tree_and_wait "${CLOUDBENCH_CHILD_TERM_SECONDS:-30}" \
        "${AUTOSCALER_PIDS[@]:-}"; then
        echo "❌ an owned autoscaler process survived local teardown" >&2
        ec=1
        teardown_failed=1
    fi
    if ! cloudbench_terminate_tree_and_wait "${CLOUDBENCH_CHILD_TERM_SECONDS:-30}" \
        "${PROVISION_PIDS[@]:-}"; then
        echo "❌ an owned provisioner process survived local teardown" >&2
        ec=1
        teardown_failed=1
    fi
    cloudbench_terminate_and_wait "${CLOUDBENCH_CHILD_TERM_SECONDS:-30}" "${CHILD_PIDS[@]:-}"
    # SIGKILL cannot run an autoscaler's EXIT trap. Release any remaining
    # complete lease records owned by this exact controller/run under the same
    # allocator lock before the snapshotted helper is removed.
    python3 "$AUTOSCALER_PORT_LEASE_HELPER" release-prefix \
        --root "${AUTOSCALER_PORT_LEASE_ROOT:-${TMPDIR:-/tmp}/rose-cloudbench-autoscaler-port-leases}" \
        --owner-pid "$$" --token "$RUN_ID-" 2>/dev/null || true
    record_tainted_claimed_pool_machines
    # Return only machines this fleet actually claimed. The pool ledger can be
    # shared by sibling workspaces, so stopping every listed ID would interrupt
    # their active runs. Stop this run's machines concurrently: serial stop +
    # per-machine inventory polling added N teardown latency after an otherwise
    # perfectly parallel batch. Keep every global lease until a shared inventory
    # read proves its machine stopped (or absent).
    if [ "$guest_shutdown_failed" = "1" ] && [ -s "$CLAIMED_POOL_FILE" ]; then
        echo "⚠️  retaining claimed pool machines and ownership claims: guest cleanup is unconfirmed" >&2
    elif [ -s "$CLAIMED_POOL_FILE" ]; then
        while read -r id; do
            [ -n "$id" ] || continue
            if grep -Fxq "$id" "$TAINTED_POOL_FILE" 2>/dev/null; then
                echo "☣️  destroying quarantined pool machine $id instead of returning it"
                claim_path="$POOL_CLAIMS_DIR/$id"
                claim_digest="$(cloudbench_env_sha256 "$claim_path")" || {
                    echo "❌ quarantined pool claim $id is unreadable; retaining ownership claim" >&2
                    ec=1
                    teardown_failed=1
                    continue
                }
                pool_volume_id="$(registry_meta_value \
                    "$FLEET_TEARDOWN_OWNERSHIP_DIR/pool/$id" volume_id)"
                if [ -n "$pool_volume_id" ] \
                    && reap_machine "$id" "" "$pool_volume_id"; then
                    if pool_ledger_remove_id "$id" \
                        && fleet_audit_record_pool_machine "$id" "$pool_volume_id" \
                            destroyed-removed-from-pool \
                        && pool_claim_release_exact "$claim_path" "$claim_digest" \
                            "$FLEET_OWNER_TOKEN" "$FLEET_OWNER_HOST" "$$" \
                            "$FLEET_OWNER_PID_START"; then
                        :
                    else
                        ec=1
                        teardown_failed=1
                    fi
                else
                    echo "❌ quarantined pool machine $id survived destroy; retaining ownership claim" >&2
                    ec=1
                    teardown_failed=1
                fi
                continue
            fi
            echo "↩️  returning claimed pool machine $id (stop)"
            claimed_pool_ids+=("$id")
        done < "$CLAIMED_POOL_FILE"

        pending_pool_ids=("${claimed_pool_ids[@]}")
        # A bounded retry handles an instantaneous control-plane throttle while
        # preserving parallel teardown. Each round uses one shared inventory
        # read, never one Machines-API list call per box.
        for round in $(seq 1 "${CLOUDBENCH_POOL_STOP_REQUEST_ATTEMPTS:-3}"); do
            stop_pids=()
            for id in "${pending_pool_ids[@]}"; do
                fly_with_timeout "${CLOUDBENCH_POOL_STOP_REQUEST_TIMEOUT:-20}" \
                    machine stop "$id" -a "$APP" >/dev/null 2>&1 &
                stop_pids+=("$!")
            done
            for stop_pid in "${stop_pids[@]}"; do
                wait "$stop_pid" 2>/dev/null || true
            done
            machines="$(FLY machines list -a "$APP" --json 2>/dev/null || true)"
            next_pending_pool_ids=()
            for id in "${pending_pool_ids[@]}"; do
                st="$(printf '%s' "$machines" | pool_machine_state_from_json "$id" 2>/dev/null)"
                presence=$?
                if [ "$presence" -ne 0 ] || [ "$st" != "stopped" ]; then
                    next_pending_pool_ids+=("$id")
                fi
            done
            if [ "${next_pending_pool_ids[0]+set}" = "set" ]; then
                pending_pool_ids=("${next_pending_pool_ids[@]}")
            else
                pending_pool_ids=()
                break
            fi
            sleep "$round"
        done

        # Stop commands normally wait for the transition. Retain a bounded
        # shared-inventory poll for Fly transitions that outlive the request.
        for _ in $(seq 1 "${CLOUDBENCH_POOL_STOP_ATTEMPTS:-30}"); do
            [ "${pending_pool_ids[0]+set}" = "set" ] || break
            machines="$(FLY machines list -a "$APP" --json 2>/dev/null || true)"
            next_pending_pool_ids=()
            for id in "${pending_pool_ids[@]}"; do
                st="$(printf '%s' "$machines" | pool_machine_state_from_json "$id" 2>/dev/null)"
                presence=$?
                if [ "$presence" -ne 0 ] || [ "$st" != "stopped" ]; then
                    next_pending_pool_ids+=("$id")
                fi
            done
            if [ "${next_pending_pool_ids[0]+set}" = "set" ]; then
                pending_pool_ids=("${next_pending_pool_ids[@]}")
                sleep 2
            else
                pending_pool_ids=()
                break
            fi
        done

        machines="$(FLY machines list -a "$APP" --json 2>/dev/null || true)"
        for id in "${claimed_pool_ids[@]}"; do
            st="$(printf '%s' "$machines" | pool_machine_state_from_json "$id" 2>/dev/null)"
            presence=$?
            claim_path="$POOL_CLAIMS_DIR/$id"
            claim_digest="$(cloudbench_env_sha256 "$claim_path" 2>/dev/null)" \
                || claim_digest=""
            pool_volume_id="$(registry_meta_value \
                "$FLEET_TEARDOWN_OWNERSHIP_DIR/pool/$id" volume_id)"
            if [ "$presence" -eq 0 ] && [ "$st" = "stopped" ] \
                && [ -n "$pool_volume_id" ] \
                && [ "$(printf '%s' "$machines" \
                    | machine_volume_id_from_json "$id" 2>/dev/null)" = "$pool_volume_id" ] \
                && [ -n "$claim_digest" ] \
                && pool_claim_owned_by_current "$claim_path"; then
                if fleet_audit_record_pool_machine "$id" "$pool_volume_id" \
                    returned-stopped-claim-released \
                    && pool_claim_release_exact "$claim_path" "$claim_digest" \
                        "$FLEET_OWNER_TOKEN" "$FLEET_OWNER_HOST" "$$" \
                        "$FLEET_OWNER_PID_START"; then
                    :
                else
                    ec=1
                    teardown_failed=1
                fi
            else
                echo "❌ claimed pool machine $id did not verify stopped; retaining ownership claim" >&2
                ec=1
                teardown_failed=1
            fi
        done
    fi
    # Claims are independent recovery roots that may still refer to a fresh
    # registry record. Reconcile them before reaping ordinary fresh clones;
    # the registry/meta remains published until every claim and the immutable
    # terminal audit have committed.
    if ! reconcile_current_pool_transfer_claims; then
        echo "❌ could not reconcile this controller's pending pool transfer claims" >&2
        ec=1
        teardown_failed=1
    fi
    if [ "$guest_shutdown_failed" = "0" ] && ! reconcile_current_pool_claims; then
        echo "❌ could not reconcile this controller's exact pool claims" >&2
        ec=1
        teardown_failed=1
    fi
    if [ "$FLEET_REGISTRY_PUBLISHED" = "1" ] && [ "$KEEP_CLONES" != "1" ]; then
        # The durable registry is authoritative for primaries AND autoscaler
        # workers. Local per-bench ledgers remain useful for live scaling, but a
        # failed reap stays recoverable even if this workspace is later deleted.
        if ! reap_registry_clones "$FLEET_REGISTRY_DIR" current; then
            echo "⚠️  FAILED to destroy all fleet-owned machines; durable ownership remains at $FLEET_REGISTRY_DIR" >&2
            ec=1
            teardown_failed=1
        fi
    elif [ "$FLEET_REGISTRY_PUBLISHED" = "1" ]; then
        echo "⚠️  --keep-clones: retaining fleet ownership at $FLEET_REGISTRY_DIR"
    fi
    # Clone volume IDs are persisted in the same exact-owner record as machine
    # IDs and reaped by reap_registry_clones. Never sweep app-global unattached
    # volumes here: another worktree can be between fork and machine attachment.
    # NOTE: do NOT pkill viewers by "$FLEET_DIR" — the batch resolver (and the
    # archive Vites it spawns for durable /open-agent) carry $FLEET_DIR in their
    # argv too, so that sweep KILLED the very resolver we persist (→ dead link
    # post-run). Per-bench viewers are reaped by their own run-bench-cloud child's
    # exit trap when we SIGTERM CHILD_PIDS above; the batch resolver lives on.
    [ -n "${FLEET_PATCH_FILE:-}" ] && rm -f "$FLEET_PATCH_FILE" 2>/dev/null || true
    if [ "$guest_shutdown_failed" = "1" ]; then
        echo "⚠️  retaining durable capacity reservation with the recoverable guest machines" >&2
    else
        if ! capacity_release_owner_reservations; then
            echo "❌ could not release this controller's durable capacity reservations" >&2
            ec=1
            teardown_failed=1
        fi
        CAPACITY_RESERVATION_PUBLISHED=0
    fi
    # Autoscaler EXIT cleanup calls the snapshotted port-lease helper. Remove
    # an invocation-owned immutable bundle only after every child/autoscaler is
    # reaped; borrowed snapshots belong to their creating/waiting process.
    if ! cleanup_owned_script_snapshot; then
        ec=1
        teardown_failed=1
    fi
    # A benchmark FAIL and a teardown FAIL are independent facts. Preserve the
    # workload exit code, but still publish verified teardown when every exact
    # resource reached its required terminal disposition.
    if [ "$teardown_failed" = "0" ] && [ "$KEEP_CLONES" != "1" ] \
        && ! fleet_audit_finalize_provider_teardown; then
        echo "❌ durable fleet teardown manifest is incomplete" >&2
        ec=1
        teardown_failed=1
    fi
    # The v2 registry/meta is the crash-recovery root for both its clone rows
    # and token-bound claims. Remove it only after the shared audit and its
    # immutable run-local terminal copy have committed successfully.
    if [ "$teardown_failed" = "0" ] && [ "$FLEET_REGISTRY_PUBLISHED" = "1" ] \
        && [ "$KEEP_CLONES" != "1" ]; then
        fleet_registry_remove_if_empty "$FLEET_REGISTRY_DIR" \
            || { ec=1; teardown_failed=1; }
    fi
    cloudbench_controller_lock_release "$LOCK_DIR"
    exit "$ec"
}
trap cleanup EXIT
# Name the killer: silent teardowns (no ❌, no barrier release) have repeatedly
# looked like infra failures when the controller was actually signalled from
# outside (session kill, stray pkill). Record which signal fired before exiting.
trap 'echo "⚰️  controller received HUP ($(date -u +%H:%M:%S))"; exit 129' HUP
trap 'echo "⚰️  controller received INT ($(date -u +%H:%M:%S))"; exit 130' INT
if [ "${CLOUDBENCH_TEST_IGNORE_CONTROLLER_TERM:-0}" = "1" ]; then
    # Permanent fake-provider coverage uses this hook only after crossing a
    # real allocation boundary, proving the detached supervisor's KILL +
    # out-of-process durable reconciliation path.
    trap '' TERM
else
    trap 'echo "⚰️  controller received TERM ($(date -u +%H:%M:%S))"; exit 143' TERM
fi

mkdir -p "$(dirname "$POOL_IDS_FILE")" "$POOL_CLAIMS_DIR" || {
    echo "❌ could not initialize durable cloudbench ownership directories under $GIT_COMMON_DIR" >&2
    exit 1
}
if [ ! -f "$POOL_IDS_FILE" ] && [ -f "$LEGACY_POOL_IDS_FILE" ]; then
    cp "$LEGACY_POOL_IDS_FILE" "$POOL_IDS_FILE" || {
        echo "❌ could not migrate legacy pool ownership into $POOL_IDS_FILE" >&2
        exit 1
    }
fi
fleet_registry_init || {
    echo "❌ could not atomically publish durable fleet ownership under $FLEET_OWNERSHIP_ROOT; refusing provider mutation" >&2
    exit 1
}
reserve_cleanup_disk_space || {
    echo "❌ could not allocate the emergency fleet teardown disk reserve; refusing provider mutation" >&2
    exit 1
}
reconcile_pool || exit 1   # stop + verify this workspace's pool before machine start
normalize_current_pool_shape || exit 1
# READ-ONLY env preflight: the run path never stages/mutates the shared
# prod-aligned app secrets (that would race concurrent workstreams). It only
# verifies they exist; refreshing them is an explicit maintenance op.
write_startup_card "verifying environment"
echo "🔎 Verifying the shared benchmark app environment (read-only)..."
if ! bash "$RUN_BENCH_CLOUD_BIN" --verify-secrets; then
    echo "❌ Cloud benchmark environment is not ready; no benchmark machine was started." >&2
    echo "   Refresh it explicitly (maintenance op): bash scripts/run-bench-cloud --refresh-secrets" >&2
    exit 1
fi

# Fail closed BEFORE provisioning N clones when the immutable seed dump for the
# cloud-guest Postgres major is missing from R2. Guests run system Postgres 15
# (`cloudbench-run.sh`); a host that only published pg16 leaves every stack
# failing at the start barrier after machines are already billed.
# Observed 2026-08-06: 49/49 daily benches excluded for
# `canonical base fixture is unavailable` on token `…-pg15-victoria-prod-sync-v1-whatsapp-v2`
# while `…-pg16-…` existed.
CLOUDBENCH_GUEST_PG_MAJOR="${CLOUDBENCH_GUEST_PG_MAJOR:-15}"
echo "🔎 Verifying canonical seed dump for cloud-guest Postgres ${CLOUDBENCH_GUEST_PG_MAJOR}..."
_SEED_GUEST_TOKEN="$(
    python3 "$ROOT_DIR/agents/benchmarks/seed_cache_path.py" --cache-token \
        --pg-major "$CLOUDBENCH_GUEST_PG_MAJOR" \
        "$ROOT_DIR/back-end/prisma/schema.prisma"
)"
_SEED_GUEST_PROBE="$(mktemp "${TMPDIR:-/tmp}/cloudbench-seed-probe.XXXXXX")"
# Detached fleet controllers can inherit a stripped PATH (Cursor cloud / minimal
# launchers). Ensure npx from nvm or common prefixes is visible before probing.
if ! command -v npx >/dev/null 2>&1; then
    for _npx_dir in \
        "$HOME/.nvm/versions/node"/*/bin \
        /usr/local/bin \
        "$ROOT_DIR/node_modules/.bin"
    do
        if [ -x "$_npx_dir/npx" ]; then
            export PATH="$_npx_dir:$PATH"
            break
        fi
    done
fi
command -v npx >/dev/null 2>&1 || {
    rm -f "$_SEED_GUEST_PROBE"
    echo "❌ npx not found on PATH; cannot verify the cloud-guest seed dump." >&2
    echo "   Install Node.js or ensure nvm's bin dir is on PATH before run-bench-fleet." >&2
    exit 1
}
# Resolve a seed-dump runner that does not depend on a writable npm cache.
# Hermetic fleet tests ship an empty package.json (no node_modules); live
# coverage can race `npx --yes tsx` into ENOTEMPTY / `tsx: not found`.
# Prefer repo-local tsx, then PATH tsx, then Node 22 type-stripping, then npx.
_seed_dump_get() {
    local token="$1" out="$2"
    # Prefer a runner that can resolve back-end deps. Cloud agents sometimes
    # have an empty/partial back-end/node_modules (npm arborist edgesOut bugs
    # on full installs); fall back to NODE_PATH + a known-good tsx binary so
    # we do not provision N Fly clones and then fail the start barrier because
    # the host falsely reported "missing" for a dump that exists in R2.
    local -a runners=()
    if [ -x "$ROOT_DIR/node_modules/.bin/tsx" ]; then
        runners+=("$ROOT_DIR/node_modules/.bin/tsx")
    fi
    if [ -x "$ROOT_DIR/back-end/node_modules/.bin/tsx" ]; then
        runners+=("$ROOT_DIR/back-end/node_modules/.bin/tsx")
    fi
    if command -v tsx >/dev/null 2>&1; then
        runners+=("$(command -v tsx)")
    fi
    local runner
    for runner in "${runners[@]}"; do
        if (
            cd "$ROOT_DIR/back-end" &&
                NODE_PATH="$ROOT_DIR/back-end/node_modules${NODE_PATH:+:$NODE_PATH}" \
                    "$runner" scripts/seed-dump-cache.ts get "$token" "$out"
        ) && [ -s "$out" ]; then
            return 0
        fi
    done
    if node --experimental-strip-types -e 'export {}' >/dev/null 2>&1; then
        if (
            cd "$ROOT_DIR/back-end" &&
                NODE_PATH="$ROOT_DIR/back-end/node_modules${NODE_PATH:+:$NODE_PATH}" \
                    node --experimental-strip-types scripts/seed-dump-cache.ts get "$token" "$out"
        ) && [ -s "$out" ]; then
            return 0
        fi
    fi
    if (
        cd "$ROOT_DIR/back-end" &&
            NODE_PATH="$ROOT_DIR/back-end/node_modules${NODE_PATH:+:$NODE_PATH}" \
                npx --yes tsx scripts/seed-dump-cache.ts get "$token" "$out"
    ) && [ -s "$out" ]; then
        return 0
    fi
    return 1
}
# Retry transient runner races before failing closed on a missing dump.
_SEED_GUEST_OK=0
for _seed_try in 1 2 3 4 5; do
    rm -f "$_SEED_GUEST_PROBE"
    if (
            cd "$ROOT_DIR/back-end" &&
                _seed_dump_get "$_SEED_GUEST_TOKEN" "$_SEED_GUEST_PROBE"
        ) && [ -s "$_SEED_GUEST_PROBE" ]; then
        _SEED_GUEST_OK=1
        break
    fi
    sleep "$_seed_try"
done
if [ "$_SEED_GUEST_OK" -ne 1 ]; then
    rm -f "$_SEED_GUEST_PROBE"
    echo "❌ Missing canonical base fixture for cloud guests: $_SEED_GUEST_TOKEN" >&2
    echo "   Publish a dump produced by a pg${CLOUDBENCH_GUEST_PG_MAJOR} client before provisioning." >&2
    echo "   (Host-only pg16 publications are not readable by Fly guest Postgres ${CLOUDBENCH_GUEST_PG_MAJOR}.)" >&2
    exit 1
fi
rm -f "$_SEED_GUEST_PROBE"
echo "✅ Canonical seed dump present for guest pg${CLOUDBENCH_GUEST_PG_MAJOR}: $_SEED_GUEST_TOKEN"

# ── Resolve the warm machine (clone source) + its volume ────────────────────
warm_json="$(FLY machines list -a "$APP" --json 2>/dev/null || echo '[]')"
warm_pair="$(printf '%s' "$warm_json" | MN="$MACHINE_NAME" python3 -c '
import json,os,sys
d=json.load(sys.stdin) or []
mn=os.environ["MN"]
for m in d:
    if m.get("name")==mn and m.get("id"):
        mounts=m.get("config",{}).get("mounts") or []
        vol=mounts[0].get("volume","") if mounts else ""
        print(m["id"], m.get("region") or "", vol); break
' 2>/dev/null || true)"
WARM_ID="$(printf '%s' "$warm_pair" | awk '{print $1}')"
warm_region="$(printf '%s' "$warm_pair" | awk '{print $2}')"
WARM_VOLUME_ID="$(printf '%s' "$warm_pair" | awk '{print $3}')"
[ -n "$WARM_ID" ] || { echo "❌ No warm machine '$MACHINE_NAME' in $APP — run: bash scripts/run-bench-cloud --setup" >&2; exit 1; }
# Volume snapshots are region-scoped, so clones MUST land in the warm box's region.
[ -n "$warm_region" ] && REGION="$warm_region"
echo "🏭 warm source machine: $WARM_ID (region $REGION)"

# A stopped-machine config update briefly reserves both old and new CPU shapes.
# Keeping the 4x maintenance donor parked beside 37 2x primaries leaves only an
# exact two-CPU margin and has produced real cpu_overcommit deaths before boot.
# The volume snapshot does not depend on guest shape, so park the donor at 1x
# between maintenance transactions; run-bench-cloud expands it only while
# rebuilding/snapshotting and parks it again on every exit path.
warm_shape="$(printf '%s' "$warm_json" | pool_machine_shape_from_json "$WARM_ID")" || {
    echo "❌ could not read warm source shape" >&2; exit 1;
}
read -r warm_state warm_kind warm_cpus warm_memory <<< "$warm_shape"
# Concurrent maintenance (or a sibling fleet's park/update) can leave the shared
# warm donor in started/stopping/replacing. Wait for stopped instead of aborting
# the whole fleet on a transient race — clones still require a stopped source.
# Never stop the warm machine ourselves (another workspace may own an in-flight
# prepare_warm_source); only poll via cloudbench_wait_machine_stopped.
if [ "$warm_state" != "stopped" ]; then
    echo "⏳ warm source is $warm_state; waiting until stopped before fleet provisioning"
    warm_stop_attempts="${CLOUDBENCH_WARM_STOP_ATTEMPTS:-60}"
    warm_stop_sleep="${CLOUDBENCH_WARM_STOP_SLEEP_SECONDS:-5}"
    cloudbench_wait_machine_stopped pool_machine_state "$WARM_ID" \
        "$warm_stop_attempts" "$warm_stop_sleep" || {
        echo "❌ warm source must be stopped before fleet provisioning (state=$(pool_machine_state "$WARM_ID" 2>/dev/null || echo unknown))" >&2
        exit 1
    }
    warm_json="$(FLY machines list -a "$APP" --json 2>/dev/null || echo '[]')"
    warm_shape="$(printf '%s' "$warm_json" | pool_machine_shape_from_json "$WARM_ID")" || {
        echo "❌ could not re-read warm source shape after stop wait" >&2; exit 1;
    }
    read -r warm_state warm_kind warm_cpus warm_memory <<< "$warm_shape"
    [ "$warm_state" = "stopped" ] || {
        echo "❌ warm source must be stopped before fleet provisioning (state=$warm_state)" >&2
        exit 1
    }
fi
if [ "$warm_kind/$warm_cpus/$warm_memory" != "shared/1/$WARM_PARKED_VM_MEMORY" ]; then
    echo "🅿️  parking warm source at $WARM_PARKED_VM_SIZE/${WARM_PARKED_VM_MEMORY}MB for config headroom"
    park_attempt=1
    park_attempts="${CLOUDBENCH_WARM_PARK_LEASE_ATTEMPTS:-8}"
    park_delay="${CLOUDBENCH_WARM_PARK_LEASE_RETRY_SECONDS:-15}"
    park_out=""
    if ! [[ "$park_attempts" =~ ^[1-9][0-9]*$ ]]; then
        echo "❌ CLOUDBENCH_WARM_PARK_LEASE_ATTEMPTS must be a positive integer (got: ${park_attempts})" >&2
        exit 1
    fi
    if ! [[ "$park_delay" =~ ^[1-9][0-9]*$ ]]; then
        echo "❌ CLOUDBENCH_WARM_PARK_LEASE_RETRY_SECONDS must be a positive integer (got: ${park_delay})" >&2
        exit 1
    fi
    while true; do
        if park_out="$(fly_with_timeout 90 machine update "$WARM_ID" -a "$APP" \
            --vm-size "$WARM_PARKED_VM_SIZE" --vm-memory "$WARM_PARKED_VM_MEMORY" \
            --skip-start --yes 2>&1)"; then
            break
        fi
        if ! printf '%s' "$park_out" | grep -Eqi 'lease currently held|failed to (obtain|get) lease'; then
            printf '%s\n' "$park_out" | sed 's/^/   /' >&2
            echo "❌ could not park warm source for fleet capacity headroom" >&2
            exit 1
        fi
        if [ "$park_attempt" -ge "$park_attempts" ]; then
            printf '%s\n' "$park_out" | sed 's/^/   /' >&2
            echo "❌ could not park warm source for fleet capacity headroom (lease held)" >&2
            exit 1
        fi
        echo "   ⏳ park lease held — retry $park_attempt/$park_attempts in ${park_delay}s" >&2
        sleep "$park_delay"
        park_attempt=$((park_attempt + 1))
    done
fi

# Clones fork the warm volume from a completed snapshot. Fly reports incremental
# stored size, not logical completeness, so a valid current snapshot can be much
# smaller than an older one. Select by lifecycle status + real creation timestamp;
# exclude the zero-byte `running` placeholder exposed while upload is in flight.
VOL_ID="$(FLY volumes list -a "$APP" --json 2>/dev/null | VN="$VOLUME_NAME" python3 -c '
import json,os,sys
try: d=json.load(sys.stdin) or []
except Exception: d=[]
vn=os.environ["VN"]
for v in d:
    if v.get("name")==vn and v.get("id"): print(v["id"]); break
' 2>/dev/null || true)"
[ -n "$VOL_ID" ] || { echo "❌ Could not find warm volume '$VOLUME_NAME' in $APP" >&2; exit 1; }
# CLOUDBENCH_SNAPSHOT_ID pins a specific snapshot (Fly can't delete snapshots, so
# when the auto-selected newest one is stale — e.g. missing the dep-fingerprint
# marker → cloudbench-sync-deps.sh FATAL — pin a known-good one until a fresh
# warm image/snapshot is baked).
if [ -n "${CLOUDBENCH_SNAPSHOT_ID:-}" ]; then
    SNAP_ID="$CLOUDBENCH_SNAPSHOT_ID"
    echo "📌 pinned snapshot (CLOUDBENCH_SNAPSHOT_ID): $SNAP_ID"
else
    # `|| echo '[]'` made a failed provider read indistinguishable from "this
    # volume has no snapshots", and the caller then aborts the whole lane with
    # "No complete snapshot". With several controllers polling Fly at once a
    # single rate-limited read killed a healthy lane that had ten usable
    # snapshots. Retry until the listing itself is valid JSON, and only then let
    # an empty result mean absence.
    SNAPSHOTS_JSON=""
    for _snap_attempt in 1 2 3 4 5 6; do
        SNAPSHOTS_JSON="$(FLY volume snapshots list "$VOL_ID" -a "$APP" --json 2>/dev/null || true)"
        if printf '%s' "$SNAPSHOTS_JSON" | python3 -c 'import json,sys; sys.exit(0 if isinstance(json.load(sys.stdin), list) else 1)' 2>/dev/null; then
            break
        fi
        SNAPSHOTS_JSON=""
        [ "$_snap_attempt" = "6" ] || sleep $(( _snap_attempt * 3 ))
    done
    if [ -z "$SNAPSHOTS_JSON" ]; then
        echo "❌ could not read volume snapshots for $VOL_ID after 6 attempts (provider read failure, not a missing snapshot)" >&2
        exit 1
    fi
    RECORDED_SNAP_ID="$(awk 'NF >= 4 {print $4; exit}' "$GIT_COMMON_DIR/cloudbench-warm-deps.fp" 2>/dev/null || true)"
    # The newest snapshot is not necessarily proven: an interrupted refresh can
    # leave a newer complete snapshot without ever publishing its dependency
    # proof. Prefer the exact recorded snapshot while it still exists and is
    # complete; warm_deps_preflight below independently verifies its fingerprints
    # and creation epoch. This prevents an orphan snapshot from invalidating a
    # perfectly warm 30-Machine pool and triggering another multi-minute cut.
    if [ -n "$RECORDED_SNAP_ID" ] && printf '%s' "$SNAPSHOTS_JSON" | \
        SID="$RECORDED_SNAP_ID" python3 -c '
import json, os, sys
try: snapshots = json.load(sys.stdin) or []
except Exception: snapshots = []
valid = {"created", "complete", "completed", "ready"}
match = next((s for s in snapshots if s.get("id") == os.environ["SID"]), None)
raise SystemExit(0 if match and str(match.get("status") or "").lower() in valid
                 and int(match.get("size") or 0) > 0 and match.get("created_at") else 1)
' 2>/dev/null; then
        SNAP_ID="$RECORDED_SNAP_ID"
        echo "🧾 using recorded proven snapshot: $SNAP_ID"
    else
        SNAP_ID="$(printf '%s' "$SNAPSHOTS_JSON" | python3 "$SNAPSHOT_SELECTOR_SCRIPT" 2>/dev/null || true)"
    fi
fi
if [ -z "$SNAP_ID" ]; then
    echo "❌ No complete snapshot for warm volume $VOL_ID. Create one and wait for it to finish:" >&2
    echo "   flyctl volume snapshots create $VOL_ID -a $APP   # then wait until STORED SIZE ≈ VOL SIZE" >&2
    exit 1
fi
# ── Preflight: will clones inherit up-to-date dep trees from this snapshot? ──
# When the warm snapshot's node_modules/venv are stale vs the current ref's
# manifests, EVERY clone pays a multi-minute rsync refresh on bring-up — the
# fleet's dominant cost at width. --refresh-deps records what the snapshot
# carries in a git-common state file (shared across sibling workspaces); heal
# centrally ONCE when it drifts.
snapshot_created_epoch() {  # snapshot_created_epoch <snap_id>
    FLY volume snapshots list "$VOL_ID" -a "$APP" --json 2>/dev/null | SID="$1" python3 -c '
import json, os, sys
from datetime import datetime
try: snaps = json.load(sys.stdin) or []
except Exception: snaps = []
for s in snaps:
    if s.get("id") == os.environ["SID"]:
        try:
            print(int(datetime.fromisoformat(str(s.get("created_at","")).replace("Z","+00:00")).timestamp()))
        except ValueError:
            print(0)
        break
' 2>/dev/null || true
}
snapshot_is_complete_exact() {  # snapshot_is_complete_exact <snap_id>
    FLY volume snapshots list "$VOL_ID" -a "$APP" --json 2>/dev/null | SNAP_ID="$1" python3 -c '
import json, os, sys
try: snaps = json.load(sys.stdin) or []
except Exception: raise SystemExit(1)
match = next((s for s in snaps if s.get("id") == os.environ["SNAP_ID"]), None)
valid = {"created", "complete", "completed", "ready"}
raise SystemExit(0 if match and str(match.get("status") or "").lower() in valid
                 and int(match.get("size") or 0) > 0 else 1)
' 2>/dev/null
}
CURRENT_NODE_FP=""
CURRENT_PY_FP=""
warm_deps_preflight() {
    local state="$GIT_COMMON_DIR/cloudbench-warm-deps.fp"
    local node_fp py_fp snap_epoch s_node s_py s_epoch _rest new_snap
    node_fp="$(cloudbench_node_dependency_fingerprint "$ROOT_DIR" 2>/dev/null || true)"
    py_fp="$(cloudbench_manifest_fingerprint "$ROOT_DIR" "${CLOUDBENCH_PYTHON_MANIFESTS[@]}" 2>/dev/null || true)"
    CURRENT_NODE_FP="$node_fp"
    CURRENT_PY_FP="$py_fp"
    if [ -z "$node_fp" ] || [ -z "$py_fp" ]; then
        echo "⚠️  could not fingerprint dep manifests — skipping warm-deps preflight" >&2
        return 0
    fi
    if [ -f "$state" ]; then
        read -r s_node s_py s_epoch _rest < "$state" || true
        snap_epoch="$(snapshot_created_epoch "$SNAP_ID")"
        if [ "$s_node" = "$node_fp" ] && [ "$s_py" = "$py_fp" ] && \
           [ "$_rest" = "$SNAP_ID" ] && \
           [ "${snap_epoch:-0}" -ge $(( ${s_epoch:-0} - 60 )) ]; then
            echo "✅ warm snapshot dep trees match the current ref (fast bring-up)"
            return 0
        fi
    fi
    # Uncommitted manifest edits can't be healed centrally (--refresh-deps syncs
    # the committed ref), and the task-box path intentionally refuses to install
    # from the network. Fail before provisioning instead of advertising an
    # impossible per-box fallback.
    if ! git -C "$ROOT_DIR" diff --quiet HEAD -- agents/requirements.txt \
        '*package.json' '*package-lock.json' 2>/dev/null; then
        echo "❌ dep manifests are DIRTY vs HEAD — commit them before the central dependency rebuild" >&2
        return 1
    fi
    if [ "${CLOUDBENCH_WARM_DEPS_AUTOREFRESH:-1}" != "1" ]; then
        echo "❌ warm snapshot dep trees are STALE vs the current ref and automatic maintenance is disabled." >&2
        echo "    heal centrally: bash scripts/run-bench-cloud --refresh-deps --ref $BENCH_REF" >&2
        return 1
    fi
    write_startup_card "healing warm snapshot (dep trees)"
    echo "♻️  warm snapshot dep trees unproven/stale → central refresh ONCE (instead of ×${#BENCHES[@]} per-clone rsyncs) ..."
    # Export a live controller token so --refresh-deps never depends solely on
    # the durable Fly GITHUB_TOKEN secret (often missing/stale on the warm box).
    if _refresh_tok_b64="$(controller_github_token_b64 2>/dev/null)"; then
        export CLOUDBENCH_GITHUB_TOKEN_B64="$_refresh_tok_b64"
    fi
    unset _refresh_tok_b64
    if bash "$RUN_BENCH_CLOUD_BIN" --refresh-deps --ref "$BENCH_REF" 2>&1 | while IFS= read -r _l; do printf '   %s\n' "$_l"; done; then
        s_node=""; s_py=""; s_epoch=""; new_snap=""
        [ -f "$state" ] && read -r s_node s_py s_epoch new_snap < "$state" || true
        snap_epoch="$(snapshot_created_epoch "$new_snap")"
        if [ "$s_node" = "$node_fp" ] && [ "$s_py" = "$py_fp" ] \
            && [ -n "$new_snap" ] && snapshot_is_complete_exact "$new_snap" \
            && [ "${snap_epoch:-0}" -ge $(( ${s_epoch:-0} - 60 )) ]; then
            SNAP_ID="$new_snap"
            echo "✅ central refresh done — forking from its exact proven snapshot $SNAP_ID"
            return 0
        fi
        echo "❌ central refresh returned without a matching exact snapshot proof" >&2
    fi
    echo "❌ central dep refresh failed; refusing to provision task machines" >&2
    return 1
}
warm_deps_preflight || exit 1
echo "🧊 forking clones from complete snapshot: $SNAP_ID"

# A newer snapshot is not proof that it contains the dependency state recorded
# for an older snapshot: the mutable warm checkout can subsequently move to an
# older ref. Likewise, an existing pool must carry the manifest fingerprints
# current code expects. Fail before claiming or starting a single task box.
if [ -s "$POOL_IDS_FILE" ]; then
    pool_node=""; pool_py=""; pool_snap=""
    [ -f "$POOL_META_FILE" ] && read -r pool_node pool_py pool_snap < "$POOL_META_FILE" || true
    if [ -z "$CURRENT_NODE_FP" ] || [ -z "$CURRENT_PY_FP" ] \
        || [ "$pool_node" != "$CURRENT_NODE_FP" ] \
        || [ "$pool_py" != "$CURRENT_PY_FP" ]; then
        echo "❌ pooled machines were built from unproven/stale dependency trees; refusing to start them" >&2
        echo "   retire this workspace's stopped pool first; then rebuild with: bash scripts/run-bench-fleet --provision-pool ${PROVISION_POOL:-${#BENCHES[@]}}" >&2
        exit 1
    fi
    echo "✅ pooled dependency trees match the current ref (${pool_snap:-unknown snapshot})"
fi

# Recover only positively owned ephemeral clones whose same-host controller
# identity is definitively dead. Any active runner, unreadable probe, malformed
# ownership, or transitional provider state blocks new provisioning.
reconcile_stale_fleet_registries || exit 1
# Reap data-plane proxy tunnels leaked by SIGKILLed/crashed controllers before
# provisioning, so a backlog of orphaned tunnels can't starve this run's proxies.
reap_orphaned_fleet_proxies
# Recovery may have removed active machines. Capacity must classify the
# post-reconciliation provider state, not the earlier warm-source lookup.
warm_json="$(FLY machines list -a "$APP" --json 2>/dev/null)" || {
    echo "❌ App capacity guard could not refresh machine state after stale-fleet recovery." >&2
    exit 1
}

# ── App-wide capacity guard — shared CPU + physical Machine count ────────────
# Fly independently enforces an org Machine-count ceiling and a shared-CPU
# overcommit governor. Live inventory at the epoch-13 failure was 100 org
# Machines: 56 in this benchmark app and 44 outside it. Model 56 truthfully as
# the benchmark app's explicit allocation, not as a fictional 60−4 org limit.
# Stopped inventory is compute-free but still occupies a Machine slot, while a
# config-only `machine update --skip-start` briefly allocates a replacement.
# Host-wide durable reservations close the cross-workspace check-then-act race.
enforce_app_capacity_guard() {
    local shared_cpu_governor shared_cpu_headroom shared_cpu_ceiling
    local app_machine_ceiling primary_nx primary_shared_units requested_machines
    local requested_shared requested_fresh_machines available_pool_machines
    local requested_pool_eligible_machines bench bench_vm_size bench_shared_units
    local replacement_slots reservation_machine_slots reservation_result reservation_status
    local reservation_outcome reserved_machines reserved_shared
    local capacity_counts active_shared active_perf
    local running_machines stopped_machines total_machines projected_shared
    local projected_machines soft_line

    CAPACITY_RESERVATION_ROOT="${CAPACITY_RESERVATION_ROOT:-${CLOUDBENCH_CAPACITY_RESERVATION_ROOT:-${TMPDIR:-/tmp}/rose-cloudbench-capacity-$APP}}"
    CAPACITY_RESERVATION_TOKEN="${CAPACITY_RESERVATION_TOKEN:-$FLEET_OWNER_TOKEN-primary}"
    CAPACITY_RESERVATION_PUBLISHED="${CAPACITY_RESERVATION_PUBLISHED:-0}"
    shared_cpu_governor="${CLOUDBENCH_SHARED_CPU_GOVERNOR:-160}"
    # The shared-CPU governor is org-wide while this guard sees only the
    # benchmark app, so retain the separately established production headroom.
    shared_cpu_headroom="${CLOUDBENCH_SHARED_CPU_HEADROOM:-20}"
    app_machine_ceiling="${CLOUDBENCH_APP_MACHINE_CEILING:-56}"
    replacement_slots="${CLOUDBENCH_BOOT_CONFIG_MAX_IN_FLIGHT:-4}"
    case "$shared_cpu_governor:$shared_cpu_headroom:$app_machine_ceiling:$replacement_slots" in
        *[!0-9:]*)
            echo "❌ capacity ceilings, governors, and headroom must be non-negative integers" >&2
            return 1
            ;;
    esac
    if [ "$shared_cpu_governor" -le "$shared_cpu_headroom" ] \
        || [ "$app_machine_ceiling" -lt 1 ] \
        || [ "$replacement_slots" -lt 1 ]; then
        echo "❌ invalid capacity ceiling/governor contract" >&2
        return 1
    fi
    shared_cpu_ceiling=$(( shared_cpu_governor - shared_cpu_headroom ))

    # Shared units per default primary, parsed from the primary shape
    # (shared-cpu-Nx → N); default 2 if the shape is non-standard.
    primary_nx="${FLEET_PRIMARY_VM_SIZE##*-}"; primary_nx="${primary_nx%x}"
    case "$primary_nx" in ''|*[!0-9]*) primary_shared_units=2 ;; *) primary_shared_units="$primary_nx" ;; esac
    requested_machines="${PROVISION_POOL:-${#BENCHES[@]}}"
    requested_pool_eligible_machines="$requested_machines"
    if [ -n "${PROVISION_POOL:-}" ]; then
        requested_shared=$(( requested_machines * primary_shared_units ))
    else
        requested_shared=0
        requested_pool_eligible_machines=0
        for bench in "${BENCHES[@]}"; do
            bench_vm_size="$(primary_vm_size_for_bench "$bench")"
            bench_shared_units="$(shared_cpu_units_for_vm_size "$bench_vm_size")"
            case "$bench_shared_units" in ''|*[!0-9]*)
                echo "❌ invalid shared-CPU units for primary VM size '$bench_vm_size'" >&2
                return 1
                ;;
            esac
            requested_shared=$(( requested_shared + bench_shared_units ))
            if ! bench_needs_bundled_frontend_primary "$bench"; then
                requested_pool_eligible_machines=$(( requested_pool_eligible_machines + 1 ))
            fi
        done
    fi
    # Pool provisioning does not run the post-clone boot-config update phase.
    [ -n "${PROVISION_POOL:-}" ] && replacement_slots=0

    available_pool_machines="$(available_stopped_pool_machine_count "$warm_json")" || {
        echo "❌ App capacity guard could not classify available stopped pool Machines." >&2
        return 1
    }
    case "$available_pool_machines" in ''|*[!0-9]*)
        echo "❌ App capacity guard received an invalid available-pool count." >&2
        return 1
        ;;
    esac
    [ "$available_pool_machines" -gt "$requested_pool_eligible_machines" ] \
        && available_pool_machines="$requested_pool_eligible_machines"
    requested_fresh_machines=$(( requested_machines - available_pool_machines ))
    reservation_machine_slots=$(( requested_fresh_machines + replacement_slots ))

    capacity_counts="$(printf '%s' "$warm_json" | python3 -c '
import json, sys
try:
    machines = json.load(sys.stdin)
    if not isinstance(machines, list) or any(not isinstance(m, dict) for m in machines):
        raise ValueError("invalid machine list")
    active_shared = active_perf = running = stopped = 0
    for m in machines:
        if m.get("state") == "stopped":
            stopped += 1
            continue
        running += 1
        guest = (m.get("config") or {}).get("guest") or {}
        cpus = guest.get("cpus")
        cpus = cpus if isinstance(cpus, int) and cpus > 0 else 1
        if guest.get("cpu_kind") == "shared":
            active_shared += cpus
        else:
            active_perf += cpus
    print(active_shared, active_perf, running, stopped, len(machines))
except Exception:
    print("")
' 2>/dev/null || true)"
    if [ -z "$capacity_counts" ]; then
        echo "❌ App capacity guard could not classify current machine states; refusing to provision." >&2
        return 1
    fi
    read -r active_shared active_perf running_machines stopped_machines total_machines <<< "$capacity_counts"

    reservation_status=0
    reservation_result="$(capacity_reserve_slots "$CAPACITY_RESERVATION_TOKEN" \
        "$reservation_machine_slots" "$requested_shared" \
        "$app_machine_ceiling" "$shared_cpu_ceiling" \
        "$total_machines" "$active_shared" primary)" || reservation_status=$?
    read -r reservation_outcome reserved_machines reserved_shared \
        projected_machines projected_shared <<< "$reservation_result"
    if [ "$reservation_status" -ne 0 ]; then
        case "$reservation_outcome" in
            DENY_MACHINE)
                echo "❌ Machine-count capacity admission denied: $total_machines app Machines" >&2
                [ "${reserved_machines:-0}" -gt 0 ] \
                    && echo "   + $reserved_machines slots reserved by live workstreams" >&2
                echo "   + this run's $requested_fresh_machines fresh primaries ($available_pool_machines from stopped pool)" >&2
                echo "   + $replacement_slots boot-config replacement slots = $projected_machines" >&2
                echo "   > benchmark-app Machine ceiling $app_machine_ceiling." >&2
                echo "   Wait for another workstream to drain or adjust this app allocation after the org reservation changes." >&2
                ;;
            DENY_SHARED)
                echo "❌ Shared-CPU capacity governor reached: $active_shared active shared units" >&2
                [ "${reserved_shared:-0}" -gt 0 ] \
                    && echo "   + $reserved_shared units reserved by live workstreams" >&2
                echo "   + this run's $requested_machines primaries ($requested_shared units) = $projected_shared" >&2
                echo "   > ceiling $shared_cpu_ceiling (governor $shared_cpu_governor − headroom $shared_cpu_headroom)." >&2
                echo "   Raise the Fly org reservation and CLOUDBENCH_SHARED_CPU_GOVERNOR together, or wait for another workstream to drain." >&2
                ;;
            *)
                echo "❌ App capacity reservation failed closed: ${reservation_result#ERROR }" >&2
                ;;
        esac
        return 1
    fi
    CAPACITY_RESERVATION_PUBLISHED=1

    if [ "$projected_shared" -gt "$shared_cpu_ceiling" ]; then
        # Defensive: capacity_reserve_slots owns this decision atomically.  A
        # contradictory success is an internal contract failure, not admission.
        echo "❌ Shared-CPU capacity reservation returned an invalid projection." >&2
        capacity_release_reservation "$CAPACITY_RESERVATION_TOKEN" || true
        CAPACITY_RESERVATION_PUBLISHED=0
        return 1
    fi
    if [ "$reservation_outcome" != "OK" ]; then
        echo "❌ App capacity reservation returned an invalid result." >&2
        capacity_release_reservation "$CAPACITY_RESERVATION_TOKEN" || true
        CAPACITY_RESERVATION_PUBLISHED=0
        return 1
    fi

    # Announce pressure on either physical boundary so concurrent runs stay visible.
    soft_line=$(( shared_cpu_ceiling * 3 / 4 ))
    if [ "$projected_shared" -gt "$soft_line" ]; then
        echo "🧵 auto-reserving shared capacity for this workstream: $projected_shared/$shared_cpu_ceiling units" >&2
        echo "   ($active_shared active + $reserved_shared live-reserved + $requested_shared requested; $active_perf perf units; running=$running_machines stopped=$stopped_machines; Machines=$total_machines+$reserved_machines+$reservation_machine_slots/$app_machine_ceiling) — proceeding." >&2
    elif [ "$available_pool_machines" -gt 0 ] || [ "$reserved_machines" -gt 0 ]; then
        echo "🧵 capacity admitted with $available_pool_machines stopped pool Machine(s) and $reserved_machines live cross-workstream slot(s) already accounted."
    fi

    return 0
}
enforce_app_capacity_guard || exit 1

release_capacity_reservation_after_primary_start_accounted() {
    # Replacement slots are no longer needed once every stopped boot config is
    # committed.  Keep the shared-unit reservation until Fly inventory itself
    # shows each accepted primary start as non-stopped; releasing on the local
    # barrier alone would let a neighbor admit during provider-state lag.
    local deadline accounted out
    [ "$CAPACITY_RESERVATION_PUBLISHED" = "1" ] || return 0
    [ "${CHILD_MACHINE[0]+set}" = "set" ] || return 1
    if [ "${#CHILD_MACHINE[@]}" -ne "${#BENCHES[@]}" ] \
        || [ "${#CHILD_OUT[@]}" -ne "${#BENCHES[@]}" ]; then
        echo "⚠️  retaining startup capacity reservation: only ${#CHILD_MACHINE[@]}/${#BENCHES[@]} requested primaries provisioned" >&2
        return 1
    fi
    deadline=$((SECONDS + ${CLOUDBENCH_CAPACITY_START_ACCOUNTING_SECONDS:-120}))
    while [ "$SECONDS" -lt "$deadline" ]; do
        accounted=1
        for out in "${CHILD_OUT[@]}"; do
            [ -s "$out/post-config-start.accepted" ] || { accounted=0; break; }
        done
        if [ "$accounted" = "1" ]; then
            accounted="$({ FLY machines list -a "$APP" --json 2>/dev/null || true; } \
                | MACHINE_IDS="${CHILD_MACHINE[*]}" python3 -c '
import json
import os
import sys

try:
    machines = json.load(sys.stdin)
    if not isinstance(machines, list):
        raise ValueError
    states = dict(
        (machine.get("id"), machine.get("state"))
        for machine in machines
        if isinstance(machine, dict) and machine.get("id")
    )
    ids = os.environ["MACHINE_IDS"].split()
    print(1 if ids and all(states.get(machine_id) not in (None, "stopped") for machine_id in ids) else 0)
except (TypeError, ValueError, json.JSONDecodeError):
    print(0)
'
)"
            if [ "$accounted" = "1" ]; then
                if capacity_release_reservation "$CAPACITY_RESERVATION_TOKEN"; then
                    CAPACITY_RESERVATION_PUBLISHED=0
                    echo "🧵 released startup capacity reservation after all primary starts became provider-visible"
                    return 0
                fi
                echo "❌ could not release the startup capacity reservation" >&2
                return 1
            fi
        fi
        sleep 0.2
    done
    echo "⚠️  retaining startup capacity reservation: primary starts did not become provider-visible within the accounting window" >&2
    return 1
}

reserve_worker_machine_slot() {  # <unique-reservation-token>
    # Autoscaler workers are created after startup admission is released.  Give
    # every dynamic clone the same serialized one-Machine check so concurrent
    # autoscalers cannot refill the Machine ceiling behind the startup guard.
    local token="$1" app_machine_ceiling current_machines result status outcome
    local reserved_machines reserved_shared projected_machines projected_shared
    app_machine_ceiling="${CLOUDBENCH_APP_MACHINE_CEILING:-56}"
    case "$app_machine_ceiling" in ''|*[!0-9]*|0) return 1 ;; esac
    current_machines="$(FLY machines list -a "$APP" --json 2>/dev/null | python3 -c '
import json, sys
try:
    machines = json.load(sys.stdin)
    if not isinstance(machines, list) or any(not isinstance(machine, dict) for machine in machines):
        raise ValueError
    print(len(machines))
except Exception:
    print("")
' 2>/dev/null)"
    case "$current_machines" in ''|*[!0-9]*) return 1 ;; esac
    result="$(capacity_reserve_slots "$token" 1 0 "$app_machine_ceiling" \
        2147483647 "$current_machines" 0 autoscaler-worker)"
    status=$?
    read -r outcome reserved_machines reserved_shared projected_machines projected_shared <<< "$result"
    if [ "$status" -ne 0 ] || [ "$outcome" != "OK" ]; then
        echo "❌ dynamic worker capacity denied: $current_machines app Machines + ${reserved_machines:-0} reserved + 1 requested > ceiling $app_machine_ceiling" >&2
        return 1
    fi
    return 0
}

# --provision-pool: one-time pre-provision of N stopped clones, then exit.
if [ -n "$PROVISION_POOL" ]; then
    # Pool slots all observe ONE controller-owned inventory stream. Without it,
    # 30 readiness loops each issued machine+volume list calls every five
    # seconds (90 API reads/cycle), recreating resource_exhausted before the
    # benchmark even started.
    start_machines_snapshot_loop || exit 1
    provision_pool "$PROVISION_POOL"
    exit $?
fi

CODE_SUMMARY=""
print_code_provenance

# ── Per-bench worker autoscaling (prod params, scoped to the bench's queue) ──
# The box worker computes desired_machine_count off its own Temporal queue with
# prod's exact params (backlog ≥20% capacity → add ceil(backlog/capacity); 60s
# zero backlog → remove) and exposes it on HEALTH_CHECK_PORT/metrics, but never
# actuates (FLY_APP_NAME="" + AUTOSCALER_ACTUATE=0). We read that number and
# reconcile a pool of WORKER-ONLY clones bound to THIS bench's queue + backend
# (Fly 6PN) — the same shape as prod's pool, isolated per bench. Workers are torn
# down on scale-down and at fleet exit.
BOX_HEALTH_PORT="3003"     # cloudbench-run.sh HEALTH_PORT = CONDUCTOR_PORT(3001)+2
BOX_BACKEND_PORT="3001"
BOX_WMH_PORT="3007"        # run.sh WMH_PORT = base+6
FLEET_PATCH_FILE=""
FLEET_PATCH_SHA256=""
if [ "${CLOUDBENCH_SKIP_LOCAL_PATCH:-0}" != "1" ] \
   && { [ "$REQUESTED_BENCH_REF" != "$BENCH_REF" ] \
        || cloudbench_worktree_has_changes "$ROOT_DIR"; }; then
    FLEET_PATCH_FILE="$(mktemp)"
    fleet_patch_rc=0
    cloudbench_prepare_workspace_patch \
        "$ROOT_DIR" "$BENCH_REF" "$FLEET_PATCH_FILE" \
        "$ROOT_DIR/scripts/create-worktree-patch.sh" || fleet_patch_rc=$?
    if [ "$fleet_patch_rc" -eq "$CLOUDBENCH_PATCH_NO_DELTA" ]; then
        # The unpushed HEAD carries only content the patch generator excludes
        # (append-only history ledgers), so the base ref already IS the code
        # under test. Shipping nothing is exactly equivalent here.
        rm -f "$FLEET_PATCH_FILE"
        FLEET_PATCH_FILE=""
        echo "📦 no shippable workspace delta beyond $BENCH_REF (append-only ledgers only); guests run the base ref"
    elif [ "$fleet_patch_rc" -ne 0 ]; then
        echo "❌ could not create the fleet local workspace patch" >&2
        exit 1
    fi
fi
if [ -n "$FLEET_PATCH_FILE" ]; then
    FLEET_PATCH_SHA256="$(cloudbench_env_sha256 "$FLEET_PATCH_FILE")"
    [ -n "$FLEET_PATCH_SHA256" ] || {
        echo "❌ could not fingerprint the fleet local workspace patch" >&2
        exit 1
    }
fi

_machine_priv_ip() {  # _machine_priv_ip <machine_id>
    inventory_machine_field "$1" private_ip 2>/dev/null || true
}

# Freeze the exact execution lane before the first task Machine is provisioned.
# Only explicit non-secret values enter this document: credentials, auth
# material, barrier tokens, and their hashes are intentionally absent. The
# helper re-hashes the actual immutable snapshot here, so a stale or edited
# dependency bundle cannot be promoted merely by retaining its old manifest.
EXECUTION_PROVENANCE_FILE="$FLEET_DIR/execution-provenance.json"
EXECUTION_TASK_MATRIX_FILE="$FLEET_DIR/execution-task-matrix.json"
workspace_patch_provenance="${FLEET_PATCH_SHA256:-none}"
TASK_MATRIX_ARGS=()
for i in "${!BENCHES[@]}"; do
    provenance_mode="${CATALOG_MODES[$i]}"
    is_sim_on "${BENCHES[$i]}" && provenance_mode="simulate"
    TASK_MATRIX_ARGS+=(--task "${BENCHES[$i]}=$provenance_mode")
done
if ! TASK_MATRIX_SHA256="$(python3 "$EXECUTION_PROVENANCE_SCRIPT" digest-task-matrix \
    "${TASK_MATRIX_ARGS[@]}" --output "$EXECUTION_TASK_MATRIX_FILE")" \
    || [ -z "$TASK_MATRIX_SHA256" ]; then
    echo "❌ could not freeze the ordered Cloud Fleet task matrix" >&2
    exit 1
fi
PROVENANCE_CONFIG_ARGS=(
    --config-value "app=$APP"
    --config-value "region=$REGION"
    --config-value "run_timeout_seconds=$RUN_TIMEOUT"
    --config-value "child_run_timeout_seconds=$CHILD_RUN_TIMEOUT"
    --config-value "synchronized_start=$SYNCHRONIZED_START"
    --config-value "first_run_stack_wait_seconds=$FIRST_RUN_STACK_WAIT_SECONDS"
    --config-value "per_box_barrier_wait_seconds=$PER_BOX_BARRIER_WAIT_SECONDS"
    --config-value "start_barrier_wait_seconds=$START_BARRIER_WAIT_SECONDS"
    --config-value "boot_launch=${CLOUDBENCH_BOOT_LAUNCH:-1}"
    --config-value "boot_config_max_in_flight=${CLOUDBENCH_BOOT_CONFIG_MAX_IN_FLIGHT:-4}"
    --config-value "boot_update_capacity_wait_seconds=$BOOT_UPDATE_CAPACITY_WAIT_SECONDS"
    --config-value "boot_config_barrier_wait_seconds=$BOOT_CONFIG_BARRIER_WAIT_SECONDS"
    --config-value "primary_vm_size=$FLEET_PRIMARY_VM_SIZE"
    --config-value "primary_vm_memory_mb=$FLEET_PRIMARY_VM_MEMORY"
    --config-value "bundled_frontend_vm_size=$FLEET_BUNDLED_FRONTEND_VM_SIZE"
    --config-value "bundled_frontend_vm_memory_mb=$FLEET_BUNDLED_FRONTEND_VM_MEMORY"
    --config-value "worker_vm_size=$FLEET_WORKER_VM_SIZE"
    --config-value "worker_vm_memory_mb=$FLEET_WORKER_VM_MEMORY"
    --config-value "worker_health_port=$FLEET_WORKER_HEALTH_PORT"
    --config-value "warm_parked_vm_size=$WARM_PARKED_VM_SIZE"
    --config-value "warm_parked_vm_memory_mb=$WARM_PARKED_VM_MEMORY"
    --config-value "autoscale_max=$AUTOSCALE_MAX"
    --config-value "autoscale_poll_seconds=$AUTOSCALE_POLL"
    --config-value "autoscale_scale_down_confirm_seconds=${AUTOSCALE_SCALE_DOWN_CONFIRM_SECONDS:-${CLOUDBENCH_AUTOSCALE_SCALE_DOWN_CONFIRM_SECONDS:-60}}"
    --config-value "autoscaler_startup_wait_seconds=$AUTOSCALER_STARTUP_WAIT_SECONDS"
    --config-value "autoscaler_finalization_wait_seconds=$AUTOSCALER_FINALIZATION_WAIT_SECONDS"
    --config-value "worker_stage_attempts=$WORKER_STAGE_ATTEMPTS"
    --config-value "worker_stage_attempt_wall_seconds=$WORKER_STAGE_ATTEMPT_WALL_SECONDS"
    --config-value "worker_ready_timeout_seconds=$WORKER_READY_TIMEOUT"
    --config-value "snapshot_poll_seconds=$SNAPSHOT_POLL"
    --config-value "snapshot_refresh_timeout_seconds=$SNAPSHOT_REFRESH_TIMEOUT"
    --config-value "inventory_max_stale_seconds=$INVENTORY_MAX_STALE_SECONDS"
    --config-value "clone_launch_stagger_seconds=${CLOUDBENCH_CLONE_LAUNCH_STAGGER_SECONDS:-0.4}"
    --config-value "launch_stagger_seconds=${CLOUDBENCH_LAUNCH_STAGGER_SECONDS:-0.25}"
    --config-value "keep_clones=$KEEP_CLONES"
    --config-value "guest_pg_major=$CLOUDBENCH_GUEST_PG_MAJOR"
    --config-value "seed_cache_identity=$_SEED_GUEST_TOKEN"
    --config-value "volume_snapshot_id=$SNAP_ID"
    --config-value "node_dependency_fingerprint=$CURRENT_NODE_FP"
    --config-value "python_dependency_fingerprint=$CURRENT_PY_FP"
    --config-value "per_child_max_concurrency=5"
    --config-value "wmh_model_name=rose-r2-archive-anthropic"
    --config-value "benchmark_fast_mode_cache=${BENCHMARK_FAST_MODE_CACHE:-}"
    --config-value "benchmark_claude_code_cache_ratchet_warn_only=${BENCHMARK_CLAUDE_CODE_CACHE_RATCHET_WARN_ONLY:-}"
    --config-value "rose_exclude_anthropic_family=${ROSE_EXCLUDE_ANTHROPIC_FAMILY:-}"
    --config-value "task_count=${#BENCHES[@]}"
    --config-value "task_matrix_sha256=$TASK_MATRIX_SHA256"
)
if ! python3 "$EXECUTION_PROVENANCE_SCRIPT" create \
    --base-sha "$BENCH_REF" \
    --workspace-patch-sha256 "$workspace_patch_provenance" \
    --snapshot-dir "$CLOUDBENCH_SCRIPT_SNAPSHOT" \
    --snapshot-manifest "$CONTROLLER_SNAPSHOT_MANIFEST" \
    --config-version cloudbench-fleet-config-v1 \
    "${PROVENANCE_CONFIG_ARGS[@]}" \
    --output "$EXECUTION_PROVENANCE_FILE"; then
    echo "❌ could not freeze Cloud Fleet execution provenance" >&2
    exit 1
fi
chmod 0444 "$EXECUTION_PROVENANCE_FILE" "$EXECUTION_TASK_MATRIX_FILE" || {
    echo "❌ could not make Cloud Fleet execution provenance immutable" >&2
    exit 1
}
echo "🔏 execution provenance: $EXECUTION_PROVENANCE_FILE"

_box_desired() {  # _box_desired <local-metrics-url> → desired_machine_count or empty
    curl --noproxy '*' -fsS --max-time 3 "$1/metrics" 2>/dev/null \
        | awk '/^desired_machine_count / {print $2; exit}' \
        | tr -dc '0-9'
}

claim_autoscaler_metrics_port() {  # <output-variable> <owner-pid> <owner-token>
    local output_var="$1" owner_pid="$2" owner_token="$3"
    local root port
    root="${AUTOSCALER_PORT_LEASE_ROOT:-${TMPDIR:-/tmp}/rose-cloudbench-autoscaler-port-leases}"
    port="$(python3 "$AUTOSCALER_PORT_LEASE_HELPER" claim \
        --root "$root" --owner-pid "$owner_pid" --token "$owner_token" \
        --start "${CLOUDBENCH_AUTOSCALER_PORT_START:-0}")" || return 1
    case "$port" in ''|*[!0-9]*) return 1 ;; esac
    printf -v "$output_var" '%s' "$port"
}

release_autoscaler_metrics_port() {  # <port> <owner-pid> <owner-token>
    local port="$1" owner_pid="$2" owner_token="$3" root
    [ -n "$port" ] || return 0
    root="${AUTOSCALER_PORT_LEASE_ROOT:-${TMPDIR:-/tmp}/rose-cloudbench-autoscaler-port-leases}"
    python3 "$AUTOSCALER_PORT_LEASE_HELPER" release \
        --root "$root" --owner-pid "$owner_pid" --token "$owner_token" \
        --port "$port"
}

release_autoscaler_metrics_owner() {  # <owner-pid> <owner-token>
    local owner_pid="$1" owner_token="$2" root
    root="${AUTOSCALER_PORT_LEASE_ROOT:-${TMPDIR:-/tmp}/rose-cloudbench-autoscaler-port-leases}"
    python3 "$AUTOSCALER_PORT_LEASE_HELPER" release-owner \
        --root "$root" --owner-pid "$owner_pid" --token "$owner_token"
}

# `kill -0` alone is not a sufficient liveness check for these background jobs:
# a just-exited child's PID can be reused by one of the controller's frequent
# short-lived probes before the liveness check. `jobs -pr` tracks the shell job
# identity, not merely the numeric PID, so only the actual proxy/autoscaler can
# satisfy the mandatory-autoscaling health gate.
fleet_job_running() {  # fleet_job_running <pid>
    local pid="${1:-}"
    case "$pid" in
        ''|*[!0-9]*) return 1 ;;
    esac
    jobs -pr | grep -qx "$pid"
}

terminate_fleet_runner_group() {  # <runner-pgid> <HUP|INT|TERM>
    local runner_pid="$1" signal_name="$2" grace deadline kill_deadline
    grace="${CLOUDBENCH_RUNNER_TERM_SECONDS:-15}"
    case "$grace" in ''|*[!0-9]*) grace=15 ;; esac
    # Stay strictly inside cleanup's 30s supervisor ceiling, leaving time for
    # SIGKILL propagation, reaping, and marker publication.
    [ "$grace" -le 20 ] || grace=20

    kill -s "$signal_name" -- "-$runner_pid" 2>/dev/null \
        || kill -s "$signal_name" "$runner_pid" 2>/dev/null \
        || true
    deadline=$((SECONDS + grace))
    while kill -0 -- "-$runner_pid" 2>/dev/null; do
        [ "$SECONDS" -lt "$deadline" ] || break
        sleep 0.1
    done
    if kill -0 -- "-$runner_pid" 2>/dev/null; then
        kill -KILL -- "-$runner_pid" 2>/dev/null \
            || kill -KILL "$runner_pid" 2>/dev/null \
            || true
    fi
    wait "$runner_pid" 2>/dev/null || true

    # Include descendants in the proof: the direct runner can be reaped while
    # one of its former proxies remains briefly visible in the process group.
    kill_deadline=$((SECONDS + 3))
    while kill -0 -- "-$runner_pid" 2>/dev/null; do
        [ "$SECONDS" -lt "$kill_deadline" ] || break
        sleep 0.1
    done
    if kill -0 -- "-$runner_pid" 2>/dev/null; then
        echo "❌ runner process group $runner_pid survived bounded teardown" >&2
        return 1
    fi
    return 0
}

run_fleet_child_supervised() {  # <finished-marker> <command> [args...]
    local finished_marker="$1" runner_pid="" runner_rc=125 marker_tmp
    local forwarded_signal_name="" forwarded_signal_rc="" runner_cleanup_failed=0
    shift

    # The asynchronous Bash function is the PID tracked by CHILD_PIDS. Its
    # command is a distinct process, so terminating only the function subshell
    # reparents run-bench-cloud to PID 1. Forward controller teardown signals
    # and wait for run-bench-cloud's own EXIT cleanup before declaring that the
    # child finished.
    trap 'trap "" HUP INT TERM; forwarded_signal_name=HUP; forwarded_signal_rc=129; [ -z "$runner_pid" ] || terminate_fleet_runner_group "$runner_pid" HUP || runner_cleanup_failed=1' HUP
    trap 'trap "" HUP INT TERM; forwarded_signal_name=INT; forwarded_signal_rc=130; [ -z "$runner_pid" ] || terminate_fleet_runner_group "$runner_pid" INT || runner_cleanup_failed=1' INT
    trap 'trap "" HUP INT TERM; forwarded_signal_name=TERM; forwarded_signal_rc=143; [ -z "$runner_pid" ] || terminate_fleet_runner_group "$runner_pid" TERM || runner_cleanup_failed=1' TERM

    # Start the runner as a dedicated session/process-group leader. Python is
    # already a fleet prerequisite and os.setsid avoids Bash's asynchronous
    # job-control edge cases (which can bypass a subshell's signal traps).
    python3 -c 'import os, sys; os.setsid(); os.execvp(sys.argv[1], sys.argv[1:])' "$@" &
    runner_pid=$!
    if [ -n "$forwarded_signal_name" ]; then
        # A signal can arrive after traps are armed but before `$!` is assigned.
        # Replay it now instead of launching an untracked runner after teardown.
        terminate_fleet_runner_group "$runner_pid" "$forwarded_signal_name" \
            || runner_cleanup_failed=1
        runner_rc="$forwarded_signal_rc"
    else
        wait "$runner_pid"
        runner_rc=$?
        [ -z "$forwarded_signal_rc" ] || runner_rc="$forwarded_signal_rc"
        # Normal runner exit should execute its own cleanup. Prove no process in
        # the isolated group survived before publishing the finished marker.
        if kill -0 -- "-$runner_pid" 2>/dev/null; then
            terminate_fleet_runner_group "$runner_pid" TERM \
                || runner_cleanup_failed=1
        fi
    fi
    runner_pid=""
    trap - HUP INT TERM
    [ "$runner_cleanup_failed" -eq 0 ] || runner_rc=125

    marker_tmp="$finished_marker.tmp.$$"
    if ! printf '%s\n' "$runner_rc" > "$marker_tmp"; then
        return 125
    fi
    if ! mv "$marker_tmp" "$finished_marker"; then
        rm -f "$marker_tmp" 2>/dev/null || true
        return 125
    fi
    return "$runner_rc"
}

mandatory_autoscaler_process_acceptable() {  # <bench-output-dir> <autoscaler-pid>
    local out="$1" pid="$2"
    fleet_job_running "$pid" && return 0
    # A child-finished marker is independent and can arrive after an autoscaler
    # silently died. Only the marker published BY the autoscaler after it
    # observed child completion proves that its exit was causally clean.
    [ -e "$out/autoscaler.completed-after-child" ]
}

# The worker-clones id-file is the SOURCE OF TRUTH for the pool size: a machine
# is recorded the instant Fly creates it (BEFORE staging), so a slow/failed stage
# can never make the reconcile think the pool is empty and re-clone in a loop.
_pool_ids() {  # count of tracked worker machines (clean single integer)
    local f="$1/worker-clones.ids" n
    [ -f "$f" ] || { echo 0; return; }
    n="$(grep -c . "$f" 2>/dev/null)"   # grep -c always prints a number; ignore its exit code
    printf '%s' "${n:-0}" | tr -dc '0-9'
    printf '\n'
}

_ready_pool_ids() {  # count of workers proven to have joined the queue
    local f="$1/worker-ready.ids" n
    [ -f "$f" ] || { echo 0; return; }
    n="$(grep -c . "$f" 2>/dev/null)"
    printf '%s\n' "${n:-0}" | tr -dc '0-9\n'
}

worker_operational() {  # worker_operational <machine-id>
    local wid="$1"
    # /health is 200 only after worker.run() has passed Temporal validation and
    # started its poller tasks; worker.py flips it back to 503 on fatal exit.
    # Pair it with the live process check so a stale HTTP response can never
    # preserve capacity after the worker process has gone away.
    fly_with_timeout 20 ssh console -a "$APP" --machine "$wid" \
        -C "bash -c \"pgrep -f 'python [w]orker.py' >/dev/null && curl -fsS --max-time 2 -o /dev/null http://127.0.0.1:$FLEET_WORKER_HEALTH_PORT/health\"" \
        >/dev/null 2>&1
}

ready_workers_operational() {  # ready_workers_operational <bench-output-dir>
    local out="$1" wid pid failed=0
    local -a probe_pids=()
    [ -s "$out/worker-ready.ids" ] || return 0
    while read -r wid; do
        [ -n "$wid" ] || continue
        worker_operational "$wid" &
        probe_pids+=("$!")
    done < "$out/worker-ready.ids"
    for pid in "${probe_pids[@]}"; do
        wait "$pid" || failed=1
    done
    [ "$failed" = "0" ]
}

CONTROLLER_GITHUB_TOKEN_B64_CACHE="${CLOUDBENCH_GITHUB_TOKEN_B64:-}"
controller_github_token_b64() {
    local token=""
    if [ -n "$CONTROLLER_GITHUB_TOKEN_B64_CACHE" ]; then
        # Cached value may be stale empty b64 from a prior empty gh auth token —
        # only reuse when decode is non-empty.
        token="$(printf '%s' "$CONTROLLER_GITHUB_TOKEN_B64_CACHE" | base64 -d 2>/dev/null || true)"
        if [ -n "$token" ]; then
            printf '%s' "$CONTROLLER_GITHUB_TOKEN_B64_CACHE"
            return 0
        fi
        CONTROLLER_GITHUB_TOKEN_B64_CACHE=""
    fi
    # Prefer live controller credentials (git insteadOf / gh hosts) over a
    # stale injected GITHUB_TOKEN — see cloudbench_controller_github_token.
    token="$(cloudbench_controller_github_token "$ROOT_DIR" 2>/dev/null || true)"
    [ -n "$token" ] || return 1
    CONTROLLER_GITHUB_TOKEN_B64_CACHE="$(printf '%s' "$token" | base64 | tr -d '\n')"
    printf '%s' "$CONTROLLER_GITHUB_TOKEN_B64_CACHE"
}

worker_is_tracked() {  # worker_is_tracked <bench-output-dir> <worker-id>
    local out="$1" wid="$2"
    [ -s "$out/worker-clones.ids" ] \
        && grep -Fxq "$wid" "$out/worker-clones.ids" 2>/dev/null
}

pool_has_pending_worker() {  # pool_has_pending_worker <bench-output-dir>
    local out="$1" marker
    for marker in "$out"/worker-*.pending; do
        [ -e "$marker" ] || continue
        return 0
    done
    return 1
}

cancel_worker_for_scale_down() {  # <bench-output-dir> <desired-worker-count>
    local out="$1" want="$2" tracked wid="" candidate rc=0
    case "$want" in ''|*[!0-9]*) return 1 ;; esac

    # Count, choose, and publish cancellation under the same ledger lock. A
    # failed provisioner can otherwise remove pending capacity after the count,
    # leaving scale-down to destroy a healthy ready worker using stale overage.
    worker_ledger_lock_acquire "$out" || return 1
    tracked="$(_pool_ids "$out")"
    case "$tracked" in ''|*[!0-9]*) rc=1 ;; esac
    if [ "$rc" = "0" ] && [ "$tracked" -gt "$want" ] \
        && ! pool_has_pending_worker "$out"; then
        # Allocation plus staging is a committed capacity request, not
        # disposable excess. Scale-down can retire only a worker whose queue
        # readiness was reconciled into the authoritative ready ledger.
        while IFS= read -r candidate; do
            [ -n "$candidate" ] || continue
            if [ ! -e "$out/worker-$candidate.cancelled" ] \
                && [ ! -e "$out/worker-$candidate.pending" ] \
                && worker_is_tracked "$out" "$candidate"; then
                wid="$candidate"
            fi
        done < "$out/worker-ready.ids"
        if [ -n "$wid" ] && ! : > "$out/worker-$wid.cancelled"; then
            rc=1
        fi
    fi
    worker_ledger_lock_release "$out" || rc=1
    [ "$rc" = "0" ] || return 1
    printf '%s\n' "$wid"
}

autoscaler_monotonic_seconds() {  # autoscaler_monotonic_seconds <output-var>
    printf -v "$1" '%s' "$SECONDS"
}

cleanup_failed_worker() {  # cleanup_failed_worker <output-dir> <worker-id>
    local cleanup_out="$1" cleanup_wid="$2" tracking_tmp ready_tmp grep_status rc=0 volume_id
    local cleanup_log="$1/worker-$2.cleanup.log"
    local claim="$1/worker-$2.cleanup-claim" self_pid="${BASHPID:-$$}"
    local claim_token claim_line claim_pid claim_owner claim_started
    claim_token="$self_pid.$(date +%s).$RANDOM"
    local now age attempt=0 claimed=0
    local claim_attempts="${WORKER_CLEANUP_CLAIM_ATTEMPTS:-300}"
    local claim_delay="${WORKER_CLEANUP_CLAIM_RETRY_SECONDS:-0.1}"
    local claim_stale="${WORKER_CLEANUP_CLAIM_STALE_SECONDS:-300}"
    case "$claim_attempts" in ''|*[!0-9]*|0) echo "❌ invalid worker cleanup claim attempts" >&2; return 1 ;; esac
    case "$claim_stale" in ''|*[!0-9]*) echo "❌ invalid worker cleanup stale timeout" >&2; return 1 ;; esac

    # Claim only the target worker while holding the short ledger lock. Provider deletion is slow,
    # so it runs after releasing that lock; other workers can be reconciled concurrently.
    while [ "$attempt" -lt "$claim_attempts" ]; do
        worker_ledger_lock_acquire "$cleanup_out" || return 1
        if [ ! -f "$cleanup_out/worker-clones.ids" ]; then
            worker_ledger_lock_release "$cleanup_out" || true
            return 1
        fi
        if grep -Fxq "$cleanup_wid" "$cleanup_out/worker-clones.ids"; then
            grep_status=0
        else
            grep_status=$?
        fi
        if [ "$grep_status" != "0" ]; then
            worker_ledger_lock_release "$cleanup_out" || return 1
            [ "$grep_status" = "1" ] && return 0
            return 1
        fi

        if [ -f "$claim" ]; then
            claim_line="$(cat "$claim" 2>/dev/null || true)"
            claim_pid=""; claim_owner=""; claim_started=""
            read -r claim_pid claim_owner claim_started < "$claim" 2>/dev/null || true
            now="$(date +%s)"
            case "$claim_started" in ''|*[!0-9]*) claim_started="$now" ;; esac
            age=$((now - claim_started))
            if [ "$age" -ge "$claim_stale" ] \
                && { [ -z "$claim_pid" ] || ! kill -0 "$claim_pid" 2>/dev/null; } \
                && [ "$(cat "$claim" 2>/dev/null || true)" = "$claim_line" ]; then
                rm -f "$claim" || { worker_ledger_lock_release "$cleanup_out" || true; return 1; }
            fi
        fi
        if [ ! -e "$claim" ]; then
            now="$(date +%s)"
            if printf '%s %s %s\n' "$self_pid" "$claim_token" "$now" > "$claim"; then
                claimed=1
            fi
        fi
        worker_ledger_lock_release "$cleanup_out" || return 1
        [ "$claimed" = "1" ] && break
        sleep "$claim_delay"
        attempt=$((attempt + 1))
    done
    if [ "$claimed" != "1" ]; then
        echo "❌ timed out claiming worker cleanup: $cleanup_wid" >&2
        return 1
    fi

    volume_id="$(fleet_registry_volume_for_id "$cleanup_wid")" || {
        echo "❌ worker $cleanup_wid has no durable exact volume ownership; refusing destroy" >&2
        rc=1
    }
    : >> "$cleanup_log" 2>/dev/null || true
    [ "$rc" = "0" ] && reap_machine "$cleanup_wid" "$cleanup_log" "$volume_id" || rc=1
    [ "$rc" = "0" ] && reap_volume "$volume_id" || rc=1
    [ "$rc" = "0" ] \
        && fleet_audit_update_fresh_clone_by_id "$cleanup_wid" destroyed-verified-absent \
        || rc=1
    [ "$rc" = "0" ] && fleet_registry_release_id "$cleanup_wid" || rc=1

    worker_ledger_lock_acquire "$cleanup_out" || return 1
    claim_owner=""
    read -r claim_pid claim_owner claim_started < "$claim" 2>/dev/null || true
    if [ "$claim_owner" != "$claim_token" ]; then
        worker_ledger_lock_release "$cleanup_out" || true
        return 1
    fi
    if [ "$rc" != "0" ]; then
        rm -f "$claim" || rc=1
        worker_ledger_lock_release "$cleanup_out" || rc=1
        return "$rc"
    fi

    # Cancellation belongs to the autoscaler/controller. A cancellation can arrive after a child
    # provisioner's last check; preserving it keeps that intentional scale-down from becoming a
    # retryable provisioning failure.
    if [ "$rc" = "0" ] && ! rm -f \
        "$cleanup_out/worker-$cleanup_wid.pending" \
        "$cleanup_out/worker-$cleanup_wid.ready"; then
        rc=1
    fi

    # Keep readiness and ownership under the same short ledger lock so the two files cannot
    # disagree after successful provider cleanup.
    ready_tmp="$cleanup_out/worker-ready.ids.tmp.$cleanup_wid.$$"
    if [ "$rc" = "0" ] && [ -f "$cleanup_out/worker-ready.ids" ]; then
        if awk -v id="$cleanup_wid" '$0 != id' "$cleanup_out/worker-ready.ids" > "$ready_tmp" \
            && mv "$ready_tmp" "$cleanup_out/worker-ready.ids"; then
            :
        else
            rm -f "$ready_tmp"
            rc=1
        fi
    fi

    # Drop the durable teardown handle last. Distinguish grep's normal no-output status (1) from
    # read/I/O errors so a damaged ledger is never replaced with an empty partial file.
    tracking_tmp="$cleanup_out/worker-clones.ids.tmp.$cleanup_wid.$$"
    if [ "$rc" = "0" ]; then
        if grep -Fxv "$cleanup_wid" "$cleanup_out/worker-clones.ids" > "$tracking_tmp"; then
            grep_status=0
        else
            grep_status=$?
        fi
        if [ "$grep_status" -le 1 ]; then
            mv "$tracking_tmp" "$cleanup_out/worker-clones.ids" || rc=1
        else
            rm -f "$tracking_tmp"
            rc=1
        fi
    fi

    # This process still owns the claim even when a local finalize write failed. Release that
    # claim so the durable ledger entry can be retried immediately instead of waiting for expiry.
    rm -f "$claim" || rc=1
    worker_ledger_lock_release "$cleanup_out" || rc=1
    return "$rc"
}

# Provisioners publish only unique per-worker outcomes. Readiness reconciliation and cleanup share
# the worker-ledger lock, eliminating append-vs-rewrite loss and keeping desired-capacity state
# authoritative over stale child outcomes.
reconcile_worker_ready_outcomes() {  # <bench-output-dir>
    local out="$1" marker name wid rc=0
    worker_ledger_lock_acquire "$out" || return $?
    for marker in "$out"/worker-*.ready; do
        [ -e "$marker" ] || continue
        name="${marker##*/}"
        wid="${name#worker-}"; wid="${wid%.ready}"
        if worker_is_tracked "$out" "$wid" \
            && [ ! -e "$out/worker-$wid.cancelled" ]; then
            if ! grep -Fxq "$wid" "$out/worker-ready.ids" 2>/dev/null \
                && ! printf '%s\n' "$wid" >> "$out/worker-ready.ids"; then
                rc=1
                break
            fi
        else
            rm -f "$marker" || { rc=1; break; }
        fi
    done
    worker_ledger_lock_release "$out" || rc=1
    return "$rc"
}

reconcile_worker_failure_outcomes() {  # <bench> <bench-output-dir>
    local bench="$1" out="$2" marker name wid reason
    for marker in "$out"/worker-*.failed; do
        [ -e "$marker" ] || continue
        name="${marker##*/}"
        wid="${name#worker-}"; wid="${wid%.failed}"
        if worker_is_tracked "$out" "$wid" \
            && [ ! -e "$out/worker-$wid.cancelled" ]; then
            reason="$(head -1 "$marker" 2>/dev/null)"
            printf '%s\n' "${reason:-worker $wid provisioning failed}" > "$out/autoscaler.failed"
            echo "  ❌ [$bench] mandatory autoscaler: ${reason:-worker $wid provisioning failed}" >&2
            return 1
        fi
        rm -f "$marker"
    done
    return 0
}

provision_worker() {  # provision_worker <bench> <workspace> <primary_id> <primary_ip> <sim01> <out>
    local bench="$1" ws="$2" primary_id="$3" pip="$4" sim="$5" out="$6"
    local wid stage_attempts worker_ready_timeout worker_capacity_token worker_github_token_b64 ready_file stage_log failure_reason
    worker_capacity_token="$FLEET_OWNER_TOKEN-worker-$(python3 -c 'import uuid; print(uuid.uuid4().hex)')"
    if ! reserve_worker_machine_slot "$worker_capacity_token"; then
        printf '%s\n' "Machine-count capacity unavailable for worker clone" > "$out/autoscaler.failed"
        echo "  ❌ [$bench] mandatory autoscaler: Machine-count capacity unavailable" >&2
        return 1
    fi
    if ! wid="$(clone_machine_target "$out/worker-clones.ids" "$primary_id" \
        "$FLEET_WORKER_VM_SIZE" "$FLEET_WORKER_VM_MEMORY")"; then
        # Keep the reservation until controller teardown: an ambiguous clone
        # failure can still become provider-visible after the lookup deadline.
        printf '%s\n' "could not allocate worker clone" > "$out/autoscaler.failed"
        echo "  ❌ [$bench] mandatory autoscaler: worker clone did not appear" >&2
        return 1
    fi
    if ! capacity_release_reservation "$worker_capacity_token"; then
        printf '%s\n' "could not release worker capacity reservation" > "$out/autoscaler.failed"
        echo "  ❌ [$bench] mandatory autoscaler: worker capacity handoff was not durable" >&2
        return 1
    fi
    echo "  ➕ [$bench] worker $wid created"
    ready_file="/data/cloudbench-worker-$wid.ready"
    if ! worker_github_token_b64="$(controller_github_token_b64)"; then
        failure_reason="No current controller GitHub token available for worker ref fetch"
        if ! cleanup_failed_worker "$out" "$wid"; then
            failure_reason="$failure_reason; worker $wid cleanup failed and remains tracked for controller teardown"
        fi
        printf '%s\n' "$failure_reason" > "$out/autoscaler.failed"
        echo "  ❌ [$bench] mandatory autoscaler: $failure_reason" >&2
        return 1
    fi
    stage_attempts="$WORKER_STAGE_ATTEMPTS"
    worker_ready_timeout="$WORKER_READY_TIMEOUT"
    case "$stage_attempts" in
        ''|*[!0-9]*)
            failure_reason="invalid worker stage/readiness timeout configuration"
            if ! cleanup_failed_worker "$out" "$wid"; then
                failure_reason="$failure_reason; worker $wid cleanup failed and remains tracked for controller teardown"
            fi
            printf '%s\n' "$failure_reason" > "$out/autoscaler.failed"
            return 1
            ;;
    esac
    case "$worker_ready_timeout" in
        ''|*[!0-9]*)
            failure_reason="invalid worker stage/readiness timeout configuration"
            if ! cleanup_failed_worker "$out" "$wid"; then
                failure_reason="$failure_reason; worker $wid cleanup failed and remains tracked for controller teardown"
            fi
            printf '%s\n' "$failure_reason" > "$out/autoscaler.failed"
            return 1
            ;;
    esac
    if [ "$stage_attempts" -lt 1 ] || [ "$worker_ready_timeout" -lt 1 ]; then
        failure_reason="worker stage attempts and readiness timeout must be positive"
        if ! cleanup_failed_worker "$out" "$wid"; then
            failure_reason="$failure_reason; worker $wid cleanup failed and remains tracked for controller teardown"
        fi
        printf '%s\n' "$failure_reason" > "$out/autoscaler.failed"
        return 1
    fi
    # Allocation is ownership, not capacity. Keep it in worker-clones.ids for
    # teardown, but count it as operational only after the worker health endpoint
    # proves that Temporal worker.run() reached its queue-polling boundary.
    : > "$out/worker-$wid.pending"
    rm -f "$out/worker-$wid.cancelled"
    stage_log="$out/worker-$wid.stage.log"
    : > "$stage_log" 2>/dev/null || true
    local wrapper worker_env; wrapper="$(mktemp)"; worker_env="$(mktemp)"
    chmod 600 "$worker_env" 2>/dev/null || true
    printf 'CLOUDBENCH_GITHUB_TOKEN_B64=%q\n' "$worker_github_token_b64" > "$worker_env"
    {
        echo "set -e"
        echo 'if [ -f /tmp/rbw.env ]; then'
        echo '    set -a'
        echo '    . /tmp/rbw.env'
        echo '    set +a'
        echo '    rm -f /tmp/rbw.env'
        echo 'fi'
        echo "export REF=$(printf '%q' "$BENCH_REF")"
        echo "export CLOUDBENCH_FETCH_REF_SCRIPT=/data/cloudbench-fetch-ref.sh"
        echo "export CLOUDBENCH_ENV_HELPER=/data/cloudbench-env.sh"
        echo "export WORKSPACE_NAME=$(printf '%q' "$ws")"
        echo "export PRIMARY_HOST=$(printf '%q' "$pip")"
        echo "export BACKEND_PORT=$(printf '%q' "$BOX_BACKEND_PORT")"
        echo "export WMH_PORT=$(printf '%q' "$BOX_WMH_PORT")"
        echo "export HEALTH_PORT=$(printf '%q' "$FLEET_WORKER_HEALTH_PORT")"
        echo "export BENCH_SIMULATE=$(printf '%q' "$sim")"
        echo "export WORKER_READY_FILE=$(printf '%q' "$ready_file")"
        echo "rm -f $(printf '%q' "$ready_file")"
        [ -n "$FLEET_PATCH_FILE" ] && echo "export LOCAL_PATCH_FILE=/tmp/cloudbench-local.patch" || echo "unset LOCAL_PATCH_FILE"
        [ -n "$FLEET_PATCH_FILE" ] && echo "export LOCAL_PATCH_SHA256=$FLEET_PATCH_SHA256" || echo "unset LOCAL_PATCH_SHA256"
        echo "exec bash /data/cloudbench-worker.sh"
    } > "$wrapper"
    (
      # This is a child provisioner, not the autoscaler owner. Bash can carry
      # the caller's EXIT trap into an async function subshell; clear it so a
      # worker exit never runs controller-owned proxy/lease cleanup with locals
      # whose dynamic scope has already ended.
      trap - EXIT HUP INT TERM
      worker_provision_cancelled() {
          [ -e "$out/worker-$wid.cancelled" ]
      }
      finish_cancelled_worker_provision() {
          rm -f "$wrapper" "$worker_env" "$out/worker-$wid.pending" 2>/dev/null || true
          exit 0
      }
      publish_worker_failure() {
          local reason="$1" failure_tmp="$out/worker-$wid.failed.tmp.$$"
          printf '%s\n' "$reason" > "$failure_tmp" \
              && mv "$failure_tmp" "$out/worker-$wid.failed"
      }
      discard_replaceable_worker() {
          local reason="$1"
          rm -f "$wrapper" "$worker_env" 2>/dev/null || true
          if cleanup_failed_worker "$out" "$wid"; then
              echo "  ⚠️  [$bench] $reason; removed worker $wid so capacity can be retried" >&2
              exit 1
          fi
          publish_worker_failure "$reason; worker $wid could not be reaped"
          exit 1
      }
      publish_worker_ready() {
          local ready_tmp="$out/worker-$wid.ready.tmp.$$"
          : > "$ready_tmp" && mv "$ready_tmp" "$out/worker-$wid.ready"
      }
      log_worker_stage() {
          printf '[%s] %s\n' \
              "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || printf unknown)" \
              "$*" >> "$stage_log" 2>/dev/null || true
      }
      run_worker_stage_cmd() {
          local label="$1" rc
          shift
          log_worker_stage "attempt ${attempt:-?}/$stage_attempts: $label"
          if "$@" >> "$stage_log" 2>&1; then
              log_worker_stage "attempt ${attempt:-?}/$stage_attempts: $label succeeded"
              return 0
          else
              rc=$?
          fi
          log_worker_stage "attempt ${attempt:-?}/$stage_attempts: $label failed rc=$rc"
          return "$rc"
      }
      launched=0
      worker_neutralized=0
      for attempt in $(seq 1 "$stage_attempts"); do
        worker_provision_cancelled && finish_cancelled_worker_provision
        if ! machine_storage_ready "$wid"; then
            if machine_storage_failed "$wid"; then
                log_worker_stage "attempt $attempt/$stage_attempts: storage failed before staging"
                discard_replaceable_worker \
                    "worker $wid storage failed before staging; see worker-$wid.stage.log"
            fi
            log_worker_stage "attempt $attempt/$stage_attempts: storage not ready"
            sleep "${CLOUDBENCH_WORKER_STAGE_RETRY_SECONDS:-3}"
            continue
        fi
        # A worker is cloned from this benchmark's primary, whose config is
        # already set to auto-run cloudbench-boot.sh. Neutralize that copied
        # command before its first start or staging could race a duplicate
        # primary benchmark driver on the same task queue/run token.
        if [ "$worker_neutralized" != "1" ]; then
            if ! run_worker_stage_cmd "neutralize cloned boot command" \
                fly_with_timeout 30 machine update "$wid" -a "$APP" \
                --env CLOUDBENCH_BOOT=0 --command "sleep infinity" \
                --skip-health-checks --skip-start --yes; then
                sleep "${CLOUDBENCH_WORKER_STAGE_RETRY_SECONDS:-3}"
                continue
            fi
            worker_neutralized=1
        fi
        run_worker_stage_cmd "start neutralized worker" \
            fly_with_timeout 20 machine start "$wid" -a "$APP" || true
        if ! run_worker_stage_cmd "clear stale worker stage files" \
            fly_with_timeout 20 ssh console -a "$APP" --machine "$wid" \
            -C "rm -f /data/cloudbench-worker.sh /data/cloudbench-fetch-ref.sh /data/cloudbench-env.sh /tmp/rbw.env /tmp/rbw.sh /tmp/cloudbench-local.patch"; then
            sleep "${CLOUDBENCH_WORKER_STAGE_RETRY_SECONDS:-3}"
            continue
        fi
          if run_worker_stage_cmd "upload cloudbench-worker.sh" \
                fly_with_timeout 20 ssh sftp put -a "$APP" --machine "$wid" -q -m 0755 "$CLOUDBENCH_SCRIPT_SNAPSHOT/cloudbench-worker.sh" /data/cloudbench-worker.sh \
             && run_worker_stage_cmd "upload cloudbench-fetch-ref.sh" \
                fly_with_timeout 20 ssh sftp put -a "$APP" --machine "$wid" -q -m 0755 "$CLOUDBENCH_SCRIPT_SNAPSHOT/cloudbench-fetch-ref.sh" /data/cloudbench-fetch-ref.sh \
             && run_worker_stage_cmd "upload cloudbench-env.sh" \
                fly_with_timeout 20 ssh sftp put -a "$APP" --machine "$wid" -q -m 0755 "$CLOUDBENCH_SCRIPT_SNAPSHOT/cloudbench-env.sh" /data/cloudbench-env.sh \
             && run_worker_stage_cmd "upload worker environment" \
                fly_with_timeout 20 ssh sftp put -a "$APP" --machine "$wid" -q -m 0600 "$worker_env" /tmp/rbw.env \
             && run_worker_stage_cmd "upload worker wrapper" \
                fly_with_timeout 20 ssh sftp put -a "$APP" --machine "$wid" -q -m 0755 "$wrapper" /tmp/rbw.sh; then
              if [ -n "$FLEET_PATCH_FILE" ]; then
                  if ! run_worker_stage_cmd "upload local patch" \
                      fly_with_timeout 20 ssh sftp put -a "$APP" --machine "$wid" -q -m 0644 "$FLEET_PATCH_FILE" /tmp/cloudbench-local.patch; then
                      worker_provision_cancelled && finish_cancelled_worker_provision
                      sleep "${CLOUDBENCH_WORKER_STAGE_RETRY_SECONDS:-3}"
                      continue
                  fi
              fi
              if run_worker_stage_cmd "launch worker wrapper" \
                  fly_with_timeout 20 ssh console -a "$APP" --machine "$wid" \
                  -C "bash -c \"begin=\$(date +%s); : > /data/worker.log; printf '%s\\n' \\\"\$begin\\\" > /data/worker.started-at; setsid bash /tmp/rbw.sh >> /data/worker.log 2>&1 < /dev/null &\""; then
                  launched=1
                  break
              fi
          fi
          worker_provision_cancelled && finish_cancelled_worker_provision
          sleep 3
      done
      rm -f "$wrapper" "$worker_env" 2>/dev/null || true
      if [ "$launched" != "1" ]; then
          worker_provision_cancelled && finish_cancelled_worker_provision
          discard_replaceable_worker \
              "worker $wid could not be staged and launched; see worker-$wid.stage.log"
      fi

      ready_deadline=$((SECONDS + worker_ready_timeout))
      while [ "$SECONDS" -lt "$ready_deadline" ]; do
          worker_provision_cancelled && finish_cancelled_worker_provision
          if worker_operational "$wid"; then
              publish_worker_ready
              worker_provision_cancelled && finish_cancelled_worker_provision
              rm -f "$out/worker-$wid.pending"
              echo "  ✅ [$bench] worker $wid joined queue navi-agent-tasks-$ws"
              exit 0
          fi
          sleep 5
      done
      worker_provision_cancelled && finish_cancelled_worker_provision
      log_worker_stage "worker did not reach queue readiness within ${worker_ready_timeout}s"
      discard_replaceable_worker \
          "worker $wid did not reach queue readiness within ${worker_ready_timeout}s; see worker-$wid.stage.log"
    ) &
    return 0
}

bench_autoscaler() {  # bench_autoscaler <bench> <primary_cid> <workspace> <sim01> <out> <local-port-base>
    local bench="$1" cid="$2" ws="$3" sim="$4" out="$5" port_base="$6"
    local pip="" metrics_proxy_pid="" metrics_port="" metrics_url=""
    local metrics_started_at scrape_failures=0 metrics_lease_owner_pid metrics_lease_token
    local ready_reconcile_rc=0
    local scale_down_target="" scale_down_since="" scale_down_now=""
    # Bash 3.2 preserves $$ from the controller in async function subshells.
    # Controller ownership is intentional: per-autoscaler EXIT releases the
    # exact token, while controller cleanup sweeps the run prefix after SIGKILL.
    metrics_lease_owner_pid="$$"
    metrics_lease_token="$RUN_ID-$bench-$RANDOM"
    : > "$out/worker-clones.ids"
    : > "$out/worker-ready.ids"
    rm -f "$out/autoscaler.ready" "$out/autoscaler.failed" \
        "$out/autoscaler.completed-after-child"
    fail_autoscaler() {  # fail_autoscaler <reason>
        local reason="$1"
        if [ ! -s "$out/autoscaler.failed" ]; then
            if ! printf '%s\n' "$reason" > "$out/autoscaler.failed"; then
                echo "  ❌ [$bench] mandatory autoscaler: could not persist failure reason: $reason" >&2
            fi
        fi
        echo "  ❌ [$bench] mandatory autoscaler: $reason" >&2
        return 1
    }
    complete_autoscaler_after_child() {
        local completed_tmp="$out/autoscaler.completed-after-child.tmp.$$"
        local desired_workers tracked_workers ready_workers terminal_deadline ready_reconcile_rc
        [ -e "$out/benchmark-child.finished" ] || return 1
        # Child completion stops new metrics decisions; it does not revoke
        # capacity already committed by a prior desired-count observation. Keep
        # provisioners alive and reconcile their durable outcomes until the same
        # invariant used by final acceptance is stable.
        terminal_deadline=$((SECONDS + AUTOSCALER_FINALIZATION_WAIT_SECONDS))
        while :; do
            ready_reconcile_rc=0
            # Finalization owns the retry deadline. Use one ledger-lock attempt
            # per poll so a nested ten-second acquisition window cannot overrun
            # the remaining terminal budget.
            WORKER_LEDGER_LOCK_ATTEMPTS=1 reconcile_worker_ready_outcomes "$out" \
                || ready_reconcile_rc=$?
            if [ "$ready_reconcile_rc" -ne 0 ]; then
                if [ "$ready_reconcile_rc" -ne 75 ]; then
                    fail_autoscaler "could not reconcile worker readiness outcomes"
                    return 1
                fi
                if [ "$SECONDS" -ge "$terminal_deadline" ]; then
                    fail_autoscaler "could not reconcile worker readiness outcomes"
                    return 1
                fi
                sleep 0.2
                continue
            fi
            if ! reconcile_worker_failure_outcomes "$bench" "$out"; then
                [ -s "$out/autoscaler.failed" ] && return 1
                fail_autoscaler "could not reconcile worker failure outcomes"
                return 1
            fi
            [ ! -s "$out/autoscaler.failed" ] || return 1
            desired_workers="$(cat "$out/desired-worker-count" 2>/dev/null || true)"
            if ! printf '%s' "$desired_workers" | grep -Eq '^[0-9]+$'; then
                printf '%s\n' "autoscaler never observed valid desired capacity" \
                    > "$out/autoscaler.failed"
                echo "  ❌ [$bench] mandatory autoscaler: no valid desired capacity before child completion" >&2
                return 1
            fi
            tracked_workers="$(_pool_ids "$out")"
            ready_workers="$(_ready_pool_ids "$out")"
            if [ "$ready_workers" -ge "$desired_workers" ] \
                && [ "$tracked_workers" = "$ready_workers" ] \
                && ! find "$out" -maxdepth 1 -name 'worker-*.pending' \
                    -print -quit 2>/dev/null | grep -q .; then
                break
            fi
            if [ "$SECONDS" -ge "$terminal_deadline" ]; then
                if [ "$ready_workers" -lt "$desired_workers" ]; then
                    printf '%s\n' \
                        "worker capacity below desired: $ready_workers/$desired_workers workers queue-ready" \
                        > "$out/autoscaler.failed"
                    echo "  ❌ [$bench] mandatory autoscaler: worker capacity below desired: $ready_workers/$desired_workers workers queue-ready" >&2
                elif [ "$tracked_workers" != "$ready_workers" ] \
                    || find "$out" -maxdepth 1 -name 'worker-*.pending' \
                        -print -quit 2>/dev/null | grep -q .; then
                    printf '%s\n' \
                        "worker capacity incomplete: $ready_workers/$tracked_workers workers queue-ready" \
                        > "$out/autoscaler.failed"
                    echo "  ❌ [$bench] mandatory autoscaler: worker capacity incomplete: $ready_workers/$tracked_workers workers queue-ready" >&2
                else
                    printf '%s\n' \
                        "autoscaler did not settle committed capacity after child completion" \
                        > "$out/autoscaler.failed"
                    echo "  ❌ [$bench] mandatory autoscaler: committed capacity did not settle after child completion" >&2
                fi
                return 1
            fi
            sleep 0.2
        done
        if ! cat "$out/benchmark-child.finished" > "$completed_tmp" \
            || ! mv "$completed_tmp" "$out/autoscaler.completed-after-child"; then
            rm -f "$completed_tmp"
            printf '%s\n' "could not persist causal child-completion proof" > "$out/autoscaler.failed"
            return 1
        fi
        return 0
    }
    cleanup_autoscaler_jobs() {
        local job_pid
        local -a live_jobs
        live_jobs=()
        while read -r job_pid; do
            if [ -n "$job_pid" ] && [ "$job_pid" != "${metrics_proxy_pid:-}" ]; then
                live_jobs+=("$job_pid")
            fi
        done < <(jobs -pr)
        cloudbench_terminate_and_wait 30 "${live_jobs[@]:-}"
        cloudbench_terminate_and_wait 5 "${metrics_proxy_pid:-}"
        if [ -n "${metrics_lease_owner_pid:-}" ] && [ -n "${metrics_lease_token:-}" ]; then
            release_autoscaler_metrics_owner \
                "$metrics_lease_owner_pid" "$metrics_lease_token" || true
        fi
    }
    trap cleanup_autoscaler_jobs EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    # Boot-launch intentionally configures the entire fleet while every primary
    # is stopped, then releases all starts together. A shared inventory generation
    # can still say `started` after the config mutation has committed `stopped`,
    # so it is not an ordering proof. Wait for run-bench-cloud to publish the exact
    # post-config start acceptance before spending the finite proxy attach budget.
    if [ "${CLOUDBENCH_BOOT_LAUNCH:-1}" = "1" ]; then
        while [ ! -f "$BOOT_CONFIG_BARRIER/release" ]; do sleep 0.2; done
        primary_start_deadline=$((SECONDS + ${CLOUDBENCH_READY_TIMEOUT:-600}))
        while [ ! -f "$out/post-config-start.accepted" ]; do
            if [ "$SECONDS" -ge "$primary_start_deadline" ]; then
                printf '%s\n' "primary post-config start was not accepted before autoscaler attachment" > "$out/autoscaler.failed"
                echo "  ❌ [$bench] mandatory autoscaler: primary post-config start was not accepted" >&2
                return 1
            fi
            sleep 0.2
        done
        IFS= read -r accepted_primary < "$out/post-config-start.accepted" || accepted_primary=""
        if [ "$accepted_primary" != "$cid" ]; then
            printf '%s\n' "primary start acceptance marker did not match allocated machine" > "$out/autoscaler.failed"
            echo "  ❌ [$bench] mandatory autoscaler: primary start acceptance marker mismatched" >&2
            return 1
        fi
    fi
    # The keyed inventory already carries Fly's provider-authoritative 6PN
    # address. Resolve it before spending the finite attach budget and target it
    # directly: newly cloned Machines can be reachable before their derived
    # .internal names have propagated through Fly DNS.
    for _ in $(seq 1 60); do pip="$(_machine_priv_ip "$cid")"; [ -n "$pip" ] && break; sleep 5; done
    if [ -z "$pip" ]; then
        printf '%s\n' "primary machine has no private IP" > "$out/autoscaler.failed"
        echo "  ❌ [$bench] mandatory autoscaler: primary machine has no private IP" >&2
        return 1
    fi
    # One persistent WireGuard tunnel replaces one `flyctl ssh` metrics read per
    # task every poll interval. At daily width that removes 180 Machines-API SSH
    # sessions/minute and the rate-limit/launch interference they caused.
    : > "$out/autoscaler-metrics-proxy.log"
    start_metrics_proxy() {  # start_metrics_proxy [timeout-seconds]
        local timeout="${1:-${CLOUDBENCH_DATA_PROXY_READY_TIMEOUT:-180}}"
        metrics_started_at="$(date +%s)"
        while [ $(( $(date +%s) - metrics_started_at )) -lt "$timeout" ]; do
            # Token-wide release also recovers a claim helper interrupted after
            # atomic publication but before its port reached this shell variable.
            release_autoscaler_metrics_owner \
                "$metrics_lease_owner_pid" "$metrics_lease_token" \
                || { sleep 2; continue; }
            metrics_port=""
            claim_autoscaler_metrics_port metrics_port \
                "$metrics_lease_owner_pid" "$metrics_lease_token" \
                || { sleep 2; continue; }
            flyctl proxy "$metrics_port:$BOX_HEALTH_PORT" "$pip" \
                -a "$APP" --bind-addr 127.0.0.1 -q \
                >> "$out/autoscaler-metrics-proxy.log" 2>&1 &
            metrics_proxy_pid=$!
            # Force flyctl's lazy DNS resolution, then accept the tunnel only if
            # the process survives that first real data-plane connection.
            sleep 0.5
            curl --noproxy '*' -sS --max-time 2 -o /dev/null \
                "http://127.0.0.1:$metrics_port/metrics" 2>/dev/null || true
            sleep 0.5
            if fleet_job_running "$metrics_proxy_pid"; then
                metrics_url="http://127.0.0.1:$metrics_port"
                return 0
            fi
            wait "$metrics_proxy_pid" 2>/dev/null || true
            metrics_proxy_pid=""
            release_autoscaler_metrics_owner \
                "$metrics_lease_owner_pid" "$metrics_lease_token" || true
            metrics_port=""
            sleep 2
        done
        return 1
    }
    # Before the first desired-capacity observation the guest may legitimately
    # still be restoring its stack, and Fly can drop an otherwise valid proxy
    # while no process listens on /metrics yet. Retry in short, observable
    # windows under the child+inventory lifecycle instead of imposing an
    # unrelated 30/180-second transport deadline on a 2160-second bootstrap.
    until start_metrics_proxy 30; do
        if [ -e "$out/benchmark-child.finished" ]; then
            complete_autoscaler_after_child
            return $?
        fi
        if ! inventory_machine_exists "$cid"; then
            printf '%s\n' "primary disappeared from provider inventory before child completion" > "$out/autoscaler.failed"
            echo "  ❌ [$bench] mandatory autoscaler: primary inventory disappeared during proxy startup" >&2
            return 1
        fi
        echo "  ⚠️ [$bench] mandatory autoscaler: metrics proxy unavailable before first desired count; retrying" >&2
        sleep 2
    done
    echo "  🛰️ [$bench] autoscaler metrics via data plane :$metrics_port → fly:$BOX_HEALTH_PORT"
    # Wait for the box /metrics to answer (stack up) before scaling. Inventory
    # lookup failure is not normal termination: a stale/failed publisher must
    # fail closed unless this autoscaler has itself observed child completion.
    while :; do
        if [ -e "$out/benchmark-child.finished" ]; then
            complete_autoscaler_after_child
            return $?
        fi
        ready_reconcile_rc=0
        reconcile_worker_ready_outcomes "$out" || ready_reconcile_rc=$?
        if [ "$ready_reconcile_rc" -ne 0 ]; then
            # The child marker can land between the loop-head lifecycle check
            # and ledger acquisition. Hand a busy ledger to the bounded terminal
            # reconciler instead of misclassifying that race as durable failure.
            if [ "$ready_reconcile_rc" -eq 75 ] \
                && [ -e "$out/benchmark-child.finished" ]; then
                complete_autoscaler_after_child
                return $?
            fi
            fail_autoscaler "could not reconcile worker readiness outcomes"
            return 1
        fi
        if ! inventory_machine_exists "$cid"; then
            if [ -e "$out/benchmark-child.finished" ]; then
                complete_autoscaler_after_child
                return $?
            fi
            printf '%s\n' "primary disappeared from provider inventory before child completion" > "$out/autoscaler.failed"
            echo "  ❌ [$bench] mandatory autoscaler: primary inventory disappeared during the run" >&2
            return 1
        fi
        if [ -s "$out/autoscaler.failed" ]; then
            return 1
        fi
        if ! fleet_job_running "$metrics_proxy_pid"; then
            scale_down_target=""
            scale_down_since=""
            metrics_proxy_pid=""
            if [ -e "$out/autoscaler.ready" ]; then
                start_metrics_proxy 30 || {
                    if [ -e "$out/benchmark-child.finished" ]; then
                        complete_autoscaler_after_child
                        return $?
                    fi
                    printf '%s\n' "metrics proxy died and did not recover" > "$out/autoscaler.failed"
                    echo "  ❌ [$bench] mandatory autoscaler: metrics proxy died and did not recover" >&2
                    return 1
                }
            else
                if ! start_metrics_proxy 30; then
                    if [ -e "$out/benchmark-child.finished" ]; then
                        complete_autoscaler_after_child
                        return $?
                    fi
                    echo "  ⚠️ [$bench] mandatory autoscaler: metrics proxy unavailable before first desired count; retrying" >&2
                    continue
                fi
            fi
            echo "  🛰️ [$bench] autoscaler metrics proxy recovered on :$metrics_port"
        fi
        local desired want cur; desired="$(_box_desired "$metrics_url")"
        if [ -z "$desired" ]; then
            # A missing observation cannot contribute to continuous low-target
            # confirmation. Require a fresh complete interval after recovery.
            scale_down_target=""
            scale_down_since=""
            # The child marker can land between the loop-head check and this
            # scrape. Recheck before advancing the terminal failure counter.
            if [ -e "$out/benchmark-child.finished" ]; then
                complete_autoscaler_after_child
                return $?
            fi
            if [ -e "$out/autoscaler.ready" ]; then
                scrape_failures=$((scrape_failures + 1))
                if [ "$scrape_failures" -ge 6 ]; then
                    printf '%s\n' "metrics returned no valid desired_machine_count for 6 consecutive polls" > "$out/autoscaler.failed"
                    echo "  ❌ [$bench] mandatory autoscaler: metrics became unreadable for 6 consecutive polls" >&2
                    return 1
                fi
            fi
            sleep "$AUTOSCALE_POLL"
            continue
        fi
        scrape_failures=0
        want=$((desired - 1)); [ "$want" -lt 0 ] && want=0
        [ "$want" -gt $((AUTOSCALE_MAX - 1)) ] && want=$((AUTOSCALE_MAX - 1))
        # Publish outstanding demand before readiness or provider allocation.
        # Final acceptance therefore cannot see tracked=ready=0 and pass while
        # clone_machine_target is still retrying or hung for desired capacity.
        if ! printf '%s\n' "$want" > "$out/desired-worker-count.tmp" \
            || ! mv "$out/desired-worker-count.tmp" "$out/desired-worker-count"; then
            printf '%s\n' "could not persist desired worker capacity" > "$out/autoscaler.failed"
            echo "  ❌ [$bench] mandatory autoscaler: could not persist desired worker capacity" >&2
            return 1
        fi
        if [ ! -e "$out/autoscaler.ready" ]; then
            : > "$out/autoscaler.ready"
            echo "  ✅ [$bench] mandatory autoscaler observed desired_machine_count=$desired"
        fi
        cur="$(_pool_ids "$out")"
        if [ "$want" -gt "$cur" ]; then
            scale_down_target=""
            scale_down_since=""
            local n=$((want - cur))
            echo "  ⤴️  [$bench] scale up +$n (desired=$desired, pool=$cur)"
            for _ in $(seq 1 "$n"); do provision_worker "$bench" "$ws" "$cid" "$pip" "$sim" "$out"; done
        elif [ "$want" -lt "$cur" ]; then
            autoscaler_monotonic_seconds scale_down_now
            if [ "$scale_down_target" != "$want" ] \
                || [ -z "$scale_down_since" ] \
                || [ "$scale_down_now" -lt "$scale_down_since" ]; then
                scale_down_target="$want"
                scale_down_since="$scale_down_now"
                echo "  ⏳ [$bench] holding lower target=$desired for ${AUTOSCALE_SCALE_DOWN_CONFIRM_SECONDS}s confirmation"
            elif [ $((scale_down_now - scale_down_since)) \
                -ge "$AUTOSCALE_SCALE_DOWN_CONFIRM_SECONDS" ]; then
                if pool_has_pending_worker "$out"; then
                    echo "  ⏳ [$bench] retaining committed pending worker before scale-down"
                else
                    local n=$((cur - want))
                    echo "  ⤵️  [$bench] scale down -$n (desired=$desired, pool=$cur)"
                    for _ in $(seq 1 "$n"); do
                        local wid
                        if ! wid="$(cancel_worker_for_scale_down "$out" "$want")"; then
                            printf '%s\n' "could not select worker for scale-down" > "$out/autoscaler.failed"
                            echo "  ❌ [$bench] mandatory autoscaler: could not select worker for scale-down" >&2
                            return 1
                        fi
                        [ -n "$wid" ] || break
                        # Only drop the id from tracking once the destroy is
                        # CONFIRMED — an untracked-but-alive machine is a
                        # billed-forever zombie. On failure keep it listed and
                        # retry on the next autoscaler tick.
                        if ! cleanup_failed_worker "$out" "$wid"; then
                            printf '%s\n' "worker $wid could not be destroyed during scale-down" > "$out/autoscaler.failed"
                            echo "  ❌ [$bench] mandatory autoscaler: worker $wid could not be destroyed during scale-down" >&2
                            return 1
                        fi
                    done
                fi
            fi
        else
            scale_down_target=""
            scale_down_since=""
        fi
        ready_reconcile_rc=0
        reconcile_worker_ready_outcomes "$out" || ready_reconcile_rc=$?
        if [ "$ready_reconcile_rc" -ne 0 ]; then
            if [ "$ready_reconcile_rc" -eq 75 ] \
                && [ -e "$out/benchmark-child.finished" ]; then
                complete_autoscaler_after_child
                return $?
            fi
            fail_autoscaler "could not reconcile worker readiness outcomes"
            return 1
        fi
        reconcile_worker_failure_outcomes "$bench" "$out" \
            || fail_autoscaler "could not reconcile worker failure outcomes"
        # The fake-controller regression for terminal proof needs to hold the
        # exact state "capacity fully accepted, child not yet complete" without
        # relying on this loop's scheduler timing. This branch is unreachable
        # outside the explicit fake Fly environment used by the harness.
        if [ -n "${CLOUDBENCH_FAKE_DIR:-}" ] \
            && [ "${CLOUDBENCH_TEST_HOLD_AUTOSCALER_AFTER_READY:-0}" = "1" ]; then
            local test_ready_workers test_tracked_workers
            test_ready_workers="$(_ready_pool_ids "$out")"
            test_tracked_workers="$(_pool_ids "$out")"
            if [ "$test_ready_workers" -ge "$want" ] \
                && [ "$test_tracked_workers" = "$test_ready_workers" ] \
                && ! find "$out" -maxdepth 1 -name 'worker-*.pending' \
                    -print -quit 2>/dev/null | grep -q . \
                && ready_workers_operational "$out"; then
                # The boundary must survive the controller's whole final
                # acceptance pass, so the normal path holds here until teardown
                # signals this process. The release marker is the harness's
                # explicit escape hatch, and the deadline is only an anti-wedge
                # backstop far beyond any scenario's runtime — never the
                # synchronization this case depends on.
                : > "$out/autoscaler.test-held-after-ready"
                local test_hold_deadline=$((SECONDS + 600))
                while [ ! -e "$out/autoscaler.test-release-after-ready" ] \
                    && [ "$SECONDS" -lt "$test_hold_deadline" ]; do
                    sleep 0.2
                done
            fi
        fi
        sleep "$AUTOSCALE_POLL"
    done
}

# ── Epoch-0 substrate preflight (fail closed before capability provisioning) ─
# /descend fleets historically burned wall-clock on INFRA because capability
# benches launched against a broken substrate. Pin a recent infra-canary PASS
# stamp before cloning so every capability fleet — including single-bench
# outcome-proof reruns — proves bring-up → strict barrier → DONE with zero
# exclusions first. N=1 used to skip this gate and still died on INFRA.
fleet_infra_canary_preflight() {
    local stamp ttl age n rc
    if [ "${INFRA_PROBE:-0}" = "1" ]; then
        return 0
    fi
    if [ "${CLOUDBENCH_SKIP_INFRA_CANARY_PREFLIGHT:-0}" = "1" ]; then
        return 0
    fi
    if [ "${CLOUDBENCH_INFRA_CANARY_PREFLIGHT_ACTIVE:-0}" = "1" ]; then
        return 0
    fi
    if [ -n "${CLOUDBENCH_FAKE_DIR:-}" ]; then
        echo "🛡  infra canary preflight: skipped under CLOUDBENCH_FAKE_DIR"
        return 0
    fi
    if [ "${RECOVER_STALE_ONLY:-0}" = "1" ] || [ -n "${PROVISION_POOL:-}" ]; then
        return 0
    fi
    stamp="$ROOT_DIR/.context/fleet-infra-canary.last-pass"
    ttl="${FLEET_INFRA_CANARY_TTL_SECONDS:-3600}"
    case "$ttl" in
        ''|*[!0-9]*|0) ttl=3600 ;;
    esac
    if [ -f "$stamp" ]; then
        age=$(( $(date +%s) - $(stat -c %Y "$stamp" 2>/dev/null || echo 0) ))
        if [ "$age" -ge 0 ] && [ "$age" -lt "$ttl" ]; then
            echo "🛡  infra canary preflight: stamp fresh (${age}s < ${ttl}s) — $stamp"
            return 0
        fi
    fi
    n="${FLEET_INFRA_CANARY_PREFLIGHT_N:-2}"
    case "$n" in
        ''|*[!0-9]*|0) n=2 ;;
    esac
    echo "🛡  infra canary preflight: stamp missing/stale — running N=$n before capability fleet"
    mkdir -p "$ROOT_DIR/.context"
    # Distinct lock so preflight never contends with the capability controller.
    # PREFLIGHT_ACTIVE + SKIP prevent recursion when the canary re-enters fleet.
    if ! CLOUDBENCH_INFRA_CANARY_PREFLIGHT_ACTIVE=1 \
        CLOUDBENCH_SKIP_INFRA_CANARY_PREFLIGHT=1 \
        CLOUDBENCH_CONTROLLER_LOCK_NAME="cloudbench-controller-infra-canary-preflight.lock" \
        bash "$ROOT_DIR/scripts/run-fleet-infra-canary" "$n"; then
        rc=$?
        echo "❌ infra canary preflight FAILED (exit=$rc) — refusing capability fleet (INFRA)" >&2
        return "$rc"
    fi
    date -u +%Y-%m-%dT%H:%M:%SZ > "$stamp"
    echo "🛡  infra canary preflight PASS — stamped $stamp"
    return 0
}
fleet_infra_canary_preflight || exit $?

# ── Clone one machine per bench + launch its isolated run ────────────────────
mkdir -p "$FLEET_DIR"
: > "$CLAIMED_POOL_FILE"
start_machines_snapshot_loop || exit 1
echo ""
echo "═══ run-bench-fleet — ${#BENCHES[@]} bench(es), one isolated machine each ═══"
# ── Phase 1: provision every bench's isolated machine CONCURRENTLY ───────────
# Cloning 28 fresh volumes-from-snapshot one-at-a-time serialized provisioning
# into a 30-50min window — the window where every clone hang, volume race, and
# cross-workspace contention event landed and aborted the batch. Fan the
# claim/clone out in parallel: each attempt runs in its own subshell and writes
# its OWN per-bench ledger (primary.ids/.names — reaped by cleanup's globs), so
# there is no shared-ledger race. The whole fleet is now provisioned in ~one
# clone's wall-time (target: < 3 min) instead of the sum of 28.
echo ""
write_startup_card "provisioning ${#BENCHES[@]} isolated machines"
echo "⏳ provisioning ${#BENCHES[@]} isolated machine(s) concurrently (claim-or-clone) ..."
# Reuse the controller-wide provision PID registry so cleanup can terminate
# precisely these children if the controller is signalled mid-provision.
for bench in "${BENCHES[@]}"; do
    out="$FLEET_DIR/$bench"
    rm -rf "$out" 2>/dev/null || true; mkdir -p "$out"
    (
        bench_vm_size="$(primary_vm_size_for_bench "$bench")"
        bench_vm_memory="$(primary_vm_memory_for_bench "$bench")"
        pcid=""
        # Prefer a pre-provisioned pool machine (skips the ~300s volume fork);
        # fall back to cloning fresh (bounded + retried) if the pool is empty.
        #
        # Bundled-frontend tasks need a larger primary for the Vite production
        # build, so they cannot safely claim the default 4GB stopped pool.
        if bench_needs_bundled_frontend_primary "$bench"; then
            echo "  ↪️  [$bench] using bundled frontend primary shape ${bench_vm_size}/${bench_vm_memory}MB" >&2
        else
            pcid="$(claim_pool_machine)"
        fi
        if [ -n "$pcid" ]; then
            printf 'pool %s\n' "$pcid" > "$out/.cid"
        elif pcid="$(clone_machine_target "$out/primary.ids" "$WARM_ID" "$bench_vm_size" "$bench_vm_memory")"; then
            printf 'clone %s\n' "$pcid" > "$out/.cid"
        fi
    ) &
    PROVISION_PIDS+=("$!")
    # Stagger the clone starts so N benches don't hammer the Fly Machines API in
    # the same instant (the direct cause of `resource_exhausted: rate limit
    # exceeded` → clones that exhaust their retries and drop from the batch).
    # Still fully concurrent — every clone stays in flight together — the burst is
    # just spread across a few seconds instead of fired simultaneously.
    sleep "${CLOUDBENCH_CLONE_LAUNCH_STAGGER_SECONDS:-0.4}"
done
for pp in "${PROVISION_PIDS[@]}"; do wait "$pp" 2>/dev/null || true; done
# Provision children are fully reaped; retain no stale PIDs across the
# potentially multi-hour benchmark phase.
PROVISION_PIDS=()

# ── Phase 2: launch each provisioned bench's isolated run (fast; backgrounded) ─
BOOT_CONFIG_BARRIER="$FLEET_DIR/.boot-config-barrier"
rm -rf "$BOOT_CONFIG_BARRIER" 2>/dev/null || true
mkdir -p "$BOOT_CONFIG_BARRIER/ready"
i=0
for bench in "${BENCHES[@]}"; do
    # Default from the batch's preflighted catalog snapshot; --sim-on is an
    # explicit override. No mutable catalog read happens after provisioning.
    catalog_wmm="${CATALOG_MODES[$i]}"
    mode_label="REAL"; [ "$catalog_wmm" = "simulate" ] && mode_label="SIM"
    is_sim_on "$bench" && mode_label="SIM"
    mode_flag="--no-simulate"; [ "$mode_label" = "SIM" ] && mode_flag="--simulate"
    # DASH_BASE is reserved for the ONE aggregated batch dashboard; per-bench
    # viewers live above it (their /open-agent deep-links back the batch rows).
    port=$((DASH_BASE + (i + 1) * 20))
    out="$FLEET_DIR/$bench"
    src=""; cid=""
    if [ -f "$out/.cid" ]; then
        read -r src cid < "$out/.cid" || true
    fi

    echo ""
    if [ -z "$cid" ]; then
        echo "❌ [$bench] provisioning failed (no machine) — skipping"
        i=$((i + 1)); continue
    fi
    if [ "$src" = "pool" ]; then
        echo "▶️  [$bench] claimed POOL machine $cid (no fork, mode=$mode_label, dash=$port)"
    else
        echo "▶️  [$bench] cloned isolated machine $cid (mode=$mode_label, dash=$port)"
    fi
    case " ${CHILD_MACHINE[*]:-} " in
        *" $cid "*) echo "❌ isolation violation: machine $cid was allocated twice" >&2; exit 1 ;;
    esac
    # run-bench-cloud owns the clone lifecycle: it waits for snapshot storage to
    # become mountable, then requests the created → started transition.
    echo "   ✅ machine=$cid allocated → launching run-bench-cloud (isolated) ..."

    # Deterministic per-bench workspace → deterministic Temporal queue, so the
    # autoscaler knows which queue its worker pool must poll.
    if ! local_ws="$(cloudbench_fleet_workspace_name "$bench" "$$" "$i")"; then
        echo "❌ [$bench] could not derive an isolated Temporal workspace" >&2
        exit 1
    fi
    # The guest intentionally tears down /metrics when its benchmark driver
    # finishes. Publish that child lifecycle atomically so the autoscaler can
    # stop cleanly instead of turning expected post-run teardown into six
    # consecutive scrape failures. The supervisor also forwards controller
    # teardown and awaits the runner, preventing local PID-1 orphans.
    CLOUDBENCH_WORKSPACE_NAME="$local_ws" \
    CLOUDBENCH_ENV_VERIFIED=1 \
    CLOUDBENCH_STORAGE_READY="$([ "$src" = "pool" ] && printf 1 || printf 0)" \
    CLOUDBENCH_MACHINE_RECORD="$INVENTORY_INDEX/current/machines/$cid" \
    CLOUDBENCH_INVENTORY_OWNER_PID="$SNAPSHOT_LOOP_PID" \
    CLOUDBENCH_INVENTORY_PUBLISHER_TOKEN="$SNAPSHOT_LOOP_TOKEN" \
    CLOUDBENCH_INVENTORY_HEALTH="$INVENTORY_INDEX/current/health" \
    CLOUDBENCH_START_BARRIER="$([ "$SYNCHRONIZED_START" = "1" ] && printf '%s' "$RUN_ID")" \
    CLOUDBENCH_BARRIER_TOKEN="$BARRIER_RELEASE_TOKEN" \
    CLOUDBENCH_START_BARRIER_WAIT_SECONDS="$START_BARRIER_WAIT_SECONDS" \
    CLOUDBENCH_FIRST_RUN_STACK_WAIT_SECONDS="$FIRST_RUN_STACK_WAIT_SECONDS" \
    CLOUDBENCH_BOOT_LAUNCH="${CLOUDBENCH_BOOT_LAUNCH:-1}" \
    CLOUDBENCH_BOOT_CONFIG_BARRIER="$BOOT_CONFIG_BARRIER" \
    CLOUDBENCH_BOOT_UPDATE_CAPACITY_WAIT_SECONDS="$BOOT_UPDATE_CAPACITY_WAIT_SECONDS" \
    CLOUDBENCH_BOOT_CONFIG_BARRIER_WAIT_SECONDS="$BOOT_CONFIG_BARRIER_WAIT_SECONDS" \
    CLOUDBENCH_LOCAL_PATCH_SOURCE="$FLEET_PATCH_FILE" \
    CLOUDBENCH_LOCAL_PATCH_SHA256="$FLEET_PATCH_SHA256" \
    CLOUDBENCH_INFRA_PROBE="${INFRA_PROBE:-0}" \
    CLOUDBENCH_SKIP_AUTOSCALER="${SKIP_AUTOSCALER:-0}" \
    CLOUDBENCH_REQUIRE_EXECUTION_PROVENANCE=1 \
    CLOUDBENCH_EXECUTION_PROVENANCE_FILE="$EXECUTION_PROVENANCE_FILE" \
    NO_OPEN=1 \
        run_fleet_child_supervised "$out/benchmark-child.finished" \
            bash "$RUN_BENCH_CLOUD_BIN" "$bench" \
            --machine "$cid" \
            --out-dir "$out" \
            --dash-port "$port" \
            --no-lock \
            --no-open \
            "$mode_flag" \
            --ref "$BENCH_REF" \
            --timeout "$CHILD_RUN_TIMEOUT" \
        > "$out/fleet-child.log" 2>&1 &
    CHILD_PIDS+=("$!")
    CHILD_OUT+=("$out")
    CHILD_BENCH+=("$bench")
    CHILD_MODE+=("$mode_label")
    CHILD_PORT+=("$port")
    CHILD_MACHINE+=("$cid")
    # Boot-launch is one bounded update/start pair and has exponential retry; it
    # no longer performs the old seven-SSH launch sequence. Feed pooled Machines
    # into that parallel bring-up at four launches/second, so all 30 are submitted
    # in ~7.5s without an instantaneous control-plane burst. Preserve the slower
    # legacy-path throttle for explicit non-boot callers.
    if [ "${CLOUDBENCH_BOOT_LAUNCH:-1}" = "1" ]; then
        sleep "${CLOUDBENCH_LAUNCH_STAGGER_SECONDS:-0.25}"
    else
        sleep "${CLOUDBENCH_LAUNCH_STAGGER_SECONDS:-3.5}"
    fi

    local_sim=0; [ "$mode_label" = "SIM" ] && local_sim=1
    # Infra probes and DEMO $0 concurrency probes finish (and tear down
    # /metrics) within seconds of barrier release / soft-complete. Mandatory
    # per-bench autoscalers then race expected post-DONE metrics death into
    # "6 consecutive scrape failures" CHILDFAIL — observed at width=20 with a
    # green 20/20 barrier (13/20 PASS, 7 CHILDFAIL), and again on DEMO fleets
    # when a late scale-up leaves worker-ready empty after guest shutdown.
    # Substrate canaries and DEMO concurrency e2e only need clone → barrier →
    # DONE/pass; skip autoscalers for both.
    if [ "${INFRA_PROBE:-0}" = "1" ] || [ "${SKIP_AUTOSCALER:-0}" = "1" ]; then
        if [ "${INFRA_PROBE:-0}" = "1" ]; then
            echo "   ⚖️  [$bench] per-bench autoscaler SKIPPED (infra-probe; no worker scaling)"
        else
            echo "   ⚖️  [$bench] per-bench autoscaler SKIPPED (--skip-autoscaler; DEMO concurrency)"
        fi
        : > "$out/autoscaler.ready"
        : > "$out/autoscaler.completed-after-child"
        printf '0\n' > "$out/desired-worker-count"
    else
        echo "   ⚖️  [$bench] per-bench autoscaler ON (mandatory prod params, max=$AUTOSCALE_MAX, queue=navi-agent-tasks-$local_ws)"
        rm -f "$out/autoscaler.pid" "$out/autoscaler.acceptance-failed"
        ( bench_autoscaler "$bench" "$cid" "$local_ws" "$local_sim" "$out" "$port" ) >> "$out/autoscaler.log" 2>&1 &
        autoscaler_pid="$!"
        AUTOSCALER_PIDS+=("$autoscaler_pid")
        autoscaler_pid_tmp="$out/autoscaler.pid.tmp.$$"
        autoscaler_started=""
        for _ in $(seq 1 50); do
            autoscaler_started="$(fleet_pid_start_time "$autoscaler_pid" || true)"
            [ -z "$autoscaler_started" ] || break
            sleep 0.01
        done
        if [ -n "$autoscaler_started" ] \
            && printf '%s|%s\n' "$autoscaler_pid" "$autoscaler_started" > "$autoscaler_pid_tmp"; then
            mv "$autoscaler_pid_tmp" "$out/autoscaler.pid" 2>/dev/null || rm -f "$autoscaler_pid_tmp"
        else
            rm -f "$autoscaler_pid_tmp"
        fi
    fi
    i=$((i + 1))
done

[ "${#CHILD_PIDS[@]}" -ge 1 ] || { echo "❌ no benches launched (all clones failed)." >&2; exit 1; }

wait_for_mandatory_autoscaler_startup() {
    local deadline=$((SECONDS + AUTOSCALER_STARTUP_WAIT_SECONDS)) ready_count j reason
    local -a indices=("$@")
    if [ "${#indices[@]}" -eq 0 ]; then
        indices=("${!AUTOSCALER_PIDS[@]}")
    fi
    while :; do
        ready_count=0
        for j in "${indices[@]}"; do
            if [ -s "${CHILD_OUT[$j]}/autoscaler.failed" ]; then
                reason="$(head -1 "${CHILD_OUT[$j]}/autoscaler.failed" 2>/dev/null)"
                echo "❌ [${CHILD_BENCH[$j]}] mandatory autoscaler failed to start: ${reason:-unknown error}" >&2
                return 1
            fi
            if [ -e "${CHILD_OUT[$j]}/autoscaler.ready" ]; then
                ready_count=$((ready_count + 1))
            elif ! fleet_job_running "${AUTOSCALER_PIDS[$j]}"; then
                echo "❌ [${CHILD_BENCH[$j]}] mandatory autoscaler failed to start: process exited without readiness" >&2
                return 1
            fi
        done
        [ "$ready_count" -eq "${#indices[@]}" ] && return 0
        if [ "$SECONDS" -ge "$deadline" ]; then
            echo "❌ mandatory autoscaler startup timed out: $ready_count/${#indices[@]} ready" >&2
            return 1
        fi
        sleep 1
    done
}

# Configure the entire stopped fleet before starting any guest. Fly can reserve
# replacement CPU while applying a machine update; interleaving update/start at
# width made later config-only updates hit cpu_overcommit_exceeded even though
# the final 37-machine shape fit. Each child publishes its completed update and
# waits here; one release then lets every explicit start proceed concurrently.
boot_config_failed_child() {
    local j out mid
    for j in "${!CHILD_OUT[@]}"; do
        out="${CHILD_OUT[$j]}"
        mid="${CHILD_MACHINE[$j]}"
        if [ -f "$out/benchmark-child.finished" ] \
            && [ ! -f "$BOOT_CONFIG_BARRIER/ready/$mid" ]; then
            printf '%s\n' "${CHILD_BENCH[$j]}"
            return 0
        fi
    done
    return 1
}
if [ "${CLOUDBENCH_BOOT_LAUNCH:-1}" = "1" ]; then
    boot_config_deadline=$((SECONDS + BOOT_CONFIG_BARRIER_WAIT_SECONDS))
    while :; do
        boot_config_ready="$(find "$BOOT_CONFIG_BARRIER/ready" -type f 2>/dev/null | wc -l | tr -d ' ')"
        [ "$boot_config_ready" = "${#CHILD_PIDS[@]}" ] && break
        if boot_config_failed_bench="$(boot_config_failed_child)"; then
            echo "❌ boot config failed before barrier release: $boot_config_failed_bench exited without a ready marker (${boot_config_ready:-0}/${#CHILD_PIDS[@]} ready)" >&2
            exit 1
        fi
        if [ "$SECONDS" -ge "$boot_config_deadline" ]; then
            echo "❌ boot config barrier timed out: ${boot_config_ready:-0}/${#CHILD_PIDS[@]} updates ready" >&2
            exit 1
        fi
        sleep 0.2
    done
    : > "$BOOT_CONFIG_BARRIER/release"
    echo "⚙️  ${#CHILD_PIDS[@]}/${#CHILD_PIDS[@]} boot configs applied while stopped; releasing concurrent starts"
    release_capacity_reservation_after_primary_start_accounted || true
fi

echo ""
echo "⏳ ${#CHILD_PIDS[@]} isolated bench machine(s) running."

# ── ONE aggregated batch dashboard (served; never auto-opens a browser) ─────
# Merge every bench's live report-card.json into a single card (N per_task rows,
# summed cost + tokens) and serve it on DASH_BASE. Each row's agent_url already
# points at its own bench's /open-agent (localhost:<bench-port>), so clicking
# "open" from the batch view routes to the right isolated machine's viewer.
UNIFIED_DIR="$FLEET_DIR/_batch"
rm -rf "$UNIFIED_DIR" 2>/dev/null || true; mkdir -p "$UNIFIED_DIR"
printf '%s' "${CODE_SUMMARY:-}" > "$UNIFIED_DIR/code.txt"   # shown in the dashboard header
cp -f "$ROOT_DIR/agents/benchmarks/dashboard.html" "$UNIFIED_DIR/dashboard.html" 2>/dev/null || true
# NOTE: never kill whatever holds DASH_BASE — that is the ONE persistent central
# hub, shared across every run + carrying the user's open tab. It picks up this
# new run dir on its next scan. We (re)start it below ONLY if it isn't already up.
# Manifest of EVERY bench in the batch — the dashboard always renders all N rows
# (queued → running → done), never a subset while some machines are still booting.
{
    printf '['
    for j in "${!CHILD_BENCH[@]}"; do
        [ "$j" -gt 0 ] && printf ','
        printf '{"name":"%s","mode":"%s","port":%s}' "${CHILD_BENCH[$j]}" "${CHILD_MODE[$j]}" "${CHILD_PORT[$j]}"
    done
    printf ']'
} > "$UNIFIED_DIR/benches.json"
# Revalidate/restart the identity-owned hub BEFORE the aggregator captures
# DASH_BASE. If the early hub disappeared and a foreign workspace took its
# port, every generated agent URL must use the newly selected port.
start_central_hub || exit 1
require_central_hub_visibility || exit 1
HUB_URL="http://localhost:$DASH_BASE/"
RUN_URL="http://localhost:$DASH_BASE/run/$RUN_ID/dashboard.html"
(
    while :; do
        env FLEET_DIR="$FLEET_DIR" UNIFIED_DIR="$UNIFIED_DIR" DASH_BASE="$DASH_BASE" \
            python3 - "$UNIFIED_DIR/report-card.json" <<'PY' 2>/dev/null || true
import json, os, sys
from pathlib import Path
from urllib.parse import parse_qs, urlparse
out = sys.argv[1]; fleet = os.environ["FLEET_DIR"]; dash_base = os.environ.get("DASH_BASE", "8765")
# Startup-phase tracker (stdlib-only) → per-row step timeline while queued.
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(fleet)), "agents"))
try:
    from benchmarks.fleet_startup_phase import startup_state
except Exception:
    startup_state = None
benches = json.load(open(os.path.join(os.environ["UNIFIED_DIR"], "benches.json")))
per_task = []
ci = {"agents_llm_usd": 0.0, "wmh_grounding_usd": 0.0, "infra_usd": 0.0, "total_usd": 0.0}
mi = {"tokens_in": 0, "tokens_out": 0}
modes, elapsed = set(), 0.0
for b in benches:
    name = b["name"]; default_mode = "simulate" if b.get("mode") == "SIM" else "real"
    card = None
    try: card = json.load(open(os.path.join(fleet, name, "cloudbench-live", "report-card.json")))
    except Exception: card = None
    row = None
    if card:
        rows = card.get("per_task") or []
        row = next((r for r in rows if r.get("name") == name), rows[0] if rows else None)
    if row is None:   # seed a queued placeholder so ALL N benches always show
        row = {"name": name, "status": "queued", "duration_s": None, "cost_usd": None,
               "agent_url": None, "tokens_in": 0, "tokens_out": 0,
               "world_model_mode": default_mode, "infra_usd": None}
    row.setdefault("world_model_mode", default_mode)
    # Route "open" through the DURABLE batch resolver (DASH_BASE) — never the
    # per-bench port that dies with the run. The resolver serves from local run
    # data, so the link can't go dead.
    url = row.get("agent_url")
    if url:
        try:
            aid = (parse_qs(urlparse(url).query).get("agent-id") or [""])[0]
        except Exception:
            aid = ""
        if aid:
            row["agent_url"] = f"http://localhost:{dash_base}/open-agent?agent-id={aid}"
    # While queued (before the on-box run_benchmark emits a card), surface the
    # concrete startup step + expected/elapsed so the dashboard shows progress.
    if row.get("status") == "queued" and startup_state is not None:
        try:
            row["startup"] = startup_state(
                Path(fleet) / name / "fleet-child.log",
                Path(fleet) / name / ".startup-state.json",
            )
        except Exception:
            pass
    per_task.append(row)
    if card:
        cost = card.get("cost") or {}
        for k in ci:
            v = cost.get(k)
            if isinstance(v, (int, float)): ci[k] += v
        md = card.get("metadata") or {}
        mi["tokens_in"] += int(md.get("tokens_in") or 0); mi["tokens_out"] += int(md.get("tokens_out") or 0)
        elapsed = max(elapsed, float(card.get("elapsed_s") or 0))
    if row.get("world_model_mode"): modes.add(row["world_model_mode"])
st = lambda s: sum(1 for t in per_task if t.get("status") == s)
passed, failed = st("passed"), st("failed") + st("error")
running = sum(1 for t in per_task if t.get("status") == "running")
queued = sum(1 for t in per_task if t.get("status") == "queued")
try:
    code_summary = open(os.path.join(os.environ["UNIFIED_DIR"], "code.txt")).read().strip()
except Exception:
    code_summary = ""
card = {
    "run_id": "batch",
    "code": code_summary,
    "elapsed_s": elapsed,
    "world_model_mode": (list(modes)[0] if len(modes) == 1 else "mixed") if modes else "real",
    "tasks": {"total": len(benches), "running": running, "completed": passed + failed, "queued": queued},
    "results": {"passed": passed, "failed": failed, "transient": st("transient"),
                "success_rate": round(passed / max(1, passed + failed), 3)},
    "cost": {**{k: round(v, 4) for k, v in ci.items()}, "fast_cache_hit_rate": None},
    "metadata": mi,
    "infra": None,
    "per_task": per_task,
}
with open(out, "w") as f: json.dump(card, f); f.write("\n")
PY
        sleep 1
    done
) & UNIFIED_AGG_PID=$!
echo "   this run: $RUN_URL"
echo "   per-bench viewers: $(for j in "${!CHILD_PORT[@]}"; do printf '%s→:%s ' "${CHILD_BENCH[$j]}" "${CHILD_PORT[$j]}"; done)"
echo ""

# A fleet run means simultaneous benchmark execution, not merely concurrent
# provisioning. Each on-box driver announces after its isolated stack is
# healthy; only then do we touch every machine's release file in parallel.
release_start_barrier() {
    [ "$SYNCHRONIZED_START" = "1" ] || return 0
    # TOLERANT barrier (default): at fleet width some isolated stacks sporadically
    # fail on-box startup (resource/timing races under N concurrent full stacks).
    # An all-or-nothing barrier turned ONE such infra failure into a whole-batch
    # abort, so a 30/31-healthy run reported ZERO results. Instead, exclude a
    # stack that dies before signalling ready (it's an infra failure, not a
    # benchmark verdict), keep waiting for the live set, and release the barrier
    # for the survivors. Only fail if EVERY stack dies.
    #
    # STRICT barrier (CLOUDBENCH_STRICT_BARRIER=1 / --strict-barrier /
    # --infra-probe): any exclusion or timeout fails closed. Infra canaries and
    # /descend must not accept "most boxes OK" as a green substrate.
    local total="${#CHILD_PIDS[@]}" ready deadline now out p j live barrier_start per_box
    local status_port ready_marker_url
    local -a is_ready=() is_dead=()
    for j in "${!CHILD_PIDS[@]}"; do is_ready[$j]=0; is_dead[$j]=0; done
    barrier_start="$(date +%s)"
    deadline=$(( barrier_start + START_BARRIER_WAIT_SECONDS ))
    # Per-box ceiling: a single box whose launcher is alive but never reaches the
    # barrier (e.g. a hung iMessage-relay setup, or a driver dead before the poll
    # loop where staleness can't see it) otherwise drags the WHOLE barrier until
    # the global timeout, and every ready box waits idle. Exclude such a holdout
    # after a generous window (covers the slowest legitimate bring-up).
    per_box="$PER_BOX_BARRIER_WAIT_SECONDS"
    echo "⏸️  waiting for $total isolated stacks at synchronized start barrier..."
    while :; do
        now="$(date +%s)"
        ready=0; live=0
        for j in "${!CHILD_PIDS[@]}"; do
            [ "${is_dead[$j]}" = "1" ] && continue
            out="${CHILD_OUT[$j]}"; p="${CHILD_PIDS[$j]}"
            if [ "${is_ready[$j]}" = "0" ]; then
                # The on-box marker is the readiness source of truth. Console
                # streaming intentionally tails only a few changed lines, so a
                # healthy box can write this marker while fleet-child.log omits
                # the READY line. Observe the durable artifact through the same
                # data-plane tunnel used for authenticated barrier release.
                status_port="$(cat "$out/status-proxy.port" 2>/dev/null || true)"
                case "$status_port" in
                    ''|*[!0-9]*) ;;
                    *)
                        ready_marker_url="http://127.0.0.1:$status_port/cloudbench-start-$RUN_ID.ready"
                        if curl --noproxy '*' -fsS --max-time 1 -o /dev/null \
                            "$ready_marker_url" 2>/dev/null; then
                            is_ready[$j]=1
                        fi
                        ;;
                esac
                # Retain the emitted line as a compatibility signal for a
                # tunnel rotating at this instant; it is written only after
                # the same marker and cannot create an early release.
                if [ "${is_ready[$j]}" = "0" ] && \
                   grep -aFq "synchronized start barrier ready: $RUN_ID" "$out/fleet-child.log" 2>/dev/null; then
                    is_ready[$j]=1
                fi
            fi
            if [ "${is_ready[$j]}" = "1" ]; then
                ready=$((ready + 1)); live=$((live + 1))
            elif ! kill -0 "$p" 2>/dev/null; then
                # exited before signalling ready → infra failure; exclude it.
                is_dead[$j]=1
                echo "⚠️  [${CHILD_BENCH[$j]}] isolated stack failed before the start barrier — excluding it (infra) and continuing with the rest" >&2
            elif [ $(( now - barrier_start )) -ge "$per_box" ]; then
                # alive but never reached the barrier within the window → holdout.
                is_dead[$j]=1
                echo "⚠️  [${CHILD_BENCH[$j]}] did not reach the start barrier within ${per_box}s — excluding it (infra) and continuing with the rest" >&2
            else
                live=$((live + 1))
            fi
        done
        [ "$live" -eq 0 ] && { echo "❌ every isolated stack failed before the start barrier" >&2; return 1; }
        [ "$ready" -ge "$live" ] && break
        if [ "$now" -ge "$deadline" ]; then
            if [ "${STRICT_BARRIER:-0}" = "1" ]; then
                echo "❌ STRICT barrier: timed out with only $ready/$total ready (need all $total)" >&2
                return 1
            fi
            echo "⚠️  start barrier timed out ($ready/$live live ready) — releasing the ready set anyway" >&2
            break
        fi
        sleep 2
    done
    local excluded=$(( total - ready ))
    echo "✅ $ready/$total isolated stacks reached the barrier ($excluded excluded as infra failures)"
    if [ "${STRICT_BARRIER:-0}" = "1" ] && [ "$excluded" -ne 0 ]; then
        echo "❌ STRICT barrier: refusing to release with $excluded/$total infra exclusions (need 0)" >&2
        return 1
    fi
    local autoscaler_ready_indices=()
    for j in "${!CHILD_PIDS[@]}"; do
        [ "${is_ready[$j]}" = "1" ] && autoscaler_ready_indices+=("$j")
    done
    if [ "${INFRA_PROBE:-0}" = "1" ] || [ "${SKIP_AUTOSCALER:-0}" = "1" ]; then
        if [ "${INFRA_PROBE:-0}" = "1" ]; then
            echo "⚖️  infra-probe: skipping mandatory autoscaler startup wait (${#autoscaler_ready_indices[@]} ready stacks)"
        else
            echo "⚖️  skip-autoscaler: skipping mandatory autoscaler startup wait (${#autoscaler_ready_indices[@]} ready stacks)"
        fi
    elif ! wait_for_mandatory_autoscaler_startup "${autoscaler_ready_indices[@]}"; then
        return 1
    else
        echo "⚖️  ${#autoscaler_ready_indices[@]}/${#autoscaler_ready_indices[@]} mandatory per-bench autoscalers ready"
    fi
    echo "🚦 releasing synchronized start barrier on the ready machines..."
    local release_pids=() release_failed=0 release_port_file
    for j in "${!CHILD_MACHINE[@]}"; do
        [ "${is_ready[$j]}" = "1" ] || continue
        release_port_file="${CHILD_OUT[$j]}/status-proxy.port"
        (
            released=0
            for _release_attempt in $(seq 1 "${CLOUDBENCH_BARRIER_RELEASE_ATTEMPTS:-10}"); do
                status_port="$(cat "$release_port_file" 2>/dev/null || true)"
                case "$status_port" in ''|*[!0-9]*) sleep 1; continue ;; esac
                status_code="$(curl -sS --max-time 3 -o /dev/null -w '%{http_code}' \
                    -X POST -H "Authorization: Bearer $CLOUDBENCH_BARRIER_TOKEN" \
                    "http://127.0.0.1:$status_port/release" 2>/dev/null || true)"
                if [ "$status_code" = "204" ]; then released=1; break; fi
                sleep 1
            done
            [ "$released" = "1" ]
        ) &
        release_pids+=("$!")
    done
    for p in "${release_pids[@]}"; do wait "$p" || release_failed=1; done
    if [ "$release_failed" = "1" ]; then
        echo "❌ could not release synchronized start barrier on every ready stack" >&2
        return 1
    fi
    return 0
}

if ! release_start_barrier; then
    exit 1
fi

# ── Wait for all children, then aggregate ────────────────────────────────────
for j in "${!CHILD_PIDS[@]}"; do
    p="${CHILD_PIDS[$j]}"
    if wait "$p" 2>/dev/null; then
        CHILD_EXIT_CODES[$j]="0"
    else
        CHILD_EXIT_CODES[$j]="$?"
    fi
done
# The child marker is only the start of autoscaler terminalization. Poll all
# autoscalers together so a synchronous provider clone or an async worker stage
# can settle before we sample final capacity. A timeout never forgives shortage:
# the unchanged checks below still fail closed on live, incomplete state.
autoscaler_finalization_deadline=$((SECONDS + AUTOSCALER_FINALIZATION_WAIT_SECONDS))
while :; do
    autoscalers_finalizing=0
    for j in "${!AUTOSCALER_PIDS[@]}"; do
        out="${CHILD_OUT[$j]}"
        [ -s "$out/autoscaler.failed" ] && continue
        [ -e "$out/autoscaler.completed-after-child" ] && continue
        if fleet_job_running "${AUTOSCALER_PIDS[$j]}"; then
            autoscalers_finalizing=$((autoscalers_finalizing + 1))
        fi
    done
    [ "$autoscalers_finalizing" -eq 0 ] && break
    [ "$SECONDS" -ge "$autoscaler_finalization_deadline" ] && break
    sleep 0.2
done
AUTOSCALER_FAILURE=0
for j in "${!AUTOSCALER_PIDS[@]}"; do
    tracked_workers="$(_pool_ids "${CHILD_OUT[$j]}")"
    ready_workers="$(_ready_pool_ids "${CHILD_OUT[$j]}")"
    desired_workers="$(cat "${CHILD_OUT[$j]}/desired-worker-count" 2>/dev/null || true)"
    if [ -s "${CHILD_OUT[$j]}/autoscaler.failed" ]; then
        reason="$(head -1 "${CHILD_OUT[$j]}/autoscaler.failed" 2>/dev/null)"
        echo "❌ [${CHILD_BENCH[$j]}] mandatory autoscaler failed during the run: ${reason:-unknown error}" >&2
        AUTOSCALER_FAILURE=1
    elif ! printf '%s' "$desired_workers" | grep -Eq '^[0-9]+$'; then
        echo "❌ [${CHILD_BENCH[$j]}] mandatory autoscaler did not persist desired worker capacity" >&2
        AUTOSCALER_FAILURE=1
    elif ! ready_workers_operational "${CHILD_OUT[$j]}"; then
        echo "❌ [${CHILD_BENCH[$j]}] mandatory autoscaler worker became unhealthy before final acceptance" >&2
        AUTOSCALER_FAILURE=1
    elif [ "$ready_workers" -lt "$desired_workers" ]; then
        echo "❌ [${CHILD_BENCH[$j]}] mandatory autoscaler worker capacity below desired: $ready_workers/$desired_workers workers queue-ready" >&2
        AUTOSCALER_FAILURE=1
    elif [ "$tracked_workers" != "$ready_workers" ] \
        || find "${CHILD_OUT[$j]}" -maxdepth 1 -name 'worker-*.pending' -print -quit 2>/dev/null | grep -q .; then
        echo "❌ [${CHILD_BENCH[$j]}] mandatory autoscaler worker capacity incomplete: $ready_workers/$tracked_workers workers queue-ready" >&2
        AUTOSCALER_FAILURE=1
    elif ! mandatory_autoscaler_process_acceptable \
        "${CHILD_OUT[$j]}" "${AUTOSCALER_PIDS[$j]}"; then
        # Capacity shortages above are provider/queue facts and remain the most
        # actionable terminal reason even if the autoscaler exits in the same
        # scheduler tick. Only use the generic process reason once measured
        # capacity itself is satisfied.
        echo "❌ [${CHILD_BENCH[$j]}] mandatory autoscaler exited during the run" >&2
        AUTOSCALER_FAILURE=1
    elif [ ! -e "${CHILD_OUT[$j]}/autoscaler.completed-after-child" ]; then
        # A live process is acceptable during the bounded drain, but never after
        # it. Counts alone are a mutable snapshot; only the autoscaler's causal
        # completion marker proves that no committed transition remains.
        printf '%s\n' "mandatory autoscaler did not confirm terminal completion" \
            > "${CHILD_OUT[$j]}/autoscaler.acceptance-failed" 2>/dev/null || true
        echo "❌ [${CHILD_BENCH[$j]}] mandatory autoscaler did not confirm terminal completion" >&2
        AUTOSCALER_FAILURE=1
    fi
done
# Normal completion has already reaped every child. Clear the ownership list so
# EXIT cleanup cannot signal a stale PID that the OS may have since reused.
CHILD_PIDS=()
# Autoscalers that already published causal completion are finished work, not
# live ownership. Reap them before the fleet summary / EXIT path so guest
# shutdown cannot race a vanishing jobs(1) entry into "survived local teardown".
reaped_autoscaler_pids=()
for j in "${!AUTOSCALER_PIDS[@]}"; do
    autoscaler_pid="${AUTOSCALER_PIDS[$j]}"
    [ -n "$autoscaler_pid" ] || continue
    if [ -e "${CHILD_OUT[$j]}/autoscaler.completed-after-child" ] \
        && ! fleet_job_running "$autoscaler_pid"; then
        wait "$autoscaler_pid" 2>/dev/null || true
        continue
    fi
    reaped_autoscaler_pids+=("$autoscaler_pid")
done
AUTOSCALER_PIDS=()
if [ "${#reaped_autoscaler_pids[@]}" -gt 0 ]; then
    AUTOSCALER_PIDS=("${reaped_autoscaler_pids[@]}")
fi
# One final merge so the batch dashboard reflects terminal results. Stop and
# reap the aggregator's whole tree first: its current sleep is a separate child
# and must not race this canonical write or outlive terminal status publication.
if ! cloudbench_terminate_tree_and_wait "${CLOUDBENCH_CHILD_TERM_SECONDS:-30}" \
    "${UNIFIED_AGG_PID:-}"; then
    echo "❌ final aggregate blocked: its owned process tree did not terminate" >&2
    LOCAL_PROCESS_TEARDOWN_FAILED=1
    exit 1
fi
UNIFIED_AGG_PID=""
if ! python3 "$AGGREGATE_RUNS_SCRIPT" "$FLEET_DIR" "$UNIFIED_DIR/run.json" \
    --expected-execution-provenance-file "$EXECUTION_PROVENANCE_FILE" \
    --expected-execution-task-matrix-file "$EXECUTION_TASK_MATRIX_FILE"; then
    echo "❌ aggregate rejected missing or mismatched execution provenance" >&2
    exit 1
fi
if [ "$SELF_MANAGED_HUB_RUN" = "1" ]; then
    python3 "$HUB_UPLOAD_HELPER" --upload-final "$UNIFIED_DIR/run.json" \
        --run-id "$BENCHMARK_HUB_PARENT_RUN_ID" --source direct-cloud-fleet
fi

echo ""
echo "════════════════════ FLEET SUMMARY ════════════════════"
FLEET_PASS=0; FLEET_TOTAL=0
for j in "${!CHILD_BENCH[@]}"; do
    bench="${CHILD_BENCH[$j]}"; out="${CHILD_OUT[$j]}"; mode="${CHILD_MODE[$j]}"
    child_rc="${CHILD_EXIT_CODES[$j]:-1}"
    line="$(RUN_JSON_PATH="$out/cloudbench-run.json" EXPECTED_TASK="$bench" CHILD_RC="$child_rc" \
        RESULT_VALIDATOR="$CLOUDBENCH_RESULT_SCRIPT" \
        EXPECTED_PROVENANCE="$EXECUTION_PROVENANCE_FILE" python3 -c '
import json,os,subprocess,sys
p=os.environ["RUN_JSON_PATH"]
expected=os.environ["EXPECTED_TASK"]
child_rc=int(os.environ["CHILD_RC"])
try:
    # Strict pass only: Claude Code credential SKIPs must not count as PASS.
    check=subprocess.run(
        [
            sys.executable,
            os.environ["RESULT_VALIDATOR"],
            p,
            "--expected-task",
            expected,
            "--expected-execution-provenance-file",
            os.environ["EXPECTED_PROVENANCE"],
            "--require-pass",
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    r=json.load(open(p)); tasks=r.get("tasks",[])
    t=tasks[0] if tasks else {}
    passed=child_rc == 0 and check.returncode == 0
    aid=t.get("agent_id") or ""
    dur=t.get("duration_seconds")
    status="PASS" if passed else ("CHILDFAIL" if child_rc != 0 else "FAIL")
    print(status, aid, ("" if dur is None else round(float(dur),1)))
except Exception as e:
    print("NORESULT", "", "")
' 2>/dev/null || echo "NORESULT  ")"
    status="$(printf '%s' "$line" | awk '{print $1}')"
    aid="$(printf '%s' "$line" | awk '{print $2}')"
    FLEET_TOTAL=$((FLEET_TOTAL + 1))
    [ "$status" = "PASS" ] && FLEET_PASS=$((FLEET_PASS + 1))
    icon="❌"; [ "$status" = "PASS" ] && icon="✅"; [ "$status" = "NORESULT" ] && icon="⚠️ "
    printf '  %s %-38s %-4s %-9s' "$icon" "$bench" "$mode" "$status"
    [ -n "$aid" ] && printf '  agent=%s' "$aid"
    printf '\n'
done
echo "  ────────────────────────────────────────────────────"
echo "  $FLEET_PASS/$FLEET_TOTAL passed"
echo "════════════════════════════════════════════════════════"
[ "$FLEET_PASS" = "$FLEET_TOTAL" ] && [ "$AUTOSCALER_FAILURE" = "0" ]
