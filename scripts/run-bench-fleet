#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# run-bench-fleet — per-bench ISOLATED cloud benchmarks.
#
# Each bench task gets its OWN isolated resources: a dedicated Fly machine cloned
# from the warm box (own backend + Postgres + Temporal queue + WMH), starting at
# one machine per bench. Concurrency = one machine per bench (the n=1,2,4,… rungs
# of the validation ladder), each an independent bubble — no shared stack, no
# cross-bench interference.
#
# Sim is per-bench: every bench defaults to REAL (world model OFF). Pass
# --sim-on <csv> to turn the world-model simulator ON for specific benches.
#
# This is the DEFAULT cloud-bench path (scripts/run-bench delegates here). Autoscaling
# is ON by default and the whole run is shown in ONE aggregated batch dashboard,
# served on the central hub (no browser window is opened — view runs in the
# in-app Benchmarks tab, or open the printed URL manually).
#
# Usage:
#   bash scripts/run-bench <bench> [<bench>...] [flags]        # via the common entry
#   bash scripts/run-bench-fleet spawn-sub-agents parallel-tool-calls
#   bash scripts/run-bench-fleet order-doordash-dinner --sim-on order-doordash-dinner
#
# Flags:
#   --sim-on <a,b>     comma list of benches to run with the WMH simulator ON
#                      (default: all benches REAL / world model OFF)
#   --ref <sha|branch> code ref to check out on each clone (default: HEAD)
#   --dash-base <port> aggregated batch dashboard port; bench i viewer = base+(i+1)*20 (default 8765)
#   --keep-clones      do NOT destroy the per-bench machines on exit (debugging)
#   --timeout <s>      per-bench ceiling passed to run-bench-cloud (default 3600)
#   --autoscale        per-bench worker autoscaling, prod params, scoped to the bench queue (DEFAULT ON)
#   --no-autoscale     keep each bench at its single machine
#   --autoscale-max N  per-bench ceiling of worker machines (default 15 = prod MAX_MACHINES)
#
# Prereq: a warm box exists (bash scripts/run-bench-cloud --setup).
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"
# shellcheck source=lib/cloudbench-env.sh
source "$ROOT_DIR/scripts/lib/cloudbench-env.sh"
MACHINE_READINESS_SCRIPT="$ROOT_DIR/scripts/cloudbench-machine-readiness.py"

APP="navi-whisper-lux-bench"
REGION="${CLOUDBENCH_REGION:-iad}"
MACHINE_NAME="cloudbench-warm"
VOLUME_NAME="cloudbench_data"
# Every run lands in its OWN dir under the runs-root; the central hub (one
# persistent dashboard on DASH_BASE) scans the runs-root so ALL runs show up and
# each is clickable at /run/<id>/. Runs never clobber each other.
RUNS_ROOT="$ROOT_DIR/.context/fleet/runs"
RUN_ID="$(date +%Y%m%d-%H%M%S)-$$"
FLEET_DIR="$RUNS_ROOT/$RUN_ID"
HUB_CTX_DIR="$RUNS_ROOT/_hub"
LOCK_DIR="$(cloudbench_controller_lock_path "$ROOT_DIR" "$APP")"

# ── Args ─────────────────────────────────────────────────────────────────────
BENCHES=()
SIM_ON_CSV=""
BENCH_REF=""
DASH_BASE="8765"
KEEP_CLONES="0"
RUN_TIMEOUT="3600"
AUTOSCALE="1"           # per-bench worker autoscaling (prod params, scoped to the bench queue) — ON by default
AUTOSCALE_MAX="15"      # prod MAX_MACHINES; per-bench ceiling of worker machines
AUTOSCALE_POLL="10"     # seconds between desired-count reads off the box /metrics
SYNCHRONIZED_START="${CLOUDBENCH_SYNCHRONIZED_START:-1}"
PROVISION_POOL=""       # --provision-pool N: pre-provision N stopped clones (current image) then exit
POOL_IDS_FILE="$ROOT_DIR/.context/cloudbench-pool.ids"   # persistent pool machine ids (one per line)
POOL_PROVENANCE_FILE="$ROOT_DIR/.context/cloudbench-pool.provenance.tsv" # id, warm id, snapshot id, immutable image, volume ids
POOL_RETIREMENT_FILE="$ROOT_DIR/.context/cloudbench-pool.retirement.tsv" # stale machine/volume + copied creation binding
GIT_COMMON_DIR="$(git rev-parse --git-common-dir 2>/dev/null || echo "$ROOT_DIR/.git")"
case "$GIT_COMMON_DIR" in /*) ;; *) GIT_COMMON_DIR="$ROOT_DIR/$GIT_COMMON_DIR" ;; esac
APP_ENV_LOCK_FILE="$GIT_COMMON_DIR/cloudbench-app-env.lock"
POOL_CLAIMS_DIR="$GIT_COMMON_DIR/cloudbench-pool-claims"
APP_ENV_LOCK_HELD=0
while [ $# -gt 0 ]; do
    case "$1" in
        --sim-on)         SIM_ON_CSV="${2:-}"; shift 2 ;;
        --ref)            BENCH_REF="${2:-}"; shift 2 ;;
        --dash-base)      DASH_BASE="${2:-}"; shift 2 ;;
        --keep-clones)    KEEP_CLONES="1"; shift ;;
        --timeout)        RUN_TIMEOUT="${2:-}"; shift 2 ;;
        --autoscale)      AUTOSCALE="1"; shift ;;
        --no-autoscale)   AUTOSCALE="0"; shift ;;   # each bench stays at its single machine
        --autoscale-max)  AUTOSCALE_MAX="${2:-}"; shift 2 ;;
        --provision-pool) PROVISION_POOL="${2:-}"; shift 2 ;;   # one-time: create N stopped clones, then exit
        -h|--help)        sed -n '2,36p' "$0"; exit 0 ;;
        --*)              echo "❌ Unknown flag: $1" >&2; exit 2 ;;
        *)                BENCHES+=("$1"); shift ;;
    esac
done
case "$RUN_TIMEOUT" in
    ''|*[!0-9]*|0) echo "❌ --timeout must be a positive integer." >&2; exit 2 ;;
esac
if [ -n "$PROVISION_POOL" ]; then
    case "$PROVISION_POOL" in
        ''|*[!0-9]*) echo "❌ --provision-pool requires a positive integer." >&2; exit 2 ;;
    esac
    [ "$PROVISION_POOL" -gt 0 ] \
        || { echo "❌ --provision-pool requires a positive integer." >&2; exit 2; }
fi
required_lock_ttl=$((RUN_TIMEOUT + 3600))
if [ -n "${CLOUDBENCH_CLOUD_LOCK_TTL:-}" ] && [ "$CLOUDBENCH_CLOUD_LOCK_TTL" -lt "$required_lock_ttl" ] 2>/dev/null; then
    echo "❌ CLOUDBENCH_CLOUD_LOCK_TTL must be at least $required_lock_ttl seconds for this fleet run." >&2
    exit 2
fi
CLOUDBENCH_CLOUD_LOCK_TTL="${CLOUDBENCH_CLOUD_LOCK_TTL:-$required_lock_ttl}"
export CLOUDBENCH_CLOUD_LOCK_TTL
# --provision-pool takes no bench args; everything else needs at least one bench.
[ -n "$PROVISION_POOL" ] || true
[ -n "$PROVISION_POOL" ] || [ "${#BENCHES[@]}" -ge 1 ] || { echo "usage: run-bench-fleet <bench> [<bench>...] [--sim-on a,b] [--ref X]  |  --provision-pool N" >&2; exit 2; }
[ -z "$BENCH_REF" ] && BENCH_REF="$(git rev-parse HEAD 2>/dev/null || echo '')"

# A synchronized child begins polling before the controller has finished
# provisioning the remaining machines. Give the remote barrier the full
# per-benchmark timeout, then add that barrier budget to the child's outer
# polling ceiling so benchmark execution still receives RUN_TIMEOUT seconds
# after every isolated stack is ready.
START_BARRIER_WAIT_SECONDS="${CLOUDBENCH_START_BARRIER_WAIT_SECONDS:-$RUN_TIMEOUT}"
for seconds in "$RUN_TIMEOUT" "$START_BARRIER_WAIT_SECONDS"; do
    case "$seconds" in
        ''|*[!0-9]*) echo "❌ --timeout and CLOUDBENCH_START_BARRIER_WAIT_SECONDS must be positive integers" >&2; exit 2 ;;
    esac
    [ "$seconds" -gt 0 ] \
        || { echo "❌ --timeout and CLOUDBENCH_START_BARRIER_WAIT_SECONDS must be positive integers" >&2; exit 2; }
done
CHILD_RUN_TIMEOUT="$RUN_TIMEOUT"
if [ "$SYNCHRONIZED_START" = "1" ]; then
    CHILD_RUN_TIMEOUT=$((RUN_TIMEOUT + START_BARRIER_WAIT_SECONDS))
fi

# ── flyctl + token (mirror run-bench-cloud) ─────────────────────────────────
if ! command -v flyctl >/dev/null 2>&1; then
    if [ -x "$HOME/.fly/bin/flyctl" ]; then export PATH="$HOME/.fly/bin:$PATH"; else
        echo "❌ flyctl not found on PATH." >&2; exit 1; fi
fi
resolve_fly_token() {
    if [ -n "${FLY_BENCH_API_TOKEN:-}" ]; then echo "$FLY_BENCH_API_TOKEN"; return; fi
    local cfg="$HOME/.fly/config.yml"
    if [ -f "$cfg" ]; then
        local t; t="$(grep -E '^access_token:' "$cfg" 2>/dev/null | head -1 | sed 's/^access_token:[[:space:]]*//; s/^["'\'']//; s/["'\'']$//')"
        [ -n "$t" ] && { echo "$t"; return; }
    fi
    if [ -n "${FLY_API_TOKEN:-}" ]; then echo "$FLY_API_TOKEN"; return; fi
    grep -E '^FLY_API_TOKEN=' agents/.env 2>/dev/null | head -1 | cut -d= -f2- | sed 's/^["'\'']//; s/["'\'']$//'
}
FLY_API_TOKEN="$(resolve_fly_token)"
[ -n "${FLY_API_TOKEN:-}" ] || { echo "❌ No Fly auth token found." >&2; exit 1; }
export FLY_API_TOKEN
FLY() { flyctl "$@"; }

# A clone ID is allocated before its snapshot-backed volume becomes mountable.
# Keep every clone start behind the same storage lifecycle contract as the
# per-benchmark child runner.
machine_storage_ready() {  # machine_storage_ready <id>
    local id="$1" machines volumes
    machines="$(FLY machines list -a "$APP" --json 2>/dev/null)" || return 1
    volumes="$(FLY volumes list -a "$APP" --json 2>/dev/null)" || return 1
    python3 "$MACHINE_READINESS_SCRIPT" "$id" \
        <(printf '%s' "$machines") <(printf '%s' "$volumes") >/dev/null
}

fleet_machine_state() {
    local id="$1"
    FLY machines list -a "$APP" --json 2>/dev/null | ID="$id" python3 -c '
import json, os, sys
wanted = os.environ["ID"]
for machine in json.load(sys.stdin) or []:
    if machine.get("id") == wanted:
        print(machine.get("state") or "")
        break
' 2>/dev/null || true
}

fleet_machine_image() {
    local id="$1"
    FLY machines list -a "$APP" --json 2>/dev/null | ID="$id" python3 -c '
import json, os, sys
wanted = os.environ["ID"]
for machine in json.load(sys.stdin) or []:
    if machine.get("id") == wanted:
        print((machine.get("config") or {}).get("image") or "")
        break
' 2>/dev/null || true
}

POOL_PROVENANCE_LINE=""
POOL_PROVENANCE_WARM=""
POOL_PROVENANCE_SNAPSHOT=""
POOL_PROVENANCE_IMAGE=""
POOL_PROVENANCE_VOLUMES=""
pool_machine_provenance_load() {  # exact durable creation record; no live-resource inference
    local id="$1" matches provenance_id provenance_warm provenance_snapshot provenance_image provenance_volumes
    [ -f "$POOL_PROVENANCE_FILE" ] || {
        echo "❌ pool provenance ledger is missing: $POOL_PROVENANCE_FILE" >&2
        return 2
    }
    matches="$(awk -F '\t' -v wanted="$id" '$1 == wanted { print }' "$POOL_PROVENANCE_FILE")"
    if [ "$(printf '%s\n' "$matches" | grep -c . 2>/dev/null || true)" != "1" ]; then
        echo "❌ pool machine $id has missing or ambiguous creation provenance" >&2
        return 2
    fi
    if [ "$(printf '%s\n' "$matches" | awk -F '\t' '{ print NF }')" != "5" ]; then
        echo "❌ pool machine $id creation provenance lacks an exact machine-to-volume binding" >&2
        return 2
    fi
    IFS=$'\t' read -r provenance_id provenance_warm provenance_snapshot provenance_image provenance_volumes <<< "$matches"
    if [ "$provenance_id" != "$id" ] || [ -z "$provenance_warm" ] || \
       [ -z "$provenance_snapshot" ] || [ -z "$provenance_image" ] || \
       [ -z "$provenance_volumes" ] || \
       [ -n "$(printf '%s' "$provenance_volumes" | tr ',' '\n' | grep -Ev '^[A-Za-z0-9_-]+$' || true)" ]; then
        echo "❌ pool machine $id has malformed creation provenance" >&2
        return 2
    fi
    POOL_PROVENANCE_WARM="$provenance_warm"
    POOL_PROVENANCE_SNAPSHOT="$provenance_snapshot"
    POOL_PROVENANCE_IMAGE="$provenance_image"
    POOL_PROVENANCE_VOLUMES="$provenance_volumes"
    POOL_PROVENANCE_LINE="$matches"
}

pool_machine_provenance_classify() {  # 0=current, 10=provably owned stale generation, 2=unverifiable
    local id="$1" live_image
    pool_machine_provenance_load "$id" || return 2
    live_image="$(fleet_machine_image "$id")"
    if [ -z "$live_image" ]; then
        echo "❌ pool machine $id live image could not be read" >&2
        return 2
    fi
    if [ "$live_image" != "$POOL_PROVENANCE_IMAGE" ]; then
        echo "❌ pool machine $id live image does not match its recorded immutable image" >&2
        return 2
    fi
    if [ "$POOL_PROVENANCE_WARM" = "$WARM_ID" ] && \
       [ "$POOL_PROVENANCE_SNAPSHOT" = "$SNAP_ID" ] && \
       [ "$POOL_PROVENANCE_IMAGE" = "$WARM_IMAGE_IDENTITY" ]; then
        return 0
    fi
    return 10
}

pool_machine_provenance_valid() {  # pool_machine_provenance_valid <id>
    local id="$1" classification
    if pool_machine_provenance_classify "$id"; then
        return 0
    else
        classification=$?
    fi
    if [ "$classification" -eq 10 ]; then
        echo "❌ pool machine $id provenance belongs to a stale warm image/snapshot generation" >&2
    fi
    return 1
}

validate_tracked_pool_provenance() {
    [ -f "$POOL_IDS_FILE" ] || return 0
    local id st presence
    while read -r id; do
        [ -n "$id" ] || continue
        st="$(pool_machine_state "$id")"
        presence=$?
        [ "$presence" -eq 1 ] && continue
        [ "$presence" -eq 0 ] || {
            echo "❌ could not inspect tracked pool machine $id for provenance" >&2
            return 1
        }
        pool_machine_provenance_valid "$id" || return 1
    done < "$POOL_IDS_FILE"
}

is_sim_on() { case ",$SIM_ON_CSV," in *",$1,"*) return 0 ;; esac; return 1; }

# Per-bench world-model mode from tasks.json (the catalog is the source of truth):
# world_model_mode == "simulate" → SIM; anything else (real/shadow/unset) → REAL.
# --sim-on <csv> is an explicit OVERRIDE on top of this.
_catalog_wmm() {
    BENCH="$1" agents/venv/bin/python - <<'PY' 2>/dev/null || echo real
import json, os
t = json.load(open("agents/benchmarks/tasks.json"))
tasks = t if isinstance(t, list) else t.get("tasks", [])
e = next((x for x in tasks if x.get("name") == os.environ["BENCH"]), {})
wmm = str(e.get("world_model_mode") or "").lower()
print("simulate" if wmm == "simulate" else "real")
PY
}

# Print EXACTLY what code the run will execute on the box: the ref (HEAD), whether
# it is on origin (unpushed commits never reach the box), and the uncommitted diff
# that is shipped as a patch. Also stashed to $UNIFIED_DIR for the dashboard header.
print_code_provenance() {
    local branch head_sha head_sub pushed dirtystat
    branch="$(git -C "$ROOT_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
    head_sha="$(git -C "$ROOT_DIR" rev-parse --short HEAD 2>/dev/null || echo '?')"
    head_sub="$(git -C "$ROOT_DIR" log -1 --pretty=%s 2>/dev/null || echo '')"
    if git -C "$ROOT_DIR" branch -r --contains HEAD 2>/dev/null | grep -q origin/; then
        pushed="on origin ✓"
    else
        pushed="⚠ NOT on origin — unpushed commits will NOT run on the box (only uncommitted changes ship)"
    fi
    echo "════════════════════ CODE UNDER TEST ════════════════════"
    echo "  branch : $branch"
    echo "  ref    : $BENCH_REF  ($head_sha $head_sub)"
    echo "  pushed : $pushed"
    if git -C "$ROOT_DIR" diff HEAD --quiet 2>/dev/null; then
        echo "  diff   : clean working tree (running committed $head_sha exactly)"
        CODE_SUMMARY="$branch@$head_sha (clean)"
    else
        dirtystat="$(git -C "$ROOT_DIR" diff HEAD --shortstat 2>/dev/null | sed 's/^ *//')"
        echo "  diff   : DIRTY — shipped as a patch on top of $head_sha: $dirtystat"
        git -C "$ROOT_DIR" diff HEAD --stat 2>/dev/null | sed 's/^/           /' | tail -30
        CODE_SUMMARY="$branch@$head_sha +patch($dirtystat)"
    fi
    echo "══════════════════════════════════════════════════════════"
}

# Destroy a machine RELIABLY. A clone still in Fly's 'created'/provisioning state
# no-ops a `--force` destroy (and then auto-starts later → a money-burning
# zombie), so retry across the transition; last resort, stop then destroy.
reap_machine() {  # reap_machine <id> — returns non-zero if the machine survived
    local id="$1" i
    [ -n "$id" ] || return 0
    if [ -n "${WARM_ID:-}" ] && [ "$id" = "$WARM_ID" ]; then
        echo "  ❌ refusing to destroy warm source machine $id" >&2
        return 1
    fi
    for i in 1 2 3 4 5; do
        FLY machine destroy --force "$id" -a "$APP" >/dev/null 2>&1 || true
        FLY machines list -a "$APP" --json 2>/dev/null | grep -q "\"$id\"" || return 0
        [ "$i" = 3 ] && FLY machine stop "$id" -a "$APP" >/dev/null 2>&1 || true
        sleep 3
    done
    if FLY machines list -a "$APP" --json 2>/dev/null | grep -q "\"$id\""; then
        echo "  ⚠️ could not destroy machine $id — check: flyctl machines list -a $APP" >&2
        return 1
    fi
    return 0
}

# ── Pre-provisioned pool: stopped clones (current image) claimed on demand ───
# A claimed pool machine skips the ~300s volume fork (its volume is already
# forked). It still git-fetches the ref + applies the patch on claim, so it runs
# the CURRENT branch code — the baked image only supplies deps. Stopped pool
# machines cost $0 compute (volumes only) between runs.
machine_id_for_clone_name() {  # machine_id_for_clone_name <name> <absolute-seconds-deadline>
    local target_name="$1" deadline="$2" matches
    while :; do
        matches="$(FLY machines list -a "$APP" --json 2>/dev/null \
            | TARGET_NAME="$target_name" python3 -c '
import json, os, sys
try: machines = json.load(sys.stdin) or []
except Exception: machines = []
for machine in machines:
    if machine.get("name") == os.environ["TARGET_NAME"] and machine.get("id"):
        print(machine["id"])
' 2>/dev/null || true)"
        if [ "$(printf '%s\n' "$matches" | grep -c . 2>/dev/null || true)" = "1" ]; then
            printf '%s' "$matches"
            return 0
        fi
        if [ "$SECONDS" -ge "$deadline" ]; then
            echo "❌ unresolved clone name '$target_name'; inspect with: flyctl machines list -a $APP --json" >&2
            return 1
        fi
        sleep 1
    done
}

clone_machine_target() {  # clone_machine_target <ownership-ledger> [source-id]; echo target id
    local ledger="$1" source_id="${2:-$WARM_ID}" clone_out clone_status target_id target_name diagnostic_log names_ledger deadline
    target_name="cloudbench-$(python3 -c 'import uuid; print(uuid.uuid4().hex[:24])')"
    mkdir -p "$(dirname "$ledger")"
    names_ledger="${ledger%.ids}.names"
    printf '%s\n' "$target_name" >> "$names_ledger"
    clone_out="$(FLY machine clone "$source_id" -a "$APP" \
        --from-snapshot "$SNAP_ID" --region "$REGION" --name "$target_name" --detach 2>&1)"
    clone_status=$?
    diagnostic_log="${ledger%.ids}.log"
    {
        printf 'clone name=%s source=%s status=%s\n' "$target_name" "$source_id" "$clone_status"
        printf '%s\n' "$clone_out"
    } >> "$diagnostic_log"

    deadline=$((SECONDS + ${CLOUDBENCH_CLONE_LOOKUP_SECONDS:-10}))
    target_id="$(machine_id_for_clone_name "$target_name" "$deadline")" || target_id=""
    if [ -n "$target_id" ] && [ "$target_id" != "$source_id" ] && [ "$target_id" != "$WARM_ID" ]; then
        grep -Fxq "$target_id" "$ledger" 2>/dev/null || printf '%s\n' "$target_id" >> "$ledger"
        grep -Fxv "$target_name" "$names_ledger" > "$names_ledger.tmp" 2>/dev/null || true
        mv "$names_ledger.tmp" "$names_ledger"
    else
        target_id=""
    fi
    if [ "$clone_status" -ne 0 ] || [ -z "$target_id" ]; then
        echo "❌ Fly clone did not return a distinct authoritative target (name=$target_name, source=$source_id, status=$clone_status)" >&2
        printf '%s\n' "$clone_out" | sed 's/^/   /' >&2
        return 1
    fi
    printf '%s' "$target_id"
}

fleet_machine_volume_ids() {  # fleet_machine_volume_ids <machine-id>
    local id="$1"
    FLY volumes list -a "$APP" --json 2>/dev/null | MACHINE_ID="$id" python3 -c '
import json, os, sys
try:
    volumes = json.load(sys.stdin)
except (TypeError, ValueError):
    raise SystemExit(2)
if not isinstance(volumes, list) or any(not isinstance(volume, dict) for volume in volumes):
    raise SystemExit(2)
for volume in volumes:
    if volume.get("attached_machine_id") == os.environ["MACHINE_ID"] and volume.get("id"):
        print(volume["id"])
'
}

fleet_volume_presence() {  # fleet_volume_presence <volume-id>: 0=present, 1=absent, 2=invalid read
    local id="$1" volumes
    volumes="$(FLY volumes list -a "$APP" --json 2>/dev/null)" || return 2
    printf '%s' "$volumes" | VOLUME_ID="$id" python3 -c '
import json, os, sys
try:
    volumes = json.load(sys.stdin)
except (TypeError, ValueError):
    raise SystemExit(2)
if not isinstance(volumes, list) or any(not isinstance(volume, dict) for volume in volumes):
    raise SystemExit(2)
raise SystemExit(0 if any(volume.get("id") == os.environ["VOLUME_ID"] for volume in volumes) else 1)
'
}

fleet_orphan_volume_safe_for_missing_machine() {  # exact recorded volume must be absent or detached
    local id="$1" volumes
    volumes="$(FLY volumes list -a "$APP" --json 2>/dev/null)" || return 1
    printf '%s' "$volumes" | VOLUME_ID="$id" python3 -c '
import json, os, sys
try:
    volumes = json.load(sys.stdin)
except (TypeError, ValueError):
    raise SystemExit(1)
if not isinstance(volumes, list) or any(not isinstance(volume, dict) for volume in volumes):
    raise SystemExit(1)
matches = [volume for volume in volumes if volume.get("id") == os.environ["VOLUME_ID"]]
if len(matches) > 1:
    raise SystemExit(1)
if not matches:
    raise SystemExit(0)
if "attached_machine_id" not in matches[0]:
    raise SystemExit(1)
attachment = matches[0].get("attached_machine_id")
raise SystemExit(0 if attachment in (None, "") else 1)
'
}

pool_retirement_target_stably_detached() {  # confirm missing Machine + absent/detached exact volume twice
    local id="$1" volume_id="$2" st presence attempt
    for attempt in 1 2; do
        st="$(pool_machine_state "$id")"
        presence=$?
        [ "$presence" -eq 1 ] || {
            echo "❌ pool machine $id is present or unreadable while retiring volume $volume_id" >&2
            return 1
        }
        fleet_orphan_volume_safe_for_missing_machine "$volume_id" || {
            echo "❌ recorded volume $volume_id for missing pool machine $id is attached or unreadable" >&2
            return 1
        }
        [ "$attempt" -eq 2 ] || sleep 2
    done
}

upgrade_pool_provenance_volume_bindings() {
    [ -f "$POOL_IDS_FILE" ] || return 0
    local id st presence matches field_count provenance_id provenance_warm provenance_snapshot provenance_image
    local live_image volume_ids volume_csv replacement tmp="$POOL_PROVENANCE_FILE.tmp"
    while read -r id; do
        [ -n "$id" ] || continue
        st="$(pool_machine_state "$id")"
        presence=$?
        [ "$presence" -eq 1 ] && continue
        [ "$presence" -eq 0 ] || {
            echo "❌ could not inspect tracked pool machine $id during provenance migration" >&2
            return 1
        }
        matches="$(awk -F '\t' -v wanted="$id" '$1 == wanted { print }' "$POOL_PROVENANCE_FILE")"
        [ "$(printf '%s\n' "$matches" | grep -c . 2>/dev/null || true)" = "1" ] || {
            echo "❌ cannot migrate missing or ambiguous pool provenance for $id" >&2
            return 1
        }
        field_count="$(printf '%s\n' "$matches" | awk -F '\t' '{ print NF }')"
        if [ "$field_count" = "5" ]; then
            pool_machine_provenance_load "$id" || return 1
            continue
        fi
        [ "$field_count" = "4" ] || {
            echo "❌ cannot migrate malformed pool provenance for $id" >&2
            return 1
        }
        IFS=$'\t' read -r provenance_id provenance_warm provenance_snapshot provenance_image <<< "$matches"
        [ "$provenance_id" = "$id" ] && [ -n "$provenance_warm" ] && \
            [ -n "$provenance_snapshot" ] && [ -n "$provenance_image" ] || return 1
        live_image="$(fleet_machine_image "$id")"
        [ -n "$live_image" ] && [ "$live_image" = "$provenance_image" ] || {
            echo "❌ refusing to bind volumes for $id without its recorded immutable live image" >&2
            return 1
        }
        volume_ids="$(fleet_machine_volume_ids "$id")" || {
            echo "❌ could not inspect volumes attached to pool machine $id" >&2
            return 1
        }
        volume_csv="$(printf '%s\n' "$volume_ids" | grep -E '^[A-Za-z0-9_-]+$' | sort -u | paste -sd, -)"
        [ -n "$volume_csv" ] || {
            echo "❌ pool machine $id has no provider-bound volume to record" >&2
            return 1
        }
        replacement="$(printf '%s\t%s\t%s\t%s\t%s' "$id" "$provenance_warm" \
            "$provenance_snapshot" "$provenance_image" "$volume_csv")"
        awk -F '\t' -v wanted="$id" -v replacement="$replacement" \
            '$1 == wanted { print replacement; next } { print }' \
            "$POOL_PROVENANCE_FILE" > "$tmp" || return 1
        mv "$tmp" "$POOL_PROVENANCE_FILE"
        echo "  🔗 recorded provider-bound pool volumes for $id"
    done < "$POOL_IDS_FILE"
}

record_pool_retirement() {  # atomically record exact machine→volume ownership before mutation
    local id="$1" volume_ids="$2" volume_id row tmp="$POOL_RETIREMENT_FILE.tmp.$$"
    [ -n "$POOL_PROVENANCE_WARM" ] && [ -n "$POOL_PROVENANCE_SNAPSHOT" ] && \
        [ -n "$POOL_PROVENANCE_IMAGE" ] && [ -n "$POOL_PROVENANCE_VOLUMES" ] || return 1
    mkdir -p "$(dirname "$POOL_RETIREMENT_FILE")"
    touch "$POOL_RETIREMENT_FILE"
    rm -f "$tmp"
    cp "$POOL_RETIREMENT_FILE" "$tmp" || return 1
    while read -r volume_id; do
        [ -n "$volume_id" ] || continue
        case ",$POOL_PROVENANCE_VOLUMES," in
            *",$volume_id,"*) ;;
            *)
                echo "❌ volume $volume_id is not bound to pool machine $id provenance" >&2
                rm -f "$tmp"
                return 1
                ;;
        esac
        row="$(printf '%s\t%s\t%s\t%s\t%s\t%s' "$id" "$volume_id" \
            "$POOL_PROVENANCE_WARM" "$POOL_PROVENANCE_SNAPSHOT" "$POOL_PROVENANCE_IMAGE" \
            "$POOL_PROVENANCE_VOLUMES")"
        if ! grep -Fxq "$row" "$tmp" 2>/dev/null; then
            printf '%s\n' "$row" >> "$tmp" || { rm -f "$tmp"; return 1; }
        fi
    done <<< "$volume_ids"
    mv "$tmp" "$POOL_RETIREMENT_FILE" || { rm -f "$tmp"; return 1; }
}

pool_retirement_provenance_valid() {  # persistent proof for interrupted post-destroy cleanup
    local id="$1" invalid count expected_count recorded_volumes expected_volumes
    pool_machine_provenance_load "$id" || return 1
    count="$(awk -F '\t' -v machine="$id" '$1 == machine && NF == 6 { count++ } END { print count+0 }' \
        "$POOL_RETIREMENT_FILE" 2>/dev/null)"
    [ "$count" -gt 0 ] || {
        echo "❌ pool retirement $id has no persisted ownership proof" >&2
        return 1
    }
    invalid="$(awk -F '\t' -v machine="$id" -v warm="$POOL_PROVENANCE_WARM" \
        -v snapshot="$POOL_PROVENANCE_SNAPSHOT" -v image="$POOL_PROVENANCE_IMAGE" \
        -v volumes="$POOL_PROVENANCE_VOLUMES" \
        '$1 == machine { owned=0; n=split($6, ids, ","); for (i=1; i<=n; i++) if (ids[i] == $2) owned=1; if (!(NF == 6 && $3 == warm && $4 == snapshot && $5 == image && $6 == volumes && owned)) count++ } END { print count+0 }' \
        "$POOL_RETIREMENT_FILE" 2>/dev/null)"
    [ "$invalid" -eq 0 ] || {
        echo "❌ pool retirement $id does not match its durable creation provenance" >&2
        return 1
    }
    expected_volumes="$(printf '%s' "$POOL_PROVENANCE_VOLUMES" | tr ',' '\n' | sort -u)"
    recorded_volumes="$(awk -F '\t' -v machine="$id" '$1 == machine && NF == 6 { print $2 }' \
        "$POOL_RETIREMENT_FILE" 2>/dev/null | sort -u)"
    expected_count="$(printf '%s\n' "$expected_volumes" | grep -c . 2>/dev/null || true)"
    if [ "$count" -ne "$expected_count" ] || [ "$recorded_volumes" != "$expected_volumes" ]; then
        echo "❌ pool retirement $id does not journal its exact durable volume set" >&2
        return 1
    fi
}

forget_pool_retirement_machine() {  # clear a complete retirement only after every bound volume is absent
    local id="$1" tmp="$POOL_RETIREMENT_FILE.tmp"
    [ -f "$POOL_RETIREMENT_FILE" ] || return 0
    awk -F '\t' -v machine="$id" \
        '!(NF == 6 && $1 == machine)' \
        "$POOL_RETIREMENT_FILE" > "$tmp" || return 1
    mv "$tmp" "$POOL_RETIREMENT_FILE"
}

retire_pool_machine() {  # retire_pool_machine <provably-owned-stale-machine-id>
    local id="$1" st presence provenance_classification retirement_count volume_ids expected_volume_ids volume_id nonce lease_index="" destroyed=0
    [ -n "$id" ] && [ "$id" != "$WARM_ID" ] || {
        echo "❌ refusing to retire empty/warm pool machine id '$id'" >&2
        return 1
    }
    st="$(pool_machine_state "$id")"
    presence=$?
    [ "$presence" -ne 2 ] || {
        echo "❌ could not inspect stale pool machine $id" >&2
        return 1
    }
    retirement_count="$(awk -F '\t' -v machine="$id" '$1 == machine { count++ } END { print count+0 }' \
        "$POOL_RETIREMENT_FILE" 2>/dev/null)"
    if [ "$presence" -eq 0 ]; then
        if pool_machine_provenance_classify "$id"; then
            provenance_classification=0
        else
            provenance_classification=$?
        fi
        [ "$provenance_classification" -eq 10 ] || {
            echo "❌ refusing to retire pool machine $id without live proof of its recorded stale image" >&2
            return 1
        }
        [ "$retirement_count" -eq 0 ] || pool_retirement_provenance_valid "$id" || return 1
    else
        if [ "$retirement_count" -eq 0 ]; then
            # The provider can drop a clone whose snapshot-backed volume never
            # finishes restoring. Its five-field creation record is the only
            # durable machine→volume ownership proof left. Promote that exact
            # proof into the retirement journal only when every recorded
            # volume is absent or detached; an attachment to any live Machine
            # fails closed instead of deleting potentially reused storage.
            pool_machine_provenance_load "$id" || return 1
            expected_volume_ids="$(printf '%s' "$POOL_PROVENANCE_VOLUMES" | tr ',' '\n' | sort -u)"
            [ -n "$expected_volume_ids" ] || {
                echo "❌ missing pool machine $id has no durable volume binding" >&2
                return 1
            }
            while read -r volume_id; do
                [ -n "$volume_id" ] || continue
                pool_retirement_target_stably_detached "$id" "$volume_id" || return 1
            done <<< "$expected_volume_ids"
            record_pool_retirement "$id" "$expected_volume_ids" || return 1
        fi
        pool_retirement_provenance_valid "$id" || return 1
    fi
    if [ "$presence" -eq 0 ]; then
        volume_ids="$(fleet_machine_volume_ids "$id")" || {
            echo "❌ could not inspect volumes owned by stale pool machine $id" >&2
            return 1
        }
        volume_ids="$(printf '%s\n' "$volume_ids" | grep -E '^[A-Za-z0-9_-]+$' | sort -u)"
        expected_volume_ids="$(printf '%s' "$POOL_PROVENANCE_VOLUMES" | tr ',' '\n' | sort -u)"
        [ "$volume_ids" = "$expected_volume_ids" ] || {
            echo "❌ live volumes on stale pool machine $id do not match its durable volume binding" >&2
            return 1
        }
        [ -n "$volume_ids" ] || {
            echo "❌ stale pool machine $id has no provable owned volume" >&2
            return 1
        }
        # Persist the machine→volume ownership proof before destroying either
        # resource. If this controller is interrupted between the two deletes,
        # the next provisioning pass resumes the recorded retirement.
        record_pool_retirement "$id" "$volume_ids" || return 1
        nonce="$(cloudbench_machine_lease_acquire_retry "$APP" "$id" \
            "cloudbench-pool-retire run=$RUN_ID" \
            "${CLOUDBENCH_PRIMARY_LEASE_ATTEMPTS:-45}" \
            "${CLOUDBENCH_PRIMARY_LEASE_RETRY_DELAY:-2}")" || nonce=""
        [ -n "$nonce" ] || {
            echo "❌ stale pool machine $id is leased by another owner; refusing retirement" >&2
            return 1
        }
        lease_index="${#LEASED_PRIMARY_IDS[@]}"
        LEASED_PRIMARY_IDS+=("$id")
        LEASED_PRIMARY_NONCES+=("$nonce")
        if cloudbench_machine_destroy_with_lease "$APP" "$id" "$nonce"; then
            LEASED_PRIMARY_NONCES[$lease_index]=""
            nonce=""
            destroyed=1
        else
            echo "❌ failed to destroy stale pool machine $id under its lease" >&2
            return 1
        fi
        for _ in $(seq 1 60); do
            st="$(pool_machine_state "$id")"
            presence=$?
            [ "$presence" -eq 1 ] && break
            [ "$presence" -eq 0 ] || return 1
            sleep 2
        done
        [ "$presence" -eq 1 ] || {
            echo "❌ stale pool machine $id remained present after leased destroy" >&2
            return 1
        }
    fi

    volume_ids="$(awk -F '\t' -v machine="$id" '$1 == machine && NF == 6 { print $2 }' \
        "$POOL_RETIREMENT_FILE" 2>/dev/null | sort -u)"
    while read -r volume_id; do
        [ -n "$volume_id" ] || continue
        pool_retirement_target_stably_detached "$id" "$volume_id" || return 1
        fleet_volume_presence "$volume_id"
        presence=$?
        if [ "$presence" -eq 1 ]; then
            continue
        fi
        [ "$presence" -eq 0 ] || {
            echo "❌ could not inspect retired pool volume $volume_id" >&2
            return 1
        }
        pool_retirement_target_stably_detached "$id" "$volume_id" || return 1
        destroyed=0
        for _ in 1 2 3 4 5; do
            pool_retirement_target_stably_detached "$id" "$volume_id" || return 1
            if FLY volumes destroy "$volume_id" -a "$APP" --yes >/dev/null 2>&1; then
                fleet_volume_presence "$volume_id"
                presence=$?
                [ "$presence" -eq 1 ] && { destroyed=1; break; }
                [ "$presence" -eq 0 ] || return 1
            fi
            sleep 2
        done
        [ "$destroyed" -eq 1 ] || {
            echo "❌ failed to destroy retired pool volume $volume_id" >&2
            return 1
        }
    done <<< "$volume_ids"
    # Keep the exact full volume set journaled across any partial cleanup. Only
    # after every bound volume has been confirmed absent can the retirement be
    # cleared atomically; otherwise a retry must retain proof for the remainder.
    forget_pool_retirement_machine "$id" || return 1
    echo "  ♻️ retired stale pool machine $id and its owned volumes"
}

resume_pool_retirements() {
    [ -s "$POOL_RETIREMENT_FILE" ] || return 0
    local id
    while read -r id; do
        [ -n "$id" ] || continue
        retire_pool_machine "$id" || return 1
    done < <(cut -f1 "$POOL_RETIREMENT_FILE" | sort -u)
}

provision_pool() {  # provision_pool <N> — ensure at least N stopped clones, record ids, exit
    local n="$1" i id ready st presence existing create_count position tracked ready_count=0
    local nonce lease_index live_image volume_ids volume_csv provenance_classification
    local reconciled_file="$FLEET_DIR/reconciled-pool.ids"
    local reconciled_provenance_file="$FLEET_DIR/reconciled-pool.provenance.tsv"
    case "$n" in
        ''|*[!0-9]*) echo "❌ --provision-pool requires a positive integer." >&2; return 2 ;;
    esac
    [ "$n" -gt 0 ] || { echo "❌ --provision-pool requires a positive integer." >&2; return 2; }

    # Preserve valid tracked machines and only top up the pool. Truncating this
    # ledger would orphan every prior clone (and its billed volume) on each
    # provisioning pass. Missing machines retire only their exact detached,
    # durably bound volumes; an unreadable control-plane response fails closed
    # instead of silently replacing ownership data.
    mkdir -p "$(dirname "$POOL_IDS_FILE")"
    touch "$POOL_IDS_FILE"
    touch "$POOL_PROVENANCE_FILE"
    touch "$POOL_RETIREMENT_FILE"
    upgrade_pool_provenance_volume_bindings || return 1
    resume_pool_retirements || return 1
    : > "$reconciled_file"
    : > "$reconciled_provenance_file"
    while read -r id; do
        case "$id" in ''|*[!0-9a-f]*) continue ;; esac
        [ "$id" != "$WARM_ID" ] || continue
        grep -Fxq "$id" "$reconciled_file" 2>/dev/null && continue
        st="$(pool_machine_state "$id")"
        presence=$?
        if [ "$presence" -eq 1 ]; then
            echo "  ♻️ retiring orphaned volume bindings for missing pool machine $id"
            retire_pool_machine "$id" || return 1
            continue
        fi
        [ "$presence" -eq 0 ] || {
            echo "❌ could not reconcile existing pool machine $id" >&2
            return 1
        }

        # A stopped Machine is not interchangeable with the current warm
        # source. Count it only when both the durable creation provenance and
        # its live immutable image prove that it came from this exact warm
        # image + snapshot generation. Only a unique prior creation record
        # whose immutable image still matches the live machine is safe to
        # rotate. Missing/ambiguous/unreadable/mismatched evidence fails closed.
        if pool_machine_provenance_classify "$id"; then
            provenance_classification=0
        else
            provenance_classification=$?
        fi
        case "$provenance_classification" in
            0) ;;
            10)
                echo "  ♻️ rotating provably owned stale pool capacity $id"
                retire_pool_machine "$id" || return 1
                continue
                ;;
            *) return 1 ;;
        esac
        printf '%s\n' "$id" >> "$reconciled_file"
        printf '%s\n' "$POOL_PROVENANCE_LINE" >> "$reconciled_provenance_file"
    done < "$POOL_IDS_FILE"
    mv "$reconciled_file" "$POOL_IDS_FILE"
    mv "$reconciled_provenance_file" "$POOL_PROVENANCE_FILE"

    existing="$(grep -c . "$POOL_IDS_FILE" 2>/dev/null || true)"
    existing="${existing:-0}"
    create_count=$((n - existing))
    [ "$create_count" -gt 0 ] || create_count=0
    echo "🏊 Ensuring pool has at least $n stopped machines ($existing tracked, $create_count to create; image = warm $WARM_ID, snapshot $SNAP_ID, region $REGION)..."
    if [ "$create_count" -gt 0 ]; then
        for i in $(seq 1 "$create_count"); do
            position=$((existing + i))
            id="$(clone_machine_target "$OWNED_CLONES_FILE")"
            if [ -n "$id" ]; then
                live_image="$(fleet_machine_image "$id")"
                if [ "$live_image" = "$WARM_IMAGE_IDENTITY" ]; then
                    volume_ids="$(fleet_machine_volume_ids "$id")" || volume_ids=""
                    volume_csv="$(printf '%s\n' "$volume_ids" | grep -E '^[A-Za-z0-9_-]+$' | sort -u | paste -sd, -)"
                    if [ -n "$volume_csv" ]; then
                        echo "  [$position/$n] created $id"
                        printf '%s\t%s\t%s\t%s\t%s\n' \
                            "$id" "$WARM_ID" "$SNAP_ID" "$WARM_IMAGE_IDENTITY" "$volume_csv" \
                            >> "$POOL_PROVENANCE_FILE"
                        printf '%s\n' "$id" >> "$POOL_IDS_FILE"
                        grep -Fxv "$id" "$OWNED_CLONES_FILE" > "$OWNED_CLONES_FILE.tmp" 2>/dev/null || true
                        mv "$OWNED_CLONES_FILE.tmp" "$OWNED_CLONES_FILE"
                    else
                        echo "  [$position/$n] ⚠ clone volume binding missing; retaining $id for cleanup"
                    fi
                else
                    echo "  [$position/$n] ⚠ clone image provenance mismatch; retaining $id for cleanup"
                fi
            else
                echo "  [$position/$n] ⚠ clone failed"
            fi
        done
    fi

    echo "⏳ waiting for volumes to provision, then stopping (pool idles at \$0 compute)..."
    while read -r id; do
        [ -n "$id" ] || continue
        ready=0; st=""; nonce=""; lease_index=""
        for _ in $(seq 1 90); do
            # Read the exact JSON machine state. A `flyctl status | grep -q`
            # pipeline is incorrect under pipefail: grep exits on its first
            # match, flyctl receives SIGPIPE, and the successful state is
            # misclassified as a failure.
            st="$(fleet_machine_state "$id")"
            case "$st" in
                started|stopped)
                    if machine_storage_ready "$id"; then
                        ready=1
                        break
                    fi
                    ;;
                destroyed|destroying) break ;;
            esac
            if machine_storage_ready "$id" && [ -z "$nonce" ]; then
                # Even controller-owned fresh clones can still be inside Fly's
                # bootstrap lease handoff. Acquire the platform Machine lease
                # before issuing any lifecycle mutation, and track it so the
                # controller cleanup can recover an ambiguous start/stop.
                nonce="$(cloudbench_machine_lease_acquire_retry "$APP" "$id" \
                    "cloudbench-pool-provision run=$RUN_ID" \
                    "${CLOUDBENCH_PRIMARY_LEASE_ATTEMPTS:-45}" \
                    "${CLOUDBENCH_PRIMARY_LEASE_RETRY_DELAY:-2}")"
                if [ -z "$nonce" ]; then
                    echo "  ⚠ $id is leased by another owner; leaving it untouched"
                    break
                fi
                lease_index="${#LEASED_PRIMARY_IDS[@]}"
                LEASED_PRIMARY_IDS+=("$id")
                LEASED_PRIMARY_NONCES+=("$nonce")
                if ! cloudbench_machine_start_with_lease "$APP" "$id" "$nonce"; then
                    echo "  ⚠ $id could not be started under its provisioning lease"
                    break
                fi
            fi
            sleep 5
        done
        if [ "$ready" != 1 ]; then
            echo "  ⚠ $id never became startable (last_state=${st:-unknown})"
            if [ -n "$nonce" ] && cloudbench_machine_stop_and_release_lease "$APP" "$id" "$nonce"; then
                LEASED_PRIMARY_NONCES[$lease_index]=""
                nonce=""
            fi
            continue
        fi
        if [ "$st" != "stopped" ]; then
            if [ -z "$nonce" ]; then
                nonce="$(cloudbench_machine_lease_acquire_retry "$APP" "$id" \
                    "cloudbench-pool-provision run=$RUN_ID" \
                    "${CLOUDBENCH_PRIMARY_LEASE_ATTEMPTS:-45}" \
                    "${CLOUDBENCH_PRIMARY_LEASE_RETRY_DELAY:-2}")"
                if [ -n "$nonce" ]; then
                    lease_index="${#LEASED_PRIMARY_IDS[@]}"
                    LEASED_PRIMARY_IDS+=("$id")
                    LEASED_PRIMARY_NONCES+=("$nonce")
                fi
            fi
            if [ -z "$nonce" ]; then
                echo "  ⚠ $id is actively leased; refusing to stop another owner"
                continue
            fi
            if cloudbench_machine_stop_and_release_lease "$APP" "$id" "$nonce"; then
                LEASED_PRIMARY_NONCES[$lease_index]=""
                nonce=""
                for _ in $(seq 1 60); do
                    st="$(fleet_machine_state "$id")"
                    [ "$st" = "stopped" ] && break
                    sleep 2
                done
            else
                echo "  ⚠ $id could not be stopped under its provisioning lease"
                continue
            fi
        fi
        if [ "$st" = "stopped" ] && machine_storage_ready "$id"; then
            ready_count=$((ready_count + 1))
            echo "  ✅ pooled (stopped): $id"
        else
            echo "  ⚠ $id could not be verified stopped with ready storage (last_state=${st:-unknown})"
        fi
    done < "$POOL_IDS_FILE"
    tracked="$(grep -c . "$POOL_IDS_FILE" 2>/dev/null || true)"
    tracked="${tracked:-0}"
    echo "✅ pool readiness: $ready_count/$tracked tracked machines stopped → $POOL_IDS_FILE"
    [ "$ready_count" -ge "$n" ] || {
        echo "❌ pool target unmet: need $n ready machines, verified $ready_count" >&2
        return 1
    }
}

CLAIMED_POOL_FILE="$FLEET_DIR/claimed-pool.ids"
UNAVAILABLE_POOL_IDS=()
# Self-heal the pool: a killed run can't run its return-to-stopped step, leaving a
# claimed machine 'started' and un-claimable (claim only takes 'stopped'). At fleet
# START this workspace's controller lock is held, so any active machine in this
# workspace's pool ledger is orphaned. Stop and verify it before environment
# activation (avoids "pool empty" → fresh clone → the 5-min volume-fork slow start).
pool_machine_state() {  # pool_machine_state <id>: prints state; 1=absent, 2=invalid read
    local id="$1" machines
    machines="$(FLY machines list -a "$APP" --json 2>/dev/null)" || return 2
    printf '%s' "$machines" | MACHINE_ID="$id" python3 -c '
import json, os, sys
try:
    machines = json.load(sys.stdin)
except (TypeError, ValueError):
    raise SystemExit(2)
if not isinstance(machines, list) or any(not isinstance(machine, dict) for machine in machines):
    raise SystemExit(2)
machine = next((item for item in machines if item.get("id") == os.environ["MACHINE_ID"]), None)
if machine is None:
    raise SystemExit(1)
state = machine.get("state")
if not isinstance(state, str) or not state:
    raise SystemExit(2)
print(state)
'
}

reconcile_pool() {
    [ -f "$POOL_IDS_FILE" ] || return 0
    local id st presence
    while read -r id; do
        [ -n "$id" ] || continue
        st="$(pool_machine_state "$id")"
        presence=$?
        [ "$presence" -eq 1 ] && continue
        [ "$presence" -eq 0 ] || { echo "❌ could not read pool machine $id before refresh" >&2; return 1; }
        [ "$st" = "stopped" ] && continue
        case "$st" in
            created|replacing|started|starting|stopping)
                UNAVAILABLE_POOL_IDS+=("$id")
                echo "  ↪️  pool machine $id is $st; leaving concurrent owner untouched"
                continue
                ;;
            *)
            echo "❌ pool machine $id has unsafe pre-refresh state '$st'" >&2
            return 1
        esac
    done < "$POOL_IDS_FILE"
}
claim_pool_machine() {  # echo a started, claimed pool machine id (or '' if none free)
    [ -f "$POOL_IDS_FILE" ] || return 0
    local id st presence claim_path owner
    mkdir -p "$POOL_CLAIMS_DIR" "$(dirname "$CLAIMED_POOL_FILE")"
    while read -r id; do
        [ -n "$id" ] || continue
        case "$id" in *[!0-9a-f]*) continue ;; esac
        case " ${UNAVAILABLE_POOL_IDS[*]:-} " in *" $id "*) continue ;; esac
        grep -Fxq "$id" "$CLAIMED_POOL_FILE" 2>/dev/null && continue
        st="$(pool_machine_state "$id")"
        presence=$?
        [ "$presence" -eq 1 ] && continue
        [ "$presence" -eq 0 ] || return 2
        pool_machine_provenance_valid "$id" || return 2
        claim_path="$POOL_CLAIMS_DIR/$id"
        if [ -f "$claim_path" ]; then
            owner="$(head -1 "$claim_path" 2>/dev/null || true)"
            if [ -n "$owner" ] && kill -0 "$owner" 2>/dev/null; then
                continue
            fi
            rm -f "$claim_path"
        fi
        [ "$st" = "stopped" ] || continue   # only claim an existing, stopped machine
        machine_storage_ready "$id" || continue
        # claim_pool_machine is called through command substitution, so shell
        # arrays mutate in a subshell. Files are the cross-subshell and
        # cross-workspace ownership source of truth while the app lock is held.
        printf '%s\n' "$$" > "$claim_path"
        printf '%s\n' "$id" >> "$CLAIMED_POOL_FILE"
        printf '%s' "$id"; return 0
    done < "$POOL_IDS_FILE"
}

release_pool_claim() {  # release only a same-controller local claim; never stop the machine here
    local id="$1" claim_path owner
    [ -n "$id" ] || return 0
    claim_path="$POOL_CLAIMS_DIR/$id"
    owner="$(head -1 "$claim_path" 2>/dev/null || true)"
    [ "$owner" = "$$" ] && rm -f "$claim_path" || true
    if [ -f "$CLAIMED_POOL_FILE" ]; then
        grep -Fxv "$id" "$CLAIMED_POOL_FILE" > "$CLAIMED_POOL_FILE.tmp" 2>/dev/null || true
        mv "$CLAIMED_POOL_FILE.tmp" "$CLAIMED_POOL_FILE"
    fi
}

acquire_app_environment_lock() {
    local owner wait_seconds deadline announced=0
    command -v shlock >/dev/null 2>&1 || {
        echo "❌ shlock is required for cross-workspace benchmark environment locking." >&2
        return 1
    }
    wait_seconds="${CLOUDBENCH_APP_ENV_LOCK_WAIT_SECONDS:-1800}"
    case "$wait_seconds" in
        ''|*[!0-9]*)
            echo "❌ CLOUDBENCH_APP_ENV_LOCK_WAIT_SECONDS must be a positive integer." >&2
            return 1
            ;;
    esac
    if [ "$wait_seconds" -le 0 ]; then
        echo "❌ CLOUDBENCH_APP_ENV_LOCK_WAIT_SECONDS must be a positive integer." >&2
        return 1
    fi
    deadline=$((SECONDS + wait_seconds))
    while :; do
        if shlock -p "$$" -f "$APP_ENV_LOCK_FILE"; then
            APP_ENV_LOCK_HELD=1
            return 0
        fi
        owner="$(cat "$APP_ENV_LOCK_FILE" 2>/dev/null || true)"
        [ "$SECONDS" -ge "$deadline" ] && break
        if [ "$announced" = "0" ]; then
            echo "⏳ waiting for shared benchmark app environment lock (owner=${owner:-unknown}, budget=${wait_seconds}s)..."
            announced=1
        fi
        sleep 2
    done
    echo "❌ Timed out after ${wait_seconds}s waiting for shared benchmark app environment lock." >&2
    return 1
}

release_app_environment_lock() {
    local owner
    [ "$APP_ENV_LOCK_HELD" = "1" ] || return 0
    owner="$(cat "$APP_ENV_LOCK_FILE" 2>/dev/null || true)"
    [ "$owner" = "$$" ] && rm -f "$APP_ENV_LOCK_FILE" 2>/dev/null || true
    APP_ENV_LOCK_HELD=0
}

# ── One controller lock for the whole fleet (children run with --no-lock) ────
# A sibling workspace holding the app-wide Fly lease is normal queue pressure.
# Wait for its handoff so the already-claimed Hub request remains queued/running
# instead of being finalized as seven synthetic failures without agent IDs.
cloudbench_controller_install_release_guard "$LOCK_DIR" "$APP"
if ! cloudbench_controller_wait_acquire "$LOCK_DIR" "$APP"; then
    echo "❌ Cloud benchmark controller acquisition failed." >&2
    exit 1
fi
mkdir -p "$FLEET_DIR"

OWNED_CLONES_FILE="$FLEET_DIR/owned-clones.ids"
AUTOSCALER_PIDS=()
CHILD_PIDS=()
CHILD_OUT=()
CHILD_BENCH=()
CHILD_MODE=()
CHILD_PORT=()
CHILD_MACHINE=()
LEASED_PRIMARY_IDS=()
LEASED_PRIMARY_NONCES=()

track_primary_lease() {
    LEASED_PRIMARY_IDS+=("$1")
    LEASED_PRIMARY_NONCES+=("$2")
}

terminate_and_wait() {  # bounded TERM→KILL for controller-owned local children
    [ "$#" -gt 0 ] || return 0
    local p watchdog
    for p in "$@"; do [ -n "$p" ] && kill "$p" 2>/dev/null || true; done
    (
        sleep "${CLOUDBENCH_CHILD_TERM_SECONDS:-30}"
        for p in "$@"; do [ -n "$p" ] && kill -KILL "$p" 2>/dev/null || true; done
    ) & watchdog=$!
    for p in "$@"; do [ -n "$p" ] && wait "$p" 2>/dev/null || true; done
    kill "$watchdog" 2>/dev/null || true
    wait "$watchdog" 2>/dev/null || true
}

cleanup_impl() {
    local ec="$1" id clone_name name_matches named_id name_deadline failed_names
    local lease_index nonce lease_stop_attempt failed_leased_primaries=""
    # The poller and terminal can deliver TERM to the same process group. Do not
    # let a second signal interrupt teardown after the EXIT trap has begun.
    trap - EXIT
    trap '' HUP INT TERM
    [ -n "${UNIFIED_AGG_PID:-}" ] && kill "$UNIFIED_AGG_PID" 2>/dev/null || true
    # Do NOT kill the central hub (UNIFIED_DASH_PID): it is THE one persistent
    # dashboard — shared across every run, carrying the user's open tab, resolving
    # "open agent" from local run data long after teardown. The next fleet run
    # REUSES it (never rebinds/kills it), so exactly one hub ever runs.
    terminate_and_wait "${AUTOSCALER_PIDS[@]:-}"
    terminate_and_wait "${CHILD_PIDS[@]:-}"
    for lease_index in "${!LEASED_PRIMARY_IDS[@]}"; do
        id="${LEASED_PRIMARY_IDS[$lease_index]}"
        nonce="${LEASED_PRIMARY_NONCES[$lease_index]:-}"
        [ -n "$id" ] && [ -n "$nonce" ] || continue
        echo "🔒 stopping leased primary $id"
        for lease_stop_attempt in 1 2 3; do
            if cloudbench_machine_stop_and_release_lease "$APP" "$id" "$nonce"; then
                nonce=""
                LEASED_PRIMARY_NONCES[$lease_index]=""
                if grep -Fxq "$id" "$POOL_IDS_FILE" 2>/dev/null; then
                    echo "↩️ returning claimed pool machine $id to the stopped pool"
                fi
                release_pool_claim "$id"
                break
            fi
            sleep 2
        done
        if [ -n "$nonce" ]; then
            failed_leased_primaries="$failed_leased_primaries $id"
            echo "  ⚠️ failed to stop leased primary $id; retaining lease until TTL" >&2
        fi
    done
    release_app_environment_lock
    if [ "$KEEP_CLONES" != "1" ]; then
        # Autoscaler worker-pool clones (tracked per bench) first, then the primaries.
        # A failed destroy is a billed-forever zombie: keep it tracked (the
        # worker-clones.ids files under $FLEET_DIR are left in place) and warn
        # loudly with the ids so a later sweep can retry.
        local failed_reaps=""
        failed_names=""
        name_deadline=$((SECONDS + ${CLOUDBENCH_CLONE_LOOKUP_SECONDS:-10}))
        for namef in "$FLEET_DIR"/*/worker-clones.names "$FLEET_DIR/owned-clones.names"; do
            [ -f "$namef" ] || continue
            while read -r clone_name; do
                [ -n "$clone_name" ] || continue
                if ! name_matches="$(machine_id_for_clone_name "$clone_name" "$name_deadline")"; then
                    failed_names="$failed_names $clone_name"
                    ec=1
                    continue
                fi
                while read -r named_id; do
                    [ -n "$named_id" ] || continue
                    echo "🧹 destroying late-appearing clone $named_id (name=$clone_name)"
                    reap_machine "$named_id" || failed_reaps="$failed_reaps $named_id"
                done <<< "$name_matches"
            done < "$namef"
        done
        for idf in "$FLEET_DIR"/*/worker-clones.ids; do
            [ -f "$idf" ] || continue
            while read -r wid; do
                [ -n "$wid" ] || continue
                echo "🧹 destroying worker clone $wid"
                reap_machine "$wid" || failed_reaps="$failed_reaps $wid"
            done < "$idf"
        done
        if [ -f "$OWNED_CLONES_FILE" ]; then
            while read -r id; do
                [ -n "$id" ] || continue
                case " $failed_leased_primaries " in *" $id "*) continue ;; esac
                echo "🧹 destroying fresh clone $id"
                reap_machine "$id" || failed_reaps="$failed_reaps $id"
            done < "$OWNED_CLONES_FILE"
        fi
        if [ -n "$failed_reaps" ]; then
            echo "⚠️  FAILED to destroy machine(s):$failed_reaps — still alive (and billed) on Fly." >&2
            echo "    retry: flyctl machine destroy --force <id> -a $APP  (ownership tracked under $FLEET_DIR)" >&2
            ec=1
        fi
        if [ -n "$failed_names" ]; then
            echo "⚠️  UNRESOLVED clone name(s):$failed_names — ownership names remain under $FLEET_DIR." >&2
            echo "    retry lookup: flyctl machines list -a $APP --json" >&2
        fi
    else
        echo "⚠️  --keep-clones: leaving $(grep -c . "$OWNED_CLONES_FILE" 2>/dev/null || echo 0) fresh clone(s) alive"
    fi
    # Pool primaries are stopped above while their per-Machine lease is still
    # held. Never sweep the shared pool: another controller may own a machine.
    # NOTE: do NOT pkill viewers by "$FLEET_DIR" — the batch resolver (and the
    # archive Vites it spawns for durable /open-agent) carry $FLEET_DIR in their
    # argv too, so that sweep KILLED the very resolver we persist (→ dead link
    # post-run). Per-bench viewers are reaped by their own run-bench-cloud child's
    # exit trap when we SIGTERM CHILD_PIDS above; the batch resolver lives on.
    [ -n "${FLEET_PATCH_FILE:-}" ] && rm -f "$FLEET_PATCH_FILE" 2>/dev/null || true
    cloudbench_controller_release "$LOCK_DIR" "$APP"
}
cleanup() {
    local ec=$?
    # Fleet lifecycle belongs exclusively to the top-level controller. A
    # non-owner shell must preserve the triggering status without side effects.
    cloudbench_dispatch_controller_cleanup "$ec" cleanup_impl "$ec"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

reconcile_pool || exit 1   # stop + verify this workspace's pool before env activation
acquire_app_environment_lock || exit 1
echo "🔐 Refreshing + production-verifying the shared benchmark environment before machine start..."
if ! CLOUDBENCH_PARENT_LOCK_HELD=1 \
    CLOUDBENCH_APP_ENV_LOCK_HELD=1 \
    CLOUDBENCH_APP_ENV_LOCK_OWNER_PID="$$" \
    CLOUDBENCH_SKIP_MACHINE_ACTIVATION=1 \
    bash scripts/run-bench-cloud --refresh-secrets; then
    echo "❌ Cloud benchmark environment refresh failed; no benchmark machine was started." >&2
    exit 1
fi

# ── Resolve the warm machine (clone source) + its volume ────────────────────
warm_json="$(FLY machines list -a "$APP" --json 2>/dev/null || echo '[]')"
warm_pair="$(printf '%s' "$warm_json" | MN="$MACHINE_NAME" python3 -c '
import json,os,sys
d=json.load(sys.stdin) or []
mn=os.environ["MN"]
for m in d:
    if m.get("name")==mn and m.get("id"):
        print(m["id"], m.get("region") or ""); break
' 2>/dev/null || true)"
WARM_ID="$(printf '%s' "$warm_pair" | awk '{print $1}')"
warm_region="$(printf '%s' "$warm_pair" | awk '{print $2}')"
[ -n "$WARM_ID" ] || { echo "❌ No warm machine '$MACHINE_NAME' in $APP — run: bash scripts/run-bench-cloud --setup" >&2; exit 1; }
WARM_IMAGE_IDENTITY="$(printf '%s' "$warm_json" | WARM_ID="$WARM_ID" python3 -c '
import json, os, sys
for machine in json.load(sys.stdin) or []:
    if machine.get("id") == os.environ["WARM_ID"]:
        print((machine.get("config") or {}).get("image") or "")
        break
' 2>/dev/null || true)"
[ -n "$WARM_IMAGE_IDENTITY" ] || { echo "❌ Could not resolve immutable warm image identity for $WARM_ID" >&2; exit 1; }
# Volume snapshots are region-scoped, so clones MUST land in the warm box's region.
[ -n "$warm_region" ] && REGION="$warm_region"
echo "🏭 warm source machine: $WARM_ID (region $REGION)"

# Clones fork the warm volume from a completed snapshot. Fly reports incremental
# stored size, not logical completeness, so a valid current snapshot can be much
# smaller than an older one. Select by lifecycle status + real creation timestamp;
# exclude the zero-byte `running` placeholder exposed while upload is in flight.
VOL_ID="$(FLY volumes list -a "$APP" --json 2>/dev/null | VN="$VOLUME_NAME" python3 -c '
import json,os,sys
try: d=json.load(sys.stdin) or []
except Exception: d=[]
vn=os.environ["VN"]
for v in d:
    if v.get("name")==vn and v.get("id"): print(v["id"]); break
' 2>/dev/null || true)"
[ -n "$VOL_ID" ] || { echo "❌ Could not find warm volume '$VOLUME_NAME' in $APP" >&2; exit 1; }
SNAP_ID="$(FLY volume snapshots list "$VOL_ID" -a "$APP" --json 2>/dev/null | python3 "$ROOT_DIR/scripts/cloudbench-select-snapshot.py" 2>/dev/null || true)"
if [ -z "$SNAP_ID" ]; then
    echo "❌ No complete snapshot for warm volume $VOL_ID. Create one and wait for it to finish:" >&2
    echo "   flyctl volume snapshots create $VOL_ID -a $APP   # then wait until STORED SIZE ≈ VOL SIZE" >&2
    exit 1
fi
echo "🧊 forking clones from complete snapshot: $SNAP_ID"

# --provision-pool: one-time pre-provision of N stopped clones, then exit.
if [ -n "$PROVISION_POOL" ]; then
    provision_pool "$PROVISION_POOL"
    provision_status=$?
    exit "$provision_status"
fi
# Normal runs migrate legacy creation records through the same provider-bound,
# fail-closed path as explicit provisioning before strict consumption checks.
upgrade_pool_provenance_volume_bindings || exit 1
validate_tracked_pool_provenance || exit 1

CODE_SUMMARY=""
print_code_provenance

# ── Per-bench worker autoscaling (prod params, scoped to the bench's queue) ──
# The box worker computes desired_machine_count off its own Temporal queue with
# prod's exact params (backlog ≥20% capacity → add ceil(backlog/capacity); 60s
# zero backlog → remove) and exposes it on HEALTH_CHECK_PORT/metrics, but never
# actuates (FLY_APP_NAME="" + AUTOSCALER_ACTUATE=0). We read that number and
# reconcile a pool of WORKER-ONLY clones bound to THIS bench's queue + backend
# (Fly 6PN) — the same shape as prod's pool, isolated per bench. Workers are torn
# down on scale-down and at fleet exit.
BOX_HEALTH_PORT="3003"     # cloudbench-run.sh HEALTH_PORT = CONDUCTOR_PORT(3001)+2
BOX_BACKEND_PORT="3001"
BOX_WMH_PORT="3007"        # run.sh WMH_PORT = base+6
FLEET_PATCH_FILE=""
if ! git -C "$ROOT_DIR" diff HEAD --quiet --binary 2>/dev/null; then
    FLEET_PATCH_FILE="$(mktemp)"; git -C "$ROOT_DIR" diff HEAD --binary > "$FLEET_PATCH_FILE"
fi

_machine_priv_ip() {  # _machine_priv_ip <machine_id>
    FLY machines list -a "$APP" --json 2>/dev/null | MID="$1" python3 -c '
import json,os,sys
try: d=json.load(sys.stdin) or []
except Exception: d=[]
mid=os.environ["MID"]
for m in d:
    if m.get("id")==mid: print(m.get("private_ip") or ""); break
' 2>/dev/null || true
}

_box_desired() {  # _box_desired <machine_id> → desired_machine_count or empty
    FLY ssh console -a "$APP" --machine "$1" -q \
        -C "bash -c \"curl -s localhost:$BOX_HEALTH_PORT/metrics 2>/dev/null | grep -E '^desired_machine_count ' | awk '{print \\\$2}'\"" 2>/dev/null \
        | tr -dc '0-9'
}

# The worker-clones id-file is the SOURCE OF TRUTH for the pool size: a machine
# is recorded the instant Fly creates it (BEFORE staging), so a slow/failed stage
# can never make the reconcile think the pool is empty and re-clone in a loop.
_pool_ids() {  # count of tracked worker machines (clean single integer)
    local f="$1/worker-clones.ids" n
    [ -f "$f" ] || { echo 0; return; }
    n="$(grep -c . "$f" 2>/dev/null)"   # grep -c always prints a number; ignore its exit code
    printf '%s' "${n:-0}" | tr -dc '0-9'
    printf '\n'
}

provision_worker() {  # provision_worker <bench> <workspace> <primary_id> <primary_ip> <sim01> <out>
    local bench="$1" ws="$2" primary_id="$3" pip="$4" sim="$5" out="$6"
    local wid
    if ! wid="$(clone_machine_target "$out/worker-clones.ids" "$primary_id")"; then
        echo "  ⚠️ [$bench] worker clone did not appear" >&2
        return 1
    fi
    echo "  ➕ [$bench] worker $wid created"
    # Stage the boot script + patch + env wrapper, then launch (best-effort;
    # counted regardless — a laggy volume just delays this worker joining).
    local wrapper; wrapper="$(mktemp)"
    {
        echo "set -e"
        echo "export REF=$(printf '%q' "$BENCH_REF")"
        echo "export WORKSPACE_NAME=$(printf '%q' "$ws")"
        echo "export PRIMARY_HOST=$(printf '%q' "$pip")"
        echo "export BACKEND_PORT=$(printf '%q' "$BOX_BACKEND_PORT")"
        echo "export WMH_PORT=$(printf '%q' "$BOX_WMH_PORT")"
        echo "export BENCH_SIMULATE=$(printf '%q' "$sim")"
        [ -n "$FLEET_PATCH_FILE" ] && echo "export LOCAL_PATCH_FILE=/tmp/cloudbench-local.patch" || echo "unset LOCAL_PATCH_FILE"
        echo "exec bash /data/cloudbench-worker.sh"
    } > "$wrapper"
    ( for _ in $(seq 1 40); do
        if machine_storage_ready "$wid"; then
            FLY machine start "$wid" -a "$APP" >/dev/null 2>&1 || true
        fi
        if FLY ssh sftp put -a "$APP" --machine "$wid" -q -m 0755 "$ROOT_DIR/scripts/cloudbench-worker.sh" /data/cloudbench-worker.sh >/dev/null 2>&1 \
           && FLY ssh sftp put -a "$APP" --machine "$wid" -q -m 0755 "$wrapper" /tmp/rbw.sh >/dev/null 2>&1; then
            [ -n "$FLEET_PATCH_FILE" ] && FLY ssh sftp put -a "$APP" --machine "$wid" -q -m 0644 "$FLEET_PATCH_FILE" /tmp/cloudbench-local.patch >/dev/null 2>&1 || true
            FLY ssh console -a "$APP" --machine "$wid" -C "bash -c \"setsid bash /tmp/rbw.sh >> /data/worker.log 2>&1 < /dev/null &\"" >/dev/null 2>&1 || true
            echo "  ✅ [$bench] worker $wid staged + launched"
            break
        fi
        sleep 3
      done; rm -f "$wrapper" 2>/dev/null || true ) &
    return 0
}

bench_autoscaler() {  # bench_autoscaler <bench> <primary_cid> <workspace> <sim01> <out>
    local bench="$1" cid="$2" ws="$3" sim="$4" out="$5"
    local pip=""; : > "$out/worker-clones.ids"
    # Wait for the box /metrics to answer (stack up) before scaling.
    for _ in $(seq 1 60); do pip="$(_machine_priv_ip "$cid")"; [ -n "$pip" ] && break; sleep 5; done
    [ -n "$pip" ] || { echo "  ⚠️ [$bench] autoscaler: no primary IP; disabled" >&2; return 0; }
    while FLY machine status "$cid" -a "$APP" >/dev/null 2>&1; do
        local desired want cur; desired="$(_box_desired "$cid")"; [ -z "$desired" ] && { sleep "$AUTOSCALE_POLL"; continue; }
        want=$((desired - 1)); [ "$want" -lt 0 ] && want=0
        [ "$want" -gt $((AUTOSCALE_MAX - 1)) ] && want=$((AUTOSCALE_MAX - 1))
        cur="$(_pool_ids "$out")"
        if [ "$want" -gt "$cur" ]; then
            local n=$((want - cur)) k
            echo "  ⤴️  [$bench] scale up +$n (desired=$desired, pool=$cur)"
            for k in $(seq 1 "$n"); do provision_worker "$bench" "$ws" "$cid" "$pip" "$sim" "$out"; done
        elif [ "$want" -lt "$cur" ]; then
            local n=$((cur - want)) k
            echo "  ⤵️  [$bench] scale down -$n (desired=$desired, pool=$cur)"
            for k in $(seq 1 "$n"); do
                local wid; wid="$(tail -1 "$out/worker-clones.ids" 2>/dev/null)"
                [ -n "$wid" ] || break
                # Only drop the id from tracking once the destroy is CONFIRMED —
                # an untracked-but-alive machine is a billed-forever zombie. On
                # failure keep it listed and retry on the next autoscaler tick.
                if ! reap_machine "$wid"; then
                    echo "  ⚠️ [$bench] failed to destroy worker $wid — kept in tracking, retrying next tick" >&2
                    break
                fi
                sed '$d' "$out/worker-clones.ids" > "$out/worker-clones.ids.tmp" 2>/dev/null && mv "$out/worker-clones.ids.tmp" "$out/worker-clones.ids" || true
            done
        fi
        sleep "$AUTOSCALE_POLL"
    done
}

# ── Clone one machine per bench + launch its isolated run ────────────────────
mkdir -p "$FLEET_DIR"
: > "$CLAIMED_POOL_FILE"
echo ""
echo "═══ run-bench-fleet — ${#BENCHES[@]} bench(es), one isolated machine each ═══"
i=0
for bench in "${BENCHES[@]}"; do
    # Default from the catalog's world_model_mode; --sim-on is an explicit override.
    mode_label="REAL"; [ "$(_catalog_wmm "$bench")" = "simulate" ] && mode_label="SIM"
    is_sim_on "$bench" && mode_label="SIM"
    mode_flag="--no-simulate"; [ "$mode_label" = "SIM" ] && mode_flag="--simulate"
    # DASH_BASE is reserved for the ONE aggregated batch dashboard; per-bench
    # viewers live above it (their /open-agent deep-links back the batch rows).
    port=$((DASH_BASE + (i + 1) * 20))
    out="$FLEET_DIR/$bench"
    rm -rf "$out" 2>/dev/null || true; mkdir -p "$out"

    echo ""
    # Prefer a pre-provisioned pool machine (skips the ~300s volume fork); fall
    # back to cloning fresh if the pool is empty/exhausted.
    cid=""
    primary_nonce=""
    primary_lease_rc=0
    primary_lease_tracked=0
    while :; do
        cid="$(claim_pool_machine)"
        pool_claim_rc=$?
        if [ "$pool_claim_rc" -ne 0 ]; then
            echo "❌ pool claim failed closed (status=$pool_claim_rc)" >&2
            exit "$pool_claim_rc"
        fi
        [ -n "$cid" ] || break
        echo "▶️  [$bench] claimed POOL candidate $cid (no fork, mode=$mode_label, dash=$port) ..."
        if primary_nonce="$(cloudbench_machine_lease_acquire "$APP" "$cid" \
            "cloudbench-primary run=$RUN_ID bench=$bench")"; then
            break
        else
            primary_lease_rc=$?
        fi
        if [ "$primary_lease_rc" -ne 75 ]; then
            echo "   ❌ platform lease request failed for pool candidate $cid" >&2
            release_pool_claim "$cid"
            exit "$primary_lease_rc"
        fi
        echo "   ⚠️ candidate primary $cid is currently leased; trying next pool machine"
        release_pool_claim "$cid"
        cid=""
    done
    if [ -z "$cid" ]; then
        echo "▶️  [$bench] pool empty → cloning fresh isolated machine (mode=$mode_label, dash=$port) ..."
        if ! cid="$(clone_machine_target "$OWNED_CLONES_FILE")"; then
            echo "   ❌ clone failed for $bench; aborting the incomplete fleet" >&2
            exit 1
        fi
    fi
    if [ -n "$primary_nonce" ]; then
        track_primary_lease "$cid" "$primary_nonce"
        primary_lease_tracked=1
    fi
    case " ${CHILD_MACHINE[*]:-} " in
        *" $cid "*) echo "❌ isolation violation: machine $cid was allocated twice" >&2; exit 1 ;;
    esac
    # Snapshot forks are documented above as taking about 300s; allow twice
    # that envelope for Fly to leave the transient `created` state.
    if ! cloudbench_wait_machine_startable fleet_machine_state "$cid" 300 2; then
        echo "   ❌ machine=$cid never became startable; aborting the incomplete fleet" >&2
        exit 1
    fi
    if [ -z "$primary_nonce" ]; then
        primary_nonce="$(cloudbench_machine_lease_acquire_retry "$APP" "$cid" \
            "cloudbench-primary run=$RUN_ID bench=$bench" \
            "${CLOUDBENCH_PRIMARY_LEASE_ATTEMPTS:-45}" \
            "${CLOUDBENCH_PRIMARY_LEASE_RETRY_DELAY:-2}")"
    fi
    if [ -z "$primary_nonce" ]; then
        echo "   ❌ could not acquire platform lease for primary $cid; aborting the incomplete fleet" >&2
        exit 1
    fi
    if [ "$primary_lease_tracked" != 1 ]; then
        track_primary_lease "$cid" "$primary_nonce"
        primary_lease_tracked=1
    fi
    echo "   🔐 activating staged environment on leased primary $cid ..."
    if ! cloudbench_activate_machine_environment_with_lease "$APP" "$cid" "$primary_nonce"; then
        echo "   ❌ could not activate environment on leased primary $cid; aborting the incomplete fleet" >&2
        exit 1
    fi
    if ! cloudbench_machine_start_with_lease "$APP" "$cid" "$primary_nonce"; then
        echo "   ❌ could not start leased primary $cid; aborting the incomplete fleet" >&2
        exit 1
    fi
    echo "   ✅ machine=$cid → leased + launching run-bench-cloud (isolated) ..."

    # Deterministic per-bench workspace → deterministic Temporal queue, so the
    # autoscaler knows which queue its worker pool must poll.
    local_ws="$(cloudbench_fleet_workspace_name "$bench" "$$" "$i")" || exit 1
    (
        CLOUDBENCH_WORKSPACE_NAME="$local_ws" \
        CLOUDBENCH_ENV_REFRESHED=1 \
        CLOUDBENCH_START_BARRIER="$([ "$SYNCHRONIZED_START" = "1" ] && printf '%s' "$RUN_ID")" \
        CLOUDBENCH_START_BARRIER_WAIT_SECONDS="$START_BARRIER_WAIT_SECONDS" \
        NO_OPEN=1 \
        bash scripts/run-bench-cloud "$bench" \
            --machine "$cid" \
            --out-dir "$out" \
            --dash-port "$port" \
            --no-lock \
            --no-open \
            "$mode_flag" \
            --ref "$BENCH_REF" \
            --timeout "$CHILD_RUN_TIMEOUT"
    ) > "$out/fleet-child.log" 2>&1 &
    CHILD_PIDS+=("$!")
    CHILD_OUT+=("$out")
    CHILD_BENCH+=("$bench")
    CHILD_MODE+=("$mode_label")
    CHILD_PORT+=("$port")
    CHILD_MACHINE+=("$cid")

    if [ "$AUTOSCALE" = "1" ]; then
        local_sim=0; [ "$mode_label" = "SIM" ] && local_sim=1
        echo "   ⚖️  [$bench] per-bench autoscaler ON (prod params, max=$AUTOSCALE_MAX, queue=navi-agent-tasks-$local_ws)"
        ( bench_autoscaler "$bench" "$cid" "$local_ws" "$local_sim" "$out" ) >> "$out/autoscaler.log" 2>&1 &
        AUTOSCALER_PIDS+=("$!")
    fi
    i=$((i + 1))
done

# Every primary now has an immutable environment-bearing source (owned pool VM
# or fresh warm clone). Other worktrees may safely stage their environment.
[ "${#CHILD_PIDS[@]}" -eq "${#BENCHES[@]}" ] || {
    echo "❌ incomplete fleet launch: ${#CHILD_PIDS[@]}/${#BENCHES[@]} requested benches received runners" >&2
    exit 1
}
release_app_environment_lock

echo ""
echo "⏳ ${#CHILD_PIDS[@]} isolated bench machine(s) running."

# ── ONE aggregated batch dashboard (served; never auto-opens a browser) ─────
# Merge every bench's live report-card.json into a single card (N per_task rows,
# summed cost + tokens) and serve it on DASH_BASE. Each row's agent_url already
# points at its own bench's /open-agent (localhost:<bench-port>), so clicking
# "open" from the batch view routes to the right isolated machine's viewer.
UNIFIED_DIR="$FLEET_DIR/_batch"
rm -rf "$UNIFIED_DIR" 2>/dev/null || true; mkdir -p "$UNIFIED_DIR"
printf '%s' "${CODE_SUMMARY:-}" > "$UNIFIED_DIR/code.txt"   # shown in the dashboard header
cp -f "$ROOT_DIR/agents/benchmarks/dashboard.html" "$UNIFIED_DIR/dashboard.html" 2>/dev/null || true
# NOTE: never kill whatever holds DASH_BASE — that is the ONE persistent central
# hub, shared across every run + carrying the user's open tab. It picks up this
# new run dir on its next scan. We (re)start it below ONLY if it isn't already up.
# Manifest of EVERY bench in the batch — the dashboard always renders all N rows
# (queued → running → done), never a subset while some machines are still booting.
{
    printf '['
    for j in "${!CHILD_BENCH[@]}"; do
        [ "$j" -gt 0 ] && printf ','
        printf '{"name":"%s","mode":"%s","port":%s}' "${CHILD_BENCH[$j]}" "${CHILD_MODE[$j]}" "${CHILD_PORT[$j]}"
    done
    printf ']'
} > "$UNIFIED_DIR/benches.json"
(
    while :; do
        FLEET_DIR="$FLEET_DIR" UNIFIED_DIR="$UNIFIED_DIR" DASH_BASE="$DASH_BASE" python3 - "$UNIFIED_DIR/report-card.json" <<'PY' 2>/dev/null || true
import json, os, sys
from pathlib import Path
from urllib.parse import parse_qs, urlparse
out = sys.argv[1]; fleet = os.environ["FLEET_DIR"]; dash_base = os.environ.get("DASH_BASE", "8765")
# Startup-phase tracker (stdlib-only) → per-row step timeline while queued.
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(fleet)), "agents"))
try:
    from benchmarks.fleet_startup_phase import startup_state
except Exception:
    startup_state = None
benches = json.load(open(os.path.join(os.environ["UNIFIED_DIR"], "benches.json")))
per_task = []
ci = {"agents_llm_usd": 0.0, "wmh_grounding_usd": 0.0, "infra_usd": 0.0, "total_usd": 0.0}
mi = {"tokens_in": 0, "tokens_out": 0}
modes, elapsed = set(), 0.0
for b in benches:
    name = b["name"]; default_mode = "simulate" if b.get("mode") == "SIM" else "real"
    card = None
    try: card = json.load(open(os.path.join(fleet, name, "cloudbench-live", "report-card.json")))
    except Exception: card = None
    row = None
    if card:
        rows = card.get("per_task") or []
        row = next((r for r in rows if r.get("name") == name), rows[0] if rows else None)
    if row is None:   # seed a queued placeholder so ALL N benches always show
        row = {"name": name, "status": "queued", "duration_s": None, "cost_usd": None,
               "agent_url": None, "tokens_in": 0, "tokens_out": 0,
               "world_model_mode": default_mode, "infra_usd": None}
    row.setdefault("world_model_mode", default_mode)
    # Route "open" through the DURABLE batch resolver (DASH_BASE) — never the
    # per-bench port that dies with the run. The resolver serves from local run
    # data, so the link can't go dead.
    url = row.get("agent_url")
    if url:
        try:
            aid = (parse_qs(urlparse(url).query).get("agent-id") or [""])[0]
        except Exception:
            aid = ""
        if aid:
            row["agent_url"] = f"http://localhost:{dash_base}/open-agent?agent-id={aid}"
    # While queued (before the on-box run_benchmark emits a card), surface the
    # concrete startup step + expected/elapsed so the dashboard shows progress.
    if row.get("status") == "queued" and startup_state is not None:
        try:
            row["startup"] = startup_state(
                Path(fleet) / name / "fleet-child.log",
                Path(fleet) / name / ".startup-state.json",
            )
        except Exception:
            pass
    per_task.append(row)
    if card:
        cost = card.get("cost") or {}
        for k in ci:
            v = cost.get(k)
            if isinstance(v, (int, float)): ci[k] += v
        md = card.get("metadata") or {}
        mi["tokens_in"] += int(md.get("tokens_in") or 0); mi["tokens_out"] += int(md.get("tokens_out") or 0)
        elapsed = max(elapsed, float(card.get("elapsed_s") or 0))
    if row.get("world_model_mode"): modes.add(row["world_model_mode"])
st = lambda s: sum(1 for t in per_task if t.get("status") == s)
passed, failed = st("passed"), st("failed") + st("error")
running = sum(1 for t in per_task if t.get("status") == "running")
queued = sum(1 for t in per_task if t.get("status") == "queued")
try:
    code_summary = open(os.path.join(os.environ["UNIFIED_DIR"], "code.txt")).read().strip()
except Exception:
    code_summary = ""
card = {
    "run_id": "batch",
    "code": code_summary,
    "elapsed_s": elapsed,
    "world_model_mode": (list(modes)[0] if len(modes) == 1 else "mixed") if modes else "real",
    "tasks": {"total": len(benches), "running": running, "completed": passed + failed, "queued": queued},
    "results": {"passed": passed, "failed": failed, "transient": st("transient"),
                "success_rate": round(passed / max(1, passed + failed), 3)},
    "cost": {**{k: round(v, 4) for k, v in ci.items()}, "fast_cache_hit_rate": None},
    "metadata": mi,
    "infra": None,
    "per_task": per_task,
}
with open(out, "w") as f: json.dump(card, f); f.write("\n")
PY
        sleep 1
    done
) & UNIFIED_AGG_PID=$!
# The CENTRAL HUB is the durable open-agent resolver (agent_link_server --hub):
# ONE persistent server over the runs-root that serves a run-index at /, each
# run's dashboard at /run/<id>/, and resolves any agent from any run's local data
# on demand. It PERSISTS across runs + past fleet exit (see cleanup), so it is the
# single dashboard, "open" is never a dead link, and we never clutter the screen
# with a new window per run. Start it ONLY if it isn't already up.
mkdir -p "$HUB_CTX_DIR"
HUB_URL="http://localhost:$DASH_BASE/"
RUN_URL="http://localhost:$DASH_BASE/run/$RUN_ID/dashboard.html"
HUB_WAS_UP=0
if curl -fsS "$HUB_URL" 2>/dev/null | grep -q "Benchmark runs"; then
    HUB_WAS_UP=1
    echo "📊 reusing the central hub already open on :$DASH_BASE (no new window)"
else
    for pp in $(lsof -tiTCP:"$DASH_BASE" -sTCP:LISTEN 2>/dev/null || true); do kill "$pp" 2>/dev/null || true; done
    python3 "$ROOT_DIR/agents/benchmarks/agent_link_server.py" \
        --root "$RUNS_ROOT" --host 127.0.0.1 --port "$DASH_BASE" \
        --repo-root "$ROOT_DIR" --context-dir "$HUB_CTX_DIR" \
        --frontend-dir "$ROOT_DIR/front-end" --hub-runs-dir "$RUNS_ROOT" \
        --preferred-archive-port "$((DASH_BASE + 200))" \
        > "$HUB_CTX_DIR/hub.log" 2>&1 & UNIFIED_DASH_PID=$!
    printf '%s\n' "$UNIFIED_DASH_PID" > "$HUB_CTX_DIR/agent-link-server.pid"
    for _ in $(seq 1 20); do curl -fsS "$HUB_URL" >/dev/null 2>&1 && break; sleep 1; done
fi
if [ "$HUB_WAS_UP" = "0" ]; then
    echo "📊 central hub: $HUB_URL (in-app: Benchmarks tab)"
fi
echo "   this run: $RUN_URL"
echo "   per-bench viewers: $(for j in "${!CHILD_PORT[@]}"; do printf '%s→:%s ' "${CHILD_BENCH[$j]}" "${CHILD_PORT[$j]}"; done)"
echo ""

# A fleet run means simultaneous benchmark execution, not merely concurrent
# provisioning. Each on-box driver announces after its isolated stack is
# healthy; only then do we touch every machine's release file in parallel.
release_start_barrier() {
    [ "$SYNCHRONIZED_START" = "1" ] || return 0
    local expected="${#CHILD_PIDS[@]}" ready deadline now out p mid
    deadline=$(( $(date +%s) + START_BARRIER_WAIT_SECONDS ))
    echo "⏸️  waiting for $expected isolated stacks at synchronized start barrier..."
    while :; do
        ready=0
        for out in "${CHILD_OUT[@]}"; do
            grep -aFq "synchronized start barrier ready: $RUN_ID" "$out/fleet-child.log" 2>/dev/null && ready=$((ready + 1))
        done
        [ "$ready" = "$expected" ] && break
        for p in "${CHILD_PIDS[@]}"; do
            if ! kill -0 "$p" 2>/dev/null; then
                echo "❌ isolated runner exited before synchronized start barrier ($ready/$expected ready)" >&2
                return 1
            fi
        done
        now="$(date +%s)"
        if [ "$now" -ge "$deadline" ]; then
            echo "❌ synchronized start barrier timed out ($ready/$expected ready)" >&2
            return 1
        fi
        sleep 2
    done
    echo "✅ all $expected isolated stacks reached the synchronized start barrier"
    echo "🚦 releasing synchronized start barrier on all machines..."
    local release_pids=()
    for mid in "${CHILD_MACHINE[@]}"; do
        ( FLY ssh console -a "$APP" --machine "$mid" -q \
            -C "touch '/data/cloudbench-start-$RUN_ID.release'" >/dev/null 2>&1 ) &
        release_pids+=("$!")
    done
    for p in "${release_pids[@]}"; do
        wait "$p" || { echo "❌ failed to release synchronized start barrier" >&2; return 1; }
    done
}

if ! release_start_barrier; then
    exit 1
fi

# ── Wait for all children, then aggregate ────────────────────────────────────
for p in "${CHILD_PIDS[@]}"; do wait "$p" 2>/dev/null || true; done
# One final merge so the batch dashboard reflects terminal results, then stop the aggregator.
kill "$UNIFIED_AGG_PID" 2>/dev/null || true
python3 "$ROOT_DIR/scripts/cloudbench-aggregate-runs.py" "$FLEET_DIR" "$UNIFIED_DIR/run.json"

echo ""
echo "════════════════════ FLEET SUMMARY ════════════════════"
FLEET_PASS=0; FLEET_TOTAL=0
for j in "${!CHILD_BENCH[@]}"; do
    bench="${CHILD_BENCH[$j]}"; out="${CHILD_OUT[$j]}"; mode="${CHILD_MODE[$j]}"
    line="$(RUN_JSON_PATH="$out/cloudbench-run.json" python3 -c '
import json,os
p=os.environ["RUN_JSON_PATH"]
try:
    r=json.load(open(p)); tasks=r.get("tasks",[])
    t=tasks[0] if tasks else {}
    passed=bool(t.get("passed"))
    aid=t.get("agent_id") or ""
    dur=t.get("duration_seconds")
    print(("PASS" if passed else "FAIL"), aid, ("" if dur is None else round(float(dur),1)))
except Exception as e:
    print("NORESULT", "", "")
' 2>/dev/null || echo "NORESULT  ")"
    status="$(printf '%s' "$line" | awk '{print $1}')"
    aid="$(printf '%s' "$line" | awk '{print $2}')"
    FLEET_TOTAL=$((FLEET_TOTAL + 1))
    [ "$status" = "PASS" ] && FLEET_PASS=$((FLEET_PASS + 1))
    icon="❌"; [ "$status" = "PASS" ] && icon="✅"; [ "$status" = "NORESULT" ] && icon="⚠️ "
    printf '  %s %-38s %-4s %-9s' "$icon" "$bench" "$mode" "$status"
    [ -n "$aid" ] && printf '  agent=%s' "$aid"
    printf '\n'
done
echo "  ────────────────────────────────────────────────────"
echo "  $FLEET_PASS/$FLEET_TOTAL passed"
echo "════════════════════════════════════════════════════════"
[ "$FLEET_PASS" = "$FLEET_TOTAL" ]
