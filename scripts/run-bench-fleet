_box_desired() {  # _box_desired <local-metrics-url> → desired_machine_count or empty
    curl --noproxy '*' -fsS --max-time 3 "$1/metrics" 2>/dev/null \
        | awk '/^desired_machine_count / {print $2; exit}' \
        | tr -dc '0-9'
}

claim_autoscaler_metrics_port() {  # <output-variable> <owner-pid> <owner-token>
    local output_var="$1" owner_pid="$2" owner_token="$3"
    local root port
    root="${AUTOSCALER_PORT_LEASE_ROOT:-${TMPDIR:-/tmp}/rose-cloudbench-autoscaler-port-leases}"
    port="$(python3 "$AUTOSCALER_PORT_LEASE_HELPER" claim \
        --root "$root" --owner-pid "$owner_pid" --token "$owner_token" \
        --start "${CLOUDBENCH_AUTOSCALER_PORT_START:-0}")" || return 1
    case "$port" in ''|*[!0-9]*) return 1 ;; esac
    printf -v "$output_var" '%s' "$port"
}

release_autoscaler_metrics_port() {  # <port> <owner-pid> <owner-token>
    local port="$1" owner_pid="$2" owner_token="$3" root
    [ -n "$port" ] || return 0
    root="${AUTOSCALER_PORT_LEASE_ROOT:-${TMPDIR:-/tmp}/rose-cloudbench-autoscaler-port-leases}"
    python3 "$AUTOSCALER_PORT_LEASE_HELPER" release \
        --root "$root" --owner-pid "$owner_pid" --token "$owner_token" \
        --port "$port"
}

release_autoscaler_metrics_owner() {  # <owner-pid> <owner-token>
    local owner_pid="$1" owner_token="$2" root
    root="${AUTOSCALER_PORT_LEASE_ROOT:-${TMPDIR:-/tmp}/rose-cloudbench-autoscaler-port-leases}"
    python3 "$AUTOSCALER_PORT_LEASE_HELPER" release-owner \
        --root "$root" --owner-pid "$owner_pid" --token "$owner_token"
}

# `kill -0` alone is not a sufficient liveness check for these background jobs:
# a just-exited child's PID can be reused by one of the controller's frequent
# short-lived probes before the liveness check. `jobs -pr` tracks the shell job
# identity, not merely the numeric PID, so only the actual proxy/autoscaler can
# satisfy the mandatory-autoscaling health gate.
fleet_job_running() {  # fleet_job_running <pid>
    local pid="${1:-}"
    case "$pid" in
        ''|*[!0-9]*) return 1 ;;
    esac
    jobs -pr | grep -qx "$pid"
}

# Waiting may over-wait but must never stop early. Under a heavily loaded
# controller `jobs -pr` has omitted a live autoscaler, ending finalization
# before it published autoscaler.completed-after-child; the later acceptance
# check then found it running without the marker. A waiter therefore also
# keeps waiting while the PID is alive. A reused PID can only extend the wait to
# its deadline; it never satisfies acceptance, which still uses fleet_job_running.
fleet_job_may_be_running() {  # fleet_job_may_be_running <pid>
    local pid="${1:-}"
    fleet_job_running "$pid" && return 0
    case "$pid" in
        ''|*[!0-9]*) return 1 ;;
    esac
    kill -0 "$pid" 2>/dev/null
}

# Poll every mandatory autoscaler until each has a terminal outcome (completion
# marker or failure file) or has exited, bounded by the finalization deadline.
wait_for_autoscaler_finalization() {
    local deadline=$((SECONDS + AUTOSCALER_FINALIZATION_WAIT_SECONDS))
    local finalizing j out
    while :; do
        finalizing=0
        for j in "${!AUTOSCALER_PIDS[@]}"; do
            out="${CHILD_OUT[$j]}"
            [ -s "$out/autoscaler.failed" ] && continue
            [ -e "$out/autoscaler.completed-after-child" ] && continue
            if fleet_job_may_be_running "${AUTOSCALER_PIDS[$j]}"; then
                finalizing=$((finalizing + 1))
            fi
        done
        [ "$finalizing" -eq 0 ] && return 0
        [ "$SECONDS" -ge "$deadline" ] && return 0
        sleep 0.2
    done
}

terminate_fleet_runner_group() {  # <runner-pgid> <HUP|INT|TERM>
    local runner_pid="$1" signal_name="$2" grace deadline residual_deadline
    local kill_deadline leader_state next_zombie_check
    grace="${CLOUDBENCH_RUNNER_TERM_SECONDS:-15}"
    case "$grace" in ''|*[!0-9]*) grace=15 ;; esac
    # Stay strictly inside cleanup's 30s supervisor ceiling, leaving time for
    # the residual-group grace, SIGKILL propagation, reaping, and marker
    # publication (at most 20 + 3 + 3 seconds).
    [ "$grace" -le 20 ] || grace=20
    deadline=$((SECONDS + grace))

    # Signal the runner itself before its process group. The runner's EXIT
    # cleanup and this controller's guest-shutdown confirmation both deliver
    # the authenticated guest /shutdown through data-plane proxies that live
    # in this same group. A group-wide signal killed those proxies at the same
    # instant, so a campaign's os.killpg, a terminal Ctrl-C or a detached
    # waiter's group TERM left both requests with HTTP 000 and the guest kept
    # executing until its own backstop. Residual members (proxies, sleeps) are
    # signalled only after the runner has exited or its grace has expired.
    #
    # The runner is started from this asynchronous subshell of a non-interactive
    # shell, so it (and its proxies) inherit SIGINT ignored and its INT trap can
    # never run. Deliver every forwarded cancellation (a campaign's TERM, a
    # terminal Ctrl-C's INT or a HUP) to the runner and residual members as
    # TERM, which the runner traps; the caller keeps the original signal for
    # its own exit status.
    kill -TERM "$runner_pid" 2>/dev/null || true
    next_zombie_check=$((SECONDS + 1))
    while [ "$SECONDS" -lt "$deadline" ]; do
        # A builtin liveness check each tick. The runner is this shell's own
        # child and normally reaped at once; a once-per-second ps check covers
        # an unreaped zombie. A failed ps read (for example fork pressure) is
        # not evidence of exit, so it never ends the grace early.
        kill -0 "$runner_pid" 2>/dev/null || break
        if [ "$SECONDS" -ge "$next_zombie_check" ]; then
            next_zombie_check=$((SECONDS + 1))
            if leader_state="$(ps -o stat= -p "$runner_pid" 2>/dev/null)"; then
                case "$leader_state" in ''|*Z*) break ;; esac
            fi
        fi
        sleep 0.1
    done
    if kill -0 -- "-$runner_pid" 2>/dev/null; then
        kill -TERM -- "-$runner_pid" 2>/dev/null || true
        residual_deadline=$((SECONDS + 3))
        [ "$deadline" -le "$residual_deadline" ] || residual_deadline="$deadline"
        while kill -0 -- "-$runner_pid" 2>/dev/null; do
            [ "$SECONDS" -lt "$residual_deadline" ] || break
            sleep 0.1
        done
    fi
    if kill -0 -- "-$runner_pid" 2>/dev/null; then
        kill -KILL -- "-$runner_pid" 2>/dev/null \
            || kill -KILL "$runner_pid" 2>/dev/null \
            || true
    fi
    wait "$runner_pid" 2>/dev/null || true

    # Include descendants in the proof: the direct runner can be reaped while
    # one of its former proxies remains briefly visible in the process group.
    kill_deadline=$((SECONDS + 3))
    while kill -0 -- "-$runner_pid" 2>/dev/null; do
        [ "$SECONDS" -lt "$kill_deadline" ] || break
        sleep 0.1
    done
    if kill -0 -- "-$runner_pid" 2>/dev/null; then
        echo "❌ runner process group $runner_pid survived bounded teardown" >&2
        return 1
    fi
    return 0
}

run_fleet_child_supervised() {  # <finished-marker> <command> [args...]
    local finished_marker="$1" runner_pid="" runner_rc=125 marker_tmp
    local forwarded_signal_name="" forwarded_signal_rc="" runner_cleanup_failed=0
    shift

    # The asynchronous Bash function is the PID tracked by CHILD_PIDS. Its
    # command is a distinct process, so terminating only the function subshell
    # reparents run-bench-cloud to PID 1. Forward controller teardown signals
    # and wait for run-bench-cloud's own EXIT cleanup before declaring that the
    # child finished.
    trap 'trap "" HUP INT TERM; forwarded_signal_name=HUP; forwarded_signal_rc=129; [ -z "$runner_pid" ] || terminate_fleet_runner_group "$runner_pid" HUP || runner_cleanup_failed=1' HUP
    trap 'trap "" HUP INT TERM; forwarded_signal_name=INT; forwarded_signal_rc=130; [ -z "$runner_pid" ] || terminate_fleet_runner_group "$runner_pid" INT || runner_cleanup_failed=1' INT
    trap 'trap "" HUP INT TERM; forwarded_signal_name=TERM; forwarded_signal_rc=143; [ -z "$runner_pid" ] || terminate_fleet_runner_group "$runner_pid" TERM || runner_cleanup_failed=1' TERM

    # Start the runner as a dedicated session/process-group leader. Python is
    # already a fleet prerequisite and os.setsid avoids Bash's asynchronous
    # job-control edge cases (which can bypass a subshell's signal traps).
    # The runner outlives the controller's session on abrupt termination. It
    # must not retain the controller's flock descriptor and prevent the exact
    # recovery entrypoint from acquiring that dead controller's workspace lock.
    python3 -c 'import os, sys; os.closerange(3, os.sysconf("SC_OPEN_MAX")); os.setsid(); os.execvp(sys.argv[1], sys.argv[1:])' "$@" &
    runner_pid=$!
    if [ -n "$forwarded_signal_name" ]; then
        # A signal can arrive after traps are armed but before `$!` is assigned.
        # Replay it now instead of launching an untracked runner after teardown.
        terminate_fleet_runner_group "$runner_pid" "$forwarded_signal_name" \
            || runner_cleanup_failed=1
        runner_rc="$forwarded_signal_rc"
    else
        wait "$runner_pid"
        runner_rc=$?
        [ -z "$forwarded_signal_rc" ] || runner_rc="$forwarded_signal_rc"
        # Normal runner exit should execute its own cleanup. Prove no process in
        # the isolated group survived before publishing the finished marker.
        if kill -0 -- "-$runner_pid" 2>/dev/null; then
            terminate_fleet_runner_group "$runner_pid" TERM \
                || runner_cleanup_failed=1
        fi
    fi
    runner_pid=""
    [ "$runner_cleanup_failed" -eq 0 ] || runner_rc=125

    marker_tmp="$finished_marker.tmp.$$"
    if ! printf '%s\n' "$runner_rc" > "$marker_tmp"; then
        return 125
    fi
    if ! mv "$marker_tmp" "$finished_marker"; then
        rm -f "$marker_tmp" 2>/dev/null || true
        return 125
    fi
    if [ -z "$forwarded_signal_name" ] && [ "${FLEET_NATIVE_REAP_ENABLED:-0}" = 1 ]; then
        fleet_retire_sealed_primary "${finished_marker%/*}" \
            || echo "⚠️ early primary retirement retained exact ownership for the final fleet sweep" >&2
    fi
    trap - HUP INT TERM
    [ -z "$forwarded_signal_rc" ] || runner_rc="$forwarded_signal_rc"
    return "$runner_rc"
}

mandatory_autoscaler_process_acceptable() {  # <bench-output-dir> <autoscaler-pid>
    local out="$1" pid="$2"
    fleet_job_running "$pid" && return 0
    # A child-finished marker is independent and can arrive after an autoscaler
    # silently died. Only the marker published BY the autoscaler after it
    # observed child completion proves that its exit was causally clean.
    [ -e "$out/autoscaler.completed-after-child" ]
}

# The worker-clones id-file is the SOURCE OF TRUTH for the pool size: a machine
# is recorded the instant Fly creates it (BEFORE staging), so a slow/failed stage
# can never make the reconcile think the pool is empty and re-clone in a loop.
explicit_worker_helper() {  # <proof>; metadata routing only, full validator still mandatory
    python3 - "${CLOUDBENCH_SCRIPT_SNAPSHOT:-$ROOT_DIR/scripts}" "$1" <<'PYWORKERHELPER'
import json,runpy,sys
from pathlib import Path
p=Path(sys.argv[1]);h=runpy.run_path(str(p/'cloudbench-explicit-idle-admission.py'))
proof=json.loads(h['read'](sys.argv[2]));a=h['described'](proof['explicit_idle']['admission'])
if a['schema']=='cloudbench-fixed-native-worker-admission-v1':
 assert a['resource']['machine_id']=='86549d6aed9358'
 print(p/'cloudbench-fixed-native-worker.py')
else:
 assert a['schema']==h['SCHEMA']
 print(p/'cloudbench-explicit-idle-admission.py')
PYWORKERHELPER
}

claim_explicit_idle_worker() {  # shared primary/worker pool, one exclusive MID claim
    local out="$1" primary="$2" workspace="$3" token="$4" pip="$5"
    local id proof volume digest attempt claim_owner current_owner="${FLEET_OWNER_TOKEN:-}"
    local FLEET_OWNER_TOKEN helper="${CLOUDBENCH_SCRIPT_SNAPSHOT:-$ROOT_DIR/scripts}/cloudbench-explicit-idle-admission.py"
    [ -n "$current_owner" ] && [ -n "${CURRENT_NODE_FP:-}" ] && [ -n "${CURRENT_PY_FP:-}" ] || return 1
    [ "${POOL_COLD_BOOTSTRAP:-0}" = 1 ] && [ -s "${POOL_IDS_FILE:-}" ] || return 0
    while IFS= read -r id; do
        case "$id" in ''|*[!0-9a-f]*) continue ;; esac
        [ "$id" != "${WARM_ID:-}" ] && [ "$id" != "${SHARED_WARM_ID:-}" ] || continue
        [ ! -e "$out/worker-runtime-evidence/$id" ] && [ ! -e "$out/worker-borrowed/$id.json" ] || continue
        [ ! -e "$POOL_CLAIMS_DIR/$id" ] && [ ! -L "$POOL_CLAIMS_DIR/$id" ] || continue
        proof="$GIT_COMMON_DIR/cloudbench-pool-reuse/$id.json"
        [ -f "$proof" ] || continue
        volume="$(python3 - "$proof" <<'PY'
import json,sys
p=json.load(open(sys.argv[1]));assert 'explicit_idle' in p and 'worker' in p['explicit_idle']['allowed_future_roles']
print(p['volume_id'])
PY
)" || continue
        if [ "${CLOUDBENCH_BOOT_TRANSPORT:-update}" = staged ]; then
            python3 "${CLOUDBENCH_SCRIPT_SNAPSHOT:-$ROOT_DIR/scripts}/cloudbench-staged-boot-return.py" worker-shape \
                --proof "$proof" --size "$FLEET_WORKER_VM_SIZE" --memory "$FLEET_WORKER_VM_MEMORY" || continue
        fi
        mkdir -p "$out/worker-borrowed" || return 1
        claim_owner="$(python3 -c 'import secrets;print(secrets.token_hex(16))')" || return 1
        FLEET_OWNER_TOKEN="$claim_owner"
        write_pool_claim "$POOL_CLAIMS_DIR/$id" "$id" "$volume" || continue
        digest="$(cloudbench_env_sha256 "$POOL_CLAIMS_DIR/$id")" || return 1
        attempt="$(mktemp -d "$out/worker-borrowed/.admit-$id.XXXXXX")" || return 1
        python3 - "$helper" "$out/worker-borrowed/$id.json" "$proof" "$digest" "$primary" "$workspace" "$token" "$attempt" "$current_owner" "$POOL_IDS_FILE" "$pip" "$claim_owner" "$volume" <<'PY' || return 1
import json,os,runpy,sys
from pathlib import Path
helper,path,proof,digest,primary,workspace,token,attempt,owner,ledger,pip,claim_owner,volume=sys.argv[1:]
h=runpy.run_path(helper);state=Path(proof).parent.parent/'cloudbench-explicit-idle'/(Path(path).stem+'.state.json')
row=dict(version=1,origin=h['ORIGIN'],historical_task_credit=0,role='borrowed-worker',machine_id=Path(path).stem,volume_id=volume,proof=proof,
 claim_sha256=digest,primary_machine_id=primary,workspace=workspace,run_token=token,admission=attempt,
 fleet_owner_token=owner,claim_owner_token=claim_owner,ledger=ledger,primary_host=pip,
 previous_state_sha256=h['sha'](h['read'](state)) if state.exists() else None)
h['sibling']('cloudbench-startup-failure-archive.py')['durable_handoff_json'](Path(path),row)
PY
        # A failure retains the exact claim and attempt: never try another POST/MID.
        if ! python3 "${CLOUDBENCH_SCRIPT_SNAPSHOT:-$ROOT_DIR/scripts}/cloudbench-staged-boot-return.py" worker-stage --assignment "$out/worker-borrowed/$id.json" \
            --source "$BENCH_REF" --node "$CURRENT_NODE_FP" --python "$CURRENT_PY_FP" \
            --size "$FLEET_WORKER_VM_SIZE" --memory "$FLEET_WORKER_VM_MEMORY" --app "$APP" > "$attempt/verified"; then
            pool_claim_mark_cleanup_unconfirmed "$POOL_CLAIMS_DIR/$id" || true
            return 1
        fi
        worker_ledger_lock_acquire "$out" || return 1
        printf '%s\n' "$id" >> "$out/worker-clones.ids" || { worker_ledger_lock_release "$out"; return 1; }
        worker_ledger_lock_release "$out" || return 1
        printf '%s' "$id"; return 0
    done < "$POOL_IDS_FILE"
}

claim_reusable_worker() {  # <out> <primary> <workspace> <run-token> <primary-6pn>
    local out="$1" primary="$2" workspace="$3" token="$4" pip="$5" ledger id proof volume digest attempt
    local current_owner="${FLEET_OWNER_TOKEN:-}" claim_owner explicit_id
    explicit_id="$(claim_explicit_idle_worker "$@")" || return 1
    if [ -n "$explicit_id" ]; then printf '%s' "$explicit_id"; return 0; fi
    local FLEET_OWNER_TOKEN
    local helper="${CLOUDBENCH_SCRIPT_SNAPSHOT:-$ROOT_DIR/scripts}/cloudbench-worker-reuse.py"
    [ -n "${GIT_COMMON_DIR:-}" ] && [ -d "$GIT_COMMON_DIR/cloudbench-worker-pools" ] || return 0
    [ -n "$current_owner" ] || return 1
    [ -n "${CURRENT_NODE_FP:-}" ] && [ -n "${CURRENT_PY_FP:-}" ] || return 1
    local POOL_IDS_FILE POOL_META_FILE
    for ledger in "$GIT_COMMON_DIR"/cloudbench-worker-pools/*.ids; do
        [ -f "$ledger" ] || continue
        POOL_IDS_FILE="$ledger"; POOL_META_FILE="$ledger.deps"
        while IFS= read -r id; do
            case "$id" in ''|*[!0-9a-f]*) continue ;; esac
            [ "$id" != "${WARM_ID:-}" ] && [ "$id" != "${SHARED_WARM_ID:-}" ] || continue
            [ ! -e "$out/worker-runtime-evidence/$id" ] || continue
            [ ! -e "$POOL_CLAIMS_DIR/$id" ] && [ ! -L "$POOL_CLAIMS_DIR/$id" ] || continue
            proof="$GIT_COMMON_DIR/cloudbench-worker-reuse/proofs/$id.json"
            [ -f "$proof" ] || continue
            volume="$(python3 - "$proof" <<'PY'
import json,sys
print(json.load(open(sys.argv[1]))['volume_id'])
PY
)" || continue
            mkdir -p "$POOL_CLAIMS_DIR" "$out/worker-borrowed" || return 1
            # The same controller can lease this worker for another primary.
            # Give each claim its own owner token to prevent same-owner ABA.
            claim_owner="$(python3 -c 'import secrets;print(secrets.token_hex(16))')" || return 1
            FLEET_OWNER_TOKEN="$claim_owner"
            write_pool_claim "$POOL_CLAIMS_DIR/$id" "$id" "$volume" || continue
            digest="$(cloudbench_env_sha256 "$POOL_CLAIMS_DIR/$id")" || return 1
            attempt="$(mktemp -d "$out/worker-borrowed/.admit-$id.XXXXXX")" || return 1
            if ! fleet_preconfig_native_read "$id" "$attempt/before.json" \
                || ! fleet_preconfig_native_read "$id" "$attempt/after.json" \
                || ! fleet_cold_handoff_volume_read "$volume" "$attempt/volume.json" \
                || ! python3 "$helper" "$proof" --target "$POOL_META_FILE" \
                    --before "$attempt/before.json" --after "$attempt/after.json" --volume "$attempt/volume.json" \
                    --source "$BENCH_REF" --node "$CURRENT_NODE_FP" --python "$CURRENT_PY_FP" \
                    --size "$FLEET_WORKER_VM_SIZE" --memory "$FLEET_WORKER_VM_MEMORY" --app "$APP" > "$attempt/verified"; then
                pool_claim_mark_cleanup_unconfirmed "$POOL_CLAIMS_DIR/$id" || true
                # Acquired ownership is unresolved, not an empty capacity pool.
                return 1
            fi
            python3 - "$out/worker-borrowed/$id.json" "$proof" "$digest" "$primary" "$workspace" "$token" "$attempt" "$current_owner" "$ledger" "$pip" "$claim_owner" <<'PY' || return 1
import json,os,sys
from pathlib import Path
path,proof,digest,primary,workspace,token,attempt,owner,ledger,pip,claim_owner=sys.argv[1:]
assert Path(path).parent.resolve(strict=True)==Path(path).parent
row=dict(version=1,role='borrowed-worker',machine_id=Path(path).stem,proof=proof,
         claim_sha256=digest,primary_machine_id=primary,workspace=workspace,run_token=token,
         admission=attempt,fleet_owner_token=owner,claim_owner_token=claim_owner,ledger=ledger,primary_host=pip)
with os.fdopen(os.open(path,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600),'w') as f:
 json.dump(row,f,sort_keys=True);f.flush();os.fsync(f.fileno())
fd=os.open(Path(path).parent,os.O_RDONLY|os.O_DIRECTORY);os.fsync(fd);os.close(fd)
PY
            worker_ledger_lock_acquire "$out" || return 1
            printf '%s\n' "$id" >> "$out/worker-clones.ids" || { worker_ledger_lock_release "$out"; return 1; }
            worker_ledger_lock_release "$out" || return 1
            printf '%s' "$id"; return 0
        done < "$ledger"
    done
}

return_reusable_worker() {  # <out> <worker>; evidence is captured before this call
    local out="$1" wid="$2" authority="$1/worker-borrowed/$2.json" helper
    local proof volume token digest ledger state nonce command attempt claim_owner origin
    helper="${CLOUDBENCH_SCRIPT_SNAPSHOT:-$ROOT_DIR/scripts}/cloudbench-worker-reuse.py"
    IFS=$'\t' read -r proof volume token digest ledger claim_owner origin < <(python3 - "$authority" "$FLEET_OWNER_TOKEN" <<'PY'
import json,sys
r=json.load(open(sys.argv[1]));p=json.load(open(r['proof']))
assert r['role']=='borrowed-worker' and r['fleet_owner_token']==sys.argv[2]
assert r['machine_id']==p['machine_id']
print(r['proof'],p['volume_id'],r['run_token'],r['claim_sha256'],r['ledger'],r['claim_owner_token'],r.get('origin','historical'),sep='\t')
PY
) || return 1
    [ -n "$proof" ] && [ -n "$volume" ] && [ -n "$token" ] && [ -n "$digest" ] || return 1
    python3 - "$helper" "$out" "$authority" <<'PY' || return 1
import json,runpy,sys
r=json.load(open(sys.argv[3]));runpy.run_path(sys.argv[1])['validate_capture'](sys.argv[2],r['machine_id'],r['primary_machine_id'],r['run_token'])
PY
    [ "$(cloudbench_env_sha256 "$POOL_CLAIMS_DIR/$wid")" = "$digest" ] || return 1
    attempt="$(mktemp -d "$out/worker-borrowed/.return-$wid.XXXXXX")" || return 1
    fleet_preconfig_native_read "$wid" "$attempt/before.json" || return 1
    state="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["state"])' "$attempt/before.json")" || return 1
    case "$state" in
        started)
            nonce="$(python3 -c 'import secrets;print(secrets.token_hex(16))')" || return 1
            command="$(python3 - "$helper" "$wid" "$nonce" <<'PY'
import runpy,sys
print(runpy.run_path(sys.argv[1])['idle_command'](*sys.argv[2:]))
PY
)" || return 1
            fly_with_timeout 30 ssh console -a "$APP" --machine "$wid" -C "$command" > "$attempt/idle.json" || return 1
            python3 - "$helper" "$attempt/idle.json" "$wid" "$nonce" <<'PY' || return 1
import json,runpy,sys
runpy.run_path(sys.argv[1])['validate_idle'](json.load(open(sys.argv[2])),*sys.argv[3:])
PY
            fly_with_timeout 20 machine stop "$wid" -a "$APP" > "$attempt/stop.log" 2>&1 || return 1
            ;;
        stopped) ;;
        *) return 1 ;;
    esac
    local step
    for step in $(seq 1 20); do
        fleet_preconfig_native_read "$wid" "$attempt/after.json" || return 1
        state="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["state"])' "$attempt/after.json")" || return 1
        [ "$state" != stopped ] || break
        case "$state" in started|stopping) sleep 1 ;; *) return 1 ;; esac
    done
    [ "$state" = stopped ] || return 1
    fleet_preconfig_native_read "$wid" "$attempt/final.json" \
        && fleet_cold_handoff_volume_read "$volume" "$attempt/volume.json" || return 1
    if [ "$origin" = explicit-user-idle-resource ]; then
        python3 "$(explicit_worker_helper "$proof")" worker-return \
            --assignment "$authority" --before "$attempt/after.json" --after "$attempt/final.json" \
            --volume "$attempt/volume.json" > "$attempt/verified" || return 1
    else
    python3 "$helper" "$proof" --target "$ledger.deps" --before "$attempt/after.json" \
        --after "$attempt/final.json" --volume "$attempt/volume.json" --source "$BENCH_REF" \
        --node "$CURRENT_NODE_FP" --python "$CURRENT_PY_FP" --size "$FLEET_WORKER_VM_SIZE" \
        --memory "$FLEET_WORKER_VM_MEMORY" --app "$APP" --returning > "$attempt/verified" || return 1
    fi
    python3 - "$helper" "$authority" "$out/worker-borrowed/$wid.returned.json" "$out/worker-runtime-evidence/$wid" <<'PY' || return 1
import json,runpy,sys
h=runpy.run_path(sys.argv[1]);r=json.loads(h['read'](sys.argv[2]));base=__import__('pathlib').Path(sys.argv[4])
evidence=base/'capture/manifest.json'
if not evidence.exists(): evidence=base/'not-launched.json'
receipt=dict(version=1,role='borrowed-worker',machine_id=r['machine_id'],run_token=r['run_token'],
             primary_machine_id=r['primary_machine_id'],fleet_owner_token=r['fleet_owner_token'],
             state='stopped',volume_retained=True,claim_sha256=r['claim_sha256'],
             evidence_sha256=h['sha'](h['read'](evidence)))
h['sibling']('cloudbench-startup-failure-archive.py')['durable_handoff_json'](__import__('pathlib').Path(sys.argv[3]),receipt)
PY
    if [ "$origin" = explicit-user-idle-resource ]; then
        python3 "$(explicit_worker_helper "$proof")" worker-return \
            --assignment "$authority" --before "$attempt/after.json" --after "$attempt/final.json" \
            --volume "$attempt/volume.json" --record > "$attempt/state-recorded" || return 1
    else
    python3 - "$helper" "$authority" "$attempt/final.json" "$attempt/volume.json" <<'PY' || return 1
import runpy,sys
runpy.run_path(sys.argv[1])['record_return_state'](*sys.argv[2:])
PY
    fi
    pool_claim_release_exact "$POOL_CLAIMS_DIR/$wid" "$digest" "$claim_owner" \
        "$FLEET_OWNER_HOST" "$$" "$FLEET_OWNER_PID_START" || return 1
    python3 - "$helper" "$out/worker-borrowed/$wid.returned.json" "$out/worker-borrowed/$wid.released.json" <<'PY' || return 1
import json,runpy,sys
from pathlib import Path
h=runpy.run_path(sys.argv[1]);h['sibling']('cloudbench-startup-failure-archive.py')['durable_handoff_json'](Path(sys.argv[3]),json.loads(h['read'](sys.argv[2])))
PY
    cloudbench_fsync_directory "$out/worker-borrowed"
}

_pool_ids() {  # count of tracked worker machines (clean single integer)
    local f="$1/worker-clones.ids" n
    [ -f "$f" ] || { echo 0; return; }
    n="$(grep -c . "$f" 2>/dev/null)"   # grep -c always prints a number; ignore its exit code
    printf '%s' "${n:-0}" | tr -dc '0-9'
    printf '\n'
}

_ready_pool_ids() {  # count of workers proven to have joined the queue
    local f="$1/worker-ready.ids" n
    [ -f "$f" ] || { echo 0; return; }
    n="$(grep -c . "$f" 2>/dev/null)"
    printf '%s\n' "${n:-0}" | tr -dc '0-9\n'
}

worker_operational() {  # worker_operational <machine-id>
    local wid="$1" out="${2:-}" command
    if [ -n "$out" ] && [ -e "$out/worker-borrowed/$wid.json" ]; then
        command="$(python3 - "${CLOUDBENCH_SCRIPT_SNAPSHOT:-$ROOT_DIR/scripts}/cloudbench-worker-reuse.py" "$out/worker-borrowed/$wid.json" <<'PY'
import json,runpy,sys
row=json.load(open(sys.argv[2])); p=row['primary_host']; t=row['run_token']
print(runpy.run_path(sys.argv[1])['ready_command'](row['machine_id'],t,p,row['workspace'],f"/data/cloudbench-worker-{row['machine_id']}-{t}.ready"))
PY
)" || return 1
        fly_with_timeout 20 ssh console -a "$APP" --machine "$wid" -C "$command" >/dev/null 2>&1 || return 1
    fi
    # /health is 200 only after worker.run() has passed Temporal validation and
    # started its poller tasks; worker.py flips it back to 503 on fatal exit.
    # Pair it with the live process check so a stale HTTP response can never
    # preserve capacity after the worker process has gone away.
    # Returns 0 healthy, 1 when the worker itself reported a missing process or
    # failed /health, and 75 when no remote verdict arrived (controller agent,
    # tunnel or SSH transport failure). Only the remote shell prints the
    # verdict line; the quoted split keeps it out of the command text.
    local output rc=0
    output="$(fly_with_timeout 20 ssh console -a "$APP" --machine "$wid" \
        -C "bash -c \"pgrep -f 'python [w]orker.py' >/dev/null && curl -fsS --max-time 2 -o /dev/null http://127.0.0.1:$FLEET_WORKER_HEALTH_PORT/health && exit 0; echo cloudbench-worker-health=unhealth''y; exit 1\"" 2>&1)" || rc=$?
    [ "$rc" = 0 ] && return 0
    if [ -n "$out" ]; then
        printf '[%s] health probe rc=%s\n%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$rc" "$output" \
            >> "$out/worker-$wid.health.log" 2>/dev/null || true
    fi
    case $'\n'"${output//$'\r'/}"$'\n' in
        *$'\n'cloudbench-worker-health=unhealthy$'\n'*) return 1 ;;
    esac
    return 75
}

worker_operational_reobserved() {  # <machine-id> <bench-output-dir>
    # A transport failure is a missing observation, not a negative one. Retry
    # only that case, boundedly; a remote unhealthy verdict is final at once.
    local wid="$1" out="$2" attempt=1 rc
    local attempts="${CLOUDBENCH_FINAL_WORKER_HEALTH_ATTEMPTS:-3}"
    local delay="${CLOUDBENCH_FINAL_WORKER_HEALTH_RETRY_SECONDS:-5}"
    case "$attempts" in ''|*[!0-9]*|0) return 1 ;; esac
    case "$delay" in ''|*[!0-9]*) return 1 ;; esac
    while :; do
        rc=0
        worker_operational "$wid" "$out" || rc=$?
        [ "$rc" = 75 ] && [ "$attempt" -lt "$attempts" ] || return "$rc"
        attempt=$((attempt + 1))
        sleep "$delay"
    done
}

ready_workers_operational() {  # ready_workers_operational <bench-output-dir>
    # 0 = every ready worker observed healthy; 1 = some worker reported itself
    # unhealthy; 75 = some worker stayed unobservable through its retries.
    local out="$1" wid pid rc result=0
    local -a probe_pids=()
    [ -s "$out/worker-ready.ids" ] || return 0
    while read -r wid; do
        [ -n "$wid" ] || continue
        worker_operational_reobserved "$wid" "$out" &
        probe_pids+=("$!")
    done < "$out/worker-ready.ids"
    for pid in "${probe_pids[@]}"; do
        rc=0
        wait "$pid" || rc=$?
        case "$rc" in
            0) ;;
            75) [ "$result" = 1 ] || result=75 ;;
            *) result=1 ;;
        esac
    done
    return "$result"
}

mandatory_worker_health_acceptable() {  # <bench-output-dir> <bench>
    local rc=0
    ready_workers_operational "$1" || rc=$?
    case "$rc" in
        0) return 0 ;;
        75) echo "❌ [$2] mandatory autoscaler worker health unobservable before final acceptance: controller SSH transport failed on every bounded probe (see worker-*.health.log)" >&2 ;;
        *) echo "❌ [$2] mandatory autoscaler worker became unhealthy before final acceptance" >&2 ;;
    esac
    return 1
}

CONTROLLER_GITHUB_TOKEN_B64_CACHE="${CLOUDBENCH_GITHUB_TOKEN_B64:-}"
controller_github_token_b64() {
    local token=""
    if [ -n "$CONTROLLER_GITHUB_TOKEN_B64_CACHE" ]; then
        # Cached value may be stale empty b64 from a prior empty gh auth token —
        # only reuse when decode is non-empty.
        token="$(printf '%s' "$CONTROLLER_GITHUB_TOKEN_B64_CACHE" | base64 -d 2>/dev/null || true)"
        if [ -n "$token" ]; then
            printf '%s' "$CONTROLLER_GITHUB_TOKEN_B64_CACHE"
            return 0
        fi
        CONTROLLER_GITHUB_TOKEN_B64_CACHE=""
    fi
    # Prefer live controller credentials (git insteadOf / gh hosts) over a
    # stale injected GITHUB_TOKEN — see cloudbench_controller_github_token.
    token="$(cloudbench_controller_github_token "$ROOT_DIR" 2>/dev/null || true)"
    [ -n "$token" ] || return 1
    CONTROLLER_GITHUB_TOKEN_B64_CACHE="$(printf '%s' "$token" | base64 | tr -d '\n')"
    printf '%s' "$CONTROLLER_GITHUB_TOKEN_B64_CACHE"
}

worker_is_tracked() {  # worker_is_tracked <bench-output-dir> <worker-id>
    local out="$1" wid="$2"
    [ -s "$out/worker-clones.ids" ] \
        && grep -Fxq "$wid" "$out/worker-clones.ids" 2>/dev/null
}

pool_has_pending_worker() {  # pool_has_pending_worker <bench-output-dir>
    local out="$1" marker
    for marker in "$out"/worker-*.pending; do
        [ -e "$marker" ] || continue
        return 0
    done
    return 1
}

cancel_worker_for_scale_down() {  # <bench-output-dir> <desired-worker-count>
    local out="$1" want="$2" tracked wid="" candidate rc=0
    case "$want" in ''|*[!0-9]*) return 1 ;; esac

    # Count, choose, and publish cancellation under the same ledger lock. A
    # failed provisioner can otherwise remove pending capacity after the count,
    # leaving scale-down to destroy a healthy ready worker using stale overage.
    worker_ledger_lock_acquire "$out" || return 1
    tracked="$(_pool_ids "$out")"
    case "$tracked" in ''|*[!0-9]*) rc=1 ;; esac
    if [ "$rc" = "0" ] && [ "$tracked" -gt "$want" ] \
        && ! pool_has_pending_worker "$out"; then
        # Allocation plus staging is a committed capacity request, not
        # disposable excess. Scale-down can retire only a worker whose queue
        # readiness was reconciled into the authoritative ready ledger.
        while IFS= read -r candidate; do
            [ -n "$candidate" ] || continue
            if [ ! -e "$out/worker-$candidate.cancelled" ] \
                && [ ! -e "$out/worker-$candidate.pending" ] \
                && worker_is_tracked "$out" "$candidate"; then
                wid="$candidate"
            fi
        done < "$out/worker-ready.ids"
        if [ -n "$wid" ] && ! : > "$out/worker-$wid.cancelled"; then
            rc=1
        fi
    fi
    worker_ledger_lock_release "$out" || rc=1
    [ "$rc" = "0" ] || return 1
    printf '%s\n' "$wid"
}

autoscaler_monotonic_seconds() {  # autoscaler_monotonic_seconds <output-var>
    printf -v "$1" '%s' "$SECONDS"
}

cleanup_failed_worker() {  # cleanup_failed_worker <output-dir> <worker-id>
    local cleanup_out="$1" cleanup_wid="$2" tracking_tmp ready_tmp grep_status rc=0 volume_id
    local cleanup_log="$1/worker-$2.cleanup.log"
    local claim="$1/worker-$2.cleanup-claim" self_pid="${BASHPID:-$$}"
    local claim_token claim_line claim_pid claim_owner claim_started
    local machine_reap_status=-1 terminal_disposition borrowed_worker=0 retained_worker=0 runtime_missing=0
    local DISPOSABLE_REAP=0
    fleet_current_disposable_registry "${FLEET_REGISTRY_DIR:-}" && DISPOSABLE_REAP=1
    claim_token="$self_pid.$(date +%s).$RANDOM"
    local now age attempt=0 claimed=0
    local claim_attempts="${WORKER_CLEANUP_CLAIM_ATTEMPTS:-300}"
    local claim_delay="${WORKER_CLEANUP_CLAIM_RETRY_SECONDS:-0.1}"
    local claim_stale="${WORKER_CLEANUP_CLAIM_STALE_SECONDS:-300}"
    case "$claim_attempts" in ''|*[!0-9]*|0) echo "❌ invalid worker cleanup claim attempts" >&2; return 1 ;; esac
    case "$claim_stale" in ''|*[!0-9]*) echo "❌ invalid worker cleanup stale timeout" >&2; return 1 ;; esac

    # Claim only the target worker while holding the short ledger lock. Provider deletion is slow,
    # so it runs after releasing that lock; other workers can be reconciled concurrently.
    while [ "$attempt" -lt "$claim_attempts" ]; do
        worker_ledger_lock_acquire "$cleanup_out" || return 1
        if [ ! -f "$cleanup_out/worker-clones.ids" ]; then
            worker_ledger_lock_release "$cleanup_out" || true
            return 1
        fi
        if grep -Fxq "$cleanup_wid" "$cleanup_out/worker-clones.ids"; then
            grep_status=0
        else
            grep_status=$?
        fi
        if [ "$grep_status" != "0" ]; then
            worker_ledger_lock_release "$cleanup_out" || return 1
            [ "$grep_status" = "1" ] && return 0
            return 1
        fi

        if [ -f "$claim" ]; then
            claim_line="$(cat "$claim" 2>/dev/null || true)"
            claim_pid=""; claim_owner=""; claim_started=""
            read -r claim_pid claim_owner claim_started < "$claim" 2>/dev/null || true
            now="$(date +%s)"
            case "$claim_started" in ''|*[!0-9]*) claim_started="$now" ;; esac
            age=$((now - claim_started))
            if [ "$age" -ge "$claim_stale" ] \
                && { [ -z "$claim_pid" ] || ! kill -0 "$claim_pid" 2>/dev/null; } \
                && [ "$(cat "$claim" 2>/dev/null || true)" = "$claim_line" ]; then
                rm -f "$claim" || { worker_ledger_lock_release "$cleanup_out" || true; return 1; }
            fi
        fi
        if [ ! -e "$claim" ]; then
            now="$(date +%s)"
            if printf '%s %s %s\n' "$self_pid" "$claim_token" "$now" > "$claim"; then
                claimed=1
            fi
        fi
        worker_ledger_lock_release "$cleanup_out" || return 1
        [ "$claimed" = "1" ] && break
        sleep "$claim_delay"
        attempt=$((attempt + 1))
    done
    if [ "$claimed" != "1" ]; then
        echo "❌ timed out claiming worker cleanup: $cleanup_wid" >&2
        return 1
    fi

    if [ -e "$cleanup_out/worker-borrowed/$cleanup_wid.json" ]; then
        borrowed_worker=1
    else
        volume_id="$(fleet_registry_volume_for_id "$cleanup_wid")" || {
            echo "❌ worker $cleanup_wid has no durable exact volume ownership; refusing destroy" >&2
            rc=1
        }
    fi
    : >> "$cleanup_log" 2>/dev/null || true
    if [ "$rc" = "0" ] \
        && [ -e "$cleanup_out/worker-runtime-evidence/$cleanup_wid/owner.json" ] \
        && ! cloudbench_preserve_unlaunched_worker "$cleanup_out" "$cleanup_wid" \
        && ! cloudbench_capture_worker_runtime_evidence "$cleanup_out" "$cleanup_wid"; then
        echo "❌ worker $cleanup_wid runtime evidence was not preserved" >&2
        runtime_missing=1
        [ "$DISPOSABLE_REAP" = 1 ] || rc=1
        # Every cleanup path (cancelled provisioner, scale-down or controller)
        # publishes the same stable run-failure reason for the final verdict.
        local failure_reason="worker $cleanup_wid runtime evidence was not preserved"
        [ ! -e "$cleanup_out/worker-$cleanup_wid.launch-attempted" ] \
            || [ -e "$cleanup_out/worker-$cleanup_wid.ready" ] \
            || failure_reason="worker $cleanup_wid could not be staged and launched; see worker-$cleanup_wid.stage.log"
        if [ ! -e "$cleanup_out/worker-$cleanup_wid.cleanup-failed" ]; then
            printf '%s\n' "$failure_reason" > "$cleanup_out/worker-$cleanup_wid.cleanup-failed.tmp.$$" \
                && mv "$cleanup_out/worker-$cleanup_wid.cleanup-failed.tmp.$$" "$cleanup_out/worker-$cleanup_wid.cleanup-failed" \
                || echo "❌ worker $cleanup_wid could not persist its cleanup failure" >&2
        fi
    fi
    if [ "$borrowed_worker" = 0 ] && [ "${POOL_REUSE_ONLY:-0}" = 1 ]; then
        # A failed evidence copy still retains its error and all ownership.
        # Current idle proof may stop compute independently of admission.
        if stop_current_owned_machine_retained "$cleanup_out" "$cleanup_wid" worker; then
            retained_worker=1
        else
            rc=1
        fi
    elif [ "$rc" = 0 ] && [ "$borrowed_worker" = 1 ]; then
        return_reusable_worker "$cleanup_out" "$cleanup_wid" || rc=1
    elif [ "$rc" = "0" ]; then
        if reap_machine "$cleanup_wid" "$cleanup_log" "$volume_id"; then
            machine_reap_status=0
        else
            machine_reap_status=$?
            [ "$machine_reap_status" -eq 74 ] || rc=1
        fi
    fi
    terminal_disposition=destroyed-verified-absent
    [ "$machine_reap_status" -eq 74 ] \
        && terminal_disposition=destroyed-provider-retained
    # reap_machine already carries the exact Volume through its terminal
    # lifecycle. A second destroy/read loop cannot strengthen that receipt.
    if [ "$borrowed_worker" = 0 ] && [ "$retained_worker" = 0 ]; then
        [ "$rc" = "0" ] \
            && fleet_audit_update_fresh_clone_by_id "$cleanup_wid" "$terminal_disposition" \
            || rc=1
        [ "$rc" = "0" ] && fleet_registry_release_id "$cleanup_wid" || rc=1
    fi

    worker_ledger_lock_acquire "$cleanup_out" || return 1
    claim_owner=""
    read -r claim_pid claim_owner claim_started < "$claim" 2>/dev/null || true
    if [ "$claim_owner" != "$claim_token" ]; then
        worker_ledger_lock_release "$cleanup_out" || true
        return 1
    fi
    if [ "$rc" != "0" ]; then
        rm -f "$claim" || rc=1
        worker_ledger_lock_release "$cleanup_out" || rc=1
        return "$rc"
    fi

    # Cancellation belongs to the autoscaler/controller. A cancellation can arrive after a child
    # provisioner's last check; preserving it keeps that intentional scale-down from becoming a
    # retryable provisioning failure.
    if [ "$rc" = "0" ] && ! rm -f \
        "$cleanup_out/worker-$cleanup_wid.pending" \
        "$cleanup_out/worker-$cleanup_wid.ready"; then
        rc=1
    fi

    # Keep readiness and ownership under the same short ledger lock so the two files cannot
    # disagree after successful provider cleanup.
    ready_tmp="$cleanup_out/worker-ready.ids.tmp.$cleanup_wid.$$"
    if [ "$rc" = "0" ] && [ -f "$cleanup_out/worker-ready.ids" ]; then
        if awk -v id="$cleanup_wid" '$0 != id' "$cleanup_out/worker-ready.ids" > "$ready_tmp" \
            && mv "$ready_tmp" "$cleanup_out/worker-ready.ids"; then
            :
        else
            rm -f "$ready_tmp"
            rc=1
        fi
    fi

    # Drop the durable teardown handle last. Distinguish grep's normal no-output status (1) from
    # read/I/O errors so a damaged ledger is never replaced with an empty partial file.
    tracking_tmp="$cleanup_out/worker-clones.ids.tmp.$cleanup_wid.$$"
    if [ "$rc" = "0" ]; then
        if grep -Fxv "$cleanup_wid" "$cleanup_out/worker-clones.ids" > "$tracking_tmp"; then
            grep_status=0
        else
            grep_status=$?
        fi
        if [ "$grep_status" -le 1 ]; then
            mv "$tracking_tmp" "$cleanup_out/worker-clones.ids" || rc=1
        else
            rm -f "$tracking_tmp"
            rc=1
        fi
    fi

    # This process still owns the claim even when a local finalize write failed. Release that
    # claim so the durable ledger entry can be retried immediately instead of waiting for expiry.
    rm -f "$claim" || rc=1
    worker_ledger_lock_release "$cleanup_out" || rc=1
    [ "$runtime_missing" = 0 ] || rc=1
    return "$rc"
}

# Readiness publication, reconciliation and cleanup share the worker-ledger lock,
# eliminating append-vs-rewrite loss and keeping desired-capacity state authoritative
# over stale child outcomes.
reconcile_worker_ready_outcomes() {  # <bench-output-dir>
    local out="$1" marker name wid rc=0
    worker_ledger_lock_acquire "$out" || return $?
    for marker in "$out"/worker-*.ready; do
        [ -e "$marker" ] || continue
        name="${marker##*/}"
        wid="${name#worker-}"; wid="${wid%.ready}"
        if worker_is_tracked "$out" "$wid" \
            && [ ! -e "$out/worker-$wid.cancelled" ]; then
            if ! grep -Fxq "$wid" "$out/worker-ready.ids" 2>/dev/null \
                && ! printf '%s\n' "$wid" >> "$out/worker-ready.ids"; then
                rc=1
                break
            fi
        else
            rm -f "$marker" || { rc=1; break; }
        fi
    done
    worker_ledger_lock_release "$out" || rc=1
    return "$rc"
}

reconcile_worker_failure_outcomes() {  # <bench> <bench-output-dir>
    local bench="$1" out="$2" marker name wid reason
    for marker in "$out"/worker-*.cleanup-failed; do
        [ -e "$marker" ] || continue
        name="${marker##*/}"
        wid="${name#worker-}"; wid="${wid%.cleanup-failed}"
        if worker_is_tracked "$out" "$wid"; then
            reason="$(head -1 "$marker" 2>/dev/null)"
            printf '%s\n' "${reason:-worker $wid cancellation cleanup failed}" > "$out/autoscaler.failed"
            echo "  ❌ [$bench] mandatory autoscaler: ${reason:-worker $wid cancellation cleanup failed}" >&2
            return 1
        fi
    done
    for marker in "$out"/worker-*.failed; do
        [ -e "$marker" ] || continue
        name="${marker##*/}"
        wid="${name#worker-}"; wid="${wid%.failed}"
        if worker_is_tracked "$out" "$wid" \
            && [ ! -e "$out/worker-$wid.cancelled" ]; then
            reason="$(head -1 "$marker" 2>/dev/null)"
            printf '%s\n' "${reason:-worker $wid provisioning failed}" > "$out/autoscaler.failed"
            echo "  ❌ [$bench] mandatory autoscaler: ${reason:-worker $wid provisioning failed}" >&2
            return 1
        fi
        rm -f "$marker"
    done
    return 0
}

provision_worker() {  # provision_worker <bench> <workspace> <primary_id> <primary_ip> <sim01> <out> <run-token>
    local bench="$1" ws="$2" primary_id="$3" pip="$4" sim="$5" out="$6"
    local runtime_run_token="$7"
    [ ! -e "$out/benchmark-child.finished" ] \
        && [ ! -e "$out/autoscaler.runtime-completed" ] || return 0
    # Autoscaled workers replay the shared cache under the guest's write policy.
    local shared_cache_read_only=0 shared_cache_status=0 shared_cache_tasks=()
    IFS=, read -r -a shared_cache_tasks <<< "$bench"
    python3 -B "$ROOT_DIR/scripts/cloudbench_catalog.py" shared-demo-cache-read-only \
        "$ROOT_DIR/agents/benchmarks/tasks.json" "${shared_cache_tasks[@]}" >/dev/null || shared_cache_status=$?
    case "$shared_cache_status" in
        0) shared_cache_read_only=1 ;;
        10) ;;
        *)
            printf 'DEMO cache write policy failed (exit %s)\n' "$shared_cache_status" > "$out/autoscaler.failed"
            return 1
            ;;
    esac
    local wid="" borrowed_worker=0
    if [ "${DISPOSABLE_LIFECYCLE:-0}" != 1 ] && declare -F claim_reusable_worker >/dev/null; then
        wid="$(claim_reusable_worker "$out" "$primary_id" "$ws" "$runtime_run_token" "$pip")" || {
            printf '%s\n' "Existing worker admission is unresolved; ownership retained" > "$out/autoscaler.failed"
            return 1
        }
    fi
    [ -z "$wid" ] || borrowed_worker=1
    if [ "$borrowed_worker" = 0 ] && [ "${POOL_REUSE_ONLY:-0}" = 1 ]; then
        # A known empty/busy pool is capacity backpressure. The autoscaler's
        # existing 75 path retries on its normal poll within the child deadline.
        # Ambiguous claims returned above and remain failures with their holds.
        return 75
    fi
    if [ "$borrowed_worker" = 0 ] && ! machine_creation_admission "$out/worker-clones.ids"; then
        printf '%s\n' "No eligible existing worker path; new Machine allocation withheld" > "$out/autoscaler.failed"
        return 1
    fi
    local stage_attempts worker_ready_timeout worker_capacity_token worker_github_token_b64 ready_file stage_log failure_reason
    local primary_volume_size worker_snapshot
    local worker_storage
    worker_storage=snapshot
    if [ "$borrowed_worker" = 0 ]; then
    [ "${FRESH_VOLUMES:-0}" = 1 ] && [ "$sim" = 0 ] && worker_storage=fresh
    if [ "$worker_storage" = fresh ]; then
        worker_snapshot="$SNAP_ID"  # unused: fresh workers retain no donor storage
    else
    primary_volume_size="$(machine_volume_size_gb "$primary_id")" || primary_volume_size=""
    if [ "$primary_volume_size" = "$WARM_SOURCE_SIZE_GB" ]; then
        worker_snapshot="$SNAP_ID"
    elif [ -n "${WORKER_POOL_SNAPSHOT_ID:-}" ] \
        && [ "$primary_volume_size" = "$WORKER_POOL_SNAPSHOT_SIZE_GB" ]; then
        worker_snapshot="$WORKER_POOL_SNAPSHOT_ID"
    else
        printf '%s\n' "primary volume size has no proven matching worker snapshot" > "$out/autoscaler.failed"
        echo "  ❌ [$bench] mandatory autoscaler: no exact-size worker snapshot for primary" >&2
        return 1
    fi
    fi
    worker_capacity_token="$FLEET_OWNER_TOKEN-worker-$(python3 -c 'import uuid; print(uuid.uuid4().hex)')"
    local worker_capacity_status=0
    reserve_worker_machine_slot "$worker_capacity_token" || worker_capacity_status=$?
    if [ "$worker_capacity_status" -eq 75 ]; then
        return 75
    fi
    if [ "$worker_capacity_status" -ne 0 ]; then
        printf '%s\n' "Machine-count capacity unavailable for worker clone" > "$out/autoscaler.failed"
        echo "  ❌ [$bench] mandatory autoscaler: Machine-count capacity unavailable" >&2
        return 1
    fi
    if [ -e "$out/benchmark-child.finished" ] || [ -e "$out/autoscaler.runtime-completed" ]; then
        capacity_release_reservation "$worker_capacity_token"
        return $?
    fi
    local worker_clone_status=0
    wid="$(clone_machine_target "$out/worker-clones.ids" "$primary_id" \
        "$FLEET_WORKER_VM_SIZE" "$FLEET_WORKER_VM_MEMORY" "$worker_snapshot" "$worker_storage")" \
        || worker_clone_status=$?
    if [ "$worker_clone_status" -eq 75 ]; then
        capacity_release_reservation "$worker_capacity_token"
        return $?
    fi
    if [ "$worker_clone_status" -ne 0 ]; then
        # Keep the reservation until controller teardown: an ambiguous clone
        # failure can still become provider-visible after the lookup deadline.
        printf '%s\n' "could not allocate worker clone" > "$out/autoscaler.failed"
        echo "  ❌ [$bench] mandatory autoscaler: worker clone did not appear" >&2
        return 1
    fi
    if ! capacity_release_reservation "$worker_capacity_token"; then
        printf '%s\n' "could not release worker capacity reservation" > "$out/autoscaler.failed"
        echo "  ❌ [$bench] mandatory autoscaler: worker capacity handoff was not durable" >&2
        return 1
    fi
    else
        worker_storage=borrowed
        if [ -f "$out/worker-borrowed/$wid.json" ]; then
            local explicit_policy
            explicit_policy="$(python3 - "$out/worker-borrowed/$wid.json" <<'PY'
import json,sys
from pathlib import Path
r=json.load(open(sys.argv[1]))
if r.get('origin')=='explicit-user-idle-resource':
 print(json.load(open(Path(r['admission'])/'stage.complete.json'))['workspace_policy'])
PY
)" || return 1
            [ "$explicit_policy" != real-empty-bootstrap-v1 ] || worker_storage=fresh
        fi
    fi
    # Preserve the exact prelaunch owner before cancellation can reap a late
    # allocation. Final evidence coverage includes destroyed worker clones.
    if ! cloudbench_record_worker_evidence_owner "$out" "$wid" "$primary_id" \
        "$runtime_run_token" "$ws"; then
        printf '%s\n' "could not preserve worker runtime evidence ownership before launch" \
            > "$out/autoscaler.failed"
        return 1
    fi
    printf '%s\n' "allocated inert worker clone; wrapper not launched" \
        > "$out/worker-$wid.stage.log" || return 1
    if [ -e "$out/benchmark-child.finished" ] || [ -e "$out/autoscaler.runtime-completed" ]; then
        : > "$out/worker-$wid.cancelled" || return 1
        cleanup_failed_worker "$out" "$wid"
        return $?
    fi
    echo "  ➕ [$bench] worker $wid created"
    ready_file="/data/cloudbench-worker-$wid.ready"
    [ "$borrowed_worker" = 0 ] || ready_file="/data/cloudbench-worker-$wid-$runtime_run_token.ready"
    if ! worker_github_token_b64="$(controller_github_token_b64)"; then
        failure_reason="No current controller GitHub token available for worker ref fetch"
        if ! cleanup_failed_worker "$out" "$wid"; then
            failure_reason="$failure_reason; worker $wid cleanup failed and remains tracked for controller teardown"
        fi
        printf '%s\n' "$failure_reason" > "$out/autoscaler.failed"
        echo "  ❌ [$bench] mandatory autoscaler: $failure_reason" >&2
        return 1
    fi
    stage_attempts="$WORKER_STAGE_ATTEMPTS"
    worker_ready_timeout="$WORKER_READY_TIMEOUT"
    case "$stage_attempts" in
        ''|*[!0-9]*)
            failure_reason="invalid worker stage/readiness timeout configuration"
            if ! cleanup_failed_worker "$out" "$wid"; then
                failure_reason="$failure_reason; worker $wid cleanup failed and remains tracked for controller teardown"
            fi
            printf '%s\n' "$failure_reason" > "$out/autoscaler.failed"
            return 1
            ;;
    esac
    case "$worker_ready_timeout" in
        ''|*[!0-9]*)
            failure_reason="invalid worker stage/readiness timeout configuration"
            if ! cleanup_failed_worker "$out" "$wid"; then
                failure_reason="$failure_reason; worker $wid cleanup failed and remains tracked for controller teardown"
            fi
            printf '%s\n' "$failure_reason" > "$out/autoscaler.failed"
            return 1
            ;;
    esac
    if [ "$stage_attempts" -lt 1 ] || [ "$worker_ready_timeout" -lt 1 ]; then
        failure_reason="worker stage attempts and readiness timeout must be positive"
        if ! cleanup_failed_worker "$out" "$wid"; then
            failure_reason="$failure_reason; worker $wid cleanup failed and remains tracked for controller teardown"
        fi
        printf '%s\n' "$failure_reason" > "$out/autoscaler.failed"
        return 1
    fi
    # Allocation is ownership, not capacity. Keep it in worker-clones.ids for
    # teardown, but count it as operational only after the worker health endpoint
    # proves that Temporal worker.run() reached its queue-polling boundary.
    : > "$out/worker-$wid.pending"
    rm -f "$out/worker-$wid.cancelled"
    stage_log="$out/worker-$wid.stage.log"
    : >> "$stage_log" 2>/dev/null || true
    local worker_launch_prefix="bash /tmp/rbw.sh" worker_selected_helper
    if [ "$borrowed_worker" = 1 ] && [ -n "${explicit_policy:-}" ]; then
        worker_selected_helper="$(explicit_worker_helper "$GIT_COMMON_DIR/cloudbench-pool-reuse/$wid.json")" || return 1
        if [ "${worker_selected_helper##*/}" = cloudbench-fixed-native-worker.py ]; then
            worker_launch_prefix="$(python3 "$worker_selected_helper" worker-launch-prefix "$GIT_COMMON_DIR/cloudbench-pool-reuse/$wid.json")" || return 1
        fi
    fi
    local wrapper worker_env; wrapper="$(mktemp)"; worker_env="$(mktemp)"
    chmod 600 "$worker_env" 2>/dev/null || true
    printf 'CLOUDBENCH_GITHUB_TOKEN_B64=%q\n' "$worker_github_token_b64" > "$worker_env"
    {
        echo "set -e"
        echo 'if [ -f /tmp/rbw.env ]; then'
        echo '    set -a'
        echo '    . /tmp/rbw.env'
        echo '    set +a'
        echo '    rm -f /tmp/rbw.env'
        echo 'fi'
        echo "export REF=$(printf '%q' "$BENCH_REF")"
        echo "export CLOUDBENCH_FETCH_REF_SCRIPT=/data/cloudbench-fetch-ref.sh"
        echo "export CLOUDBENCH_FRESH_VOLUME=$([ "$worker_storage" = fresh ] && printf 1 || printf 0)"
        echo "export CLOUDBENCH_SYNC_DEPS_SCRIPT=/data/cloudbench-sync-deps.sh"
        echo "export CLOUDBENCH_SYNC_PRISMA_SCRIPT=/data/cloudbench-sync-prisma-client.sh"
        echo "export CLOUDBENCH_ENV_HELPER=/data/cloudbench-env.sh"
        echo "export CLOUDBENCH_WORKER_EVIDENCE_HELPER=/data/cloudbench-worker-evidence.py"
        echo "export CLOUDBENCH_WORKER_RUN_TOKEN=$(printf '%q' "$runtime_run_token")"
        [ "$borrowed_worker" = 0 ] || echo "export CLOUDBENCH_WORKER_EVIDENCE_SCOPE=run"
        echo "export CLOUDBENCH_WORKER_MACHINE_ID=$(printf '%q' "$wid")"
        echo "export WORKSPACE_NAME=$(printf '%q' "$ws")"
        echo "export PRIMARY_HOST=$(printf '%q' "$pip")"
        echo "export CLOUDBENCH_BOOT=0"
        echo "export BACKEND_PORT=$(printf '%q' "$BOX_BACKEND_PORT")"
        echo "export WMH_PORT=$(printf '%q' "$BOX_WMH_PORT")"
        # Simulated tool boundaries on autoscaled workers name the served model.
        echo "export WMH_MODEL_NAME=$(printf '%q' "$WMH_MODEL_NAME")"
        # ...and its execution policy, which partitions the DEMO cache like the primary's.
        echo "export WMH_EXECUTION_POLICY=$(printf '%q' "$WMH_EXECUTION_POLICY")"
        echo "export HEALTH_PORT=$(printf '%q' "$FLEET_WORKER_HEALTH_PORT")"
        echo "export BENCH_SIMULATE=$(printf '%q' "$sim")"
        if [ "${BENCHMARK_DEMO_CACHE_READ_ONLY:-}" = 1 ]; then
            echo "export BENCHMARK_DEMO_CACHE_READ_ONLY=1"
            echo "export FAST_MODE_CACHE_DISABLE_WRITE_THROUGH=1"
            echo "export BENCHMARK_ISOLATED_RUN=true"
        fi
        [ "$shared_cache_read_only" = 0 ] || echo "export FAST_MODE_CACHE_DISABLE_WRITE_THROUGH=1"
        echo "export WORKER_READY_FILE=$(printf '%q' "$ready_file")"
        echo "rm -f $(printf '%q' "$ready_file")"
        [ -n "$FLEET_PATCH_FILE" ] && echo "export LOCAL_PATCH_FILE=/tmp/cloudbench-local.patch" || echo "unset LOCAL_PATCH_FILE"
        [ -n "$FLEET_PATCH_FILE" ] && echo "export LOCAL_PATCH_SHA256=$FLEET_PATCH_SHA256" || echo "unset LOCAL_PATCH_SHA256"
        echo "exec bash /data/cloudbench-worker.sh"
    } > "$wrapper"
    (
      # This is a child provisioner, not the autoscaler owner. Bash can carry
      # the caller's EXIT trap into an async function subshell; clear it so a
      # worker exit never runs controller-owned proxy/lease cleanup with locals
      # whose dynamic scope has already ended.
      trap - EXIT HUP INT TERM
      worker_provision_cancelled() {
          if [ -e "$out/benchmark-child.finished" ] || [ -e "$out/autoscaler.runtime-completed" ]; then
              : > "$out/worker-$wid.cancelled" || return 1
          fi
          [ -e "$out/worker-$wid.cancelled" ]
      }
      finish_cancelled_worker_provision() {
          local cleanup_status=0 failure_tmp="$out/worker-$wid.cleanup-failed.tmp.$$"
          rm -f "$wrapper" "$worker_env" 2>/dev/null || true
          cleanup_failed_worker "$out" "$wid" || cleanup_status=$?
          if [ "$cleanup_status" -ne 0 ]; then
              # Intentional cancellation cannot forgive failed preservation or
              # retirement. Keep pending/ownership and publish the joined result.
              # An attempted launch that never succeeded keeps its actual cause.
              local failure_reason="worker $wid cancellation cleanup failed; exact ownership retained"
              [ "${launched:-0}" = 1 ] || [ ! -e "$out/worker-$wid.launch-attempted" ] \
                  || failure_reason="worker $wid could not be staged and launched; see worker-$wid.stage.log"
              printf '%s\n' "$failure_reason" \
                  > "$failure_tmp" && mv "$failure_tmp" "$out/worker-$wid.cleanup-failed" \
                  || echo "❌ worker $wid could not persist cancellation cleanup failure" >&2
          fi
          exit "$cleanup_status"
      }
      publish_worker_failure() {
          local reason="$1" failure_tmp="$out/worker-$wid.failed.tmp.$$"
          printf '%s\n' "$reason" > "$failure_tmp" \
              && mv "$failure_tmp" "$out/worker-$wid.failed"
      }
      discard_replaceable_worker() {
          local reason="$1"
          rm -f "$wrapper" "$worker_env" 2>/dev/null || true
          if cleanup_failed_worker "$out" "$wid"; then
              echo "  ⚠️  [$bench] $reason; removed worker $wid so capacity can be retried" >&2
              exit 1
          fi
          publish_worker_failure "$reason; worker $wid could not be reaped"
          exit 1
      }
      publish_worker_ready() {
          local ready_tmp="$out/worker-$wid.ready.tmp.$$"
          : > "$ready_tmp" && mv "$ready_tmp" "$out/worker-$wid.ready" || return 1
          if [ "${QUALIFY_WORKER:-0}" = 1 ]; then
              printf '%s|%s|%s\n' "$wid" "$runtime_run_token" "$primary_id" > "$ready_tmp" \
                  && mv "$ready_tmp" "$out/worker-$wid.qualification-ready" || return 1
          fi
          # A bounded readiness consumer must not wait for the next metrics
          # scrape to see an already queue-ready worker. Reuse the same locked
          # reconciler as cleanup and the autoscaler, including its cancellation
          # and exact tracked-worker checks.
          reconcile_worker_ready_outcomes "$out"
      }
      log_worker_stage() {
          printf '[%s] %s\n' \
              "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || printf unknown)" \
              "$*" >> "$stage_log" 2>/dev/null || true
      }
      run_worker_stage_cmd() {
          local label="$1" rc
          shift
          worker_provision_cancelled && finish_cancelled_worker_provision
          log_worker_stage "attempt ${attempt:-?}/$stage_attempts: $label"
          if "$@" >> "$stage_log" 2>&1; then
              log_worker_stage "attempt ${attempt:-?}/$stage_attempts: $label succeeded"
              return 0
          else
              rc=$?
          fi
          log_worker_stage "attempt ${attempt:-?}/$stage_attempts: $label failed rc=$rc"
          return "$rc"
      }
      launched=0
      for attempt in $(seq 1 "$stage_attempts"); do
        worker_provision_cancelled && finish_cancelled_worker_provision
        if ! machine_storage_ready "$wid"; then
            if machine_storage_failed "$wid"; then
                log_worker_stage "attempt $attempt/$stage_attempts: storage failed before staging"
                discard_replaceable_worker \
                    "worker $wid storage failed before staging; see worker-$wid.stage.log"
            fi
            log_worker_stage "attempt $attempt/$stage_attempts: storage not ready"
            sleep "${CLOUDBENCH_WORKER_STAGE_RETRY_SECONDS:-3}"
            continue
        fi
        # Creation already overrides CMD with inert sleep and rejects source
        # exec/entrypoint overrides. An identical native update consumes a
        # replacement slot and fails at the org limit. Clear BOOT in the
        # explicit wrapper instead, before any worker code runs.
        if [ "$(inventory_machine_field "$wid" clone_cmd_inert)" != "1" ]; then
            log_worker_stage "waiting for native inert clone command"
            sleep "${CLOUDBENCH_WORKER_STAGE_RETRY_SECONDS:-3}"
            continue
        fi
        run_worker_stage_cmd "start neutralized worker" \
            fly_with_timeout 20 machine start "$wid" -a "$APP" || true
        if ! run_worker_stage_cmd "clear stale worker stage files" \
            fly_with_timeout 20 ssh console -a "$APP" --machine "$wid" \
            -C "rm -f /data/cloudbench-worker.sh /data/cloudbench-worker-evidence.py /data/cloudbench-fetch-ref.sh /data/cloudbench-sync-deps.sh /data/cloudbench-sync-prisma-client.sh /data/cloudbench-env.sh /tmp/rbw.env /tmp/rbw.sh /tmp/cloudbench-local.patch"; then
            sleep "${CLOUDBENCH_WORKER_STAGE_RETRY_SECONDS:-3}"
            continue
        fi
          if run_worker_stage_cmd "upload cloudbench-worker.sh" \
                fly_with_timeout 20 ssh sftp put -a "$APP" --machine "$wid" -q -m 0755 "$CLOUDBENCH_SCRIPT_SNAPSHOT/cloudbench-worker.sh" /data/cloudbench-worker.sh \
             && run_worker_stage_cmd "upload worker evidence helper" \
                fly_with_timeout 20 ssh sftp put -a "$APP" --machine "$wid" -q -m 0755 "$CLOUDBENCH_SCRIPT_SNAPSHOT/cloudbench-worker-evidence.py" /data/cloudbench-worker-evidence.py \
             && run_worker_stage_cmd "upload cloudbench-fetch-ref.sh" \
                fly_with_timeout 20 ssh sftp put -a "$APP" --machine "$wid" -q -m 0755 "$CLOUDBENCH_SCRIPT_SNAPSHOT/cloudbench-fetch-ref.sh" /data/cloudbench-fetch-ref.sh \
             && { [ "$worker_storage" != fresh ] || {
                    run_worker_stage_cmd "upload cloudbench-sync-deps.sh" \
                        fly_with_timeout 20 ssh sftp put -a "$APP" --machine "$wid" -q -m 0755 "$CLOUDBENCH_SCRIPT_SNAPSHOT/cloudbench-sync-deps.sh" /data/cloudbench-sync-deps.sh \
                    && run_worker_stage_cmd "upload cloudbench-sync-prisma-client.sh" \
                        fly_with_timeout 20 ssh sftp put -a "$APP" --machine "$wid" -q -m 0755 "$CLOUDBENCH_SCRIPT_SNAPSHOT/cloudbench-sync-prisma-client.sh" /data/cloudbench-sync-prisma-client.sh
                }; } \
             && run_worker_stage_cmd "upload cloudbench-env.sh" \
                fly_with_timeout 20 ssh sftp put -a "$APP" --machine "$wid" -q -m 0755 "$CLOUDBENCH_SCRIPT_SNAPSHOT/cloudbench-env.sh" /data/cloudbench-env.sh \
             && run_worker_stage_cmd "upload worker environment" \
                fly_with_timeout 20 ssh sftp put -a "$APP" --machine "$wid" -q -m 0600 "$worker_env" /tmp/rbw.env \
             && run_worker_stage_cmd "upload worker wrapper" \
                fly_with_timeout 20 ssh sftp put -a "$APP" --machine "$wid" -q -m 0755 "$wrapper" /tmp/rbw.sh; then
              if [ -n "$FLEET_PATCH_FILE" ]; then
                  if ! run_worker_stage_cmd "upload local patch" \
                      fly_with_timeout 20 ssh sftp put -a "$APP" --machine "$wid" -q -m 0644 "$FLEET_PATCH_FILE" /tmp/cloudbench-local.patch; then
                      worker_provision_cancelled && finish_cancelled_worker_provision
                      sleep "${CLOUDBENCH_WORKER_STAGE_RETRY_SECONDS:-3}"
                      continue
                  fi
              fi
              worker_provision_cancelled && finish_cancelled_worker_provision
              : > "$out/worker-$wid.launch-attempted" || exit 1
              if run_worker_stage_cmd "launch worker wrapper" \
                  fly_with_timeout 20 ssh console -a "$APP" --machine "$wid" \
                  -C "bash -c \"begin=\$(date +%s); : > /data/worker.log; printf '%s\\n' \\\"\$begin\\\" > /data/worker.started-at; setsid $worker_launch_prefix >> /data/worker.log 2>&1 < /dev/null &\""; then
                  launched=1
                  break
              fi
          fi
          worker_provision_cancelled && finish_cancelled_worker_provision
          sleep 3
      done
      rm -f "$wrapper" "$worker_env" 2>/dev/null || true
      if [ "$launched" != "1" ]; then
          worker_provision_cancelled && finish_cancelled_worker_provision
          discard_replaceable_worker \
              "worker $wid could not be staged and launched; see worker-$wid.stage.log"
      fi

      ready_deadline=$((SECONDS + worker_ready_timeout))
      while [ "$SECONDS" -lt "$ready_deadline" ]; do
          worker_provision_cancelled && finish_cancelled_worker_provision
          if worker_operational "$wid" "$out"; then
              if ! publish_worker_ready; then
                  worker_provision_cancelled && finish_cancelled_worker_provision
                  discard_replaceable_worker \
                      "worker $wid could not publish queue readiness; see worker-$wid.stage.log"
              fi
              worker_provision_cancelled && finish_cancelled_worker_provision
              rm -f "$out/worker-$wid.pending"
              echo "  ✅ [$bench] worker $wid joined queue navi-agent-tasks-$ws"
              exit 0
          fi
          sleep 5
      done
      worker_provision_cancelled && finish_cancelled_worker_provision
      log_worker_stage "worker did not reach queue readiness within ${worker_ready_timeout}s"
      # Preserve the worker-side bootstrap failure before cleanup destroys its
      # snapshot volume. Without this, a readiness timeout only reports the
      # symptom and the actionable /data/worker.log disappears with the clone.
      run_worker_stage_cmd "capture worker log after readiness timeout" \
          fly_with_timeout 20 ssh console -a "$APP" --machine "$wid" \
          -C "tail -n 300 /data/worker.log" || true
      discard_replaceable_worker \
          "worker $wid did not reach queue readiness within ${worker_ready_timeout}s; see worker-$wid.stage.log"
    ) &
    return 0
}

bench_autoscaler() {  # <bench> <primary_cid> <workspace> <sim01> <out> <local-port-base> [exact-run-token]
    local bench="$1" cid="$2" ws="$3" sim="$4" out="$5" port_base="$6"
    local runtime_run_token="${7:-}"
    local pip="" metrics_proxy_pid="" metrics_proxy_pid_LEASE="" metrics_proxy_pid_TOKEN="" metrics_proxy_pid_LIVE="" metrics_port="" metrics_url=""
    local metrics_started_at scrape_failures=0 metrics_lease_owner_pid metrics_lease_token
    local ready_reconcile_rc=0 inventory_status=0
    local scale_down_target="" scale_down_since="" scale_down_now=""
    # Bash 3.2 preserves $$ from the controller in async function subshells.
    # Controller ownership is intentional: per-autoscaler EXIT releases the
    # exact token, while controller cleanup sweeps the run prefix after SIGKILL.
    metrics_lease_owner_pid="$$"
    metrics_lease_token="$RUN_ID-$bench-$RANDOM"
    : > "$out/worker-clones.ids"
    : > "$out/worker-ready.ids"
    rm -f "$out/autoscaler.ready" "$out/autoscaler.failed" \
        "$out/autoscaler.completed-after-child" "$out/autoscaler.runtime-completed"
    fail_autoscaler() {  # fail_autoscaler <reason>
        local reason="$1"
        if [ ! -s "$out/autoscaler.failed" ]; then
            if ! printf '%s\n' "$reason" > "$out/autoscaler.failed"; then
                echo "  ❌ [$bench] mandatory autoscaler: could not persist failure reason: $reason" >&2
            fi
        fi
        echo "  ❌ [$bench] mandatory autoscaler: $reason" >&2
        return 1
    }
    guest_runtime_completed() {
        local port code marker_tmp
        case "$runtime_run_token" in ''|*[!a-zA-Z0-9._-]*) return 1 ;; esac
        [ -n "${CLOUDBENCH_BARRIER_TOKEN:-}" ] || return 1
        [ ! -s "$out/autoscaler.failed" ] || return 1
        port="$(cat "$out/status-proxy.port" 2>/dev/null)" || return 1
        case "$port" in ''|*[!0-9]*|??????*) return 1 ;; esac
        [ "$((10#$port))" -gt 0 ] && [ "$((10#$port))" -le 65535 ] || return 1
        code="$(curl --noproxy '*' -sS --max-time 3 -o /dev/null -w '%{http_code}' \
            -H "Authorization: Bearer $CLOUDBENCH_BARRIER_TOKEN" \
            -H "X-Cloudbench-Run-Token: $runtime_run_token" \
            -H "X-Cloudbench-Machine-Id: $cid" \
            "http://127.0.0.1:$port/shutdown-health" 2>/dev/null || true)"
        [ "$code" = "204" ] && [ ! -s "$out/autoscaler.failed" ] || return 1
        marker_tmp="$out/autoscaler.runtime-completed.tmp.$$"
        printf '%s|%s\n' "$runtime_run_token" "$cid" > "$marker_tmp" \
            && mv "$marker_tmp" "$out/autoscaler.runtime-completed" || return 1
    }
    complete_autoscaler_after_child() {
        local completed_tmp="$out/autoscaler.completed-after-child.tmp.$$"
        local desired_workers tracked_workers ready_workers terminal_deadline ready_reconcile_rc
        [ -e "$out/benchmark-child.finished" ] || [ "${1:-}" = "verified-runtime" ] || return 1
        # Child completion stops new metrics decisions; it does not revoke
        # capacity already committed by a prior desired-count observation. Keep
        # provisioners alive and reconcile their durable outcomes until the same
        # invariant used by final acceptance is stable.
        terminal_deadline=$((SECONDS + AUTOSCALER_FINALIZATION_WAIT_SECONDS))
        while :; do
            ready_reconcile_rc=0
            # Finalization owns the retry deadline. Use one ledger-lock attempt
            # per poll so a nested ten-second acquisition window cannot overrun
            # the remaining terminal budget.
            WORKER_LEDGER_LOCK_ATTEMPTS=1 reconcile_worker_ready_outcomes "$out" \
                || ready_reconcile_rc=$?
            if [ "$ready_reconcile_rc" -ne 0 ]; then
                if [ "$ready_reconcile_rc" -ne 75 ]; then
                    fail_autoscaler "could not reconcile worker readiness outcomes"
                    return 1
                fi
                if [ "$SECONDS" -ge "$terminal_deadline" ]; then
                    fail_autoscaler "could not reconcile worker readiness outcomes"
                    return 1
                fi
                sleep 0.2
                continue
            fi
            if ! reconcile_worker_failure_outcomes "$bench" "$out"; then
                [ -s "$out/autoscaler.failed" ] && return 1
                fail_autoscaler "could not reconcile worker failure outcomes"
                return 1
            fi
            [ ! -s "$out/autoscaler.failed" ] || return 1
            desired_workers="$(cat "$out/desired-worker-count" 2>/dev/null || true)"
            if ! printf '%s' "$desired_workers" | grep -Eq '^[0-9]+$'; then
                printf '%s\n' "autoscaler never observed valid desired capacity" \
                    > "$out/autoscaler.failed"
                echo "  ❌ [$bench] mandatory autoscaler: no valid desired capacity before child completion" >&2
                return 1
            fi
            tracked_workers="$(_pool_ids "$out")"
            ready_workers="$(_ready_pool_ids "$out")"
            if [ -e "$out/benchmark-child.finished" ] \
                || [ -e "$out/autoscaler.runtime-completed" ]; then
                # A finished task cannot use future capacity. Existing owned
                # transitions still drain and retire; an unallocated demand
                # observation cannot reject the terminal task or delay release.
                desired_workers="$ready_workers"
            fi
            if [ "$ready_workers" -ge "$desired_workers" ] \
                && [ "$tracked_workers" = "$ready_workers" ] \
                && ! find "$out" -maxdepth 1 -name 'worker-*.pending' \
                    -print -quit 2>/dev/null | grep -q .; then
                # A verified guest can be stopped while run-bench-cloud still
                # collects its complete artifacts. Settle admitted workers,
                # but never forge the collector's independent finish marker.
                [ -e "$out/benchmark-child.finished" ] && break
            fi
            # No new capacity is admitted after runtime completion. Once all
            # admitted workers have settled, a retired worker's unmet demand
            # cannot recover by waiting out the provisioning deadline.
            if [ "$SECONDS" -ge "$terminal_deadline" ] || {
                [ "$tracked_workers" -lt "$desired_workers" ] \
                    && [ "$tracked_workers" = "$ready_workers" ] \
                    && ! find "$out" -maxdepth 1 -name 'worker-*.pending' \
                        -print -quit 2>/dev/null | grep -q .
            }; then
                if [ "$ready_workers" -lt "$desired_workers" ]; then
                    printf '%s\n' \
                        "worker capacity below desired: $ready_workers/$desired_workers workers queue-ready" \
                        > "$out/autoscaler.failed"
                    echo "  ❌ [$bench] mandatory autoscaler: worker capacity below desired: $ready_workers/$desired_workers workers queue-ready" >&2
                elif [ "$tracked_workers" != "$ready_workers" ] \
                    || find "$out" -maxdepth 1 -name 'worker-*.pending' \
                        -print -quit 2>/dev/null | grep -q .; then
                    printf '%s\n' \
                        "worker capacity incomplete: $ready_workers/$tracked_workers workers queue-ready" \
                        > "$out/autoscaler.failed"
                    echo "  ❌ [$bench] mandatory autoscaler: worker capacity incomplete: $ready_workers/$tracked_workers workers queue-ready" >&2
                elif [ ! -e "$out/benchmark-child.finished" ]; then
                    fail_autoscaler "artifact collector did not finish after verified guest runtime completion"
                    return 1
                else
                    printf '%s\n' \
                        "autoscaler did not settle committed capacity after child completion" \
                        > "$out/autoscaler.failed"
                    echo "  ❌ [$bench] mandatory autoscaler: committed capacity did not settle after child completion" >&2
                fi
                return 1
            fi
            sleep 0.2
        done
        if ! cat "$out/benchmark-child.finished" > "$completed_tmp" \
            || ! mv "$completed_tmp" "$out/autoscaler.completed-after-child"; then
            rm -f "$completed_tmp"
            printf '%s\n' "could not persist causal child-completion proof" > "$out/autoscaler.failed"
            return 1
        fi
        return 0
    }
    cleanup_autoscaler_jobs() {
        local job_pid
        local -a live_jobs
        live_jobs=()
        while read -r job_pid; do
            if [ -n "$job_pid" ] && [ "$job_pid" != "${metrics_proxy_pid:-}" ]; then
                live_jobs+=("$job_pid")
            fi
        done < <(jobs -pr)
        cloudbench_terminate_and_wait 30 "${live_jobs[@]:-}"
        cloudbench_proxy_stop metrics_proxy_pid || true
        if [ -n "${metrics_lease_owner_pid:-}" ] && [ -n "${metrics_lease_token:-}" ]; then
            release_autoscaler_metrics_owner \
                "$metrics_lease_owner_pid" "$metrics_lease_token" || true
        fi
    }
    trap cleanup_autoscaler_jobs EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    # Boot-launch intentionally configures the entire fleet while every primary
    # is stopped, then releases all starts together. A shared inventory generation
    # can still say `started` after the config mutation has committed `stopped`,
    # so it is not an ordering proof. Wait for run-bench-cloud to publish the exact
    # post-config start acceptance before spending the finite proxy attach budget.
    if [ "${CLOUDBENCH_BOOT_LAUNCH:-1}" = "1" ]; then
        while [ ! -f "$BOOT_CONFIG_BARRIER/release" ]; do sleep 0.2; done
        primary_start_deadline=$((SECONDS + ${CLOUDBENCH_READY_TIMEOUT:-600}))
        while [ ! -f "$out/post-config-start.accepted" ]; do
            if [ "$SECONDS" -ge "$primary_start_deadline" ]; then
                printf '%s\n' "primary post-config start was not accepted before autoscaler attachment" > "$out/autoscaler.failed"
                echo "  ❌ [$bench] mandatory autoscaler: primary post-config start was not accepted" >&2
                return 1
            fi
            sleep 0.2
        done
        IFS= read -r accepted_primary < "$out/post-config-start.accepted" || accepted_primary=""
        if [ "$accepted_primary" != "$cid" ]; then
            printf '%s\n' "primary start acceptance marker did not match allocated machine" > "$out/autoscaler.failed"
            echo "  ❌ [$bench] mandatory autoscaler: primary start acceptance marker mismatched" >&2
            return 1
        fi
    fi
    # The keyed inventory already carries Fly's provider-authoritative 6PN
    # address. Resolve it before spending the finite attach budget and target it
    # directly: newly cloned Machines can be reachable before their derived
    # .internal names have propagated through Fly DNS.
    for _ in $(seq 1 60); do pip="$(_machine_priv_ip "$cid")"; [ -n "$pip" ] && break; sleep 5; done
    if [ -z "$pip" ]; then
        printf '%s\n' "primary machine has no private IP" > "$out/autoscaler.failed"
        echo "  ❌ [$bench] mandatory autoscaler: primary machine has no private IP" >&2
        return 1
    fi
    # One persistent WireGuard tunnel replaces one `flyctl ssh` metrics read per
    # task every poll interval. At daily width that removes 180 Machines-API SSH
    # sessions/minute and the rate-limit/launch interference they caused.
    : > "$out/autoscaler-metrics-proxy.log"
    start_metrics_proxy() {  # start_metrics_proxy [timeout-seconds]
        local timeout="${1:-${CLOUDBENCH_DATA_PROXY_READY_TIMEOUT:-180}}"
        if cloudbench_shared_relay_enabled; then cloudbench_proxy_stop metrics_proxy_pid || return 1; fi
        metrics_started_at="$(date +%s)"
        while [ $(( $(date +%s) - metrics_started_at )) -lt "$timeout" ]; do
            # Token-wide release also recovers a claim helper interrupted after
            # atomic publication but before its port reached this shell variable.
            release_autoscaler_metrics_owner \
                "$metrics_lease_owner_pid" "$metrics_lease_token" \
                || { sleep 2; continue; }
            metrics_port=""
            claim_autoscaler_metrics_port metrics_port \
                "$metrics_lease_owner_pid" "$metrics_lease_token" \
                || { sleep 2; continue; }
            if cloudbench_shared_relay_enabled; then
                local mid="$cid"
                cloudbench_shared_proxy_start "$metrics_port" "$BOX_HEALTH_PORT" "$pip" "$out/autoscaler-metrics-proxy.log" metrics_proxy_pid metrics "$timeout" || return 1
                metrics_url="http://127.0.0.1:$metrics_port"
                return 0
            fi
            flyctl proxy "$metrics_port:$BOX_HEALTH_PORT" "$pip" \
                -a "$APP" --bind-addr 127.0.0.1 -q \
                >> "$out/autoscaler-metrics-proxy.log" 2>&1 &
            metrics_proxy_pid=$!
            # Force flyctl's lazy DNS resolution, then accept the tunnel only if
            # the process survives that first real data-plane connection.
            sleep 0.5
            curl --noproxy '*' -sS --max-time 2 -o /dev/null \
                "http://127.0.0.1:$metrics_port/metrics" 2>/dev/null || true
            sleep 0.5
            if fleet_job_running "$metrics_proxy_pid"; then
                metrics_url="http://127.0.0.1:$metrics_port"
                return 0
            fi
            wait "$metrics_proxy_pid" 2>/dev/null || true
            metrics_proxy_pid=""
            release_autoscaler_metrics_owner \
                "$metrics_lease_owner_pid" "$metrics_lease_token" || true
            metrics_port=""
            sleep 2
        done
        return 1
    }
    # Before the first desired-capacity observation the guest may legitimately
    # still be restoring its stack, and Fly can drop an otherwise valid proxy
    # while no process listens on /metrics yet. Retry in short, observable
    # windows under the child+inventory lifecycle instead of imposing an
    # unrelated 30/180-second transport deadline on a 2160-second bootstrap.
    until start_metrics_proxy 30; do
        if [ -e "$out/benchmark-child.finished" ]; then
            complete_autoscaler_after_child
            return $?
        fi
        inventory_machine_exists "$cid" || inventory_status=$?
        if [ "$inventory_status" -ne 0 ]; then
            if [ "$inventory_status" -eq 75 ]; then
                inventory_status=0
                echo "  ⚠️ [$bench] mandatory autoscaler: provider inventory temporarily unavailable during proxy startup; retrying" >&2
                sleep 2
                continue
            fi
            if [ "$inventory_status" -eq 2 ]; then
                fail_autoscaler "shared provider inventory is unhealthy during proxy startup"
            else
                fail_autoscaler "primary disappeared from provider inventory before child completion"
            fi
            return 1
        fi
        inventory_status=0
        echo "  ⚠️ [$bench] mandatory autoscaler: metrics proxy unavailable before first desired count; retrying" >&2
        sleep 2
    done
    echo "  🛰️ [$bench] autoscaler metrics via data plane :$metrics_port → fly:$BOX_HEALTH_PORT"
    # Wait for the box /metrics to answer (stack up) before scaling. Inventory
    # Transient feed loss pauses capacity changes under the existing child
    # lifecycle. Invalid ownership or a missing primary still fails closed.
    while :; do
        if [ -e "$out/benchmark-child.finished" ]; then
            complete_autoscaler_after_child
            return $?
        fi
        ready_reconcile_rc=0
        reconcile_worker_ready_outcomes "$out" || ready_reconcile_rc=$?
        if [ "$ready_reconcile_rc" -ne 0 ]; then
            # The child marker can land between the loop-head lifecycle check
            # and ledger acquisition. Hand a busy ledger to the bounded terminal
            # reconciler instead of misclassifying that race as durable failure.
            if [ "$ready_reconcile_rc" -eq 75 ] \
                && [ -e "$out/benchmark-child.finished" ]; then
                complete_autoscaler_after_child
                return $?
            fi
            fail_autoscaler "could not reconcile worker readiness outcomes"
            return 1
        fi
        inventory_machine_exists "$cid" || inventory_status=$?
        if [ "$inventory_status" -ne 0 ]; then
            if [ -e "$out/benchmark-child.finished" ]; then
                complete_autoscaler_after_child
                return $?
            fi
            if [ "$inventory_status" -eq 75 ]; then
                inventory_status=0
                scale_down_target=""
                scale_down_since=""
                echo "  ⚠️ [$bench] mandatory autoscaler: provider inventory temporarily unavailable during the run; retrying" >&2
                sleep "$AUTOSCALE_POLL"
                continue
            fi
            if [ "$inventory_status" -eq 2 ]; then
                fail_autoscaler "shared provider inventory is unhealthy during the run"
            else
                fail_autoscaler "primary disappeared from provider inventory before child completion"
            fi
            return 1
        fi
        inventory_status=0
        if [ -s "$out/autoscaler.failed" ]; then
            return 1
        fi
        if { cloudbench_shared_relay_enabled && ! cloudbench_proxy_alive metrics_proxy_pid; } || { ! cloudbench_shared_relay_enabled && ! fleet_job_running "$metrics_proxy_pid"; }; then
            scale_down_target=""
            scale_down_since=""
            metrics_proxy_pid=""
            if ! start_metrics_proxy 30; then
                if [ -e "$out/benchmark-child.finished" ]; then
                    complete_autoscaler_after_child
                    return $?
                fi
                # A transport retry window is an observation boundary, not the
                # task deadline. The next loop rechecks exact inventory/child
                # ownership before making any further capacity decision.
                if [ -e "$out/autoscaler.ready" ]; then
                    echo "  ⚠️ [$bench] mandatory autoscaler: metrics proxy unavailable during the run; retrying" >&2
                else
                    echo "  ⚠️ [$bench] mandatory autoscaler: metrics proxy unavailable before first desired count; retrying" >&2
                fi
                sleep "$AUTOSCALE_POLL"
                continue
            fi
            echo "  🛰️ [$bench] autoscaler metrics proxy recovered on :$metrics_port"
        fi
        local desired want cur; desired="$(_box_desired "$metrics_url")"
        if [ -z "$desired" ]; then
            # A missing observation cannot contribute to continuous low-target
            # confirmation. Require a fresh complete interval after recovery.
            scale_down_target=""
            scale_down_since=""
            # The child marker can land between the loop-head check and this
            # scrape. Recheck before advancing the terminal failure counter.
            if [ -e "$out/benchmark-child.finished" ]; then
                complete_autoscaler_after_child
                return $?
            fi
            if [ -e "$out/autoscaler.ready" ]; then
                # Metrics belong to the guest runtime, not the longer-lived
                # artifact collector. Only an authenticated exact run+machine
                # cleanup seal may end decisions before the child exits.
                if guest_runtime_completed; then
                    complete_autoscaler_after_child verified-runtime
                    return $?
                fi
                scrape_failures=$((scrape_failures + 1))
                if [ $((scrape_failures % 6)) -eq 0 ]; then
                    echo "  ⚠️ [$bench] mandatory autoscaler: metrics temporarily unreadable for $scrape_failures consecutive polls; retrying" >&2
                fi
            fi
            sleep "$AUTOSCALE_POLL"
            continue
        fi
        scrape_failures=0
        # Only explicit qualification changes the controller demand floor.
        # Keep the actual guest metric intact in logs and ordinary execution.
        want=$((desired - 1)); [ "$want" -lt 0 ] && want=0
        if [ "${QUALIFY_WORKER:-0}" = 1 ] && [ "$want" -lt 1 ]; then want=1; fi
        [ "$want" -gt $((AUTOSCALE_MAX - 1)) ] && want=$((AUTOSCALE_MAX - 1))
        # Publish outstanding demand before readiness or provider allocation.
        # Final acceptance therefore cannot see tracked=ready=0 and pass while
        # clone_machine_target is still retrying or hung for desired capacity.
        if ! printf '%s\n' "$want" > "$out/desired-worker-count.tmp" \
            || ! mv "$out/desired-worker-count.tmp" "$out/desired-worker-count"; then
            printf '%s\n' "could not persist desired worker capacity" > "$out/autoscaler.failed"
            echo "  ❌ [$bench] mandatory autoscaler: could not persist desired worker capacity" >&2
            return 1
        fi
        if [ ! -e "$out/autoscaler.ready" ]; then
            : > "$out/autoscaler.ready"
            echo "  ✅ [$bench] mandatory autoscaler observed desired_machine_count=$desired"
        fi
        cur="$(_pool_ids "$out")"
        if [ "$want" -gt "$cur" ]; then
            scale_down_target=""
            scale_down_since=""
            local n=$((want - cur))
            echo "  ⤴️  [$bench] scale up +$n (desired=$desired, pool=$cur)"
            for _ in $(seq 1 "$n"); do
                local provision_status=0
                provision_worker "$bench" "$ws" "$cid" "$pip" "$sim" "$out" "$runtime_run_token" \
                    || provision_status=$?
                # Unknown inventory admits nothing. Observe again on the normal
                # poll, with child/owner lifecycle checked at the next loop head.
                [ "$provision_status" -ne 75 ] || break
                [ "$provision_status" -eq 0 ] || return "$provision_status"
            done
        elif [ "$want" -lt "$cur" ]; then
            autoscaler_monotonic_seconds scale_down_now
            if [ "$scale_down_target" != "$want" ] \
                || [ -z "$scale_down_since" ] \
                || [ "$scale_down_now" -lt "$scale_down_since" ]; then
                scale_down_target="$want"
                scale_down_since="$scale_down_now"
                echo "  ⏳ [$bench] holding lower target=$desired for ${AUTOSCALE_SCALE_DOWN_CONFIRM_SECONDS}s confirmation"
            elif [ $((scale_down_now - scale_down_since)) \
                -ge "$AUTOSCALE_SCALE_DOWN_CONFIRM_SECONDS" ]; then
                if pool_has_pending_worker "$out"; then
                    echo "  ⏳ [$bench] retaining committed pending worker before scale-down"
                else
                    local n=$((cur - want))
                    echo "  ⤵️  [$bench] scale down -$n (desired=$desired, pool=$cur)"
                    for _ in $(seq 1 "$n"); do
                        local wid
                        if ! wid="$(cancel_worker_for_scale_down "$out" "$want")"; then
                            printf '%s\n' "could not select worker for scale-down" > "$out/autoscaler.failed"
                            echo "  ❌ [$bench] mandatory autoscaler: could not select worker for scale-down" >&2
                            return 1
                        fi
                        [ -n "$wid" ] || break
                        # Only drop the id from tracking once the destroy is
                        # CONFIRMED — an untracked-but-alive machine is a
                        # billed-forever zombie. On failure keep it listed and
                        # retry on the next autoscaler tick.
                        if ! cleanup_failed_worker "$out" "$wid"; then
                            printf '%s\n' "worker $wid could not be destroyed during scale-down" > "$out/autoscaler.failed"
                            echo "  ❌ [$bench] mandatory autoscaler: worker $wid could not be destroyed during scale-down" >&2
                            return 1
                        fi
                    done
                fi
            fi
        else
            scale_down_target=""
            scale_down_since=""
        fi
        ready_reconcile_rc=0
        reconcile_worker_ready_outcomes "$out" || ready_reconcile_rc=$?
        if [ "$ready_reconcile_rc" -ne 0 ]; then
            if [ "$ready_reconcile_rc" -eq 75 ] \
                && [ -e "$out/benchmark-child.finished" ]; then
                complete_autoscaler_after_child
                return $?
            fi
            fail_autoscaler "could not reconcile worker readiness outcomes"
            return 1
        fi
        reconcile_worker_failure_outcomes "$bench" "$out" \
            || fail_autoscaler "could not reconcile worker failure outcomes"
        # The fake-controller regression for terminal proof needs to hold the
        # exact state "capacity fully accepted, child not yet complete" without
        # relying on this loop's scheduler timing. This branch is unreachable
        # outside the explicit fake Fly environment used by the harness.
        if [ -n "${CLOUDBENCH_FAKE_DIR:-}" ] \
            && [ "${CLOUDBENCH_TEST_HOLD_AUTOSCALER_AFTER_READY:-0}" = "1" ]; then
            local test_ready_workers test_tracked_workers
            test_ready_workers="$(_ready_pool_ids "$out")"
            test_tracked_workers="$(_pool_ids "$out")"
            if [ "$test_ready_workers" -ge "$want" ] \
                && [ "$test_tracked_workers" = "$test_ready_workers" ] \
                && ! find "$out" -maxdepth 1 -name 'worker-*.pending' \
                    -print -quit 2>/dev/null | grep -q . \
                && ready_workers_operational "$out"; then
                # The boundary must survive the controller's whole final
                # acceptance pass, so the normal path holds here until teardown
                # signals this process. The release marker is the harness's
                # explicit escape hatch, and the deadline is only an anti-wedge
                # backstop far beyond any scenario's runtime — never the
                # synchronization this case depends on.
                : > "$out/autoscaler.test-held-after-ready"
                local test_hold_deadline=$((SECONDS + 600))
                while [ ! -e "$out/autoscaler.test-release-after-ready" ] \
                    && [ "$SECONDS" -lt "$test_hold_deadline" ]; do
                    sleep 0.2
                done
            fi
        fi
        sleep "$AUTOSCALE_POLL"
    done
}

# ── Epoch-0 substrate preflight (fail closed before capability provisioning) ─
# /descend fleets historically burned wall-clock on INFRA because capability
# benches launched against a broken substrate. Pin a recent infra-canary PASS
# stamp before cloning so every capability fleet — including single-bench
# outcome-proof reruns — proves bring-up → strict barrier → DONE with zero
# exclusions first. N=1 used to skip this gate and still died on INFRA.
fleet_infra_canary_preflight() {
    local stamp ttl age n rc lock canary
    if [ "${INFRA_PROBE:-0}" = "1" ]; then
        return 0
    fi
    if [ "${CLOUDBENCH_SKIP_INFRA_CANARY_PREFLIGHT:-0}" = "1" ]; then
        return 0
    fi
    if [ "${CLOUDBENCH_INFRA_CANARY_PREFLIGHT_ACTIVE:-0}" = "1" ]; then
        return 0
    fi
    if [ -n "${CLOUDBENCH_FAKE_DIR:-}" ]; then
        echo "🛡  infra canary preflight: skipped under CLOUDBENCH_FAKE_DIR"
        return 0
    fi
    if [ "${RECOVER_STALE_ONLY:-0}" = "1" ] || [ -n "${PROVISION_POOL:-}" ]; then
        return 0
    fi
    stamp="${FLEET_INFRA_CANARY_STAMP:-$ROOT_DIR/.context/fleet-infra-canary.last-pass}"
    ttl="${FLEET_INFRA_CANARY_TTL_SECONDS:-3600}"
    case "$ttl" in
        ''|*[!0-9]*|0) ttl=3600 ;;
    esac
    # A campaign must check its own abort/failure even when another cohort has
    # a fresh global PASS. The transaction helper owns that check.
    if [ -z "${RUN_BENCH_CAMPAIGN_BARRIER_DIR:-}" ] && [ -f "$stamp" ]; then
        age=$(( $(date +%s) - $(stat -c %Y "$stamp" 2>/dev/null || echo 0) ))
        if [ "$age" -ge 0 ] && [ "$age" -lt "$ttl" ]; then
            echo "🛡  infra canary preflight: stamp fresh (${age}s < ${ttl}s) — $stamp"
            return 0
        fi
    fi
    n="${FLEET_INFRA_CANARY_PREFLIGHT_N:-2}"
    case "$n" in
        ''|*[!0-9]*|0) n=2 ;;
    esac
    mkdir -p "$ROOT_DIR/.context"
    lock="${FLEET_INFRA_CANARY_LOCK:-$ROOT_DIR/.context/fleet-infra-canary-preflight.transaction.lock}"
    canary="${CLOUDBENCH_SCRIPT_SNAPSHOT:-$ROOT_DIR/scripts}/run-fleet-infra-canary"
    # The helper holds a shared transaction lock while it rechecks the stamp,
    # runs the canary, and stamps PASS. Its lock is distinct from the nested
    # controller lifecycle lock, so nested fleet entry cannot self-deadlock.
    if CLOUDBENCH_INFRA_CANARY_COLD_BOOTSTRAP="${POOL_COLD_BOOTSTRAP:-0}" \
        CLOUDBENCH_INFRA_CANARY_REF="${BENCH_REF:-}" \
        python3 -S "$INFRA_CANARY_PREFLIGHT_SCRIPT" \
        --stamp "$stamp" \
        --lock "$lock" \
        --ttl-seconds "$ttl" \
        --width "$n" \
        --canary "$canary" \
        --nested-controller-lock "cloudbench-controller-infra-canary-preflight.lock"; then
        rc=0
    else
        rc=$?
        echo "❌ infra canary preflight FAILED (exit=$rc) — refusing capability fleet (INFRA)" >&2
        return "$rc"
    fi
    return 0
}
fleet_infra_canary_preflight || exit $?

# The preflight starts a nested fleet with its own capacity reservation. Reserve
# this fleet only after it exits, or its canary counts our pending slots twice
# and can deadlock against the app Machine ceiling before either fleet starts.
# Campaign parent → birth/token-fenced native feed → unchanged capacity guard.
# Borrow before admission; temporary feed loss shares its existing wait clock.
if [ -n "${CLOUDBENCH_CAMPAIGN_INVENTORY_DIR:-}" ]; then
    inventory_status=0
    start_machines_snapshot_loop || inventory_status=$?
    case "$inventory_status" in 0|75) ;; *) exit "$inventory_status" ;; esac
fi
admit_app_capacity_with_wait 1 || exit 1

# ── Clone one machine per bench + launch its isolated run ────────────────────
mkdir -p "$FLEET_DIR"
: > "$CLAIMED_POOL_FILE"
start_admitted_machines_snapshot_loop || exit 1
echo ""
echo "═══ run-bench-fleet — ${#BENCHES[@]} bench(es), one isolated machine each ═══"
# A pooled primary can have a smaller volume than the legacy warm donor. Worker
# clones inherit their primary's volume size, so the warm donor's 40 GB snapshot
# is not admissible for a 20 GB pool primary. Cut one exact pool-volume snapshot
# on first use and cache its immutable ID across slices. This happens before
# any task starts, never once per autoscaled worker or benchmark.
WARM_SOURCE_SIZE_GB="$(machine_volume_size_gb "$WARM_ID" "$VOL_ID")" || WARM_SOURCE_SIZE_GB=""
case "$WARM_SOURCE_SIZE_GB" in ''|0|*[!0-9]*)
    echo "❌ could not verify warm source volume size for worker clones" >&2; exit 1 ;;
esac
WORKER_POOL_SNAPSHOT_SIZE_GB=""
WORKER_POOL_SNAPSHOT_ID=""
if [ -s "$POOL_IDS_FILE" ]; then
    worker_snapshot_binding="$(python3 "$WORKER_SNAPSHOT_HELPER" \
        --pool-ids "$POOL_IDS_FILE" \
        --cache "$POOL_IDS_FILE.worker-snapshot.json" \
        --app "$APP" --warm-volume-id "$VOL_ID" \
        --warm-snapshot-id "$SNAP_ID")" || exit 1
    read -r WORKER_POOL_SNAPSHOT_SIZE_GB WORKER_POOL_SNAPSHOT_ID <<< "$worker_snapshot_binding"
    case "$WORKER_POOL_SNAPSHOT_SIZE_GB:$WORKER_POOL_SNAPSHOT_ID" in
        *[!a-zA-Z0-9_:.-]*|:)
            echo "❌ worker pool snapshot binding malformed" >&2; exit 1 ;;
    esac
    [ -n "$WORKER_POOL_SNAPSHOT_SIZE_GB" ] && [ -n "$WORKER_POOL_SNAPSHOT_ID" ] || {
        echo "❌ worker pool snapshot binding missing" >&2; exit 1;
    }
    echo "🧊 worker clone source: ${WORKER_POOL_SNAPSHOT_SIZE_GB} GB pool snapshot $WORKER_POOL_SNAPSHOT_ID"
fi
# ── ONE aggregated batch dashboard (served; never auto-opens a browser) ─────
# Merge every bench's live report-card.json into a single card (N per_task rows,
# summed cost + tokens) and serve it on DASH_BASE. Each row's agent_url already
# points at its own bench's /open-agent (localhost:<bench-port>), so clicking
# "open" from the batch view routes to the right isolated machine's viewer.
UNIFIED_DIR="$FLEET_DIR/_batch"
mkdir -p "$UNIFIED_DIR"
printf '%s' "${CODE_SUMMARY:-}" > "$UNIFIED_DIR/code.txt"   # shown in the dashboard header
cp -f "$ROOT_DIR/agents/benchmarks/dashboard.html" "$UNIFIED_DIR/dashboard.html" 2>/dev/null || true
# NOTE: never kill whatever holds DASH_BASE — that is the ONE persistent central
# hub, shared across every run + carrying the user's open tab. It picks up this
# new run dir on its next scan. We (re)start it below ONLY if it isn't already up.
# benches.json was frozen with the complete requested task list at fire time.
# Live and terminal projections consume that same manifest, including when
# provisioning exits before every child has an output directory.
# Revalidate/restart the identity-owned hub BEFORE the aggregator captures
# DASH_BASE. If the early hub disappeared and a foreign workspace took its
# port, every generated agent URL must use the newly selected port.
start_central_hub || exit 1
require_central_hub_visibility || exit 1
HUB_URL="http://localhost:$DASH_BASE/"
RUN_URL="http://localhost:$DASH_BASE/run/$RUN_ID/dashboard.html"
(
    exec env FLEET_DIR="$FLEET_DIR" UNIFIED_DIR="$UNIFIED_DIR" DASH_BASE="$DASH_BASE" \
        ROOT_DIR="$ROOT_DIR" SELF_MANAGED_HUB_RUN="$SELF_MANAGED_HUB_RUN" \
        FLEET_CONTROLLER_STARTED_EPOCH="$FLEET_CONTROLLER_STARTED_EPOCH" \
        python3 -u - "$UNIFIED_DIR/report-card.json" <<'PY'
import json, os, sys
from pathlib import Path
from datetime import datetime, timezone
from urllib.parse import parse_qs, urlparse
import time
import traceback
sys.path.insert(0, os.path.join(os.environ["ROOT_DIR"], "agents"))


def aggregate_tick():
    out = sys.argv[1]; fleet = os.environ["FLEET_DIR"]; dash_base = os.environ.get("DASH_BASE", "8765")
    # Startup-phase tracker (stdlib-only) → per-row step timeline while queued.
    try:
        from benchmarks.fleet_startup_phase import startup_state
    except Exception:
        startup_state = None
    benches = json.load(open(os.path.join(os.environ["UNIFIED_DIR"], "benches.json")))
    per_task = []
    ci = {"agents_llm_usd": 0.0, "wmh_grounding_usd": 0.0, "infra_usd": 0.0, "total_usd": 0.0}
    mi = {"tokens_in": 0, "tokens_out": 0}
    modes, elapsed = set(), 0.0
    for b in benches:
        name = b["name"]; default_mode = "simulate" if b.get("mode") == "SIM" else "real"
        card = None
        try: card = json.load(open(os.path.join(fleet, name, "cloudbench-live", "report-card.json")))
        except Exception: card = None
        row = None
        if card:
            rows = card.get("per_task") or []
            row = next((r for r in rows if r.get("name") == name), rows[0] if rows else None)
        if row is None:   # seed a queued placeholder so ALL N benches always show
            row = {"name": name, "status": "queued", "duration_s": None, "cost_usd": None,
                   "agent_url": None, "tokens_in": 0, "tokens_out": 0,
                   "world_model_mode": default_mode, "infra_usd": None}
        row.setdefault("world_model_mode", default_mode)
        directory = Path(fleet) / name
        if (row.get("status") in ("queued", "starting", "running")
                and (directory / "benchmark-child.finished").is_file()
                and not (directory / "cloudbench-run.json").is_file()):
            row["status"] = "error"
        if (directory / "bench-e2e.finished-epoch").exists():
            row["lifecycle_stage"] = "released"
        elif (directory / "guest-shutdown.confirmed").exists() or (directory / "benchmark-child.finished").exists():
            row["lifecycle_stage"] = "teardown"
        elif row.get("status") in ("passed", "failed", "error"):
            row["lifecycle_stage"] = "evaluated"
        elif row.get("status") == "running":
            row["lifecycle_stage"] = "running"
        elif (directory / "barrier.ready.observed").exists():
            row["lifecycle_stage"] = "ready"
        elif (directory / "bench-e2e.started-epoch").exists():
            row["lifecycle_stage"] = "starting"
        else:
            row["lifecycle_stage"] = "queued"
        # Route "open" through the DURABLE batch resolver (DASH_BASE) — never the
        # per-bench port that dies with the run. The resolver serves from local run
        # data, so the link can't go dead.
        url = row.get("agent_url")
        if url:
            try:
                aid = (parse_qs(urlparse(url).query).get("agent-id") or [""])[0]
            except Exception:
                aid = ""
            if aid:
                row["agent_url"] = f"http://localhost:{dash_base}/open-agent?agent-id={aid}"
        # While queued (before the on-box run_benchmark emits a card), surface the
        # concrete startup step + expected/elapsed so the dashboard shows progress.
        if row.get("status") == "queued" and startup_state is not None:
            try:
                row["startup"] = startup_state(
                    Path(fleet) / name / "fleet-child.log",
                    Path(fleet) / name / ".startup-state.json",
                )
            except Exception:
                pass
        per_task.append(row)
        if card:
            cost = card.get("cost") or {}
            for k in ci:
                v = cost.get(k)
                if isinstance(v, (int, float)): ci[k] += v
            md = card.get("metadata") or {}
            mi["tokens_in"] += int(md.get("tokens_in") or 0); mi["tokens_out"] += int(md.get("tokens_out") or 0)
            elapsed = max(elapsed, float(card.get("elapsed_s") or 0))
        if row.get("world_model_mode"): modes.add(row["world_model_mode"])
    st = lambda s: sum(1 for t in per_task if t.get("status") == s)
    passed, failed = st("passed"), st("failed") + st("error")
    running = sum(1 for t in per_task if t.get("status") == "running")
    queued = sum(1 for t in per_task if t.get("status") == "queued")
    try:
        code_summary = open(os.path.join(os.environ["UNIFIED_DIR"], "code.txt")).read().strip()
    except Exception:
        code_summary = ""
    card = {
        "run_id": "batch",
        "timestamp": datetime.fromtimestamp(float(os.environ["FLEET_CONTROLLER_STARTED_EPOCH"]), timezone.utc).isoformat(),
        "code": code_summary,
        "elapsed_s": elapsed,
        "world_model_mode": (list(modes)[0] if len(modes) == 1 else "mixed") if modes else "real",
        "tasks": {"total": len(benches), "running": running, "completed": passed + failed, "queued": queued},
        "results": {"passed": passed, "failed": failed, "transient": st("transient"),
                    "success_rate": round(passed / max(1, passed + failed), 3)},
        "cost": {**{k: round(v, 4) for k, v in ci.items()}, "fast_cache_hit_rate": None},
        "metadata": mi,
        "infra": None,
        "per_task": per_task,
    }
    target = Path(out)
    temporary = target.with_name(f".{target.name}.tmp.{os.getpid()}")
    try:
        with temporary.open("w") as f:
            json.dump(card, f)
            f.write("\n")
        temporary.replace(target)
    finally:
        temporary.unlink(missing_ok=True)
    if os.environ.get("SELF_MANAGED_HUB_RUN") == "1":
        from benchmarks.hub_upload import publish_live_report_card
        from benchmarks.outcome_publication import acknowledge_published
        parent = os.environ["BENCHMARK_HUB_PARENT_RUN_ID"]
        if publish_live_report_card(card, run_id=parent,
                                   state_path=Path(out).with_name("hub-live-publication.json")):
            acknowledge_published(card, run_id=parent, fleet_dir=Path(fleet))


while True:
    try:
        aggregate_tick()
    except SystemExit as error:
        # A zero-status tick exit was successful in the former Bash loop.
        if error.code not in (None, 0):
            traceback.print_exc()
            print("⚠️ live benchmark publication failed", file=sys.stderr, flush=True)
    except Exception:
        traceback.print_exc()
        print("⚠️ live benchmark publication failed", file=sys.stderr, flush=True)
    # Keep the original delay AFTER each completed or failed iteration.
    # TERM/KeyboardInterrupt remain owner-stop signals, never tick failures.
    time.sleep(1)
PY
) & UNIFIED_AGG_PID=$!

# ── Phase 1: provision every bench's isolated machine CONCURRENTLY ───────────
if [ "${CLOUDBENCH_POOL_DYNAMIC_VM_SHAPE:-0}" = "1" ] \
    && [ "${CLOUDBENCH_BOOT_LAUNCH:-1}" != "1" ]; then
    echo "❌ dynamic pool VM shape requires verified boot-launch updates" >&2
    exit 2
fi
# Cloning 28 fresh volumes-from-snapshot one-at-a-time serialized provisioning
# into a 30-50min window — the window where every clone hang, volume race, and
# cross-workspace contention event landed and aborted the batch. Fan the
# claim/clone out in parallel: each attempt runs in its own subshell and writes
# its OWN per-bench ledger (primary.ids/.names — reaped by cleanup's globs), so
# there is no shared-ledger race. The whole fleet is now provisioned in ~one
# clone's wall-time (target: < 3 min) instead of the sum of 28.
echo ""
write_startup_card "provisioning ${#BENCHES[@]} isolated machines"
echo "⏳ provisioning ${#BENCHES[@]} isolated machine(s) concurrently (claim-or-clone) ..."
# Reuse the controller-wide provision PID registry so cleanup can terminate
# precisely these children if the controller is signalled mid-provision.
for bench in "${BENCHES[@]}"; do
    out="$FLEET_DIR/$bench"
    # Keep the start recorded before startup checks; never reset it later.
    fleet_mark_bench_e2e_started "$bench" || exit 1
    (
        provision_primary_machine "$bench" "$out"
    ) &
    PROVISION_PIDS+=("$!")
    # Stagger the clone starts so N benches don't hammer the Fly Machines API in
    # the same instant (the direct cause of `resource_exhausted: rate limit
    # exceeded` → clones that exhaust their retries and drop from the batch).
    # Still fully concurrent — every clone stays in flight together — the burst is
    # just spread across a few seconds instead of fired simultaneously.
    sleep "${CLOUDBENCH_CLONE_LAUNCH_STAGGER_SECONDS:-0.4}"
done
for pp in "${PROVISION_PIDS[@]}"; do wait "$pp" 2>/dev/null || true; done
# Provision children are fully reaped; retain no stale PIDs across the
# potentially multi-hour benchmark phase.
PROVISION_PIDS=()

# ── Phase 2: launch each provisioned bench's isolated run (fast; backgrounded) ─
FLEET_NATIVE_REAP_ENABLED=0
if [ "${CLOUDBENCH_BOOT_LAUNCH:-1}" = 1 ] && [ "${INFRA_PROBE:-0}" != 1 ] \
    && [ "${SKIP_AUTOSCALER:-0}" != 1 ] && [ "$KEEP_CLONES" != 1 ]; then
    if fleet_validate_reap_cohort "$FLEET_REGISTRY_DIR" \
        && fleet_retirement_index init && fleet_native_reap_open; then
        :
    else
        FLEET_NATIVE_REAP_ENABLED=0
        echo "⚠️ early primary retirement unavailable; preserving the final fleet cleanup path" >&2
    fi
fi
BOOT_CONFIG_BARRIER="$FLEET_DIR/.boot-config-barrier"
rm -rf "$BOOT_CONFIG_BARRIER" 2>/dev/null || true
mkdir -p "$BOOT_CONFIG_BARRIER/ready"
# One bench's run-bench-cloud child (and its mandatory autoscaler) for the
# Machine recorded in <out>/.cid. Appends a new child slot, or reuses an
# existing slot (same bench, port and run token; new PID and Machine) when a
# host-unresponsive primary is replaced before the boot-config barrier
# releases. Bash 3.2 portable: no namerefs.
launch_fleet_bench_child() {  # <bench-index> <bench> [existing-child-slot]
    local i="$1" bench="$2" slot="${3:-}"
    # Default from the batch's preflighted catalog snapshot; --sim-on is an
    # explicit override. No mutable catalog read happens after provisioning.
    catalog_wmm="${CATALOG_MODES[$i]}"
    mode_label="REAL"; [ "$catalog_wmm" = "simulate" ] && mode_label="SIM"
    is_sim_on "$bench" && mode_label="SIM"
    mode_flag="--no-simulate"; [ "$mode_label" = "SIM" ] && mode_flag="--simulate"
    # DASH_BASE is reserved for the ONE aggregated batch dashboard; per-bench
    # viewers live above it (their /open-agent deep-links back the batch rows).
    port=$((DASH_BASE + (i + 1) * 20))
    out="$FLEET_DIR/$bench"
    src=""; cid=""
    if [ -f "$out/.cid" ]; then
        read -r src cid < "$out/.cid" || true
    fi

    echo ""
    if [ -z "$cid" ]; then
        echo "❌ [$bench] provisioning failed (no machine) — skipping"
        return 1
    fi
    cold_primary=0
    if [ "$src" = archived-reuse ]; then cold_primary=1; fi
    if [ "$src" = pool ]; then
        cold_primary="$(primary_cold_bootstrap_requested "$out" "$cid")" || {
            echo "❌ [$bench] cold/warm claim intent differs from this exact task; refusing boot" >&2; exit 1;
        }
    fi
    if [ "$src" = archived-reuse ]; then
        echo "▶️  [$bench] retained Machine $cid; same physical volume, new isolated task generation (mode=$mode_label, dash=$port)"
    elif [ "$src" = "pool" ]; then
        echo "▶️  [$bench] claimed POOL machine $cid (no fork, mode=$mode_label, dash=$port)"
    else
        echo "▶️  [$bench] cloned isolated machine $cid (mode=$mode_label, dash=$port)"
    fi
    case " ${CHILD_MACHINE[*]:-} " in
        *" $cid "*) echo "❌ isolation violation: machine $cid was allocated twice" >&2; exit 1 ;;
    esac
    # run-bench-cloud owns the clone lifecycle: it waits for snapshot storage to
    # become mountable, then requests the created → started transition.
    echo "   ✅ machine=$cid allocated → launching run-bench-cloud (isolated) ..."
    pool_boot_vm_size=""
    pool_boot_vm_memory=""
    if [ "${CLOUDBENCH_BOOT_TRANSPORT:-update}" = staged ]; then
        pool_boot_vm_size="$(primary_vm_size_for_bench "$bench")"
        pool_boot_vm_memory="$(primary_vm_memory_for_bench "$bench")"
    fi
    if [ "$src" = "pool" ] \
        && [ "${CLOUDBENCH_POOL_DYNAMIC_VM_SHAPE:-0}" = "1" ]; then
        desired_vm_size="$(primary_vm_size_for_bench "$bench")"
        desired_vm_memory="$(primary_vm_memory_for_bench "$bench")"
        desired_vm_cpus="$(printf '%s' "$desired_vm_size" | sed -nE 's/.*-([0-9]+)x$/\1/p')"
        desired_vm_kind="${desired_vm_size%%-*}"
        current_pool_shape="$(awk -v id="$cid" '$1 == id { print $2, $3, $4; exit }' "$FLEET_DIR/pool-shapes.tsv")"
        if [ "$current_pool_shape" != "$desired_vm_kind $desired_vm_cpus $desired_vm_memory" ]; then
            pool_boot_vm_size="$desired_vm_size"
            pool_boot_vm_memory="$desired_vm_memory"
        fi
    fi

    # Deterministic per-bench workspace → deterministic Temporal queue, so the
    # autoscaler knows which queue its worker pool must poll. It is bound to
    # this fleet's random owner token, never the controller PID: sharded
    # disposable controllers reuse PIDs across hosts on one shared namespace.
    if ! local_ws="$(cloudbench_fleet_workspace_name "$bench" "$FLEET_OWNER_TOKEN" "$i")"; then
        echo "❌ [$bench] could not derive an isolated Temporal workspace" >&2
        exit 1
    fi
    bench_run_timeout="$(bench_execution_budget "${CATALOG_TIMEOUTS[$i]}" "$RUN_TIMEOUT" "$RUN_TIMEOUT_OPERATOR_SET")"
    bench_backstop="$(bench_execution_budget "${CATALOG_TIMEOUTS[$i]}" "$BENCHMARK_WALL_CLOCK_BACKSTOP_SECONDS" "$BACKSTOP_OPERATOR_SET")"
    bench_child_timeout="$bench_run_timeout"
    if [ "$SYNCHRONIZED_START" = "1" ]; then
        bench_child_timeout=$((bench_run_timeout + START_BARRIER_WAIT_SECONDS))
    fi
    if [ "$bench_run_timeout" != "$RUN_TIMEOUT" ] || [ "$bench_backstop" != "$BENCHMARK_WALL_CLOCK_BACKSTOP_SECONDS" ]; then
        echo "   ⏱️  [$bench] catalog timeout ${CATALOG_TIMEOUTS[$i]}s: run timeout ${bench_run_timeout}s, execution backstop ${bench_backstop}s"
    fi
    # Bind the guest runtime and its autoscaler to one owner-derived token.
    # The supervisor's separate finish marker still means the entire collector
    # and its descendants have exited, including on controller cancellation.
    BENCHMARK_WALL_CLOCK_BACKSTOP_SECONDS="$bench_backstop" \
    CLOUDBENCH_WORKSPACE_NAME="$local_ws" \
    CLOUDBENCH_FLEET_RUN_TOKEN="$FLEET_OWNER_TOKEN-$i" \
    CLOUDBENCH_FLEET_RUN_ID="$RUN_ID" \
    CLOUDBENCH_ENV_VERIFIED=1 \
    CLOUDBENCH_ARCHIVED_REUSE_PROOF_FILE="$([ "$src" = archived-reuse ] && printf '%s' "$out/archived-reuse-proof.json")" \
    CLOUDBENCH_STORAGE_READY="$([ "$src" = "pool" ] && printf 1 || printf 0)" \
    CLOUDBENCH_MACHINE_RECORD="$INVENTORY_INDEX/current/machines/$cid" \
    CLOUDBENCH_INVENTORY_OWNER_PID="$SNAPSHOT_LOOP_PID" \
    CLOUDBENCH_INVENTORY_PUBLISHER_TOKEN="$SNAPSHOT_LOOP_TOKEN" \
    CLOUDBENCH_INVENTORY_HEALTH="$INVENTORY_INDEX/current/health" \
    CLOUDBENCH_START_BARRIER="$([ "$SYNCHRONIZED_START" = "1" ] && printf '%s' "$RUN_ID")" \
    CLOUDBENCH_BARRIER_TOKEN="$BARRIER_RELEASE_TOKEN" \
    CLOUDBENCH_START_BARRIER_WAIT_SECONDS="$START_BARRIER_WAIT_SECONDS" \
    CLOUDBENCH_FIRST_RUN_STACK_WAIT_SECONDS="$FIRST_RUN_STACK_WAIT_SECONDS" \
    CLOUDBENCH_BOOT_LAUNCH="${CLOUDBENCH_BOOT_LAUNCH:-1}" \
    CLOUDBENCH_BOOT_CONFIG_BARRIER="$BOOT_CONFIG_BARRIER" \
    CLOUDBENCH_BOOT_UPDATE_CAPACITY_WAIT_SECONDS="$BOOT_UPDATE_CAPACITY_WAIT_SECONDS" \
    CLOUDBENCH_BOOT_CONFIG_BARRIER_WAIT_SECONDS="$BOOT_CONFIG_BARRIER_WAIT_SECONDS" \
    CLOUDBENCH_LOCAL_PATCH_SOURCE="$FLEET_PATCH_FILE" \
    CLOUDBENCH_LOCAL_PATCH_SHA256="$FLEET_PATCH_SHA256" \
    CLOUDBENCH_INFRA_PROBE="${INFRA_PROBE:-0}" \
    CLOUDBENCH_COLD_PRIMARY_BOOTSTRAP="$cold_primary" \
    CLOUDBENCH_FRESH_VOLUME="$([ "$src" != archived-reuse ] && { [ "$cold_primary" = 1 ] || { [ "$src" != pool ] && [ "$(primary_clone_storage_mode "$bench")" = fresh ]; }; } && printf 1 || printf 0)" \
    CLOUDBENCH_POOL_BOOT_VM_SIZE="$pool_boot_vm_size" \
    CLOUDBENCH_POOL_BOOT_VM_MEMORY="$pool_boot_vm_memory" \
    CLOUDBENCH_SKIP_AUTOSCALER="${SKIP_AUTOSCALER:-0}" \
    CLOUDBENCH_REQUIRE_EXECUTION_PROVENANCE=1 \
    CLOUDBENCH_EXECUTION_PROVENANCE_FILE="$EXECUTION_PROVENANCE_FILE" \
    NO_OPEN=1 \
        run_fleet_child_supervised "$out/benchmark-child.finished" \
            bash "$RUN_BENCH_CLOUD_BIN" "$bench" \
            --machine "$cid" \
            --out-dir "$out" \
            --dash-port "$port" \
            --no-lock \
            --no-open \
            "$mode_flag" \
            --ref "$BENCH_REF" \
            --timeout "$bench_child_timeout" \
        > "$out/fleet-child.log" 2>&1 &
    if [ -z "$slot" ]; then
    CHILD_PIDS+=("$!")
    CHILD_OUT+=("$out")
    CHILD_BENCH+=("$bench")
    CHILD_MODE+=("$mode_label")
    CHILD_PORT+=("$port")
    CHILD_MACHINE+=("$cid")
    CHILD_RUN_TOKEN+=("$FLEET_OWNER_TOKEN-$i")
    CHILD_BENCH_INDEX+=("$i")
    else
    CHILD_PIDS[$slot]="$!"
    CHILD_MACHINE[$slot]="$cid"
    fi
    # Boot-launch is one bounded update/start pair and has exponential retry; it
    # no longer performs the old seven-SSH launch sequence. Feed pooled Machines
    # into that parallel bring-up at four launches/second, so all 30 are submitted
    # in ~7.5s without an instantaneous control-plane burst. Preserve the slower
    # legacy-path throttle for explicit non-boot callers.
    if [ "${CLOUDBENCH_BOOT_LAUNCH:-1}" = "1" ]; then
        sleep "${CLOUDBENCH_LAUNCH_STAGGER_SECONDS:-0.25}"
    else
        sleep "${CLOUDBENCH_LAUNCH_STAGGER_SECONDS:-3.5}"
    fi

    local_sim=0; [ "$mode_label" = "SIM" ] && local_sim=1
    # Infra probes and DEMO $0 concurrency probes finish (and tear down
    # /metrics) within seconds of barrier release / soft-complete. Mandatory
    # per-bench autoscalers then race expected post-DONE metrics death into
    # "6 consecutive scrape failures" CHILDFAIL — observed at width=20 with a
    # green 20/20 barrier (13/20 PASS, 7 CHILDFAIL), and again on DEMO fleets
    # when a late scale-up leaves worker-ready empty after guest shutdown.
    # Substrate canaries and DEMO concurrency e2e only need clone → barrier →
    # DONE/pass; skip autoscalers for both.
    if [ "${INFRA_PROBE:-0}" = "1" ] || [ "${SKIP_AUTOSCALER:-0}" = "1" ]; then
        if [ "${INFRA_PROBE:-0}" = "1" ]; then
            echo "   ⚖️  [$bench] per-bench autoscaler SKIPPED (infra-probe; no worker scaling)"
        else
            echo "   ⚖️  [$bench] per-bench autoscaler SKIPPED (--skip-autoscaler; DEMO concurrency)"
        fi
        : > "$out/autoscaler.ready"
        : > "$out/autoscaler.completed-after-child"
        printf '0\n' > "$out/desired-worker-count"
    else
        echo "   ⚖️  [$bench] per-bench autoscaler ON (mandatory prod params, max=$AUTOSCALE_MAX, queue=navi-agent-tasks-$local_ws)"
        rm -f "$out/autoscaler.pid" "$out/autoscaler.acceptance-failed"
        ( bench_autoscaler "$bench" "$cid" "$local_ws" "$local_sim" "$out" "$port" "$FLEET_OWNER_TOKEN-$i" ) >> "$out/autoscaler.log" 2>&1 &
        autoscaler_pid="$!"
        if [ -z "$slot" ]; then
            AUTOSCALER_PIDS+=("$autoscaler_pid")
        else
            AUTOSCALER_PIDS[$slot]="$autoscaler_pid"
        fi
        autoscaler_pid_tmp="$out/autoscaler.pid.tmp.$$"
        autoscaler_started=""
        for _ in $(seq 1 50); do
            autoscaler_started="$(fleet_pid_start_time "$autoscaler_pid" || true)"
            [ -z "$autoscaler_started" ] || break
            sleep 0.01
        done
        if [ -n "$autoscaler_started" ] \
            && printf '%s|%s\n' "$autoscaler_pid" "$autoscaler_started" > "$autoscaler_pid_tmp"; then
            mv "$autoscaler_pid_tmp" "$out/autoscaler.pid" 2>/dev/null || rm -f "$autoscaler_pid_tmp"
        else
            rm -f "$autoscaler_pid_tmp"
        fi
    fi
    return 0
}
i=0
for bench in "${BENCHES[@]}"; do
    launch_fleet_bench_child "$i" "$bench" || true
    i=$((i + 1))
done

[ "${#CHILD_PIDS[@]}" -ge 1 ] || { echo "❌ no benches launched (all clones failed)." >&2; exit 1; }

wait_for_mandatory_autoscaler_startup() {
    local deadline=$((SECONDS + AUTOSCALER_STARTUP_WAIT_SECONDS)) ready_count j reason
    local -a indices=("$@")
    if [ "${#indices[@]}" -eq 0 ]; then
        indices=("${!AUTOSCALER_PIDS[@]}")
    fi
    while :; do
        ready_count=0
        for j in "${indices[@]}"; do
            if [ -s "${CHILD_OUT[$j]}/autoscaler.failed" ]; then
                reason="$(head -1 "${CHILD_OUT[$j]}/autoscaler.failed" 2>/dev/null)"
                echo "❌ [${CHILD_BENCH[$j]}] mandatory autoscaler failed to start: ${reason:-unknown error}" >&2
                return 1
            fi
            if [ -e "${CHILD_OUT[$j]}/autoscaler.ready" ]; then
                ready_count=$((ready_count + 1))
            elif ! fleet_job_running "${AUTOSCALER_PIDS[$j]}"; then
                echo "❌ [${CHILD_BENCH[$j]}] mandatory autoscaler failed to start: process exited without readiness" >&2
                return 1
            fi
        done
        [ "$ready_count" -eq "${#indices[@]}" ] && return 0
        if [ "$SECONDS" -ge "$deadline" ]; then
            echo "❌ mandatory autoscaler startup timed out: $ready_count/${#indices[@]} ready" >&2
            return 1
        fi
        sleep 1
    done
}

# Configure the entire stopped fleet before starting any guest. Fly can reserve
# replacement CPU while applying a machine update; interleaving update/start at
# width made later config-only updates hit cpu_overcommit_exceeded even though
# the final 37-machine shape fit. Each child publishes its completed update and
# waits here; one release then lets every explicit start proceed concurrently.
boot_config_failed_child() {  # prints the failed child slot
    local j out mid
    for j in "${!CHILD_OUT[@]}"; do
        out="${CHILD_OUT[$j]}"
        mid="${CHILD_MACHINE[$j]}"
        if [ -f "$out/benchmark-child.finished" ] \
            && [ ! -f "$BOOT_CONFIG_BARRIER/ready/$mid" ]; then
            printf '%s\n' "$j"
            return 0
        fi
    done
    return 1
}
# A Fly Machine never leaves its host. When run-bench-cloud proves that host
# stopped answering same-ID boot-config updates (consecutive 408s), replace
# that one disposable clone instead of aborting every copy in the fleet. The
# old Machine stays in this fleet's exact registry and per-bench ledger, so the
# normal exact-owner teardown destroys it; nothing is guessed or reclaimed.
# Each child slot gets one replacement, inside the unchanged barrier deadline;
# pool claims, archived reuse and a second failure keep the strict abort.
fleet_replace_host_unresponsive_child() {  # <child-slot> <barrier-deadline>
    local j="$1" deadline="$2" out bench mid src cid archive name pcid
    local -a moved=()
    out="${CHILD_OUT[$j]}"
    bench="${CHILD_BENCH[$j]}"
    mid="${CHILD_MACHINE[$j]}"
    [ -f "$out/boot-config-host-unresponsive" ] \
        && [ "$(head -1 "$out/boot-config-host-unresponsive" 2>/dev/null)" = "$mid" ] || return 1
    if [ -e "$out/boot-config-host-replaced" ]; then
        echo "❌ [$bench] replacement Machine $mid also hit an unresponsive Fly host; no second replacement" >&2
        return 1
    fi
    src=""; cid=""
    read -r src cid < "$out/.cid" 2>/dev/null || true
    if [ "$src" != clone ] || [ "$cid" != "$mid" ]; then
        echo "❌ [$bench] host-unresponsive Machine $mid is not this run's disposable clone ($src); no replacement" >&2
        return 1
    fi
    # The mandatory autoscaler observes the same finished marker and exits. A
    # replacement must not inherit its workers or race its completion proof.
    while [ -n "${AUTOSCALER_PIDS[$j]:-}" ] && fleet_job_running "${AUTOSCALER_PIDS[$j]}"; do
        if [ "$SECONDS" -ge "$deadline" ]; then
            echo "❌ [$bench] autoscaler for $mid did not exit before the boot-config deadline; no replacement" >&2
            return 1
        fi
        sleep 0.2
    done
    if [ -s "$out/worker-clones.ids" ]; then
        echo "❌ [$bench] autoscaler for $mid owns worker clones; no replacement" >&2
        return 1
    fi
    [ "$SECONDS" -lt "$deadline" ] || return 1
    # Both processes already exited (finished marker / loop above); reap them
    # before their slots are reused so no stale PID remains owned.
    wait "${CHILD_PIDS[$j]}" 2>/dev/null || true
    [ -z "${AUTOSCALER_PIDS[$j]:-}" ] || wait "${AUTOSCALER_PIDS[$j]}" 2>/dev/null || true
    # Everything the failed child and autoscaler left that names the old
    # Machine moves aside, including the pre-boot runtime-evidence ownership
    # the relaunched child would otherwise refuse to reuse.
    archive="$out/host-replaced-$mid"
    mkdir "$archive" || return 1
    for name in .cid .startup-state.json fleet-child.log benchmark-child.finished \
        boot-config-unapplied boot-config-host-unresponsive cloudbench-boot-update.log \
        runtime-evidence.pending runtime-evidence.owner.json remote-logs \
        autoscaler.log autoscaler.pid autoscaler.ready autoscaler.failed \
        autoscaler.completed-after-child desired-worker-count; do
        if [ -e "$out/$name" ] || [ -L "$out/$name" ]; then
            mv "$out/$name" "$archive/$name" || return 1
            moved+=("$name")
        fi
    done
    echo "🔁 [$bench] Fly host for Machine $mid stopped answering boot-config updates; cloning a replacement (old Machine retained for exact-owner teardown)" >&2
    # Always a fresh clone: a pool claim or archived reuse cannot be taken
    # here and then abandoned. A failed clone restores the exact failed state
    # so the strict abort and startup-failure archive see the original owner.
    if pcid="$(clone_machine_target "$out/primary.ids" "$WARM_ID" \
        "$(primary_vm_size_for_bench "$bench")" "$(primary_vm_memory_for_bench "$bench")" \
        "$SNAP_ID" "$(primary_clone_storage_mode "$bench")")" \
        && [ -n "$pcid" ] && [ "$pcid" != "$mid" ]; then
        printf 'clone %s\n' "$pcid" > "$out/.cid" || return 1
    else
        echo "❌ [$bench] replacement clone for $mid failed; keeping the original failure" >&2
        for name in "${moved[@]}"; do mv "$archive/$name" "$out/$name" || true; done
        rmdir "$archive" 2>/dev/null || true
        return 1
    fi
    printf '%s\n' "$mid" > "$out/boot-config-host-replaced" || return 1
    launch_fleet_bench_child "${CHILD_BENCH_INDEX[$j]}" "$bench" "$j" || return 1
    if [ -n "${AUTOSCALER_PIDS[$j]:-}" ] && [ "${INFRA_PROBE:-0}" != 1 ] \
        && [ "${SKIP_AUTOSCALER:-0}" != 1 ]; then
        wait_for_mandatory_autoscaler_startup "$j" || return 1
    fi
    return 0
}
if [ "${CLOUDBENCH_BOOT_LAUNCH:-1}" = "1" ]; then
    boot_config_deadline=$((SECONDS + BOOT_CONFIG_BARRIER_WAIT_SECONDS))
    while :; do
        boot_config_ready="$(find "$BOOT_CONFIG_BARRIER/ready" -type f 2>/dev/null | wc -l | tr -d ' ')"
        [ "$boot_config_ready" = "${#CHILD_PIDS[@]}" ] && break
        if boot_config_failed_slot="$(boot_config_failed_child)"; then
            if fleet_replace_host_unresponsive_child "$boot_config_failed_slot" "$boot_config_deadline"; then
                continue
            fi
            echo "❌ boot config failed before barrier release: ${CHILD_BENCH[$boot_config_failed_slot]} exited without a ready marker (${boot_config_ready:-0}/${#CHILD_PIDS[@]} ready)" >&2
            exit 1
        fi
        if [ "$SECONDS" -ge "$boot_config_deadline" ]; then
            echo "❌ boot config barrier timed out: ${boot_config_ready:-0}/${#CHILD_PIDS[@]} updates ready" >&2
            exit 1
        fi
        sleep 0.2
    done
    : > "$BOOT_CONFIG_BARRIER/release"
    echo "⚙️  ${#CHILD_PIDS[@]}/${#CHILD_PIDS[@]} boot configs applied while stopped; releasing concurrent starts"
    release_capacity_reservation_after_primary_start_accounted || true
fi

echo ""
echo "⏳ ${#CHILD_PIDS[@]} isolated bench machine(s) running."


echo "   this run: $RUN_URL"
echo "   per-bench viewers: $(for j in "${!CHILD_PORT[@]}"; do printf '%s→:%s ' "${CHILD_BENCH[$j]}" "${CHILD_PORT[$j]}"; done)"
echo ""

# A fleet run means simultaneous benchmark execution, not merely concurrent
# provisioning. Each on-box driver announces after its isolated stack is
# healthy; only then do we touch every machine's release file in parallel.
release_start_barrier() {
    [ "$SYNCHRONIZED_START" = "1" ] || return 0
    # TOLERANT barrier (default): at fleet width some isolated stacks sporadically
    # fail on-box startup (resource/timing races under N concurrent full stacks).
    # An all-or-nothing barrier turned ONE such infra failure into a whole-batch
    # abort, so a 30/31-healthy run reported ZERO results. Instead, exclude a
    # stack that dies before signalling ready (it's an infra failure, not a
    # benchmark verdict), keep waiting for the live set, and release the barrier
    # for the survivors. Only fail if EVERY stack dies.
    #
    # STRICT barrier (CLOUDBENCH_STRICT_BARRIER=1 / --strict-barrier /
    # --infra-probe): any exclusion or timeout fails closed. Infra canaries and
    # /descend must not accept "most boxes OK" as a green substrate.
    local total="${#CHILD_PIDS[@]}" ready deadline now out p j live barrier_start per_box
    local status_port ready_marker_url
    local -a is_ready=() is_dead=()
    for j in "${!CHILD_PIDS[@]}"; do is_ready[$j]=0; is_dead[$j]=0; done
    barrier_start="$(date +%s)"
    deadline=$(( barrier_start + START_BARRIER_WAIT_SECONDS ))
    # Per-box ceiling: a single box whose launcher is alive but never reaches the
    # barrier (e.g. a hung iMessage-relay setup, or a driver dead before the poll
    # loop where staleness can't see it) otherwise drags the WHOLE barrier until
    # the global timeout, and every ready box waits idle. Exclude such a holdout
    # after a generous window (covers the slowest legitimate bring-up).
    per_box="$PER_BOX_BARRIER_WAIT_SECONDS"
    echo "⏸️  waiting for $total isolated stacks at synchronized start barrier..."
    while :; do
        now="$(date +%s)"
        ready=0; live=0
        for j in "${!CHILD_PIDS[@]}"; do
            [ "${is_dead[$j]}" = "1" ] && continue
            out="${CHILD_OUT[$j]}"; p="${CHILD_PIDS[$j]}"
            if [ "${is_ready[$j]}" = "0" ]; then
                # The on-box marker is the readiness source of truth. Console
                # streaming intentionally tails only a few changed lines, so a
                # healthy box can write this marker while fleet-child.log omits
                # the READY line. Observe the durable artifact through the same
                # data-plane tunnel used for authenticated barrier release.
                status_port="$(cat "$out/status-proxy.port" 2>/dev/null || true)"
                case "$status_port" in
                    ''|*[!0-9]*) ;;
                    *)
                        ready_marker_url="http://127.0.0.1:$status_port/cloudbench-start-$RUN_ID.ready"
                        if curl --noproxy '*' -fsS --max-time 1 -o /dev/null \
                            "$ready_marker_url" 2>/dev/null; then
                            is_ready[$j]=1
                        fi
                        ;;
                esac
                # Retain the emitted line as a compatibility signal for a
                # tunnel rotating at this instant; it is written only after
                # the same marker and cannot create an early release.
                if [ "${is_ready[$j]}" = "0" ] && \
                   grep -aFq "synchronized start barrier ready: $RUN_ID" "$out/fleet-child.log" 2>/dev/null; then
                    is_ready[$j]=1
                fi
            fi
            if [ "${is_ready[$j]}" = "1" ]; then
                : > "$out/barrier.ready.observed" || true
                ready=$((ready + 1)); live=$((live + 1))
            elif ! kill -0 "$p" 2>/dev/null; then
                # exited before signalling ready → infra failure; exclude it.
                is_dead[$j]=1
                echo "⚠️  [${CHILD_BENCH[$j]}] isolated stack failed before the start barrier — excluding it (infra) and continuing with the rest" >&2
            elif [ $(( now - barrier_start )) -ge "$per_box" ]; then
                # alive but never reached the barrier within the window → holdout.
                is_dead[$j]=1
                echo "⚠️  [${CHILD_BENCH[$j]}] did not reach the start barrier within ${per_box}s — excluding it (infra) and continuing with the rest" >&2
            else
                live=$((live + 1))
            fi
        done
        [ "$live" -eq 0 ] && { echo "❌ every isolated stack failed before the start barrier" >&2; return 1; }
        [ "$ready" -ge "$live" ] && break
        if [ "$now" -ge "$deadline" ]; then
            if [ "${STRICT_BARRIER:-0}" = "1" ]; then
                echo "❌ STRICT barrier: timed out with only $ready/$total ready (need all $total)" >&2
                return 1
            fi
            echo "⚠️  start barrier timed out ($ready/$live live ready) — releasing the ready set anyway" >&2
            break
        fi
        sleep 2
    done
    local excluded=$(( total - ready ))
    echo "✅ $ready/$total isolated stacks reached the barrier ($excluded excluded as infra failures)"
    if [ "${STRICT_BARRIER:-0}" = "1" ] && [ "$excluded" -ne 0 ]; then
        echo "❌ STRICT barrier: refusing to release with $excluded/$total infra exclusions (need 0)" >&2
        return 1
    fi
    local autoscaler_ready_indices=()
    for j in "${!CHILD_PIDS[@]}"; do
        [ "${is_ready[$j]}" = "1" ] && autoscaler_ready_indices+=("$j")
    done
    if [ "${INFRA_PROBE:-0}" = "1" ] || [ "${SKIP_AUTOSCALER:-0}" = "1" ]; then
        if [ "${INFRA_PROBE:-0}" = "1" ]; then
            echo "⚖️  infra-probe: skipping mandatory autoscaler startup wait (${#autoscaler_ready_indices[@]} ready stacks)"
        else
            echo "⚖️  skip-autoscaler: skipping mandatory autoscaler startup wait (${#autoscaler_ready_indices[@]} ready stacks)"
        fi
    elif ! wait_for_mandatory_autoscaler_startup "${autoscaler_ready_indices[@]}"; then
        return 1
    else
        echo "⚖️  ${#autoscaler_ready_indices[@]}/${#autoscaler_ready_indices[@]} mandatory per-bench autoscalers ready"
    fi
    # A repeated strict campaign coordinates these otherwise independent
    # one-task fleets only after their normal readiness checks. Consume this
    # existing startup deadline; task execution and owned teardown stay intact.
    if [ -n "${RUN_BENCH_CAMPAIGN_BARRIER_DIR:-}" ]; then
        python3 "$CLOUDBENCH_SCRIPT_SNAPSHOT/cloudbench-campaign-barrier.py" \
            --deadline "$deadline" --controller-pid "$$" || return 1
    fi
    echo "🚦 releasing synchronized start barrier on the ready machines..."
    local release_pids=() release_failed=0 release_port_file
    for j in "${!CHILD_MACHINE[@]}"; do
        [ "${is_ready[$j]}" = "1" ] || continue
        release_port_file="${CHILD_OUT[$j]}/status-proxy.port"
        (
            released=0
            for _release_attempt in $(seq 1 "${CLOUDBENCH_BARRIER_RELEASE_ATTEMPTS:-10}"); do
                status_port="$(cat "$release_port_file" 2>/dev/null || true)"
                case "$status_port" in ''|*[!0-9]*) sleep 1; continue ;; esac
                status_code="$(curl -sS --max-time 3 -o /dev/null -w '%{http_code}' \
                    -X POST -H "Authorization: Bearer $CLOUDBENCH_BARRIER_TOKEN" \
                    "http://127.0.0.1:$status_port/release" 2>/dev/null || true)"
                if [ "$status_code" = "204" ]; then released=1; break; fi
                sleep 1
            done
            [ "$released" = "1" ]
        ) &
        release_pids+=("$!")
    done
    for p in "${release_pids[@]}"; do wait "$p" || release_failed=1; done
    if [ "$release_failed" = "1" ]; then
        echo "❌ could not release synchronized start barrier on every ready stack" >&2
        return 1
    fi
    return 0
}

if ! release_start_barrier; then
    exit 1
fi

# ── Wait for all children, then aggregate ────────────────────────────────────
for j in "${!CHILD_PIDS[@]}"; do
    p="${CHILD_PIDS[$j]}"
    if wait "$p" 2>/dev/null; then
        CHILD_EXIT_CODES[$j]="0"
    else
        CHILD_EXIT_CODES[$j]="$?"
    fi
done
# The child marker is only the start of autoscaler terminalization. Poll all
# autoscalers together so a synchronous provider clone or an async worker stage
# can settle before we sample final capacity. A timeout never forgives shortage:
# the unchanged checks below still fail closed on live, incomplete state.
wait_for_autoscaler_finalization
AUTOSCALER_FAILURE=0
# Per-bench attribution lets the sealed lifecycle name the failed autoscaler(s)
# instead of leaving one fleet-wide flag that hides which case it belongs to.
AUTOSCALER_FAILED_BENCHES=()
for j in "${!AUTOSCALER_PIDS[@]}"; do
    autoscaler_bench_failed=0
    tracked_workers="$(_pool_ids "${CHILD_OUT[$j]}")"
    ready_workers="$(_ready_pool_ids "${CHILD_OUT[$j]}")"
    desired_workers="$(cat "${CHILD_OUT[$j]}/desired-worker-count" 2>/dev/null || true)"
    if [ -s "${CHILD_OUT[$j]}/autoscaler.failed" ]; then
        reason="$(head -1 "${CHILD_OUT[$j]}/autoscaler.failed" 2>/dev/null)"
        echo "❌ [${CHILD_BENCH[$j]}] mandatory autoscaler failed during the run: ${reason:-unknown error}" >&2
        autoscaler_bench_failed=1
    elif ! printf '%s' "$desired_workers" | grep -Eq '^[0-9]+$'; then
        echo "❌ [${CHILD_BENCH[$j]}] mandatory autoscaler did not persist desired worker capacity" >&2
        autoscaler_bench_failed=1
    elif ! mandatory_worker_health_acceptable "${CHILD_OUT[$j]}" "${CHILD_BENCH[$j]}"; then
        autoscaler_bench_failed=1
    elif worker_cleanup_failure="$(find "${CHILD_OUT[$j]}" -maxdepth 1 -name 'worker-*.cleanup-failed' -type f -print -quit 2>/dev/null)" \
        && [ -n "$worker_cleanup_failure" ]; then
        # A launched worker whose runtime evidence or retirement failed is a
        # run failure even when the task finished before needing its capacity.
        echo "❌ [${CHILD_BENCH[$j]}] mandatory autoscaler $(head -1 "$worker_cleanup_failure" 2>/dev/null)" >&2
        autoscaler_bench_failed=1
    elif [ "$tracked_workers" != "$ready_workers" ] \
        || find "${CHILD_OUT[$j]}" -maxdepth 1 -name 'worker-*.pending' -print -quit 2>/dev/null | grep -q .; then
        echo "❌ [${CHILD_BENCH[$j]}] mandatory autoscaler worker capacity incomplete: $ready_workers/$tracked_workers workers queue-ready" >&2
        autoscaler_bench_failed=1
    elif ! mandatory_autoscaler_process_acceptable \
        "${CHILD_OUT[$j]}" "${AUTOSCALER_PIDS[$j]}"; then
        # Capacity shortages above are provider/queue facts and remain the most
        # actionable terminal reason even if the autoscaler exits in the same
        # scheduler tick. Only use the generic process reason once measured
        # capacity itself is satisfied.
        echo "❌ [${CHILD_BENCH[$j]}] mandatory autoscaler exited during the run" >&2
        autoscaler_bench_failed=1
    elif [ ! -e "${CHILD_OUT[$j]}/autoscaler.completed-after-child" ]; then
        # A live process is acceptable during the bounded drain, but never after
        # it. Counts alone are a mutable snapshot; only the autoscaler's causal
        # completion marker proves that no committed transition remains.
        printf '%s\n' "mandatory autoscaler did not confirm terminal completion" \
            > "${CHILD_OUT[$j]}/autoscaler.acceptance-failed" 2>/dev/null || true
        echo "❌ [${CHILD_BENCH[$j]}] mandatory autoscaler did not confirm terminal completion" >&2
        autoscaler_bench_failed=1
    fi
    if [ "$autoscaler_bench_failed" = 1 ]; then
        AUTOSCALER_FAILURE=1
        AUTOSCALER_FAILED_BENCHES+=("${CHILD_BENCH[$j]}")
    fi
    if [ "$ready_workers" -lt "${desired_workers:-0}" ] \
        && [ -e "${CHILD_OUT[$j]}/autoscaler.completed-after-child" ]; then
        echo "⚠️ [${CHILD_BENCH[$j]}] task finished before future worker demand was needed: $ready_workers/$desired_workers queue-ready" >&2
    fi
done
# Normal completion has already reaped every child. Clear the ownership list so
# EXIT cleanup cannot signal a stale PID that the OS may have since reused.
CHILD_PIDS=()
# Autoscalers that already published causal completion are finished work, not
# live ownership. Reap them before the fleet summary / EXIT path so guest
# shutdown cannot race a vanishing jobs(1) entry into "survived local teardown".
reaped_autoscaler_pids=()
for j in "${!AUTOSCALER_PIDS[@]}"; do
    autoscaler_pid="${AUTOSCALER_PIDS[$j]}"
    [ -n "$autoscaler_pid" ] || continue
    if [ -e "${CHILD_OUT[$j]}/autoscaler.completed-after-child" ] \
        && ! fleet_job_running "$autoscaler_pid"; then
        wait "$autoscaler_pid" 2>/dev/null || true
        continue
    fi
    reaped_autoscaler_pids+=("$autoscaler_pid")
done
AUTOSCALER_PIDS=()
if [ "${#reaped_autoscaler_pids[@]}" -gt 0 ]; then
    AUTOSCALER_PIDS=("${reaped_autoscaler_pids[@]}")
fi
# One final merge so the batch dashboard reflects terminal results. Stop and
# reap the aggregator's whole tree first: its current sleep is a separate child
# and must not race this canonical write or outlive terminal status publication.
if ! cloudbench_terminate_tree_and_wait "${CLOUDBENCH_CHILD_TERM_SECONDS:-30}" \
    "${UNIFIED_AGG_PID:-}"; then
    echo "❌ final aggregate blocked: its owned process tree did not terminate" >&2
    LOCAL_PROCESS_TEARDOWN_FAILED=1
    exit 1
fi
UNIFIED_AGG_PID=""
if ! finalize_terminal_projection 0; then
    echo "❌ aggregate rejected missing or mismatched execution provenance" >&2
    exit 1
fi
if [ "$SELF_MANAGED_HUB_RUN" = "1" ]; then
    python3 "$HUB_UPLOAD_HELPER" --upload-live "$UNIFIED_DIR/run.json" \
        --run-id "$BENCHMARK_HUB_PARENT_RUN_ID" --source direct-cloud-fleet
fi

echo ""
echo "════════════════════ FLEET SUMMARY ════════════════════"
FLEET_PASS=0; FLEET_TOTAL=0
for j in "${!CHILD_BENCH[@]}"; do
    bench="${CHILD_BENCH[$j]}"; out="${CHILD_OUT[$j]}"; mode="${CHILD_MODE[$j]}"
    child_rc="${CHILD_EXIT_CODES[$j]:-1}"
    line="$(RUN_JSON_PATH="$out/cloudbench-run.json" EXPECTED_TASK="$bench" CHILD_RC="$child_rc" \
        RESULT_VALIDATOR="$CLOUDBENCH_RESULT_SCRIPT" \
        EXPECTED_PROVENANCE="$EXECUTION_PROVENANCE_FILE" python3 -c '
import json,os,subprocess,sys
p=os.environ["RUN_JSON_PATH"]
expected=os.environ["EXPECTED_TASK"]
child_rc=int(os.environ["CHILD_RC"])
try:
    # Strict pass only: Claude Code credential SKIPs must not count as PASS.
    check=subprocess.run(
        [
            sys.executable,
            os.environ["RESULT_VALIDATOR"],
            p,
            "--expected-task",
            expected,
            "--expected-execution-provenance-file",
            os.environ["EXPECTED_PROVENANCE"],
            "--require-pass",
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    r=json.load(open(p)); tasks=r.get("tasks",[])
    t=tasks[0] if tasks else {}
    passed=child_rc == 0 and check.returncode == 0
    aid=t.get("agent_id") or ""
    dur=t.get("duration_seconds")
    status="PASS" if passed else ("CHILDFAIL" if child_rc != 0 else "FAIL")
    print(status, aid, ("" if dur is None else round(float(dur),1)))
except Exception as e:
    print("NORESULT", "", "")
' 2>/dev/null || echo "NORESULT  ")"
    status="$(printf '%s' "$line" | awk '{print $1}')"
    aid="$(printf '%s' "$line" | awk '{print $2}')"
    FLEET_TOTAL=$((FLEET_TOTAL + 1))
    [ "$status" = "PASS" ] && FLEET_PASS=$((FLEET_PASS + 1))
    icon="❌"; [ "$status" = "PASS" ] && icon="✅"; [ "$status" = "NORESULT" ] && icon="⚠️ "
    printf '  %s %-38s %-4s %-9s' "$icon" "$bench" "$mode" "$status"
    [ -n "$aid" ] && printf '  agent=%s' "$aid"
    printf '\n'
done
echo "  ────────────────────────────────────────────────────"
echo "  $FLEET_PASS/$FLEET_TOTAL passed"
echo "════════════════════════════════════════════════════════"
FLEET_EXECUTION_COMPLETED=1
[ "$FLEET_PASS" = "$FLEET_TOTAL" ] && [ "$AUTOSCALER_FAILURE" = "0" ]
