# READ-ONLY env preflight: the run path never stages/mutates the shared
# prod-aligned app secrets (that would race concurrent workstreams). It only
# verifies they exist; refreshing them is an explicit maintenance op.
write_startup_card "verifying environment"
echo "🔎 Verifying the shared benchmark app environment (read-only)..."
verify_fleet_environment() {
    if [ -n "${CLOUDBENCH_CAMPAIGN_INVENTORY_DIR:-}" ] && [ -n "${RUN_BENCH_CAMPAIGN_BARRIER_DIR:-}" ]; then
        python3 -I -S -B "$CLOUDBENCH_SCRIPT_SNAPSHOT/cloudbench-campaign-env.py" \
            --root "$ROOT_DIR" --inventory "$CLOUDBENCH_CAMPAIGN_INVENTORY_DIR" \
            --barrier "$RUN_BENCH_CAMPAIGN_BARRIER_DIR" --job "${RUN_BENCH_CAMPAIGN_JOB_ID:?}" \
            --controller-pid "$$" --source-ref "${CLOUDBENCH_PRESTACK_CONTROLLER_REF:?}" \
            --deadline "$((FLEET_CONTROLLER_STARTED_EPOCH + START_BARRIER_WAIT_SECONDS))"
    else
        bash "$RUN_BENCH_CLOUD_BIN" --verify-secrets
    fi
}
if ! verify_fleet_environment; then
    echo "❌ Cloud benchmark environment is not ready; no benchmark machine was started." >&2
    echo "   Refresh it explicitly (maintenance op): bash scripts/run-bench-cloud --refresh-secrets" >&2
    exit 1
fi

# Fail closed BEFORE provisioning N clones when the immutable seed dump for the
# cloud-guest Postgres major is missing from R2. Guests run system Postgres 15
# (`cloudbench-run.sh`); a host that only published pg16 leaves every stack
# failing at the start barrier after machines are already billed.
# Observed 2026-08-06: 49/49 daily benches excluded for
# `canonical base fixture is unavailable` on token `…-pg15-victoria-prod-sync-v1-whatsapp-v2`
# while `…-pg16-…` existed.
CLOUDBENCH_GUEST_PG_MAJOR="${CLOUDBENCH_GUEST_PG_MAJOR:-15}"
echo "🔎 Verifying canonical seed dump for cloud-guest Postgres ${CLOUDBENCH_GUEST_PG_MAJOR}..."
_SEED_GUEST_TOKEN="$(
    python3 "$ROOT_DIR/agents/benchmarks/seed_cache_path.py" --cache-token \
        --pg-major "$CLOUDBENCH_GUEST_PG_MAJOR" \
        "$ROOT_DIR/back-end/prisma/schema.prisma"
)"
# Detached fleet controllers can inherit a stripped PATH (Cursor cloud / minimal
# launchers). Ensure npx from nvm or common prefixes is visible before probing.
if ! command -v npx >/dev/null 2>&1; then
    for _npx_dir in \
        "$HOME/.nvm/versions/node"/*/bin \
        /usr/local/bin \
        "$ROOT_DIR/node_modules/.bin"
    do
        if [ -x "$_npx_dir/npx" ]; then
            export PATH="$_npx_dir:$PATH"
            break
        fi
    done
fi
command -v npx >/dev/null 2>&1 || {
    echo "❌ npx not found on PATH; cannot verify the cloud-guest seed dump." >&2
    echo "   Install Node.js or ensure nvm's bin dir is on PATH before run-bench-fleet." >&2
    exit 1
}
if [ -n "${CLOUDBENCH_CAMPAIGN_SEED_PROOF:-}" ]; then
    python3 "$CLOUDBENCH_SCRIPT_SNAPSHOT/cloudbench-campaign-seed.py" consume \
        --root "$ROOT_DIR" --inventory "${CLOUDBENCH_CAMPAIGN_INVENTORY_DIR:?}" \
        --barrier "${RUN_BENCH_CAMPAIGN_BARRIER_DIR:?}" \
        --proof "$CLOUDBENCH_CAMPAIGN_SEED_PROOF" \
        --job "${RUN_BENCH_CAMPAIGN_JOB_ID:?}" --controller-pid "$$" \
        --deadline "$((FLEET_CONTROLLER_STARTED_EPOCH + START_BARRIER_WAIT_SECONDS))" || exit 1
else
    _SEED_GUEST_PROBE="$(mktemp "${TMPDIR:-/tmp}/cloudbench-seed-probe.XXXXXX")"
    if ! bash "$CLOUDBENCH_SCRIPT_SNAPSHOT/cloudbench-seed-get.sh" \
        "$ROOT_DIR" "$_SEED_GUEST_TOKEN" "$_SEED_GUEST_PROBE"; then
        rm -f "$_SEED_GUEST_PROBE"
        echo "❌ Missing canonical base fixture for cloud guests: $_SEED_GUEST_TOKEN" >&2
        echo "   Publish a dump produced by a pg${CLOUDBENCH_GUEST_PG_MAJOR} client before provisioning." >&2
        echo "   (Host-only pg16 publications are not readable by Fly guest Postgres ${CLOUDBENCH_GUEST_PG_MAJOR}.)" >&2
        exit 1
    fi
    rm -f "$_SEED_GUEST_PROBE"
fi
echo "✅ Canonical seed dump present for guest pg${CLOUDBENCH_GUEST_PG_MAJOR}: $_SEED_GUEST_TOKEN"

# ── Resolve the warm machine (clone source) + its volume ────────────────────
private_fleet_source_admission() {
    # The existing publisher reads provider inventory once per poll. Clone
    # admission checks only the selected immutable base's fresh native record.
    [ "$(inventory_machine_field "$PRIVATE_SOURCE_ID" instance_id)" = "$PRIVATE_SOURCE_INSTANCE_ID" ] \
        && [ "$(inventory_machine_field "$PRIVATE_SOURCE_ID" state)" = stopped ] \
        && [ "$(inventory_machine_field "$PRIVATE_SOURCE_ID" storage_ready)" = 1 ] || {
        echo "❌ private fleet source native readiness changed before clone admission" >&2
        return 1
    }
}
validate_private_fleet_source() {
    local machines volumes snapshots
    # Read-only provider inventory is flaky under a 14-job cohort: listings fail
    # transiently (HTTP/2 stream INTERNAL_ERROR) or the snapshot listing returns rc=0
    # and [] (14 parallel reads: 23/28 empty; sequential reads complete). Re-read a
    # bounded number of times; the strict validation below is unchanged.
    local _inventory_read _inventory_ok
    for _inventory_read in 1 2 3 4 5 6; do
        _inventory_ok=0
        if machines="$(FLY machines list -a "$APP" --json)" \
            && volumes="$(FLY volumes list -a "$APP" --json)" \
            && snapshots="$(FLY volume snapshots list "$PRIVATE_SOURCE_VOLUME_ID" -a "$APP" --json)"; then
            _inventory_ok=1
            printf '%s' "$snapshots" | python3 -c 'import json, sys
rows = json.load(sys.stdin)
sys.exit(0 if isinstance(rows, list) and any(isinstance(r, dict) and r.get("id") == sys.argv[1] for r in rows) else 1)' \
                "$PRIVATE_SOURCE_SNAPSHOT" 2>/dev/null && break
            echo "⚠️  provider snapshot listing omitted $PRIVATE_SOURCE_SNAPSHOT (read $_inventory_read/6)" >&2
        else
            echo "⚠️  provider inventory read failed (read $_inventory_read/6)" >&2
        fi
        [ "$_inventory_read" -lt 6 ] || { [ "$_inventory_ok" = 1 ] || return 1; break; }
        sleep $((_inventory_read * 2 + RANDOM % 3))
    done
    printf '{"machines":%s,"volumes":%s,"snapshots":%s}' "$machines" "$volumes" "$snapshots" \
        | python3 "$SOURCE_HELPER" verify "$PRIVATE_SOURCE_FILE" --parked-memory "$WARM_PARKED_VM_MEMORY" --sha256 "$PRIVATE_SOURCE_SHA256"
}
if [ -n "${CLOUDBENCH_CAMPAIGN_INVENTORY_DIR:-}" ]; then
    campaign_inventory_wait start_machines_snapshot_loop || exit $?
fi
# One warm source per dependency set (opt-in until proven on Fly). The single
# shared `cloudbench-warm` donor is rebuilt whenever a fleet's dependency set
# differs, so every other devbox waits for it to stop and two sets keep
# flipping it. With CLOUDBENCH_WARM_SOURCE_PER_DEPS=1 the fleet selects
# `cloudbench-warm-<set>` (created once from the base donor's snapshot under
# the cross-devbox claim, scripts/cloudbench-warm-source.py); a fleet whose
# set already has a warm source never waits on another set's maintenance, and
# its run-bench-cloud children inherit the same names. An explicit
# CLOUDBENCH_WARM_MACHINE_NAME or a private fleet source keeps its selection.
select_dependency_set_warm_source() {
    local node_fp py_fp selected set_id
    [ "${CLOUDBENCH_WARM_SOURCE_PER_DEPS:-0}" = 1 ] || return 0
    { [ -z "${PRIVATE_SOURCE_FILE:-}" ] && [ -z "${CLOUDBENCH_WARM_MACHINE_NAME:-}" ]; } || return 0
    node_fp="$(cloudbench_node_dependency_fingerprint "$ROOT_DIR")" || return 1
    py_fp="$(cloudbench_manifest_fingerprint "$ROOT_DIR" "${CLOUDBENCH_PYTHON_MANIFESTS[@]}")" || return 1
    selected="$(python3 "$WARM_SOURCE_HELPER" --app "$APP" ensure --node-fp "$node_fp" --py-fp "$py_fp" \
        --owner "fleet-$FLEET_OWNER_TOKEN")" || {
        echo "❌ could not select this dependency set's warm source" >&2
        return 1
    }
    read -r set_id MACHINE_NAME VOLUME_NAME <<< "$selected"
    if [ "$MACHINE_NAME" != "cloudbench-warm-$set_id" ] || [ "$VOLUME_NAME" != "cloudbench_data_$set_id" ]; then
        echo "❌ warm source helper returned an unexpected selection" >&2
        return 1
    fi
    export CLOUDBENCH_WARM_MACHINE_NAME="$MACHINE_NAME" CLOUDBENCH_WARM_VOLUME_NAME="$VOLUME_NAME"
    WARM_DEPS_STATE_FILE="$GIT_COMMON_DIR/cloudbench-warm-deps.$MACHINE_NAME.fp"
    echo "🏷️  dependency set $set_id uses warm source $MACHINE_NAME"
}
select_dependency_set_warm_source || exit 1
if [ -n "${PRIVATE_SOURCE_FILE:-}" ]; then
    validate_private_fleet_source || exit 1
    WARM_ID="$PRIVATE_SOURCE_ID"
    WARM_VOLUME_ID="$PRIVATE_SOURCE_VOLUME_ID"
    VOL_ID="$PRIVATE_SOURCE_VOLUME_ID"
    REGION="$PRIVATE_SOURCE_REGION"
    SNAP_ID="$PRIVATE_SOURCE_SNAPSHOT"
    if [ -n "${CLOUDBENCH_SNAPSHOT_ID:-}" ] && [ "$CLOUDBENCH_SNAPSHOT_ID" != "$SNAP_ID" ]; then
        echo "❌ private source snapshot pin differs from its captured manifest" >&2
        exit 1
    fi
    echo "🧊 independently owned immutable source: $WARM_ID (region $REGION)"
else
campaign_inventory_capture warm_json fleet_admission_machines_json || exit $?
warm_pair="$(printf '%s' "$warm_json" | MN="$MACHINE_NAME" python3 -c '
import json,os,sys
d=json.load(sys.stdin) or []
mn=os.environ["MN"]
for m in d:
    if m.get("name")==mn and m.get("id"):
        mounts=m.get("config",{}).get("mounts") or []
        vol=mounts[0].get("volume","") if mounts else ""
        print(m["id"], m.get("region") or "", vol); break
' 2>/dev/null || true)"
WARM_ID="$(printf '%s' "$warm_pair" | awk '{print $1}')"
warm_region="$(printf '%s' "$warm_pair" | awk '{print $2}')"
WARM_VOLUME_ID="$(printf '%s' "$warm_pair" | awk '{print $3}')"
[ -n "$WARM_ID" ] || { echo "❌ No warm machine '$MACHINE_NAME' in $APP — run: bash scripts/run-bench-cloud --setup" >&2; exit 1; }
# Volume snapshots are region-scoped, so clones MUST land in the warm box's region.
[ -n "$warm_region" ] && REGION="$warm_region"
echo "🏭 warm source machine: $WARM_ID (region $REGION)"

# A stopped-machine config update briefly reserves both old and new CPU shapes.
# Keeping the 4x maintenance donor parked beside 37 2x primaries leaves only an
# exact two-CPU margin and has produced real cpu_overcommit deaths before boot.
# The volume snapshot does not depend on guest shape, so park the donor at 1x
# between maintenance transactions; run-bench-cloud expands it only while
# rebuilding/snapshotting and parks it again on every exit path.
# A legacy pool request has no measured new-Machine admission (043659fa8).
# Refuse it before any donor park, pool ledger/.deps publication or clone so a
# refused request leaves provider and workspace pool state untouched.
if [ -n "$PROVISION_POOL" ]; then
    machine_creation_admission "$FLEET_DIR/pool-provision-1.ids" || exit 1
fi
warm_shape="$(printf '%s' "$warm_json" | pool_machine_shape_from_json "$WARM_ID")" || {
    echo "❌ could not read warm source shape" >&2; exit 1;
}
read -r warm_state warm_kind warm_cpus warm_memory <<< "$warm_shape"
# Concurrent maintenance (or a sibling fleet's park/update) can leave the shared
# warm donor in started/stopping/replacing. Wait for stopped instead of aborting
# the whole fleet on a transient race — clones still require a stopped source.
# Never stop the warm machine ourselves (another workspace may own an in-flight
# prepare_warm_source); only poll via cloudbench_wait_machine_stopped.
# The direct read can see the donor stopped while a shared inventory snapshot
# still holds the generation that recorded the transient state, so re-list only
# from a newer generation, within the same stop budget.
await_stopped_warm_source() {  # sets warm_json warm_state warm_kind warm_cpus warm_memory
    local warm_stop_attempts="${CLOUDBENCH_WARM_STOP_ATTEMPTS:-60}"
    local warm_stop_sleep="${CLOUDBENCH_WARM_STOP_SLEEP_SECONDS:-5}"
    local warm_stop_deadline warm_generation warm_shape
    echo "⏳ warm source is $warm_state; waiting until stopped before fleet provisioning"
    warm_stop_deadline=$((SECONDS + warm_stop_attempts * warm_stop_sleep))
    cloudbench_wait_machine_stopped pool_machine_state "$WARM_ID" \
        "$warm_stop_attempts" "$warm_stop_sleep" || {
        echo "❌ warm source must be stopped before fleet provisioning (state=$(pool_machine_state "$WARM_ID" 2>/dev/null || echo unknown))" >&2
        return 1
    }
    while :; do
        warm_generation="$(machines_snapshot_identity)"
        campaign_inventory_capture warm_json fleet_admission_machines_json || exit $?
        warm_shape="$(printf '%s' "$warm_json" | pool_machine_shape_from_json "$WARM_ID")" || {
            echo "❌ could not re-read warm source shape after stop wait" >&2; return 1;
        }
        read -r warm_state warm_kind warm_cpus warm_memory <<< "$warm_shape"
        [ "$warm_state" != "stopped" ] || return 0
        # Only a shared snapshot can lag the direct read; a live list cannot.
        if [ -z "${SNAPSHOT_LOOP_PID:-}" ] || [ "$SECONDS" -ge "$warm_stop_deadline" ] \
            || ! refresh_machines_snapshot_after "$warm_generation" "$warm_stop_deadline"; then
            echo "❌ warm source must be stopped before fleet provisioning (state=$warm_state)" >&2
            return 1
        fi
    done
}
if [ "$warm_state" != "stopped" ]; then
    await_stopped_warm_source || exit 1
fi
if [ "$warm_kind/$warm_cpus/$warm_memory" != "shared/1/$WARM_PARKED_VM_MEMORY" ]; then
    echo "🅿️  parking warm source at $WARM_PARKED_VM_SIZE/${WARM_PARKED_VM_MEMORY}MB for config headroom"
    park_attempt=1
    park_attempts="${CLOUDBENCH_WARM_PARK_LEASE_ATTEMPTS:-8}"
    park_delay="${CLOUDBENCH_WARM_PARK_LEASE_RETRY_SECONDS:-15}"
    park_out=""
    if ! [[ "$park_attempts" =~ ^[1-9][0-9]*$ ]]; then
        echo "❌ CLOUDBENCH_WARM_PARK_LEASE_ATTEMPTS must be a positive integer (got: ${park_attempts})" >&2
        exit 1
    fi
    if ! [[ "$park_delay" =~ ^[1-9][0-9]*$ ]]; then
        echo "❌ CLOUDBENCH_WARM_PARK_LEASE_RETRY_SECONDS must be a positive integer (got: ${park_delay})" >&2
        exit 1
    fi
    while true; do
        if park_out="$(fly_with_timeout 90 machine update "$WARM_ID" -a "$APP" \
            --vm-size "$WARM_PARKED_VM_SIZE" --vm-memory "$WARM_PARKED_VM_MEMORY" \
            --skip-start --yes 2>&1)"; then
            break
        fi
        if ! printf '%s' "$park_out" | grep -Eqi 'lease currently held|failed to (obtain|get) lease'; then
            printf '%s\n' "$park_out" | sed 's/^/   /' >&2
            echo "❌ could not park warm source for fleet capacity headroom" >&2
            exit 1
        fi
        if [ "$park_attempt" -ge "$park_attempts" ]; then
            printf '%s\n' "$park_out" | sed 's/^/   /' >&2
            echo "❌ could not park warm source for fleet capacity headroom (lease held)" >&2
            exit 1
        fi
        echo "   ⏳ park lease held — retry $park_attempt/$park_attempts in ${park_delay}s" >&2
        sleep "$park_delay"
        park_attempt=$((park_attempt + 1))
    done
fi

# Clones fork the warm volume from a completed snapshot. Fly reports incremental
# stored size, not logical completeness, so a valid current snapshot can be much
# smaller than an older one. Select by lifecycle status + real creation timestamp;
# exclude the zero-byte `running` placeholder exposed while upload is in flight.
# Cloned volumes can retain the donor name. Bind the exact mount resolved
# from the named warm Machine; a same-name volume is not source authority.
campaign_inventory_capture warm_volumes_json fleet_volumes_json || exit $?
VOL_ID="$(printf '%s' "$warm_volumes_json" | VN="$VOLUME_NAME" WV="$WARM_VOLUME_ID" WM="$WARM_ID" python3 -c '
import json,os,sys
try:
    d=json.load(sys.stdin)
    if not isinstance(d,list) or any(not isinstance(v,dict) for v in d): raise ValueError
    expected=os.environ["WV"]
    if not expected: raise ValueError
    matches=[v for v in d if v.get("id")==expected]
    if len(matches)!=1: raise ValueError
    v=matches[0]
    if v.get("name")!=os.environ["VN"] or v.get("attached_machine_id")!=os.environ["WM"]: raise ValueError
except (TypeError,ValueError,KeyError):
    raise SystemExit(1)
print(expected)
' 2>/dev/null || true)"
[ -n "$VOL_ID" ] || { echo "❌ Could not find warm volume '$VOLUME_NAME' in $APP" >&2; exit 1; }
# CLOUDBENCH_SNAPSHOT_ID pins a specific snapshot (Fly can't delete snapshots, so
# when the auto-selected newest one is stale — e.g. missing the dep-fingerprint
# marker → cloudbench-sync-deps.sh FATAL — pin a known-good one until a fresh
# warm image/snapshot is baked).
if { [ -n "${CLOUDBENCH_WARM_SNAPSHOT_INVENTORY_FILE:-}" ] || [ -n "${CLOUDBENCH_WARM_SNAPSHOT_INVENTORY_SHA256:-}" ]; } \
    && { [ -z "${CLOUDBENCH_WARM_SNAPSHOT_INVENTORY_FILE:-}" ] || [ -z "${CLOUDBENCH_SNAPSHOT_ID:-}" ]; }; then
    echo "❌ configured snapshot inventory requires an explicit file and snapshot pin" >&2
    exit 1
fi
if [ -n "${CLOUDBENCH_SNAPSHOT_ID:-}" ]; then
    SNAP_ID="$CLOUDBENCH_SNAPSHOT_ID"
    echo "📌 pinned snapshot (CLOUDBENCH_SNAPSHOT_ID): $SNAP_ID"
    if [ -n "${CLOUDBENCH_WARM_SNAPSHOT_INVENTORY_FILE:-}" ]; then
        SNAPSHOTS_JSON="$(configured_warm_snapshot_inventory)" || exit 1
        _proof_node="$(cloudbench_node_dependency_fingerprint "$ROOT_DIR")" || exit 1
        _proof_python="$(cloudbench_manifest_fingerprint "$ROOT_DIR" "${CLOUDBENCH_PYTHON_MANIFESTS[@]}")" || exit 1
        HYDRATED_WARM_DEPS_STATE="$(printf '{"machines":%s,"snapshots":%s}' "$warm_json" "$SNAPSHOTS_JSON" | \
            cloudbench_warm_deps_state_from_inventory "$APP" "$WARM_ID" "$VOL_ID" "$_proof_node" "$_proof_python")" || {
            echo "❌ configured snapshot inventory does not prove current donor dependencies" >&2
            exit 1
        }
        read -r _ _ _ _proof_snapshot <<< "$HYDRATED_WARM_DEPS_STATE" || exit 1
        if [ "$_proof_snapshot" != "$SNAP_ID" ]; then
            echo "❌ configured snapshot inventory does not prove the pinned snapshot" >&2
            exit 1
        fi
    fi
else
    # `|| echo '[]'` made a failed provider read indistinguishable from "this
    # volume has no snapshots", and the caller then aborts the whole lane with
    # "No complete snapshot". With several controllers polling Fly at once a
    # single rate-limited read killed a healthy lane that had ten usable
    # snapshots. Retry until the listing itself is valid JSON, and only then let
    # an empty result mean absence.
    list_donor_snapshots
    if [ -z "$SNAPSHOTS_JSON" ]; then
        echo "❌ could not read volume snapshots for $VOL_ID after $SNAPSHOT_LIST_ATTEMPTS_USED attempts (provider read failure, not a missing snapshot)" >&2
        exit 1
    fi
    hydrate_warm_deps_state
    RECORDED_SNAP_ID="$(warm_deps_recorded_state 2>/dev/null | awk 'NF >= 4 {print $4; exit}' || true)"
    # The newest snapshot is not necessarily proven: an interrupted refresh can
    # leave a newer complete snapshot without ever publishing its dependency
    # proof. Prefer the exact recorded snapshot while it still exists and is
    # complete; warm_deps_preflight below independently verifies its fingerprints
    # and creation epoch. This prevents an orphan snapshot from invalidating a
    # perfectly warm 30-Machine pool and triggering another multi-minute cut.
    if [ -n "$RECORDED_SNAP_ID" ] && printf '%s' "$SNAPSHOTS_JSON" | \
        SID="$RECORDED_SNAP_ID" python3 -c '
import json, os, sys
try: snapshots = json.load(sys.stdin) or []
except Exception: snapshots = []
valid = {"created", "complete", "completed", "ready"}
match = next((s for s in snapshots if s.get("id") == os.environ["SID"]), None)
raise SystemExit(0 if match and str(match.get("status") or "").lower() in valid
                 and int(match.get("size") or 0) > 0 and match.get("created_at") else 1)
' 2>/dev/null; then
        SNAP_ID="$RECORDED_SNAP_ID"
        echo "🧾 using recorded proven snapshot: $SNAP_ID"
    else
        SNAP_ID="$(printf '%s' "$SNAPSHOTS_JSON" | python3 "$SNAPSHOT_SELECTOR_SCRIPT" 2>/dev/null || true)"
    fi
fi
if [ -z "$SNAP_ID" ]; then
    echo "❌ No complete snapshot for warm volume $VOL_ID. Create one and wait for it to finish:" >&2
    echo "   (listing read ${SNAPSHOT_LIST_ATTEMPTS_USED:-0} time(s); the last valid read held $(printf '%s' "${SNAPSHOTS_JSON:-[]}" | python3 -c 'import json,sys; print(len(json.load(sys.stdin)))' 2>/dev/null || echo unknown) snapshot(s))" >&2
    echo "   flyctl volume snapshots create $VOL_ID -a $APP   # then wait until STORED SIZE ≈ VOL SIZE" >&2
    exit 1
fi
fi
# Freeze one workspace patch before maintenance and reuse it for every guest.
FLEET_PATCH_FILE=""
FLEET_PATCH_SHA256=""
if [ "${CLOUDBENCH_SKIP_LOCAL_PATCH:-0}" != "1" ] \
   && { [ "$REQUESTED_BENCH_REF" != "$BENCH_REF" ] \
        || cloudbench_worktree_has_changes "$ROOT_DIR"; }; then
    FLEET_PATCH_FILE="$(mktemp)"
    fleet_patch_rc=0
    cloudbench_prepare_workspace_patch \
        "$ROOT_DIR" "$BENCH_REF" "$FLEET_PATCH_FILE" \
        "$ROOT_DIR/scripts/create-worktree-patch.sh" || fleet_patch_rc=$?
    if [ "$fleet_patch_rc" -eq "$CLOUDBENCH_PATCH_NO_DELTA" ]; then
        # The unpushed HEAD carries only content the patch generator excludes
        # (append-only history ledgers), so the base ref already IS the code
        # under test. Shipping nothing is exactly equivalent here.
        rm -f "$FLEET_PATCH_FILE"
        FLEET_PATCH_FILE=""
        echo "📦 no shippable workspace delta beyond $BENCH_REF (append-only ledgers only); guests run the base ref"
    elif [ "$fleet_patch_rc" -ne 0 ]; then
        echo "❌ could not create the fleet local workspace patch" >&2
        exit 1
    fi
fi
if [ -n "$FLEET_PATCH_FILE" ]; then
    FLEET_PATCH_SHA256="$(cloudbench_env_sha256 "$FLEET_PATCH_FILE")"
    [ -n "$FLEET_PATCH_SHA256" ] || {
        echo "❌ could not fingerprint the fleet local workspace patch" >&2
        exit 1
    }
fi


# ── Preflight: will clones inherit up-to-date dep trees from this snapshot? ──
# When the warm snapshot's node_modules/venv are stale vs the current ref's
# manifests, EVERY clone pays a multi-minute rsync refresh on bring-up — the
# fleet's dominant cost at width. --refresh-deps records what the snapshot
# carries in a git-common state file (shared across sibling workspaces); heal
# centrally ONCE when it drifts.
snapshot_created_epoch() {  # snapshot_created_epoch <snap_id> [captured-inventory]
    local snapshots query_status=0
    if [ "$#" -gt 1 ]; then
        snapshots="$2"
    else
        snapshots="$(FLY volume snapshots list "$VOL_ID" -a "$APP" --json 2>/dev/null)" || query_status=$?
        if [ "$query_status" -ne 0 ]; then
            echo "snapshot epoch provider read failed (exit=$query_status)" >&2
            return 75
        fi
    fi
    printf '%s' "$snapshots" | SID="$1" python3 -c '
import json, os, sys
from datetime import datetime
try:
    snaps = json.load(sys.stdin)
    if not isinstance(snaps, list) or any(not isinstance(s, dict) for s in snaps):
        raise ValueError("inventory type")
    matches = [s for s in snaps if s.get("id") == os.environ["SID"]]
    if not matches:
        print("snapshot epoch exact snapshot absent", file=sys.stderr)
        raise SystemExit(1)
    if len(matches) != 1:
        raise ValueError("duplicate snapshot identity")
    epoch = int(datetime.fromisoformat(str(matches[0].get("created_at", "")).replace("Z", "+00:00")).timestamp())
    if epoch <= 0:
        raise ValueError("nonpositive epoch")
    print(epoch)
except (ValueError, TypeError, OverflowError, OSError) as error:
    print("snapshot epoch inventory invalid (" + type(error).__name__ + ")", file=sys.stderr)
    raise SystemExit(75)
'
}

snapshot_is_complete_exact() {  # snapshot_is_complete_exact <snap_id>
    FLY volume snapshots list "$VOL_ID" -a "$APP" --json 2>/dev/null | SNAP_ID="$1" python3 -c '
import json, os, sys
try: snaps = json.load(sys.stdin) or []
except Exception: raise SystemExit(1)
match = next((s for s in snaps if s.get("id") == os.environ["SNAP_ID"]), None)
valid = {"created", "complete", "completed", "ready"}
raise SystemExit(0 if match and str(match.get("status") or "").lower() in valid
                 and int(match.get("size") or 0) > 0 else 1)
' 2>/dev/null
}
CURRENT_NODE_FP=""
CURRENT_PY_FP=""
warm_deps_preflight() {
    if [ -n "${PRIVATE_SOURCE_FILE:-}" ]; then
        CURRENT_NODE_FP="$(cloudbench_node_dependency_fingerprint "$ROOT_DIR")" || return 1
        CURRENT_PY_FP="$(cloudbench_manifest_fingerprint "$ROOT_DIR" "${CLOUDBENCH_PYTHON_MANIFESTS[@]}")" || return 1
        if [ "$CURRENT_NODE_FP" != "$PRIVATE_SOURCE_NODE_FP" ] || [ "$CURRENT_PY_FP" != "$PRIVATE_SOURCE_PY_FP" ]; then
            echo "❌ private fleet source dependencies differ from current manifests; maintenance is not permitted" >&2
            return 1
        fi
        return 0
    fi
    local state="$WARM_DEPS_STATE_FILE"
    local node_fp py_fp snap_epoch s_node s_py s_epoch _rest new_snap recorded_state
    node_fp="$(cloudbench_node_dependency_fingerprint "$ROOT_DIR" 2>/dev/null || true)"
    py_fp="$(cloudbench_manifest_fingerprint "$ROOT_DIR" "${CLOUDBENCH_PYTHON_MANIFESTS[@]}" 2>/dev/null || true)"
    CURRENT_NODE_FP="$node_fp"
    CURRENT_PY_FP="$py_fp"
    if [ -z "$node_fp" ] || [ -z "$py_fp" ]; then
        echo "⚠️  could not fingerprint dep manifests — skipping warm-deps preflight" >&2
        return 0
    fi
    recorded_state="$(warm_deps_recorded_state 2>/dev/null || true)"
    if [ -n "$recorded_state" ]; then
        read -r s_node s_py s_epoch _rest <<< "$recorded_state" || true
        # Hydration already bound this exact completed snapshot and epoch to
        # the donor, volume and manifests. Reuse that captured inventory: an
        # uncertain later provider read is not evidence that proof went stale.
        if [ -n "${HYDRATED_WARM_DEPS_STATE:-}" ] && [ -n "${SNAPSHOTS_JSON:-}" ]; then
            snap_epoch="$(snapshot_created_epoch "$SNAP_ID" "$SNAPSHOTS_JSON")" || {
                echo "❌ warm snapshot freshness could not be verified; refusing maintenance" >&2
                return 1
            }
        else
            snap_epoch="$(snapshot_created_epoch "$SNAP_ID")" || {
                echo "❌ warm snapshot freshness could not be verified; refusing maintenance" >&2
                return 1
            }
        fi
        if [ "$s_node" = "$node_fp" ] && [ "$s_py" = "$py_fp" ] && \
           [ "$_rest" = "$SNAP_ID" ] && \
           [ "${snap_epoch:-0}" -ge $(( ${s_epoch:-0} - 60 )) ]; then
            # Migrate a verified legacy controller receipt without another
            # install/snapshot. This writes metadata only, including if another
            # controller has since started the donor for maintenance.
            if [ "${warm_json:-[]}" != "[]" ] && [ -n "${SNAPSHOTS_JSON:-}" ] && \
                ! printf '{"machines":%s,"snapshots":%s}' \
                "$warm_json" "$SNAPSHOTS_JSON" | cloudbench_warm_deps_state_from_inventory \
                "$APP" "$WARM_ID" "$VOL_ID" "$node_fp" "$py_fp" >/dev/null; then
                if ! cloudbench_publish_warm_deps_state "$APP" "$WARM_ID" "$VOL_ID" \
                    "$s_node" "$s_py" "$s_epoch" "$SNAP_ID"; then
                    echo "⚠️  shared dependency proof publication failed; using this checkout's verified snapshot" >&2
                fi
            fi
            echo "✅ warm snapshot dep trees match the current ref (fast bring-up)"
            return 0
        fi
    fi
    # Require committed dependency changes before rebuilding the shared donor.
    # Maintenance receives the same base + pinned patch as task guests, including
    # unpublished commits. Task boxes still never install from the network.
    if ! git -C "$ROOT_DIR" diff --quiet HEAD -- agents/requirements.txt \
        '*package.json' '*package-lock.json' 2>/dev/null; then
        echo "❌ dep manifests are DIRTY vs HEAD — commit them before the central dependency rebuild" >&2
        return 1
    fi
    if [ "${POOL_REUSE_ONLY:-0}" = 1 ]; then
        echo "❌ reuse-only dependency baseline is unproven; refusing automatic warm maintenance" >&2
        return 1
    fi
    if [ "${CLOUDBENCH_WARM_DEPS_AUTOREFRESH:-1}" != "1" ]; then
        echo "❌ warm snapshot dep trees are STALE vs the current ref and automatic maintenance is disabled." >&2
        echo "    heal centrally: bash scripts/run-bench-cloud --refresh-deps --ref $BENCH_REF" >&2
        return 1
    fi
    write_startup_card "healing warm snapshot (dep trees)"
    echo "♻️  warm snapshot dep trees unproven/stale → central refresh ONCE (instead of ×${#BENCHES[@]} per-clone rsyncs) ..."
    # Export a live controller token so --refresh-deps never depends solely on
    # the durable Fly GITHUB_TOKEN secret (often missing/stale on the warm box).
    if _refresh_tok_b64="$(controller_github_token_b64 2>/dev/null)"; then
        export CLOUDBENCH_GITHUB_TOKEN_B64="$_refresh_tok_b64"
    fi
    unset _refresh_tok_b64
    if CLOUDBENCH_LOCAL_PATCH_SOURCE="${FLEET_PATCH_FILE:-}" \
       CLOUDBENCH_LOCAL_PATCH_SHA256="${FLEET_PATCH_SHA256:-}" \
       bash "$RUN_BENCH_CLOUD_BIN" --refresh-deps --ref "$BENCH_REF" 2>&1 | while IFS= read -r _l; do printf '   %s\n' "$_l"; done; then
        s_node=""; s_py=""; s_epoch=""; new_snap=""
        [ -f "$state" ] && read -r s_node s_py s_epoch new_snap < "$state" || true
        snap_epoch="$(snapshot_created_epoch "$new_snap")"
        if [ "$s_node" = "$node_fp" ] && [ "$s_py" = "$py_fp" ] \
            && [ -n "$new_snap" ] && snapshot_is_complete_exact "$new_snap" \
            && [ "${snap_epoch:-0}" -ge $(( ${s_epoch:-0} - 60 )) ]; then
            SNAP_ID="$new_snap"
            echo "✅ central refresh done — forking from its exact proven snapshot $SNAP_ID"
            return 0
        fi
        echo "❌ central refresh returned without a matching exact snapshot proof" >&2
    fi
    echo "❌ central dep refresh failed; refusing to provision task machines" >&2
    return 1
}
warm_deps_preflight || exit 1
fresh_target_region_bind_destination || exit 1
echo "🧊 forking clones from complete snapshot: $SNAP_ID"

# A newer snapshot is not proof that it contains the dependency state recorded
# for an older snapshot: the mutable warm checkout can subsequently move to an
# older ref. Likewise, an existing pool must carry the manifest fingerprints
# current code expects. Fail before claiming or starting a single task box.
if [ "${DISPOSABLE_LIFECYCLE:-0}" != 1 ] && [ -s "$POOL_IDS_FILE" ]; then
    pool_node=""; pool_py=""; pool_snap=""
    [ -f "$POOL_META_FILE" ] && read -r pool_node pool_py pool_snap < "$POOL_META_FILE" || true
    if [ -z "$CURRENT_NODE_FP" ] || [ -z "$CURRENT_PY_FP" ] \
        || [ "$pool_node" != "$CURRENT_NODE_FP" ] \
        || [ "$pool_py" != "$CURRENT_PY_FP" ]; then
        echo "❌ pooled machines were built from unproven/stale dependency trees; refusing to start them" >&2
        echo "   retire this workspace's stopped pool first; then rebuild with: bash scripts/run-bench-fleet --provision-pool ${PROVISION_POOL:-${#BENCHES[@]}}" >&2
        exit 1
    fi
    if [ "${POOL_COLD_BOOTSTRAP:-0}" = 1 ]; then
        echo "✅ cold pool image manifest baseline matches; guest checkout remains uninitialized until guarded bootstrap"
    else
        echo "✅ pooled dependency trees match the current ref (${pool_snap:-unknown snapshot})"
    fi
fi

# Recover only positively owned ephemeral clones whose same-host controller
# identity is definitively dead. Any active runner, unreadable probe, malformed
# ownership, or transitional provider state blocks new provisioning.
reconcile_stale_fleet_registries || exit 1
# Reap data-plane proxy tunnels leaked by SIGKILLed/crashed controllers before
# provisioning, so a backlog of orphaned tunnels can't starve this run's proxies.
if [ -z "${RUN_BENCH_CLEANUP_COHORT_DIR:-}" ] || [ "${POOL_REUSE_ONLY:-0}" = 1 ]; then
    reap_orphaned_fleet_proxies
fi
# Recovery may have removed active machines. Capacity must classify the
# post-reconciliation provider state, not the earlier warm-source lookup.
if [ -n "${CLOUDBENCH_CAMPAIGN_INVENTORY_DIR:-}" ]; then
    if { [ "${FLEET_STALE_RECONCILIATION_MAY_HAVE_MUTATED:-1}" != 0 ] \
        && [ "${FLEET_STALE_RECONCILIATION_INVENTORY_SATISFIED:-0}" != 1 ]; } \
        || [ "${FLEET_POOL_RECONCILIATION_MAY_HAVE_MUTATED:-1}" != 0 ]; then
        refresh_machines_snapshot_after "$(machines_snapshot_identity)" || {
            echo "❌ App capacity guard could not refresh machine state after stale-fleet recovery." >&2
            exit 1
        }
    fi
    campaign_inventory_capture warm_json fleet_admission_machines_json || {
        echo "❌ App capacity guard could not refresh machine state after stale-fleet recovery." >&2
        exit 1
    }
else
    # Standalone recovery must retain its exact fresh provider observation.
    warm_json="$(FLY machines list -a "$APP" --json 2>/dev/null)" || {
        echo "❌ App capacity guard could not refresh machine state after stale-fleet recovery." >&2
        exit 1
    }
fi

# ── App-wide capacity guard — shared CPU + physical Machine count ────────────
# Fly independently enforces an org Machine-count ceiling and a shared-CPU
# overcommit governor. Live inventory at the epoch-13 failure was 100 org
# Machines: 56 in this benchmark app and 44 outside it. Model 56 truthfully as
# the benchmark app's explicit allocation, not as a fictional 60−4 org limit.
# Stopped inventory is compute-free but still occupies a Machine slot, while a
# config-only `machine update --skip-start` briefly allocates a replacement.
# Host-wide durable reservations close the cross-workspace check-then-act race.
enforce_app_capacity_guard() {
    local shared_cpu_governor shared_cpu_headroom shared_cpu_ceiling
    local app_machine_ceiling primary_nx primary_shared_units requested_machines
    local requested_shared requested_fresh_machines available_pool_machines
    local requested_pool_eligible_machines bench bench_vm_size bench_shared_units
    local replacement_slots reservation_machine_slots reservation_result reservation_status
    local reservation_outcome reserved_machines reserved_shared
    local capacity_counts active_shared active_perf capacity_parse_status
    local LC_ALL=C
    local running_machines stopped_machines total_machines projected_shared
    local projected_machines soft_line

    CAPACITY_ADMISSION_RETRYABLE=0

    CAPACITY_RESERVATION_ROOT="${CAPACITY_RESERVATION_ROOT:-${CLOUDBENCH_CAPACITY_RESERVATION_ROOT:-${TMPDIR:-/tmp}/rose-cloudbench-capacity-$APP}}"
    CAPACITY_RESERVATION_TOKEN="${CAPACITY_RESERVATION_TOKEN:-$FLEET_OWNER_TOKEN-primary}"
    CAPACITY_RESERVATION_PUBLISHED="${CAPACITY_RESERVATION_PUBLISHED:-0}"
    # Raised 2026-11-06 from 160 / 56 after proving Fly allows far more: org settings
    # report machines_per_org_limit=1000 and no CPU quota; the placement simulator fits
    # 250 shared-cpu-4x (1000 units) and 300 performance-1x in iad; 60 real shared-cpu-4x
    # creates raised the org to 313 shared units with no rejection
    # (/project/fly-capacity-probe-20261106). Production workers are performance-1x and
    # draw no shared units. The downstream limits these ceilings used to imply are now
    # explicit lane ceilings (admit_lane_capacity below), not machine counts.
    shared_cpu_governor="${CLOUDBENCH_SHARED_CPU_GOVERNOR:-1000}"
    # The shared-CPU governor is org-wide while this guard sees only the
    # benchmark app, so retain the separately established production headroom.
    shared_cpu_headroom="${CLOUDBENCH_SHARED_CPU_HEADROOM:-20}"
    app_machine_ceiling="${CLOUDBENCH_APP_MACHINE_CEILING:-300}"
    replacement_slots="${CLOUDBENCH_BOOT_CONFIG_MAX_IN_FLIGHT:-4}"
    case "$shared_cpu_governor:$shared_cpu_headroom:$app_machine_ceiling:$replacement_slots" in
        *[!0-9:]*)
            echo "❌ capacity ceilings, governors, and headroom must be non-negative integers" >&2
            return 1
            ;;
    esac
    if [ "$shared_cpu_governor" -le "$shared_cpu_headroom" ] \
        || [ "$app_machine_ceiling" -lt 1 ] \
        || [ "$replacement_slots" -lt 1 ]; then
        echo "❌ invalid capacity ceiling/governor contract" >&2
        return 1
    fi
    shared_cpu_ceiling=$(( shared_cpu_governor - shared_cpu_headroom ))

    # Shared units per default primary, parsed from the primary shape
    # (shared-cpu-Nx → N); default 2 if the shape is non-standard.
    primary_nx="${FLEET_PRIMARY_VM_SIZE##*-}"; primary_nx="${primary_nx%x}"
    case "$primary_nx" in ''|*[!0-9]*) primary_shared_units=2 ;; *) primary_shared_units="$primary_nx" ;; esac
    requested_machines="${PROVISION_POOL:-${#BENCHES[@]}}"
    # Retain the historical local replacement-capacity accounting setting;
    # it is not a measured provider concurrency limit or dispatch batch size.
    # This fleet reserves no more replacement slots than its primary count.
    [ "$replacement_slots" -gt "$requested_machines" ] \
        && replacement_slots="$requested_machines"
    requested_pool_eligible_machines="$requested_machines"
    if [ -n "${PROVISION_POOL:-}" ]; then
        requested_shared=$(( requested_machines * primary_shared_units ))
    else
        requested_shared=0
        requested_pool_eligible_machines=0
        for bench in "${BENCHES[@]}"; do
            bench_vm_size="$(primary_vm_size_for_bench "$bench")"
            bench_shared_units="$(shared_cpu_units_for_vm_size "$bench_vm_size")"
            case "$bench_shared_units" in ''|*[!0-9]*)
                echo "❌ invalid shared-CPU units for primary VM size '$bench_vm_size'" >&2
                return 1
                ;;
            esac
            requested_shared=$(( requested_shared + bench_shared_units ))
            if bench_uses_default_pool_shape "$bench"; then
                requested_pool_eligible_machines=$(( requested_pool_eligible_machines + 1 ))
            fi
        done
    fi
    # Pool provisioning does not run the post-clone boot-config update phase.
    [ -n "${PROVISION_POOL:-}" ] && replacement_slots=0

    available_pool_machines=0
    if [ "${DISPOSABLE_LIFECYCLE:-0}" != 1 ]; then
    available_pool_machines="$(available_stopped_pool_machine_count "$warm_json")" || {
        echo "❌ App capacity guard could not classify available stopped pool Machines." >&2
        return 1
    }
    fi
    case "$available_pool_machines" in ''|*[!0-9]*)
        echo "❌ App capacity guard received an invalid available-pool count." >&2
        return 1
        ;;
    esac
    [ "$available_pool_machines" -gt "$requested_pool_eligible_machines" ] \
        && available_pool_machines="$requested_pool_eligible_machines"
    local archived_reuse_count
    archived_reuse_count="$(archived_reuse_capacity_credit)" || return 1
    [ "$available_pool_machines" = 0 ] || [ "$archived_reuse_count" = 0 ] || return 1
    requested_fresh_machines=$(( requested_machines - available_pool_machines - archived_reuse_count ))
    [ "$requested_fresh_machines" -ge 0 ] || return 1
    if [ "${POOL_REUSE_ONLY:-0}" = 1 ] && [ "$requested_fresh_machines" -ne 0 ]; then
        echo "❌ reuse-only requires $requested_machines eligible stopped pool primaries; observed $available_pool_machines" >&2
        return 1
    fi
    reservation_machine_slots=$(( requested_fresh_machines + replacement_slots ))

    capacity_parse_status=0
    capacity_counts="$(printf '%s' "$warm_json" | python3 -c '
import json, sys
try:
    machines = json.load(sys.stdin)
    if not isinstance(machines, list) or any(not isinstance(m, dict) for m in machines):
        raise ValueError("invalid machine list")
    active_shared = active_perf = running = stopped = 0
    for m in machines:
        if m.get("state") == "stopped":
            stopped += 1
            continue
        running += 1
        guest = (m.get("config") or {}).get("guest") or {}
        cpus = guest.get("cpus")
        cpus = cpus if isinstance(cpus, int) and cpus > 0 else 1
        if guest.get("cpu_kind") == "shared":
            active_shared += cpus
        else:
            active_perf += cpus
    print(active_shared, active_perf, running, stopped, len(machines))
except Exception as exc:
    position = getattr(exc, "pos", -1)
    print(f"capacity classification failed: {type(exc).__name__} position={position}", file=sys.stderr)
    raise SystemExit(1)
')" || capacity_parse_status=$?
    if [ "$capacity_parse_status" -ne 0 ] || [ -z "$capacity_counts" ]; then
        printf 'capacity classification diagnostic: exit=%s input_bytes=%s\n' "$capacity_parse_status" "${#warm_json}" >&2
        echo "❌ App capacity guard could not classify current machine states; refusing to provision." >&2
        return 1
    fi
    read -r active_shared active_perf running_machines stopped_machines total_machines <<< "$capacity_counts"

    admit_lane_capacity "$warm_json" || return 1

    reservation_status=0
    reservation_result="$(capacity_reserve_slots "$CAPACITY_RESERVATION_TOKEN" \
        "$reservation_machine_slots" "$requested_shared" \
        "$app_machine_ceiling" "$shared_cpu_ceiling" \
        "$total_machines" "$active_shared" primary)" || reservation_status=$?
    read -r reservation_outcome reserved_machines reserved_shared \
        projected_machines projected_shared <<< "$reservation_result"
    if [ "$reservation_status" -ne 0 ]; then
        case "$reservation_outcome" in
            DENY_MACHINE)
                CAPACITY_ADMISSION_RETRYABLE=1
                echo "❌ Machine-count capacity admission denied: $total_machines app Machines" >&2
                [ "${reserved_machines:-0}" -gt 0 ] \
                    && echo "   + $reserved_machines slots reserved by live workstreams" >&2
                echo "   + this run's $requested_fresh_machines fresh primaries ($available_pool_machines from stopped pool)" >&2
                echo "   + $replacement_slots boot-config replacement slots = $projected_machines" >&2
                echo "   > benchmark-app Machine ceiling $app_machine_ceiling." >&2
                echo "   Wait for another workstream to drain or adjust this app allocation after the org reservation changes." >&2
                ;;
            DENY_SHARED)
                CAPACITY_ADMISSION_RETRYABLE=1
                echo "❌ Shared-CPU capacity governor reached: $active_shared active shared units" >&2
                [ "${reserved_shared:-0}" -gt 0 ] \
                    && echo "   + $reserved_shared units reserved by live workstreams" >&2
                echo "   + this run's $requested_machines primaries ($requested_shared units) = $projected_shared" >&2
                echo "   > ceiling $shared_cpu_ceiling (governor $shared_cpu_governor − headroom $shared_cpu_headroom)." >&2
                echo "   Raise the Fly org reservation and CLOUDBENCH_SHARED_CPU_GOVERNOR together, or wait for another workstream to drain." >&2
                ;;
            *)
                echo "❌ App capacity reservation failed closed: ${reservation_result#ERROR }" >&2
                ;;
        esac
        return 1
    fi
    CAPACITY_RESERVATION_PUBLISHED=1

    if [ "$projected_shared" -gt "$shared_cpu_ceiling" ]; then
        # Defensive: capacity_reserve_slots owns this decision atomically.  A
        # contradictory success is an internal contract failure, not admission.
        echo "❌ Shared-CPU capacity reservation returned an invalid projection." >&2
        capacity_release_reservation "$CAPACITY_RESERVATION_TOKEN" || true
        CAPACITY_RESERVATION_PUBLISHED=0
        return 1
    fi
    if [ "$reservation_outcome" != "OK" ]; then
        echo "❌ App capacity reservation returned an invalid result." >&2
        capacity_release_reservation "$CAPACITY_RESERVATION_TOKEN" || true
        CAPACITY_RESERVATION_PUBLISHED=0
        return 1
    fi

    # Announce pressure on either physical boundary so concurrent runs stay visible.
    soft_line=$(( shared_cpu_ceiling * 3 / 4 ))
    if [ "$projected_shared" -gt "$soft_line" ]; then
        echo "🧵 auto-reserving shared capacity for this workstream: $projected_shared/$shared_cpu_ceiling units" >&2
        echo "   ($active_shared active + $reserved_shared live-reserved + $requested_shared requested; $active_perf perf units; running=$running_machines stopped=$stopped_machines; Machines=$total_machines+$reserved_machines+$reservation_machine_slots/$app_machine_ceiling) — proceeding." >&2
    elif [ "$available_pool_machines" -gt 0 ] || [ "$reserved_machines" -gt 0 ]; then
        echo "🧵 capacity admitted with $available_pool_machines stopped pool Machine(s) and $reserved_machines live cross-workstream slot(s) already accounted."
    fi

    return 0
}

# Cross-workstream lane ceilings: the downstream capacity a machine count used to imply.
#   demo:       guests replaying the shared DEMO cache hold 4 production-pooler clients
#               each (cloudbench-run.sh). back-end/src/providers/database.ts leaves 300
#               non-production clients; 5 dev/benchmark stacks at 20 keep 100, so 200/4 = 50.
#   delegating: REAL/SIM primaries lease production compute tokens per LLM call (the
#               Render backend has no rate limit and no measured ceiling) and share
#               provider caps (Parallel 70 across launches). 70 is the widest proven run
#               (2026-10-19 fresh 70: 0 infra). Raise it only with a measured backend load.
# Counted from the live app inventory, so every devbox's workstreams are included.
# Unlabelled live primaries count as delegating; performance-1x guests are autoscaler
# workers (no pooler client, no lease of their own) and suspended warm members are idle.
admit_lane_capacity() {  # <app machine list json>
    [ -n "${PROVISION_POOL:-}" ] && return 0
    [ "${INFRA_PROBE:-0}" = 1 ] && return 0
    local demo_ceiling="${CLOUDBENCH_DEMO_GUEST_CEILING:-50}"
    local delegating_ceiling="${CLOUDBENCH_DELEGATING_PRIMARY_CEILING:-70}"
    case "$demo_ceiling:$delegating_ceiling" in *[!0-9:]*|:*|*:)
        echo "❌ lane ceilings must be non-negative integers" >&2; return 1 ;;
    esac
    local requested_demo=0 requested_delegating=0 bench lane
    for bench in "${BENCHES[@]}"; do
        lane="${CLOUDBENCH_LANE:-}"
        if [ -z "$lane" ]; then
            if bench_uses_shared_demo_cache "$bench"; then lane=demo; else lane=delegating; fi
        fi
        case "$lane" in
            demo) requested_demo=$(( requested_demo + 1 )) ;;
            infra) ;;
            *) requested_delegating=$(( requested_delegating + 1 )) ;;
        esac
    done
    local live
    live="$(printf '%s' "$1" | python3 -c '
import json, sys
machines = json.load(sys.stdin)
demo = delegating = 0
for m in machines:
    if m.get("state") in ("stopped", "suspended", "destroyed", "destroying"):
        continue
    config = m.get("config") or {}
    lane = (config.get("metadata") or {}).get("rose_cloudbench_lane")
    guest = config.get("guest") or {}
    if lane == "demo":
        demo += 1
    elif lane in ("infra", "worker"):
        continue
    elif lane == "delegating" or not (guest.get("cpu_kind") == "performance" and guest.get("cpus") == 1):
        delegating += 1
print(demo, delegating)
')" || { echo "❌ App capacity guard could not classify live guest lanes; refusing to provision." >&2; return 1; }
    local live_demo live_delegating
    read -r live_demo live_delegating <<< "$live"
    if [ $(( live_demo + requested_demo )) -gt "$demo_ceiling" ]; then
        CAPACITY_ADMISSION_RETRYABLE=1
        echo "❌ DEMO guest ceiling reached: $live_demo live + $requested_demo requested > $demo_ceiling" >&2
        echo "   Each DEMO guest holds 4 production-pooler clients; non-production has 300 of 1000 (back-end/src/providers/database.ts)." >&2
        return 1
    fi
    if [ $(( live_delegating + requested_delegating )) -gt "$delegating_ceiling" ]; then
        CAPACITY_ADMISSION_RETRYABLE=1
        echo "❌ Delegating-guest ceiling reached: $live_delegating live REAL/SIM primaries + $requested_delegating requested > $delegating_ceiling" >&2
        echo "   They lease production compute tokens and shared provider capacity; $delegating_ceiling is the widest proven-safe width." >&2
        return 1
    fi
    return 0
}

admit_app_capacity_with_wait() {
    local deadline interval remaining inventory_status phase="during admission wait"
    local refresh_inventory="${1:-0}"
    local wait_seconds="${CLOUDBENCH_CAPACITY_ADMISSION_WAIT_SECONDS:-300}"
    # Every devbox shares the app's ceilings, so a shortfall is normally another
    # devbox's fleet that will release. A caller with its own gate deadline (the
    # deploy cloud adapter) passes it explicitly as an absolute epoch and
    # admission keeps polling at the same cadence until then; the ceilings and
    # the 300 s default for other callers are unchanged.
    local caller_deadline="${CLOUDBENCH_CAPACITY_ADMISSION_DEADLINE_EPOCH:-}" budget_label
    interval="${CLOUDBENCH_CAPACITY_ADMISSION_RETRY_SECONDS:-10}"
    case "$wait_seconds:$interval:$caller_deadline" in
        *[!0-9:]*) echo "❌ capacity admission wait, retry seconds and caller deadline must be integers" >&2; return 2 ;;
    esac
    if [ -n "$caller_deadline" ] && [ -z "${CAPACITY_ADMISSION_DEADLINE:-}" ]; then
        wait_seconds=$((caller_deadline - $(date +%s)))
        if [ "$wait_seconds" -lt 1 ]; then
            echo "❌ caller's capacity admission deadline already passed (epoch $caller_deadline)" >&2
            return 1
        fi
    fi
    if [ "$wait_seconds" -lt 1 ] || [ "$interval" -lt 1 ]; then
        echo "❌ capacity admission wait and retry seconds must be positive" >&2
        return 2
    fi
    budget_label="admission wait"
    [ -z "$caller_deadline" ] || budget_label="caller's deadline"
    [ "$refresh_inventory" != 1 ] || phase="after infra canary"
    deadline="${CAPACITY_ADMISSION_DEADLINE:-$((SECONDS + wait_seconds))}"
    case "$deadline" in ''|*[!0-9]*) echo "❌ invalid original capacity admission deadline" >&2; return 2 ;; esac
    CAPACITY_ADMISSION_DEADLINE="$deadline"
    while :; do
        inventory_status=0
        if [ "$refresh_inventory" = 1 ]; then
            warm_json="$(fleet_admission_machines_json)" || inventory_status=$?
        fi
        if [ "$inventory_status" = 0 ]; then
            enforce_app_capacity_guard && return 0
            [ "$CAPACITY_ADMISSION_RETRYABLE" = 1 ] || return 1
        elif [ "$inventory_status" = 75 ] && [ -n "${SNAPSHOT_LOOP_PID:-}" ]; then
            echo "⚠️ native inventory temporarily unavailable; withholding capacity admission" >&2
        else
            echo "❌ App capacity guard could not refresh machine state $phase." >&2
            return 1
        fi
        remaining=$((deadline - SECONDS))
        if [ "$remaining" -le 0 ]; then
            echo "❌ capacity admission remained blocked for ${wait_seconds}s (${budget_label})" >&2
            return 1
        fi
        [ "$interval" -gt "$remaining" ] && interval="$remaining"
        echo "⏳ capacity admission pending; retrying provider observation in ${interval}s (${remaining}s left before the ${budget_label})" >&2
        sleep "$interval"
        refresh_inventory=1
        phase="during admission wait"
    done
}
start_admitted_machines_snapshot_loop() {
    # Admission already established this deadline and reserved this fleet.
    # A borrowed publisher may cross its generation expiry before reuse. Wait
    # only inside that original clock; never re-reserve or accept stale data.
    local status remaining interval="${CLOUDBENCH_CAPACITY_ADMISSION_RETRY_SECONDS:-10}"
    while :; do
        status=0
        start_machines_snapshot_loop || status=$?
        [ "$status" -ne 0 ] || return 0
        if [ "$status" -ne 75 ] \
            || [ -z "${CLOUDBENCH_CAMPAIGN_INVENTORY_DIR:-}" ] \
            || [ "${INVENTORY_PUBLISHER_BORROWED:-0}" != 1 ]; then
            echo "❌ post-admission inventory authority unavailable (status=$status); refusing provisioning" >&2
            return 1
        fi
        case "${CAPACITY_ADMISSION_DEADLINE:-}:$interval" in
            *[!0-9:]*|:*) echo "❌ invalid original inventory admission wait clock" >&2; return 1 ;;
        esac
        [ "$interval" -gt 0 ] || return 1
        remaining=$((CAPACITY_ADMISSION_DEADLINE - SECONDS))
        if [ "$remaining" -le 0 ]; then
            echo "❌ post-admission inventory remained unavailable within the original admission deadline" >&2
            return 1
        fi
        [ "$interval" -le "$remaining" ] || interval="$remaining"
        echo "⏳ post-admission inventory temporarily unavailable; withholding provisioning within original deadline" >&2
        sleep "$interval"
    done
}

release_capacity_reservation_after_primary_start_accounted() {
    # Replacement slots are no longer needed once every stopped boot config is
    # committed.  Keep the shared-unit reservation until Fly inventory itself
    # shows each accepted primary start as non-stopped; releasing on the local
    # barrier alone would let a neighbor admit during provider-state lag.
    local deadline accounted out remaining
    [ "$CAPACITY_RESERVATION_PUBLISHED" = "1" ] || return 0
    [ "${CHILD_MACHINE[0]+set}" = "set" ] || return 1
    if [ "${#CHILD_MACHINE[@]}" -ne "${#BENCHES[@]}" ] \
        || [ "${#CHILD_OUT[@]}" -ne "${#BENCHES[@]}" ]; then
        echo "⚠️  retaining startup capacity reservation: only ${#CHILD_MACHINE[@]}/${#BENCHES[@]} requested primaries provisioned" >&2
        return 1
    fi
    deadline=$((SECONDS + ${CLOUDBENCH_CAPACITY_START_ACCOUNTING_SECONDS:-120}))
    while [ "$SECONDS" -lt "$deadline" ]; do
        accounted=1
        for out in "${CHILD_OUT[@]}"; do
            [ -s "$out/post-config-start.accepted" ] || { accounted=0; break; }
        done
        if [ "$accounted" = "1" ]; then
            remaining=$((deadline - SECONDS))
            [ "$remaining" -gt 0 ] || break
            accounted="$(python3 -S - "$CLOUDBENCH_SCRIPT_SNAPSHOT/cloudbench-campaign-machines.py" \
                "$APP" "$remaining" "${CHILD_MACHINE[@]}" <<'PYACCOUNT'
import json
import runpy
import signal
import sys
import time

helper, app, seconds, *ids = sys.argv[1:]
deadline = time.monotonic() + float(seconds)
def expired(signum, frame):
    raise TimeoutError('original start accounting deadline')

try:
    signal.signal(signal.SIGALRM, expired)
    signal.setitimer(signal.ITIMER_REAL, max(0.001, deadline - time.monotonic()))
    fetch = runpy.run_path(helper)['fetch']
    if not ids or len(set(ids)) != len(ids):
        raise ValueError('invalid owned primary identities')
    for machine_id in ids:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise ValueError('original start accounting deadline')
        raw = fetch(app, remaining, machine_id)
        # fetch owns and clears its I/O alarm; restore this same outer clock
        # before parsing or loading the next selected response.
        signal.setitimer(signal.ITIMER_REAL, max(0.001, deadline - time.monotonic()))
        machine = json.loads(raw)
        if machine.get('id') != machine_id or not machine.get('state') or machine['state'] == 'stopped':
            raise ValueError('primary start not yet provider visible')
    print(1 if time.monotonic() < deadline else 0)
except Exception:
    print(0)
finally:
    signal.setitimer(signal.ITIMER_REAL, 0)
PYACCOUNT
)" || accounted=0
            if [ "$accounted" = "1" ] && [ "$SECONDS" -lt "$deadline" ]; then
                if capacity_release_reservation "$CAPACITY_RESERVATION_TOKEN"; then
                    CAPACITY_RESERVATION_PUBLISHED=0
                    echo "🧵 released startup capacity reservation after all primary starts became provider-visible"
                    return 0
                fi
                echo "❌ could not release the startup capacity reservation" >&2
                return 1
            fi
        fi
        sleep 0.2
    done
    echo "⚠️  retaining startup capacity reservation: primary starts did not become provider-visible within the accounting window" >&2
    return 1
}

reserve_worker_machine_slot() {  # <unique-reservation-token>
    # Autoscaler workers are created after startup admission is released.  Give
    # every dynamic clone the same serialized one-Machine check so concurrent
    # autoscalers cannot refill the Machine ceiling behind the startup guard.
    local token="$1" app_machine_ceiling current_machines result status outcome
    local reserved_machines reserved_shared projected_machines projected_shared
    # Same default as the startup admission (raised from 56 on 2026-11-06): a stale 56 denied
    # a mass-agent worker clone at "61 app Machines" while the primaries had been admitted.
    app_machine_ceiling="${CLOUDBENCH_APP_MACHINE_CEILING:-300}"
    case "$app_machine_ceiling" in ''|*[!0-9]*|0) return 1 ;; esac
    local worker_inventory inventory_status=0
    if [ -n "${CLOUDBENCH_CAMPAIGN_INVENTORY_DIR:-}" ] || [ -n "${SNAPSHOT_LOOP_PID:-}" ]; then
        worker_inventory="$(fleet_admission_machines_json)" || inventory_status=$?
        # Healthy temporary absence stays pending; invalid ownership remains fatal.
        [ "$inventory_status" = 0 ] || return "$inventory_status"
    else
        worker_inventory="$(FLY machines list -a "$APP" --json 2>/dev/null)" || {
            echo "⚠️ worker capacity inventory unavailable; admission pending" >&2
            return 75
        }
    fi
    if ! current_machines="$(printf '%s' "$worker_inventory" | python3 -c '
import json, sys
try:
    machines = json.load(sys.stdin)
    if not isinstance(machines, list) or any(not isinstance(machine, dict) for machine in machines):
        raise ValueError
    print(len(machines))
except Exception:
    print("")
' 2>/dev/null)"; then
        echo "⚠️ worker capacity inventory unavailable; admission pending" >&2
        return 75
    fi
    case "$current_machines" in
        ''|*[!0-9]*)
            if [ -n "${CLOUDBENCH_CAMPAIGN_INVENTORY_DIR:-}" ] || [ -n "${SNAPSHOT_LOOP_PID:-}" ]; then
                echo "❌ worker shared capacity inventory malformed; refusing admission" >&2
                return 1
            fi
            echo "⚠️ worker capacity inventory invalid; admission pending" >&2
            return 75
            ;;
    esac
    result="$(capacity_reserve_slots "$token" 1 0 "$app_machine_ceiling" \
        2147483647 "$current_machines" 0 autoscaler-worker)"
    status=$?
    read -r outcome reserved_machines reserved_shared projected_machines projected_shared <<< "$result"
    if [ "$status" -ne 0 ] || [ "$outcome" != "OK" ]; then
        echo "❌ dynamic worker capacity denied: $current_machines app Machines + ${reserved_machines:-0} reserved + 1 requested > ceiling $app_machine_ceiling" >&2
        return 1
    fi
    return 0
}

# --provision-pool: one-time pre-provision of N stopped clones, then exit.
if [ -n "$PROVISION_POOL" ]; then
    admit_app_capacity_with_wait || exit 1
    # Pool slots all observe ONE controller-owned inventory stream. Without it,
    # 30 readiness loops each issued machine+volume list calls every five
    # seconds (90 API reads/cycle), recreating resource_exhausted before the
    # benchmark even started.
    start_machines_snapshot_loop || exit 1
    provision_pool "$PROVISION_POOL"
    exit $?
fi

CODE_SUMMARY=""
print_code_provenance

# ── Per-bench worker autoscaling (prod params, scoped to the bench's queue) ──
# The box worker computes desired_machine_count off its own Temporal queue with
# prod's exact params (backlog ≥20% capacity → add ceil(backlog/capacity); 60s
# zero backlog → remove) and exposes it on HEALTH_CHECK_PORT/metrics, but never
# actuates (FLY_APP_NAME="" + AUTOSCALER_ACTUATE=0). We read that number and
# reconcile a pool of WORKER-ONLY clones bound to THIS bench's queue + backend
# (Fly 6PN) — the same shape as prod's pool, isolated per bench. Workers are torn
# down on scale-down and at fleet exit.
BOX_HEALTH_PORT="3003"     # cloudbench-run.sh HEALTH_PORT = CONDUCTOR_PORT(3001)+2
# The guest worker's queue observation spends the shared Temporal namespace's
# Visibility API budget (prod uses it too). Pace every concurrent guest on this
# host so their sum stays within CLOUDBENCH_TEMPORAL_VISIBILITY_CALLS_PER_SECOND;
# a campaign child counts the campaign's concurrent guests, not just itself.
CLOUDBENCH_GUEST_AUTOSCALER_POLL_SECONDS="$(cloudbench_guest_autoscaler_poll_seconds \
    "${CLOUDBENCH_CAMPAIGN_CONCURRENT_GUESTS:-${#BENCHES[@]}}" "" "$AUTOSCALE_POLL")" || exit 1
export CLOUDBENCH_GUEST_AUTOSCALER_POLL_SECONDS
echo "🛰️  guest autoscaler observation every ${CLOUDBENCH_GUEST_AUTOSCALER_POLL_SECONDS}s (Temporal visibility budget ${CLOUDBENCH_TEMPORAL_VISIBILITY_CALLS_PER_SECOND:-20}/s)"
BOX_BACKEND_PORT="3001"
BOX_WMH_PORT="3007"        # run.sh WMH_PORT = base+6

_machine_priv_ip() {  # _machine_priv_ip <machine_id>
    inventory_machine_field "$1" private_ip 2>/dev/null || true
}

# Freeze the exact execution lane before the first task Machine is provisioned.
# Only explicit non-secret values enter this document: credentials, auth
# material, barrier tokens, and their hashes are intentionally absent. The
# helper re-hashes the actual immutable snapshot here, so a stale or edited
# dependency bundle cannot be promoted merely by retaining its old manifest.
EXECUTION_PROVENANCE_FILE="$FLEET_DIR/execution-provenance.json"
EXECUTION_TASK_MATRIX_FILE="$FLEET_DIR/execution-task-matrix.json"
workspace_patch_provenance="${FLEET_PATCH_SHA256:-none}"
TASK_MATRIX_ARGS=()
for i in "${!BENCHES[@]}"; do
    provenance_mode="${CATALOG_MODES[$i]}"
    is_sim_on "${BENCHES[$i]}" && provenance_mode="simulate"
    TASK_MATRIX_ARGS+=(--task "${BENCHES[$i]}=$provenance_mode")
done
if ! TASK_MATRIX_SHA256="$(python3 "$EXECUTION_PROVENANCE_SCRIPT" digest-task-matrix \
    "${TASK_MATRIX_ARGS[@]}" --output "$EXECUTION_TASK_MATRIX_FILE")" \
    || [ -z "$TASK_MATRIX_SHA256" ]; then
    echo "❌ could not freeze the ordered Cloud Fleet task matrix" >&2
    exit 1
fi
PROVENANCE_CONFIG_ARGS=(
