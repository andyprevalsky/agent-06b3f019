fleet_billing_stop_retained_idle() {  # <positive-owned-joins>; billing only, never evidence/claim release
    [ "${FLEET_REGISTRY_PUBLISHED:-0}" = 1 ] && [ "${KEEP_CLONES:-0}" = 1 ] || return 0
    python3 - "${CLOUDBENCH_SCRIPT_SNAPSHOT:-$ROOT_DIR/scripts}/cloudbench-original-volume-capture.py" \
        "$APP" "$FLEET_REGISTRY_DIR" "$FLEET_TEARDOWN_OWNERSHIP_DIR" "$FLEET_DIR" \
        "$FLEET_OWNER_TOKEN" "$$" "$FLEET_OWNER_PID_START" "$1" <<'PYBILLING'
import json,os,runpy,signal,sys,time
from pathlib import Path
try:
    if sys.argv[9]!='1':raise ValueError('producer joins are unconfirmed')
    started=time.monotonic()
    prior_timer=signal.getitimer(signal.ITIMER_REAL)
    prior_handler=signal.getsignal(signal.SIGALRM)
    if prior_timer[1]!=0:raise ValueError('periodic caller timer is unsupported')
    deadline=started+(min(180,prior_timer[0]) if prior_timer[0]>0 else 180)
    def expired(*unused):raise TimeoutError('billing caller deadline')
    signal.signal(signal.SIGALRM,expired)
    try:
        remaining=deadline-time.monotonic()
        if remaining<=0:raise TimeoutError('billing caller deadline')
        signal.setitimer(signal.ITIMER_REAL,remaining)
        helper=runpy.run_path(sys.argv[1])
        # Validate current REAP ownership before even refreshing authentication.
        helper['_billing_local'](Path(sys.argv[3]),Path(sys.argv[4]),Path(sys.argv[5]),
            sys.argv[6],int(sys.argv[7]),sys.argv[8],True)
        result=helper['billing_stop_retained_owned'](helper['Fly'](sys.argv[2],os.environ['FLY_API_TOKEN']),
            Path(sys.argv[3]),Path(sys.argv[4]),Path(sys.argv[5]),Path(sys.argv[5])/'_batch/billing-stop-retain',
            sys.argv[6],int(sys.argv[7]),sys.argv[8],joins_verified=True)
        if time.monotonic()>=deadline:raise TimeoutError('billing caller deadline')
    finally:
        signal.setitimer(signal.ITIMER_REAL,0)
        signal.signal(signal.SIGALRM,prior_handler)
        if prior_timer[0]>0:
            signal.setitimer(signal.ITIMER_REAL,max(.000001,prior_timer[0]-(time.monotonic()-started)))
    print(json.dumps(result,sort_keys=True))
except Exception as error:
    # Never print a provider body, token, config or generic exception message.
    pending={'status':'PENDING','reason':'BILLING_STOP_REFUSED','error_class':type(error).__name__,
             'native_release_verified':False,'proof_credit':0}
    try:
        path=Path(sys.argv[5])/'_batch/billing-stop-retain-caller.pending.json'
        with os.fdopen(os.open(path,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600),'w') as stream:
            json.dump(pending,stream,sort_keys=True);stream.write('\n');stream.flush();os.fsync(stream.fileno())
        fd=os.open(path.parent,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW)
        try:os.fsync(fd)
        finally:os.close(fd)
    except OSError:pass  # Preserve an earlier receipt or report storage refusal on stdout.
    print(json.dumps(pending))
PYBILLING
}

fleet_verify_staged_primary_return() {  # <machine> <volume>; before exact claim release
    local id="$1" volume="$2" index out="" attempt
    local -a refresh_args=()
    [ "${3:-record}" != refresh ] || refresh_args=(--refresh-existing)
    for index in "${!CHILD_MACHINE[@]}"; do
        if [ "${CHILD_MACHINE[$index]}" = "$id" ]; then
            [ -z "$out" ] || return 1
            out="${CHILD_OUT[$index]}"
        fi
    done
    if [ "${CLOUDBENCH_BOOT_TRANSPORT:-update}" != staged ]; then
        [ -z "$out" ] || { [ ! -e "$out/staged-boot" ] && [ ! -L "$out/staged-boot" ]; } || return 1
        return 0
    fi
    [ -n "$out" ] && [ -d "$out/staged-boot" ] && [ ! -L "$out/staged-boot" ] || return 1
    attempt="$(mktemp -d "$out/staged-boot/.return.XXXXXX")" || return 1
    fleet_preconfig_native_read "$id" "$attempt/before.json" \
        && fleet_preconfig_native_read "$id" "$attempt/after.json" \
        && fleet_cold_handoff_volume_read "$volume" "$attempt/volume.json" || return 1
    python3 "$CLOUDBENCH_SCRIPT_SNAPSHOT/cloudbench-staged-boot-return.py" \
        --output "$out" --registry "$FLEET_REGISTRY_DIR" --common "$GIT_COMMON_DIR" \
        --source "$BENCH_REF" --machine "$id" --volume "$volume" \
        --before "$attempt/before.json" --after "$attempt/after.json" \
        --volume-path "$attempt/volume.json" "${refresh_args[@]}" > "$attempt/verified.json"
}

fleet_record_staged_primary_release() {  # <machine>; exact claim was just released
    local index out=""
    [ "${CLOUDBENCH_BOOT_TRANSPORT:-update}" = staged ] || return 0
    for index in "${!CHILD_MACHINE[@]}"; do
        if [ "${CHILD_MACHINE[$index]}" = "$1" ]; then
            [ -z "$out" ] || return 1
            out="${CHILD_OUT[$index]}"
        fi
    done
    [ -n "$out" ] || return 1
    python3 "$CLOUDBENCH_SCRIPT_SNAPSHOT/cloudbench-staged-boot-return.py" released \
        "$out" "$GIT_COMMON_DIR" "$1"
}

# The live-owner plan shares the return-to-pool ownership/provenance guards.
# Guest shutdown and owned joins must already have completed before this call.
stop_current_registry_primaries_for_pool() {  # <joins> <guest-failed> <runtime-failed>
    local plan baseline id name volume details state seen_name mounted budget pending
    local seconds="${CLOUDBENCH_GUEST_NATIVE_STOP_SECONDS:-20}" deadline
    local -a ids=() names=() volumes=() states=()
    plan="$(current_registry_primaries_to_pool_plan "$@")" || return 1
    baseline="${plan%%$'\n'*}"
    [ "$plan" != "$baseline" ] || return 0
    case "$seconds" in ''|*[!0-9]*|0) seconds=20 ;; esac
    deadline=$((SECONDS + seconds))
    # Validate the complete exact set before issuing any STOP.
    while IFS=$'\t' read -r id name volume; do
        [ -n "$id" ] || continue
        [ "$id" != "${WARM_ID:-}" ] && [ "$id" != "${SHARED_WARM_ID:-}" ] \
            && [ "$volume" != "${WARM_VOLUME_ID:-}" ] && [ "$volume" != "${SHARED_WARM_VOLUME_ID:-}" ] || return 1
        budget="$(fleet_native_stop_call_budget "$deadline")" || return 1
        details="$(registry_machine_details "$id" "$budget")" || return 1
        read -r state seen_name _ <<< "$details"
        budget="$(fleet_native_stop_call_budget "$deadline")" || return 1
        mounted="$(machine_volume_id "$id" "$budget")" || return 1
        [ "$seen_name" = "$name" ] && [ "$mounted" = "$volume" ] || return 1
        case "$state" in started|stopping|stopped) ;; *) return 1 ;; esac
        ids+=("$id"); names+=("$name"); volumes+=("$volume"); states+=("$state")
    done < <(printf '%s\n' "$plan" | tail -n +2)
    for id in "${!ids[@]}"; do
        if [ "${states[$id]}" = started ]; then
            # An ACK is only a request result. Verification below owns success.
            fleet_native_stop_send "${ids[$id]}" "$deadline" || true
        fi
    done
    while :; do
        pending=0
        for id in "${!ids[@]}"; do
            budget="$(fleet_native_stop_call_budget "$deadline")" || return 1
            details="$(registry_machine_details "${ids[$id]}" "$budget")" || return 1
            read -r state seen_name _ <<< "$details"
            budget="$(fleet_native_stop_call_budget "$deadline")" || return 1
            mounted="$(machine_volume_id "${ids[$id]}" "$budget")" || return 1
            [ "$seen_name" = "${names[$id]}" ] && [ "$mounted" = "${volumes[$id]}" ] || return 1
            case "$state" in stopped) ;; started|stopping) pending=1 ;; *) return 1 ;; esac
        done
        [ "$pending" = 1 ] || return 0
        [ "$SECONDS" -lt "$deadline" ] || return 1
        sleep 1
    done
}

verify_worker_qualification() {  # <out>; existing canonical capture and return only
    python3 - "${CLOUDBENCH_SCRIPT_SNAPSHOT:-$ROOT_DIR/scripts}/cloudbench-worker-reuse.py" \
        "$1" "$FLEET_OWNER_TOKEN" "$POOL_CLAIMS_DIR" <<'PYVERIFY'
import json,runpy,sys
from pathlib import Path
h=runpy.run_path(sys.argv[1]);out=Path(sys.argv[2]);owner=sys.argv[3];claims=Path(sys.argv[4]);qualified=[]
for path in sorted((out/'worker-borrowed').glob('*.released.json')):
    returned=json.loads(h['read'](path));mid=returned['machine_id']
    assignment=json.loads(h['read'](out/'worker-borrowed'/(mid+'.json')))
    assert returned==json.loads(h['read'](out/'worker-borrowed'/(mid+'.returned.json')))
    assert assignment['fleet_owner_token']==returned['fleet_owner_token']==owner
    assert assignment['machine_id']==mid and assignment['claim_sha256']==returned['claim_sha256']
    assert assignment['primary_machine_id']==returned['primary_machine_id'] and assignment['run_token']==returned['run_token']
    assert returned['state']=='stopped' and returned['volume_retained'] is True
    assert not (claims/mid).exists() and not (claims/mid).is_symlink()
    capture=out/'worker-runtime-evidence'/mid/'capture/manifest.json'
    assert capture.is_file() and not capture.is_symlink()
    assert json.loads(h['read'](capture))['terminal']['worker_started'] is True
    assert h['read'](out/('worker-'+mid+'.qualification-ready')).decode().strip()==mid+'|'+assignment['run_token']+'|'+assignment['primary_machine_id']
    assert h['validate_capture'](out,mid,assignment['primary_machine_id'],assignment['run_token'])==returned['evidence_sha256']
    qualified.append(mid)
assert qualified, 'no runtime-verified released worker'
print(json.dumps({'schema':'cloudbench-worker-qualification-v1','worker_ids':qualified,'floor':2,'original_campaign_credit':0}))
PYVERIFY
}

cleanup() {
    local result_ec=$? ec teardown_failed="${LOCAL_PROCESS_TEARDOWN_FAILED:-0}" publication_failed=0
    local id i out claim_path st presence machines round stop_pid pool_volume_id guest_shutdown_failed=0
    local claim_digest machine_reap_status record runtime_evidence_failed=0 billing_owned_joins=1
    [ "${LOCAL_PROCESS_TEARDOWN_FAILED:-0}" = 0 ] || billing_owned_joins=0
    local -a claimed_pool_ids pending_pool_ids next_pending_pool_ids stop_pids
    ec="$result_ec"
    export -n machines 2>/dev/null || true
    claimed_pool_ids=()
    pending_pool_ids=()
    next_pending_pool_ids=()
    stop_pids=()
    # The poller and terminal can deliver TERM to the same process group. Do not
    # let a second signal interrupt teardown after the EXIT trap has begun.
    trap - EXIT
    trap '' HUP INT TERM
    release_cleanup_disk_reserve || { ec=1; teardown_failed=1; }
    # Both auxiliary loops sleep in child processes. Killing only their Bash
    # roots reparents the current sleep into the detached controller group, so
    # the wrapper can publish status while that owned group is still live.
    # Capture each complete tree before TERM and reap the waitable roots before
    # provider cleanup or the detached status rendezvous can complete.
    local snapshot_teardown_pid="${SNAPSHOT_LOOP_PID:-}"
    [ "${INVENTORY_PUBLISHER_BORROWED:-0}" != 1 ] || snapshot_teardown_pid=""
    # These loops die from the same process-group signal as this controller;
    # cloudbench_terminate_tree_and_wait treats a root the kernel no longer has
    # as terminal even when Bash still lists it as Running.
    if ! cloudbench_terminate_tree_and_wait "${CLOUDBENCH_CHILD_TERM_SECONDS:-30}" \
        "${UNIFIED_AGG_PID:-}" "$snapshot_teardown_pid"; then
        echo "❌ an owned aggregator/snapshot process survived local teardown" >&2
        billing_owned_joins=0
        ec=1
        teardown_failed=1
    fi
    UNIFIED_AGG_PID=""
    SNAPSHOT_LOOP_PID=""
    if [ "${INVENTORY_PUBLISHER_BORROWED:-0}" != 1 ]; then
        [ -n "${INVENTORY_WAIT_FIFO:-}" ] && rm -f "$INVENTORY_WAIT_FIFO" 2>/dev/null || true
    fi
    # Do NOT kill the central hub (UNIFIED_DASH_PID): it is THE one persistent
    # dashboard — shared across every run, carrying the user's open tab, resolving
    # "open agent" from local run data long after teardown. The next fleet run
    # REUSES it (never rebinds/kills it), so exactly one hub ever runs.
    if ! cloudbench_confirm_guest_shutdowns --native-stop-undelivered; then
        guest_shutdown_failed=1
    elif ! fleet_registry_confirm_guest_teardown; then
        echo "❌ could not persist confirmed guest-cleanup ownership transition" >&2
        guest_shutdown_failed=1
    fi
    if [ "$guest_shutdown_failed" = "1" ]; then
        # Disposable retirement must never destroy a guest whose delivered
        # stop is still draining browser/session cleanup and evidence sealing.
        if [ "${FLEET_GUEST_DRAIN_UNACKNOWLEDGED:-0}" = 1 ]; then
            echo "❌ a delivered guest is still draining; retaining its exact owner, Machine, volume and evidence instead of disposable retirement" >&2
            KEEP_CLONES=1
        else
            fleet_current_disposable_registry "$FLEET_REGISTRY_DIR" || KEEP_CLONES=1
        fi
        ec=1
        teardown_failed=1
        if ! fleet_registry_retain_unconfirmed_guest; then
            echo "❌ could not persist fail-closed guest-cleanup ownership policy" >&2
        fi
        if [ -s "$CLAIMED_POOL_FILE" ]; then
            while read -r id; do
                [ -n "$id" ] || continue
                claim_path="$POOL_CLAIMS_DIR/$id"
                if ! pool_claim_mark_cleanup_unconfirmed "$claim_path"; then
                    echo "❌ could not quarantine exact pool claim $id; linked fleet sentinel remains authoritative" >&2
                fi
            done < "$CLAIMED_POOL_FILE"
        fi
    fi
    if ! cloudbench_terminate_tree_and_wait "${CLOUDBENCH_CHILD_TERM_SECONDS:-30}" \
        "${AUTOSCALER_PIDS[@]:-}"; then
        echo "❌ an owned autoscaler process survived local teardown" >&2
        billing_owned_joins=0
        ec=1
        teardown_failed=1
    fi
    if ! cloudbench_terminate_tree_and_wait "${CLOUDBENCH_CHILD_TERM_SECONDS:-30}" \
        "${PROVISION_PIDS[@]:-}"; then
        echo "❌ an owned provisioner process survived local teardown" >&2
        billing_owned_joins=0
        ec=1
        teardown_failed=1
    fi
    if ! cloudbench_terminate_tree_and_wait "${CLOUDBENCH_CHILD_TERM_SECONDS:-30}" \
        "${CHILD_PIDS[@]:-}"; then
        echo "❌ an owned collector/native retirement tree survived local teardown" >&2
        billing_owned_joins=0
        KEEP_CLONES=1
        ec=1
        teardown_failed=1
    elif [ "${FLEET_NATIVE_REAP_ENABLED:-0}" = 1 ]; then
        # Every early native owner is joined before the remaining exact records
        # enter the same bounded mechanism. Every permit must also return;
        # cancellation that lost a permit retains exact ownership fail-closed.
        fleet_native_reap_close && fleet_native_reap_open \
            || { KEEP_CLONES=1; ec=1; teardown_failed=1; billing_owned_joins=0; }
    fi
    # Guest ACK and copied runtime evidence are independent receipts. Keep the
    # durable evidence latch through every crash window until all primary and
    # historical worker captures are verified, including workers scaled down
    # before the benchmark finished.
    if ! cloudbench_collect_remaining_runtime_evidence; then
        if fleet_current_disposable_registry "$FLEET_REGISTRY_DIR" && [ "${KEEP_CLONES:-0}" != 1 ]; then
            echo "❌ runtime evidence is incomplete; failed result retained while disposable resources are retired" >&2
        else
            echo "❌ runtime evidence is incomplete; retaining original fleet volumes" >&2
        fi
        runtime_evidence_failed=1
        fleet_current_disposable_registry "$FLEET_REGISTRY_DIR" || KEEP_CLONES=1
        ec=1
        teardown_failed=1
    fi
    if fleet_current_disposable_registry "$FLEET_REGISTRY_DIR"; then
        fleet_record_disposable_cleanup_state "$guest_shutdown_failed" "$runtime_evidence_failed" || { ec=1; teardown_failed=1; }
    fi
    # Finish all data-plane reads first. Evidence retention does not authorize
    # provider release; this separate helper may only stop verified idle owned
    # Machines and retains every latch, audit, claim, file and volume.
    if ! archived_reuse_retire_all; then ec=1; teardown_failed=1; fi
    fleet_billing_stop_retained_idle "$billing_owned_joins"
    # SIGKILL cannot run an autoscaler's EXIT trap. Release any remaining
    # complete lease records owned by this exact controller/run under the same
    # allocator lock before the snapshotted helper is removed.
    python3 "$AUTOSCALER_PORT_LEASE_HELPER" release-prefix \
        --root "${AUTOSCALER_PORT_LEASE_ROOT:-${TMPDIR:-/tmp}/rose-cloudbench-autoscaler-port-leases}" \
        --owner-pid "$$" --token "$RUN_ID-" 2>/dev/null || true
    record_tainted_claimed_pool_machines
    # Return only machines this fleet actually claimed. The pool ledger can be
    # shared by sibling workspaces, so stopping every listed ID would interrupt
    # their active runs. Stop this run's machines concurrently: serial stop +
    # per-machine inventory polling added N teardown latency after an otherwise
    # perfectly parallel batch. Keep every global lease until a shared inventory
    # read proves its machine stopped (or absent).
    if { [ "$guest_shutdown_failed" = "1" ] || [ "$billing_owned_joins" != "1" ]; } \
        && [ -s "$CLAIMED_POOL_FILE" ]; then
        echo "⚠️  retaining claimed pool machines and ownership claims: guest cleanup or owned process joins are unconfirmed" >&2
    elif [ -s "$CLAIMED_POOL_FILE" ]; then
        while read -r id; do
            [ -n "$id" ] || continue
            claim_path="$POOL_CLAIMS_DIR/$id"
            if ! pool_claim_owned_by_current "$claim_path"; then
                echo "❌ claimed pool machine $id lost exact ownership; retaining it untouched" >&2
                ec=1
                teardown_failed=1
                continue
            fi
            if [ "$runtime_evidence_failed" = "0" ] \
                && grep -Fxq "$id" "$TAINTED_POOL_FILE" 2>/dev/null; then
                echo "☣️  destroying quarantined pool machine $id instead of returning it"
                claim_path="$POOL_CLAIMS_DIR/$id"
                claim_digest="$(cloudbench_env_sha256 "$claim_path")" || {
                    echo "❌ quarantined pool claim $id is unreadable; retaining ownership claim" >&2
                    ec=1
                    teardown_failed=1
                    continue
                }
                pool_volume_id="$(registry_meta_value \
                    "$FLEET_TEARDOWN_OWNERSHIP_DIR/pool/$id" volume_id)"
                machine_reap_status=1
                if [ -n "$pool_volume_id" ]; then
                    if reap_machine "$id" "" "$pool_volume_id"; then
                        machine_reap_status=0
                    else
                        machine_reap_status=$?
                    fi
                fi
                if [ "$machine_reap_status" -eq 0 ] \
                    || [ "$machine_reap_status" -eq 74 ]; then
                    if pool_ledger_remove_id "$id" \
                        && fleet_audit_record_pool_machine "$id" "$pool_volume_id" \
                            destroyed-removed-from-pool \
                        && pool_claim_release_exact "$claim_path" "$claim_digest" \
                            "$FLEET_OWNER_TOKEN" "$FLEET_OWNER_HOST" "$$" \
                            "$FLEET_OWNER_PID_START"; then
                        :
                    else
                        ec=1
                        teardown_failed=1
                    fi
                else
                    echo "❌ quarantined pool machine $id survived destroy; retaining ownership claim" >&2
                    ec=1
                    teardown_failed=1
                fi
                continue
            fi
            echo "↩️  returning claimed pool machine $id (stop)"
            claimed_pool_ids+=("$id")
        done < "$CLAIMED_POOL_FILE"

        pending_pool_ids=("${claimed_pool_ids[@]}")
        # A bounded retry handles an instantaneous control-plane throttle while
        # preserving parallel teardown. Each round uses one shared inventory
        # read, never one Machines-API list call per box.
        for round in $(seq 1 "${CLOUDBENCH_POOL_STOP_REQUEST_ATTEMPTS:-3}"); do
            stop_pids=()
            for id in "${pending_pool_ids[@]}"; do
                fly_with_timeout "${CLOUDBENCH_POOL_STOP_REQUEST_TIMEOUT:-20}" \
                    machine stop "$id" -a "$APP" >/dev/null 2>&1 &
                stop_pids+=("$!")
            done
            for stop_pid in "${stop_pids[@]}"; do
                wait "$stop_pid" 2>/dev/null || true
            done
            machines="$(FLY machines list -a "$APP" --json 2>/dev/null || true)"
            next_pending_pool_ids=()
            for id in "${pending_pool_ids[@]}"; do
                st="$(printf '%s' "$machines" | pool_machine_state_from_json "$id" 2>/dev/null)"
                presence=$?
                if [ "$presence" -ne 0 ] || [ "$st" != "stopped" ]; then
                    next_pending_pool_ids+=("$id")
                fi
            done
            if [ "${next_pending_pool_ids[0]+set}" = "set" ]; then
                pending_pool_ids=("${next_pending_pool_ids[@]}")
            else
                pending_pool_ids=()
                break
            fi
            sleep "$round"
        done

        # Stop commands normally wait for the transition. Retain a bounded
        # shared-inventory poll for Fly transitions that outlive the request.
        for _ in $(seq 1 "${CLOUDBENCH_POOL_STOP_ATTEMPTS:-30}"); do
            [ "${pending_pool_ids[0]+set}" = "set" ] || break
            machines="$(FLY machines list -a "$APP" --json 2>/dev/null || true)"
            next_pending_pool_ids=()
            for id in "${pending_pool_ids[@]}"; do
                st="$(printf '%s' "$machines" | pool_machine_state_from_json "$id" 2>/dev/null)"
                presence=$?
                if [ "$presence" -ne 0 ] || [ "$st" != "stopped" ]; then
                    next_pending_pool_ids+=("$id")
                fi
            done
            if [ "${next_pending_pool_ids[0]+set}" = "set" ]; then
                pending_pool_ids=("${next_pending_pool_ids[@]}")
                sleep 2
            else
                pending_pool_ids=()
                break
            fi
        done

        machines="$(FLY machines list -a "$APP" --json 2>/dev/null || true)"
        for id in "${claimed_pool_ids[@]}"; do
            st="$(printf '%s' "$machines" | pool_machine_state_from_json "$id" 2>/dev/null)"
            presence=$?
            claim_path="$POOL_CLAIMS_DIR/$id"
            claim_digest="$(cloudbench_env_sha256 "$claim_path" 2>/dev/null)" \
                || claim_digest=""
            pool_volume_id="$(registry_meta_value \
                "$FLEET_TEARDOWN_OWNERSHIP_DIR/pool/$id" volume_id)"
            if [ "$presence" -eq 0 ] && [ "$st" = "stopped" ] \
                && [ -n "$pool_volume_id" ] \
                && [ "$(printf '%s' "$machines" \
                    | machine_volume_id_from_json "$id" 2>/dev/null)" = "$pool_volume_id" ] \
                && [ -n "$claim_digest" ] \
                && pool_claim_owned_by_current "$claim_path"; then
                if [ "$runtime_evidence_failed" = "1" ]; then
                    # Guest shutdown and producer joins were positively confirmed.
                    # Preserve the evidence latch, claim and data while ending compute.
                    echo "↩️  claimed pool machine $id verified stopped; retaining claim for missing runtime evidence" >&2
                    continue
                fi
                if fleet_verify_staged_primary_return "$id" "$pool_volume_id" \
                    && fleet_audit_record_pool_machine "$id" "$pool_volume_id" \
                    returned-stopped-claim-released \
                    && pool_claim_release_exact "$claim_path" "$claim_digest" \
                        "$FLEET_OWNER_TOKEN" "$FLEET_OWNER_HOST" "$$" \
                        "$FLEET_OWNER_PID_START" \
                    && fleet_record_staged_primary_release "$id"; then
                    for i in "${!CHILD_MACHINE[@]}"; do
                        if [ "${CHILD_MACHINE[$i]}" = "$id" ]; then
                            date +%s > "${CHILD_OUT[$i]}/pool-primary.returned-epoch" \
                                || { ec=1; teardown_failed=1; }
                            break
                        fi
                    done
                else
                    ec=1
                    teardown_failed=1
                fi
            else
                echo "❌ claimed pool machine $id did not verify stopped; retaining ownership claim" >&2
                ec=1
                teardown_failed=1
            fi
        done
    fi
    # Claims are independent recovery roots that may still refer to a fresh
    # registry record. Reconcile them before reaping ordinary fresh clones;
    # the registry/meta remains published until every claim and the immutable
    # terminal audit have committed.
    if ! reconcile_current_pool_transfer_claims; then
        echo "❌ could not reconcile this controller's pending pool transfer claims" >&2
        ec=1
        teardown_failed=1
    fi
    if [ "$guest_shutdown_failed" = "0" ] && [ "$runtime_evidence_failed" = "0" ] \
        && ! reconcile_current_pool_claims; then
        echo "❌ could not reconcile this controller's exact pool claims" >&2
        ec=1
        teardown_failed=1
    fi
    if [ "$FLEET_REGISTRY_PUBLISHED" = "1" ] && [ "$KEEP_CLONES" != "1" ] && ! fleet_current_disposable_registry "$FLEET_REGISTRY_DIR"; then
        if ! stop_current_registry_primaries_for_pool "$billing_owned_joins" \
                "$guest_shutdown_failed" "$runtime_evidence_failed" \
            || ! return_current_registry_primaries_to_pool "$billing_owned_joins" \
                "$guest_shutdown_failed" "$runtime_evidence_failed"; then
            echo "❌ fresh primary STOP/pool return was not verified; retaining exact ownership and data" >&2
            KEEP_CLONES=1
            ec=1
            teardown_failed=1
        fi
    fi
    if [ "$FLEET_REGISTRY_PUBLISHED" = "1" ] && [ "$KEEP_CLONES" != "1" ]; then
        # The durable registry is authoritative for primaries AND autoscaler
        # workers. Local per-bench ledgers remain useful for live scaling, but a
        # failed reap stays recoverable even if this workspace is later deleted.
        if [ "${POOL_REUSE_ONLY:-0}" = 1 ]; then
            # Residual workers remain owned until a separate verified admission.
            # Never enter the native reaper, which also has direct deletion paths.
            for record in "$FLEET_REGISTRY_DIR"/clones/*; do
                if [ -e "$record" ] || [ -L "$record" ]; then
                    echo "⚠️  reuse-only retains residual ownership for stopped worker admission" >&2
                    KEEP_CLONES=1
                    ec=1
                    teardown_failed=1
                    break
                fi
            done
        elif ! FLEET_CLONE_PRODUCERS_JOINED="$billing_owned_joins" \
            reap_registry_clones "$FLEET_REGISTRY_DIR" current; then
            echo "⚠️  FAILED to destroy all fleet-owned machines; durable ownership remains at $FLEET_REGISTRY_DIR" >&2
            ec=1
            teardown_failed=1
        fi
    elif [ "$FLEET_REGISTRY_PUBLISHED" = "1" ]; then
        echo "⚠️  --keep-clones: retaining fleet ownership at $FLEET_REGISTRY_DIR"
    fi
    # Clone volume IDs are persisted in the same exact-owner record as machine
    # IDs and reaped by reap_registry_clones. Never sweep app-global unattached
    # volumes here: another worktree can be between fork and machine attachment.
    # NOTE: do NOT pkill viewers by "$FLEET_DIR" — the batch resolver (and the
    # archive Vites it spawns for durable /open-agent) carry $FLEET_DIR in their
    # argv too, so that sweep KILLED the very resolver we persist (→ dead link
    # post-run). Per-bench viewers are reaped by their own run-bench-cloud child's
    # exit trap when we SIGTERM CHILD_PIDS above; the batch resolver lives on.
    if [ "${QUALIFY_WORKER:-0}" = 1 ] && [ "$ec" = 0 ]; then
        for out in "${CHILD_OUT[@]}"; do
            if ! verify_worker_qualification "$out"; then
                echo "❌ worker qualification lacks verified runtime and stopped/released worker" >&2
                ec=1
            fi
        done
    fi
    fleet_native_reap_close || { ec=1; teardown_failed=1; }
    [ -n "${FLEET_PATCH_FILE:-}" ] && rm -f "$FLEET_PATCH_FILE" 2>/dev/null || true
    if ! fleet_release_cleanup_capacity "$guest_shutdown_failed" "$runtime_evidence_failed"; then
        ec=1
        teardown_failed=1
    fi
    if ! finalize_terminal_projection "$ec"; then
        echo "❌ could not finalize Cloud Fleet run/report-card projection" >&2
        ec=1
        teardown_failed=1
    fi
    # A benchmark FAIL and a teardown FAIL are independent facts. Preserve the
    # workload exit code, but still publish verified teardown when every exact
    # resource reached its required terminal disposition.
    if [ "$teardown_failed" = "0" ] && [ "$KEEP_CLONES" != "1" ] \
        && ! fleet_audit_finalize_provider_teardown; then
        echo "❌ durable fleet teardown manifest is incomplete" >&2
        ec=1
        teardown_failed=1
    fi
    # The v2 registry/meta is the crash-recovery root for both its clone rows
    # and token-bound claims. Remove it only after the shared audit and its
    # immutable run-local terminal copy have committed successfully.
    if [ "$teardown_failed" = "0" ] && [ "$FLEET_REGISTRY_PUBLISHED" = "1" ] \
        && [ "$KEEP_CLONES" != "1" ]; then
        fleet_registry_remove_if_empty "$FLEET_REGISTRY_DIR" \
            || { ec=1; teardown_failed=1; }
    fi
    cloudbench_controller_lock_release "$LOCK_DIR"
    # Report each bench's end-to-end duration only after the complete primary,
    # worker and exact-claim audit. An early pool return has a separate marker.
    # Legacy clockless audits retain a truthful post-verification fallback.
    if [ "$teardown_failed" = "0" ] && [ "$KEEP_CLONES" != "1" ]; then
        fleet_finalize_released_projection 1 || { ec=1; teardown_failed=1; }
    fi
    # Keep the parent live while releasing resources. Only this post-release
    # projection closes dashboard polling and publishes the final transcripts.
    local registry_release_verified=0
    if [ "$teardown_failed" = "0" ] && [ "$KEEP_CLONES" != "1" ] \
        && fleet_registry_release_verified; then registry_release_verified=1; fi
    if ! finalize_terminal_projection "$ec"; then
        ec=1
    elif [ "${SELF_MANAGED_HUB_RUN:-0}" = "1" ]; then
        local hub_final_action=--upload-live
        if [ "$teardown_failed" = "0" ] && [ "$KEEP_CLONES" != "1" ] \
            && [ "$registry_release_verified" = "1" ]; then
            hub_final_action=--upload-final
        fi
        if ! python3 "$HUB_UPLOAD_HELPER" "$hub_final_action" "$FLEET_DIR/_batch/run.json" \
            --run-id "$BENCHMARK_HUB_PARENT_RUN_ID" --source direct-cloud-fleet; then
            if [ "$hub_final_action" = --upload-final ]; then
                echo "❌ terminal Hub publication failed after resource release" >&2
                publication_failed=1
                ec=1
            else
                echo "⚠️ final live Hub update failed; canonical outcome and cleanup status are preserved" >&2
            fi
        fi
    fi
    # Seal the lifecycle after provider audit, exact registry retirement and
    # required terminal publication. A publication failure does not change the
    # recorded physical resource disposition or the benchmark verdict.
    if [ -d "$FLEET_DIR/_batch" ]; then
        if ! CLOUDBENCH_AUTOSCALER_FAILED_BENCHES="${AUTOSCALER_FAILED_BENCHES[*]:-}" \
            python3 - "$FLEET_DIR" "$FLEET_OWNER_TOKEN" "$RUN_ID" "$ROOT_DIR" \
            "$ec" "$teardown_failed" "$KEEP_CLONES" \
            "$FLEET_EXECUTION_COMPLETED" "${AUTOSCALER_FAILURE:-1}" \
            "$FLEET_REGISTRY_DIR" "$publication_failed" "$registry_release_verified" <<'PY'
import json
import os
import sys
from pathlib import Path

directory, owner, run_id, workspace, exit_code, teardown, retained, completed, autoscaler, registry, publication_failed, registry_release_verified = sys.argv[1:]
root = Path(directory)
audit_digest = ""
try:
    binding = dict(line.split("=", 1) for line in (root / "teardown-ownership/source-audit").read_text().splitlines())
    audit_digest = binding["sha256"]
except (OSError, ValueError, KeyError):
    pass
# Execution completed and every owned resource was released and audited. A
# mandatory-autoscaler failure is a run verdict, not a cleanup verdict: record
# it by bench beside this so consumers can keep verified cleanup separate.
cleanup_verified = (
    teardown == "0" and retained != "1" and completed == "1"
    and len(audit_digest) == 64
    and publication_failed == "0" and exit_code in ("0", "1")
    and bool(registry) and registry_release_verified == "1"
)
autoscaler_failed_benches = sorted(set(os.environ.get("CLOUDBENCH_AUTOSCALER_FAILED_BENCHES", "").split()))
verified = cleanup_verified and autoscaler == "0"
target = root / "_batch/lifecycle.json"
temporary = target.with_name(f".lifecycle.{os.getpid()}.tmp")
payload = {
    "version": 1, "fleet_owner_token": owner, "run_id": run_id,
    "workspace_root": workspace, "status": "verified" if verified else "failed",
    "controller_exit_code": int(exit_code), "audit_sha256": audit_digest,
    "hub_publication_failed": publication_failed != "0",
    "cleanup_verified": cleanup_verified,
    "autoscaler_failed_benches": autoscaler_failed_benches,
}
try:
    with temporary.open("x") as handle:
        json.dump(payload, handle, sort_keys=True)
        handle.write("\n")
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temporary, target)
    descriptor = os.open(target.parent, os.O_RDONLY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
finally:
    temporary.unlink(missing_ok=True)
PY
        then
            echo "❌ could not seal final fleet lifecycle verdict" >&2
            ec=1
        fi
    fi
    if declare -F fleet_scorecard_report >/dev/null; then
        if [ "$ec" = 0 ] || [ "$ec" = 1 ]; then fleet_scorecard_report end ENDED; else fleet_scorecard_report end FAILED; fi
    fi
    if [ "$publication_failed" = "1" ]; then
        finalize_terminal_projection "$ec" || ec=1
    fi
    # Teardown and final publication both need the snapshotted helpers.
    cleanup_owned_script_snapshot || ec=1
    exit "$ec"
}
trap cleanup EXIT
# Name the killer: silent teardowns (no ❌, no barrier release) have repeatedly
# looked like infra failures when the controller was actually signalled from
# outside (session kill, stray pkill). Record which signal fired before exiting.
trap 'echo "⚰️  controller received HUP ($(date -u +%H:%M:%S))"; exit 129' HUP
trap 'echo "⚰️  controller received INT ($(date -u +%H:%M:%S))"; exit 130' INT
if [ "${CLOUDBENCH_TEST_IGNORE_CONTROLLER_TERM:-0}" = "1" ]; then
    # Permanent fake-provider coverage uses this hook only after crossing a
    # real allocation boundary, proving the detached supervisor's KILL +
    # out-of-process durable reconciliation path.
    trap '' TERM
else
    trap 'echo "⚰️  controller received TERM ($(date -u +%H:%M:%S))"; exit 143' TERM
fi
# Every startup exit below runs the armed finalizer. Start each requested
# bench's conservative E2E clock now, so its verified release projection also
# closes a row whose INFRA exit preceded provisioning.
if [ -z "$PROVISION_POOL" ]; then
    for bench in "${BENCHES[@]}"; do
        fleet_mark_bench_e2e_started "$bench" || {
            echo "❌ could not record the E2E start clock for $bench" >&2
            exit 1
        }
    done
fi

mkdir -p "$(dirname "$POOL_IDS_FILE")" "$POOL_CLAIMS_DIR" || {
    echo "❌ could not initialize durable cloudbench ownership directories under $GIT_COMMON_DIR" >&2
    exit 1
}
if [ ! -f "$POOL_IDS_FILE" ] && [ -f "$LEGACY_POOL_IDS_FILE" ]; then
    cp "$LEGACY_POOL_IDS_FILE" "$POOL_IDS_FILE" || {
        echo "❌ could not migrate legacy pool ownership into $POOL_IDS_FILE" >&2
        exit 1
    }
fi
fleet_registry_init || {
    echo "❌ could not atomically publish durable fleet ownership under $FLEET_OWNERSHIP_ROOT; refusing provider mutation" >&2
    exit 1
}
echo "📡 Monitor this exact fleet every 30s, through terminal status AND resource release:"
printf '    %q monitor %q' "$ROOT_DIR/scripts/run-bench" "$FLEET_DIR"
if [ -n "${CLOUDBENCH_DETACHED_STATUS_FILE:-}" ]; then
    printf ' --controller-status %q' "$CLOUDBENCH_DETACHED_STATUS_FILE"
fi
printf '\n'
printf '    owner: %s; private controller diagnostics stay in this run directory.\n' "$FLEET_OWNER_TOKEN"
echo "    PASS/FAIL is the evaluated task result; lifecycle.json records final cleanup."
echo "    On stale/missing observations, inspect exact owner liveness and private logs; do not restart."
# Reporting aids only: the mandatory CLI scorecard command and one ledger line per
# standalone launch (campaign children belong to their campaign). Never blocks.
fleet_scorecard_report() {
    [ -f "$ROOT_DIR/scripts/cloudbench-scorecard.py" ] || return 0
    python3 "$ROOT_DIR/scripts/cloudbench-scorecard.py" --instruction "$FLEET_DIR" 2>/dev/null || true
    [ -z "${RUN_BENCH_CAMPAIGN_CHILD:-}" ] && [ -z "${CLOUDBENCH_FAKE_DIR:-}" ] && [ -z "$PROVISION_POOL" ] || return 0
    local goal="${RUN_BENCH_GOAL:-fleet:$(printf '%s\n' "${BENCHES[@]}" | sort -u | paste -sd, - | cut -c1-120)}"
    local fields=(--field "kind=fleet" --field "run_dir=$FLEET_DIR")
    if [ "$1" = launch ]; then
        fields+=(--field "triggered_at=$(date +%s)" --field "scheduled_total=${#BENCHES[@]}" --field "tasks=${#BENCHES[@]}" --field "runs=1")
        fields+=(--field "slice=${RUN_BENCH_EXPERIMENT_LABEL:-$(printf '%s' "${BENCHES[0]:-fleet}")$([ "${#BENCHES[@]}" -gt 1 ] && printf ' +%s' "$(( ${#BENCHES[@]} - 1 ))")}")
    else
        fields+=(--field "ended_at=$(date +%s)" --field "state=$2")
    fi
    CLOUDBENCH_EXPERIMENTS_LEDGER="${CLOUDBENCH_EXPERIMENTS_LEDGER:-$GIT_COMMON_DIR/cloudbench-experiments.jsonl}" \
        python3 "$ROOT_DIR/scripts/cloudbench_experiments.py" record --event "$1" --id "$RUN_ID" \
        --goal "$goal" "${fields[@]}" >/dev/null 2>&1 || true
}
fleet_scorecard_report launch
reserve_cleanup_disk_space || {
    echo "❌ could not allocate the emergency fleet teardown disk reserve; refusing provider mutation" >&2
    exit 1
}
# Visibility can fail on imports, credentials, or HTTP. Publish controller
# authority and arm its finalizer before those calls so startup failures get
# the same durable teardown as failures after allocation.
if [ -z "$PROVISION_POOL" ]; then
    require_central_hub_visibility || exit 1
    require_in_app_hub_visibility || exit 1
fi
reconcile_pool || exit 1   # stop + verify this workspace's pool before machine start
