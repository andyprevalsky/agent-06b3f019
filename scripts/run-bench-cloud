#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# run-bench-cloud — CLOUD-EXCLUSIVE benchmark runner.
#
# Provisions a one-shot Fly.io machine (app: navi-whisper-lux-bench) that runs
# the ENTIRE isolated Rose stack — backend + agents worker + World Model Harness
# + system Postgres — plus a single benchmark task in --simulate, ENTIRELY on the
# box. Retrieves the report card from the machine logs, then ALWAYS destroys the
# machine (mandatory: no leaked billed resources).
#
# Usage:
#   bash scripts/run-bench-cloud <task> [--simulate] [--no-simulate]
#                                [--flags "<extra run_benchmark flags>"]
#                                [--model <wmh-model-name>]
#                                [--vm-size <size>] [--vm-memory <mb>]
#                                [--timeout <seconds>] [--keep] [--reuse-image]
#
#   bash scripts/run-bench-cloud spawn-sub-agents --simulate
#   bash scripts/run-bench-cloud chat-mode --simulate
#
# Teardown is NON-NEGOTIABLE: every exit path (success, failure, error, timeout,
# Ctrl-C) destroys the machine via a bash trap. After a run,
# `flyctl machines list -a navi-whisper-lux-bench` shows 0 machines.
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

APP="navi-whisper-lux-bench"
PROD_APP="navi-whisper-lux"   # NEVER touch this.
REGION="iad"
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR" || exit 1

# ── Defaults ───────────────────────────────────────────────────────────────
BENCH_TASK=""
BENCH_SIMULATE="1"
BENCH_FLAGS=""
WMH_MODEL_NAME="rose-archive"
VM_SIZE="shared-cpu-4x"
VM_MEMORY="8192"
RUN_TIMEOUT="3600"      # 60 min hard ceiling: cold WMH build (~15-25 min) + stack + benchmark.
KEEP_MACHINE="0"        # debug-only; still warns loudly.
REUSE_IMAGE=""          # skip build, run this pre-built image ref.

# ── Arg parsing ──────────────────────────────────────────────────────────────
while [ $# -gt 0 ]; do
    case "$1" in
        --simulate)     BENCH_SIMULATE="1"; shift ;;
        --no-simulate)  BENCH_SIMULATE="0"; shift ;;
        --flags)        BENCH_FLAGS="${2:-}"; shift 2 ;;
        --model)        WMH_MODEL_NAME="${2:-}"; shift 2 ;;
        --vm-size)      VM_SIZE="${2:-}"; shift 2 ;;
        --vm-memory)    VM_MEMORY="${2:-}"; shift 2 ;;
        --timeout)      RUN_TIMEOUT="${2:-}"; shift 2 ;;
        --keep)         KEEP_MACHINE="1"; shift ;;
        --reuse-image)  REUSE_IMAGE="${2:-}"; shift 2 ;;
        -h|--help)
            sed -n '2,32p' "$0"; exit 0 ;;
        --*)            echo "❌ Unknown flag: $1" >&2; exit 2 ;;
        *)
            if [ -z "$BENCH_TASK" ]; then BENCH_TASK="$1"; else
                echo "❌ Unexpected extra argument: $1" >&2; exit 2
            fi
            shift ;;
    esac
done

if [ -z "$BENCH_TASK" ]; then
    echo "❌ A benchmark task name is required. e.g. bash scripts/run-bench-cloud spawn-sub-agents --simulate" >&2
    exit 2
fi

# ── Fly auth token ───────────────────────────────────────────────────────────
# App creation + operating a NEW app requires a USER/org-scoped token. The
# FLY_API_TOKEN in agents/.env is deploy-scoped to the PROD app (navi-whisper-lux)
# only and cannot create or operate the bench app. So prefer, in order:
#   1) FLY_BENCH_API_TOKEN (explicit override, if the caller provides an org token)
#   2) the user login token in ~/.fly/config.yml (`flyctl auth login`) — org-wide
#   3) FLY_API_TOKEN env / agents/.env (last resort; may be app-scoped to prod)
resolve_fly_token() {
    if [ -n "${FLY_BENCH_API_TOKEN:-}" ]; then
        echo "$FLY_BENCH_API_TOKEN"; return
    fi
    local cfg="$HOME/.fly/config.yml"
    if [ -f "$cfg" ]; then
        local tok
        tok="$(grep -E '^access_token:' "$cfg" 2>/dev/null | head -1 | sed 's/^access_token: *//; s/^["'\'']//; s/["'\'']$//')"
        if [ -n "$tok" ]; then echo "$tok"; return; fi
    fi
    if [ -n "${FLY_API_TOKEN:-}" ]; then echo "$FLY_API_TOKEN"; return; fi
    grep -E '^FLY_API_TOKEN=' agents/.env 2>/dev/null | head -1 | cut -d= -f2- | sed 's/^["'\'']//; s/["'\'']$//'
}

FLY_API_TOKEN="$(resolve_fly_token)"
if [ -z "${FLY_API_TOKEN:-}" ]; then
    echo "❌ No Fly auth token found (FLY_BENCH_API_TOKEN, ~/.fly/config.yml, or FLY_API_TOKEN)." >&2
    echo "   Run 'flyctl auth login' or set FLY_BENCH_API_TOKEN to an org-scoped token." >&2
    exit 1
fi
export FLY_API_TOKEN

FLY() { flyctl "$@"; }

# ── Locate flyctl ────────────────────────────────────────────────────────────
if ! command -v flyctl >/dev/null 2>&1; then
    if [ -x "$HOME/.fly/bin/flyctl" ]; then
        export PATH="$HOME/.fly/bin:$PATH"
    else
        echo "❌ flyctl not found on PATH." >&2
        exit 1
    fi
fi

# ─────────────────────────────────────────────────────────────────────────────
# MANDATORY TEARDOWN TRAP — destroys every machine in the bench app on ANY exit.
# ─────────────────────────────────────────────────────────────────────────────
MACHINE_ID=""
TEARDOWN_DONE="0"

teardown() {
    local exit_code=$?
    [ "$TEARDOWN_DONE" = "1" ] && return
    TEARDOWN_DONE="1"

    if [ "$KEEP_MACHINE" = "1" ]; then
        echo ""
        echo "⚠️  --keep set: NOT destroying machine ${MACHINE_ID:-<none>}. THIS LEAKS BILLING."
        echo "   Destroy manually: flyctl machine destroy --force ${MACHINE_ID:-<id>} -a $APP"
        return
    fi

    echo ""
    echo "🧹 Teardown: destroying all machines in $APP ..."

    # Destroy the specific machine we started first (fast path).
    if [ -n "$MACHINE_ID" ]; then
        FLY machine destroy --force "$MACHINE_ID" -a "$APP" 2>&1 | sed 's/^/   /' || true
    fi

    # Belt-and-suspenders: destroy ANY machine still present in the app, so a
    # partial failure (e.g. machine created but id capture failed) can't leak.
    local ids
    ids="$(FLY machines list -a "$APP" --json 2>/dev/null \
        | python3 -c 'import json,sys
try:
    data=json.load(sys.stdin)
except Exception:
    data=[]
for m in (data or []):
    mid=m.get("id")
    if mid: print(mid)' 2>/dev/null || true)"
    for id in $ids; do
        echo "   destroying leftover machine $id"
        FLY machine destroy --force "$id" -a "$APP" 2>&1 | sed 's/^/   /' || true
    done

    # Proof of teardown: list must show 0 machines.
    echo ""
    echo "🔎 Proof of teardown — flyctl machines list -a $APP:"
    FLY machines list -a "$APP" 2>&1 | sed 's/^/   /' || true
    local remaining
    remaining="$(FLY machines list -a "$APP" --json 2>/dev/null \
        | python3 -c 'import json,sys
try: print(len(json.load(sys.stdin) or []))
except Exception: print("?")' 2>/dev/null || echo '?')"
    echo "   machines remaining: $remaining"
    if [ "$remaining" != "0" ]; then
        echo "   ❌ WARNING: machines still present — retrying destroy once more..."
        for id in $(FLY machines list -a "$APP" --json 2>/dev/null | python3 -c 'import json,sys
try:
    for m in (json.load(sys.stdin) or []):
        if m.get("id"): print(m["id"])
except Exception: pass' 2>/dev/null); do
            FLY machine destroy --force "$id" -a "$APP" 2>&1 | sed 's/^/   /' || true
        done
        FLY machines list -a "$APP" 2>&1 | sed 's/^/   /' || true
    fi

    echo ""
    echo "Original exit code: $exit_code"
}
trap teardown EXIT INT TERM

# ── 1. Ensure the bench app exists (NEVER the prod app) ──────────────────────
if [ "$APP" = "$PROD_APP" ]; then
    echo "❌ Refusing to run: bench app equals prod app ($PROD_APP)." >&2
    exit 1
fi
echo "═══ run-bench-cloud ═══"
echo "task=$BENCH_TASK simulate=$BENCH_SIMULATE model=$WMH_MODEL_NAME vm=$VM_SIZE/${VM_MEMORY}MB app=$APP region=$REGION"
echo ""

if FLY apps list --json 2>/dev/null | python3 -c 'import json,sys
apps=json.load(sys.stdin)
names={a.get("Name") or a.get("name") for a in (apps or [])}
sys.exit(0 if "'"$APP"'" in names else 1)' 2>/dev/null; then
    echo "✅ App $APP already exists"
else
    echo "📦 Creating app $APP ..."
    FLY apps create "$APP" --org personal 2>&1 | sed 's/^/   /' || {
        # "already exists" races are fine.
        FLY apps list 2>/dev/null | grep -q "$APP" || { echo "❌ Failed to create app $APP"; exit 1; }
    }
fi

# ── 2. Inject secrets (only keys that are present) ───────────────────────────
# The stack reads agents/.env + back-end/.env directly, so the simplest correct
# transport is to base64 the entire files and let the entrypoint decode them —
# every key captured exactly, no per-key drift. We also set the R2 keys as plain
# secrets (redundant, but harmless) so any direct-env consumer sees them too.
echo ""
echo "🔐 Injecting secrets into $APP ..."

if [ ! -f agents/.env ] || [ ! -f back-end/.env ]; then
    echo "❌ agents/.env and back-end/.env are required to inject secrets." >&2
    exit 1
fi

AGENTS_ENV_B64="$(base64 < agents/.env | tr -d '\n')"
BACKEND_ENV_B64="$(base64 < back-end/.env | tr -d '\n')"

# Pull a few individual keys through as well (present-only) for visibility/logging.
get_env() {  # get_env FILE KEY
    grep -E "^$2=" "$1" 2>/dev/null | head -1 | cut -d= -f2- | sed 's/^["'\'']//; s/["'\'']$//'
}

declare -a SECRET_ARGS=()
SECRET_ARGS+=("AGENTS_ENV_B64=$AGENTS_ENV_B64")
SECRET_ARGS+=("BACKEND_ENV_B64=$BACKEND_ENV_B64")

# Log which high-value keys are present (do NOT print values).
echo "   secret files: AGENTS_ENV_B64 ($(wc -l < agents/.env | tr -d ' ') lines), BACKEND_ENV_B64 ($(wc -l < back-end/.env | tr -d ' ') lines)"
PRESENT_KEYS=()
for k in TEMPORAL_API_KEY TEMPORAL_ADDRESS TEMPORAL_NAMESPACE OPENROUTER_API_KEY ROSE_API_KEY \
         ANTHROPIC_API_KEY BACKEND_API_KEY SUPABASE_SERVICE_ROLE_KEY SUPABASE_ANON_KEY \
         R2_ACCOUNT_ID R2_ACCESS_KEY_ID R2_SECRET_ACCESS_KEY R2_BUCKET_TRACE_ARCHIVE \
         CLICKHOUSE_ENDPOINT FLY_API_TOKEN; do
    v="$(get_env agents/.env "$k")"
    [ -z "$v" ] && v="$(get_env back-end/.env "$k")"
    [ -n "$v" ] && PRESENT_KEYS+=("$k")
done
echo "   present high-value keys: ${PRESENT_KEYS[*]:-<none>}"

# Set as a batch. --stage stores them WITHOUT triggering a deploy; because a new
# `machine run` reads the app's current secrets at launch time, we then flush the
# staged secrets to "active" so the fresh machine actually receives them. With 0
# running machines, `secrets deploy` has nothing to restart — it just activates.
FLY secrets set --stage -a "$APP" "${SECRET_ARGS[@]}" 2>&1 | sed 's/^/   /' || {
    echo "❌ Failed to set secrets"; exit 1
}
FLY secrets deploy -a "$APP" 2>&1 | sed 's/^/   /' || true
echo "✅ Secrets set (active)"

# ── 3. Build + push the image with Fly's CLASSIC builder (plain manifest) ────
# Depot (the default builder) pushes an OCI image INDEX with provenance/
# attestation manifests. `flyctl machine run` then can't resolve that index tag
# by manifest → "MANIFEST_UNKNOWN [http 404]" — both in the standalone and the
# atomic (`machine run . --build-depot`) forms. The classic remote builder
# (`--depot=false`) pushes a single plain manifest that `machine run <tag>`
# resolves cleanly. The classic builder occasionally throws a transient
# "unable to upgrade to h2c, received 500" while its builder VM warms up, so we
# retry the build a few times.
IMAGE_REF="$REUSE_IMAGE"
if [ -z "$IMAGE_REF" ]; then
    echo ""
    echo "🏗️  Building + pushing image (Fly classic remote builder, plain manifest)..."
    IMAGE_LABEL="cloudbench-$(date +%Y%m%d-%H%M%S)"
    BUILD_OK=0
    for attempt in 1 2 3; do
        echo "   build attempt $attempt/3 (label $IMAGE_LABEL)"
        if FLY deploy \
            -c fly.cloudbench.toml \
            --dockerfile Dockerfile.cloudbench \
            --depot=false \
            --remote-only \
            --build-only \
            --push \
            --image-label "$IMAGE_LABEL" \
            -a "$APP" 2>&1; then
            BUILD_OK=1
            break
        fi
        echo "   ⚠️  build attempt $attempt failed — retrying in 15s (transient builder errors are common)"
        sleep 15
    done
    if [ "$BUILD_OK" != "1" ]; then
        echo "❌ Image build failed after 3 attempts (see output above)"; exit 1
    fi
    # Deterministic tag ref — the label we just pushed. Pass by TAG (never a
    # @sha256 digest) so machine run resolves the plain manifest.
    IMAGE_REF="registry.fly.io/$APP:$IMAGE_LABEL"
    echo "✅ Image: $IMAGE_REF"
fi

# ── 4. Provision a one-shot machine with the benchmark env ───────────────────
echo ""
echo "🚀 Provisioning one-shot machine ($VM_SIZE / ${VM_MEMORY}MB) ..."
RUN_LOG="$(mktemp)"
# --restart no: one-shot; do NOT auto-remove (--rm) — we destroy explicitly in
# teardown AFTER retrieving logs, so the machine must survive until then.
FLY machine run "$IMAGE_REF" \
    -a "$APP" \
    --region "$REGION" \
    --vm-size "$VM_SIZE" \
    --vm-memory "$VM_MEMORY" \
    --restart no \
    --env "BENCH_TASK=$BENCH_TASK" \
    --env "BENCH_SIMULATE=$BENCH_SIMULATE" \
    --env "BENCH_FLAGS=$BENCH_FLAGS" \
    --env "WMH_MODEL_NAME=$WMH_MODEL_NAME" \
    --detach 2>&1 | tee "$RUN_LOG"
MACHINE_RUN_STATUS="${PIPESTATUS[0]}"

# Capture the machine id from the run output REGARDLESS of exit status. Even when
# `machine run --detach` returns non-zero (e.g. "failed to reach desired start
# state" because a cold image pull in iad exceeded its internal start deadline),
# the machine IS created and WILL start — the health-wait loop below tolerates a
# slow start. We only hard-fail when NO machine exists.
MACHINE_ID="$(grep -oiE 'Machine ID: [0-9a-f]+' "$RUN_LOG" | tail -1 | awk '{print $3}')"
rm -f "$RUN_LOG"
if [ -z "$MACHINE_ID" ]; then
    # No id in output — ask the API (there should be exactly one machine).
    MACHINE_ID="$(FLY machines list -a "$APP" --json 2>/dev/null | python3 -c 'import json,sys
try:
    d=json.load(sys.stdin) or []
    print(d[0]["id"] if d else "")
except Exception:
    print("")' 2>/dev/null)"
fi
if [ -z "$MACHINE_ID" ]; then
    if [ "$MACHINE_RUN_STATUS" -ne 0 ]; then
        echo "❌ Failed to provision machine and no machine was created (see output above)."
        exit 1
    fi
    echo "⚠️  Could not determine machine id (teardown will still sweep the whole app)."
    MACHINE_ID=""
else
    if [ "$MACHINE_RUN_STATUS" -ne 0 ]; then
        echo "⚠️  machine run returned non-zero (likely a slow cold image pull) — machine $MACHINE_ID was created; continuing to monitor its start."
    fi
    echo "✅ Machine: $MACHINE_ID"
fi

# ── 5. Stream logs; wait for the DONE marker; capture the report card ─────────
echo ""
echo "📡 Streaming machine logs (waiting for benchmark to complete)..."
echo "   (hard timeout ${RUN_TIMEOUT}s — teardown fires on timeout too)"

DONE_MARKER="::CLOUDBENCH-DONE::"
REPORT_BEGIN="::CLOUDBENCH-REPORT-CARD-BEGIN::"
REPORT_END="::CLOUDBENCH-REPORT-CARD-END::"

ALL_LOGS="$(mktemp)"
DEADLINE=$(( $(date +%s) + RUN_TIMEOUT ))
FINISHED="0"
BENCH_EXIT=""

# Poll buffered logs on an interval (streaming `flyctl logs` blocks indefinitely;
# polling with --no-tail lets us watch for the DONE marker and enforce a timeout).
while [ "$(date +%s)" -lt "$DEADLINE" ]; do
    if [ -n "$MACHINE_ID" ]; then
        FLY logs -a "$APP" --machine "$MACHINE_ID" --no-tail 2>/dev/null > "$ALL_LOGS" || true
    else
        FLY logs -a "$APP" --no-tail 2>/dev/null > "$ALL_LOGS" || true
    fi

    # Show new [cloudbench] progress lines (dedupe against last render).
    grep -aE '\[cloudbench\]|🌌|🌍|report-card|❌|FATAL|Results saved' "$ALL_LOGS" 2>/dev/null \
        | tail -8 | sed 's/^/   /' || true

    if grep -aq "$DONE_MARKER" "$ALL_LOGS" 2>/dev/null; then
        FINISHED="1"
        BENCH_EXIT="$(grep -aoE "${DONE_MARKER} exit=[0-9]+" "$ALL_LOGS" | tail -1 | grep -oE '[0-9]+$' || echo '')"
        break
    fi

    # If the machine has stopped/destroyed without a DONE marker, bail.
    STATE="$(FLY machines list -a "$APP" --json 2>/dev/null | python3 -c 'import json,sys
d=json.load(sys.stdin) or []
print(d[0].get("state","") if d else "gone")' 2>/dev/null || echo '')"
    if [ "$STATE" = "stopped" ] || [ "$STATE" = "destroyed" ] || [ "$STATE" = "gone" ]; then
        echo "   ⚠️  machine state=$STATE without DONE marker — collecting final logs"
        sleep 3
        if [ -n "$MACHINE_ID" ]; then
            FLY logs -a "$APP" --machine "$MACHINE_ID" --no-tail 2>/dev/null > "$ALL_LOGS" || true
        fi
        grep -aq "$DONE_MARKER" "$ALL_LOGS" 2>/dev/null && FINISHED="1"
        break
    fi

    sleep 10
done

echo ""
if [ "$FINISHED" != "1" ]; then
    echo "⏰ Timed out or machine ended before completion. Final logs tail:"
    tail -60 "$ALL_LOGS" 2>/dev/null | sed 's/^/   /' || true
fi

# ── 6. Retrieve the report card + run JSON directly from the machine ─────────
# `flyctl logs --no-tail` only returns the last ~100 buffered lines, so the
# report card (printed between delimiters) can scroll out of the buffer. Fetch
# the files directly over SSH instead — reliable and complete. This runs while
# the machine is still alive (before teardown).
mkdir -p "$ROOT_DIR/.context"
CARD_OUT="$ROOT_DIR/.context/cloudbench-report-card.json"
RUN_OUT="$ROOT_DIR/.context/cloudbench-run.json"
REMOTE_CTX="/app/.context/cloudbench"
CARD_JSON=""
RUN_JSON=""

if [ -n "$MACHINE_ID" ] && [ "$FINISHED" = "1" ]; then
    echo ""
    echo "📥 Fetching report card + run record from the machine over SSH..."
    CARD_JSON="$(FLY ssh console -a "$APP" --machine "$MACHINE_ID" \
        -C "cat $REMOTE_CTX/report-card.json" 2>/dev/null \
        | grep -av '^Connecting to' || true)"
    RUN_JSON="$(FLY ssh console -a "$APP" --machine "$MACHINE_ID" \
        -C "bash -lc 'ls -t /app/agents/benchmarks/runs/*.json 2>/dev/null | head -1 | xargs cat 2>/dev/null'" 2>/dev/null \
        | grep -av '^Connecting to' || true)"
fi

# Fallback: recover the report card from the log buffer if SSH missed it.
if [ -z "$CARD_JSON" ]; then
    CARD_JSON="$(awk "/$REPORT_BEGIN/{f=1;next} /$REPORT_END/{f=0} f" "$ALL_LOGS" 2>/dev/null)"
fi

echo ""
echo "════════════════════ REPORT CARD ════════════════════"
if [ -n "$CARD_JSON" ]; then
    echo "$CARD_JSON" | python3 -m json.tool 2>/dev/null || echo "$CARD_JSON"
    echo "$CARD_JSON" > "$CARD_OUT" 2>/dev/null && echo "" && echo "💾 Saved report card: $CARD_OUT"
else
    echo "⚠️  No report card retrieved."
fi
echo "══════════════════════════════════════════════════════"

# Persist + summarize the run record (the authoritative pass/fail).
PASS_RATE=""
if [ -n "$RUN_JSON" ]; then
    echo "$RUN_JSON" > "$RUN_OUT" 2>/dev/null && echo "💾 Saved run record: $RUN_OUT"
    echo ""
    echo "──────────────────── RUN SUMMARY ────────────────────"
    PASS_RATE="$(printf '%s' "$RUN_JSON" | python3 -c 'import json,sys
try:
    d=json.load(sys.stdin)
    s=d.get("summary",{})
    print(f"passed={s.get(\"passed\")} failed={s.get(\"failed\")} skipped={s.get(\"skipped\",0)} pass_rate={s.get(\"pass_rate\")} dur={s.get(\"total_duration_seconds\")}s cost_cents={s.get(\"total_cost_cents\")}")
    for t in d.get("tasks",[]):
        print(f"  task={t.get(\"name\")} passed={t.get(\"passed\")} mode={t.get(\"world_model_mode\")} dur={t.get(\"duration_seconds\")}s agent={t.get(\"agent_id\")}")
    print("PASS_RATE_VALUE=", s.get("pass_rate"))
except Exception as e:
    print("could not parse run json:", e)' 2>/dev/null | sed 's/^/   /')"
    echo "$PASS_RATE"
    echo "─────────────────────────────────────────────────────"
fi

echo ""
echo "🏁 benchmark exit code (run_benchmark.py --ci): ${BENCH_EXIT:-unknown}   (finished=$FINISHED)"

# Derive the authoritative outcome from the run record's pass_rate when we have
# it (the --ci exit also fails on skipped tasks, which is stricter than "did the
# task pass"). Prefer the run JSON; fall back to the entrypoint's exit code.
OUTCOME_OK="0"
RUN_PASS_RATE="$(printf '%s' "$PASS_RATE" | grep -oE 'PASS_RATE_VALUE= [0-9.]+' | awk '{print $2}' || true)"
if [ -n "$RUN_PASS_RATE" ]; then
    case "$RUN_PASS_RATE" in
        1|1.0|1.00) OUTCOME_OK="1" ;;
    esac
    echo "🎯 authoritative pass_rate from run record: $RUN_PASS_RATE (ok=$OUTCOME_OK)"
elif [ "$FINISHED" = "1" ] && [ "${BENCH_EXIT:-1}" = "0" ]; then
    OUTCOME_OK="1"
fi

rm -f "$ALL_LOGS"

# teardown() (EXIT trap) destroys the machine + proves 0 remain.
[ "$OUTCOME_OK" = "1" ] && exit 0
exit 1
