#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# run-bench-cloud — WARM, PERSISTENT cloud-exclusive benchmark runner.
#
# A single deterministically-named Fly machine (app: navi-whisper-lux-bench) with
# a Fly VOLUME mounted at /data holds the deps (baked into the keep-alive image),
# the branch checkout (/data/repo), and a cached World Model Harness artifact
# (/data/world-model). The machine is START/STOPPED per run — NEVER destroyed —
# so a warm run only git-syncs the branch and boots the stack against the CACHED
# WMH model (served, not rebuilt). A STOPPED Fly machine bills only for the small
# volume, so idle cost is ~0.
#
# The per-run path is HANDS-OFF + WARM:
#     one-time  : --setup  → volume + machine + git clone
#     rare      : --build-wmh → build the native WMH on an owned big machine + publish
#                 --refresh-wmh → restore the published serving cache onto the volume
#     per run   : <task...> [--simulate] → start warm machine → detach the on-box
#                  driver (cloudbench-run.sh) → serve-cached-WMH → run_benchmark →
#                  proxy the live dashboard to the Mac → retrieve report card +
#                  newest run record → STOP the machine
#     cleanup   : --destroy → destroy machine + volume
#
# The warm machine (cloudbench-warm) + Fly volume (cloudbench_data → /data) already
# exist. /data persists across stop/start (the container's baked /app does NOT):
#   /data/repo         a PRE-AUTHENTICATED git checkout (remote URL embeds a repo
#                      token — no token handling needed on the box)
#   /data/world-model  a PRE-BUILT WMH model (served, NEVER rebuilt from R2, which
#                      is throttled to ~14 KB/s = hours)
#
# WHY the detach + poll design: `flyctl ssh console -C` BUFFERS stdout until the
# session ends AND returns exit 4294967295 whenever the remote command backgrounds
# a process. So the on-box driver is launched DETACHED
#     setsid bash /tmp/rb.sh > /data/bench.log 2>&1 < /dev/null &
# and this controller polls /data/bench.log for the DONE marker over SEPARATE short
# ssh -C reads (each retry-wrapped to tolerate transient ssh failures).
#
# Usage:
#   # ── one-time bootstrap (run these two, in order, once) ──
#   bash scripts/run-bench-cloud --setup
#   bash scripts/run-bench-cloud --refresh-wmh
#
#   # ── HANDS-OFF per-run path (repeat as often as you like) ──
#   bash scripts/run-bench-cloud <task...> --simulate
#   bash scripts/run-bench-cloud spawn-sub-agents --simulate
#   bash scripts/run-bench-cloud chat-mode spawn-sub-agents --simulate --parallel
#   bash scripts/run-bench-cloud chat-mode --simulate --ref my-branch
#
#   # ── explicit cleanup (removes the machine + volume; ends billing entirely) ──
#   bash scripts/run-bench-cloud --destroy
#
# Flags:
#   --setup            one-time: create volume + persistent machine + git clone
#   --build-image      build/push the dependency image without changing Machines
#   --builder native|depot  image-build only; native default, Depot app scope/zstd 3
#   --no-cache         explicitly bypass image build layers (build/setup only)
#   --build-context D  build the unchanged source in another checkout
#   --refresh-wmh      explicit-only: refresh the cached WMH models on the donor
#                      (native default: restore WMH_CACHE_NAME into /data/world-model-native
#                      + pre-create the native venv, and restore WMH_LEGACY_CACHE_NAME
#                      (default rose-r2-archive-legacy) into /data/world-model only when
#                      the legacy model is missing; fails before a pull without room;
#                      WMH_ENGINE=legacy rebuilds on-box)
#   --build-wmh        explicit-only: build the native WMH on an OWNED ephemeral
#                      Machine+Volume forked from the donor snapshot (WMH_BUILD_VM_SIZE
#                      performance-8x, WMH_BUILD_VM_MEMORY_MB 65536, WMH_BUILD_VOLUME_GB
#                      80), push WMH_CACHE_NAME (serving-only) + WMH_FULL_CACHE_NAME
#                      (full; default rose-archive-native), then destroy both. Optional
#                      WMH_EXPORT_CACHE_NAME runs only the native step on that export.
#   --refresh-secrets  refresh + verify the app environment, then exit (maintenance
#                      op — the ONLY path that stages/activates app secrets)
#   --verify-secrets   READ-ONLY check that the app environment exists, then exit.
#                      Used by every run path so concurrent workstreams never
#                      mutate (and therefore never race) the shared environment.
#   --destroy          explicit-only: destroy the machine + volume
#   --simulate         pass --simulate to run_benchmark (default for a task run)
#   --no-simulate      real mode (no WMH); serves nothing, runs the live stack
#   --parallel         run multiple tasks concurrently (implied when >1 task)
#   --max-concurrency <n>  cap concurrent tasks when running multiple (default 5)
#   --ref <branch|sha> branch/sha to git-sync + run (default: current HEAD sha)
#   --no-dashboard     do NOT proxy/open the live dashboard (implied under CI)
#   --dash-port <n>    local port for the proxied dashboard (default CONDUCTOR_PORT+5764
#                      → 8765 on the standard 3001 workspace)
#   --model <name>     WMH model artifact name (default rose-archive; legacy engine:
#                      rose-r2-archive-anthropic)
#   --vm-size <size>   machine size at --setup (default shared-cpu-4x)
#   --vm-memory <mb>   machine memory at --setup (default 8192)
#   --volume-size <gb> volume size at --setup (default 20)
#   --timeout <secs>   controller ceiling for ordinary tasks (default 7200); catalog
#                      step-budget-only Polar uses a semantic-inactivity watchdog
#                      capped by this value (default inactivity 1800)
#
# SAFETY: the default per-run path ALWAYS STOPS the machine on every exit
# (success, failure, error, timeout, Ctrl-C) so nothing is left running/billing.
# Only --destroy removes the machine + volume.
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

# Snapshot-local validators import sibling controller modules. Fleet already
# exports this before launch; keep direct/legacy controller invocations equally
# unable to mutate a supplied sealed snapshot with Python bytecode caches.
export PYTHONDONTWRITEBYTECODE=1

APP="navi-whisper-lux-bench"
PROD_APP="navi-whisper-lux"   # NEVER touch this.
REGION="${CLOUDBENCH_REGION:-iad}"
MACHINE_NAME="${CLOUDBENCH_WARM_MACHINE_NAME:-cloudbench-warm}"
VOLUME_NAME="${CLOUDBENCH_WARM_VOLUME_NAME:-cloudbench_data}"     # Fly volume names must be [a-z0-9_].
case "$MACHINE_NAME" in ''|*[!a-z0-9-]*) echo "Invalid warm machine name" >&2; exit 2 ;; esac
case "$VOLUME_NAME" in ''|*[!a-z0-9_]*) echo "Invalid warm volume name" >&2; exit 2 ;; esac
ROOT_DIR="${CLOUDBENCH_FLEET_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT_DIR" || exit 1
# shellcheck source=lib/cloudbench-env.sh
source "${CLOUDBENCH_SCRIPT_SNAPSHOT:-$ROOT_DIR/scripts/lib}/cloudbench-env.sh"
# Every guest refuses bench-app secrets lacking the committed guest namespace,
# whichever launcher (or older checkout) staged them; a launcher may bind its own.
CLOUDBENCH_EXPECTED_GUEST_TEMPORAL_NAMESPACE="${CLOUDBENCH_EXPECTED_GUEST_TEMPORAL_NAMESPACE:-$(cloudbench_expected_guest_temporal_namespace "$APP")}"
# shellcheck source=lib/cloudbench-github-token.sh
source "${CLOUDBENCH_SCRIPT_SNAPSHOT:-$ROOT_DIR/scripts/lib}/cloudbench-github-token.sh"
CLOUDBENCH_CATALOG_SCRIPT="${CLOUDBENCH_SCRIPT_SNAPSHOT:-$ROOT_DIR/scripts}/cloudbench_catalog.py"
CLOUDBENCH_RUNTIME_SCRIPT_ROOT="${CLOUDBENCH_SCRIPT_SNAPSHOT:-$ROOT_DIR/scripts}"
[ -d "$CLOUDBENCH_RUNTIME_SCRIPT_ROOT/lib" ] \
    && CLOUDBENCH_RUNTIME_LIB_ROOT="$CLOUDBENCH_RUNTIME_SCRIPT_ROOT/lib" \
    || CLOUDBENCH_RUNTIME_LIB_ROOT="$CLOUDBENCH_RUNTIME_SCRIPT_ROOT"
CLOUDBENCH_GUEST_GENERATION_SCRIPT="$CLOUDBENCH_RUNTIME_SCRIPT_ROOT/cloudbench-isolated-generation.py"
CLOUDBENCH_GUEST_BOOT_SCRIPT="$CLOUDBENCH_RUNTIME_SCRIPT_ROOT/cloudbench-boot.sh"
CLOUDBENCH_GUEST_BOOT_PAYLOAD_SCRIPT="$CLOUDBENCH_RUNTIME_SCRIPT_ROOT/cloudbench-boot-payload.py"
CLOUDBENCH_GUEST_CODEX_AUTH_SCRIPT="$CLOUDBENCH_RUNTIME_SCRIPT_ROOT/cloudbench-codex-auth.py"
CLOUDBENCH_GUEST_RUN_SCRIPT="$CLOUDBENCH_RUNTIME_SCRIPT_ROOT/cloudbench-run.sh"
CLOUDBENCH_GUEST_PROCESS_IDENTITY_SCRIPT="$CLOUDBENCH_RUNTIME_SCRIPT_ROOT/process-identity.py"
CLOUDBENCH_GUEST_FETCH_REF_SCRIPT="$CLOUDBENCH_RUNTIME_SCRIPT_ROOT/cloudbench-fetch-ref.sh"
CLOUDBENCH_GUEST_SYNC_DEPS_SCRIPT="$CLOUDBENCH_RUNTIME_SCRIPT_ROOT/cloudbench-sync-deps.sh"
CLOUDBENCH_GUEST_SYNC_PRISMA_SCRIPT="$CLOUDBENCH_RUNTIME_SCRIPT_ROOT/cloudbench-sync-prisma-client.sh"
CLOUDBENCH_GUEST_NGROK_INSTALL_SCRIPT="$CLOUDBENCH_RUNTIME_SCRIPT_ROOT/cloudbench-install-ngrok.sh"
CLOUDBENCH_GUEST_CURRENT_RUN_ARTIFACT_SCRIPT="$CLOUDBENCH_RUNTIME_SCRIPT_ROOT/cloudbench-current-run-artifact.py"
CLOUDBENCH_GUEST_PREPARE_PATCH_SCRIPT="$CLOUDBENCH_RUNTIME_SCRIPT_ROOT/cloudbench-prepare-patch.sh"
CLOUDBENCH_GUEST_STATUS_SERVER="$CLOUDBENCH_RUNTIME_SCRIPT_ROOT/cloudbench-status-server.py"
CLOUDBENCH_GUEST_BENCHMARK_TARGET_SCRIPT="$CLOUDBENCH_RUNTIME_SCRIPT_ROOT/cloudbench-benchmark-target.py"
CLOUDBENCH_GUEST_CATALOG_SCRIPT="$CLOUDBENCH_RUNTIME_SCRIPT_ROOT/cloudbench_catalog.py"
CLOUDBENCH_GUEST_EXECUTION_PROVENANCE_SCRIPT="$CLOUDBENCH_RUNTIME_SCRIPT_ROOT/cloudbench_execution_provenance.py"
CLOUDBENCH_GUEST_EXACT_SESSION_CLEANUP_SCRIPT="$CLOUDBENCH_RUNTIME_SCRIPT_ROOT/cloudbench-exact-session-cleanup.py"
CLOUDBENCH_GUEST_RECOVERY_SCRIPT="$CLOUDBENCH_RUNTIME_SCRIPT_ROOT/cloudbench-guest-recovery.py"
CLOUDBENCH_GUEST_ENV_HELPER="$CLOUDBENCH_RUNTIME_LIB_ROOT/cloudbench-env.sh"
CLOUDBENCH_GUEST_SEED_BUDGET_LIB="$CLOUDBENCH_RUNTIME_LIB_ROOT/cloudbench-seed-budget.sh"
MACHINE_READINESS_SCRIPT="$CLOUDBENCH_RUNTIME_SCRIPT_ROOT/cloudbench-machine-readiness.py"
CLOUDBENCH_RESULT_SCRIPT="$CLOUDBENCH_RUNTIME_SCRIPT_ROOT/cloudbench_result.py"
CONTROLLER_SNAPSHOT_MANIFEST="$CLOUDBENCH_RUNTIME_SCRIPT_ROOT/cloudbench-controller-snapshot-manifest.json"

STATE_FILE="$ROOT_DIR/.context/cloudbench-machine.json"
POOL_IDS_FILE="$ROOT_DIR/.context/cloudbench-pool.ids"
GIT_COMMON_DIR="$(git rev-parse --git-common-dir 2>/dev/null || echo "$ROOT_DIR/.git")"
case "$GIT_COMMON_DIR" in /*) ;; *) GIT_COMMON_DIR="$ROOT_DIR/$GIT_COMMON_DIR" ;; esac
WARM_DEPS_STATE_FILE="$GIT_COMMON_DIR/cloudbench-warm-deps.fp"
if [ "$MACHINE_NAME" != cloudbench-warm ]; then
    WARM_DEPS_STATE_FILE="$GIT_COMMON_DIR/cloudbench-warm-deps.$MACHINE_NAME.fp"
fi
APP_ENV_LOCK_FILE="$GIT_COMMON_DIR/cloudbench-app-env.lock"
# Cross-workspace app-environment lock primitive (acquire/release/assert). Its
# wait budget must outlast a peer's warm-dep refresh so concurrent fleets queue
# rather than abort — see scripts/tests/cloudbench-app-env-lock.test.sh. Prefer
# the immutable per-invocation script snapshot (set by run-bench-fleet) so a
# mid-run edit to the live lib can't shift bytes under an in-flight controller;
# fall back to the live lib dir for direct run-bench-cloud invocations.
# shellcheck source=lib/cloudbench-app-env-lock.sh
source "${CLOUDBENCH_SCRIPT_SNAPSHOT:-$ROOT_DIR/scripts/lib}/cloudbench-app-env-lock.sh"

# On-box paths (mirror scripts/cloudbench-run.sh).
REMOTE_REPO="/data/repo"
REMOTE_WMH="/data/world-model"
# uv-managed Python for the native WMH venv; must live on the volume so clones keep it.
REMOTE_UV_PYTHON="/data/uv-python"
# The native experiential model lives beside, never inside, the legacy model
# directory: every engine's guests fork the same donor snapshot.
REMOTE_WMH_NATIVE="/data/world-model-native"
REMOTE_LOG="/data/bench.log"      # detached on-box driver logs here; we poll it.
REMOTE_TMP_SCRIPT="/tmp/rb.sh"    # the base64'd on-box invocation lands here.
REMOTE_DASH_PORT="8009"           # on-box static dashboard http.server port.
REMOTE_STATUS_PORT="8011"         # on-box http.server serving /data (bench.log) —
                                  # polled over the Fly DATA PLANE (flyctl proxy)
                                  # instead of ssh (rate-limited Machines API).
REMOTE_BACKEND_PORT="3001"        # scripts/run.sh backend port for CONDUCTOR_PORT=3001.
# The runner user that owns every benchmark agent (matches run_benchmark.py USER_ID).
# The archive API proxies live reads to the box backend with this + the API key,
# which is what makes benchmark agents visible past RLS (a real logged-in browser
# user would be a different id and see nothing — the "dead localhost" symptom).
CLOUDBENCH_RUNNER_USER_ID="1f85ff25-6e29-4c1b-8739-f917bd101a30"

# ── Defaults ───────────────────────────────────────────────────────────────
MODE="run"              # run | setup | build-wmh | refresh-wmh | refresh-secrets | destroy
IMAGE_BUILD_NO_CACHE=0
IMAGE_BUILD_CONTEXT="$ROOT_DIR"
IMAGE_BUILD_BUILDER=native
IMAGE_BUILD_BUILDER_REQUESTED=0
IMAGE_PUBLISHER_CLIENT=""
BENCH_TASKS=()          # one or more task names (positional).
BENCH_SIMULATE="1"
BENCH_PARALLEL="0"
BENCH_MAX_CONCURRENCY="5"
BENCH_REF=""
# World-model launch configuration uses portable values, never controller paths.
# Cloud SIM serves the same native experiential WMH as local runs by default
# (see .claude/skills/instantiate-whm). WMH_ENGINE=legacy explicitly selects the
# previous model and its legacy defaults; every value stays operator-overridable.
WMH_ENGINE="${WMH_ENGINE:-experiential}"
case "$WMH_ENGINE" in
    legacy|experiential) ;;
    *) echo "Invalid WMH_ENGINE: expected legacy or experiential" >&2; exit 2 ;;
esac
if [ "$WMH_ENGINE" = experiential ]; then
    WMH_MODEL_NAME="${WMH_MODEL_NAME:-rose-archive}"
    WMH_ROSE_POOL="${WMH_ROSE_POOL:-rose-wmh-gpt61}"
    WMH_EXECUTION_POLICY="${WMH_EXECUTION_POLICY:-rose-outcome-distribution-v4}"
else
    WMH_MODEL_NAME="${WMH_MODEL_NAME:-rose-r2-archive-anthropic}"
    WMH_ROSE_POOL="${WMH_ROSE_POOL:-rose-1-ultra}"
    WMH_EXECUTION_POLICY="${WMH_EXECUTION_POLICY:-upstream}"
fi
if ! [[ "$WMH_MODEL_NAME" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    echo "Invalid WMH_MODEL_NAME" >&2
    exit 2
fi
# R2 cache name of the serving-only native build that --refresh-wmh restores.
WMH_CACHE_NAME="${WMH_CACHE_NAME:-rose-archive-serving}"
if ! [[ "$WMH_CACHE_NAME" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    echo "Invalid WMH_CACHE_NAME" >&2
    exit 2
fi
# Both engines serve from one donor snapshot: the legacy model (main's default)
# under /data/world-model and the native one beside it. When the donor lost the
# legacy model, the native --refresh-wmh restores it from this R2 cache.
WMH_LEGACY_CACHE_NAME="${WMH_LEGACY_CACHE_NAME:-rose-r2-archive-legacy}"
WMH_LEGACY_MODEL_NAME="${WMH_LEGACY_MODEL_NAME:-rose-r2-archive-anthropic}"
for _wmh_name_key in WMH_LEGACY_CACHE_NAME WMH_LEGACY_MODEL_NAME; do
    if ! [[ "${!_wmh_name_key}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
        echo "Invalid $_wmh_name_key" >&2
        exit 2
    fi
done
if ! [[ "$WMH_ROSE_POOL" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then
    echo "Invalid WMH_ROSE_POOL" >&2
    exit 2
fi
# The guest runs BENCH_REF, so its pool registry decides; this checkout may differ.
validate_wmh_rose_pool_at_ref() {  # validate_wmh_rose_pool_at_ref <ref> <pool>
    local ref="$1" pool="$2" registry status
    if [ -z "$ref" ] || ! git -C "$ROOT_DIR" rev-parse --quiet --verify --end-of-options "$ref^{commit}" >/dev/null 2>&1; then
        echo "⚠️  Benchmark ref ${ref:-<none>} is not available locally; WMH_ROSE_POOL=$pool is not validated before launch" >&2
        return 0
    fi
    registry="$(mktemp "${TMPDIR:-/tmp}/rose-pools.XXXXXX")" || return 2
    if ! git -C "$ROOT_DIR" show "$ref:agents/providers/rose/pools.py" > "$registry" 2>/dev/null; then
        rm -f "$registry"
        echo "Invalid WMH_ROSE_POOL: the Rose pool registry is missing at $ref" >&2
        return 2
    fi
    # Read the selected ref's registry as data; never execute its code here.
    python3 - "$registry" "$pool" <<'PY_WMH_POOL'
import ast
import sys

names = None
for node in ast.parse(open(sys.argv[1], encoding="utf-8").read()).body:
    if isinstance(node, ast.AnnAssign):
        target = node.target
    elif isinstance(node, ast.Assign) and len(node.targets) == 1:
        target = node.targets[0]
    else:
        continue
    if isinstance(target, ast.Name) and target.id == "POOL_REGISTRY" and isinstance(node.value, ast.Dict):
        keys = node.value.keys
        if all(isinstance(key, ast.Constant) and isinstance(key.value, str) for key in keys):
            names = {key.value for key in keys}
if names is None:
    sys.exit("POOL_REGISTRY is not a literal dict of pool names")
sys.exit(0 if sys.argv[2] in names else 1)
PY_WMH_POOL
    status=$?
    rm -f "$registry"
    if [ "$status" -ne 0 ]; then
        echo "Invalid WMH_ROSE_POOL: expected a Rose pool registered at $ref" >&2
        return 2
    fi
}
WMH_CONTEXT_TOKENS="${WMH_CONTEXT_TOKENS:-}"
if [ -n "$WMH_CONTEXT_TOKENS" ] && ! [[ "$WMH_CONTEXT_TOKENS" =~ ^[1-9][0-9]*$ ]]; then
    echo "Invalid WMH_CONTEXT_TOKENS: expected a positive integer or unset" >&2
    exit 2
fi
case "$WMH_EXECUTION_POLICY" in
    upstream|rose-virtual-public-affordances-v1|rose-virtual-public-affordances-v2|rose-outcome-distribution-v1|rose-outcome-distribution-v2|rose-outcome-distribution-v3|rose-outcome-distribution-v4) ;;
    *) echo "Invalid WMH_EXECUTION_POLICY: expected an immutable registered policy" >&2; exit 2 ;;
esac
if [ "$WMH_ENGINE" != experiential ] && [ "$WMH_EXECUTION_POLICY" != upstream ]; then
    echo "WMH_EXECUTION_POLICY requires WMH_ENGINE=experiential" >&2
    exit 2
fi
# End world-model launch configuration.
VM_SIZE="shared-cpu-4x"
VM_MEMORY="8192"
WARM_PARKED_VM_SIZE="${CLOUDBENCH_WARM_PARKED_VM_SIZE:-shared-cpu-1x}"
WARM_PARKED_VM_MEMORY="${CLOUDBENCH_WARM_PARKED_VM_MEMORY:-2048}"
VOLUME_SIZE="20"
RUN_TIMEOUT="7200"      # 120 min controller backstop; benchmark work has its own ceiling.
BENCHMARK_WALL_CLOCK_BACKSTOP_SECONDS="${BENCHMARK_WALL_CLOCK_BACKSTOP_SECONDS-7200}"
case "$BENCHMARK_WALL_CLOCK_BACKSTOP_SECONDS" in
    ''|*[!0-9]*|0) echo "❌ BENCHMARK_WALL_CLOCK_BACKSTOP_SECONDS must be a positive integer" >&2; exit 2 ;;
esac
[ "$BENCHMARK_WALL_CLOCK_BACKSTOP_SECONDS" -gt 0 ] || exit 2
CLOUDBENCH_RUNTIME_EVIDENCE_SECONDS="${CLOUDBENCH_RUNTIME_EVIDENCE_SECONDS:-$BENCHMARK_WALL_CLOCK_BACKSTOP_SECONDS}"
case "$CLOUDBENCH_RUNTIME_EVIDENCE_SECONDS" in
    ''|*[!0-9]*|0) echo "❌ CLOUDBENCH_RUNTIME_EVIDENCE_SECONDS must be a positive integer" >&2; exit 2 ;;
esac
[ "$CLOUDBENCH_RUNTIME_EVIDENCE_SECONDS" -gt 0 ] || exit 2
DASHBOARD="1"           # proxy + open the live dashboard (auto-off under CI).
# Per-workspace default so concurrent workspaces get non-colliding dashboards
# (CONDUCTOR_PORT=3001 → 8765, the historical default).
LOCAL_DASH_PORT="${CLOUDBENCH_DASH_BASE:-$(( ${CONDUCTOR_PORT:-3001} + 5764 ))}"
FLEET_MACHINE_ID=""     # set by run-bench-fleet to pin a per-bench cloned machine.
OUT_DIR=""              # set by run-bench-fleet to isolate a bench's .context outputs.
SKIP_CONTROLLER_LOCK="0"  # set by run-bench-fleet (fleet owns one lock for its children).
NO_OPEN="${NO_OPEN:-0}"   # legacy flag; nothing auto-opens a browser anymore (in-app hub).

# ── Arg parsing ──────────────────────────────────────────────────────────────
while [ $# -gt 0 ]; do
    case "$1" in
        --setup)          MODE="setup"; shift ;;
        --build-image)    MODE="build-image"; shift ;;
        --no-cache)       IMAGE_BUILD_NO_CACHE=1; shift ;;
        --builder)
            [ "$#" -ge 2 ] || { echo "--builder requires native or depot" >&2; exit 2; }
            case "$2" in
                native|depot) IMAGE_BUILD_BUILDER="$2"; IMAGE_BUILD_BUILDER_REQUESTED=1 ;;
                *) echo "--builder requires native or depot" >&2; exit 2 ;;
            esac
            shift 2
            ;;
        --build-context)  IMAGE_BUILD_CONTEXT="${2:-}"; shift 2 ;;
        --refresh-wmh)    MODE="refresh-wmh"; shift ;;
        --build-wmh)      MODE="build-wmh"; shift ;;
        --refresh-deps)   MODE="refresh-deps"; shift ;;
        --refresh-secrets) MODE="refresh-secrets"; shift ;;
        --verify-secrets) MODE="verify-secrets"; shift ;;   # read-only preflight (concurrency-safe)
        --destroy)        MODE="destroy"; shift ;;
        --simulate)       BENCH_SIMULATE="1"; shift ;;
        --no-simulate)    BENCH_SIMULATE="0"; shift ;;
        --parallel)       BENCH_PARALLEL="1"; shift ;;
        --max-concurrency) BENCH_MAX_CONCURRENCY="${2:-}"; shift 2 ;;
        --ref)            BENCH_REF="${2:-}"; shift 2 ;;
        --no-dashboard)   DASHBOARD="0"; shift ;;
        --dash-port)      LOCAL_DASH_PORT="${2:-}"; shift 2 ;;
        # ── Fleet mode: a per-bench machine managed by run-bench-fleet ───────
        --machine)        FLEET_MACHINE_ID="${2:-}"; shift 2 ;;   # target this machine; caller owns its lifecycle
        --out-dir)        OUT_DIR="${2:-}"; shift 2 ;;            # isolate this run's .context outputs
        --no-lock)        SKIP_CONTROLLER_LOCK="1"; shift ;;      # fleet holds one lock for all its children
        --no-open)        NO_OPEN="1"; shift ;;                   # legacy no-op (nothing auto-opens a browser anymore)
        --model)          WMH_MODEL_NAME="${2:-}"; shift 2 ;;
        --vm-size)        VM_SIZE="${2:-}"; shift 2 ;;
        --vm-memory)      VM_MEMORY="${2:-}"; shift 2 ;;
        --volume-size)    VOLUME_SIZE="${2:-}"; shift 2 ;;
        --timeout)        RUN_TIMEOUT="${2:-}"; shift 2 ;;
        -h|--help)
            sed -n '2,91p' "$0"; exit 0 ;;
        --*)              echo "❌ Unknown flag: $1" >&2; exit 2 ;;
        *)                BENCH_TASKS+=("$1"); shift ;;
    esac
done

# Explicit transport selection is frozen before any provider mutation. Never
# fall back to staged dispatch after an attempted config update.
if [ "$MODE" != verify-secrets ]; then
case "${CLOUDBENCH_BOOT_TRANSPORT:-config}" in
    config) ;;
    staged)
        [ "${CLOUDBENCH_BOOT_LAUNCH:-0}" = 1 ] \
            || { echo "staged boot requires explicit BOOT_LAUNCH" >&2; exit 2; }
        ;;
    *) echo "invalid explicit boot transport" >&2; exit 2 ;;
esac
fi

# BEGIN archived-generation transport (also exercised by the offline owner).
CLOUDBENCH_ARCHIVED_PROOF_B64=""
CLOUDBENCH_ARCHIVED_PROOF_SHA=""
CLOUDBENCH_ARCHIVED_DATA_ROOT=""
cloudbench_outcome_ok() {  # sets OUTCOME_OK=1/0 from FINISHED TIMED_OUT BENCH_EXIT RUN_IDENTITY_OK RUN_PASS_OK IMESSAGE_RELAY_OK
    if [ "$FINISHED" = "1" ] && [ "$TIMED_OUT" = "0" ] && [ "${BENCH_EXIT:-1}" = "0" ] \
        && [ "$RUN_PASS_OK" = "1" ] && [ "$IMESSAGE_RELAY_OK" = "1" ]; then
        OUTCOME_OK="1"
        return 0
    fi
    # Artifact-backed recovery: fast soft-complete guests (DEMO $0 cache) can tear
    # down the data-plane proxy before the controller finishes the post-DONE driver
    # 410 catch-up, leaving FINISHED=0 / BENCH_EXIT=1 even when the collected run
    # JSON validates --require-pass. Prefer validated pass artifacts over the
    # terminal-lifecycle race — same evidence the hub already trusts.
    # An observed exit (FINISHED=1) is authoritative: run.json is saved before
    # post-run gates (cache/memory ratchets), so a nonzero exit with a passing
    # artifact is a real gate failure, never a race to recover from.
    if [ "$FINISHED" != "1" ] \
        && [ "$TIMED_OUT" = "0" ] \
        && [ "$RUN_IDENTITY_OK" = "1" ] \
        && [ "$RUN_PASS_OK" = "1" ] \
        && [ "$IMESSAGE_RELAY_OK" = "1" ]; then
        echo "⚠️  recovering OUTCOME_OK from validated pass artifacts after terminal FINISHED race (finished=${FINISHED:-0} bench_exit=${BENCH_EXIT:-unknown})"
        OUTCOME_OK="1"
        return 0
    fi
    OUTCOME_OK="0"
}

cloudbench_load_archived_proof() {
    [ -n "${CLOUDBENCH_ARCHIVED_REUSE_PROOF_FILE:-}" ] || {
        [ "${CLOUDBENCH_STORAGE_MODE:-}" != retained-volume-fresh-generation ] || return 1
        return 0
    }
    [ "$MODE" = run ] && [ "$BENCH_SIMULATE" = 0 ] \
        && [ "${CLOUDBENCH_BOOT_LAUNCH:-0}" = 1 ] \
        && [ "${CLOUDBENCH_BOOT_TRANSPORT:-config}" = config ] \
        && [ "${CLOUDBENCH_FRESH_VOLUME:-0}" = 0 ] \
        && [ "${CLOUDBENCH_COLD_PRIMARY_BOOTSTRAP:-0}" = 1 ] || return 1
    local result
    result="$(python3 -S - "$CLOUDBENCH_GUEST_GENERATION_SCRIPT" "$CLOUDBENCH_ARCHIVED_REUSE_PROOF_FILE" \
        "$FLEET_MACHINE_ID" "$BENCH_REF" "${CLOUDBENCH_FLEET_RUN_TOKEN:-}" "${BENCH_TASKS[0]:-}" <<'PY'
import base64, hashlib, importlib.util, json, os, stat, sys
helper, path, machine, ref, token, task = sys.argv[1:]
fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
try:
    before = os.fstat(fd)
    if not stat.S_ISREG(before.st_mode) or before.st_uid != os.geteuid() or before.st_mode & 0o077 or not 0 < before.st_size <= 65536:
        raise ValueError('unsafe archived proof file')
    raw = os.read(fd, 65537)
    after = os.fstat(fd)
    if len(raw) != before.st_size or (before.st_ino, before.st_dev, before.st_size, before.st_mtime_ns) != (after.st_ino, after.st_dev, after.st_size, after.st_mtime_ns):
        raise ValueError('archived proof changed during read')
finally:
    os.close(fd)
# Boot and later fleet collectors must certify the same semantic proof bytes.
# The durable proof file itself remains untouched, including its recorded hash.
raw = json.dumps(json.loads(raw), sort_keys=True, separators=(",", ":"), allow_nan=False).encode()
b64 = base64.b64encode(raw).decode()
digest = hashlib.sha256(raw).hexdigest()
spec = importlib.util.spec_from_file_location('isolated_generation', helper)
module = importlib.util.module_from_spec(spec); spec.loader.exec_module(module)
value = module.proof({**os.environ, 'CLOUDBENCH_STORAGE_MODE':'retained-volume-fresh-generation',
    'CLOUDBENCH_ARCHIVED_REUSE_PROOF_B64':b64, 'CLOUDBENCH_ARCHIVED_REUSE_PROOF_SHA256':digest,
    'FLY_MACHINE_ID':machine, 'REF':ref, 'CLOUDBENCH_RUN_TOKEN':token})
if value['successor']['task'] != task: raise ValueError('archived task mismatch')
print(b64, digest, value['guest']['data_dir'])
PY
)" || return 1
    read -r CLOUDBENCH_ARCHIVED_PROOF_B64 CLOUDBENCH_ARCHIVED_PROOF_SHA CLOUDBENCH_ARCHIVED_DATA_ROOT <<< "$result"
    [ -n "$CLOUDBENCH_ARCHIVED_DATA_ROOT" ]
}
cloudbench_namespace_command() {  # exact MID, logical command; never rewrite provenance paths
    local id="$1" command="$2" encoded
    [ -n "$CLOUDBENCH_ARCHIVED_PROOF_B64" ] || { printf '%s' "$command"; return 0; }
    [ "$id" = "$FLEET_MACHINE_ID" ] || return 1
    encoded="$(printf '%s' "$command" | base64 | tr -d '\n')"
    printf 'env CLOUDBENCH_STORAGE_MODE=retained-volume-fresh-generation CLOUDBENCH_ARCHIVED_REUSE_PROOF_B64=%s CLOUDBENCH_ARCHIVED_REUSE_PROOF_SHA256=%s FLY_MACHINE_ID=%s REF=%s CLOUDBENCH_RUN_TOKEN=%q python3 -S /cloudbench-isolated-generation.py --external-exec /bin/bash -c "$(printf %%s %s | base64 -d)"' \
        "$CLOUDBENCH_ARCHIVED_PROOF_B64" "$CLOUDBENCH_ARCHIVED_PROOF_SHA" "$id" "$BENCH_REF" "$CLOUDBENCH_FLEET_RUN_TOKEN" "$encoded"
}
cloudbench_generation_sftp_path() {
    local id="$1" path="$2"
    [ -n "$CLOUDBENCH_ARCHIVED_PROOF_B64" ] || { printf '%s' "$path"; return 0; }
    [ "$id" = "$FLEET_MACHINE_ID" ] || return 1
    case "$path" in *'/../'*|*/..|*'/./'*|*/.) return 1 ;; esac
    case "$path" in
        /data) printf '%s' "$CLOUDBENCH_ARCHIVED_DATA_ROOT" ;;
        /data/*) printf '%s/%s' "$CLOUDBENCH_ARCHIVED_DATA_ROOT" "${path#/data/}" ;;
        /tmp/*) printf '%s' "$path" ;;
        *) return 1 ;;
    esac
}
# END archived-generation transport.

cloudbench_load_archived_proof || { echo "Invalid archived-generation handoff" >&2; exit 2; }

case "${CLOUDBENCH_COLD_PRIMARY_BOOTSTRAP:-0}" in 0|1) ;; *) exit 2 ;; esac
if [ "${CLOUDBENCH_COLD_PRIMARY_BOOTSTRAP:-0}" = 1 ]; then
    [ "${CLOUDBENCH_FRESH_VOLUME:-0}" = 1 ] || [ -n "$CLOUDBENCH_ARCHIVED_PROOF_B64" ] || { echo "Cold primary requires explicit future empty bootstrap" >&2; exit 2; }
fi
case "${CLOUDBENCH_FRESH_VOLUME:-0}" in 0|1) ;; *) echo "Invalid fresh-volume handoff" >&2; exit 2 ;; esac
if [ "${CLOUDBENCH_FRESH_VOLUME:-0}" = 1 ]; then
    [ "$MODE" = run ] && [ "$BENCH_SIMULATE" = 0 ] && [ "${CLOUDBENCH_BOOT_LAUNCH:-0}" = 1 ] || {
        echo "Fresh-volume bootstrap requires a REAL boot-launched task" >&2
        exit 2
    }
fi

if [ "$IMAGE_BUILD_BUILDER_REQUESTED" = 1 ] && [ "$MODE" != build-image ]; then
    echo "--builder requires --build-image" >&2
    exit 2
fi
if [ "$IMAGE_BUILD_NO_CACHE" = 1 ] || [ "$IMAGE_BUILD_CONTEXT" != "$ROOT_DIR" ]; then
    case "$MODE" in
        build-image|setup) ;;
        *) echo "Image build options require --build-image or --setup" >&2; exit 2 ;;
    esac
fi
case "$MODE" in
    build-image|setup)
        [ -d "$IMAGE_BUILD_CONTEXT" ] \
            && [ -f "$IMAGE_BUILD_CONTEXT/Dockerfile.cloudbench-warm" ] \
            && [ -f "$IMAGE_BUILD_CONTEXT/fly.cloudbench-warm.toml" ] \
            || { echo "Image build context requires Dockerfile.cloudbench-warm and fly.cloudbench-warm.toml" >&2; exit 2; }
        IMAGE_BUILD_CONTEXT="$(cd "$IMAGE_BUILD_CONTEXT" && pwd -P)"
        ;;
esac

# ── Parallel-safety guard: never run a bench on the SHARED warm machine ──────
# A bench RUN executes on whatever machine resolve_machine_id() returns. Without
# --machine (set ONLY by run-bench-fleet, which clones a DEDICATED ephemeral
# machine per bench), a run lands on the one shared warm box (name=cloudbench-
# warm). Two worktrees doing that collide on the SAME box — and whichever one
# stops it kills the other's in-flight run (a real cross-workspace clobber).
# So the warm machine is a CLONE SOURCE only; benches never run on it directly.
# Force every run through the parallel-safe fleet. Admin/maintenance modes
# (--setup / --refresh-* / --verify-secrets / --destroy) legitimately operate on
# the warm box and are exempt because MODE != "run". A maintainer can still opt
# in explicitly with CLOUDBENCH_ALLOW_SHARED_WARM_RUN=1 (not for agent use).
if [ "$MODE" = "run" ] && [ -z "$FLEET_MACHINE_ID" ] && [ "${CLOUDBENCH_ALLOW_SHARED_WARM_RUN:-0}" != "1" ]; then
    echo "❌ Direct cloud-bench runs on the shared warm machine are disabled — NOT parallel-safe." >&2
    echo "   Two worktrees running here collide on the one 'cloudbench-warm' box, and stopping it" >&2
    echo "   kills the other's in-flight run. Use the parallel-safe entrypoint (clones a dedicated" >&2
    echo "   Fly machine per bench, so concurrent worktrees never share a box):" >&2
    echo "       bash scripts/run-bench <task...>          # default: per-bench isolated Fly fleet" >&2
    echo "       bash scripts/run-bench-fleet <task...>    # same, explicit" >&2
    echo "   (run-bench-fleet invokes this script with --machine <clone> per bench; this guard only" >&2
    echo "    blocks bench RUNs on the shared warm box — --setup/--refresh-*/--destroy still work.)" >&2
    exit 2
fi

# Validate CLI inputs before exporting credentials or calling a provider.
# Injected $GITHUB_TOKEN is often an invalid github_pat_. Overwrite process env
# and local .env so children inherit the working hosts.yml / insteadOf token.
if [ "$MODE" != build-image ]; then
    # Image-only builds do not fetch or run source and need only Fly auth.
    cloudbench_export_controller_github_token \
      "$ROOT_DIR/agents/.env" \
      "$ROOT_DIR/back-end/.env" \
      || echo "WARN: controller GITHUB_TOKEN export failed; fetch-ref still uses cloudbench_controller_github_token" >&2
fi

# CI never pops a browser / proxy.
if [ -n "${CI:-}" ] || [ -n "${GITHUB_ACTIONS:-}" ] || [ -n "${CONTINUOUS_INTEGRATION:-}" ]; then
    DASHBOARD="0"
fi

# --parallel is implied when more than one task is given.
if [ "${#BENCH_TASKS[@]}" -gt 1 ]; then
    BENCH_PARALLEL="1"
fi

# Run-scoped output root. Defaults to the shared .context; run-bench-fleet points
# each per-bench child at its own dir so concurrent children never clobber each
# other's report-card.json / run.json / live-dashboard dir.
OUT_DIR="${OUT_DIR:-$ROOT_DIR/.context}"
mkdir -p "$OUT_DIR" 2>/dev/null || true

# Default ref = current branch's HEAD sha (deterministic; matches the code the
# caller is looking at). A caller can override with --ref <branch|sha>.
if [ -z "$BENCH_REF" ]; then
    BENCH_REF="$(git rev-parse HEAD 2>/dev/null || echo '')"
fi
validate_wmh_rose_pool_at_ref "$BENCH_REF" "$WMH_ROSE_POOL" || exit 2
# --model may replace the configured name after the launch block validated it.
if ! [[ "$WMH_MODEL_NAME" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    echo "Invalid WMH_MODEL_NAME" >&2
    exit 2
fi

# ── Fly auth token ───────────────────────────────────────────────────────────
# Operating the bench app requires a USER/org-scoped token. Prefer, in order:
#   1) FLY_BENCH_API_TOKEN (explicit override; must look real — len≥20)
#   2) the user login token in ~/.fly/config.yml (`flyctl auth login`) — org-wide
#   3) FLY_API_TOKEN env / agents/.env (last resort; may be app-scoped to prod)
# Cloud/agent shells sometimes inject a stub FLY_BENCH_API_TOKEN (len≪20) that
# shadows a good FLY_API_TOKEN and then fails secrets/machines with 401 —
# refuse stubs (mirrors scripts/run-bench-fleet).
resolve_fly_token() {
    if [ -n "${FLY_BENCH_API_TOKEN:-}" ] && [ "${#FLY_BENCH_API_TOKEN}" -ge 20 ]; then
        echo "$FLY_BENCH_API_TOKEN"
        return
    fi
    if [ -n "${FLY_BENCH_API_TOKEN:-}" ]; then
        echo "⚠️  ignoring stub FLY_BENCH_API_TOKEN (len=${#FLY_BENCH_API_TOKEN}); falling back" >&2
    fi
    local cfg="$HOME/.fly/config.yml"
    if [ -f "$cfg" ]; then
        local tok
        tok="$(grep -E '^access_token:' "$cfg" 2>/dev/null | head -1 | sed 's/^access_token: *//; s/^["'\'']//; s/["'\'']$//')"
        if [ -n "$tok" ]; then echo "$tok"; return; fi
    fi
    if [ -n "${FLY_API_TOKEN:-}" ]; then echo "$FLY_API_TOKEN"; return; fi
    grep -E '^FLY_API_TOKEN=' agents/.env 2>/dev/null | head -1 | cut -d= -f2- | sed 's/^["'\'']//; s/["'\'']$//'
}

FLY_API_TOKEN="$(resolve_fly_token)"
if [ -z "${FLY_API_TOKEN:-}" ]; then
    echo "❌ No Fly auth token found (FLY_BENCH_API_TOKEN, ~/.fly/config.yml, or FLY_API_TOKEN)." >&2
    echo "   Run 'flyctl auth login' or set FLY_BENCH_API_TOKEN to an org-scoped token." >&2
    exit 1
fi
export FLY_API_TOKEN

FLY() {
    if [ -n "${CLOUDBENCH_ARCHIVED_PROOF_B64:-}" ] && [ "${1:-} ${2:-}" = 'ssh console' ]; then
        echo "Archived generations require the namespace SSH entry" >&2
        return 1
    fi
    if [ -n "${CLOUDBENCH_ARCHIVED_PROOF_B64:-}" ] && [ "${1:-} ${2:-}" = 'ssh sftp' ]; then
        local -a generation_args=("$@")
        local generation_mid="" generation_i generation_remote
        for ((generation_i=0; generation_i<${#generation_args[@]}; generation_i++)); do
            if [ "${generation_args[$generation_i]}" = --machine ]; then
                generation_mid="${generation_args[$((generation_i+1))]}"
            fi
        done
        [ "$generation_mid" = "$FLEET_MACHINE_ID" ] || return 1
        case "${3:-}" in
            put)
                generation_i=$((${#generation_args[@]}-1))
                # No supported config-boot upload writes /data. Physical SFTP
                # would resolve guest symlinks in the OLD host mount namespace.
                case "${generation_args[$generation_i]}" in /data|/data/*) return 1 ;; esac
                ;;
            get)
                generation_i=$((${#generation_args[@]}-2))
                case "${generation_args[$generation_i]}" in /data|/data/*) return 1 ;; esac
                ;;
            *) return 1 ;;
        esac
        ssh_exec "$generation_mid" true >/dev/null || return 1
        generation_remote="$(cloudbench_generation_sftp_path "$generation_mid" "${generation_args[$generation_i]}")" || return 1
        generation_args[$generation_i]="$generation_remote"
        flyctl "${generation_args[@]}"
        return $?
    fi
    case "${1:-} ${2:-}" in
        'machine update'|'machines update'|'machine start'|'machines start'|'machine stop'|'machines stop'|'machine destroy'|'machines destroy'|'machine restart'|'machines restart'|'volume destroy'|'volumes destroy')
            local common arg
            common="$(git -C "$ROOT_DIR" rev-parse --path-format=absolute --git-common-dir)" || return 1
            for arg in "$@"; do
                if [ -e "$common/cloudbench-cold-handoffs/outgoing/$arg" ] || [ -L "$common/cloudbench-cold-handoffs/outgoing/$arg" ]; then
                    echo "❌ outgoing cold handoff excludes this source allocation" >&2; return 1
                fi
            done ;;
    esac
    flyctl "$@"
}

request_machine_start() {  # request_machine_start <machine_id>
    local id="$1"

    # Keep start as a simple foreground flyctl call. Readiness is still gated by
    # machine_state + ssh_ready below; this helper just requests the transition.
    FLY machine start "$id" -a "$APP" 2>&1 | sed 's/^/   /' || true
}

# ── Locate flyctl ────────────────────────────────────────────────────────────
if ! command -v flyctl >/dev/null 2>&1; then
    if [ -x "$HOME/.fly/bin/flyctl" ]; then
        export PATH="$HOME/.fly/bin:$PATH"
    else
        echo "❌ flyctl not found on PATH." >&2
        exit 1
    fi
fi

if [ "$APP" = "$PROD_APP" ]; then
    echo "❌ Refusing to run: bench app equals prod app ($PROD_APP)." >&2
    exit 1
fi

# Markers the on-box per-run script prints (parsed from the SSH transcript).
# Persistent pool volumes can still have a previous detached driver unwinding
# while the next run starts. Scope every terminal marker to this controller so
# stale output can never complete or populate the new run.
RUN_LOG_TOKEN="${CLOUDBENCH_FLEET_RUN_TOKEN:-$$-$(date +%s)-$RANDOM}"
case "$RUN_LOG_TOKEN" in
    ''|*[!a-zA-Z0-9._-]*) echo "❌ invalid cloud benchmark run token" >&2; exit 2 ;;
esac
DONE_MARKER="::CLOUDBENCH-DONE:: token=$RUN_LOG_TOKEN"
REPORT_BEGIN="::CLOUDBENCH-REPORT-CARD-BEGIN:: token=$RUN_LOG_TOKEN"
REPORT_END="::CLOUDBENCH-REPORT-CARD-END:: token=$RUN_LOG_TOKEN"
RESULT_BEGIN="::CLOUDBENCH-RESULT-BEGIN:: token=$RUN_LOG_TOKEN"
RESULT_END="::CLOUDBENCH-RESULT-END:: token=$RUN_LOG_TOKEN"

# ─────────────────────────────────────────────────────────────────────────────
# Helpers
# ─────────────────────────────────────────────────────────────────────────────

# Select the rolling watchdog only for the isolated one-task shape Fleet actually
# provisions.  The decision consumes one ordered JSONL metadata result for the
# complete batch; it never infers policy from a task-name prefix.  A multi-task
# process retains the absolute deadline because progress by one task cannot prove
# that its sibling is not stuck.
cloudbench_watchdog_mode_from_metadata() {
    python3 -c '
import json
import sys

try:
    rows = [json.loads(line) for line in sys.stdin if line.strip()]
except (TypeError, ValueError) as exc:
    print(f"invalid cloud benchmark metadata: {exc}", file=sys.stderr)
    raise SystemExit(2)

def exact_int(value):
    return isinstance(value, int) and not isinstance(value, bool)

eligible = (
    len(rows) == 1
    and rows[0].get("group") == "polar-bench"
    and isinstance(rows[0].get("tags"), list)
    and "polar-bench" in rows[0]["tags"]
    and exact_int(rows[0].get("timeout_seconds"))
    and rows[0]["timeout_seconds"] == 0
    and exact_int(rows[0].get("browser_step_budget"))
    and rows[0]["browser_step_budget"] > 0
)
if eligible:
    task_name = rows[0]["name"]
    step_budget = rows[0]["browser_step_budget"]
    print(f"progress\t{task_name}\t{step_budget}")
else:
    print("absolute")
'
}

# The dedicated default catches a heartbeat-masked live hang in half the old
# hour.  An explicit smaller --timeout still caps paid-resource inactivity;
# selecting Polar must never silently expand an operator-supplied bound.
cloudbench_polar_stall_seconds() {
    local absolute_seconds="$1"
    local requested="${CLOUDBENCH_POLAR_PROGRESS_STALL_SECONDS:-1800}"
    local execution_seconds barrier_seconds
    case "$absolute_seconds" in ''|*[!0-9]*|0) return 2 ;; esac
    case "$requested" in ''|*[!0-9]*|0) return 2 ;; esac
    execution_seconds="$absolute_seconds"
    if [ -n "${CLOUDBENCH_START_BARRIER:-}" ]; then
        barrier_seconds="${CLOUDBENCH_START_BARRIER_WAIT_SECONDS:-}"
        case "$barrier_seconds" in ''|*[!0-9]*|0) return 2 ;; esac
        [ "$absolute_seconds" -gt "$barrier_seconds" ] || return 2
        # Fleet pads the child timeout by its pre-execution barrier allowance.
        # Remove that padding before honoring the operator's task-run ceiling.
        execution_seconds=$((absolute_seconds - barrier_seconds))
    fi
    if [ "$execution_seconds" -lt "$requested" ]; then
        printf '%s\n' "$execution_seconds"
    else
        printf '%s\n' "$requested"
    fi
}

# Return a monotonic signature of benchmark-semantic events in the current
# token-bound driver log.  Timestamps, status elapsed seconds, report-card
# rewrites, arbitrary bytes, and the driver's generic benchmark heartbeat are
# deliberately absent.  STEP transitions, agent identity/status, and increasing
# structured counters are observable work; the signature changes only when one
# of those facts advances in the cumulative log.
cloudbench_progress_signature() {
    local run_token="$1" expected_task="$2" expected_budget="$3"
    python3 -c '
import hashlib
import json
import re
import sys

run_token = sys.argv[1]
expected_task = sys.argv[2]
expected_budget = sys.argv[3]
lines = sys.stdin.read().splitlines()
stamp = f"RUNSTAMP-{run_token}"
try:
    lines = lines[lines.index(stamp):]
except ValueError:
    raise SystemExit(0)

# The controller catalog describes local HEAD, while the paid guest checks out
# --ref (and may apply a patch).  Drop the absolute ceiling only after that guest
# prints the same exact task and step-only budget contract.  A stale/mismatched
# catalog therefore yields no renewable signature.
task_header = re.compile(r"^\s*📋\s+" + re.escape(expected_task) + r":")
budget_contract = re.compile(
    r"^\s*timeout=disabled \(step budget\), browser_steps≤"
    + re.escape(expected_budget)
    + r","
)
if not any(task_header.search(line) for line in lines):
    raise SystemExit(0)
if not any(budget_contract.search(line) for line in lines):
    raise SystemExit(0)

steps = set()
agent_ids = set()
statuses = set()
status_shapes = set()
max_agents = max_failed = max_root_messages = max_browser_steps = 0
max_cost = 0.0

full_status = re.compile(
    r"^\s+\.\.\.\s+([A-Z_]+)\s+\|\s+(\d+) agents "
    r"\((\d+) active, (\d+) failed\)\s+\|\s+(\d+) root msgs\s+\|\s+"
    r"([0-9]+(?:\.[0-9]+)?)c\s+\|\s+[0-9]+(?:\.[0-9]+)?s\s*$"
)
root_status = re.compile(
    r"^\s+\.\.\.\s+([A-Z_]+)\s+\((\d+) root msgs, "
    r"[0-9]+(?:\.[0-9]+)?s\)\s*$"
)
for line in lines:
    step = re.search(
        r"^\[cloudbench \d{2}:\d{2}:\d{2}\] STEP "
        r"(git_sync|env_decode|dep_sync|postgres|stack_launch|services_wait|benchmark)$",
        line,
    )
    if step:
        steps.add(step.group(1).strip())
    agent = re.search(r"Agent created:\s+([A-Za-z0-9-]+)", line)
    if agent:
        agent_ids.add(agent.group(1))
    status = full_status.search(line)
    if status:
        statuses.add(status.group(1))
        status_shapes.add(
            f"{status.group(1)}:{status.group(2)}:{status.group(3)}:{status.group(4)}"
        )
        max_agents = max(max_agents, int(status.group(2)))
        max_failed = max(max_failed, int(status.group(4)))
        max_root_messages = max(max_root_messages, int(status.group(5)))
        max_cost = max(max_cost, float(status.group(6)))
        continue
    status = root_status.search(line)
    if status:
        statuses.add(status.group(1))
        status_shapes.add(f"{status.group(1)}:-:-:-")
        max_root_messages = max(max_root_messages, int(status.group(2)))
    budget = re.search(r"Browser step budget reached:\s+(\d+)/(\d+)", line)
    if (
        budget
        and int(budget.group(2)) == int(expected_budget)
        and int(budget.group(1)) >= int(expected_budget)
    ):
        max_browser_steps = max(max_browser_steps, int(budget.group(1)))

semantic = dict(
    run=run_token,
    task=expected_task,
    browser_step_budget=expected_budget,
    steps=sorted(steps),
    agent_ids=sorted(agent_ids),
    statuses=sorted(statuses),
    status_shapes=sorted(status_shapes),
    max_agents=max_agents,
    max_failed=max_failed,
    max_root_messages=max_root_messages,
    max_cost=max_cost,
    max_browser_steps=max_browser_steps,
)
payload = json.dumps(semantic, sort_keys=True, separators=(",", ":")).encode()
print(hashlib.sha256(payload).hexdigest())
' "$run_token" "$expected_task" "$expected_budget"
}

# Consume only newly validated log bytes and persist a compact monotonic
# semantic state. The pending-line buffer is bounded, so a multi-megabyte JSON
# report line cannot turn liveness parsing back into cumulative work.
cloudbench_update_progress_state() {  # <state> <delta> <token> <task> <budget> <reset>
    local state_file="$1" delta_file="$2" run_token="$3"
    local expected_task="$4" expected_budget="$5" reset_stream="$6"
    python3 -S - "$state_file" "$delta_file" "$run_token" \
        "$expected_task" "$expected_budget" "$reset_stream" <<'PY'
import base64
import json
import os
import re
import sys
from pathlib import Path

state_path = Path(sys.argv[1])
delta_path = Path(sys.argv[2])
run_token, expected_task, expected_budget, reset_stream = sys.argv[3:7]

def fresh_state():
    return dict(
        version=1,
        run_token=run_token,
        expected_task=expected_task,
        expected_budget=expected_budget,
        task_seen=False,
        budget_seen=False,
        steps=[],
        stream_agent_creations=0,
        max_agent_creations=0,
        statuses=[],
        active_ranges=dict(),
        max_agents=0,
        max_active=-1,
        min_active=None,
        max_failed=0,
        max_root_messages=0,
        max_cost=0.0,
        max_browser_steps=0,
        pending_b64="",
        dropping_long_line=False,
        done_exit=None,
        barrier_ready=False,
        barrier_released=False,
    )

try:
    raw_state = state_path.read_text().strip()
    state = json.loads(raw_state) if raw_state else fresh_state()
except (OSError, ValueError, TypeError):
    raise SystemExit("invalid cloudbench progress state")
if (
    state.get("version") != 1
    or state.get("run_token") != run_token
    or state.get("expected_task") != expected_task
    or state.get("expected_budget") != expected_budget
):
    raise SystemExit("cloudbench progress state identity mismatch")

try:
    pending = base64.b64decode(state.get("pending_b64", ""), validate=True)
except (ValueError, TypeError):
    raise SystemExit("invalid cloudbench progress pending buffer")
dropping = bool(state.get("dropping_long_line", False))
if reset_stream == "1":
    pending = b""
    dropping = False
    state["stream_agent_creations"] = 0
    state["done_exit"] = None
    state["barrier_ready"] = False
    state["barrier_released"] = False
data = pending + delta_path.read_bytes()
lines = []
if dropping:
    newline = data.find(b"\n")
    if newline < 0:
        data = b""
    else:
        data = data[newline + 1 :]
        dropping = False
while not dropping:
    newline = data.find(b"\n")
    if newline < 0:
        break
    line = data[:newline]
    data = data[newline + 1 :]
    if len(line) <= 8192:
        lines.append(line.decode("utf-8", errors="replace"))
if not dropping and len(data) > 8192:
    data = b""
    dropping = True

changed = False
task_pattern = re.compile(r"^\s*📋\s+" + re.escape(expected_task) + r":")
budget_pattern = re.compile(
    r"^\s*timeout=disabled \(step budget\), browser_steps≤"
    + re.escape(expected_budget)
    + r","
)
step_pattern = re.compile(
    r"^\[cloudbench \d{2}:\d{2}:\d{2}\] STEP "
    r"(git_sync|env_decode|dep_sync|postgres|stack_launch|services_wait|benchmark)$"
)
full_status = re.compile(
    r"^\s+\.\.\.\s+([A-Z_]+)\s+\|\s+(\d+) agents "
    r"\((\d+) active, (\d+) failed\)\s+\|\s+(\d+) root msgs\s+\|\s+"
    r"([0-9]+(?:\.[0-9]+)?)c\s+\|\s+[0-9]+(?:\.[0-9]+)?s\s*$"
)
root_status = re.compile(
    r"^\s+\.\.\.\s+([A-Z_]+)\s+\((\d+) root msgs, "
    r"[0-9]+(?:\.[0-9]+)?s\)\s*$"
)
done_pattern = re.compile(
    r"^::CLOUDBENCH-DONE:: token=" + re.escape(run_token) + r" exit=([0-9]+)$"
)

steps = set(state.get("steps", []))
if (
    not isinstance(state.get("stream_agent_creations"), int)
    or state["stream_agent_creations"] < 0
    or not isinstance(state.get("max_agent_creations"), int)
    or state["max_agent_creations"] < state["stream_agent_creations"]
):
    raise SystemExit("invalid cloudbench progress identity ordinal")
known_statuses = set((
    "STARTING_UP",
    "ACTIVE",
    "PAUSED",
    "FAILED",
    "COMPLETED",
    "OUT_OF_CREDITS",
    "COST_LIMIT_REACHED",
))
statuses = set(state.get("statuses", []))
if not statuses <= known_statuses:
    raise SystemExit("invalid cloudbench progress status state")
active_ranges = state.get("active_ranges", dict())
if not isinstance(active_ranges, dict) or not set(active_ranges) <= known_statuses:
    raise SystemExit("invalid cloudbench progress active-range state")
if any(
    not isinstance(bounds, list)
    or len(bounds) != 2
    or any(not isinstance(value, int) or value < 0 for value in bounds)
    or bounds[0] > bounds[1]
    for bounds in active_ranges.values()
):
    raise SystemExit("invalid cloudbench progress active-range bounds")
for line in lines:
    if expected_task and not state["task_seen"] and task_pattern.search(line):
        state["task_seen"] = True
        changed = True
    if expected_budget and not state["budget_seen"] and budget_pattern.search(line):
        state["budget_seen"] = True
        changed = True
    step = step_pattern.search(line)
    if step and step.group(1) not in steps:
        steps.add(step.group(1))
        changed = True
    agent = re.search(r"Agent created:\s+([A-Za-z0-9-]+)", line)
    if agent:
        state["stream_agent_creations"] += 1
        if state["stream_agent_creations"] > state["max_agent_creations"]:
            state["max_agent_creations"] = state["stream_agent_creations"]
            changed = True
    status = full_status.search(line)
    if status:
        name = status.group(1)
        if name not in known_statuses:
            continue
        agents, active, failed, messages = map(int, status.group(2, 3, 4, 5))
        cost = float(status.group(6))
        if name not in statuses:
            statuses.add(name)
            changed = True
        bounds = active_ranges.get(name)
        if bounds is None:
            active_ranges[name] = [active, active]
            changed = True
        else:
            if active < bounds[0]:
                bounds[0] = active
                changed = True
            if active > bounds[1]:
                bounds[1] = active
                changed = True
        for key, value in (
            ("max_agents", agents),
            ("max_active", active),
            ("max_failed", failed),
            ("max_root_messages", messages),
            ("max_cost", cost),
        ):
            if value > state[key]:
                state[key] = value
                changed = True
        if state["min_active"] is None or active < state["min_active"]:
            state["min_active"] = active
            changed = True
        continue
    status = root_status.search(line)
    if status:
        name, messages = status.group(1), int(status.group(2))
        if name not in known_statuses:
            continue
        if name not in statuses:
            statuses.add(name)
            changed = True
        if messages > state["max_root_messages"]:
            state["max_root_messages"] = messages
            changed = True
    budget = re.search(r"Browser step budget reached:\s+(\d+)/(\d+)", line)
    if (
        budget
        and expected_budget
        and int(budget.group(2)) == int(expected_budget)
        and int(budget.group(1)) >= int(expected_budget)
        and int(budget.group(1)) > state["max_browser_steps"]
    ):
        state["max_browser_steps"] = int(budget.group(1))
        changed = True
    done = done_pattern.search(line)
    if done:
        state["done_exit"] = int(done.group(1))
    if "synchronized start barrier ready" in line:
        state["barrier_ready"] = True
    if "synchronized start barrier released" in line:
        state["barrier_released"] = True

state["steps"] = sorted(steps)
state["statuses"] = sorted(statuses)
state["active_ranges"] = active_ranges
state["pending_b64"] = base64.b64encode(data).decode()
state["dropping_long_line"] = dropping
temporary = state_path.with_name(f"{state_path.name}.tmp.{os.getpid()}")
temporary.write_text(json.dumps(state, sort_keys=True, separators=(",", ":")) + "\n")
os.replace(temporary, state_path)
attested = bool(state["task_seen"] and state["budget_seen"])
done_exit = "-" if state["done_exit"] is None else str(state["done_exit"])
print(
    f"{int(attested)}|{int(changed and attested)}|{done_exit}|"
    f"{int(state['barrier_ready'])}|{int(state['barrier_released'])}"
)
PY
}

cloudbench_apply_progress_update() {  # <encoded update> <clock seconds>
    local encoded="$1" update_clock="$2"
    local attested_now changed done barrier_ready_now barrier_released_now
    IFS='|' read -r attested_now changed done barrier_ready_now \
        barrier_released_now <<< "$encoded"
    if [[ ! "$attested_now:$changed:$done:$barrier_ready_now:$barrier_released_now" \
        =~ ^[01]:[01]:(-|[0-9]+):[01]:[01]$ ]]; then
        return 1
    fi
    progress_barrier_ready="$barrier_ready_now"
    progress_barrier_released="$barrier_released_now"
    [ "$changed" != "1" ] || last_meaningful_progress="$update_clock"
    [ "$attested_now" != "1" ] || progress_attested="1"
    if [[ "$done" =~ ^[0-9]+$ ]]; then
        terminal_pending_exit="$done"
        [ -n "$terminal_pending_since" ] \
            || terminal_pending_since="$update_clock"
    else
        # The persisted parser repeats a numeric DONE until a validated stream
        # reset clears it. Therefore '-' is authoritative proof that any caller
        # terminal candidate belongs to the replaced generation.
        terminal_pending_exit=""
        terminal_pending_since=""
        terminal_read_failures="0"
    fi
}

# Gate every benchmark deadline on a successful current log read. A bounded
# sequence of transport/contract failures is infrastructure, never semantic
# inactivity. Return 0=current, 10=retry, 20=exhausted.
cloudbench_log_read_gate() {  # <refresh succeeded: 0|1>
    local succeeded="$1"
    case "$succeeded" in
        1)
            log_read_failures="0"
            return 0
            ;;
        0)
            log_read_failures=$((log_read_failures + 1))
            [ "$log_read_failures" -lt "$BENCH_LOG_READ_MAX_FAILURES" ] \
                && return 10
            return 20
            ;;
        *) return 2 ;;
    esac
}

# A driver-health 410 is only a lifecycle seal. The verdict is accepted after
# the bounded log accumulator reaches EOF and still contains this run's exact
# DONE marker. Return 10 for retryable reads and 20 for a sealed malformed log.
cloudbench_collect_terminal_log() {
    local line terminal_prefix candidate
    CURRENT_TERMINAL_EXIT=""
    refresh_bench_log_to_eof 2>/dev/null || return 10
    terminal_prefix="$DONE_MARKER exit="
    while IFS= read -r line; do
        [[ "$line" == "$terminal_prefix"* ]] || continue
        candidate="${line#"$terminal_prefix"}"
        [[ "$candidate" =~ ^[0-9]+$ ]] || continue
        CURRENT_TERMINAL_EXIT="$candidate"
    done < "$SSH_LOG"
    [[ "$CURRENT_TERMINAL_EXIT" =~ ^[0-9]+$ ]] || return 20
    return 0
}

# Pure deadline decision.  Explicit clock inputs keep the policy independently
# testable without sleeping.  Return 0 when the selected watchdog has expired.
cloudbench_watchdog_expired() {
    local mode="$1" now="$2" started_at="$3" last_progress_at="$4"
    local absolute_seconds="$5" progress_stall_seconds="$6"
    if [ "$mode" = "progress" ]; then
        [ $((now - last_progress_at)) -ge "$progress_stall_seconds" ]
    else
        [ $((now - started_at)) -ge "$absolute_seconds" ]
    fi
}

# Standalone maintenance commands read provider inventories directly. Fleet
# children never call these helpers: they receive one O(1) keyed machine record
# from the controller-owned inventory index.
_machines_json() {
    FLY machines list -a "$APP" --json 2>/dev/null || echo '[]'
}

_volumes_json() {
    FLY volumes list -a "$APP" --json 2>/dev/null
}

INVENTORY_LOCAL_CLOCK_EPOCH="$(date +%s)"
INVENTORY_LOCAL_CLOCK_SECONDS="$SECONDS"

_inventory_index_healthy() {
    local pid="${CLOUDBENCH_INVENTORY_OWNER_PID:-}"
    local expected_token="${CLOUDBENCH_INVENTORY_PUBLISHER_TOKEN:-}"
    local health_path="${CLOUDBENCH_INVENTORY_HEALTH:-}"
    local key value publisher_token="" valid_until="" now
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    [ -n "$expected_token" ] && [ -s "$health_path" ] || return 1
    while IFS='=' read -r key value; do
        case "$key" in
            publisher_token) publisher_token="$value" ;;
            valid_until) valid_until="$value" ;;
        esac
    done < "$health_path"
    case "$valid_until" in ''|*[!0-9]*) return 1 ;; esac
    [ "$publisher_token" = "$expected_token" ] || return 1
    now=$((INVENTORY_LOCAL_CLOCK_EPOCH + SECONDS - INVENTORY_LOCAL_CLOCK_SECONDS))
    [ "$valid_until" -ge "$now" ]
}

_machine_record_field() {  # _machine_record_field <id> <field>
    local key value
    _inventory_index_healthy || return 1
    [ -n "${CLOUDBENCH_MACHINE_RECORD:-}" ] || return 1
    [ "$1" = "$FLEET_MACHINE_ID" ] || return 1
    [ -s "$CLOUDBENCH_MACHINE_RECORD" ] || return 1
    while IFS='=' read -r key value; do
        [ "$key" = "$2" ] && { printf '%s' "$value"; return 0; }
    done < "$CLOUDBENCH_MACHINE_RECORD"
    return 1
}

# Resolve the persistent warm machine id from the provider-authoritative name.
# The local state file is only a tie-breaker among exact warm-name matches; it
# must never redirect warm operations to a live pool/ephemeral machine. Fleet
# mode pins an explicit per-bench machine and skips the warm-box state file.
resolve_machine_id() {
    if [ -n "$FLEET_MACHINE_ID" ]; then
        printf '%s' "$FLEET_MACHINE_ID"
        return 0
    fi
    local stored=""
    if [ -f "$STATE_FILE" ]; then
        stored="$(python3 -c 'import json,sys
try: print(json.load(open(sys.argv[1])).get("machine_id",""))
except Exception: print("")' "$STATE_FILE" 2>/dev/null || echo '')"
    fi
    _machines_json | MACHINE_NAME="$MACHINE_NAME" STORED="$stored" python3 -c '
import json,os,sys
try:
    data=json.load(sys.stdin) or []
except Exception:
    data=[]
name=os.environ.get("MACHINE_NAME")
stored=os.environ.get("STORED") or ""
warm=[m for m in data if m.get("name")==name and m.get("id")]
if stored:
    cached=next((m for m in warm if m.get("id")==stored), None)
    if cached:
        print(cached["id"]); sys.exit(0)
if warm:
    print(warm[0]["id"]); sys.exit(0)
print("")
' 2>/dev/null || echo ""
}

machine_state() {  # machine_state <id>
    local id="$1"
    if [ -n "${CLOUDBENCH_MACHINE_RECORD:-}" ]; then
        _machine_record_field "$id" state 2>/dev/null || echo "gone"
        return 0
    fi
    _machines_json | ID="$id" python3 -c '
import json,os,sys
try: data=json.load(sys.stdin) or []
except Exception: data=[]
mid=os.environ.get("ID")
for m in data:
    if m.get("id")==mid:
        print(m.get("state","")); sys.exit(0)
print("gone")
' 2>/dev/null || echo "gone"
}

# A snapshot-backed clone is visible in `created` before its volume restore is
# mountable. Fly rejects start during that window. Machine identity therefore is
# not a startability signal: require every configured volume to reach a state
# Fly documents as mountable before requesting the machine transition.
machine_storage_ready() {  # machine_storage_ready <id>
    # A durable pool slot was already held until both its machine and snapshot
    # volume were mountable, then verified stopped before ledger promotion.
    # Re-reading Machines+Volumes from every one of 30 children recreates the
    # control-plane burst pooling is meant to eliminate.
    [ "${CLOUDBENCH_STORAGE_READY:-0}" = "1" ] && return 0
    if [ -n "${CLOUDBENCH_MACHINE_RECORD:-}" ]; then
        [ "$(_machine_record_field "$1" storage_ready 2>/dev/null || true)" = "1" ]
        return $?
    fi
    local id="$1" machines volumes
    local inventory_timeout="${CLOUDBENCH_STORAGE_QUERY_TIMEOUT:-20}"
    # A single read-only flyctl process can wedge while the same API remains
    # healthy for other callers. Yield to the existing readiness retry instead
    # of holding the synchronized fleet barrier indefinitely.
    machines="$(_with_timeout "$inventory_timeout" flyctl machines list -a "$APP" --json 2>/dev/null)" || return 1
    volumes="$(_with_timeout "$inventory_timeout" flyctl volumes list -a "$APP" --json 2>/dev/null)" || return 1
    python3 "$MACHINE_READINESS_SCRIPT" "$id" \
        <(printf '%s' "$machines") <(printf '%s' "$volumes") >/dev/null
}

write_state() {  # write_state <machine_id>
    # Fleet children target caller-owned ephemeral/pool machines. Recording one
    # as the persistent warm source would make a later controller follow a
    # clone that cleanup is about to destroy.
    [ -n "$FLEET_MACHINE_ID" ] && return 0
    mkdir -p "$ROOT_DIR/.context"
    printf '{"app":"%s","machine_id":"%s","machine_name":"%s","volume_name":"%s","region":"%s"}\n' \
        "$APP" "$1" "$MACHINE_NAME" "$VOLUME_NAME" "$REGION" > "$STATE_FILE"
}

ensure_app() {
    # App-scoped deploy tokens can operate the target app but cannot enumerate
    # every app in the organization.  Treat a successful app-specific Machines
    # API read as authoritative before falling back to the org-wide app list.
    if FLY machines list -a "$APP" --json >/dev/null 2>&1 || FLY apps list --json 2>/dev/null | python3 -c 'import json,sys
apps=json.load(sys.stdin)
names={a.get("Name") or a.get("name") for a in (apps or [])}
sys.exit(0 if "'"$APP"'" in names else 1)' 2>/dev/null; then
        echo "✅ App $APP already exists"
    else
        echo "📦 Creating app $APP ..."
        FLY apps create "$APP" --org personal 2>&1 | sed 's/^/   /' || {
            FLY apps list 2>/dev/null | grep -q "$APP" || { echo "❌ Failed to create app $APP"; exit 1; }
        }
    fi
}

# Prefer a GitHub token that can actually fetch the private rose repo.
# Stale GITHUB_TOKEN values in .env / the ambient environment previously made
# --refresh-deps emit an empty AUTH_HDR and fail with:
#   fatal: could not read Username for 'https://github.com'
# Never return an unvalidated token: an invalid PAT is worse than a missing one
# because callers treat non-empty as "auth is configured".
github_token_can_fetch_repo() {
    local token="$1" cfg header
    [ -n "$token" ] || return 1
    # Validate the operation this token is actually used for. The GitHub REST
    # contents probe used here previously consumes the API rate window; once the
    # shared credential hit that limit, a still-valid Git credential was falsely
    # rejected and --refresh-deps failed before its git fetch. A metadata-only
    # PAT cannot read the private Git remote, so ls-remote preserves the required
    # Contents permission check without depending on REST quota.
    # Keep the PAT out of argv and the ambient git config via a mode-0600 config.
    cfg="$(mktemp)"
    header="$(token_to_git_auth_header "$token")" || {
        rm -f "$cfg"
        return 1
    }
    printf '[http]\n\textraheader = %s\n' "$header" >"$cfg"
    chmod 600 "$cfg"
    if ! (
        trap 'rm -f "$cfg"' EXIT
        trap 'exit 129' HUP
        trap 'exit 130' INT
        trap 'exit 143' TERM
        GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=true \
            GIT_CONFIG_GLOBAL="$cfg" GIT_CONFIG_NOSYSTEM=1 \
            git -c credential.helper= ls-remote --exit-code \
            'https://github.com/Rose-Ai-Labs/rose.git' HEAD >/dev/null 2>&1
    ); then
        rm -f "$cfg"
        return 1
    fi
    rm -f "$cfg"
    return 0
}

# Long-lived token for Fly app secrets. Never use `gh auth token` here — those
# expire and would leave the warm box unable to git-sync after the next hour.
# Try candidates in priority order until one passes Contents validation so an
# invalid DISPATCH value cannot block a later valid GITHUB_TOKEN.
resolve_durable_github_token() {
    local candidates=() t
    t="$(grep -E '^GITHUB_DISPATCH_TOKEN=' back-end/.env 2>/dev/null | head -1 | cut -d= -f2- | sed 's/^["'\'']//; s/["'\'']$//')"
    [ -n "$t" ] && candidates+=("$t")
    t="$(grep -E '^GITHUB_DISPATCH_TOKEN=' agents/.env 2>/dev/null | head -1 | cut -d= -f2- | sed 's/^["'\'']//; s/["'\'']$//')"
    [ -n "$t" ] && candidates+=("$t")
    t="$(grep -E '^GITHUB_TOKEN=' back-end/.env 2>/dev/null | head -1 | cut -d= -f2- | sed 's/^["'\'']//; s/["'\'']$//')"
    [ -n "$t" ] && candidates+=("$t")
    t="$(grep -E '^GITHUB_TOKEN=' agents/.env 2>/dev/null | head -1 | cut -d= -f2- | sed 's/^["'\'']//; s/["'\'']$//')"
    [ -n "$t" ] && candidates+=("$t")
    for t in "${candidates[@]}"; do
        if github_token_can_fetch_repo "$t"; then
            printf '%s' "$t"
            return 0
        fi
    done
    return 1
}

# Resolve a GitHub token that can fetch this private repo for ephemeral
# controller→guest git-sync (refresh-deps SSH snippet, boot-launch env).
# Prefer the controller's live `gh auth token`, then exported GITHUB_TOKEN /
# GH_TOKEN (same order as run-bench-fleet), then long-lived .env tokens via
# resolve_durable_github_token (DISPATCH first). Validate Contents access before
# accepting any candidate. Never print the value.
resolve_github_token() {
    local candidates=() t decoded gh_tok
    if [ -n "${CLOUDBENCH_GITHUB_TOKEN_B64:-}" ]; then
        decoded="$(printf '%s' "$CLOUDBENCH_GITHUB_TOKEN_B64" | base64 -d 2>/dev/null || true)"
        [ -n "$decoded" ] && candidates+=("$decoded")
    fi
    t="$(cloudbench_git_credential_github_token "$ROOT_DIR" 2>/dev/null || true)"
    [ -n "$t" ] && candidates+=("$t")
    # gh prefers ambient GH_TOKEN/GITHUB_TOKEN/GH_HOST over hosts.yml — unset them
    # so a stale env override cannot mask a working CLI login for github.com.
    gh_tok="$(env -u GITHUB_TOKEN -u GH_TOKEN -u GH_HOST gh auth token --hostname github.com 2>/dev/null || true)"
    [ -n "$gh_tok" ] && candidates+=("$gh_tok")
    t="${GITHUB_TOKEN:-${GH_TOKEN:-}}"
    [ -n "$t" ] && candidates+=("$t")
    t="$(resolve_durable_github_token)"
    [ -n "$t" ] && candidates+=("$t")

    for t in "${candidates[@]}"; do
        if github_token_can_fetch_repo "$t"; then
            printf '%s' "$t"
            return 0
        fi
    done
    # Every candidate above can be Andy's one user identity; once its quota is
    # drained none of them can fetch. The token pool's pick adds the org GitHub
    # App (an hourly installation token), so it is tried last and only for this
    # ephemeral controller->guest sync, never as a durable Fly secret.
    if [ -f "$ROOT_DIR/scripts/github_token_pool.py" ]; then
        t="$(cd "$ROOT_DIR" && python3 scripts/github_token_pool.py pick 2>/dev/null || true)"
        if [ -n "$t" ] && github_token_can_fetch_repo "$t"; then
            printf '%s' "$t"
            return 0
        fi
    fi
    return 1
}

# Resolve the CONTROLLER GitHub token into an Authorization Basic header value.
# Fail closed when no token is available — never fall back to an optional empty
# box-side GITHUB_TOKEN secret (that produced `fatal: could not read Username
# for 'https://github.com'` on non-TTY ssh and aborted fleet --refresh-deps).
token_to_git_auth_header() {
    printf 'Authorization: Basic %s' "$(printf 'x-access-token:%s' "$1" | base64 | tr -d '\n')"
}

resolve_controller_git_auth_header() {
    local token
    token="$(resolve_github_token)"
    if [ -z "$token" ]; then
        echo "❌ No controller GitHub token for private-repo git-sync." >&2
        echo "   Set GITHUB_TOKEN in back-end/.env / agents/.env, or authenticate gh." >&2
        return 1
    fi
    token_to_git_auth_header "$token"
}

# Build a remote shell snippet that fetches+checks out $2 inside $1.
# The returned script NEVER embeds the controller token. Delivery must set
# AUTH_HDR (and optional AUTH_HDR_DURABLE) via ssh_exec_controller_git_sync
# stdin, and uses git's GIT_CONFIG_* environment mechanism for http.extraheader
# so credentials never appear in flyctl/ssh/git argv.
build_controller_authenticated_git_sync_cmd() {  # <remote-repo> <ref> [verify-marker]
    local remote_repo="$1" ref="$2" verify_marker="${3:-}"
    # Fail closed early if the controller has no token (same gate as delivery).
    resolve_controller_git_auth_header >/dev/null || return 1
    local repo_q ref_q
    printf -v repo_q '%q' "$remote_repo"
    printf -v ref_q '%q' "$ref"
    local cmd
    cmd="set -e
[ -n \"\${AUTH_HDR:-}\" ] || { echo 'FATAL: missing controller git auth header' >&2; exit 1; }
_try_fetch() {
  export GIT_CONFIG_COUNT=1
  export GIT_CONFIG_KEY_0=http.extraheader
  export GIT_CONFIG_VALUE_0=\"\$1\"
  git -c safe.directory=$repo_q -C $repo_q fetch --quiet origin $ref_q
}
if ! _try_fetch \"\$AUTH_HDR\" 2>/tmp/cloudbench-git-fetch.err; then
  _err=\$(cat /tmp/cloudbench-git-fetch.err 2>/dev/null || true)
  rm -f /tmp/cloudbench-git-fetch.err
  case \"\$_err\" in
    *'could not read Username'*|*'Authentication failed'*|*'Invalid username or password'*|*'403'*|*'401'*)
      if [ -n \"\${AUTH_HDR_DURABLE:-}\" ]; then
        echo 'primary GitHub token auth failed; retrying with durable fallback'
        _try_fetch \"\$AUTH_HDR_DURABLE\"
      else
        printf '%s\\n' \"\$_err\" >&2
        exit 1
      fi
      ;;
    *)
      printf '%s\\n' \"\$_err\" >&2
      exit 1
      ;;
  esac
else
  rm -f /tmp/cloudbench-git-fetch.err
fi
FETCHED_REF=\$(git -c safe.directory=$repo_q -C $repo_q rev-parse FETCH_HEAD)
case $ref_q in
  [0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]*)
    case \"\$FETCHED_REF\" in
      $ref_q*) ;;
      *) echo \"FATAL: FETCH_HEAD \$FETCHED_REF does not match requested SHA $ref_q\" >&2; exit 1 ;;
    esac
    ;;
esac
git -c safe.directory=$repo_q -C $repo_q checkout -f \"\$FETCHED_REF\"
git -c safe.directory=$repo_q -C $repo_q reset --hard
chown -R rose:rose $repo_q 2>/dev/null || true
REMOTE_REF=\$(git -c safe.directory=$repo_q -C $repo_q rev-parse HEAD)
echo checkout \$(printf '%s' \"\$REMOTE_REF\" | cut -c1-8)"
    if [ -n "$verify_marker" ]; then
        # Marker is a controller-owned constant (e.g. ::CLOUDBENCH-REF::).
        case "$verify_marker" in
            *[!A-Za-z0-9:_-]*) echo "❌ invalid git-sync verify marker" >&2; return 1 ;;
        esac
        cmd="$cmd
echo \"${verify_marker}\$REMOTE_REF\""
    fi
    printf '%s' "$cmd"
}

# Deliver a controller git-sync script over SSH without putting the token in
# process arguments. flyctl `ssh console -C` does NOT forward local stdin to the
# remote command (observed hang on `IFS= read -r AUTH_HDR`), so credentials are
# SFTP'd to mode-0600 temp files and the -C argv only names those paths.
# Prefer the primary controller token; on auth failure the remote script retries
# with the durable DISPATCH/GITHUB_TOKEN header when it differs.
ssh_exec_controller_git_sync() {  # <machine_id> <remote-shell-command>
    local mid="$1" sync_cmd="$2" primary durable primary_hdr durable_hdr=""
    local auth_local durable_local cmd_local remote_auth remote_durable remote_cmd
    primary="$(resolve_github_token)"
    [ -n "$primary" ] || {
        echo "❌ No controller GitHub token for private-repo git-sync." >&2
        echo "   Set GITHUB_TOKEN in back-end/.env / agents/.env, or authenticate gh." >&2
        return 1
    }
    primary_hdr="$(token_to_git_auth_header "$primary")"
    durable="$(resolve_durable_github_token)"
    if [ -n "$durable" ] && [ "$durable" != "$primary" ]; then
        durable_hdr="$(token_to_git_auth_header "$durable")"
    fi
    unset primary durable
    auth_local="$(mktemp)"
    durable_local="$(mktemp)"
    cmd_local="$(mktemp)"
    remote_auth="/tmp/cloudbench-git-sync-auth.$$"
    remote_durable="/tmp/cloudbench-git-sync-auth-durable.$$"
    remote_cmd="/tmp/cloudbench-git-sync-cmd.$$"
    printf '%s\n' "$primary_hdr" >"$auth_local"
    printf '%s\n' "$durable_hdr" >"$durable_local"
    printf '%s\n' "$sync_cmd" >"$cmd_local"
    chmod 600 "$auth_local" "$durable_local" "$cmd_local"
    _sftp_put_git_sync() {
        ssh_exec "$mid" "rm -f '$remote_auth' '$remote_durable' '$remote_cmd'" >/dev/null || true
        FLY ssh sftp put -a "$APP" --machine "$mid" -q -m 0600 "$auth_local" "$remote_auth" &&
        FLY ssh sftp put -a "$APP" --machine "$mid" -q -m 0600 "$durable_local" "$remote_durable" &&
        FLY ssh sftp put -a "$APP" --machine "$mid" -q -m 0700 "$cmd_local" "$remote_cmd"
    }
    if ! cloudbench_retry_command \
        "${CLOUDBENCH_GIT_SYNC_SFTP_ATTEMPTS:-5}" \
        "${CLOUDBENCH_GIT_SYNC_SFTP_RETRY_SECONDS:-3}" \
        _sftp_put_git_sync; then
        rm -f "$auth_local" "$durable_local" "$cmd_local"
        echo "❌ failed to upload controller git-sync credentials/script to $mid" >&2
        return 1
    fi
    rm -f "$auth_local" "$durable_local" "$cmd_local"
    # -C argv contains only remote paths — never the Authorization header.
    # Bound hung sessions (dead tunnel / rate-limit) via CLOUDBENCH_SSH_EXEC_TIMEOUT
    # so refresh-deps cannot block fleets indefinitely (descend I-02).
    local -a ssh_cmd=(
        flyctl ssh console -a "$APP" --machine "$mid"
        -C "bash -lc \"IFS= read -r AUTH_HDR < '$remote_auth'; IFS= read -r AUTH_HDR_DURABLE < '$remote_durable'; export AUTH_HDR AUTH_HDR_DURABLE; trap 'rm -f \\'$remote_auth\\' \\'$remote_durable\\' \\'$remote_cmd\\'' EXIT; bash '$remote_cmd'\""
    )
    local sync_rc=0
    if [ -n "${CLOUDBENCH_SSH_EXEC_TIMEOUT:-}" ]; then
        set +e
        _with_timeout "$CLOUDBENCH_SSH_EXEC_TIMEOUT" "${ssh_cmd[@]}"
        sync_rc=$?
        set -e
        if [ "$sync_rc" -eq 124 ]; then
            echo "❌ ssh_exec timed out after ${CLOUDBENCH_SSH_EXEC_TIMEOUT}s" >&2
            return 124
        fi
        return "$sync_rc"
    fi
    "${ssh_cmd[@]}"
}

resolve_render_env_value() {
    local key="$1" api_key service_id response
    api_key="$(cloudbench_env_value back-end/.env RENDER_API_KEY)"
    service_id="$(cloudbench_env_value back-end/.env RENDER_SERVICE_ID)"
    [ -n "$api_key" ] && [ -n "$service_id" ] || {
        echo "FATAL: RENDER_API_KEY and RENDER_SERVICE_ID are required for production env verification" >&2
        return 1
    }
    response="$(curl -fsS --connect-timeout 5 --max-time 15 \
        --retry 2 --retry-delay 1 --retry-all-errors \
        "https://api.render.com/v1/services/$service_id/env-vars/$key" \
        -H "Authorization: Bearer $api_key" -H 'Accept: application/json')" || {
        echo "FATAL: could not read $key from the production Render environment" >&2
        return 1
    }
    printf '%s' "$response" | python3 -c '
import json, sys
item = json.load(sys.stdin)
env = item.get("envVar") or item
print(env.get("value") or "")
'
}

resolve_prod_backend_browser_provider() {
    local provider
    provider="$(resolve_render_env_value BROWSER_PROVIDER)" || return 1
    [ -n "$provider" ] || {
        echo "FATAL: production Render BROWSER_PROVIDER is empty" >&2
        return 1
    }
    printf '%s\n' "$provider"
}

resolve_prod_worker_browser_provider() {
    local machines err
    # The worker fallback marker must come from production, never local source files.
    err="$(mktemp)"
    if machines="$(FLY machines list -a "$PROD_APP" --json 2>"$err")"; then
        rm -f "$err"
        printf '%s' "$machines" | python3 -c '
import json, sys
machines = json.load(sys.stdin) or []
values = [
    str(((machine.get("config") or {}).get("env") or {}).get("BROWSER_PROVIDER") or "").strip().lower()
    for machine in machines
]
if not machines or any(not value for value in values):
    raise SystemExit("FATAL: every production Fly worker must expose BROWSER_PROVIDER")
providers = set(values)
if len(providers) != 1:
    raise SystemExit(f"FATAL: production Fly workers do not expose one BROWSER_PROVIDER: {sorted(providers)!r}")
print(next(iter(providers)))
'
        return
    fi
    cat "$err" >&2 || true
    rm -f "$err"
    echo "FATAL: could not read production Fly worker configuration" >&2
    return 1
}

validate_environment_contract() {
    local prod_backend prod_worker
    prod_backend="$(resolve_prod_backend_browser_provider)" || exit 1
    prod_worker="$(resolve_prod_worker_browser_provider)" || exit 1
    cloudbench_validate_browser_provider_contract \
        agents/.env back-end/.env "$prod_backend" "$prod_worker" || exit 1
    # Refuse to stage a BACKEND_ENV_B64 that cannot run AgentCard payment tasks.
    cloudbench_require_agentcard_org_oauth back-end/.env || exit 1
    CLOUDBENCH_PROD_BROWSER_PROVIDER="$prod_backend"
    CLOUDBENCH_PROD_WORKER_BROWSER_PROVIDER="$prod_worker"
    export CLOUDBENCH_PROD_BROWSER_PROVIDER CLOUDBENCH_PROD_WORKER_BROWSER_PROVIDER
}

machine_state_for_activation() {  # machine_state_for_activation <machine_id>: 0=present, 1=absent, 2=invalid
    local machine_id="$1" machines
    machines="$(FLY machines list -a "$APP" --json 2>/dev/null)" || return 2
    printf '%s' "$machines" | MACHINE_ID="$machine_id" python3 -c '
import json, os, sys
try:
    machines = json.load(sys.stdin)
except (TypeError, ValueError):
    raise SystemExit(2)
if not isinstance(machines, list) or any(not isinstance(machine, dict) for machine in machines):
    raise SystemExit(2)
machine_id = os.environ["MACHINE_ID"]
machine = next((item for item in machines if item.get("id") == machine_id), None)
if machine is None:
    raise SystemExit(1)
print(machine.get("state") or "unknown")
'
}

machine_has_activation_image() {  # machine_has_activation_image <machine_id> <image_ref>
    local machine_id="$1" image_ref="$2" machines
    machines="$(FLY machines list -a "$APP" --json 2>/dev/null)" || return 2
    printf '%s' "$machines" | MACHINE_ID="$machine_id" IMAGE_REF="$image_ref" python3 -c '
import json, os, sys
try:
    machines = json.load(sys.stdin)
except (TypeError, ValueError):
    raise SystemExit(2)
if not isinstance(machines, list) or any(not isinstance(machine, dict) for machine in machines):
    raise SystemExit(2)
machine_id = os.environ["MACHINE_ID"]
machine = next((item for item in machines if item.get("id") == machine_id), None)
if machine is None:
    raise SystemExit(1)
config = machine.get("config") or {}
actual = config.get("image") if isinstance(config, dict) else None
expected = os.environ["IMAGE_REF"]
if not isinstance(actual, str):
    raise SystemExit(1)
if "@" in expected:
    raise SystemExit(0 if actual == expected else 1)
raise SystemExit(0 if actual.split("@", 1)[0] == expected else 1)
'
}

wait_for_activation_image() {  # wait_for_activation_image <machine_id> <image_ref>
    local machine_id="$1" image_ref="$2" state presence attempt=1
    local attempts="${CLOUDBENCH_IMAGE_SETTLE_ATTEMPTS:-15}"
    local retry_delay="${CLOUDBENCH_IMAGE_SETTLE_RETRY_DELAY:-2}"
    while [ "$attempt" -le "$attempts" ]; do
        state="$(machine_state_for_activation "$machine_id")"
        presence=$?
        [ "$presence" -eq 0 ] || return 1
        if [ "$state" = "stopped" ] \
            && machine_has_activation_image "$machine_id" "$image_ref"; then
            return 0
        fi
        case "$state" in
            stopped|created|pending|replacing|stopping) ;;
            *) return 1 ;;
        esac
        [ "$attempt" -lt "$attempts" ] && sleep "$retry_delay"
        attempt=$((attempt + 1))
    done
    return 1
}

activate_machine_environment() {  # activate_machine_environment <machine_id> [warm|pool] [image_ref]
    local machine_id="$1" role="${2:-warm}" image_ref="${3:-}" attempt=1 output status state presence
    local attempts="${CLOUDBENCH_UPDATE_ATTEMPTS:-3}"
    local retry_delay="${CLOUDBENCH_UPDATE_RETRY_DELAY:-2}"
    local -a update_args
    while [ "$attempt" -le "$attempts" ]; do
        state="$(machine_state_for_activation "$machine_id")"
        presence=$?
        if [ "$presence" -eq 1 ]; then
            if [ "$role" = "pool" ]; then
                echo "      pool machine $machine_id disappeared; skipping stale owned entry" >&2
                return 0
            fi
            echo "      warm source $machine_id disappeared before activation" >&2
            return 1
        fi
        [ "$presence" -eq 0 ] || return 1
        if [ "$role" = "pool" ]; then
            case "$state" in
                stopped) ;;
                started|starting) echo "      pool machine $machine_id is $state; skipping concurrently active machine" >&2; return 0 ;;
                *) echo "      pool machine $machine_id has unsafe activation state '$state'" >&2; return 1 ;;
            esac
        elif [ "$role" = "warm" ]; then
            [ "$state" = "stopped" ] || {
                echo "      warm source $machine_id must be stopped for strict environment activation (state=$state)" >&2
                return 1
            }
        else
            echo "      unknown environment activation role '$role'" >&2
            return 1
        fi
        assert_app_environment_lock_ownership || return 1
        update_args=(machine update "$machine_id" -a "$APP")
        [ -n "$image_ref" ] && update_args+=(--image "$image_ref")
        update_args+=(--skip-start --yes)
        output="$(FLY "${update_args[@]}" 2>&1)"
        status=$?
        printf '%s\n' "$output" | sed 's/^/      /'
        [ "$status" -eq 0 ] && return 0
        if [ -n "$image_ref" ] \
            && wait_for_activation_image "$machine_id" "$image_ref"; then
            echo "      Fly CLI reported failure, but provider confirms desired image on stopped machine"
            return 0
        fi
        if [ "$role" = "pool" ]; then
            state="$(machine_state_for_activation "$machine_id")"
            presence=$?
            if [ "$presence" -eq 1 ]; then
                echo "      pool machine $machine_id disappeared during activation; skipping" >&2
                return 0
            fi
            [ "$presence" -eq 0 ] || return 1
            case "$state" in
                stopped) ;;
                started|starting) echo "      pool machine $machine_id became $state during activation; skipping concurrent owner" >&2; return 0 ;;
                *) echo "      pool machine $machine_id reached unsafe activation state '$state'" >&2; return 1 ;;
            esac
        fi
        if [ "$attempt" -ge "$attempts" ] || ! printf '%s' "$output" \
            | grep -qiE '(^|[^[:alnum:]])(408|429|5[0-9][0-9])([^[:alnum:]]|$)|timed? out|timeout|context deadline|connection reset|unexpected EOF|temporar(y|ily)'; then
            return "$status"
        fi
        echo "      transient Fly update failure; retrying machine $machine_id ($attempt/$attempts)" >&2
        sleep "$retry_delay"
        attempt=$((attempt + 1))
    done
    return 1
}

environment_activation_targets() {  # warm source + this workspace's declared pool only
    local machines pool_ids=""
    machines="$(FLY machines list -a "$APP" --json 2>/dev/null)" || return 2
    [ -f "$POOL_IDS_FILE" ] && pool_ids="$(grep -E '^[0-9a-f]+$' "$POOL_IDS_FILE" 2>/dev/null || true)"
    printf '%s' "$machines" | MACHINE_NAME="$MACHINE_NAME" POOL_IDS="$pool_ids" python3 -c '
import json, os, sys
try:
    machines = json.load(sys.stdin)
except (TypeError, ValueError):
    raise SystemExit(2)
if not isinstance(machines, list) or any(not isinstance(machine, dict) for machine in machines):
    raise SystemExit(2)
machine_name = os.environ["MACHINE_NAME"]
warm = [machine for machine in machines if machine.get("name") == machine_name]
if len(warm) != 1 or not warm[0].get("id"):
    raise SystemExit("expected exactly one warm source named %r" % machine_name)
print("warm", warm[0]["id"], sep="\t")
pool_ids = set(os.environ.get("POOL_IDS", "").split())
for machine in machines:
    machine_id = machine.get("id")
    if machine_id in pool_ids and machine_id != warm[0]["id"]:
        print("pool", machine_id, sep="\t")
'
}

activate_owned_machine_images() {  # activate_owned_machine_images <image_ref>
    local image_ref="$1" activation_targets role machine_id
    activation_targets="$(environment_activation_targets)" || return 1
    while IFS=$'\t' read -r role machine_id; do
        [ -n "$machine_id" ] || continue
        echo "   activating image on $role machine $machine_id (skip-start)"
        activate_machine_environment "$machine_id" "$role" "$image_ref" || return 1
    done <<< "$activation_targets"
}

# Inject the two base64 .env blobs + GITHUB_TOKEN as active Fly secrets (present
# on machine init + in ssh sessions). The benchmark app uses the Machines API,
# not Fly Launch releases: stage app secrets, then update each stopped machine
# with --skip-start so staged-only values can never be mistaken for active ones.
# GITHUB_TOKEN is injected as a secret so the on-box per-run git-sync (private
# repo) can authenticate via git http.extraheader without the token ever being
# stored in .git/config on the volume.
_inject_secrets_locked() {
    echo "🔐 Injecting secrets into $APP ..."
    if [ ! -f agents/.env ] || [ ! -f back-end/.env ]; then
        echo "❌ agents/.env and back-end/.env are required to inject secrets." >&2
        exit 1
    fi
    validate_environment_contract
    local agents_b64 backend_b64 gh_token agents_sha backend_sha
    local agents_src=agents/.env backend_src=back-end/.env
    local guest_temporal_override guest_env_dir="" guest_temporal_namespace=""
    # Guest-only Temporal namespace (see cloudbench_guest_temporal_override_file):
    # the staged blobs get the override; local and production env files do not.
    guest_temporal_override="$(cloudbench_guest_temporal_override_file agents/.env)" || exit 1
    if [ -n "$guest_temporal_override" ]; then
        guest_env_dir="$(mktemp -d "${TMPDIR:-/tmp}/cloudbench-guest-env.XXXXXX")" || exit 1
        if ! guest_temporal_namespace="$(cloudbench_write_guest_temporal_env_files \
                agents/.env back-end/.env "$guest_temporal_override" "$guest_env_dir")"; then
            rm -rf "$guest_env_dir"
            exit 1
        fi
        agents_src="$guest_env_dir/agents.env"
        backend_src="$guest_env_dir/backend.env"
        echo "   guest Temporal namespace override: $guest_temporal_namespace (guest copies only; from $guest_temporal_override)"
    else
        echo "   guest Temporal namespace: unchanged from agents/.env (no .env.benchmark-temporal override)"
    fi
    if ! cloudbench_require_staged_guest_temporal_namespace "$APP" "$guest_temporal_override" \
            "$agents_src" "$backend_src"; then
        [ -z "$guest_env_dir" ] || rm -rf "$guest_env_dir"
        exit 1
    fi
    agents_b64="$(base64 < "$agents_src" | tr -d '\n')"
    backend_b64="$(base64 < "$backend_src" | tr -d '\n')"
    agents_sha="$(cloudbench_env_sha256 "$agents_src")"
    backend_sha="$(cloudbench_env_sha256 "$backend_src")"
    local agents_lines backend_lines
    agents_lines="$(wc -l < "$agents_src" | tr -d ' ')"
    backend_lines="$(wc -l < "$backend_src" | tr -d ' ')"
    [ -z "$guest_env_dir" ] || rm -rf "$guest_env_dir"
    if [ -z "$agents_b64" ] || [ -z "$backend_b64" ] || [ -z "$agents_sha" ] || [ -z "$backend_sha" ]; then
        echo "❌ Could not encode the benchmark guest env files." >&2
        exit 1
    fi
    # Fly secrets need a durable token (gh auth expires). resolve_durable_*
    # already Contents-validates candidates in priority order.
    gh_token="$(resolve_durable_github_token)" || gh_token=""
    echo "   env provenance: Render backend + Fly workers → backend=$CLOUDBENCH_PROD_BROWSER_PROVIDER worker=$CLOUDBENCH_PROD_WORKER_BROWSER_PROVIDER"
    echo "   agents/.env sha256=${agents_sha:0:12} ($agents_lines lines)"
    echo "   back-end/.env sha256=${backend_sha:0:12} ($backend_lines lines)"
    local -a set_args=(
        "AGENTS_ENV_B64=$agents_b64"
        "BACKEND_ENV_B64=$backend_b64"
        "AGENTS_ENV_SHA256=$agents_sha"
        "BACKEND_ENV_SHA256=$backend_sha"
        "CLOUDBENCH_BROWSER_PROVIDER=$CLOUDBENCH_PROD_BROWSER_PROVIDER"
        "CLOUDBENCH_WORKER_BROWSER_PROVIDER=$CLOUDBENCH_PROD_WORKER_BROWSER_PROVIDER"
    )
    # Always stage GITHUB_TOKEN= so a missing/invalid durable candidate clears any
    # previously staged stale credential while preserving the required secret name.
    set_args+=("GITHUB_TOKEN=$gh_token")
    if [ -n "$gh_token" ]; then
        echo "   GITHUB_TOKEN present (durable + Contents-validated for private-repo git-sync)"
    else
        echo "   ⚠️  No validated durable GitHub token — staging empty GITHUB_TOKEN to clear stale secret"
    fi
    assert_app_environment_lock_ownership || exit 1
    FLY secrets set --stage -a "$APP" "${set_args[@]}" 2>&1 | sed 's/^/   /' || {
        echo "❌ Failed to stage benchmark environment secrets"; exit 1
    }
    local activation_targets role machine_id
    activation_targets="$(environment_activation_targets)" || {
        echo "❌ Could not resolve owned benchmark machines for environment activation." >&2
        exit 1
    }
    while IFS=$'\t' read -r role machine_id; do
        [ -n "$machine_id" ] || continue
        assert_app_environment_lock_ownership || exit 1
        echo "   activating env on $role machine $machine_id (skip-start)"
        activate_machine_environment "$machine_id" "$role" || {
            echo "❌ Failed to activate environment on machine $machine_id" >&2
            exit 1
        }
    done <<< "$activation_targets"
    mkdir -p "$ROOT_DIR/.context"
    python3 - "$ROOT_DIR/.context/cloudbench-env-manifest.json" \
        "$agents_sha" "$backend_sha" "$CLOUDBENCH_PROD_BROWSER_PROVIDER" \
        "$CLOUDBENCH_PROD_WORKER_BROWSER_PROVIDER" "$guest_temporal_namespace" <<'PY'
import json, sys
path, agents_sha, backend_sha, provider, worker_provider, guest_namespace = sys.argv[1:]
overrides = ["DATABASE_URL", "DIRECT_URL", "BACKEND_API_URL", "TEMPORAL_TASK_QUEUE", "ports", "workspace"]
if guest_namespace:
    overrides += ["TEMPORAL_ADDRESS", "TEMPORAL_NAMESPACE", "TEMPORAL_API_KEY"]
with open(path, "w") as handle:
    json.dump({
        "agents_env_sha256": agents_sha,
        "backend_env_sha256": backend_sha,
        "browser_provider": provider,
        "worker_browser_provider": worker_provider,
        "guest_temporal_namespace": guest_namespace or None,
        "production_sources": {
            "backend": "render:Navi",
            "worker": "fly:navi-whisper-lux",
        },
        "isolation_overrides": overrides,
    }, handle, indent=2)
    handle.write("\n")
PY
    echo "✅ Secrets set (active)"
}

inject_secrets() {
    acquire_app_environment_lock || exit 1
    # Setup owns donor maintenance. A canceled refresh may have left it live;
    # quiesce that exact named donor before strict skip-start env activation.
    if [ "${MODE:-}" = setup ] && [ -n "$(resolve_machine_id)" ]; then
        local setup_targets setup_role setup_machine setup_state
        setup_targets="$(environment_activation_targets)" || {
            release_app_environment_lock; exit 1
        }
        while IFS=$'\t' read -r setup_role setup_machine; do
            [ "$setup_role" = warm ] || continue
            assert_app_environment_lock_ownership || {
                release_app_environment_lock; exit 1
            }
            setup_state="$(machine_state_for_activation "$setup_machine")" || {
                release_app_environment_lock; exit 1
            }
            if [ "$setup_state" != stopped ]; then
                stop_machine_strict "$setup_machine" || {
                    release_app_environment_lock; exit 1
                }
            fi
        done <<< "$setup_targets"
    fi
    ( _inject_secrets_locked )
    local status=$?
    if [ "$status" -eq 0 ] && [ "${CLOUDBENCH_HOLD_APP_ENV_LOCK:-0}" = "1" ]; then
        return 0
    fi
    release_app_environment_lock
    [ "$status" -eq 0 ] || exit "$status"
    return "$status"
}

# READ-ONLY env preflight for every RUN path: assert the prod-aligned app
# secrets exist WITHOUT staging or activating anything, so concurrent
# workstreams never race each other's environment. Staging/activation lives
# only in the explicit maintenance ops (--refresh-secrets/--setup/--refresh-wmh).
#
# GITHUB_TOKEN must be present as an app secret name (on-box decode / legacy
# paths). refresh-deps does NOT rely on that secret being non-empty in SSH —
# it injects a controller-resolved token (gh auth / DISPATCH) into the sync
# command — because Fly Status=Staged can persist on Machines-only apps even
# after machine update, and a stale GITHUB_TOKEN secret may be empty or 401.
REQUIRED_APP_SECRETS="AGENTS_ENV_B64 BACKEND_ENV_B64 AGENTS_ENV_SHA256 BACKEND_ENV_SHA256 CLOUDBENCH_BROWSER_PROVIDER CLOUDBENCH_WORKER_BROWSER_PROVIDER GITHUB_TOKEN"
verify_app_environment() {
    local listing missing read_status
    listing="$(FLY secrets list -a "$APP" --json)" || {
        read_status=$?
        echo "❌ Could not read app secrets for $APP (read exit=$read_status)." >&2
        echo "   One-time setup: bash scripts/run-bench-cloud --setup" >&2
        return 1
    }
    if ! missing="$(printf '%s' "$listing" | REQUIRED="$REQUIRED_APP_SECRETS" python3 -c '
import json, os, sys
try:
    secrets = json.load(sys.stdin) or []
except Exception:
    raise SystemExit("unreadable secrets listing")
names = {str(item.get("Name") or item.get("name") or "") for item in secrets if isinstance(item, dict)}
print(" ".join(key for key in os.environ["REQUIRED"].split() if key not in names))
')"; then
        echo "❌ Unreadable app secrets listing for $APP." >&2
        return 1
    fi
    if [ -n "$missing" ]; then
        echo "❌ Benchmark app environment is missing secrets: $missing" >&2
        echo "   Refresh explicitly (maintenance op): bash scripts/run-bench-cloud --refresh-secrets" >&2
        return 1
    fi
    echo "✅ Shared benchmark app environment verified (read-only): $REQUIRED_APP_SECRETS"
}

if [ "$MODE" = "verify-secrets" ]; then
    verify_app_environment
    exit $?
fi

if [ "$MODE" = "refresh-secrets" ]; then
    echo "═══ run-bench-cloud --refresh-secrets ═══"
    refresh_lock="$ROOT_DIR/.context/cloudbench-controller.lock"
    if ! cloudbench_controller_lock_acquire "$refresh_lock"; then
        old_pid="$(cat "$refresh_lock" 2>/dev/null || true)"
        echo "❌ Another cloud benchmark controller is already running in this workspace${old_pid:+ (pid $old_pid)}." >&2
        exit 1
    fi
    cleanup_refresh_lock() {
        cloudbench_controller_lock_release "$refresh_lock"
    }
    trap cleanup_refresh_lock EXIT
    trap 'cleanup_refresh_lock; exit 130' INT
    trap 'cleanup_refresh_lock; exit 143' TERM
    ensure_app
    inject_secrets
    echo "✅ Cloud benchmark environment refreshed from current production-aligned sources."
    exit 0
fi

# Checkout an exact SHA on the shared warm volume using the same controller
# token + cloudbench-fetch-ref.sh path guest drivers already use. Never fall
# back to optional box-side $GITHUB_TOKEN: an empty token makes `git fetch`
# prompt for a username over HTTPS and abort the fleet before any task starts.
warm_source_fetch_ref() {  # warm_source_fetch_ref <machine-id> <sha>
    local mid="$1" sha="$2" token token_b64 sync_log remote_ref token_local remote_token
    # Contents-validated resolver (same gate as --setup / refresh-deps) — never
    # an unvalidated hosts.yml / url.insteadOf token that later 401s on fetch.
    token="$(resolve_github_token)" || token=""
    [ -n "$token" ] || {
        echo "❌ No controller GitHub token for warm-source git-sync." >&2
        return 1
    }
    token_b64="$(printf '%s' "$token" | base64 | tr -d '\n')"
    token_local="$(mktemp)"
    remote_token="/tmp/cloudbench-warm-fetch-token.$$"
    printf '%s' "$token_b64" >"$token_local"
    chmod 600 "$token_local"
    _sftp_put_fetch_ref() {
        # flyctl sftp will not overwrite; each attempt must start from a clean dest.
        ssh_exec "$mid" "rm -f /data/cloudbench-fetch-ref.sh '$remote_token'" >/dev/null || true
        FLY ssh sftp put -a "$APP" --machine "$mid" -q -m 0755 \
            "$CLOUDBENCH_GUEST_FETCH_REF_SCRIPT" /data/cloudbench-fetch-ref.sh &&
        FLY ssh sftp put -a "$APP" --machine "$mid" -q -m 0600 \
            "$token_local" "$remote_token"
    }
    # Guest driver staging already retries sftp (CLOUDBENCH_STAGE_ATTEMPTS). A
    # single Fly API "tunnel unavailable / context deadline exceeded" here used
    # to abort the whole fleet before any task machine started.
    if ! cloudbench_retry_command \
        "${CLOUDBENCH_WARM_FETCH_REF_SFTP_ATTEMPTS:-5}" \
        "${CLOUDBENCH_WARM_FETCH_REF_SFTP_RETRY_SECONDS:-3}" \
        _sftp_put_fetch_ref; then
        rm -f "$token_local"
        echo "❌ failed to upload cloudbench-fetch-ref.sh to $mid" >&2
        return 1
    fi
    rm -f "$token_local"
    sync_log="$(mktemp)"
    # Controller-side bound must outlast guest fetch work but still fail closed
    # when flyctl hangs after a mid-sync machine stop (descend I-07).
    # -C argv names only remote paths — never the token bytes (main).
    GIT_SYNC_TO="${CLOUDBENCH_GIT_SYNC_TIMEOUT:-240}"
    local sync_rc=0
    set +e
    ssh_exec "$mid" "set -e
trap 'rm -f $remote_token' EXIT
export CLOUDBENCH_GITHUB_TOKEN_B64=\$(cat '$remote_token')
export CLOUDBENCH_APP_USER=rose
bash /data/cloudbench-fetch-ref.sh '$REMOTE_REPO' '$sha'
REMOTE_REF=\$(git -c safe.directory='$REMOTE_REPO' -C '$REMOTE_REPO' rev-parse HEAD)
echo checkout \$(printf '%s' \"\$REMOTE_REF\" | cut -c1-8)
echo \"::CLOUDBENCH-REF::\$REMOTE_REF\"" "$GIT_SYNC_TO" 2>&1 | grep -av '^Connecting to' | tee "$sync_log" | sed 's/^/   /'
    sync_rc=${PIPESTATUS[0]}
    set -e
    if [ "$sync_rc" -ne 0 ]; then
        rm -f "$sync_log"
        echo "❌ exact remote checkout failed (ssh_exec timed out or remote error; bound=${GIT_SYNC_TO}s)" >&2
        return "$sync_rc"
    fi
    remote_ref="$(sed -n 's/^::CLOUDBENCH-REF:://p' "$sync_log" | tail -1)"
    rm -f "$sync_log"
    if [ "$remote_ref" != "$sha" ]; then
        echo "❌ remote checkout mismatch: expected $sha, got ${remote_ref:-<missing>}" >&2
        return 1
    fi
    return 0
}

# Apply exactly the fleet's workspace after fetching its reachable base. Keep
# staging outside the checkout, validate bytes on BOTH sides, and clean only this
# maintenance invocation's files. The caller holds the shared warm-source lease.
warm_source_apply_patch() {  # <machine-id> <patch-file> <pinned-sha256>
    local mid="$1" patch="$2" digest="$3"
    local remote_dir="${REMOTE_REPO%/*}/cloudbench-warm-patch.$$"
    [ -s "$patch" ] && [ -n "$digest" ] \
        && [ "$(cloudbench_env_sha256 "$patch")" = "$digest" ] || {
        echo "❌ warm workspace patch checksum mismatch" >&2
        return 1
    }
    _sftp_put_warm_patch() {
        ssh_exec "$mid" "mkdir -p '$remote_dir'; rm -f '$remote_dir/workspace.diff' '$remote_dir/prepare.sh'" >/dev/null &&
        FLY ssh sftp put -a "$APP" --machine "$mid" -q -m 0600 \
            "$patch" "$remote_dir/workspace.diff" &&
        FLY ssh sftp put -a "$APP" --machine "$mid" -q -m 0700 \
            "$CLOUDBENCH_GUEST_PREPARE_PATCH_SCRIPT" "$remote_dir/prepare.sh"
    }
    if ! cloudbench_retry_command \
        "${CLOUDBENCH_WARM_FETCH_REF_SFTP_ATTEMPTS:-5}" \
        "${CLOUDBENCH_WARM_FETCH_REF_SFTP_RETRY_SECONDS:-3}" _sftp_put_warm_patch; then
        ssh_exec "$mid" "rm -f '$remote_dir/workspace.diff' '$remote_dir/prepare.sh'; rmdir '$remote_dir'" >/dev/null || true
        echo "❌ failed to upload the pinned warm workspace patch" >&2
        return 1
    fi
    ssh_exec "$mid" "set -e
trap 'rm -f \"$remote_dir/workspace.diff\" \"$remote_dir/prepare.sh\"; rmdir \"$remote_dir\"' EXIT
actual=\$(sha256sum '$remote_dir/workspace.diff' | cut -d ' ' -f1)
[ \"\$actual\" = '$digest' ] || { echo 'FATAL: warm workspace patch checksum mismatch' >&2; exit 1; }
export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0='$REMOTE_REPO'
bash '$remote_dir/prepare.sh' '$REMOTE_REPO' '$remote_dir/workspace.diff'
git -c safe.directory='$REMOTE_REPO' -C '$REMOTE_REPO' apply --check '$remote_dir/workspace.diff'
git -c safe.directory='$REMOTE_REPO' -C '$REMOTE_REPO' apply '$remote_dir/workspace.diff'" "${CLOUDBENCH_REFRESH_DEPS_SSH_TIMEOUT:-300}"
}

# SSH-exec a shell snippet on the machine, streaming output.
# $1 = machine id, $2 = remote shell command, $3 = optional timeout seconds
# (default CLOUDBENCH_SSH_EXEC_TIMEOUT or 1800). Always bound via _with_timeout:
# unbounded `flyctl ssh console` hung 10+ minutes after warm stop mid git-sync
# (descend wait-for-trigger I-07).
ssh_exec() {  # ssh_exec <machine_id> <remote-shell-command> [timeout_secs]
    # base64 the command instead of printf %q: a multi-line command quotes to
    # $'set -e\n...', which the remote `-C` shell (not guaranteed bash) does not
    # expand — the literal $'...' reaches `bash -lc` and fails (observed: heal
    # git-sync/sync-deps SSH commands failing while the same commands run fine
    # by hand). base64 has no shell-special bytes, so it survives any shell.
    local id="$1" cmd="$2" to="${3:-${CLOUDBENCH_SSH_EXEC_TIMEOUT:-1800}}"
    cmd="$(cloudbench_namespace_command "$id" "$cmd")" || return 1
    local b64
    b64="$(printf '%s' "$cmd" | base64 | tr -d '\n')"
    # Always bound (descend I-07). Use flyctl not FLY: _with_timeout/Popen
    # cannot resolve shell functions/aliases.
    _with_timeout "$to" flyctl ssh console -a "$APP" --machine "$id" \
        -C "bash -lc \"printf %s $b64 | base64 -d | bash -l\""
}

# Retry-wrapped, QUIET ssh -C read. `flyctl ssh console -C` buffers stdout until
# the session ends and can transiently fail (network blip, machine mid-start), so
# every poll read is retried a few times. Returns the remote stdout on stdout;
# returns non-zero only if every attempt failed. $1=machine id, $2=remote command.
# Hard timeout wrapper (macOS has no `timeout`). Own the child process explicitly:
# SIGALRM is not a reliable contract across exec (a stopped-machine flyctl SSH
# ignored it for 2h22m), which prevented the outer run deadline from being read.
_with_timeout() {  # _with_timeout <secs> <cmd> [args...]
    local mutation_launch_code=""
    [ "${BOOT_CONFIG_UPDATE_SLOT_SHARED:-0}" != 1 ] || mutation_launch_code="$(cloudbench_mutation_launch_code)"
    CLOUDBENCH_TIMEOUT_NATIVE_LAUNCH_CODE="$mutation_launch_code" \
    CLOUDBENCH_TIMEOUT_NATIVE_MUTATION="${BOOT_CONFIG_UPDATE_SLOT_SHARED:-0}" \
    CLOUDBENCH_TIMEOUT_NATIVE_LEASE="${BOOT_CONFIG_UPDATE_SLOT:-}" \
    CLOUDBENCH_TIMEOUT_NATIVE_OWNER_PID="$$" \
    CLOUDBENCH_TIMEOUT_NATIVE_OWNER_START="${MUTATION_OWNER_PID_START:-}" \
    CLOUDBENCH_TIMEOUT_NATIVE_ROOT="${CLOUDBENCH_CAPACITY_RESERVATION_ROOT:-${TMPDIR:-/tmp}/rose-cloudbench-capacity-${APP:-}}" \
    CLOUDBENCH_TIMEOUT_NATIVE_APP="${APP:-}" \
    CLOUDBENCH_TIMEOUT_NATIVE_HELPER="${CLOUDBENCH_RUNTIME_SCRIPT_ROOT:-}/cloudbench-campaign-mutation.py" python3 -c '
import os, signal, subprocess, sys

timeout = float(sys.argv[1])
guarded = os.environ.get("CLOUDBENCH_TIMEOUT_NATIVE_MUTATION") == "1"
interrupted = None
proc = None

def native_receipt(action):
    if guarded:
        subprocess.run([sys.executable, "-c", os.environ["CLOUDBENCH_TIMEOUT_NATIVE_LAUNCH_CODE"],
            os.environ["CLOUDBENCH_TIMEOUT_NATIVE_HELPER"], action,
            "--app", os.environ["CLOUDBENCH_TIMEOUT_NATIVE_APP"],
            "--root", os.environ["CLOUDBENCH_TIMEOUT_NATIVE_ROOT"],
            "--owner-pid", os.environ["CLOUDBENCH_TIMEOUT_NATIVE_OWNER_PID"],
            "--owner-start", os.environ["CLOUDBENCH_TIMEOUT_NATIVE_OWNER_START"],
            "--lease", os.environ["CLOUDBENCH_TIMEOUT_NATIVE_LEASE"],
            "--native-owner-pid", str(os.getpid())], check=True)

def joined_receipt():
    # Tell the caller this attempt reaped its child and wrote join-native;
    # its exit status alone cannot distinguish that from an unjoined one.
    path = os.environ.get("CLOUDBENCH_TIMEOUT_NATIVE_JOIN_RECEIPT")
    if path:
        os.close(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600))

native_receipt("start-native")
if guarded:
    def stop(signum, _frame):
        global interrupted
        interrupted = signum
        raise InterruptedError()
    for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(signum, stop)
try:
    proc = subprocess.Popen(sys.argv[2:])
    rc = proc.wait(timeout=timeout)
except (subprocess.TimeoutExpired, InterruptedError):
    if interrupted is not None:
        for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            signal.signal(signum, signal.SIG_IGN)
    # An interruption inside Popen has no proven child handle. Retain the
    # unjoined lease instead of asserting that a native mutation was drained.
    if proc is None:
        raise SystemExit(128 + interrupted if interrupted is not None else 124)
    proc.terminate()
    try:
        proc.wait(timeout=1)
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.wait()
    native_receipt("join-native")
    joined_receipt()
    raise SystemExit(128 + interrupted if interrupted is not None else 124)
native_receipt("join-native")
joined_receipt()
raise SystemExit(rc if rc >= 0 else 128 - rc)
' "$@"
}

ssh_read() {  # ssh_read <machine_id> <remote-shell-command>
    local id="$1" cmd="$2" out="" tries="${SSH_READ_TRIES:-3}"
    local to="${SSH_READ_TIMEOUT:-60}"
    cmd="$(cloudbench_namespace_command "$id" "$cmd")" || return 1
    local n=0
    while [ "$n" -lt "$tries" ]; do
        if out="$(_with_timeout "$to" flyctl ssh console -a "$APP" --machine "$id" \
                    -C "bash -lc $(printf '%q' "$cmd")" 2>/dev/null \
                  | grep -av '^Connecting to')"; then
            printf '%s' "$out"
            return 0
        fi
        n=$((n + 1))
        sleep 2
    done
    return 1
}

# True (0) iff Fly reports the machine started AND a trivial ssh command returns R.
# Used to gate the run start: warm ~10s, cold pull can take minutes.
ssh_ready() {  # ssh_ready <machine_id>
    local id="$1"
    [ "$(machine_state "$id")" = "started" ] || return 1
    local r
    r="$(ssh_read "$id" 'echo R' 2>/dev/null || true)"
    [ "$(printf '%s' "$r" | tr -d '[:space:]')" = "R" ]
}

# Start the machine and wait until Fly reports it "started".
start_machine() {  # start_machine <id>
    local id="$1" st now last_start_ts=0
    local attempts="${CLOUDBENCH_MACHINE_START_ATTEMPTS:-60}"
    local nap="${CLOUDBENCH_MACHINE_START_SLEEP_SECONDS:-2}"
    st="$(machine_state "$id")"
    if [ "$st" = "started" ]; then
        echo "✅ Machine $id already started"
        return 0
    fi
    echo "▶️  Starting machine $id ..."
    for _ in $(seq 1 "$attempts"); do
        st="$(machine_state "$id")"
        [ "$st" = "started" ] && { echo "✅ Machine started"; return 0; }
        [ "$st" = "gone" ] && { echo "❌ Machine $id disappeared while starting"; return 1; }
        # A start issued while Fly still reports stopping/replacing fails with
        # failed_precondition and leaves require_machine_ready racing itself
        # (observed: start error → false progress → SSH wait on stopped donor).
        case "$st" in
            stopping|replacing|starting)
                sleep "$nap"
                continue
                ;;
        esac
        now="$(date +%s)"
        if machine_storage_ready "$id" \
            && { [ "$last_start_ts" -eq 0 ] || [ $((now - last_start_ts)) -ge 20 ]; }; then
            request_machine_start "$id" || true
            last_start_ts="$now"
        fi
        sleep "$nap"
    done
    # FAILS CLOSED. This used to warn and `return 0` on the theory that "SSH will
    # retry" — but wait_for_ssh also returned 0 on exhaustion, so both gates were
    # optimistic and the run died later with a misleading error.
    echo "❌ Machine $id did not report 'started' after $attempts attempts (state=$st)" >&2
    return 1
}

# Stop the machine (keep it + volume). Safe default on every per-run exit path.
stop_machine() {  # stop_machine <id>
    local id="$1"
    [ -z "$id" ] && return 0
    echo "⏹️  Stopping machine $id (kept; volume retained; idle cost ~0) ..."
    FLY machine stop "$id" -a "$APP" 2>&1 | sed 's/^/   /' || true
}

# Snapshot maintenance is different from best-effort exit cleanup: the volume
# must be proven quiescent before it can be published as a dependency source.
stop_machine_strict() {  # stop_machine_strict <id>
    local id="$1" st=""
    [ -n "$id" ] || { echo "❌ cannot strictly stop an empty machine id" >&2; return 1; }
    echo "⏹️  Stopping machine $id and proving the volume is quiescent ..."
    if ! FLY machine stop "$id" -a "$APP" 2>&1 | sed 's/^/   /'; then
        echo "❌ stop request failed for maintenance machine $id" >&2
        return 1
    fi
    for _ in $(seq 1 "${CLOUDBENCH_MAINTENANCE_STOP_ATTEMPTS:-60}"); do
        st="$(machine_state "$id")"
        [ "$st" = "stopped" ] && { echo "✅ Machine stopped (snapshot-safe)"; return 0; }
        [ "$st" = "gone" ] && { echo "❌ maintenance machine $id disappeared while stopping" >&2; return 1; }
        sleep 2
    done
    echo "❌ maintenance machine $id did not reach stopped state (state=${st:-unknown})" >&2
    return 1
}

resize_stopped_warm_source() {  # resize_stopped_warm_source <id> <size> <memory> <purpose>
    local id="$1" size="$2" memory="$3" purpose="$4" state
    local attempt=1 max_attempts retry_delay this_delay cap update_out update_rc
    local lease_attempts="${CLOUDBENCH_WARM_RESIZE_LEASE_ATTEMPTS:-8}"
    local lease_delay="${CLOUDBENCH_WARM_RESIZE_LEASE_RETRY_SECONDS:-15}"
    [ -n "$id" ] || return 0
    max_attempts="${CLOUDBENCH_WARM_RESIZE_ATTEMPTS:-6}"
    retry_delay="${CLOUDBENCH_WARM_RESIZE_RETRY_SECONDS:-8}"
    cap="${CLOUDBENCH_WARM_RESIZE_RETRY_MAX_SECONDS:-90}"
    if ! [[ "$lease_attempts" =~ ^[1-9][0-9]*$ ]]; then
        echo "❌ CLOUDBENCH_WARM_RESIZE_LEASE_ATTEMPTS must be a positive integer (got: ${lease_attempts})" >&2
        return 1
    fi
    if ! [[ "$lease_delay" =~ ^[1-9][0-9]*$ ]]; then
        echo "❌ CLOUDBENCH_WARM_RESIZE_LEASE_RETRY_SECONDS must be a positive integer (got: ${lease_delay})" >&2
        return 1
    fi
    if ! [[ "$max_attempts" =~ ^[1-9][0-9]*$ ]]; then
        echo "❌ CLOUDBENCH_WARM_RESIZE_ATTEMPTS must be a positive integer (got: ${max_attempts})" >&2
        return 1
    fi
    # Retry delay/cap may be 0 in unit tests (instant retry); production defaults are >0.
    if ! [[ "$retry_delay" =~ ^[0-9]+$ ]]; then
        echo "❌ CLOUDBENCH_WARM_RESIZE_RETRY_SECONDS must be a non-negative integer (got: ${retry_delay})" >&2
        return 1
    fi
    if ! [[ "$cap" =~ ^[0-9]+$ ]]; then
        echo "❌ CLOUDBENCH_WARM_RESIZE_RETRY_MAX_SECONDS must be a non-negative integer (got: ${cap})" >&2
        return 1
    fi
    state="$(machine_state "$id")"
    if [ "$state" != "stopped" ]; then
        stop_machine_strict "$id" || return 1
    fi
    echo "🧮 sizing warm source for $purpose: $size/${memory}MB"
    # Retry Fly machine-update failures that are either exclusive leases held by
    # a peer workspace, or org API rate limits after park→prepare. Fail closed
    # after bounded attempts so a stuck donor cannot strand every later fleet.
    while true; do
        update_rc=0
        update_out="$(FLY machine update "$id" -a "$APP" --vm-size "$size" --vm-memory "$memory" \
            --command "sleep infinity" --skip-start --yes 2>&1)" || update_rc=$?
        if [ "$update_rc" -eq 0 ]; then
            return 0
        fi
        if printf '%s' "$update_out" | grep -Eqi 'lease currently held|failed to (obtain|get) lease'; then
            if [ "$attempt" -ge "$lease_attempts" ]; then
                printf '%s\n' "$update_out" | sed 's/^/   /' >&2
                echo "❌ warm source resize lease still held after ${lease_attempts} attempts" >&2
                return 1
            fi
            echo "   ⏳ warm resize lease held — retry $attempt/$lease_attempts in ${lease_delay}s" >&2
            sleep "$lease_delay"
            attempt=$((attempt + 1))
            continue
        fi
        if ! printf '%s' "$update_out" | grep -Eqi \
            'resource_exhausted|rate[[:space:]]*limit|429|concurrent[[:space:]]+update|version[[:space:]]+changed|aborted:'; then
            printf '%s\n' "$update_out" | sed 's/^/   /' >&2
            echo "❌ warm-source resize for $purpose failed (non-retryable)" >&2
            return 1
        fi
        if [ "$attempt" -ge "$max_attempts" ]; then
            printf '%s\n' "$update_out" | sed 's/^/   /' >&2
            echo "❌ warm-source resize for $purpose exhausted $attempt rate-limit retries" >&2
            return 1
        fi
        this_delay=$(( retry_delay * (1 << (attempt - 1)) ))
        [ "$this_delay" -gt "$cap" ] && this_delay="$cap"
        this_delay=$(( this_delay + (RANDOM % 5) ))
        echo "⏳ warm-source resize rate-limited (attempt $attempt/$max_attempts); retrying in ${this_delay}s ..." >&2
        sleep "$this_delay"
        attempt=$((attempt + 1))
    done
}

prepare_warm_source() {
    resize_stopped_warm_source "$1" "$VM_SIZE" "$VM_MEMORY" maintenance
}

park_warm_source() {
    resize_stopped_warm_source "$1" "$WARM_PARKED_VM_SIZE" "$WARM_PARKED_VM_MEMORY" idle-capacity
}

# Bind the maintenance transaction to Fly's authoritative snapshot id. A time
# window or "newest" selector can adopt a concurrent manual/workspace snapshot
# that never carried the dependency trees this transaction just verified.
CREATED_SNAPSHOT_ID=""
create_volume_snapshot_exact() {  # create_volume_snapshot_exact <volume-id>
    local vol="$1" before_ids="" listed_ids="" create_output="" snapshots_json=""
    local candidate="" state="" requested_at="" attempt="" schedule_attempt=""
    local baseline_attempts="${CLOUDBENCH_SNAPSHOT_BASELINE_ATTEMPTS:-6}"
    # Measured 2026-10-12 on the warm donor: a snapshot ran about 14 minutes, and
    # one scheduled while the donor was running waited 7 more before starting.
    local schedule_attempts="${CLOUDBENCH_SNAPSHOT_SCHEDULE_ATTEMPTS:-120}"
    local ready_attempts="${CLOUDBENCH_SNAPSHOT_READY_ATTEMPTS:-180}"
    CREATED_SNAPSHOT_ID=""
    for attempt in "$baseline_attempts" "$schedule_attempts" "$ready_attempts"; do
        case "$attempt" in
            ''|*[!0-9]*|0) echo "❌ CLOUDBENCH_SNAPSHOT_*_ATTEMPTS must be positive integers" >&2; return 1 ;;
        esac
    done
    for schedule_attempt in $(seq 1 "$schedule_attempts"); do
        # Fly can briefly return a valid but empty list while older snapshots
        # exist. An empty baseline makes every existing snapshot look new, so
        # re-read it before accepting that the volume has none.
        for attempt in $(seq 1 "$baseline_attempts"); do
            if ! listed_ids="$(FLY volume snapshots list "$vol" -a "$APP" --json 2>/dev/null | python3 -c '
import json, sys
snapshots = json.load(sys.stdin)
if not isinstance(snapshots, list): raise SystemExit(1)
for snapshot in snapshots:
    if isinstance(snapshot, dict) and snapshot.get("id"): print(snapshot["id"])
')"; then
                echo "❌ could not capture the authoritative pre-snapshot inventory" >&2
                return 1
            fi
            before_ids="$listed_ids"
            [ -n "$before_ids" ] && break
            [ "$attempt" -ge "$baseline_attempts" ] || sleep $(( attempt * 3 ))
        done
        requested_at="$(date +%s)"
        echo "🧊 cutting a fresh snapshot of $vol ..."
        create_output="$(FLY volumes snapshots create "$vol" -a "$APP" --json 2>&1)" && break
        # Fly accepts one scheduled snapshot per volume. One left by an earlier
        # (possibly failed) transaction blocks this request until it finishes;
        # wait for it rather than failing every queued controller in turn.
        case "$create_output" in
            *"snapshot is already scheduled"*)
                if [ "$schedule_attempt" -lt "$schedule_attempts" ]; then
                    echo "   ⏳ another snapshot of $vol is still scheduled — retry $schedule_attempt/$schedule_attempts in 10s"
                    sleep 10
                    continue
                fi
                ;;
        esac
        [ -z "$create_output" ] || printf '%s\n' "$create_output" | sed 's/^/   /' >&2
        echo "❌ snapshot creation request failed" >&2
        return 1
    done
    [ -z "$create_output" ] || printf '%s\n' "$create_output" | sed 's/^/   /'
    for _ in $(seq 1 "$ready_attempts"); do
        if ! snapshots_json="$(FLY volume snapshots list "$vol" -a "$APP" --json 2>/dev/null)"; then
            echo "❌ could not verify snapshot inventory" >&2
            return 1
        fi
        read -r candidate state candidate_ids <<< "$(printf '%s' "$snapshots_json" \
            | BEFORE_IDS="$before_ids" BOUND_ID="$CREATED_SNAPSHOT_ID" REQUESTED_AT="$requested_at" \
                BASELINE_EMPTY="$([ -n "$before_ids" ] || echo 1)" \
                SCHEDULE_RETRIED="$([ "$schedule_attempt" -gt 1 ] && echo 1 || echo 0)" \
                CLOCK_SKEW="${CLOUDBENCH_SNAPSHOT_CLOCK_SKEW_SECONDS:-300}" python3 -c '
import json, os, sys
from datetime import datetime
snapshots = json.load(sys.stdin)
if not isinstance(snapshots, list): raise SystemExit(1)
valid = {"created", "complete", "completed", "ready"}
before = set(os.environ.get("BEFORE_IDS", "").splitlines())
bound = os.environ.get("BOUND_ID", "")
# A snapshot Fly dated well before this request cannot be its result, even if a
# transiently empty baseline omitted it. Pending snapshots carry a zero date and
# unparseable dates stay candidates, so this never adopts by time.
# A scheduling retry follows a positively competing transaction. Its snapshot
# may finish after our baseline but before this accepted request; the ordinary
# clock-skew allowance must not let us adopt that earlier transaction.
skew = 0 if os.environ.get("SCHEDULE_RETRIED") == "1" else float(os.environ["CLOCK_SKEW"])
predates = float(os.environ["REQUESTED_AT"]) - skew
def created_before_request(snapshot):
    try:
        created = datetime.fromisoformat(str(snapshot.get("created_at") or "").replace("Z", "+00:00"))
    except ValueError:
        return False
    return created.year > 1 and created.tzinfo is not None and created.timestamp() < predates
if bound:
    matches = [s for s in snapshots if isinstance(s, dict) and s.get("id") == bound]
    ready = any(str(s.get("status") or "").lower() in valid and int(s.get("size") or 0) > 0 for s in matches)
    print(bound, "complete" if ready else "pending")
else:
    new_by_id = {}
    for snapshot in snapshots:
        if not isinstance(snapshot, dict): continue
        snapshot_id = snapshot.get("id")
        if snapshot_id and snapshot_id not in before and not created_before_request(snapshot):
            new_by_id.setdefault(snapshot_id, []).append(snapshot)
    if len(new_by_id) > 1:
        print("ambiguous ambiguous", ",".join(sorted(new_by_id)))
    elif not new_by_id:
        print("missing missing")
    else:
        snapshot_id, records = next(iter(new_by_id.items()))
        ready = any(str(s.get("status") or "").lower() in valid and int(s.get("size") or 0) > 0 for s in records)
        if ready and os.environ.get("BASELINE_EMPTY") == "1":
            # With no baseline, an already-complete snapshot cannot be the one
            # this request just scheduled (Fly takes minutes); never adopt it.
            print("preexisting preexisting", snapshot_id)
        else:
            print(snapshot_id, "complete" if ready else "pending")
' 2>/dev/null || echo unreadable unreadable)"
        [ "$candidate" = "ambiguous" ] && {
            echo "❌ multiple new snapshots appeared before ownership was bound (${candidate_ids:-unknown}); refusing to guess transaction ownership" >&2
            return 1
        }
        [ "$candidate" = "preexisting" ] && {
            echo "❌ only an already-complete snapshot appeared after an empty baseline (${candidate_ids:-unknown}); refusing to adopt it" >&2
            return 1
        }
        [ "$candidate" = "unreadable" ] && { echo "❌ could not parse snapshot inventory" >&2; return 1; }
        if [ "$candidate" != "missing" ]; then
            if [ -z "$CREATED_SNAPSHOT_ID" ]; then
                CREATED_SNAPSHOT_ID="$candidate"
                echo "   transaction snapshot: $CREATED_SNAPSHOT_ID"
            elif [ "$candidate" != "$CREATED_SNAPSHOT_ID" ]; then
                echo "❌ snapshot transaction identity changed during polling" >&2
                return 1
            fi
        fi
        [ "$state" = "complete" ] && return 0
        sleep 10
    done
    echo "❌ exact snapshot ${CREATED_SNAPSHOT_ID:-<missing>} did not complete in time (state=${state:-unknown})" >&2
    return 1
}

# Wait for SSH to answer on the machine (post-start it can take a few seconds).
#
# FAILS CLOSED. This used to warn and `return 0`, so callers exec'd into a
# machine that was not up and the real constraint resurfaced as an unrelated
# error ("exact remote checkout failed" / "app has no started VMs"), aborting a
# whole fleet run before it provisioned anything. Readiness is a precondition,
# not a hint: if SSH never answers, say so and let the caller decide.
#
# A machine can also drop back out of `started` between start and exec (an
# auto-stop, a resize-induced restart, or a sibling fleet's stop/start). A bare
# start issued while Fly still reports stopping fails with failed_precondition
# and leaves SSH waiting on a stopped donor. Wait out transitional states, then
# re-issue start on the same cadence as start_machine (not a single shot).
wait_for_ssh() {  # wait_for_ssh <id>
    local id="$1" attempts="${CLOUDBENCH_SSH_WAIT_ATTEMPTS:-30}"
    local nap="${CLOUDBENCH_SSH_WAIT_SLEEP_SECONDS:-3}"
    local probe_timeout="${CLOUDBENCH_SSH_PROBE_TIMEOUT_SECONDS:-10}"
    local state now last_start_ts=0
    for _ in $(seq 1 "$attempts"); do
        # Reuse the run-start readiness contract and its hard process timeout.
        # A raw `flyctl ssh` against a stopped machine has hung for hours.
        if SSH_READ_TRIES=1 SSH_READ_TIMEOUT="$probe_timeout" ssh_ready "$id"; then
            return 0
        fi
        state="$(machine_state "$id")"
        if [ "$state" = "gone" ]; then
            echo "❌ Machine $id disappeared while waiting for SSH" >&2
            return 1
        fi
        if [ "$state" != "started" ]; then
            case "$state" in
                stopping|replacing|starting)
                    sleep "$nap"
                    continue
                    ;;
            esac
            now="$(date +%s)"
            if [ "$last_start_ts" -eq 0 ] || [ $((now - last_start_ts)) -ge 20 ]; then
                echo "   ↻ $id fell out of 'started' (state=$state) — re-asserting start"
                request_machine_start "$id" || true
                last_start_ts="$now"
            fi
        fi
        sleep "$nap"
    done
    echo "❌ SSH never became reachable on $id after $attempts attempts (state=${state:-unknown})" >&2
    return 1
}

require_machine_ready() {  # require_machine_ready <id>
    local id="$1"
    start_machine "$id" || {
        echo "❌ $id never reached 'started'; refusing remote maintenance." >&2
        return 1
    }
    wait_for_ssh "$id" || {
        echo "❌ $id never became ssh-ready; refusing remote maintenance." >&2
        return 1
    }
}

# ═════════════════════════════════════════════════════════════════════════════
# MODE: --destroy — remove the machine + volume entirely (ends all billing).
# ═════════════════════════════════════════════════════════════════════════════
if [ "$MODE" = "destroy" ]; then
    echo "═══ run-bench-cloud --destroy ═══"
    ensure_app
    mid="$(resolve_machine_id)"
    if [ -n "$mid" ]; then
        echo "🧹 Destroying machine $mid ..."
        FLY machine destroy --force "$mid" -a "$APP" 2>&1 | sed 's/^/   /' || true
    fi
    # Belt-and-suspenders: sweep any leftover machines in the app.
    for id in $(_machines_json | python3 -c 'import json,sys
try:
    for m in (json.load(sys.stdin) or []):
        if m.get("id"): print(m["id"])
except Exception: pass' 2>/dev/null); do
        echo "   destroying leftover machine $id"
        FLY machine destroy --force "$id" -a "$APP" 2>&1 | sed 's/^/   /' || true
    done
    # Destroy the volume(s).
    for vid in $(FLY volumes list -a "$APP" --json 2>/dev/null | python3 -c 'import json,sys
try:
    for v in (json.load(sys.stdin) or []):
        if v.get("id"): print(v["id"])
except Exception: pass' 2>/dev/null); do
        echo "   destroying volume $vid"
        FLY volumes destroy "$vid" -a "$APP" --yes 2>&1 | sed 's/^/   /' || true
    done
    rm -f "$STATE_FILE"
    echo ""
    echo "🔎 Proof — remaining machines / volumes:"
    FLY machines list -a "$APP" 2>&1 | sed 's/^/   /' || true
    FLY volumes list -a "$APP" 2>&1 | sed 's/^/   /' || true
    echo "✅ Destroyed. Idle cost is now zero (no machine, no volume)."
    exit 0
fi

# ═════════════════════════════════════════════════════════════════════════════
# CLI image-build → native uncached build/push → exact image receipt.
# Setup consumes that same image builder before donor activation; ordinary
# source-only benchmarks do not build an image.
build_warm_image() {
    local builder_args=()
    IMAGE_BUILD_COMPLETION='{"publication_verified":false,"publisher_exit_code":null,"published_tag_resolution_verified":false,"publication_metadata_warning":null}'
    IMAGE_BUILD_ATTEMPTS=0
    case "${IMAGE_BUILD_BUILDER:-native}" in
        native) builder_args=(--depot=false) ;;
        depot)
            builder_args=(--depot=true --depot-scope=app --compression=zstd --compression-level=3)
            ;;
        *) echo "--builder requires native or depot" >&2; return 2 ;;
    esac
    if [ -n "${WARM_IMAGE_REF:-}" ]; then
        [ "${IMAGE_BUILD_BUILDER:-native}" = native ] || {
            echo "--builder depot cannot use a prebuilt WARM_IMAGE_REF" >&2
            return 2
        }
        [ "$IMAGE_BUILD_NO_CACHE" = 0 ] || {
            echo "--no-cache cannot use a prebuilt WARM_IMAGE_REF" >&2
            return 2
        }
        IMAGE_REF="$WARM_IMAGE_REF"
        echo "✅ Using pre-built image (WARM_IMAGE_REF): $IMAGE_REF"
        return 0
    fi
    if ! declare -F cloudbench_image_publish >/dev/null; then
        # Load from the invocation snapshot so later edits cannot change an
        # in-flight controller's publisher.
        source "${CLOUDBENCH_SCRIPT_SNAPSHOT:-$ROOT_DIR/scripts/lib}/cloudbench-image-publisher.sh" || return $?
    fi
    local attempt build_ok=0 build_status=0 used_labels=" " build_args=()
    local completion_file="$OUT_DIR/cloudbench-image-publication.json"
    echo "🏗️  Building dependency image (layer_cache_bypassed=$IMAGE_BUILD_NO_CACHE)..."
    for attempt in 1 2 3; do
        # A failed attempt's remote builder can still publish after its local
        # client exits. Each attempt therefore owns a fresh tag, so that output
        # can never be read back as a later attempt's registry handoff.
        IMAGE_LABEL="cloudbench-warm-$(date +%Y%m%d-%H%M%S)-$$"
        while [[ "$used_labels" == *" $IMAGE_LABEL "* ]]; do
            command sleep 1
            IMAGE_LABEL="cloudbench-warm-$(date +%Y%m%d-%H%M%S)-$$"
        done
        used_labels+="$IMAGE_LABEL "
        build_args=(
            deploy "$IMAGE_BUILD_CONTEXT"
            -c "$IMAGE_BUILD_CONTEXT/fly.cloudbench-warm.toml"
            --dockerfile "$IMAGE_BUILD_CONTEXT/Dockerfile.cloudbench-warm"
            "${builder_args[@]}" --remote-only --build-only --push
            --image-label "$IMAGE_LABEL" -a "$APP"
        )
        [ "$IMAGE_BUILD_NO_CACHE" = 0 ] || build_args+=(--no-cache)
        echo "   build attempt $attempt/3 (label $IMAGE_LABEL)"
        # Fly resolves build files from the config directory. Bind every path
        # and the invocation directory to the selected checkout, even when the
        # CLI itself belongs to a different worktree.
        if (cd "$IMAGE_BUILD_CONTEXT" &&
            CLOUDBENCH_IMAGE_COMPLETION_FILE="$completion_file" \
            CLOUDBENCH_IMAGE_ATTEMPT_CONTEXT="$IMAGE_BUILD_CONTEXT" \
            CLOUDBENCH_IMAGE_ATTEMPT_APP="$APP" CLOUDBENCH_IMAGE_ATTEMPT_LABEL="$IMAGE_LABEL" \
            CLOUDBENCH_IMAGE_ATTEMPT_PID="$$" cloudbench_image_publish "${build_args[@]}"); then
            build_ok=1
            [ ! -f "$completion_file" ] || IMAGE_BUILD_COMPLETION="$(cat "$completion_file")"
            break
        else
            build_status=$?
            # Registry continuation reuses the same built manifest. A failed
            # handoff must not restart dependency installation or hide evidence.
            [ "$build_status" != 74 ] || return "$build_status"
        fi
        [ "$attempt" = 3 ] || sleep 15
    done
    [ "$build_ok" = 1 ] || { echo "Image build failed after 3 attempts" >&2; return 1; }
    IMAGE_REF="$(python3 - "$IMAGE_BUILD_COMPLETION" "registry.fly.io/$APP:$IMAGE_LABEL" <<'PY_IMAGE_REF'
import json,sys
print(json.loads(sys.argv[1]).get("published_image_ref") or sys.argv[2])
PY_IMAGE_REF
    )" || return $?
    IMAGE_BUILD_ATTEMPTS="$attempt"
    echo "✅ Image: $IMAGE_REF"
}

image_build_input_provenance() {
    python3 - "$IMAGE_BUILD_CONTEXT" "${IMAGE_BUILD_BUILDER:-native}" <<'PY_INPUTS'
import hashlib
import json
import os
import subprocess
import sys
from pathlib import Path

context = Path(sys.argv[1]).resolve()
builder = sys.argv[2]
def git_value(*arguments):
    try:
        result = subprocess.run(
            ["git", "-C", str(context), *arguments],
            capture_output=True, text=True, check=False,
        )
    except OSError:
        return None
    return result.stdout.strip() if result.returncode == 0 else None

dirty = git_value("status", "--porcelain=v1", "--untracked-files=normal")
print(json.dumps({
    "build_context": str(context),
    "source_sha": git_value("rev-parse", "HEAD") or "",
    "source_dirty": None if dirty is None else bool(dirty),
    "dockerfile_sha256": hashlib.sha256((context / "Dockerfile.cloudbench-warm").read_bytes()).hexdigest(),
    "config_sha256": hashlib.sha256((context / "fly.cloudbench-warm.toml").read_bytes()).hexdigest(),
    "requested_builder": builder,
    "requested_builder_scope": "app" if builder == "depot" else None,
    "requested_compression": "zstd" if builder == "depot" else None,
    "requested_compression_level": 3 if builder == "depot" else None,
    "requested_platform": "linux/amd64" if builder == "depot" else (os.environ.get("FLY_DEV_PLATFORM") or "linux/amd64"),
    "image_publisher_version": "0.4.112",
    "image_publisher_transport": "https",
    "image_publisher_engine": "docker-classic" if builder == "native" else "depot-buildkit",
}))
PY_INPUTS
}

if [ "$MODE" = build-image ]; then
    image_build_pid=""
    image_build_exit() {
        local status=$?
        trap - EXIT
        trap '' HUP INT TERM
        # $! also covers a signal between asynchronous launch and PID assignment.
        # Capture native births before signaling; never touch the shared builder.
        cloudbench_terminate_tree_and_wait "${CLOUDBENCH_CHILD_TERM_SECONDS:-30}" \
            "${image_build_pid:-${!:-}}" || status=70
        exit "$status"
    }
    trap image_build_exit EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    (
        # Parent owns cancellation and joining; the publisher owns no CLI traps.
        trap - EXIT HUP INT TERM
        image_build_started="$(date +%s)"
        if ! declare -F cloudbench_image_publish >/dev/null; then
            source "${CLOUDBENCH_SCRIPT_SNAPSHOT:-$ROOT_DIR/scripts/lib}/cloudbench-image-publisher.sh" || exit $?
        fi
        IMAGE_PUBLISHER_CLIENT="$(cloudbench_image_publisher_client)" || exit $?
        # Capture the selected inputs before provider launch; later edits must not
        # be attributed to an image whose build context was already submitted.
        image_build_provenance="$(image_build_input_provenance)" || exit $?
        build_warm_image || exit $?
        image_build_finished="$(date +%s)"
        python3 - "$OUT_DIR/cloudbench-image-build.json" "$IMAGE_REF" \
            "$IMAGE_BUILD_NO_CACHE" "$image_build_provenance" \
            "$image_build_started" "$image_build_finished" \
            "$IMAGE_BUILD_COMPLETION" "$IMAGE_BUILD_ATTEMPTS" <<'PY_RECEIPT'
import json,os,sys
path,image,cold,provenance,started,finished,completion,attempts=sys.argv[1:]
receipt={"schema":"cloudbench-image-build-v1","image_ref":image,
         "layer_cache_bypassed":cold=="1",**json.loads(provenance),
         "started_epoch":int(started),"finished_epoch":int(finished),
         "elapsed_seconds":int(finished)-int(started),
         **json.loads(completion),"build_attempts":int(attempts)}
with open(path,"w") as handle:
    json.dump(receipt,handle)
    handle.write("\n")
os.chmod(path,0o600)
PY_RECEIPT
        echo "Image build receipt: $OUT_DIR/cloudbench-image-build.json"
        exit 0
    ) &
    image_build_pid=$!
    if wait "$image_build_pid"; then
        image_build_status=0
    else
        image_build_status=$?
    fi
    trap - EXIT HUP INT TERM
    exit "$image_build_status"
fi

# MODE: --setup — one-time: app + secrets + image + volume + machine + git clone.
# ═════════════════════════════════════════════════════════════════════════════
warm_source_machine_creation_admission() {
    echo "❌ warm-source capacity gap: reuse an existing owned warm Machine; new Machine creation is withheld without measured admission" >&2
    return 78
}
# Bind the activated image to the manifests it was built from, so fleets can
# prove that fresh REAL primaries (which copy deps from the image's baked /app)
# will match their checkout. Only an image this process built from
# IMAGE_BUILD_CONTEXT has known /app manifests; a prebuilt WARM_IMAGE_REF stays
# unproven, and fresh fleets then restore the proven snapshot instead.
publish_warm_image_deps_proof() {  # <warm-machine-id>
    local machine_id="$1" node_fp py_fp
    if [ -n "${WARM_IMAGE_REF:-}" ]; then
        echo "   prebuilt image: no dependency proof published (fresh fleets restore the proven snapshot)"
        return 0
    fi
    node_fp="$(cloudbench_node_dependency_fingerprint "$IMAGE_BUILD_CONTEXT")" || node_fp=""
    py_fp="$(cloudbench_manifest_fingerprint "$IMAGE_BUILD_CONTEXT" "${CLOUDBENCH_PYTHON_MANIFESTS[@]}")" || py_fp=""
    if [ -n "$node_fp" ] && [ -n "$py_fp" ] \
        && cloudbench_publish_warm_image_deps "$APP" "$machine_id" "$IMAGE_REF" "$node_fp" "$py_fp"; then
        echo "🧾 published warm image dependency proof for $IMAGE_REF (node ${node_fp:0:12}, python ${py_fp:0:12})"
    else
        echo "⚠️  could not publish the warm image dependency proof; fresh fleets will restore the proven snapshot" >&2
    fi
    return 0
}
if [ "$MODE" = "setup" ]; then
    echo "═══ run-bench-cloud --setup ═══"
    echo "app=$APP region=$REGION machine=$MACHINE_NAME volume=$VOLUME_NAME vm=$VM_SIZE/${VM_MEMORY}MB volume_size=${VOLUME_SIZE}GB"
    echo ""

    # Resolve before app/secrets/build/volume mutations. An absent or unsafe
    # warm source is an admission gap, never permission to create another one.
    setup_existing_machine="$(resolve_machine_id)" || { warm_source_machine_creation_admission; exit 78; }
    [ -n "$setup_existing_machine" ] || { warm_source_machine_creation_admission; exit 78; }
    ensure_app
    CLOUDBENCH_HOLD_APP_ENV_LOCK=1
    trap 'release_app_environment_lock' EXIT
    trap 'release_app_environment_lock; exit 130' INT
    trap 'release_app_environment_lock; exit 143' TERM
    inject_secrets

    # ── Build + push the KEEP-ALIVE image (deps baked; CMD = sleep infinity) ──
    # Uses the Fly classic remote builder (plain manifest) so `machine run <tag>`
    # resolves cleanly (Depot pushes an OCI index that machine-run can't resolve).
    echo ""
    build_warm_image || exit $?

    # ── Create the volume (if absent) ────────────────────────────────────────
    echo ""
    HAVE_VOL="$(FLY volumes list -a "$APP" --json 2>/dev/null | VN="$VOLUME_NAME" python3 -c 'import json,os,sys
try: data=json.load(sys.stdin) or []
except Exception: data=[]
print("1" if any(v.get("name")==os.environ["VN"] for v in data) else "0")' 2>/dev/null || echo 0)"
    if [ "$HAVE_VOL" = "1" ]; then
        echo "✅ Volume $VOLUME_NAME already exists"
    else
        echo "💽 Creating volume $VOLUME_NAME (${VOLUME_SIZE}GB, region $REGION) ..."
        warm_source_machine_creation_admission || exit $?
        FLY volumes create "$VOLUME_NAME" -a "$APP" --region "$REGION" --size "$VOLUME_SIZE" --yes 2>&1 | sed 's/^/   /' || {
            echo "❌ Failed to create volume"; exit 1
        }
    fi

    # ── Create the persistent machine (keep-alive image + volume at /data) ───
    echo ""
    mid="$(resolve_machine_id)"
    if [ -n "$mid" ]; then
        echo "🔄 Updating the existing warm source and pool to image $IMAGE_REF ..."
        activate_owned_machine_images "$IMAGE_REF" || {
            echo "❌ Failed to activate the rebuilt dependency image" >&2
            exit 1
        }
        echo "✅ Persistent machine already exists: $mid (image refreshed)"
        publish_warm_image_deps_proof "$mid"
    else
        echo "🖥️  Creating persistent machine $MACHINE_NAME ($VM_SIZE / ${VM_MEMORY}MB, volume→/data) ..."
        warm_source_machine_creation_admission || exit $?
        RUN_LOG="$(mktemp)"
        FLY machine run "$IMAGE_REF" \
            -a "$APP" \
            --name "$MACHINE_NAME" \
            --region "$REGION" \
            --vm-size "$VM_SIZE" \
            --vm-memory "$VM_MEMORY" \
            --volume "$VOLUME_NAME:/data" \
            --restart no \
            --detach 2>&1 | tee "$RUN_LOG"
        mid="$(grep -oiE 'Machine ID: [0-9a-f]+' "$RUN_LOG" | tail -1 | awk '{print $3}')"
        rm -f "$RUN_LOG"
        [ -z "$mid" ] && mid="$(resolve_machine_id)"
        [ -z "$mid" ] && { echo "❌ Failed to create the persistent machine"; exit 1; }
        echo "✅ Machine: $mid"
        publish_warm_image_deps_proof "$mid"
    fi
    write_state "$mid"

    prepare_warm_source "$mid" || exit 1
    require_machine_ready "$mid" || exit 1

    # ── git clone the repo into /data/repo (auth via validated controller token) ─
    SETUP_GITHUB_TOKEN="$(resolve_github_token)" || SETUP_GITHUB_TOKEN=""
    if [ -z "$SETUP_GITHUB_TOKEN" ]; then
        echo "❌ No validated GitHub token available — cannot clone the private repo." >&2
        echo "   Checked CLOUDBENCH_GITHUB_TOKEN_B64, GITHUB_DISPATCH_TOKEN, gh auth, and .env GITHUB_TOKEN." >&2
        echo "   Stopping machine; fix credentials and re-run --setup." >&2
        stop_machine "$mid"
        exit 1
    fi
    SETUP_GITHUB_TOKEN_B64="$(printf '%s' "$SETUP_GITHUB_TOKEN" | base64 | tr -d '\n')"
    echo ""
    echo "📥 Cloning repo into $REMOTE_REPO on the box (branch $BENCH_REF) ..."
    # Request-scoped controller token via GIT_CONFIG_GLOBAL http.extraheader —
    # never persist into .git/config, never put AUTH_HDR on git argv (ps leak).
    # Upload token + script via SFTP (mode 0600/0700); -C only names remote paths.
    CLONE_CMD="set -e
mkdir -p /data
TOKEN=\$(printf '%s' \"\$CLOUDBENCH_GITHUB_TOKEN_B64\" | base64 -d 2>/dev/null || true)
[ -n \"\$TOKEN\" ] || { echo 'FATAL: controller GitHub token unavailable for setup clone' >&2; exit 1; }
auth_config=\$(mktemp /tmp/cloudbench-setup-gitconfig.XXXXXX)
trap 'rm -f \"\$auth_config\"' EXIT
printf '[http]\\n\\textraheader = Authorization: Basic %s\\n' \"\$(printf 'x-access-token:%s' \"\$TOKEN\" | base64 | tr -d '\\n')\" >\"\$auth_config\"
chmod 600 \"\$auth_config\"
git_auth() { env \"GIT_CONFIG_GLOBAL=\$auth_config\" GIT_CONFIG_NOSYSTEM=1 git \"\$@\"; }
if [ -d '$REMOTE_REPO/.git' ]; then
  echo 'repo already present — fetching latest'
  # Reset origin before authenticated fetch so a retained/altered remote cannot
  # receive the controller token (same order as cloudbench-fetch-ref.sh).
  git -c safe.directory='$REMOTE_REPO' -C '$REMOTE_REPO' remote set-url origin 'https://github.com/Rose-Ai-Labs/rose.git'
  git_auth -c safe.directory='$REMOTE_REPO' -C '$REMOTE_REPO' fetch --quiet origin
else
  git_auth clone --quiet 'https://github.com/Rose-Ai-Labs/rose.git' '$REMOTE_REPO'
fi
git -c safe.directory='$REMOTE_REPO' -C '$REMOTE_REPO' remote set-url origin 'https://github.com/Rose-Ai-Labs/rose.git'
chown -R rose:rose '$REMOTE_REPO' 2>/dev/null || true
echo 'clone/fetch complete'"
    setup_token_local="$(mktemp)"
    setup_cmd_local="$(mktemp)"
    remote_setup_token="/tmp/cloudbench-setup-token.$$"
    remote_setup_cmd="/tmp/cloudbench-setup-cmd.$$"
    printf '%s' "$SETUP_GITHUB_TOKEN_B64" >"$setup_token_local"
    printf '%s' "$CLONE_CMD" >"$setup_cmd_local"
    chmod 600 "$setup_token_local" "$setup_cmd_local"
    # flyctl sftp will not overwrite; start clean, and wipe remotes on any
    # partial failure so a lone token file cannot linger on the box.
    ssh_exec "$mid" "rm -f '$remote_setup_token' '$remote_setup_cmd'" >/dev/null 2>&1 || true
    if ! FLY ssh sftp put -a "$APP" --machine "$mid" -q -m 0600 "$setup_token_local" "$remote_setup_token" ||
       ! FLY ssh sftp put -a "$APP" --machine "$mid" -q -m 0700 "$setup_cmd_local" "$remote_setup_cmd"; then
        ssh_exec "$mid" "rm -f '$remote_setup_token' '$remote_setup_cmd'" >/dev/null 2>&1 || true
        rm -f "$setup_token_local" "$setup_cmd_local"
        echo "❌ failed to upload setup clone credentials/script"; stop_machine "$mid"; exit 1
    fi
    rm -f "$setup_token_local" "$setup_cmd_local"
    clone_output=""
    if ! clone_output="$(FLY ssh console -a "$APP" --machine "$mid" \
        -C "bash -lc \"trap 'rm -f $remote_setup_token $remote_setup_cmd' EXIT; export CLOUDBENCH_GITHUB_TOKEN_B64=\$(cat $remote_setup_token); bash $remote_setup_cmd\"" 2>&1)"; then
        printf '%s\n' "$clone_output" | grep -av '^Connecting to' | sed 's/^/   /'
        echo "❌ git clone failed"; stop_machine "$mid"; exit 1
    fi
    printf '%s\n' "$clone_output" | grep -av '^Connecting to' | sed 's/^/   /'

    park_warm_source "$mid" || exit 1
    echo ""
    echo "✅ Setup complete."
    echo "   Next (one-time, builds the cached WMH model):  bash scripts/run-bench-cloud --refresh-wmh"
    echo "   Then per run:                                  bash scripts/run-bench-cloud <task> --simulate"
    exit 0
fi

# ═════════════════════════════════════════════════════════════════════════════
# MODE: --refresh-deps — sync the warm VOLUME's baked dependency trees to the
# current ref and cut a fresh snapshot. Fleet clones fork the warm snapshot;
# when its node_modules/venv trees are stale vs the ref's manifests, EVERY
# clone pays the multi-minute rsync refresh on bring-up (the fleet's dominant
# cost). Refresh centrally ONCE here instead; clones then no-op their dep sync.
# ═════════════════════════════════════════════════════════════════════════════
# Print the snapshot a peer published while this refresh request waited for the
# app environment lock, when its proof covers the exact expected manifests and
# passes the same complete-snapshot/epoch check the fleet applies afterwards.
# <request-mtime-ns> is a marker file's mtime taken when the request started, on
# the state file's own filesystem: both times come from the same kernel clock.
# (Comparing an mtime with `date +%s` let a peer's write just after a second
# boundary read as one second older than the request, so it was not reused.)
peer_refreshed_snapshot() {  # peer_refreshed_snapshot <request-mtime-ns>
    local since="$1" s_node="" s_py="" s_epoch="" s_snap="" written="" vol=""
    [ -f "$WARM_DEPS_STATE_FILE" ] || return 1
    written="$(python3 -c 'import os, sys; print(os.stat(sys.argv[1]).st_mtime_ns)' "$WARM_DEPS_STATE_FILE" 2>/dev/null)" || return 1
    [ "${written:-0}" -ge "$since" ] || return 1
    read -r s_node s_py s_epoch s_snap < "$WARM_DEPS_STATE_FILE" || return 1
    [ "$s_node" = "$EXPECTED_NODE_FP" ] && [ "$s_py" = "$EXPECTED_PY_FP" ] && [ -n "$s_snap" ] || return 1
    # Reuse only an unpatched peer snapshot of this exact source ref: a patched
    # producer leaves no receipt, and a patched request refreshes its own tree.
    [ -z "${REFRESH_PATCH_FILE:-}" ] || return 1
    [ "$(cat "$WARM_DEPS_STATE_FILE.ref" 2>/dev/null)" = "$EXPECTED_REF $s_snap" ] || return 1
    vol="$(FLY machines list -a "$APP" --json 2>/dev/null | MN="$MACHINE_NAME" python3 -c '
import json, os, sys
for m in json.load(sys.stdin) or []:
    if m.get("name") == os.environ["MN"]:
        mounts = m.get("config", {}).get("mounts") or []
        if mounts: print(mounts[0].get("volume", ""))
        break
' 2>/dev/null)" || return 1
    [ -n "$vol" ] || return 1
    FLY volume snapshots list "$vol" -a "$APP" --json 2>/dev/null \
        | SID="$s_snap" EPOCH="${s_epoch:-0}" python3 -c '
import json, os, sys
from datetime import datetime
valid = {"created", "complete", "completed", "ready"}
records = [s for s in json.load(sys.stdin) or [] if isinstance(s, dict) and s.get("id") == os.environ["SID"]]
def proven(snapshot):
    try:
        created = datetime.fromisoformat(str(snapshot.get("created_at") or "").replace("Z", "+00:00")).timestamp()
    except ValueError:
        return False
    return (str(snapshot.get("status") or "").lower() in valid and int(snapshot.get("size") or 0) > 0
            and created >= int(os.environ["EPOCH"]) - 60)
raise SystemExit(0 if any(proven(s) for s in records) else 1)
' 2>/dev/null || return 1
    printf '%s\n' "$s_snap"
}

if [ "$MODE" = "refresh-deps" ]; then
    # Per-dependency-set warm sources (`cloudbench-warm-<set>`, selected by the
    # fleet with CLOUDBENCH_WARM_SOURCE_PER_DEPS=1) are shared by every devbox, and
    # the per-host app-environment lock cannot see another devbox's refresh. Hold
    # the set's Fly-native claim (scripts/cloudbench-warm-source.py: a lease-guarded
    # compare-and-set on the base donor's metadata, renewed while this process
    # lives, released on exit) for the whole maintenance transaction. Other sets
    # use other claims, so they never wait on this one.
    WARM_SOURCE_CLAIM_PID=""
    acquire_warm_source_claim() {  # <set>
        local set="$1" ready helper="$CLOUDBENCH_RUNTIME_SCRIPT_ROOT/cloudbench-warm-source.py"
        ready="$(mktemp "${TMPDIR:-/tmp}/cloudbench-warm-claim.XXXXXX")" || return 1
        rm -f "$ready"
        python3 "$helper" --app "$APP" claim hold --set "$set" --owner "refresh-$(hostname | tr -c 'A-Za-z0-9.-' '-')-$$" \
            --parent-pid "$$" --ready "$ready" --wait "${CLOUDBENCH_APP_ENV_LOCK_WAIT_SECONDS:-3600}" &
        WARM_SOURCE_CLAIM_PID=$!
        while [ ! -s "$ready" ]; do
            if ! kill -0 "$WARM_SOURCE_CLAIM_PID" 2>/dev/null; then
                wait "$WARM_SOURCE_CLAIM_PID" 2>/dev/null || true
                WARM_SOURCE_CLAIM_PID=""
                echo "❌ could not claim maintenance of warm source set $set across devboxes" >&2
                return 1
            fi
            sleep 1
        done
        rm -f "$ready"
        echo "🔒 holding the cross-devbox maintenance claim for warm source set $set"
    }
    release_warm_source_claim() {
        [ -n "$WARM_SOURCE_CLAIM_PID" ] || return 0
        kill -TERM "$WARM_SOURCE_CLAIM_PID" 2>/dev/null || true
        wait "$WARM_SOURCE_CLAIM_PID" 2>/dev/null || true
        WARM_SOURCE_CLAIM_PID=""
    }
    # Print the snapshot another devbox proved for these exact manifests on this
    # set's warm source while this request waited, and record it as this checkout's
    # receipt. The proof check is the fleet's own (cloudbench_warm_deps_state_from_inventory).
    peer_devbox_proven_snapshot() {
        local machines snapshots pair mid vol state temporary
        [ -z "${REFRESH_PATCH_FILE:-}" ] || return 1  # a patched request refreshes its own tree
        machines="$(FLY machines list -a "$APP" --json 2>/dev/null)" || return 1
        pair="$(printf '%s' "$machines" | MN="$MACHINE_NAME" python3 -c '
import json, os, sys
rows = [m for m in json.load(sys.stdin) or [] if m.get("name") == os.environ["MN"]]
mounts = (rows[0].get("config") or {}).get("mounts") or [] if len(rows) == 1 else []
if len(mounts) == 1 and rows[0].get("id"): print(rows[0]["id"], mounts[0].get("volume", ""))
' 2>/dev/null)" || return 1
        read -r mid vol <<< "$pair"
        [ -n "$mid" ] && [ -n "$vol" ] || return 1
        snapshots="$(FLY volume snapshots list "$vol" -a "$APP" --json 2>/dev/null)" || return 1
        state="$(printf '{"machines":%s,"snapshots":%s}' "$machines" "$snapshots" \
            | cloudbench_warm_deps_state_from_inventory "$APP" "$mid" "$vol" "$EXPECTED_NODE_FP" "$EXPECTED_PY_FP")" || return 1
        temporary="$WARM_DEPS_STATE_FILE.tmp.$$"
        printf '%s\n' "$state" > "$temporary" && mv "$temporary" "$WARM_DEPS_STATE_FILE" || { rm -f "$temporary"; return 1; }
        printf '%s\n' "${state##* }"
    }

    if ! EXPECTED_REF="$(git -C "$ROOT_DIR" rev-parse --verify "${BENCH_REF}^{commit}" 2>/dev/null)"; then
        echo "❌ invalid benchmark ref: $BENCH_REF is not a local commit" >&2
        exit 1
    fi
    REFRESH_PATCH_FILE=""
    REFRESH_PATCH_SHA256=""
    REFRESH_OWNED_PATCH=""
    cleanup_refresh_deps() {
        if [ -n "${maintenance_mid:-}" ]; then
            park_warm_source "${mid:-$maintenance_mid}" || true
        fi
        release_app_environment_lock
        # Released only after the donor is parked: the next devbox's
        # maintenance must find it stopped.
        release_warm_source_claim
        [ -z "$REFRESH_OWNED_PATCH" ] || rm -f "$REFRESH_OWNED_PATCH"
    }
    trap cleanup_refresh_deps EXIT
    trap 'cleanup_refresh_deps; exit 130' INT
    trap 'cleanup_refresh_deps; exit 143' TERM
    if [ "${CLOUDBENCH_SKIP_LOCAL_PATCH:-0}" != "1" ]; then
        if [ -n "${CLOUDBENCH_LOCAL_PATCH_SOURCE:-}" ]; then
            REFRESH_PATCH_FILE="$CLOUDBENCH_LOCAL_PATCH_SOURCE"
            REFRESH_PATCH_SHA256="${CLOUDBENCH_LOCAL_PATCH_SHA256:-}"
            [ -s "$REFRESH_PATCH_FILE" ] && [ -n "$REFRESH_PATCH_SHA256" ] \
                && [ "$(cloudbench_env_sha256 "$REFRESH_PATCH_FILE")" = "$REFRESH_PATCH_SHA256" ] || {
                echo "❌ shared warm workspace patch is missing or its pinned checksum mismatches" >&2
                exit 1
            }
        else
            # Direct maintenance also supports committed, unpublished changes:
            # compare the workspace with the fetchable base, never just HEAD.
            REFRESH_OWNED_PATCH="$(mktemp)"
            refresh_patch_rc=0
            cloudbench_prepare_workspace_patch "$ROOT_DIR" "$EXPECTED_REF" \
                "$REFRESH_OWNED_PATCH" "$ROOT_DIR/scripts/create-worktree-patch.sh" || refresh_patch_rc=$?
            if [ "$refresh_patch_rc" -eq 0 ]; then
                REFRESH_PATCH_FILE="$REFRESH_OWNED_PATCH"
                REFRESH_PATCH_SHA256="$(cloudbench_env_sha256 "$REFRESH_PATCH_FILE")"
            elif [ "$refresh_patch_rc" -ne "$CLOUDBENCH_PATCH_NO_DELTA" ]; then
                echo "❌ could not freeze the warm workspace patch" >&2
                exit 1
            fi
        fi
    fi
    EXPECTED_NODE_FP="$(cloudbench_node_dependency_fingerprint "$ROOT_DIR")"
    EXPECTED_PY_FP="$(cloudbench_manifest_fingerprint "$ROOT_DIR" "${CLOUDBENCH_PYTHON_MANIFESTS[@]}")"
    [ -n "$EXPECTED_NODE_FP" ] && [ -n "$EXPECTED_PY_FP" ] || {
        echo "❌ could not resolve the local dependency fingerprints" >&2
        exit 1
    }
    echo "═══ run-bench-cloud --refresh-deps (ref $BENCH_REF) ═══"
    ensure_app
    # The request's start as a fresh marker's mtime (ns) beside the state file,
    # so peer_refreshed_snapshot compares two times from the same kernel clock.
    mkdir -p "$(dirname "$WARM_DEPS_STATE_FILE")"
    REFRESH_REQUEST_MARKER="$(mktemp "$(dirname "$WARM_DEPS_STATE_FILE")/.refresh-request.XXXXXX")"
    REFRESH_REQUESTED_EPOCH="$(python3 -c 'import os, sys; print(os.stat(sys.argv[1]).st_mtime_ns)' "$REFRESH_REQUEST_MARKER")"
    rm -f "$REFRESH_REQUEST_MARKER"
    [ -n "$REFRESH_REQUESTED_EPOCH" ] || { echo "❌ could not stamp the refresh request" >&2; exit 1; }
    CLOUDBENCH_HOLD_APP_ENV_LOCK=1
    acquire_app_environment_lock || exit 1
    # Concurrent controllers queue here for the same refresh. Once one finishes,
    # the rest reuse its proof instead of each repeating a refresh and snapshot.
    if PEER_SNAP="$(peer_refreshed_snapshot "$REFRESH_REQUESTED_EPOCH")"; then
        echo "✅ a peer refreshed these exact manifests while this request waited; reusing snapshot $PEER_SNAP"
        exit 0
    fi
    if [[ "$MACHINE_NAME" =~ ^cloudbench-warm-[0-9a-f]{12}$ ]]; then
        acquire_warm_source_claim "${MACHINE_NAME#cloudbench-warm-}" || exit 1
        if PEER_SNAP="$(peer_devbox_proven_snapshot)"; then
            echo "✅ another devbox refreshed these exact manifests while this request waited; reusing snapshot $PEER_SNAP"
            exit 0
        fi
    fi

    mid="$(resolve_machine_id)"
    [ -z "$mid" ] && { echo "❌ No persistent machine — run 'run-bench-cloud --setup' first."; exit 1; }
    write_state "$mid"

    maintenance_mid="$mid"
    prepare_warm_source "$mid" || exit 1
    require_machine_ready "$mid" || exit 1

    # Sync the repo to the ref whose manifests the trees must match via the same
    # controller-token + cloudbench-fetch-ref.sh path used by WMH / guest drivers.
    # Token resolution prefers live controller credentials (insteadOf / gh hosts)
    # via cloudbench_export_controller_github_token, then Contents-validated
    # resolve_github_token inside warm_source_fetch_ref. Bound hung sessions so
    # refresh-deps cannot sit on "git-syncing ..." forever (descend I-02).
    echo "🔄 git-syncing $REMOTE_REPO → $BENCH_REF ..."
    SYNC_SSH_TIMEOUT="${CLOUDBENCH_REFRESH_DEPS_SSH_TIMEOUT:-300}"
    set +e
    CLOUDBENCH_SSH_EXEC_TIMEOUT="$SYNC_SSH_TIMEOUT" \
      warm_source_fetch_ref "$mid" "$EXPECTED_REF"
    sync_rc=$?
    set -e
    if [ "$sync_rc" -eq 124 ]; then
        echo "❌ exact remote checkout failed: ssh_exec timed out after ${SYNC_SSH_TIMEOUT}s" >&2
        exit 1
    fi
    if [ "$sync_rc" -ne 0 ]; then
        echo "❌ exact remote checkout failed" >&2
        exit 1
    fi

    if [ -n "$REFRESH_PATCH_FILE" ]; then
        warm_source_apply_patch "$mid" "$REFRESH_PATCH_FILE" "$REFRESH_PATCH_SHA256" || exit 1
    fi

    echo "📦 rebuilding/syncing warm dependency trees for the exact checked-out ref ..."
    DEPS_CMD="set -e
chown -R rose:rose '$REMOTE_REPO' 2>/dev/null || true
gosu rose env HOME=/home/rose CLOUDBENCH_REBUILD_DEPS=1 \
  bash '$REMOTE_REPO/scripts/cloudbench-sync-deps.sh' /app '$REMOTE_REPO'
source '$REMOTE_REPO/scripts/lib/cloudbench-env.sh'
REMOTE_REF=\$(git -c safe.directory='$REMOTE_REPO' -C '$REMOTE_REPO' rev-parse HEAD)
REMOTE_NODE_FP=\$(cloudbench_node_dependency_fingerprint '$REMOTE_REPO')
REMOTE_PY_FP=\$(cloudbench_manifest_fingerprint '$REMOTE_REPO' \"\${CLOUDBENCH_PYTHON_MANIFESTS[@]}\")
echo \"::DEPS-REMOTE-REF::\$REMOTE_REF\"
echo \"::DEPS-REMOTE-NODE::\$REMOTE_NODE_FP\"
echo \"::DEPS-REMOTE-PY::\$REMOTE_PY_FP\"
# The donor is stopped by signal and snapshotted next; write back the synced
# checkout and dependency trees first (see the native WMH refresh flush).
sync -f '$REMOTE_REPO'
sync
echo '::DEPS-REFRESH-DONE::'"
    DEPS_LOG="$(mktemp)"
    ssh_exec "$mid" "$DEPS_CMD" 2>&1 | grep -av '^Connecting to' | tee "$DEPS_LOG" | sed 's/^/   /'
    if ! grep -q '::DEPS-REFRESH-DONE::' "$DEPS_LOG" 2>/dev/null; then
        rm -f "$DEPS_LOG"
        echo "❌ dependency refresh did not report completion (see output above)."
        exit 1
    fi
    REMOTE_REF="$(sed -n 's/^::DEPS-REMOTE-REF:://p' "$DEPS_LOG" | tail -1)"
    REMOTE_NODE_FP="$(sed -n 's/^::DEPS-REMOTE-NODE:://p' "$DEPS_LOG" | tail -1)"
    REMOTE_PY_FP="$(sed -n 's/^::DEPS-REMOTE-PY:://p' "$DEPS_LOG" | tail -1)"
    rm -f "$DEPS_LOG"
    if [ "$REMOTE_REF" != "$EXPECTED_REF" ] \
        || [ "$REMOTE_NODE_FP" != "$EXPECTED_NODE_FP" ] \
        || [ "$REMOTE_PY_FP" != "$EXPECTED_PY_FP" ]; then
        echo "❌ remote dependency state did not match the exact local ref/fingerprints" >&2
        echo "   ref expected=$EXPECTED_REF remote=${REMOTE_REF:-<missing>}" >&2
        echo "   node expected=$EXPECTED_NODE_FP remote=${REMOTE_NODE_FP:-<missing>}" >&2
        echo "   python expected=$EXPECTED_PY_FP remote=${REMOTE_PY_FP:-<missing>}" >&2
        exit 1
    fi

    # Stop and verify before snapshotting so the volume is provably quiescent.
    stop_machine_strict "$mid" || exit 1
    mid=""

    VOL_ID="$(FLY machines list -a "$APP" --json 2>/dev/null | MN="$MACHINE_NAME" python3 -c '
import json, os, sys
for m in json.load(sys.stdin) or []:
    if m.get("name") == os.environ["MN"]:
        mounts = m.get("config", {}).get("mounts") or []
        if mounts: print(mounts[0].get("volume", ""))
        break
')"
    [ -n "$VOL_ID" ] || { echo "❌ could not resolve the warm volume id"; exit 1; }

    SNAP_START_EPOCH="$(date +%s)"
    create_volume_snapshot_exact "$VOL_ID" || exit 1
    NEW_SNAP="$CREATED_SNAPSHOT_ID"

    # Record what the snapshot now carries so fleet preflights can prove
    # freshness without mounting anything. Shared across sibling workspaces
    # via the git-common dir (same pattern as pool claims).
    printf '%s %s %s %s\n' "$EXPECTED_NODE_FP" "$EXPECTED_PY_FP" "$SNAP_START_EPOCH" "$NEW_SNAP" \
        > "$WARM_DEPS_STATE_FILE"
    # Beside the four-field proof (its format is shared with older readers),
    # record the exact verified source ref this snapshot was produced from.
    # Sharded runs reuse a snapshot only for their own exact ref; a patched
    # workspace is not that ref, so it leaves no receipt.
    rm -f "$WARM_DEPS_STATE_FILE.ref"
    if [ -z "$REFRESH_PATCH_FILE" ]; then
        printf '%s %s\n' "$EXPECTED_REF" "$NEW_SNAP" > "$WARM_DEPS_STATE_FILE.ref.$$" \
            && mv -f "$WARM_DEPS_STATE_FILE.ref.$$" "$WARM_DEPS_STATE_FILE.ref"
    fi
    if ! cloudbench_publish_warm_deps_state "$APP" "$maintenance_mid" "$VOL_ID" \
        "$EXPECTED_NODE_FP" "$EXPECTED_PY_FP" "$SNAP_START_EPOCH" "$NEW_SNAP"; then
        echo "⚠️  shared dependency proof publication failed; this checkout retains its verified snapshot" >&2
    fi
    echo "✅ warm volume deps refreshed; fresh snapshot: $NEW_SNAP"
    echo "   state: $WARM_DEPS_STATE_FILE"
    exit 0
fi

# ═════════════════════════════════════════════════════════════════════════════
# MODE: --refresh-wmh — (re)build the cached WMH model on /data/world-model.
# This is the ONLY place the model is (re)built. NOT per run.
# ═════════════════════════════════════════════════════════════════════════════
if [ "$MODE" = "refresh-wmh" ]; then
    # Refresh the complete eligible archive by default. Operators may still set
    # a positive value for a deliberately scoped diagnostic refresh, but normal
    # maintenance must not silently omit valid trajectories.
    WMH_REFRESH_MAX_BUNDLES="${WMH_REFRESH_MAX_BUNDLES:-0}"
    case "$WMH_REFRESH_MAX_BUNDLES" in
        ''|*[!0-9]*)
            echo "❌ WMH_REFRESH_MAX_BUNDLES must be a non-negative integer." >&2
            exit 2
            ;;
    esac
    # Explicit diagnostic step controls. Both default to unlimited so normal
    # maintenance embeds every completed step from every eligible bundle.
    WMH_REFRESH_MAX_STEPS="${WMH_REFRESH_MAX_STEPS:-0}"
    WMH_REFRESH_MAX_STEPS_PER_BUNDLE="${WMH_REFRESH_MAX_STEPS_PER_BUNDLE:-0}"
    for _wmh_cap in WMH_REFRESH_MAX_STEPS WMH_REFRESH_MAX_STEPS_PER_BUNDLE; do
        case "${!_wmh_cap}" in
            ''|*[!0-9]*)
                echo "❌ $_wmh_cap must be a non-negative integer." >&2
                exit 2
                ;;
        esac
    done
    # An explicit corpus makes a one-trace ingestion proof attributable: retain
    # the exact prior delta-index roots and admit one named live root, instead of
    # relying on whichever UUIDs happen to fit the archive cap. Restrict values
    # to UUIDs because this string crosses the remote maintenance shell.
    WMH_REFRESH_ROOT_AGENT_IDS="${WMH_REFRESH_ROOT_AGENT_IDS:-}"
    if [ -n "$WMH_REFRESH_ROOT_AGENT_IDS" ]; then
        IFS=',' read -r -a _wmh_refresh_roots <<< "$WMH_REFRESH_ROOT_AGENT_IDS"
        for _wmh_root in "${_wmh_refresh_roots[@]}"; do
            if [[ ! "$_wmh_root" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]; then
                echo "❌ WMH_REFRESH_ROOT_AGENT_IDS must be comma-separated UUIDs (bad value: $_wmh_root)." >&2
                exit 2
            fi
        done
        if [ "$WMH_REFRESH_MAX_BUNDLES" -gt 0 ] \
            && [ "${#_wmh_refresh_roots[@]}" -gt "$WMH_REFRESH_MAX_BUNDLES" ]; then
            echo "❌ explicit WMH root count exceeds WMH_REFRESH_MAX_BUNDLES; raise the cap or set it to 0." >&2
            exit 2
        fi
    fi
    echo "═══ run-bench-cloud --refresh-wmh ═══"
    echo "engine=$WMH_ENGINE cache=$WMH_CACHE_NAME pool=$WMH_ROSE_POOL policy=$WMH_EXECUTION_POLICY"
    echo "model=$WMH_MODEL_NAME target=$REMOTE_WMH max_bundles=$WMH_REFRESH_MAX_BUNDLES max_steps=$WMH_REFRESH_MAX_STEPS max_steps_per_bundle=$WMH_REFRESH_MAX_STEPS_PER_BUNDLE"
    [ -n "$WMH_REFRESH_ROOT_AGENT_IDS" ] \
        && echo "explicit_roots=${#_wmh_refresh_roots[@]} (strict corpus selection)"
    echo ""
    ensure_app
    cleanup_refresh_wmh() {
        park_warm_source "${mid:-${maintenance_mid:-}}" || true
        release_app_environment_lock
    }
    trap cleanup_refresh_wmh EXIT
    trap 'cleanup_refresh_wmh; exit 130' INT
    trap 'cleanup_refresh_wmh; exit 143' TERM
    CLOUDBENCH_HOLD_APP_ENV_LOCK=1
    # Exclusive donor maintenance, but never restage the shared app secrets:
    # restaging from this checkout's env reverted every concurrent guest to the
    # prod Temporal namespace (2026-10-19). The donor already carries the app's
    # R2 credentials; rotate them only with an explicit --refresh-secrets.
    acquire_app_environment_lock || exit 1
    verify_app_environment || exit 1

    mid="$(resolve_machine_id)"
    [ -z "$mid" ] && { echo "❌ No persistent machine — run 'run-bench-cloud --setup' first."; exit 1; }
    write_state "$mid"

    # The snapshot this refresh cuts carries the donor's CURRENT dependency
    # trees, so it may only be republished under the fingerprints of the newest
    # donor proof — never this checkout's local receipt, which a peer devbox's
    # dependency refresh can have superseded (the lock is per clone, not global).
    # Resolve it before touching the donor; it is re-checked before publication.
    # Begin WMH donor dependency proof.
    wmh_refresh_donor_proof() {  # → "node python epoch snapshot volume"
        local inventory volume proof
        inventory="$(FLY machines list -a "$APP" --json 2>/dev/null)" || return 1
        volume="$(printf '%s' "$inventory" | ID="$maintenance_mid" python3 -c '
import json, os, sys
for m in json.load(sys.stdin) or []:
    if m.get("id") == os.environ["ID"]:
        mounts = (m.get("config") or {}).get("mounts") or []
        print(mounts[0].get("volume", "") if len(mounts) == 1 else "")
')" || return 1
        [ -n "$volume" ] || return 1
        proof="$(printf '%s' "$inventory" | cloudbench_warm_deps_latest_proof "$APP" "$maintenance_mid" "$volume")" || return 1
        printf '%s %s\n' "$proof" "$volume"
    }
    # End WMH donor dependency proof.
    maintenance_mid="$mid"
    if ! WMH_DONOR_PROOF="$(wmh_refresh_donor_proof)"; then
        echo "❌ the donor publishes no dependency proof for its volume; run --refresh-deps first" >&2
        exit 1
    fi
    read -r RECORDED_NODE_FP RECORDED_PY_FP _ _ VOL_ID <<< "$WMH_DONOR_PROOF"
    prepare_warm_source "$mid" || exit 1
    require_machine_ready "$mid" || exit 1

    # Sync the repo first so the WMH build uses the current branch's builder code.
    # Prefer the shared warm_source_fetch_ref helper (SHA-pinned, fail-closed).
    echo "🔄 git-syncing $REMOTE_REPO → $BENCH_REF (so the WMH build uses current builder code) ..."
    if ! EXPECTED_WMH_REF="$(git -C "$ROOT_DIR" rev-parse --verify "${BENCH_REF}^{commit}" 2>/dev/null)"; then
        echo "❌ invalid benchmark ref: $BENCH_REF is not a local commit" >&2
        exit 1
    fi
    warm_source_fetch_ref "$mid" "$EXPECTED_WMH_REF" || exit 1
    echo ""
    # Native (default): the small donor never builds. The model is built on a big
    # owned machine and published with `wmh_build_cache push --serving-only`; here
    # the donor restores that serving-only cache, and pre-creates the native venv
    # (and its uv-managed Python) on the volume so guests never install at run time.
    # The cache is restored and verified beside the live tree, then swapped into
    # its own directory: the legacy model under $REMOTE_WMH, which other
    # workspaces' guests still serve, is never replaced (2026-10-19 a --force
    # restore into $REMOTE_WMH deleted rose-r2-archive-anthropic from the donor).
    NATIVE_REFRESH_CMD="set -e
[ -n \"\${AGENTS_ENV_B64:-}\" ] && echo \"\$AGENTS_ENV_B64\" | base64 -d > '$REMOTE_REPO/agents/.env'
[ -n \"\${BACKEND_ENV_B64:-}\" ] && echo \"\$BACKEND_ENV_B64\" | base64 -d > '$REMOTE_REPO/back-end/.env'
chown rose:rose '$REMOTE_REPO/agents/.env' '$REMOTE_REPO/back-end/.env' 2>/dev/null || true
[ -x '$REMOTE_REPO/agents/venv/bin/python' ] || rsync -a /app/agents/venv/ '$REMOTE_REPO/agents/venv/'
mkdir -p '$REMOTE_REPO/.context' '$REMOTE_UV_PYTHON'
chown -R rose:rose '$REMOTE_REPO/agents/venv' '$REMOTE_REPO/.context' '$REMOTE_UV_PYTHON' 2>/dev/null || true
cd '$REMOTE_REPO'
[ -x agents/venv/bin/uv ] || gosu rose env HOME=/home/rose agents/venv/bin/python -m pip install --quiet uv
gosu rose env HOME=/home/rose UV_PYTHON_INSTALL_DIR='$REMOTE_UV_PYTHON' UV_CACHE_DIR=/tmp/rose-uv-cache UV_LINK_MODE=copy bash scripts/setup-world-model.sh
cd agents
# A streaming pull stages beside its target and needs the cache's full size free
# there (the previous tree stays until the swap): fail before pulling otherwise.
# An optional third path counts as free: the caller would delete it first.
wmh_require_room() {
    local need avail reclaim=0
    need=\$(PYTHONDONTWRITEBYTECODE=1 venv/bin/python -u -m benchmarks.wmh_build_cache status --name \"\$1\" | venv/bin/python -c 'import json, sys; print(int(json.load(sys.stdin)[\"plaintext_bytes\"]))') || { echo \"cannot read the published size of WMH cache \$1\" >&2; return 1; }
    avail=\$(df -PB1 \"\$(dirname \"\$2\")\" | awk 'NR == 2 { print \$4 }')
    if [ -n \"\${3:-}\" ]; then
        reclaim=\$(du -sB1 \"\$3\" | awk 'NR == 1 { print \$1 }') && [ -n \"\$reclaim\" ] || { echo \"cannot measure \$3\" >&2; return 1; }
        avail=\$((\${avail:-0} + reclaim))
    fi
    if ! [ \"\$avail\" -ge \$((need + 1073741824)) ] 2>/dev/null; then
        echo \"insufficient donor disk for WMH cache \$1: needs \$need bytes + 1 GiB margin beside \$2, \${avail:-unknown} bytes free\" >&2
        return 1
    fi
    echo \"disk headroom ok for \$1: \$need bytes needed, \$avail free\"
}
# The legacy model (main's default engine) must survive beside the native one.
# Restore it atomically only when it is missing or was replaced by another model.
if [ -f '$REMOTE_WMH/build.manifest.json' ] && [ -d '$REMOTE_WMH/models/$WMH_LEGACY_MODEL_NAME' ] && [ ! -e '$REMOTE_WMH/models/$WMH_LEGACY_MODEL_NAME/experiential.json' ]; then
    echo 'legacy WMH model $WMH_LEGACY_MODEL_NAME intact at $REMOTE_WMH; leaving it'
else
    echo 'legacy WMH model $WMH_LEGACY_MODEL_NAME missing at $REMOTE_WMH; restoring cache $WMH_LEGACY_CACHE_NAME'
    rm -rf '$REMOTE_WMH.incoming' '$REMOTE_WMH.incoming'.replaced-* '$REMOTE_WMH.previous'
    wmh_require_room '$WMH_LEGACY_CACHE_NAME' '$REMOTE_WMH.incoming'
    PYTHONDONTWRITEBYTECODE=1 venv/bin/python -u -m benchmarks.wmh_build_cache pull --build-dir '$REMOTE_WMH.incoming' --name '$WMH_LEGACY_CACHE_NAME' --force
    [ -f '$REMOTE_WMH.incoming/build.manifest.json' ] && [ -d '$REMOTE_WMH.incoming/models/$WMH_LEGACY_MODEL_NAME' ] || { rm -rf '$REMOTE_WMH.incoming'; echo 'restored cache $WMH_LEGACY_CACHE_NAME lacks build.manifest.json or models/$WMH_LEGACY_MODEL_NAME' >&2; exit 1; }
    chown -R rose:rose '$REMOTE_WMH.incoming'
    if [ -e '$REMOTE_WMH' ]; then mv '$REMOTE_WMH' '$REMOTE_WMH.previous'; fi
    mv '$REMOTE_WMH.incoming' '$REMOTE_WMH'
    rm -rf '$REMOTE_WMH.previous'
    echo 'restored legacy WMH model $WMH_LEGACY_MODEL_NAME at $REMOTE_WMH'
fi
rm -rf '$REMOTE_WMH_NATIVE.incoming' '$REMOTE_WMH_NATIVE.incoming'.replaced-* '$REMOTE_WMH_NATIVE.previous'
# A previous native tree (~16 GB) and its staged replacement do not both fit a
# 40 GB donor volume. This maintenance donor serves nothing and its snapshot is
# published only on success (fleets keep forking the previous snapshot until
# then), so drop the previous tree when the staged pull would not fit. Prove the
# drop frees enough first: a refresh that cannot fit keeps the previous tree.
if ! wmh_require_room '$WMH_CACHE_NAME' '$REMOTE_WMH_NATIVE.incoming'; then
    [ -e '$REMOTE_WMH_NATIVE' ] || exit 1
    wmh_require_room '$WMH_CACHE_NAME' '$REMOTE_WMH_NATIVE.incoming' '$REMOTE_WMH_NATIVE'
    echo 'dropping the previous native WMH tree at $REMOTE_WMH_NATIVE to make room for its replacement'
    rm -rf '$REMOTE_WMH_NATIVE'
    wmh_require_room '$WMH_CACHE_NAME' '$REMOTE_WMH_NATIVE.incoming'
fi
PYTHONDONTWRITEBYTECODE=1 venv/bin/python -u -m benchmarks.wmh_build_cache pull --build-dir '$REMOTE_WMH_NATIVE.incoming' --name '$WMH_CACHE_NAME' --force
[ -f '$REMOTE_WMH_NATIVE.incoming/models/$WMH_MODEL_NAME/experiential.json' ] || { rm -rf '$REMOTE_WMH_NATIVE.incoming'; echo 'restored cache $WMH_CACHE_NAME lacks models/$WMH_MODEL_NAME/experiential.json' >&2; exit 1; }
[ -f '$REMOTE_WMH_NATIVE.incoming/build.manifest.json' ] || { rm -rf '$REMOTE_WMH_NATIVE.incoming'; echo 'restored cache $WMH_CACHE_NAME lacks build.manifest.json' >&2; exit 1; }
chown -R rose:rose '$REMOTE_WMH_NATIVE.incoming'
if [ -e '$REMOTE_WMH_NATIVE' ]; then mv '$REMOTE_WMH_NATIVE' '$REMOTE_WMH_NATIVE.previous'; fi
mv '$REMOTE_WMH_NATIVE.incoming' '$REMOTE_WMH_NATIVE'
rm -rf '$REMOTE_WMH_NATIVE.previous'
# The donor is stopped and snapshotted right after this; flush every restored
# byte first (2026-10-20 an unflushed blob tail was snapshotted truncated).
sync -f '$REMOTE_WMH_NATIVE'
sync
echo '::WMH-REFRESH-DONE::'
ls -la '$REMOTE_WMH/models' '$REMOTE_WMH_NATIVE/models' 2>/dev/null || true
df -h /data 2>/dev/null || true"
    # Legacy (explicit WMH_ENGINE=legacy): decode secrets into the checkout .env,
    # mirror deps if needed, then run the WMH build. This is the ONLY place
    # update_world_model_for_simulation() runs cloud-side. Runs as rose from the
    # agents dir with the cached-model build root.
    BUILD_CMD="set -e
# decode env for R2 creds the corpus read needs
[ -n \"\${AGENTS_ENV_B64:-}\" ] && echo \"\$AGENTS_ENV_B64\" | base64 -d > '$REMOTE_REPO/agents/.env'
[ -n \"\${BACKEND_ENV_B64:-}\" ] && echo \"\$BACKEND_ENV_B64\" | base64 -d > '$REMOTE_REPO/back-end/.env'
chown rose:rose '$REMOTE_REPO/agents/.env' '$REMOTE_REPO/back-end/.env' 2>/dev/null || true
# mirror baked venv if the checkout lacks it
[ -x '$REMOTE_REPO/agents/venv/bin/python' ] || rsync -a /app/agents/venv/ '$REMOTE_REPO/agents/venv/'
mkdir -p '$REMOTE_WMH'
chown -R rose:rose '$REMOTE_WMH' '$REMOTE_REPO/agents/venv' 2>/dev/null || true
cd '$REMOTE_REPO/agents'
gosu rose env HOME=/home/rose WMH_BUILD_DIR='$REMOTE_WMH' WMH_MODEL_NAME='$WMH_MODEL_NAME' WMH_ENGINE='$WMH_ENGINE' WMH_ROSE_POOL='$WMH_ROSE_POOL' WMH_CONTEXT_TOKENS='$WMH_CONTEXT_TOKENS' WMH_EXECUTION_POLICY='$WMH_EXECUTION_POLICY' WMH_GEPA_BUDGET=0 WMH_MAX_BUNDLES='$WMH_REFRESH_MAX_BUNDLES' WMH_MAX_STEPS='$WMH_REFRESH_MAX_STEPS' WMH_MAX_STEPS_PER_BUNDLE='$WMH_REFRESH_MAX_STEPS_PER_BUNDLE' WMH_ROOT_AGENT_IDS='$WMH_REFRESH_ROOT_AGENT_IDS' WMH_CONFORMANCE_EXAMPLES=100 WMH_REQUIRE_CONFORMANCE=1 \\
  venv/bin/python -u -c \"from benchmarks.world_model_harness import update_world_model_for_simulation as u; import json, os; ids=[value for value in os.environ.get('WMH_ROOT_AGENT_IDS', '').split(',') if value]; print(json.dumps(u(root_agent_ids=ids or None, progress=lambda e: print('[WMH]', e.get('title'), e.get('status'), flush=True))))\"
echo '::WMH-REFRESH-DONE::'
ls -la '$REMOTE_WMH/models' 2>/dev/null || true"
    if [ "$WMH_ENGINE" = experiential ]; then
        echo "🌍 Restoring native WMH cache $WMH_CACHE_NAME → $REMOTE_WMH_NATIVE (model $WMH_MODEL_NAME; no on-box build) ..."
        BUILD_CMD="$NATIVE_REFRESH_CMD"
    else
        echo "🌍 Building the legacy WMH model on the box → $REMOTE_WMH (WMH_GEPA_BUDGET=0 index-only) ..."
    fi
    REFRESH_LOG="$(mktemp)"
    ssh_exec "$mid" "$BUILD_CMD" 2>&1 | grep -av '^Connecting to' | tee "$REFRESH_LOG" | sed 's/^/   /'
    if grep -q '::WMH-REFRESH-DONE::' "$REFRESH_LOG" 2>/dev/null; then
        echo ""
        echo "✅ WMH model ($WMH_ENGINE) refreshed + cached at $REMOTE_WMH (served-not-rebuilt on every future run)."
        rm -f "$REFRESH_LOG"
    else
        echo ""
        echo "❌ WMH refresh did not report completion (see output above)."
        rm -f "$REFRESH_LOG"
        exit 1
    fi

    # Fleet clones fork a snapshot, not the mutable warm volume. Publish the exact rebuilt
    # volume only after the model reported ready and the source is proven quiescent; otherwise
    # successful maintenance silently leaves every benchmark on the previous WMH corpus.
    stop_machine_strict "$mid" || exit 1
    mid=""
    # A peer dependency refresh during this window replaced the volume's trees:
    # never publish this snapshot under the fingerprints read at the start.
    if ! WMH_DONOR_PROOF_AFTER="$(wmh_refresh_donor_proof)" \
        || [ "$WMH_DONOR_PROOF_AFTER" != "$WMH_DONOR_PROOF" ]; then
        echo "❌ the donor dependency proof changed during the WMH refresh; not cutting or publishing a snapshot" >&2
        exit 1
    fi
    SNAP_START_EPOCH="$(date +%s)"
    create_volume_snapshot_exact "$VOL_ID" || exit 1
    NEW_SNAP="$CREATED_SNAPSHOT_ID"
    printf '%s %s %s %s\n' "$RECORDED_NODE_FP" "$RECORDED_PY_FP" "$SNAP_START_EPOCH" \
        "$NEW_SNAP" > "$WARM_DEPS_STATE_FILE"
    printf '%s %s\n' "$EXPECTED_WMH_REF" "$NEW_SNAP" > "$WARM_DEPS_STATE_FILE.ref.$$" \
        && mv -f "$WARM_DEPS_STATE_FILE.ref.$$" "$WARM_DEPS_STATE_FILE.ref"
    # Fleets rehydrate the donor proof from its Machine metadata, not this
    # checkout's file: without publishing, every SIM clone keeps forking the
    # previous snapshot (and its previous WMH model).
    if ! cloudbench_publish_warm_deps_state "$APP" "$maintenance_mid" "$VOL_ID" \
        "$RECORDED_NODE_FP" "$RECORDED_PY_FP" "$SNAP_START_EPOCH" "$NEW_SNAP"; then
        echo "❌ WMH snapshot $NEW_SNAP was cut but its donor proof was not published; fleets would keep the previous model" >&2
        exit 1
    fi
    echo "✅ WMH model snapshot published for fleet clones: $NEW_SNAP"

    # EXIT trap parks the already-stopped source machine.
    exit 0
fi

# ═════════════════════════════════════════════════════════════════════════════
# MODE: --build-wmh — build the native WMH model on an OWNED, ephemeral big
# Machine + Volume forked from the donor's proven snapshot, publish the
# serving-only cache (what --refresh-wmh restores) and the full cache (the base
# of the next incremental build), then destroy both resources. The donor itself
# is never started, synced or modified here.
# ═════════════════════════════════════════════════════════════════════════════
# Begin WMH build lifecycle.
WMH_BUILD_VM_SIZE="${WMH_BUILD_VM_SIZE:-performance-8x}"
WMH_BUILD_VM_MEMORY_MB="${WMH_BUILD_VM_MEMORY_MB:-65536}"
WMH_BUILD_VOLUME_GB="${WMH_BUILD_VOLUME_GB:-80}"
WMH_BUILD_TIMEOUT_SECONDS="${WMH_BUILD_TIMEOUT_SECONDS:-14400}"
WMH_BUILD_POLL_SECONDS="${WMH_BUILD_POLL_SECONDS:-60}"
WMH_BUILD_RELEASE_ATTEMPTS="${WMH_BUILD_RELEASE_ATTEMPTS:-90}"
WMH_BUILD_RELEASE_SLEEP_SECONDS="${WMH_BUILD_RELEASE_SLEEP_SECONDS:-2}"
WMH_FULL_CACHE_NAME="${WMH_FULL_CACHE_NAME:-rose-archive-native}"
WMH_EXPORT_CACHE_NAME="${WMH_EXPORT_CACHE_NAME:-}"
# A rose-owned parent: wmh_build_cache pull stages its temp dir beside the build dir.
WMH_BUILD_REMOTE_ROOT="${WMH_BUILD_REMOTE_ROOT:-/data/wmhb}"
WMH_BUILD_REMOTE_DIR="$WMH_BUILD_REMOTE_ROOT/native"
WMH_BUILD_REMOTE_SCRIPT="/data/wmh-build.sh"
WMH_BUILD_REMOTE_LOG="/data/wmh-build.log"
WMH_BUILD_REMOTE_PID="/data/wmh-build.pid"
WMH_BUILD_LEDGER=""
WMH_BUILD_DONOR_MID=""
WMH_BUILD_DONOR_VOLUME=""
WMH_BUILD_TORN_DOWN=0

wmh_build_validate() {
    local key
    for key in WMH_BUILD_VM_MEMORY_MB WMH_BUILD_VOLUME_GB WMH_BUILD_TIMEOUT_SECONDS \
        WMH_BUILD_RELEASE_ATTEMPTS; do
        [[ "${!key}" =~ ^[1-9][0-9]*$ ]] || { echo "❌ $key must be a positive integer" >&2; return 2; }
    done
    for key in WMH_BUILD_POLL_SECONDS WMH_BUILD_RELEASE_SLEEP_SECONDS; do
        [[ "${!key}" =~ ^[0-9]+$ ]] || { echo "❌ $key must be a non-negative integer" >&2; return 2; }
    done
    # The full archive export plus the forked repo/deps tree outgrew smaller volumes.
    [ "$WMH_BUILD_VOLUME_GB" -ge 80 ] || { echo "❌ WMH_BUILD_VOLUME_GB must be at least 80" >&2; return 2; }
    [[ "$WMH_BUILD_VM_SIZE" =~ ^[a-z0-9-]+$ ]] || { echo "❌ invalid WMH_BUILD_VM_SIZE" >&2; return 2; }
    for key in WMH_FULL_CACHE_NAME WMH_EXPORT_CACHE_NAME; do
        [ -z "${!key}" ] && [ "$key" = WMH_EXPORT_CACHE_NAME ] && continue
        [[ "${!key}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || { echo "❌ invalid $key" >&2; return 2; }
    done
    [ "$WMH_ENGINE" = experiential ] || { echo "❌ --build-wmh builds the native experiential model only" >&2; return 2; }
}

# Durable ownership ledger: every intent and exact ID is fsynced BEFORE use, so
# teardown (or a human after a controller crash) can release exactly this run's
# resources and nothing else.
wmh_build_record() {  # wmh_build_record <key> <value>
    printf '%s=%s\n' "$1" "$2" >> "$WMH_BUILD_LEDGER" || return 1
    python3 -c 'import os, sys
fd = os.open(sys.argv[1], os.O_RDONLY)
os.fsync(fd); os.close(fd)' "$WMH_BUILD_LEDGER"
}

wmh_build_ledger_value() {  # wmh_build_ledger_value <key>
    [ -f "$WMH_BUILD_LEDGER" ] || return 0
    sed -n "s/^$1=//p" "$WMH_BUILD_LEDGER" | tail -1
}

wmh_build_not_donor() {  # wmh_build_not_donor <machine-or-volume-id>
    [ -n "$1" ] || return 1
    if [ "$1" = "$WMH_BUILD_DONOR_MID" ] || [ "$1" = "$WMH_BUILD_DONOR_VOLUME" ]; then
        echo "❌ refusing to operate on the shared donor resource $1" >&2
        return 1
    fi
}

# Print "<field> of the exact-name/ID match" from a provider listing; exit 3 when
# the listing itself is unreadable (never confuse that with "absent").
wmh_build_lookup() {  # wmh_build_lookup machines|volumes id|name <value> <field>
    local listing
    listing="$(FLY "$1" list -a "$APP" --json 2>/dev/null)" || return 3
    printf '%s' "$listing" | KEY="$2" VALUE="$3" FIELD="$4" python3 -c '
import json, os, sys
try:
    rows = json.load(sys.stdin) or []
except Exception:
    raise SystemExit(3)
matches = [r for r in rows if isinstance(r, dict) and r.get(os.environ["KEY"]) == os.environ["VALUE"]]
if len(matches) > 1:
    raise SystemExit(4)
if matches:
    print(matches[0].get(os.environ["FIELD"]) or "")
'
}

wmh_build_create_resources() {  # → sets WMH_BUILD_MID / WMH_BUILD_VOLUME
    local run_id="$1" snapshot="$2" image="$3" volume_name machine_name output
    volume_name="wmhb_$run_id"
    machine_name="wmhb-${run_id//_/-}"
    WMH_BUILD_MID=""
    WMH_BUILD_VOLUME=""
    wmh_build_record volume_name "$volume_name" || return 1
    echo "💽 Forking volume $volume_name (${WMH_BUILD_VOLUME_GB}GB) from donor snapshot $snapshot ..."
    output="$(FLY volumes create "$volume_name" -a "$APP" --region "$REGION" \
        --size "$WMH_BUILD_VOLUME_GB" --snapshot-id "$snapshot" --yes --json 2>&1)" || {
        printf '%s\n' "$output" | sed 's/^/   /' >&2
        echo "❌ volume fork failed" >&2
        return 1
    }
    WMH_BUILD_VOLUME="$(printf '%s' "$output" | python3 -c '
import json, sys
text = sys.stdin.read()
try:
    print(json.loads(text[text.index("{"):]).get("id") or "")
except Exception:
    print("")
')"
    [[ "$WMH_BUILD_VOLUME" =~ ^vol_[A-Za-z0-9]+$ ]] || {
        echo "❌ volume fork returned no exact ID" >&2
        WMH_BUILD_VOLUME=""
        return 1
    }
    wmh_build_not_donor "$WMH_BUILD_VOLUME" || return 1
    wmh_build_record volume_id "$WMH_BUILD_VOLUME" || return 1
    echo "   volume: $WMH_BUILD_VOLUME"
    wmh_build_record machine_name "$machine_name" || return 1
    echo "🖥️  Creating build machine $machine_name ($WMH_BUILD_VM_SIZE / ${WMH_BUILD_VM_MEMORY_MB}MB, process: sleep infinity) ..."
    # The process must outlive any build: a finite sleep exits and stops the box.
    output="$(FLY machine run "$image" -a "$APP" --name "$machine_name" --region "$REGION" \
        --vm-size "$WMH_BUILD_VM_SIZE" --vm-memory "$WMH_BUILD_VM_MEMORY_MB" \
        --volume "$WMH_BUILD_VOLUME:/data" --restart no \
        --metadata "wmh_build_run=$run_id" --detach sleep infinity 2>&1)" || {
        printf '%s\n' "$output" | sed 's/^/   /' >&2
        echo "❌ build machine creation failed" >&2
        return 1
    }
    WMH_BUILD_MID="$(printf '%s\n' "$output" | grep -oiE 'Machine ID: [0-9a-f]+' | tail -1 | awk '{print $3}')"
    [ -n "$WMH_BUILD_MID" ] || WMH_BUILD_MID="$(wmh_build_lookup machines name "$machine_name" id)" || WMH_BUILD_MID=""
    [[ "$WMH_BUILD_MID" =~ ^[0-9a-f]{8,32}$ ]] || {
        echo "❌ build machine creation returned no exact ID" >&2
        WMH_BUILD_MID=""
        return 1
    }
    wmh_build_not_donor "$WMH_BUILD_MID" || { WMH_BUILD_MID=""; return 1; }
    wmh_build_record machine_id "$WMH_BUILD_MID" || return 1
    echo "   machine: $WMH_BUILD_MID"
}

# Destroy exactly the ledger's resources and prove release. Idempotent; returns
# non-zero (with the ledger path) when either release is unproven.
wmh_build_teardown() {
    [ "$WMH_BUILD_TORN_DOWN" = 1 ] && return 0
    WMH_BUILD_TORN_DOWN=1
    [ -n "$WMH_BUILD_LEDGER" ] && [ -f "$WMH_BUILD_LEDGER" ] || return 0
    local mid vid name state attempt status=0
    mid="$(wmh_build_ledger_value machine_id)"
    vid="$(wmh_build_ledger_value volume_id)"
    # An ambiguous create recorded only its unique name; resolve that exact name.
    name="$(wmh_build_ledger_value machine_name)"
    if [ -z "$mid" ] && [ -n "$name" ]; then
        mid="$(wmh_build_lookup machines name "$name" id)" || { echo "❌ cannot resolve machine $name" >&2; status=1; mid=""; }
        [ -n "$mid" ] && wmh_build_not_donor "$mid" && wmh_build_record machine_id "$mid"
    fi
    name="$(wmh_build_ledger_value volume_name)"
    if [ -z "$vid" ] && [ -n "$name" ]; then
        vid="$(wmh_build_lookup volumes name "$name" id)" || { echo "❌ cannot resolve volume $name" >&2; status=1; vid=""; }
        [ -n "$vid" ] && wmh_build_not_donor "$vid" && wmh_build_record volume_id "$vid"
    fi
    if [ -n "$mid" ] && wmh_build_not_donor "$mid"; then
        echo "🧹 Destroying build machine $mid ..."
        FLY machine destroy --force "$mid" -a "$APP" 2>&1 | sed 's/^/   /' || true
        state="unknown"
        for attempt in $(seq 1 "$WMH_BUILD_RELEASE_ATTEMPTS"); do
            state="$(wmh_build_lookup machines id "$mid" state)" || state="unknown"
            case "$state" in ''|destroyed) state=released; break ;; esac
            [ "$attempt" = 15 ] && FLY machine destroy --force "$mid" -a "$APP" >/dev/null 2>&1
            sleep "$WMH_BUILD_RELEASE_SLEEP_SECONDS"
        done
        if [ "$state" = released ]; then
            wmh_build_record machine_released destroyed
        else
            echo "❌ build machine $mid release unproven (state=$state)" >&2
            status=1
        fi
    elif [ -n "$mid" ]; then
        status=1
    fi
    if [ -n "$vid" ] && wmh_build_not_donor "$vid"; then
        echo "🧹 Destroying build volume $vid ..."
        state="unknown"
        for attempt in $(seq 1 "$WMH_BUILD_RELEASE_ATTEMPTS"); do
            state="$(wmh_build_lookup volumes id "$vid" state)" || state="unknown"
            case "$state" in ''|pending_destroy|destroyed) state="released:${state:-absent}"; break ;; esac
            # Fly rejects deletion until the destroyed machine detaches; retry.
            FLY volumes destroy "$vid" -a "$APP" --yes >/dev/null 2>&1 || true
            sleep "$WMH_BUILD_RELEASE_SLEEP_SECONDS"
        done
        if [ "${state%%:*}" = released ]; then
            wmh_build_record volume_released "${state#released:}"
        else
            echo "❌ build volume $vid release unproven (state=$state)" >&2
            status=1
        fi
    elif [ -n "$vid" ]; then
        status=1
    fi
    if [ "$status" -eq 0 ]; then
        echo "✅ Build machine + volume released (ledger: $WMH_BUILD_LEDGER)"
    else
        echo "❌ WMH build resources NOT proven released — reconcile exactly the IDs in $WMH_BUILD_LEDGER" >&2
    fi
    return "$status"
}

# The detached on-box job. Values are passed as a quoted header; the body is
# literal so it needs no escaping. Runs as root; every build step runs as rose.
wmh_build_remote_script() {
    printf 'B_REPO=%q\nB_UV_PYTHON=%q\nB_ROOT=%q\nB_DIR=%q\nB_PID=%q\n' \
        "$REMOTE_REPO" "$REMOTE_UV_PYTHON" "$WMH_BUILD_REMOTE_ROOT" "$WMH_BUILD_REMOTE_DIR" "$WMH_BUILD_REMOTE_PID"
    printf 'B_MODEL=%q\nB_POOL=%q\nB_POLICY=%q\nB_CONTEXT=%q\n' \
        "$WMH_MODEL_NAME" "$WMH_ROSE_POOL" "$WMH_EXECUTION_POLICY" "$WMH_CONTEXT_TOKENS"
    printf 'B_SERVING=%q\nB_FULL=%q\nB_EXPORT=%q\n' \
        "$WMH_CACHE_NAME" "$WMH_FULL_CACHE_NAME" "$WMH_EXPORT_CACHE_NAME"
    cat <<'WMH_BUILD_BODY'
set -euo pipefail
mkdir -p "$B_ROOT"
# A re-launch after an unconfirmed launch must never start a second build.
mkdir "$B_ROOT/.running" 2>/dev/null || { echo "[wmh-build] already running"; exit 0; }
echo $$ > "$B_PID"
trap 'rc=$?; [ "$rc" -eq 0 ] || echo "::WMH-BUILD-FAILED:: rc=$rc"' EXIT
step() { echo "[wmh-build] $(date -u +%H:%M:%SZ) $*"; }
as_rose() {
    gosu rose env HOME=/home/rose UV_PYTHON_INSTALL_DIR="$B_UV_PYTHON" UV_CACHE_DIR="$B_ROOT/uv-cache" \
        UV_LINK_MODE=copy PYTHONDONTWRITEBYTECODE=1 "$@"
}
cd "$B_REPO"
[ -s agents/.env ] || { echo "agents/.env is missing (R2 credentials)" >&2; exit 1; }
[ -x agents/venv/bin/python ] || rsync -a /app/agents/venv/ agents/venv/
mkdir -p "$B_UV_PYTHON" "$B_ROOT/uv-cache" .context
chown -R rose:rose "$B_ROOT" "$B_UV_PYTHON" .context agents/venv
step "native venv (uv-managed Python under $B_UV_PYTHON)"
[ -x agents/venv/bin/uv ] || as_rose agents/venv/bin/python -m pip install --quiet uv
as_rose bash scripts/setup-world-model.sh
cd agents
cache() { as_rose venv/bin/python -u -m benchmarks.wmh_build_cache "$@"; }
if [ -n "$B_EXPORT" ]; then
    step "pull export cache $B_EXPORT"
    cache pull --build-dir "$B_DIR" --name "$B_EXPORT" --force
    step "native build only (model $B_MODEL, pool $B_POOL)"
    as_rose env WMH_ENGINE=experiential WMH_ROSE_POOL="$B_POOL" WMH_EXECUTION_POLICY="$B_POLICY" \
        venv/bin/python -u -c 'import sys; from benchmarks.experiential_bridge import build_native; build_native(sys.argv[1], sys.argv[1], sys.argv[2], sys.argv[3])' \
        "$B_DIR" "$B_MODEL" "$B_POOL"
else
    status="$(cache status --name "$B_FULL" 2>&1)" && published=1 || published=0
    if [ "$published" = 1 ]; then
        step "pull full cache $B_FULL (only new bundles export)"
        cache pull --build-dir "$B_DIR" --name "$B_FULL" --force
    elif printf '%s' "$status" | grep -q "no cache published for"; then
        step "no full cache $B_FULL published: full build"
    else
        printf '%s\n' "$status" >&2
        echo "cannot read full cache $B_FULL" >&2
        exit 1
    fi
    step "update_world_model_for_simulation (model $B_MODEL)"
    as_rose env WMH_BUILD_DIR="$B_DIR" WMH_MODEL_NAME="$B_MODEL" WMH_ENGINE=experiential WMH_ROSE_POOL="$B_POOL" \
        WMH_CONTEXT_TOKENS="$B_CONTEXT" WMH_EXECUTION_POLICY="$B_POLICY" WMH_GEPA_BUDGET=0 WMH_MAX_BUNDLES=0 \
        WMH_CONFORMANCE_EXAMPLES=100 WMH_REQUIRE_CONFORMANCE=1 \
        venv/bin/python -u -c "from benchmarks.world_model_harness import update_world_model_for_simulation as u; import json; print(json.dumps(u(progress=lambda e: print('[WMH]', e.get('title'), e.get('status'), flush=True)), default=str))"
fi
[ -f "$B_DIR/models/$B_MODEL/experiential.json" ] || { echo "build lacks models/$B_MODEL/experiential.json" >&2; exit 1; }
[ -f "$B_DIR/build.manifest.json" ] || { echo "build lacks build.manifest.json" >&2; exit 1; }
step "push serving-only cache $B_SERVING"
cache push --serving-only --build-dir "$B_DIR" --name "$B_SERVING"
step "push full cache $B_FULL"
cache push --build-dir "$B_DIR" --name "$B_FULL"
echo "::WMH-BUILD-DONE::"
WMH_BUILD_BODY
}

# Poll the detached job's log with short reads; print new lines as progress.
wmh_build_poll() {  # wmh_build_poll <machine-id>
    local mid="$1" lines=0 deadline=$((SECONDS + WMH_BUILD_TIMEOUT_SECONDS))
    local out body total alive misses=0 dead=0
    while :; do
        out="$(ssh_read "$mid" "f='$WMH_BUILD_REMOTE_LOG'; t=\$(wc -l < \"\$f\" 2>/dev/null || echo 0); sed -n '$((lines + 1)),$((lines + 2000))p' \"\$f\" 2>/dev/null; p=\$(cat '$WMH_BUILD_REMOTE_PID' 2>/dev/null); if [ -n \"\$p\" ] && kill -0 \"\$p\" 2>/dev/null; then a=alive; else a=dead; fi; echo \"::WMH-LOG-END:: \$t \$a\"")" || out=""
        if printf '%s\n' "$out" | grep -q '^::WMH-LOG-END:: '; then
            misses=0
            body="$(printf '%s\n' "$out" | sed '/^::WMH-LOG-END:: /,$d')"
            read -r _ total alive <<< "$(printf '%s\n' "$out" | grep '^::WMH-LOG-END:: ' | tail -1)"
            [ -n "$body" ] && printf '%s\n' "$body" | sed 's/^/   /'
            [[ "$total" =~ ^[0-9]+$ ]] || total="$lines"
            lines=$(( total < lines + 2000 ? total : lines + 2000 ))
            if printf '%s\n' "$body" | grep -q '^::WMH-BUILD-DONE::'; then
                return 0
            fi
            if printf '%s\n' "$body" | grep -q '^::WMH-BUILD-FAILED::'; then
                echo "❌ on-box WMH build failed (log: $WMH_BUILD_REMOTE_LOG on $mid)" >&2
                return 1
            fi
            if [ "$alive" = dead ] && [ "$lines" -ge "$total" ]; then
                dead=$((dead + 1))
                [ "$dead" -ge 2 ] && {
                    echo "❌ on-box WMH build exited without a completion marker" >&2
                    return 1
                }
            else
                dead=0
            fi
        else
            misses=$((misses + 1))
            echo "   ⚠️ log read failed ($misses); machine state: $(machine_state "$mid")" >&2
            [ "$misses" -ge 10 ] && { echo "❌ build log unreadable 10 times in a row" >&2; return 1; }
        fi
        if [ "$SECONDS" -ge "$deadline" ]; then
            echo "❌ WMH build timed out after ${WMH_BUILD_TIMEOUT_SECONDS}s (WMH_BUILD_TIMEOUT_SECONDS)" >&2
            return 1
        fi
        sleep "$WMH_BUILD_POLL_SECONDS"
    done
}
# End WMH build lifecycle.

if [ "$MODE" = "build-wmh" ]; then
    wmh_build_validate || exit 2
    if ! WMH_BUILD_REF="$(git -C "$ROOT_DIR" rev-parse --verify "${BENCH_REF}^{commit}" 2>/dev/null)"; then
        echo "❌ invalid benchmark ref: $BENCH_REF is not a local commit" >&2
        exit 1
    fi
    validate_wmh_rose_pool_at_ref "$WMH_BUILD_REF" "$WMH_ROSE_POOL" || exit 2
    read -r _ _ _ WMH_BUILD_SNAPSHOT < "$WARM_DEPS_STATE_FILE" 2>/dev/null || true
    [ -n "${WMH_BUILD_SNAPSHOT:-}" ] || {
        echo "❌ no proven donor snapshot in $WARM_DEPS_STATE_FILE (run --refresh-deps first)" >&2
        exit 1
    }
    echo "═══ run-bench-cloud --build-wmh ═══"
    echo "ref=$WMH_BUILD_REF snapshot=$WMH_BUILD_SNAPSHOT vm=$WMH_BUILD_VM_SIZE/${WMH_BUILD_VM_MEMORY_MB}MB volume=${WMH_BUILD_VOLUME_GB}GB"
    echo "model=$WMH_MODEL_NAME pool=$WMH_ROSE_POOL policy=$WMH_EXECUTION_POLICY serving=$WMH_CACHE_NAME full=$WMH_FULL_CACHE_NAME export=${WMH_EXPORT_CACHE_NAME:-<none>}"
    ensure_app
    # Read-only: the build machine inherits the shared app secrets; never mutate them here.
    verify_app_environment || exit 1
    WMH_BUILD_DONOR_MID="$(resolve_machine_id)"
    [ -n "$WMH_BUILD_DONOR_MID" ] || { echo "❌ no donor machine $MACHINE_NAME to take the image from" >&2; exit 1; }
    read -r WMH_BUILD_IMAGE WMH_BUILD_DONOR_VOLUME <<< "$(_machines_json | ID="$WMH_BUILD_DONOR_MID" python3 -c '
import json, os, sys
for m in json.load(sys.stdin) or []:
    if m.get("id") == os.environ["ID"]:
        config = m.get("config") or {}
        mounts = config.get("mounts") or [{}]
        print(config.get("image") or "", mounts[0].get("volume") or "")
')"
    [ -n "${WMH_BUILD_IMAGE:-}" ] || { echo "❌ could not read the donor image" >&2; exit 1; }
    WMH_BUILD_RUN_ID="$(date -u +%Y%m%d%H%M%S)_$(printf '%04x' "$((RANDOM % 65536))")"
    mkdir -p "$ROOT_DIR/.context/wmh-build/$WMH_BUILD_RUN_ID" || exit 1
    WMH_BUILD_LEDGER="$ROOT_DIR/.context/wmh-build/$WMH_BUILD_RUN_ID/owned-resources.env"
    wmh_build_record app "$APP" || exit 1
    wmh_build_record source_snapshot "$WMH_BUILD_SNAPSHOT" || exit 1
    wmh_build_record donor_machine_id "$WMH_BUILD_DONOR_MID" || exit 1
    echo "ownership ledger: $WMH_BUILD_LEDGER"
    wmh_build_exit() {
        local rc=$?
        trap - EXIT INT TERM HUP
        wmh_build_teardown || rc=1
        exit "$rc"
    }
    trap wmh_build_exit EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP

    wmh_build_create_resources "$WMH_BUILD_RUN_ID" "$WMH_BUILD_SNAPSHOT" "$WMH_BUILD_IMAGE" || exit 1
    require_machine_ready "$WMH_BUILD_MID" || exit 1
    echo "🔄 checking out $WMH_BUILD_REF on the build machine ..."
    warm_source_fetch_ref "$WMH_BUILD_MID" "$WMH_BUILD_REF" || exit 1
    set +e   # warm_source_fetch_ref leaves errexit on; this mode handles failures explicitly.
    ssh_exec "$WMH_BUILD_MID" "set -e
[ -n \"\${AGENTS_ENV_B64:-}\" ] && echo \"\$AGENTS_ENV_B64\" | base64 -d > '$REMOTE_REPO/agents/.env'
[ -n \"\${BACKEND_ENV_B64:-}\" ] && echo \"\$BACKEND_ENV_B64\" | base64 -d > '$REMOTE_REPO/back-end/.env'
chown rose:rose '$REMOTE_REPO/agents/.env' '$REMOTE_REPO/back-end/.env'
rm -f '$WMH_BUILD_REMOTE_SCRIPT' '$WMH_BUILD_REMOTE_PID'
echo ::WMH-ENV-READY::" 300 2>&1 | grep -a '::WMH-ENV-READY::' >/dev/null || {
        echo "❌ could not stage the app env files on the build machine" >&2
        exit 1
    }
    WMH_BUILD_LOCAL_SCRIPT="$(mktemp)"
    wmh_build_remote_script > "$WMH_BUILD_LOCAL_SCRIPT"
    cloudbench_retry_command 5 3 FLY ssh sftp put -a "$APP" --machine "$WMH_BUILD_MID" -q -m 0700 \
        "$WMH_BUILD_LOCAL_SCRIPT" "$WMH_BUILD_REMOTE_SCRIPT" || {
        rm -f "$WMH_BUILD_LOCAL_SCRIPT"
        echo "❌ could not upload the build job" >&2
        exit 1
    }
    rm -f "$WMH_BUILD_LOCAL_SCRIPT"
    # Fly's exec API 408s on long commands and `ssh -C` mishandles background jobs: detach the
    # job on the box and poll its log with short reads instead.
    WMH_BUILD_LAUNCHED=0
    for _attempt in 1 2 3 4; do
        FLY ssh console -a "$APP" --machine "$WMH_BUILD_MID" \
            -C "bash -lc \"setsid nohup bash '$WMH_BUILD_REMOTE_SCRIPT' >> '$WMH_BUILD_REMOTE_LOG' 2>&1 < /dev/null &\"" >/dev/null 2>&1 || true
        sleep 5
        if ssh_read "$WMH_BUILD_MID" "p=\$(cat '$WMH_BUILD_REMOTE_PID' 2>/dev/null); [ -n \"\$p\" ] && kill -0 \"\$p\" && echo RUNNING; grep -q '^::WMH-BUILD-' '$WMH_BUILD_REMOTE_LOG' 2>/dev/null && echo RUNNING" \
            2>/dev/null | grep -q RUNNING; then
            WMH_BUILD_LAUNCHED=1
            break
        fi
        echo "   ⚠️ build job not confirmed (attempt $_attempt/4); re-launching"
    done
    [ "$WMH_BUILD_LAUNCHED" = 1 ] || { echo "❌ build job never started on $WMH_BUILD_MID" >&2; exit 1; }
    echo "🏗️  Build running on $WMH_BUILD_MID (log $WMH_BUILD_REMOTE_LOG; timeout ${WMH_BUILD_TIMEOUT_SECONDS}s)"
    wmh_build_poll "$WMH_BUILD_MID" || exit 1
    echo "✅ Native WMH built; published serving-only cache $WMH_CACHE_NAME and full cache $WMH_FULL_CACHE_NAME."
    echo "   Next: bash scripts/run-bench-cloud --refresh-wmh   (restores $WMH_CACHE_NAME onto the donor)"
    exit 0
fi

# ═════════════════════════════════════════════════════════════════════════════
# MODE: run (default) — the HANDS-OFF, WARM per-run path.
#   start warm machine → detach on-box driver → serve CACHED WMH → run_benchmark →
#   proxy the live dashboard to the Mac → poll /data/bench.log for DONE → retrieve
#   report-card.json + newest runs/*.json → STOP the machine.
# ═════════════════════════════════════════════════════════════════════════════
if [ "${#BENCH_TASKS[@]}" -eq 0 ]; then
    echo "❌ At least one benchmark task name is required." >&2
    echo "   e.g. bash scripts/run-bench-cloud spawn-sub-agents --simulate" >&2
    echo "        bash scripts/run-bench-cloud chat-mode spawn-sub-agents --simulate" >&2
    echo "   (Or use --setup / --refresh-wmh / --destroy.)" >&2
    exit 2
fi

# Resolve the complete requested batch against the same unified catalog used by
# Fleet and the on-box benchmark target.  One batch call is O(catalog + tasks),
# preserves task order, and fails before this run starts paid benchmark work.
if ! CATALOG_METADATA="$(python3 "$CLOUDBENCH_CATALOG_SCRIPT" metadata "$ROOT_DIR/agents/benchmarks/tasks.json" "${BENCH_TASKS[@]}")"; then
    echo "❌ Could not resolve benchmark watchdog metadata from the unified catalog." >&2
    exit 1
fi
if ! WATCHDOG_POLICY="$(printf '%s\n' "$CATALOG_METADATA" | cloudbench_watchdog_mode_from_metadata)"; then
    echo "❌ Could not derive a safe benchmark watchdog policy." >&2
    exit 1
fi
WATCHDOG_MODE="absolute"
WATCHDOG_TASK=""
WATCHDOG_BUDGET=""
IFS=$'\t' read -r WATCHDOG_MODE WATCHDOG_TASK WATCHDOG_BUDGET <<< "$WATCHDOG_POLICY"
case "$WATCHDOG_MODE" in
    absolute) ;;
    progress)
        if [ -z "$WATCHDOG_TASK" ] || [ -z "$WATCHDOG_BUDGET" ]; then
            echo "❌ Polar watchdog policy omitted its task or browser-step budget." >&2
            exit 1
        fi
        ;;
    *)
        echo "❌ Unknown benchmark watchdog policy: $WATCHDOG_MODE" >&2
        exit 1
        ;;
esac
if ! POLAR_PROGRESS_STALL_SECONDS="$(cloudbench_polar_stall_seconds "$RUN_TIMEOUT")"; then
    echo "❌ --timeout and CLOUDBENCH_POLAR_PROGRESS_STALL_SECONDS must be positive integers." >&2
    exit 2
fi

# Comma-joined task list for the on-box driver + human-readable display.
TASKS_CSV="$(IFS=,; echo "${BENCH_TASKS[*]}")"
TASKS_DISPLAY="${BENCH_TASKS[*]}"
NEEDS_IMESSAGE_RELAY="0"
for task_name in "${BENCH_TASKS[@]}"; do
    [ "$task_name" = "message-person" ] && NEEDS_IMESSAGE_RELAY="1"
done
IMESSAGE_RELAY_EXPECTED_PHONE="+19729777432"
IMESSAGE_RELAY_EXPECTED_MESSAGE="Hi! This is the Rose iMessage send bench."
# base64 the task list so it survives the base64/exec layers verbatim (printf %q
# escapes the comma to '\,', which the double-decode + `bash` re-parse mangled,
# dropping every task after the first).
TASKS_CSV_B64="$(printf '%s' "$TASKS_CSV" | base64 | tr -d '\n')"
# A direct run's workspace becomes its shared Temporal Cloud queue and Steel
# ownership marker. PID + second repeats across identical disposable hosts, so
# bind the fallback to a random identity rather than this process.
RUN_WORKSPACE_NAME="${CLOUDBENCH_WORKSPACE_NAME:-cloudbench-$(date -u +%Y%m%d%H%M%S)-$(python3 -c 'import uuid; print(uuid.uuid4().hex[:12])')}"
OBSERVED_PEAK_FLY_MACHINES="${CLOUDBENCH_OBSERVED_PEAK_FLY_MACHINES:-1}"

# Estimated Fly machine cost (USD/hour) for this bench's isolated VM, from its
# size + memory. Fly bills compute per shared-CPU tier + RAM per GB; these are
# published-rate ESTIMATES, overridable with CLOUDBENCH_VM_USD_PER_HOUR. Fed to
# run_benchmark as BENCHMARK_VM_USD_PER_HOUR → per-task/total infra_usd on the card.
VM_USD_PER_HOUR="$(CLOUDBENCH_VM_USD_PER_HOUR="${CLOUDBENCH_VM_USD_PER_HOUR:-}" VM_SIZE="$VM_SIZE" VM_MEMORY="$VM_MEMORY" python3 -c '
import os
override = os.environ.get("CLOUDBENCH_VM_USD_PER_HOUR", "").strip()
if override:
    print(override); raise SystemExit(0)
size = os.environ.get("VM_SIZE", "shared-cpu-4x")
try: mem_gb = float(os.environ.get("VM_MEMORY", "8192")) / 1024.0
except ValueError: mem_gb = 8.0
# shared-cpu-Nx compute ≈ N × $0.00288/hr ($0.0000008/s); RAM ≈ $0.00732/GB/hr ($5.34/GB/mo).
mult = 1
try:
    part = size.split("-")[-1].rstrip("x")
    mult = int(part) if part.isdigit() else 1
except Exception:
    mult = 1
perf = 4.0 if size.startswith("performance") else 1.0
print(round(mult * 0.00288 * perf + mem_gb * 0.00732, 5))
' 2>/dev/null || echo "0.07")"

echo "═══ run-bench-cloud (warm run) ═══"
echo "tasks=[$TASKS_DISPLAY] simulate=$BENCH_SIMULATE parallel=$BENCH_PARALLEL max_concurrency=$BENCH_MAX_CONCURRENCY"
echo "ref=${BENCH_REF:-<HEAD>} model=$WMH_MODEL_NAME engine=$WMH_ENGINE app=$APP dashboard=$DASHBOARD workspace=$RUN_WORKSPACE_NAME"
echo ""

# READ-ONLY env preflight (concurrent-workstream safe): the run path only
# verifies the prod-aligned app secrets exist — it never stages them. Fleet
# children inherit their controller's app/environment proof and perform no
# app-wide provider read; direct runs verify here.
if [ -n "$FLEET_MACHINE_ID" ]; then
    if [ "${CLOUDBENCH_ENV_VERIFIED:-0}" != "1" ]; then
        echo "❌ Fleet child has no controller environment-verification proof." >&2
        exit 1
    fi
    echo "🔎 App and environment verified by fleet controller."
else
    ensure_app
    verify_app_environment || exit 1
fi

mid="$(resolve_machine_id)"
if [ -z "$mid" ]; then
    echo "❌ No persistent machine found. Run one-time setup first:" >&2
    echo "     bash scripts/run-bench-cloud --setup" >&2
    echo "     bash scripts/run-bench-cloud --refresh-wmh" >&2
    exit 1
fi
write_state "$mid"

# ── Local dashboard handles (started once the run is in flight) ──────────────
PROXY_PID=""
DASHBOARD_PID=""
DASHBOARD_MIRROR_PID=""
IMESSAGE_RELAY_PID=""
stop_proxy() {
    # Proxy launch sites invoke the flyctl executable directly, so these are the
    # tunnel PIDs (not backgrounded FLY() wrapper subshells). Terminate and reap
    # them before releasing their port leases; otherwise an orphaned listener can
    # poison a later fleet with an address-in-use failure.
    cloudbench_proxy_stop PROXY_PID || true
    cloudbench_proxy_stop STATUS_PROXY_PID || true
    STATUS_PROXY_PID=""
    [ -n "$DASHBOARD_MIRROR_PID" ] && kill "$DASHBOARD_MIRROR_PID" 2>/dev/null || true
    if [ -n "$IMESSAGE_RELAY_PID" ]; then
        pkill -P "$IMESSAGE_RELAY_PID" 2>/dev/null || true
        kill "$IMESSAGE_RELAY_PID" 2>/dev/null || true
        wait "$IMESSAGE_RELAY_PID" 2>/dev/null || true
    fi
    PROXY_PID=""
    DASHBOARD_MIRROR_PID=""
    IMESSAGE_RELAY_PID=""
}

# Reap the live archive-frontend Vite (spawned on-demand by agent_link_server for
# during-run viewing). Its upstream is the ephemeral backend proxy, so once the run
# ends it is dead weight — the post-run static archive replaces it. Killing it keeps
# a single viewer alive at a time (no accumulating zombie Vites across runs).
stop_live_archive_frontend() {
    local pid_file="$OUT_DIR/archive-frontend-live.pid"
    if [ -f "$pid_file" ]; then
        local live_pid
        live_pid="$(cat "$pid_file" 2>/dev/null || true)"
        [ -n "$live_pid" ] && kill "$live_pid" 2>/dev/null || true
        rm -f "$pid_file" "$OUT_DIR/archive-frontend-live.json" 2>/dev/null || true
    fi
}

# Reap every local viewer this run started: the dashboard/link server and the
# static (post-run) archive supervisor. The viewer is intentionally run-scoped —
# clickable while the run is live, gone afterwards — so no process lingers.
stop_all_local_viewers() {
    [ -n "$DASHBOARD_PID" ] && kill "$DASHBOARD_PID" 2>/dev/null || true
    DASHBOARD_PID=""
    local pf
    for pf in "$OUT_DIR/cloudbench-live/agent-link-server.pid" \
              "$OUT_DIR/archive-frontend.pid"; do
        if [ -f "$pf" ]; then
            local vp
            vp="$(cat "$pf" 2>/dev/null || true)"
            [ -n "$vp" ] && kill "$vp" 2>/dev/null || true
            rm -f "$pf" 2>/dev/null || true
        fi
    done
    rm -f "$OUT_DIR/archive-frontend.json" 2>/dev/null || true
}

PORT_LEASE_ROOT="${TMPDIR:-/tmp}/rose-cloudbench-port-leases"
PORT_LEASE_NONCE="$RUN_LOG_TOKEN"
PORT_LEASE_HELPER="${CLOUDBENCH_SCRIPT_SNAPSHOT:-$ROOT_DIR/scripts}/cloudbench-port-lease.py"
PORT_LEASES=()

local_port_is_bindable() {
    python3 - "$1" <<'PY'
import socket
import sys

sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
try:
    sock.bind(("127.0.0.1", int(sys.argv[1])))
except OSError:
    raise SystemExit(1)
finally:
    sock.close()
PY
}

claim_exact_local_port() {  # claim_exact_local_port <port> <output-variable>
    local port="$1" output_var="$2" lease owner owner_pid stale_lease
    local port_min=1024 port_max=65535
    case "$port" in
        ''|*[!0-9]*) return 1 ;;
    esac
    port=$((10#$port))
    [ "$port" -ge "$port_min" ] && [ "$port" -le "$port_max" ] || return 1
    mkdir -p "$PORT_LEASE_ROOT"
    lease="$PORT_LEASE_ROOT/$port"
    if mkdir "$lease" 2>/dev/null; then
        if local_port_is_bindable "$port"; then
            printf '%s %s\n' "$$" "$PORT_LEASE_NONCE" > "$lease/owner"
            PORT_LEASES+=("$lease")
            printf -v "$output_var" '%s' "$port"
            return 0
        fi
        rmdir "$lease" 2>/dev/null || true
        return 1
    fi
    owner="$(cat "$lease/owner" 2>/dev/null || true)"
    owner_pid="${owner%% *}"
    if [ -n "$owner_pid" ] && ! kill -0 "$owner_pid" 2>/dev/null; then
        stale_lease="$PORT_LEASE_ROOT/.stale-$port-$$-$RANDOM-$RANDOM"
        if mv "$lease" "$stale_lease" 2>/dev/null; then
            rm -rf "$stale_lease" 2>/dev/null || true
        fi
    fi
    return 1
}

claim_local_port() {  # claim_local_port <preferred> <output-variable>
    local preferred="$1" output_var="$2" port lease owner owner_pid stale_lease
    local range_start range_end scan_phase
    local port_min=1024 port_max=65535 port_span
    case "$preferred" in
        ''|*[!0-9]*) return 1 ;;
    esac
    preferred=$((10#$preferred))
    port_span=$((port_max - port_min + 1))
    # Fleet preferences advance by a fixed stride per child and can exceed the
    # numeric TCP range at large widths. Map that preference into the valid
    # namespace before searching, preserving its deterministic distribution.
    preferred=$((port_min + ((preferred - port_min) % port_span + port_span) % port_span))
    mkdir -p "$PORT_LEASE_ROOT"
    # Search the complete unprivileged namespace exactly once, starting at the
    # caller's preferred port and wrapping at 65535. Dense concurrent/archive
    # viewers can legitimately occupy more than 100 adjacent ports; a fixed
    # window turns that local density into a fleet-wide boot-barrier failure.
    for scan_phase in 1 2; do
        if [ "$scan_phase" -eq 1 ]; then
            range_start="$preferred"
            range_end="$port_max"
        else
            range_start="$port_min"
            range_end=$((preferred - 1))
        fi
        [ "$range_start" -le "$range_end" ] || continue
        port="$range_start"
        while [ "$port" -le "$range_end" ]; do
            lease="$PORT_LEASE_ROOT/$port"
            if mkdir "$lease" 2>/dev/null; then
                if local_port_is_bindable "$port"; then
                    printf '%s %s\n' "$$" "$PORT_LEASE_NONCE" > "$lease/owner"
                    PORT_LEASES+=("$lease")
                    printf -v "$output_var" '%s' "$port"
                    return 0
                fi
                rmdir "$lease" 2>/dev/null || true
                port=$((port + 1))
                continue
            fi
            owner="$(cat "$lease/owner" 2>/dev/null || true)"
            owner_pid="${owner%% *}"
            if [ -n "$owner_pid" ] && ! kill -0 "$owner_pid" 2>/dev/null; then
                stale_lease="$PORT_LEASE_ROOT/.stale-$port-$$-$RANDOM-$RANDOM"
                if mv "$lease" "$stale_lease" 2>/dev/null; then
                    rm -rf "$stale_lease" 2>/dev/null || true
                fi
            fi
            port=$((port + 1))
        done
    done
    return 1
}

claim_local_archive_ports() {  # claim_local_archive_ports <preferred> <api-output-variable> <frontend-output-variable>
    local preferred="$1" api_output_var="$2" frontend_output_var="$3"
    local api_port frontend_port port range_start range_end scan_phase
    local port_min=1024 port_max=65534 port_span
    case "$preferred" in
        ''|*[!0-9]*) return 1 ;;
    esac
    preferred=$((10#$preferred))
    port_span=$((port_max - port_min + 1))
    preferred=$((port_min + ((preferred - port_min) % port_span + port_span) % port_span))

    for scan_phase in 1 2; do
        if [ "$scan_phase" -eq 1 ]; then
            range_start="$preferred"
            range_end="$port_max"
        else
            range_start="$port_min"
            range_end=$((preferred - 1))
        fi
        [ "$range_start" -le "$range_end" ] || continue
        port="$range_start"
        while [ "$port" -le "$range_end" ]; do
            if claim_exact_local_port "$port" api_port; then
                if claim_exact_local_port "$((port + 1))" frontend_port; then
                    printf -v "$api_output_var" '%s' "$api_port"
                    printf -v "$frontend_output_var" '%s' "$frontend_port"
                    return 0
                fi
                release_local_port_lease "$api_port"
            fi
            port=$((port + 1))
        done
    done

    return 1
}

release_local_port_lease() {  # release_local_port_lease <port>
    local lease="$PORT_LEASE_ROOT/$1" owner
    owner="$(cat "$lease/owner" 2>/dev/null || true)"
    [ "$owner" = "$$ $PORT_LEASE_NONCE" ] && rm -rf "$lease" 2>/dev/null || true
}

release_local_port_leases() {
    local lease owner
    for lease in "${PORT_LEASES[@]:-}"; do
        owner="$(cat "$lease/owner" 2>/dev/null || true)"
        [ "$owner" = "$$ $PORT_LEASE_NONCE" ] && rm -rf "$lease" 2>/dev/null || true
    done
    PORT_LEASES=()
}

start_local_archive_frontend() {
    [ "$DASHBOARD" = "1" ] || return 0
    [ -s "$OUT_DIR/report-card.json" ] || return 0
    [ -s "$OUT_DIR/run.json" ] || return 0

    cp -f "$ROOT_DIR/agents/benchmarks/dashboard.html" "$OUT_DIR/dashboard.html" 2>/dev/null || true

    # The live dashboard mirror owns LOCAL_DASH_PORT during the run. Once results
    # are local, shut it down and open the real frontend against an archive API
    # shim instead of leaving dead links to the stopped benchmark stack. The live
    # archive viewer (upstream = the now-dead backend proxy) is reaped here; the
    # static archive launched below is the durable post-run viewer.
    stop_proxy
    release_local_port_leases
    stop_live_archive_frontend

    local archive_api_port="" archive_fe_port=""
    if ! claim_local_archive_ports "$LOCAL_DASH_PORT" archive_api_port archive_fe_port; then
        echo "   could not find free local ports for archived frontend; files are in $ROOT_DIR/.context"
        return 0
    fi

    for pid_file in "$OUT_DIR/archive-frontend.pid" "$OUT_DIR/archive-api.pid"; do
        if [ -f "$pid_file" ]; then
            old_pid="$(cat "$pid_file" 2>/dev/null || true)"
            [ -n "$old_pid" ] && kill "$old_pid" 2>/dev/null || true
        fi
    done

    python3 "$ROOT_DIR/agents/benchmarks/archive_frontend.py" "$OUT_DIR/run.json" \
        --frontend-dir "$ROOT_DIR/front-end" \
        --context-dir "$ROOT_DIR/.context" \
        --host 127.0.0.1 \
        --api-port "$archive_api_port" \
        --frontend-port "$archive_fe_port" \
        --daemon

    local archive_fe_url="http://localhost:$archive_fe_port"
    python3 - "$archive_fe_url" \
        "$OUT_DIR/report-card.json" \
        "$OUT_DIR/cloudbench-report-card.json" \
        "$OUT_DIR/cloudbench-live/report-card.json" \
        "$RUN_CONTEXT_DIR/report-card.json" <<'PY' || true
import json
import sys
from pathlib import Path

frontend = sys.argv[1].rstrip("/")
for raw_path in sys.argv[2:]:
    path = Path(raw_path)
    if not path.exists():
        continue
    card = json.loads(path.read_text())
    for task in card.get("per_task", []):
        url = task.get("agent_url")
        if not url:
            continue
        try:
            from urllib.parse import parse_qs, urlparse
            agent_id = (parse_qs(urlparse(url).query).get("agent-id") or [""])[0]
        except Exception:
            agent_id = ""
        if agent_id:
            task["agent_url"] = f"{frontend}/?agent-id={agent_id}"
    path.write_text(json.dumps(card, indent=2))
PY

    local first_agent
    first_agent="$(python3 - "$OUT_DIR/run.json" <<'PY'
import json
import sys
for task in json.load(open(sys.argv[1])).get("tasks", []):
    if task.get("agent_id"):
        print(task["agent_id"])
        break
PY
)"
    local archive_url="$archive_fe_url/"
    if [ -n "$first_agent" ]; then
        archive_url="$archive_fe_url/?agent-id=$first_agent"
    fi

    for _ in $(seq 1 40); do
        curl -fsS "http://127.0.0.1:$archive_api_port/health" >/dev/null 2>&1 \
            && curl -fsS "$archive_fe_url/" >/dev/null 2>&1 \
            && break
        sleep 1
    done

    if [ "${NO_OPEN:-0}" = "1" ]; then
        echo "   archived frontend live (batch controller opens the aggregate): $archive_url"
    elif command -v open >/dev/null 2>&1; then
        echo "   view: $archive_url (or use the in-app Benchmarks tab)"
    else
        echo "   archived frontend: $archive_url"
    fi
    echo "   archived frontend API: http://127.0.0.1:$archive_api_port"
}

# SAFETY: STOP the machine on EVERY exit (success, failure, error, timeout,
# Ctrl-C) and always kill the local dashboard proxy. Never destroy on the per-run
# path — only --destroy removes it. A stopped machine bills only for the volume.
LOCK_DIR="$ROOT_DIR/.context/cloudbench-controller.lock"
LOCK_ACQUIRED="0"
# Fleet mode: run-bench-fleet holds a single controller lock for all its children,
# so each per-bench child skips its own lock (they run concurrently by design).
if [ "$SKIP_CONTROLLER_LOCK" != "1" ]; then
    if ! cloudbench_controller_lock_acquire "$LOCK_DIR"; then
        old_pid="$(cat "$LOCK_DIR" 2>/dev/null || true)"
        echo "❌ Another cloud benchmark controller is already running${old_pid:+ (pid $old_pid)}." >&2
        echo "   Stop that run before starting another one." >&2
        exit 1
    fi
    LOCK_ACQUIRED="1"
    trap 'cloudbench_controller_lock_release "$LOCK_DIR"' EXIT
    trap 'cloudbench_controller_lock_release "$LOCK_DIR"; exit 130' INT
    trap 'cloudbench_controller_lock_release "$LOCK_DIR"; exit 143' TERM
fi

STOP_DONE="0"
BOOT_CONFIG_UPDATE_SLOT=""
MUTATION_OWNER_PID_START="$(cloudbench_pid_start_time $$)"
acquire_boot_config_update_slot() {
    local barrier="${CLOUDBENCH_BOOT_CONFIG_BARRIER:-}" max_in_flight
    local wait_seconds deadline slots_dir slot
    [ -n "$barrier" ] || return 0
    case "${CLOUDBENCH_CAMPAIGN_MUTATION_ADMISSION:-0}" in 0|1) ;; *) return 1 ;; esac
    max_in_flight="${CLOUDBENCH_BOOT_CONFIG_MAX_IN_FLIGHT:-4}"
    wait_seconds="${CLOUDBENCH_BOOT_CONFIG_SLOT_WAIT_SECONDS:-${CLOUDBENCH_BOOT_CONFIG_BARRIER_WAIT_SECONDS:-1800}}"
    case "$max_in_flight:$wait_seconds" in
        *[!0-9:]*|0:*|*:0) echo "❌ invalid boot config update concurrency/wait contract" >&2; return 1 ;;
    esac
    if [ "${CLOUDBENCH_CAMPAIGN_MUTATION_ADMISSION:-0}" = 1 ]; then
        # Campaign owners receive independent tracked leases; provider responses alone impose backoff.
        BOOT_CONFIG_UPDATE_SLOT="$(cloudbench_mutation_admission "$CLOUDBENCH_RUNTIME_SCRIPT_ROOT/cloudbench-campaign-mutation.py" acquire \
            --app "$APP" --root "${CLOUDBENCH_CAPACITY_RESERVATION_ROOT:-${TMPDIR:-/tmp}/rose-cloudbench-capacity-$APP}" \
            --owner-pid "$$" --owner-start "$MUTATION_OWNER_PID_START" --wait-seconds "$wait_seconds")" || return 1
        BOOT_CONFIG_UPDATE_SLOT_SHARED=1
        BOOT_CONFIG_UPDATE_SLOT_NATIVE_JOINED=0
        return 0
    fi
    slots_dir="$barrier/update-slots"
    mkdir -p "$slots_dir" || return 1
    deadline=$((SECONDS + wait_seconds))
    while [ "$SECONDS" -lt "$deadline" ]; do
        for slot in $(seq 1 "$max_in_flight"); do
            if mkdir "$slots_dir/$slot" 2>/dev/null; then
                BOOT_CONFIG_UPDATE_SLOT="$slots_dir/$slot"
                return 0
            fi
        done
        sleep 0.2
    done
    echo "❌ timed out waiting for a boot config update slot" >&2
    return 1
}
boot_update_with_capacity_recovery() {
    local update_log="$1" regular_attempts max_regular timeout_seconds
    local capacity_wait capacity_retry regular_retry capacity_deadline native_budget rate_code rate_delay
    local native_rc native_join_receipt="$1.join-native" attempt_log="$1.attempt"
    local host_timeouts=0 host_timeout_limit attempt_number=0
    shift
    # No native mutation is in flight until an attempt starts below, so an early
    # refusal (invalid contract, pacing failure) leaves nothing to fence.
    BOOT_CONFIG_UPDATE_SLOT_NATIVE_JOINED=1
    max_regular="${CLOUDBENCH_BOOT_UPDATE_ATTEMPTS:-10}"
    timeout_seconds="${CLOUDBENCH_BOOT_UPDATE_TIMEOUT:-90}"
    capacity_wait="${CLOUDBENCH_BOOT_UPDATE_CAPACITY_WAIT_SECONDS:-1200}"
    capacity_retry="${CLOUDBENCH_BOOT_UPDATE_CAPACITY_RETRY_SECONDS:-8}"
    regular_retry="${CLOUDBENCH_BOOT_UPDATE_RETRY_SECONDS:-8}"
    host_timeout_limit="${CLOUDBENCH_BOOT_UPDATE_HOST_TIMEOUT_LIMIT:-3}"
    case "$host_timeout_limit" in
        ''|*[!0-9]*|0) echo "❌ invalid boot update host-timeout limit" >&2; return 2 ;;
    esac
    case "$max_regular:$timeout_seconds:$capacity_wait" in
        *[!0-9:]*|0:*|*:0:*|*:*:0)
            echo "❌ invalid boot update retry/capacity-wait contract" >&2
            return 2
            ;;
    esac
    case "$capacity_retry:$regular_retry" in
        *[!0-9:]*|:*|*:)
            echo "❌ invalid boot update retry interval" >&2
            return 2
            ;;
    esac
    regular_attempts=0
    capacity_deadline=$((SECONDS + capacity_wait))
    while [ "$regular_attempts" -lt "$max_regular" ]; do
        native_budget="$timeout_seconds"
        if [ "${CLOUDBENCH_CAMPAIGN_MUTATION_ADMISSION:-0}" = 1 ]; then
            native_budget="$(cloudbench_mutation_admission "$CLOUDBENCH_RUNTIME_SCRIPT_ROOT/cloudbench-campaign-mutation.py" pace \
                --app "$APP" --root "${CLOUDBENCH_CAPACITY_RESERVATION_ROOT:-${TMPDIR:-/tmp}/rose-cloudbench-capacity-$APP}" \
                --owner-pid "$$" --owner-start "$MUTATION_OWNER_PID_START" \
                --wait-seconds "$timeout_seconds" --print-budget)" || return 1
            case "$native_budget" in ''|*[!0-9]*|0) return 1 ;; esac
        fi
        # Mark the lease joined exactly when this attempt's _with_timeout wrote
        # its join-native receipt. Its exit status cannot tell: a signal-killed
        # child (137) or an interruption after the child exists is reaped and
        # joined, while an interruption before any child handle is not. Follow
        # the latest attempt: the helper refuses start-native after an unjoined
        # owner, so a later receipt also proves every earlier owner joined.
        BOOT_CONFIG_UPDATE_SLOT_NATIVE_JOINED=0
        native_rc=0
        rm -f "$native_join_receipt" || return 1
        # Classify each attempt from its own output, but keep every attempt in
        # the update log: a per-attempt overwrite left only the last of ten
        # Fly 408s as evidence for the whole retry sequence.
        attempt_number=$((attempt_number + 1))
        CLOUDBENCH_TIMEOUT_NATIVE_JOIN_RECEIPT="$native_join_receipt" \
            _with_timeout "$native_budget" "$@" > "$attempt_log" 2>&1 || native_rc=$?
        if [ -f "$native_join_receipt" ]; then
            BOOT_CONFIG_UPDATE_SLOT_NATIVE_JOINED=1
            rm -f "$native_join_receipt" || true
        fi
        {
            printf '=== boot update attempt %s at %s rc=%s ===\n' \
                "$attempt_number" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$native_rc"
            cat "$attempt_log" 2>/dev/null
        } >> "$update_log"
        if [ "$native_rc" = 0 ]; then
            rm -f "$attempt_log"
            return 0
        fi
        # An organization Machine-count limit is a permanent refusal for this
        # attempt, even for a same-ID update. Retain the first response; do not
        # replay the mutation as though host CPU capacity might become free.
        if grep -Eiq 'reached (its|the) machine limit|machine limit[^[:alnum:]]+reached' "$attempt_log" 2>/dev/null; then
            echo "❌ boot update refused by organization Machine limit; no retry" >&2
            return 1
        fi
        if [ "${CLOUDBENCH_CAMPAIGN_MUTATION_ADMISSION:-0}" = 1 ]; then
            rate_code=""
            if grep -Eiq '(^|[^[:alnum:]])429([^[:alnum:]]|$)' "$attempt_log"; then rate_code=429
            elif grep -Eiq 'resource_exhausted' "$attempt_log"; then rate_code=resource_exhausted; fi
            if [ -n "$rate_code" ]; then
                rate_delay="$regular_retry"
                [ "$rate_delay" -ge 1 ] || rate_delay=1
                [ "$rate_delay" -le 90 ] || rate_delay=90
                cloudbench_mutation_admission "$CLOUDBENCH_RUNTIME_SCRIPT_ROOT/cloudbench-campaign-mutation.py" backoff \
                    --app "$APP" --root "${CLOUDBENCH_CAPACITY_RESERVATION_ROOT:-${TMPDIR:-/tmp}/rose-cloudbench-capacity-$APP}" \
                    --owner-pid "$$" --owner-start "$MUTATION_OWNER_PID_START" \
                    --response-code "$rate_code" --retry-after "$rate_delay" || return 1
            fi
        fi
        if grep -Eiq \
            'cpu_overcommit_exceeded|shared[ -]cpu.*(limit|overcommit)|insufficient CPUs available to fulfill request on the current host' \
            "$attempt_log" 2>/dev/null; then
            host_timeouts=0
            if [ "$SECONDS" -ge "$capacity_deadline" ]; then
                echo "❌ boot update replacement capacity did not return within ${capacity_wait}s" >&2
                return 1
            fi
            echo "⏳ boot update waiting for provider replacement capacity (${capacity_wait}s ceiling) ..." >&2
            sleep "$capacity_retry"
            continue
        fi
        # A Fly 408 naming this exact VM on a same-ID update means the flyd
        # host that owns this Machine did not answer in time. A Machine never
        # moves hosts, so replaying the same mutation cannot reach a healthy
        # one. App-wide API errors (5xx, 429) are not host evidence and keep
        # the normal budget. After consecutive host timeouts, stop spending the boot
        # deadline here and name the exact Machine so the fleet can replace it
        # through its owned clone lifecycle.
        if [ -n "${BOOT_UPDATE_MACHINE_ID:-}" ] && grep -Fq \
            "failed to update VM ${BOOT_UPDATE_MACHINE_ID}: request returned non-2xx status: 408" \
            "$attempt_log" 2>/dev/null; then
            host_timeouts=$((host_timeouts + 1))
        else
            host_timeouts=0
        fi
        if [ "$host_timeouts" -ge "$host_timeout_limit" ]; then
            if [ -n "${BOOT_UPDATE_HOST_UNRESPONSIVE_MARKER:-}" ]; then
                printf '%s\n' "${BOOT_UPDATE_MACHINE_ID:-}" > "$BOOT_UPDATE_HOST_UNRESPONSIVE_MARKER" 2>/dev/null || true
            fi
            echo "❌ boot update: Fly host for ${BOOT_UPDATE_MACHINE_ID:-this Machine} timed out ${host_timeouts} consecutive times; the Machine needs a replacement" >&2
            rm -f "$attempt_log"
            return 1
        fi
        regular_attempts=$((regular_attempts + 1))
        [ "$regular_attempts" -lt "$max_regular" ] && sleep "$regular_retry"
    done
    rm -f "$attempt_log"
    return 1
}
release_boot_config_update_slot() {
    if [ "${BOOT_CONFIG_UPDATE_SLOT_SHARED:-0}" = 1 ] && [ -n "$BOOT_CONFIG_UPDATE_SLOT" ]; then
        [ "${BOOT_CONFIG_UPDATE_SLOT_NATIVE_JOINED:-0}" = 1 ] || return 1
        cloudbench_mutation_admission "$CLOUDBENCH_RUNTIME_SCRIPT_ROOT/cloudbench-campaign-mutation.py" release \
            --app "$APP" --root "${CLOUDBENCH_CAPACITY_RESERVATION_ROOT:-${TMPDIR:-/tmp}/rose-cloudbench-capacity-$APP}" \
            --owner-pid "$$" --owner-start "$MUTATION_OWNER_PID_START" --lease "$BOOT_CONFIG_UPDATE_SLOT" || return 1
        BOOT_CONFIG_UPDATE_SLOT=""
        BOOT_CONFIG_UPDATE_SLOT_SHARED=0
        return 0
    fi
    if [ -n "${BOOT_CONFIG_UPDATE_SLOT:-}" ]; then
        rmdir "$BOOT_CONFIG_UPDATE_SLOT" 2>/dev/null || true
        BOOT_CONFIG_UPDATE_SLOT=""
    fi
}
# Fast soft-complete / probe paths emit DONE while the boot supervisor still
# holds the driver for controller collection. Waiting on driver-health 410 or
# /shutdown-health 204 then races that intentional hold into CHILDFAIL
# (FINISHED=0 → exit 1 → cleanup 125) even when pass artifacts are green.
cloudbench_skip_held_driver_teardown_race() {
    [ "${CLOUDBENCH_INFRA_PROBE:-0}" = "1" ] \
        || [ "${CLOUDBENCH_SKIP_AUTOSCALER:-0}" = "1" ]
}

# Controller cleanup natively stops an owned guest that no party ever
# delivered an authenticated /shutdown to. Its own request can fail merely
# because this runner already delivered the stop and retired the proxy while
# the guest drains (an execution-window timeout, or an acknowledgement window
# that ends first). Record the accepted delivery durably, before waiting for
# the guest's acknowledgement. The receipt binds this exact fleet run, runner
# token, Machine and bench, and is linked into place without ever replacing an
# existing receipt.
publish_guest_shutdown_delivery_receipt() {  # <http-status>
    python3 - "$OUT_DIR" "${CLOUDBENCH_FLEET_RUN_ID:-$RUN_LOG_TOKEN}" "$RUN_LOG_TOKEN" \
        "$FLEET_MACHINE_ID" "${TASKS_CSV:-}" "$1" <<'PY'
import json
import os
import stat
import sys
import time

output, run_id, run_token, machine, bench, status = sys.argv[1:]
receipt = {
    "version": 1,
    "kind": "guest-shutdown-requested",
    "run_id": run_id,
    "run_token": run_token,
    "machine_id": machine,
    "bench": bench,
    "http_status": int(status),
    "requested_epoch": int(time.time()),
}
binding = ("version", "kind", "run_id", "run_token", "machine_id", "bench")
target = os.path.join(output, "guest-shutdown.requested")
nofollow = getattr(os, "O_NOFOLLOW", 0)


def existing_matches():
    try:
        descriptor = os.open(target, os.O_RDONLY | os.O_NONBLOCK | nofollow)
    except FileNotFoundError:
        return None
    except OSError:
        return False
    try:
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode) or info.st_size > 4096:
            return False
        current = json.loads(os.read(descriptor, 4097))
    except (OSError, ValueError):
        return False
    finally:
        os.close(descriptor)
    return isinstance(current, dict) and all(current.get(key) == receipt[key] for key in binding)


directory = os.open(output, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | nofollow)
try:
    matched = existing_matches()
    if matched is not None:
        raise SystemExit(0 if matched else 1)
    temporary = f"{target}.tmp.{os.getpid()}"
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | nofollow, 0o600)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(receipt, handle, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        try:
            os.link(temporary, target)
        except FileExistsError:
            raise SystemExit(0 if existing_matches() else 1)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
    os.fsync(directory)
finally:
    os.close(directory)
PY
}

confirm_guest_shutdown() {
    local deadline status_code port marker_tmp confirmation_id saved_traps deferred_signal=""
    [ -n "$FLEET_MACHINE_ID" ] || return 0
    confirmation_id="${CLOUDBENCH_FLEET_RUN_ID:-$RUN_LOG_TOKEN}"
    case "$confirmation_id" in ''|*[!a-zA-Z0-9._-]*) return 1 ;; esac
    if [ -e "$OUT_DIR/guest-shutdown.confirmed" ] \
        || [ -L "$OUT_DIR/guest-shutdown.confirmed" ]; then
        [ -f "$OUT_DIR/guest-shutdown.confirmed" ] \
            && [ ! -L "$OUT_DIR/guest-shutdown.confirmed" ] \
            && [ "$(cat "$OUT_DIR/guest-shutdown.confirmed")" = "$confirmation_id" ] \
            && return 0
        echo "❌ existing guest cleanup confirmation does not match this run" >&2
        return 1
    fi
    # Infra probes and DEMO --skip-autoscaler fleets never open browsers/sessions.
    # The boot supervisor also holds the driver process after DONE for controller
    # collection, so /shutdown-health can sit on HTTP 202 until the child-term
    # deadline and flip a clean PASS into exit 125 + KEEP_CLONES. Skip the
    # browser-cleanup handshake and record the same confirmation marker fleet
    # teardown expects.
    if [ "${FINISHED:-0}" = "1" ] && [ -z "${CODEX_AUTH_SHA256:-}" ] \
        && cloudbench_skip_held_driver_teardown_race; then
        marker_tmp="$OUT_DIR/guest-shutdown.confirmed.tmp.$$"
        printf '%s\n' "$confirmation_id" > "$marker_tmp" \
            && mv "$marker_tmp" "$OUT_DIR/guest-shutdown.confirmed"
        if [ "${CLOUDBENCH_INFRA_PROBE:-0}" = "1" ]; then
            echo "✅ guest cleanup skipped for infra-probe (no browser/session work)"
        else
            echo "✅ guest cleanup skipped for DEMO skip-autoscaler (no browser/session work)"
        fi
        return 0
    fi
    port="${LOCAL_STATUS_PORT:-}"
    case "$port" in
        ''|*[!0-9]*)
            echo "❌ guest cleanup unconfirmed: status proxy port was never published" >&2
            return 1
            ;;
    esac
    if ! cloudbench_proxy_alive STATUS_PROXY_PID; then
        echo "❌ guest cleanup unconfirmed: status proxy is not running" >&2
        return 1
    fi
    deadline=$((SECONDS + ${CLOUDBENCH_CHILD_TERM_SECONDS:-30}))
    # Hold cancellation signals across the request and its receipt. Once the
    # guest has accepted the stop, the receipt must exist before a pending TERM
    # ends this runner; otherwise controller cleanup natively stops a delivered,
    # draining guest. The held signal is replayed immediately afterwards.
    saved_traps="$(trap -p HUP INT TERM)"
    trap 'deferred_signal="${deferred_signal:-HUP}"' HUP
    trap 'deferred_signal="${deferred_signal:-INT}"' INT
    trap 'deferred_signal="${deferred_signal:-TERM}"' TERM
    # A transport error (no HTTP answer through the shared relay) retries within the deadline: the
    # relay itself allows 10 s to connect to the guest (cloudbench-shared-relay.py), so one 3 s try
    # expired against a healthy guest and turned PR1784's passing agent-payment-test-shop into exit
    # 125 (2026-11-08). /shutdown records one run-scoped request, so a repeat is idempotent; any HTTP
    # answer ends the retries and keeps the 202/204/409 handling below unchanged.
    local shutdown_attempt=0
    while :; do
        shutdown_attempt=$((shutdown_attempt + 1))
        status_code="$(curl --noproxy '*' -sS --max-time "${CLOUDBENCH_GUEST_SHUTDOWN_REQUEST_SECONDS:-12}" \
            -o /dev/null -w '%{http_code}' -X POST -H "Authorization: Bearer ${CLOUDBENCH_BARRIER_TOKEN:-}" \
            "http://127.0.0.1:$port/shutdown" 2>/dev/null || true)"
        case "$status_code" in ''|000) ;; *) break ;; esac
        [ "$shutdown_attempt" -lt 3 ] && [ "$SECONDS" -lt "$deadline" ] || break
        echo "⚠️  guest shutdown request got no HTTP answer (attempt $shutdown_attempt/3); retrying" >&2
        sleep 1
    done
    case "$status_code" in
        # Only 202/204 mean the guest recorded the request and is stopping its
        # benchmark. Its status server also answers 409 when nothing was
        # recorded or the executing driver could not be signalled.
        202|204)
            if ! publish_guest_shutdown_delivery_receipt "$status_code"; then
                echo "⚠️  guest shutdown was delivered (HTTP $status_code) but its delivery receipt could not be published; controller cleanup will treat the stop as undelivered" >&2
            fi
            ;;
    esac
    trap - HUP INT TERM
    eval "$saved_traps"
    [ -z "$deferred_signal" ] || kill -s "$deferred_signal" "$BASHPID"
    case "$status_code" in
        # A configured /shutdown writes its run-scoped request before validating
        # the live driver PID. A 409 can therefore mean the request is durable,
        # and a naturally exiting driver can publish its cleanup acknowledgement
        # moments after DONE. Keep the proxy alive and let /shutdown-health
        # decide completion; only HTTP 204 is an acknowledgement. A 409 is
        # never recorded as delivery.
        202|204|409) ;;
        *)
            echo "❌ guest cleanup request failed (HTTP ${status_code:-transport-error})" >&2
            return 1
            ;;
    esac
    while [ "$SECONDS" -le "$deadline" ]; do
        status_code="$(curl --noproxy '*' -sS --max-time 3 -o /dev/null -w '%{http_code}' \
            -H "Authorization: Bearer ${CLOUDBENCH_BARRIER_TOKEN:-}" \
            "http://127.0.0.1:$port/shutdown-health" 2>/dev/null || true)"
        if [ "$status_code" = "204" ]; then
            marker_tmp="$OUT_DIR/guest-shutdown.confirmed.tmp.$$"
            printf '%s\n' "$confirmation_id" > "$marker_tmp" \
                && mv "$marker_tmp" "$OUT_DIR/guest-shutdown.confirmed"
            echo "✅ guest browser/session cleanup acknowledged before machine release"
            return 0
        fi
        [ "$status_code" != "500" ] || break
        sleep 0.25
    done
    echo "❌ guest cleanup was not acknowledged; machine ownership must be retained (HTTP ${status_code:-transport-error})" >&2
    return 1
}
cloudbench_prepare_runtime_evidence() {  # before boot config/start; no guest work admitted on failure
    [ "${CLOUDBENCH_BOOT_LAUNCH:-0}" = "1" ] || return 0
    if [ "${CLOUDBENCH_BOOT_TRANSPORT:-config}" = staged ] && [ "${CLOUDBENCH_INFRA_PROBE:-0}" = 1 ]; then
        python3 "$CLOUDBENCH_RUNTIME_SCRIPT_ROOT/cloudbench-staged-boot.py" \
            --prepare-probe-owner --app "$APP" --machine "${FLEET_MACHINE_ID:-$mid}" \
            --run-token "$RUN_LOG_TOKEN" --source-ref "$BENCH_REF" --output "$OUT_DIR"
        return $?
    fi
    cloudbench_skip_held_driver_teardown_race && return 0
    # Fleet supplies its shared credential; a standalone boot run owns a fresh
    # credential for the same authenticated status endpoint before guest config.
    if [ -z "${CLOUDBENCH_BARRIER_TOKEN:-}" ]; then
        CLOUDBENCH_BARRIER_TOKEN="$(python3 -c 'import secrets; print(secrets.token_hex(32))')" || return 1
    fi
    export CLOUDBENCH_BARRIER_TOKEN
    python3 - "$OUT_DIR" "$RUN_LOG_TOKEN" "${FLEET_MACHINE_ID:-$mid}" "${CLOUDBENCH_FLEET_RUN_TOKEN:+fleet}" <<'PY'
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import sys
os.umask(0o077)
output_dir, run_token, machine, fleet = sys.argv[1:]
assert re.fullmatch(r"[A-Za-z0-9._-]+", run_token) and machine
assert not Path(output_dir).is_symlink()
root = Path(output_dir).resolve(strict=True)
intent = root / "runtime-evidence.pending"
# The fleet owns deletion. Keep this independent of a truthful guest cleanup
# acknowledgement: failed collection must retain the original volume.
owner = intent.with_name("runtime-evidence.owner.json")
capture = root / "remote-logs/runtime-evidence"
if not fleet:
    # Serialize only local admission. The pending owner fences the namespace
    # after this short-lived lock exits, including an interrupted admission.
    lock = os.open(root / ".runtime-evidence-admission.lock", os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    assert stat.S_ISREG(os.fstat(lock).st_mode)
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
assert not intent.exists() and not intent.is_symlink(), "previous runtime evidence is still pending"

def read(path, ceiling=1048576):
    assert path.resolve(strict=True) == path
    with os.fdopen(os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK), "rb") as stream:
        info = os.fstat(stream.fileno())
        assert stat.S_ISREG(info.st_mode) and info.st_size <= ceiling
        data = stream.read(info.st_size + 1)
        assert len(data) == info.st_size
        return data

def sync_directory(path):
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)

if owner.exists() or owner.is_symlink():
    assert not fleet, "fleet runtime evidence ownership cannot be reused"
    previous = json.loads(read(owner))
    token = previous["run_token"]
    assert previous["version"] == 1 and re.fullmatch(r"[0-9a-f]+", previous["machine_id"])
    assert re.fullmatch(r"[A-Za-z0-9._-]+", token) and token not in (".", "..", run_token)
    manifest = json.loads(read(capture / "manifest.json"))
    assert all(manifest[key] == previous[key] for key in ("version", "machine_id", "run_token"))
    services = json.loads(read(capture / "services.json"))
    count = services["env"]["worker_processes"]
    assert services["status"] == "stopped" and type(count) is int and 1 <= count <= 1024
    cleanup_name = f"cloudbench-stack-cleanup-{token}.status"
    expected = {"services.json", "run.json", "stack.log", cleanup_name, "logs/backend.log",
                "logs/worker.log", *(f"logs/worker.{i}.log" for i in range(1, count))}
    # The served WMH log (simulated runs) and guest diagnostics are optional.
    optional = set(manifest["files"]) & {"wmh-serve-log.txt", "guest-diagnostics.jsonl"}
    assert set(manifest["files"]) - optional == expected
    entries = list(capture.rglob("*"))
    assert all(not path.is_symlink() for path in entries)
    assert {str(path.relative_to(capture)) for path in entries} == expected | optional | {"manifest.json", "logs"}
    cleanup = dict(line.split("=", 1) for line in read(capture / cleanup_name).decode().splitlines())
    assert cleanup["state"] == "clean" and cleanup["token"] == token
    total = 0
    for name, metadata in manifest["files"].items():
        assert set(metadata) == {"bytes", "sha256"}
        assert type(metadata["bytes"]) is int and metadata["bytes"] >= 0
        total += metadata["bytes"]
        assert total <= 512 * 1024 * 1024
        path = capture / name
        assert path.resolve(strict=True) == path
        with os.fdopen(os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK), "rb") as stream:
            before = os.fstat(stream.fileno())
            assert stat.S_ISREG(before.st_mode) and before.st_size == metadata["bytes"]
            digest = hashlib.sha256()
            for chunk in iter(lambda: stream.read(65536), b""):
                digest.update(chunk)
            after = path.stat()
            assert (before.st_ino, before.st_size, before.st_mtime_ns) == (after.st_ino, after.st_size, after.st_mtime_ns)
            assert digest.hexdigest() == metadata["sha256"]
    history = root / "runtime-evidence-history"
    assert not history.is_symlink()
    history.mkdir(exist_ok=True)
    archive = history / token
    archive.mkdir()
    owner.rename(archive / owner.name)
    capture.rename(archive / "runtime-evidence")
    for directory in (archive, history, capture.parent, root):
        sync_directory(directory)
else:
    assert not capture.exists() and not capture.is_symlink(), "runtime evidence has no matching owner"
row = {"version": 1, "run_token": run_token, "machine_id": machine}
for path in (owner, intent):
    with path.open("x") as output:
        json.dump(row, output, sort_keys=True)
        output.write("\n")
        output.flush()
        os.fsync(output.fileno())
sync_directory(root)
PY
}

cloudbench_collect_runtime_evidence() {  # <destination> <port> <run-token> <machine> <deadline>
    python3 - "$@" <<'PY'
import hashlib
import http.client
import json
import os
from pathlib import Path
import re
import signal
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request

destination, port, run_token, machine, deadline = sys.argv[1:]
os.umask(0o077)
assert port.isascii() and port.isdigit() and 1 <= int(port) <= 65535
assert deadline.isascii() and deadline.isdigit() and int(deadline) > 0
assert re.fullmatch(r"[A-Za-z0-9._-]+", run_token) and machine
maximum = 512 * 1024 * 1024
parent = Path(destination)
intent = parent.parent / "runtime-evidence.pending"
owner = intent.with_name("runtime-evidence.owner.json")
for path in (owner, intent):
    assert not path.is_symlink() and path.is_file()
    assert json.loads(path.read_text()) == {"version": 1, "run_token": run_token, "machine_id": machine}
class RuntimeEvidenceDeadline(RuntimeError):
    """The whole capture budget expired, not one retryable socket read."""

def timed_out(_signum, _frame):
    raise RuntimeEvidenceDeadline("terminal runtime evidence deadline expired")
signal.signal(signal.SIGALRM, timed_out)
signal.alarm(int(deadline))
class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        return None
opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect())
headers = {"Authorization": "Bearer " + os.environ["CLOUDBENCH_BARRIER_TOKEN"],
           "X-Cloudbench-Run-Token": run_token, "X-Cloudbench-Machine-Id": machine}
url = f"http://127.0.0.1:{port}/runtime-evidence"
shutdown_url = f"http://127.0.0.1:{port}/shutdown-health"
driver_url = f"http://127.0.0.1:{port}/driver-health"
ack_url = f"http://127.0.0.1:{port}/cloudbench-driver-clean-{run_token}.ack"
def request(suffix=""):
    return opener.open(urllib.request.Request(url + suffix, headers=headers), timeout=6)
def manifest():
    with request() as response:
        data = response.read(1048577)
        assert len(data) <= 1048576 and response.status == 200
        # read(amt) returns a short body without IncompleteRead when the stream closes early.
        sealed = response.headers.get("Content-Length")
        if sealed is not None and sealed.isdigit() and len(data) != int(sealed):
            raise TruncatedTransfer(f"manifest ended at {len(data)} of {sealed} bytes")
        return json.loads(data)
def exited_without_ack():
    # /shutdown-health is 409 until the controller sends POST /shutdown, even
    # when a failed driver's boot supervisor has already sealed state=exited.
    # Read both exact guest facts before deciding the runtime can never seal.
    try:
        with opener.open(urllib.request.Request(driver_url, headers=headers), timeout=6):
            return False
    except urllib.error.HTTPError as error:
        if error.code != 410:
            return False
    try:
        with opener.open(urllib.request.Request(ack_url, headers=headers), timeout=6) as response:
            return response.read(256).strip() != run_token.encode()
    except urllib.error.HTTPError as error:
        return error.code == 404
class TruncatedTransfer(ConnectionError):
    """The guest stream ended before its sealed Content-Length was delivered."""

class SealedReadAttempt:
    """Absorb one transport fault of a sealed read so the caller can restart it.

    The shared relay tunnel can freeze every stream for seconds (a 7 s stall
    exceeded the 6 s socket budget mid run.json on 2026-11-06). A sealed file
    is immutable and served afresh per request, so a bounded restart from byte
    0 is exact; the per-read budget and whole-capture alarm stay unchanged.
    HTTP errors are protocol answers, and assertions are integrity checks:
    both propagate on the first attempt.
    """
    def __init__(self, name, number, last):
        self.name, self.number, self.last, self.done = name, number, last, False
    def __enter__(self):
        return self
    def __exit__(self, kind, error, _traceback):
        if kind is None:
            self.done = True
            return False
        if (self.last or issubclass(kind, urllib.error.HTTPError)
                or not issubclass(kind, (urllib.error.URLError, http.client.IncompleteRead,
                                         TimeoutError, ConnectionError))):
            return False
        print(f"⚠️  retrying runtime evidence file {self.name} from byte 0 after a transport "
              f"fault (attempt {self.number}/{SEALED_READ_ATTEMPTS}): {error!r}",
              file=sys.stderr, flush=True)
        time.sleep(0.5)
        return True
SEALED_READ_ATTEMPTS = 3
def sealed_read_attempts(name):
    for number in range(1, SEALED_READ_ATTEMPTS + 1):
        attempt = SealedReadAttempt(name, number, number == SEALED_READ_ATTEMPTS)
        yield attempt
        if attempt.done:
            return
unacked_exits = 0
shutdown_complete = False
# DONE precedes the guest EXIT trap. Retry only seal observation and transient
# transport reads before the first manifest, within the unchanged whole-capture
# alarm. Once sealed, transfers and the final manifest comparison fail closed on
# any HTTP rejection, header/size disagreement, hash mismatch or manifest change;
# only a transport fault restarts that exact read (sealed_read_attempts).
while True:
    try:
        try:
            expected = manifest()
            break
        except urllib.error.HTTPError as error:
            if error.code != 409:
                raise
            if shutdown_complete:
                # This 409 was observed after the exact terminal ACK, unlike
                # the earlier read that may have raced the guest's seal.
                raise RuntimeError("guest shutdown without sealed runtime evidence") from error
        try:
            with opener.open(urllib.request.Request(shutdown_url, headers=headers), timeout=6) as response:
                if response.status == 204:
                    shutdown_complete = True
                    continue
                assert response.status == 202
        except urllib.error.HTTPError as shutdown_error:
            if shutdown_error.code == 500:
                raise RuntimeError("driver exited without cleanup acknowledgement") from shutdown_error
            if shutdown_error.code not in (409, 503):
                raise
        unacked_exits = unacked_exits + 1 if exited_without_ack() else 0
        if unacked_exits >= 2:
            raise RuntimeError("driver exited without cleanup acknowledgement")
    except urllib.error.HTTPError:
        # HTTPError is a URLError subclass; authentication and protocol failures
        # are not transient transport reads.
        raise
    except (urllib.error.URLError, TimeoutError, ConnectionError):
        pass
    time.sleep(0.5)
assert expected["version"] == 1 and expected["run_token"] == run_token and expected["machine_id"] == machine
files = expected["files"]
# A guest stopped before launching anything seals only its exact bench.log.
prelaunch = expected.get("prelaunch") is True
if prelaunch:
    required = {"bench.log"}
    assert set(expected) == {"version", "run_token", "machine_id", "files", "prelaunch"}
    assert isinstance(files, dict) and set(files) == required
else:
    required = {"services.json", "run.json", "stack.log", "logs/backend.log", f"cloudbench-stack-cleanup-{run_token}.status"}
# Present only when the stack served a world model (its per-step server timing),
# or when the guest diagnostics sampler ran (CPU/load, DB pool, pg_stat_activity).
OPTIONAL = {"wmh-serve-log.txt", "guest-diagnostics.jsonl"}
assert isinstance(files, dict) and required <= files.keys() and len(files) <= 1030
total = 0
for name, metadata in files.items():
    assert name in required or name in OPTIONAL or re.fullmatch(r"logs/worker(?:\.[1-9][0-9]*)?\.log", name)
    assert set(metadata) == {"bytes", "sha256"}
    assert type(metadata["bytes"]) is int and metadata["bytes"] >= 0
    assert re.fullmatch(r"[0-9a-f]{64}", metadata["sha256"])
    total += metadata["bytes"]
assert total <= maximum
final = parent / "runtime-evidence"
assert not final.exists() and not final.is_symlink()
pending = Path(tempfile.mkdtemp(prefix=".runtime-evidence-", dir=parent))
for name, metadata in files.items():
    target = pending / name
    target.parent.mkdir(parents=True, exist_ok=True)
    for attempt in sealed_read_attempts(name):
        with attempt:
            target.unlink(missing_ok=True)  # Restart from byte 0; never splice.
            digest = hashlib.sha256()
            remaining = metadata["bytes"]
            with request("?" + urllib.parse.urlencode({"file": name})) as response, target.open("xb") as output:
                assert response.status == 200 and response.headers.get("Content-Length") == str(remaining)
                while remaining:
                    chunk = response.read(min(65536, remaining))
                    if not chunk:
                        raise TruncatedTransfer("runtime evidence response ended early")
                    output.write(chunk)
                    digest.update(chunk)
                    remaining -= len(chunk)
                assert not response.read(1), "runtime evidence response exceeded manifest"
                output.flush()
                os.fsync(output.fileno())
    assert digest.hexdigest() == metadata["sha256"], "runtime evidence hash mismatch"
if prelaunch:
    with (pending / "bench.log").open("rb") as log:
        stamp = ("RUNSTAMP-" + run_token + "\n").encode()
        assert log.read(len(stamp)) == stamp, "pre-launch log belongs to another run"
else:
    services = json.loads((pending / "services.json").read_text())
    count = services["env"]["worker_processes"]
    assert services["status"] == "stopped" and type(count) is int and 1 <= count <= 1024
    assert set(files) - OPTIONAL == required | {"logs/worker.log", *(f"logs/worker.{i}.log" for i in range(1, count))}
for attempt in sealed_read_attempts("manifest"):
    with attempt:
        final_manifest = manifest()
assert final_manifest == expected, "runtime evidence changed across collection"
with (pending / "manifest.json").open("x") as output:
    json.dump(expected, output, sort_keys=True)
    output.write("\n")
    output.flush()
    os.fsync(output.fileno())
# Persist child directory entries before acknowledging the published capture.
# File fsync alone does not make their names durable across controller failure.
for directory in ((pending,) if prelaunch else (pending / "logs", pending)):
    descriptor = os.open(directory, os.O_RDONLY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
pending.rename(final)
descriptor = os.open(parent, os.O_RDONLY)
try:
    os.fsync(descriptor)
finally:
    os.close(descriptor)
if prelaunch:
    # No run result can exist to bind the latch to; the sealed pre-launch
    # bundle is the complete runtime evidence, so release the latch here.
    intent.unlink()
    descriptor = os.open(intent.parent, os.O_RDONLY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
signal.alarm(0)
PY
}

# Diagnostic-only capture of a guest whose stack teardown failed. The driver
# then refuses its clean ACK, so the sealed /runtime-evidence never opens and
# the disposable teardown deletes the only copy of the worker/stack logs that
# explain the failure (descend-full69-20261023 P8: a worker drain that ran the
# whole 2100 s grace). This never creates remote-logs/runtime-evidence, never
# clears runtime-evidence.pending and never changes the run's classification.
cloudbench_collect_failed_runtime_evidence() {
    local destination="$1" port="$2" run_token="$3" machine="$4" deadline="$5"
    python3 - "$destination" "$port" "$run_token" "$machine" "$deadline" <<'PY'
import hashlib
import json
import os
import re
import signal
import sys
import tempfile
import urllib.parse
import urllib.request
from pathlib import Path

destination, port, run_token, machine, deadline = sys.argv[1:]
os.umask(0o077)
assert port.isascii() and port.isdigit() and 1 <= int(port) <= 65535
assert deadline.isascii() and deadline.isdigit() and int(deadline) > 0
assert re.fullmatch(r"[A-Za-z0-9._-]+", run_token) and machine
signal.alarm(int(deadline))
maximum = 512 * 1024 * 1024
parent = Path(destination)
final = parent / "failed-runtime-evidence"
assert not final.exists() and not final.is_symlink()


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        return None


opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect())
headers = {"Authorization": "Bearer " + os.environ["CLOUDBENCH_BARRIER_TOKEN"],
           "X-Cloudbench-Run-Token": run_token, "X-Cloudbench-Machine-Id": machine}
url = f"http://127.0.0.1:{port}/failed-runtime-evidence"


def request(suffix=""):
    return opener.open(urllib.request.Request(url + suffix, headers=headers), timeout=30)


def manifest():
    with request() as response:
        data = response.read(1048577)
        assert len(data) <= 1048576 and response.status == 200
        return json.loads(data)


expected = manifest()
assert expected["version"] == 1 and expected["run_token"] == run_token and expected["machine_id"] == machine
assert expected.get("stack_cleanup_state") == "failed"
files = expected["files"]
assert isinstance(files, dict) and "logs/worker.log" in files and len(files) <= 1030
total = 0
for name, metadata in files.items():
    assert re.fullmatch(r"[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)?", name) and ".." not in name
    assert set(metadata) == {"bytes", "sha256"} and type(metadata["bytes"]) is int and metadata["bytes"] >= 0
    total += metadata["bytes"]
assert total <= maximum
pending = Path(tempfile.mkdtemp(prefix=".failed-runtime-evidence-", dir=parent))
for name, metadata in files.items():
    target = pending / name
    target.parent.mkdir(parents=True, exist_ok=True)
    digest = hashlib.sha256()
    remaining = metadata["bytes"]
    with request("?" + urllib.parse.urlencode({"file": name})) as response, target.open("xb") as output:
        assert response.status == 200 and response.headers.get("Content-Length") == str(remaining)
        while remaining:
            chunk = response.read(min(65536, remaining))
            assert chunk, "failed runtime evidence response ended early"
            output.write(chunk)
            digest.update(chunk)
            remaining -= len(chunk)
        assert not response.read(1), "failed runtime evidence response exceeded manifest"
    assert digest.hexdigest() == metadata["sha256"], "failed runtime evidence hash mismatch"
assert manifest() == expected, "failed runtime evidence changed across collection"
with (pending / "manifest.json").open("x") as output:
    json.dump({**expected, "diagnostic_only": True, "proof_credit": 0}, output, sort_keys=True)
    output.write("\n")
pending.rename(final)
signal.alarm(0)
print(f"📦 failed-cleanup runtime evidence captured for diagnosis: {final} ({len(files)} files)", file=sys.stderr)
PY
}

stop_on_exit() {
    local ec=$?
    local retirement_deadline=$((SECONDS + ${CLOUDBENCH_CHILD_TERM_SECONDS:-30} - 2))
    local remaining shutdown_confirmed=0
    # A second cancellation signal (the supervisor's residual group TERM after
    # its grace, or controller teardown of the child process tree) used to run
    # the `exit` TERM trap inside this EXIT trap and abort it midway, skipping
    # proxy retirement, port-lease release, viewer teardown and the exit
    # status. Record such a signal instead. Child commands still receive it
    # with their default dispositions, and every caller bounds this cleanup
    # with SIGKILL.
    trap ':' HUP INT TERM
    [ -z "${POLL_SLEEP_PID:-}" ] || kill "$POLL_SLEEP_PID" 2>/dev/null || true
    release_boot_config_update_slot
    if [ -n "${GUEST_SHUTDOWN_RESULT:-}" ]; then
        if [ "$GUEST_SHUTDOWN_RESULT" = "0" ]; then shutdown_confirmed=1; else ec=125; fi
    elif confirm_guest_shutdown; then
        shutdown_confirmed=1
    else
        ec=125
    fi
    # TERM and early exits bypass the normal post-loop collector. The same
    # exact-owner data-plane transfer must finish before stop_proxy retires its
    # only transport. Keep the original exit status and pending marker: result
    # validation, not a signal handler, decides whether a run is accepted.
    if [ "$shutdown_confirmed" = "1" ] \
        && [ "${CLOUDBENCH_BOOT_LAUNCH:-0}" = "1" ] \
        && ! cloudbench_skip_held_driver_teardown_race \
        && { [ -e "$OUT_DIR/runtime-evidence.pending" ] || [ -L "$OUT_DIR/runtime-evidence.pending" ]; }; then
        mkdir -p "$OUT_DIR/remote-logs"
        if [ ! -f "$OUT_DIR/remote-logs/cloudbench-driver.log" ]; then
            if [ -f "${SSH_LOG:-}" ]; then
                cp "$SSH_LOG" "$OUT_DIR/remote-logs/cloudbench-driver.log" || ec=70
            else
                ec=70
            fi
        fi
        if [ ! -d "$OUT_DIR/remote-logs/runtime-evidence" ]; then
            remaining=$((retirement_deadline - SECONDS))
            if [ "$remaining" -le 0 ] \
                || ! cloudbench_collect_runtime_evidence "$OUT_DIR/remote-logs" \
                    "$LOCAL_STATUS_PORT" "$RUN_LOG_TOKEN" "${FLEET_MACHINE_ID:-$mid}" "$remaining"; then
                echo "❌ terminal runtime evidence remains incomplete; retaining exact owner" >&2
                ec=70
            fi
        fi
    fi
    if declare -F cleanup_staged_local_files >/dev/null 2>&1; then
        cleanup_staged_local_files
    fi
    rm -f "${BENCH_LOG_CHUNK_FILE:-}" "${BENCH_LOG_HEADERS_FILE:-}" \
        "${BENCH_LOG_GENERATION_FILE:-}" "${BENCH_LOG_PROGRESS_FILE:-}" \
        "${BENCH_PROGRESS_STATE_FILE:-}" 2>/dev/null || true
    stop_proxy
    release_local_port_leases
    # The viewer is tied to the run's lifecycle: it spins up on the first "open"
    # click during the run and is fully reaped here on exit. Nothing lingers past
    # the run ("otherwise dead") — no orphaned link server, archive Vite, or proxy.
    stop_live_archive_frontend
    stop_all_local_viewers
    # In fleet mode the machine is a per-bench clone owned by run-bench-fleet,
    # which destroys it after collecting results — never stop it here.
    if [ "$STOP_DONE" != "1" ] && [ -z "$FLEET_MACHINE_ID" ]; then
        if [ -e "$OUT_DIR/runtime-evidence.pending" ] || [ -L "$OUT_DIR/runtime-evidence.pending" ]; then
            echo "❌ standalone runtime evidence remains pending; retaining original machine" >&2
            ec=70
        else
            STOP_DONE="1"
            stop_machine "$mid"
        fi
    fi
    if [ "${LOCK_ACQUIRED:-0}" = "1" ]; then
        cloudbench_controller_lock_release "$LOCK_DIR"
    fi
    echo "Original exit code: $ec"
    trap - EXIT
    exit "$ec"
}
trap stop_on_exit EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# Build the code payload before choosing a launch transport. Boot-launch and the
# legacy SSH path must consume this one source of truth; creating it only inside
# the legacy branch made the fast path silently run the base checkout.
STAGED_LOCAL_FILES=()
cleanup_staged_local_files() {
    # macOS Bash 3.2 treats an empty array expansion as unbound under `set -u`.
    # Most boot-launch children share the fleet patch and therefore stage no
    # controller-local temp files; cleanup must remain a no-op in that case.
    [ "${STAGED_LOCAL_FILES[0]+set}" = "set" ] || return 0
    for p in "${STAGED_LOCAL_FILES[@]}"; do
        [ -n "$p" ] && rm -f "$p" 2>/dev/null || true
    done
}
# Explicit auth stays out of machine config.files and durable run artifacts.
CODEX_AUTH_SOURCE=""
CODEX_AUTH_SHA256=""
if [ -n "${CODEX_AUTH_PATH:-}" ]; then
    CODEX_AUTH_SOURCE="$(mktemp /tmp/rose-cloudbench-codex-auth.XXXXXXXX)" || exit 1
    STAGED_LOCAL_FILES+=("$CODEX_AUTH_SOURCE")
    rm -f "$CODEX_AUTH_SOURCE"
    CODEX_AUTH_SHA256="$(python3 "$CLOUDBENCH_GUEST_CODEX_AUTH_SCRIPT" prepare \
        --source "$CODEX_AUTH_PATH" --output "$CODEX_AUTH_SOURCE")" || exit 1
fi

stage_explicit_codex_auth() {  # <controller-staged guest helper>
    [ -n "$CODEX_AUTH_SOURCE" ] || return 0
    local helper="$1" deadline=$((SECONDS + 270)) remaining command staged=0 stage_log stage_reply stage_status
    local probe_timeout="${CLOUDBENCH_SSH_PROBE_TIMEOUT_SECONDS:-10}"
    case "$probe_timeout" in ''|*[!0-9]*) return 1 ;; esac
    [ "$probe_timeout" -gt 0 ] || return 1
    case "$RUN_LOG_TOKEN" in ''|*[!a-zA-Z0-9._-]*) return 1 ;; esac
    [[ "$mid" =~ ^[0-9a-f]{14,16}$ ]] || return 1
    stage_log="$OUT_DIR/cloudbench-codex-stage.log"
    : > "$stage_log"
    stage_reply="$OUT_DIR/cloudbench-codex-stage-reply.log"
    command="test \"\$(head -n 1 /data/bench.log)\" = RUNSTAMP-$RUN_LOG_TOKEN && export CLOUDBENCH_RUN_TOKEN=$RUN_LOG_TOKEN && python3 $helper stage --run-token $RUN_LOG_TOKEN --machine-id $mid --sha256 $CODEX_AUTH_SHA256"
    command="$(cloudbench_namespace_command "$mid" "$command")" || return 1
    while [ "$SECONDS" -lt "$deadline" ]; do
        remaining=$((deadline - SECONDS))
        [ "$remaining" -le "$probe_timeout" ] || remaining="$probe_timeout"
        if _with_timeout "$remaining" flyctl ssh console -a "$APP" --machine "$mid" \
            -C "bash -lc $(printf '%q' "$command")" > "$stage_reply" 2>&1; then
            cat "$stage_reply" >> "$stage_log"
            stage_status="$(tail -n 1 "$stage_reply")"
            [ "$stage_status" != already-ready ] || return 0
            [ "$stage_status" = stage-ready ] || return 1
            staged=1
            break
        fi
        sleep 1
    done
    [ "$staged" = 1 ] || return 1
    remaining=$((deadline - SECONDS)); [ "$remaining" -gt 0 ] || return 1
    _with_timeout "$remaining" flyctl ssh sftp put -a "$APP" --machine "$mid" -q -m 0600 \
        "$CODEX_AUTH_SOURCE" "/tmp/rose-cloudbench-codex/$RUN_LOG_TOKEN-$mid/auth.pending" \
        >> "$stage_log" 2>&1 || return 1
    remaining=$((deadline - SECONDS)); [ "$remaining" -gt 0 ] || return 1
    command="test \"\$(head -n 1 /data/bench.log)\" = RUNSTAMP-$RUN_LOG_TOKEN && export CLOUDBENCH_RUN_TOKEN=$RUN_LOG_TOKEN && python3 $helper publish --run-token $RUN_LOG_TOKEN --machine-id $mid --sha256 $CODEX_AUTH_SHA256"
    command="$(cloudbench_namespace_command "$mid" "$command")" || return 1
    _with_timeout "$remaining" flyctl ssh console -a "$APP" --machine "$mid" \
        -C "bash -lc $(printf '%q' "$command")" >> "$stage_log" 2>&1
}

LOCAL_PATCH_FILE=""
LOCAL_PATCH_SHA256=""
if [ "${CLOUDBENCH_SKIP_LOCAL_PATCH:-0}" != "1" ]; then
    if [ -n "${CLOUDBENCH_LOCAL_PATCH_SOURCE:-}" ]; then
        [ -s "$CLOUDBENCH_LOCAL_PATCH_SOURCE" ] || {
            echo "❌ shared local workspace patch is missing or empty" >&2
            exit 1
        }
        [ -n "${CLOUDBENCH_LOCAL_PATCH_SHA256:-}" ] || {
            echo "❌ shared local workspace patch has no fleet-pinned checksum" >&2
            exit 1
        }
        LOCAL_PATCH_FILE="$CLOUDBENCH_LOCAL_PATCH_SOURCE"
        _shared_patch_sha256="$(cloudbench_env_sha256 "$LOCAL_PATCH_FILE")"
        [ "$_shared_patch_sha256" = "$CLOUDBENCH_LOCAL_PATCH_SHA256" ] || {
            echo "❌ shared local workspace patch checksum mismatch" >&2
            exit 1
        }
        # Reuse the fleet's one authoritative digest for every child/guest.
        # The hash above verifies bytes, but never promotes a mutated child's
        # newly observed value to the expected checksum.
        LOCAL_PATCH_SHA256="$CLOUDBENCH_LOCAL_PATCH_SHA256"
    elif cloudbench_worktree_has_changes "$ROOT_DIR"; then
        _candidate_patch="$(mktemp)"
        STAGED_LOCAL_FILES+=("$_candidate_patch")
        _local_patch_rc=0
        cloudbench_prepare_workspace_patch \
            "$ROOT_DIR" HEAD "$_candidate_patch" \
            "$ROOT_DIR/scripts/create-worktree-patch.sh" || _local_patch_rc=$?
        if [ "$_local_patch_rc" -eq 0 ]; then
            LOCAL_PATCH_FILE="$_candidate_patch"
        elif [ "$_local_patch_rc" -eq "$CLOUDBENCH_PATCH_NO_DELTA" ]; then
            # Only excluded content (append-only history ledgers) changed
            # between the shippability check and generation, so the base ref
            # already IS the code under test. Declare no patch, never abort.
            echo "📦 no shippable workspace delta (append-only ledgers only); guest runs the base ref"
        else
            echo "❌ could not create the local workspace patch" >&2
            exit 1
        fi
    fi
fi
if [ -n "$LOCAL_PATCH_FILE" ] && [ -z "$LOCAL_PATCH_SHA256" ]; then
    LOCAL_PATCH_SHA256="$(cloudbench_env_sha256 "$LOCAL_PATCH_FILE")"
    [ -n "$LOCAL_PATCH_SHA256" ] || {
        echo "❌ could not fingerprint the local workspace patch" >&2
        exit 1
    }
fi

verify_execution_provenance_contract() {
    [ "${CLOUDBENCH_REQUIRE_EXECUTION_PROVENANCE:-0}" = "1" ] || return 0
    [ -s "${CLOUDBENCH_EXECUTION_PROVENANCE_FILE:-}" ] || {
        echo "❌ Cloud Fleet child has no expected execution provenance" >&2
        return 1
    }
    [ -s "$CLOUDBENCH_GUEST_EXECUTION_PROVENANCE_SCRIPT" ] \
        && [ -s "$CONTROLLER_SNAPSHOT_MANIFEST" ] \
        && [ -s "$CLOUDBENCH_RESULT_SCRIPT" ] || {
        echo "❌ immutable controller snapshot is missing execution provenance dependencies" >&2
        return 1
    }
    python3 "$CLOUDBENCH_GUEST_EXECUTION_PROVENANCE_SCRIPT" verify-binding \
        --provenance "$CLOUDBENCH_EXECUTION_PROVENANCE_FILE" \
        --base-sha "$BENCH_REF" \
        --workspace-patch-sha256 "${LOCAL_PATCH_SHA256:-none}" \
        --snapshot-dir "$CLOUDBENCH_RUNTIME_SCRIPT_ROOT" \
        --manifest "$CONTROLLER_SNAPSHOT_MANIFEST"
}
verify_execution_provenance_contract || exit 1

# ── Launch the driver: BOOT-LAUNCH (no ssh) or the legacy ssh path ──────────
# BOOT-LAUNCH removes the per-box launch-ssh burst (start + ssh-ready + clear-stale
# + stage + launch + confirm ≈ 7 ssh × N) that saturated Fly's Machines-API rate
# limit at fleet width and killed drivers at launch. Instead the controller sets
# the per-run params as machine --env and cloudbench-boot.sh as the --command, then
# starts the box — it AUTO-RUNS the driver on boot with ZERO ssh; progress is polled
# over the data-plane status proxy. Requires /data/cloudbench-boot.sh in the snapshot.
# A prior or concurrent run may still own this run's preferred block. Atomically
# lease every listener port for this process; bind-check-close alone is TOCTOU
# racy when two controllers start together.
claim_local_port "$LOCAL_DASH_PORT" LOCAL_DASH_PORT \
    || { echo "❌ could not lease a local dashboard port" >&2; exit 1; }
LOCAL_STATUS_PORT=""
STATUS_PROXY_PID=""
# Shared setup used by BOTH launch paths AND the post-launch proxy/relay code —
# must be set before the branch, or boot-launch trips `set -u` at the backend proxy.
LIVE_BACKEND_PORT=""
LIVE_BACKEND_URL=""
CLOUDBENCH_API_KEY="$( { grep -h '^BACKEND_API_KEY' "$ROOT_DIR/back-end/.env" "$ROOT_DIR/agents/.env" 2>/dev/null | head -1; } | sed -E 's/^BACKEND_API_KEY=//; s/^"//; s/"$//' )"

# Persist capture authority before boot configuration can launch guest writers.
# A crash anywhere after admission leaves exact evidence ownership recoverable.
cloudbench_prepare_runtime_evidence || { echo "❌ could not persist runtime evidence ownership" >&2; exit 70; }
# demo: reads the shared DEMO cache through the production pooler (4 clients per guest).
# delegating: a REAL/SIM guest that leases production compute tokens and third-party
# providers. infra: a substrate probe with neither. Unknown catalogs stay delegating.
cloudbench_guest_lane() {
    [ "${CLOUDBENCH_INFRA_PROBE:-0}" = 1 ] && { echo infra; return 0; }
    case "${CLOUDBENCH_LANE:-}" in demo|delegating|infra) echo "$CLOUDBENCH_LANE"; return 0 ;; esac
    local lane_status=0
    python3 -B "$ROOT_DIR/scripts/cloudbench_catalog.py" needs-shared-demo-cache \
        "$ROOT_DIR/agents/benchmarks/tasks.json" "${BENCH_TASKS[@]}" >/dev/null 2>&1 || lane_status=$?
    if [ "$lane_status" = 0 ]; then echo demo; else echo delegating; fi
}
if [ "${CLOUDBENCH_BOOT_LAUNCH:-0}" = "1" ]; then
    POST_CONFIG_START_MARKER="$OUT_DIR/post-config-start.accepted"
    rm -f "$POST_CONFIG_START_MARKER"
    _ghb64="$(printf '%s' "$(cloudbench_controller_github_token)" | base64 | tr -d '\n')"
    [ -n "$_ghb64" ] || { echo "❌ No controller GitHub token for boot-launch." >&2; exit 1; }
    _envargs=(
        --env CLOUDBENCH_BOOT=1
        --env CODEX_AUTH_PATH=
        --env CLOUDBENCH_CODEX_AUTH_HELPER=/cloudbench-codex-auth.py
        --env "CLOUDBENCH_CODEX_AUTH_SHA256=$CODEX_AUTH_SHA256"
        --env "CLOUDBENCH_CODEX_AUTH_MACHINE_ID=$mid"
        --env CLOUDBENCH_RUN_SCRIPT=/cloudbench-run.sh
        --env CLOUDBENCH_FETCH_REF_SCRIPT=/cloudbench-fetch-ref.sh
        --env "CLOUDBENCH_FRESH_VOLUME=${CLOUDBENCH_FRESH_VOLUME:-0}"
        --env "CLOUDBENCH_COLD_PRIMARY_BOOTSTRAP=${CLOUDBENCH_COLD_PRIMARY_BOOTSTRAP:-0}"
        --env CLOUDBENCH_SYNC_DEPS_SCRIPT=/cloudbench-sync-deps.sh
        --env CLOUDBENCH_SYNC_PRISMA_SCRIPT=/cloudbench-sync-prisma-client.sh
        --env CLOUDBENCH_NGROK_INSTALL_SCRIPT=/cloudbench-install-ngrok.sh
        --env CLOUDBENCH_CURRENT_RUN_ARTIFACT_SCRIPT=/cloudbench-current-run-artifact.py
        --env CLOUDBENCH_PREPARE_PATCH_SCRIPT=/cloudbench-prepare-patch.sh
        --env CLOUDBENCH_STATUS_SERVER_SCRIPT=/cloudbench-status-server.py
        --env CLOUDBENCH_BENCHMARK_TARGET_SCRIPT=/cloudbench-benchmark-target.py
        --env CLOUDBENCH_CATALOG_SCRIPT=/cloudbench_catalog.py
        --env CLOUDBENCH_ENV_HELPER=/cloudbench-env.sh
        --env CLOUDBENCH_EXACT_SESSION_CLEANUP_SCRIPT=/cloudbench-exact-session-cleanup.py
        --env CLOUDBENCH_GUEST_RECOVERY_SCRIPT=/cloudbench-guest-recovery.py
        --env "LOCAL_PATCH_B64="
        --env "CLOUDBENCH_RUN_TOKEN=$RUN_LOG_TOKEN"
        --env "REF=$BENCH_REF"
        --env "CLOUDBENCH_GITHUB_TOKEN_B64=$_ghb64"
        --env "CLOUDBENCH_START_BARRIER=${CLOUDBENCH_START_BARRIER:-}"
        --env "CLOUDBENCH_BARRIER_TOKEN=${CLOUDBENCH_BARRIER_TOKEN:-}"
        --env "CLOUDBENCH_START_BARRIER_WAIT_SECONDS=${CLOUDBENCH_START_BARRIER_WAIT_SECONDS:-$RUN_TIMEOUT}"
        --env "CLOUDBENCH_FIRST_RUN_STACK_WAIT_SECONDS=${CLOUDBENCH_FIRST_RUN_STACK_WAIT_SECONDS:-2160}"
        --env "CLOUDBENCH_SEED_BUDGET_LIB=/cloudbench-seed-budget.sh"
        --env "CLOUDBENCH_STATUS_PORT=$REMOTE_STATUS_PORT"
        --env "WMH_MODEL_NAME=$WMH_MODEL_NAME"
        --env "WMH_ENGINE=$WMH_ENGINE"
        --env "WMH_ROSE_POOL=$WMH_ROSE_POOL"
        --env "WMH_CONTEXT_TOKENS=$WMH_CONTEXT_TOKENS"
        --env "WMH_EXECUTION_POLICY=$WMH_EXECUTION_POLICY"
        --env "BENCH_TASKS_B64=$TASKS_CSV_B64"
        --env "BENCH_MAX_CONCURRENCY=$BENCH_MAX_CONCURRENCY"
        --env "BENCH_SIMULATE=$BENCH_SIMULATE"
        --env "BENCH_DASHPORT=$REMOTE_DASH_PORT"
        --env "CONDUCTOR_WORKSPACE_NAME=$RUN_WORKSPACE_NAME"
        --env "BENCHMARK_HUB_PARENT_RUN_ID=${BENCHMARK_HUB_PARENT_RUN_ID:-}"
        --env "BENCHMARK_FAST_MODE_CACHE=${BENCHMARK_FAST_MODE_CACHE:-}"
        # Keep the override in the owned driver process. A pooled Machine must
        # not retain a replay probe's read-only flag for its next ordinary run.
        --env "CLOUDBENCH_FAST_CACHE_READ_ONLY=${BENCHMARK_DEMO_CACHE_READ_ONLY:-}"
        --env "BENCHMARK_WALL_CLOCK_BACKSTOP_SECONDS=$BENCHMARK_WALL_CLOCK_BACKSTOP_SECONDS"
        --env "BENCHMARK_CLAUDE_CODE_CACHE_RATCHET_WARN_ONLY=${BENCHMARK_CLAUDE_CODE_CACHE_RATCHET_WARN_ONLY:-}"
        --env "ROSE_EXCLUDE_ANTHROPIC_FAMILY=${ROSE_EXCLUDE_ANTHROPIC_FAMILY:-}"
        --env "BENCHMARK_PEAK_FLY_MACHINES=$OBSERVED_PEAK_FLY_MACHINES"
        --env "BENCHMARK_VM_USD_PER_HOUR=$VM_USD_PER_HOUR"
        --env "CLOUDBENCH_INFRA_PROBE=${CLOUDBENCH_INFRA_PROBE:-0}"
        --env "CLOUDBENCH_GUEST_AUTOSCALER_POLL_SECONDS=${CLOUDBENCH_GUEST_AUTOSCALER_POLL_SECONDS:-}"
        # Explicit (also when empty) so a pooled Machine never keeps an older run's value.
        --env "CLOUDBENCH_EXPECTED_GUEST_TEMPORAL_NAMESPACE=${CLOUDBENCH_EXPECTED_GUEST_TEMPORAL_NAMESPACE:-}"
        # One shared compute-token authority for every guest (empty = opted out).
        --env "CLOUDBENCH_COMPUTE_TOKEN_AUTHORITY_URL=$(cloudbench_compute_token_authority_url)"
    )
    _boot_command="bash /cloudbench-boot.sh"
    if [ -n "$CLOUDBENCH_ARCHIVED_PROOF_B64" ]; then
        [ "$mid" = "$FLEET_MACHINE_ID" ] || exit 1
        _envargs+=(--env CLOUDBENCH_STORAGE_MODE=retained-volume-fresh-generation
            --env "CLOUDBENCH_ARCHIVED_REUSE_PROOF_B64=$CLOUDBENCH_ARCHIVED_PROOF_B64"
            --env "CLOUDBENCH_ARCHIVED_REUSE_PROOF_SHA256=$CLOUDBENCH_ARCHIVED_PROOF_SHA")
        _boot_command="python3 -S /cloudbench-isolated-generation.py"
    fi
    _pool_shape_args=()
    if [ -n "${CLOUDBENCH_POOL_BOOT_VM_SIZE:-}" ] \
        || [ -n "${CLOUDBENCH_POOL_BOOT_VM_MEMORY:-}" ]; then
        if ! [[ "${CLOUDBENCH_POOL_BOOT_VM_SIZE:-}" =~ ^(shared-cpu|performance)-[1-9][0-9]*x$ ]]; then
            echo "❌ invalid claimed-pool VM size" >&2
            exit 70
        fi
        case "${CLOUDBENCH_POOL_BOOT_VM_MEMORY:-}" in
            ''|*[!0-9]*|0) echo "❌ invalid claimed-pool VM memory" >&2; exit 70 ;;
        esac
        _pool_shape_args=(--vm-size "$CLOUDBENCH_POOL_BOOT_VM_SIZE"
                          --vm-memory "$CLOUDBENCH_POOL_BOOT_VM_MEMORY")
    fi
    _boot_file_args=(
        --file-local "/cloudbench-boot.sh=$CLOUDBENCH_GUEST_BOOT_SCRIPT"
        --file-local "/cloudbench-run.sh=$CLOUDBENCH_GUEST_RUN_SCRIPT"
        --file-local "/process-identity.py=$CLOUDBENCH_GUEST_PROCESS_IDENTITY_SCRIPT"
        --file-local "/cloudbench-codex-auth.py=$CLOUDBENCH_GUEST_CODEX_AUTH_SCRIPT"
        --file-local "/cloudbench-fetch-ref.sh=$CLOUDBENCH_GUEST_FETCH_REF_SCRIPT"
        --file-local "/cloudbench-sync-deps.sh=$CLOUDBENCH_GUEST_SYNC_DEPS_SCRIPT"
        --file-local "/cloudbench-sync-prisma-client.sh=$CLOUDBENCH_GUEST_SYNC_PRISMA_SCRIPT"
        --file-local "/cloudbench-install-ngrok.sh=$CLOUDBENCH_GUEST_NGROK_INSTALL_SCRIPT"
        --file-local "/cloudbench-current-run-artifact.py=$CLOUDBENCH_GUEST_CURRENT_RUN_ARTIFACT_SCRIPT"
        --file-local "/cloudbench-prepare-patch.sh=$CLOUDBENCH_GUEST_PREPARE_PATCH_SCRIPT"
        --file-local "/cloudbench-status-server.py=$CLOUDBENCH_GUEST_STATUS_SERVER"
        --file-local "/cloudbench-benchmark-target.py=$CLOUDBENCH_GUEST_BENCHMARK_TARGET_SCRIPT"
        --file-local "/cloudbench_catalog.py=$CLOUDBENCH_GUEST_CATALOG_SCRIPT"
        --file-local "/cloudbench-env.sh=$CLOUDBENCH_GUEST_ENV_HELPER"
        --file-local "/cloudbench-seed-budget.sh=$CLOUDBENCH_GUEST_SEED_BUDGET_LIB"
        --file-local "/cloudbench-exact-session-cleanup.py=$CLOUDBENCH_GUEST_EXACT_SESSION_CLEANUP_SCRIPT"
        --file-local "/cloudbench-guest-recovery.py=$CLOUDBENCH_GUEST_RECOVERY_SCRIPT"
    )
    if [ "${CLOUDBENCH_REQUIRE_EXECUTION_PROVENANCE:-0}" = "1" ]; then
        _envargs+=(
            --env CLOUDBENCH_EXECUTION_PROVENANCE_SCRIPT=/cloudbench-execution-provenance.py
            --env CLOUDBENCH_EXECUTION_PROVENANCE_FILE=/cloudbench-execution-provenance.json
            --env CLOUDBENCH_REQUIRE_EXECUTION_PROVENANCE=1
        )
        _boot_file_args+=(
            --file-local "/cloudbench-execution-provenance.py=$CLOUDBENCH_GUEST_EXECUTION_PROVENANCE_SCRIPT"
            --file-local "/cloudbench-execution-provenance.json=$CLOUDBENCH_EXECUTION_PROVENANCE_FILE"
        )
    else
        # A pooled Machine can retain env from a prior Fleet run. Standalone
        # cloud runs explicitly disable that old requirement.
        _envargs+=(
            --env CLOUDBENCH_EXECUTION_PROVENANCE_SCRIPT=
            --env CLOUDBENCH_EXECUTION_PROVENANCE_FILE=
            --env CLOUDBENCH_REQUIRE_EXECUTION_PROVENANCE=0
        )
    fi
    if [ -n "$LOCAL_PATCH_FILE" ]; then
        # flyctl embeds every --file-local payload base64-encoded inside the
        # machine-config update body, and Fly caps that body. On 2026-09-08 a
        # 1.9MB workspace patch became ~2.5MB of base64 and Fly rejected the
        # whole update with `http: request body too large`, so every guest in a
        # 50-task fleet failed to boot and the campaign returned zero results
        # behind a generic provider error. Ship the patch compressed - a text
        # patch shrinks several-fold - and let the guest verify both the bytes
        # it received and the decompressed patch.
        #
        # LOCAL_PATCH_SHA256 stays the PLAINTEXT digest: it is the execution
        # provenance identity the guest re-verifies and the campaign compares.
        _boot_patch_local="$LOCAL_PATCH_FILE"
        _boot_patch_guest="/cloudbench-local.patch"
        _boot_patch_compression="none"
        _boot_patch_gz="$OUT_DIR/cloudbench-local.patch.gz"
        if gzip -9 -c "$LOCAL_PATCH_FILE" > "$_boot_patch_gz" 2>/dev/null \
           && [ -s "$_boot_patch_gz" ] \
           && [ "$(wc -c < "$_boot_patch_gz")" -lt "$(wc -c < "$LOCAL_PATCH_FILE")" ]; then
            _boot_patch_local="$_boot_patch_gz"
            _boot_patch_guest="/cloudbench-local.patch.gz"
            _boot_patch_compression="gzip"
        else
            rm -f "$_boot_patch_gz"
        fi
        _boot_patch_transport_sha256="$(cloudbench_env_sha256 "$_boot_patch_local")"
        [ -n "$_boot_patch_transport_sha256" ] || {
            echo "❌ boot-launch: could not fingerprint the transported workspace patch" >&2
            exit 1
        }
        _envargs+=(
            --env "LOCAL_PATCH_FILE=$_boot_patch_guest"
            --env "LOCAL_PATCH_SHA256=$LOCAL_PATCH_SHA256"
            --env "LOCAL_PATCH_COMPRESSION=$_boot_patch_compression"
            --env "LOCAL_PATCH_TRANSPORT_SHA256=$_boot_patch_transport_sha256"
        )
        _boot_file_args+=(--file-local "$_boot_patch_guest=$_boot_patch_local")
    else
        # A pooled Machine can retain config from an older run. Clear the path
        # and digest explicitly so it cannot apply a stale rootfs patch.
        _envargs+=(
            --env "LOCAL_PATCH_FILE=" --env "LOCAL_PATCH_SHA256="
            --env "LOCAL_PATCH_COMPRESSION=" --env "LOCAL_PATCH_TRANSPORT_SHA256="
        )
    fi
    if [ -n "$CLOUDBENCH_ARCHIVED_PROOF_B64" ]; then
        _boot_file_args+=(--file-local "/cloudbench-isolated-generation.py=$CLOUDBENCH_GUEST_GENERATION_SCRIPT")
    fi
    # BENCHMARK_FRONTEND_URL is consumed by run_benchmark.py for task prompt
    # substitution; cloud browser agents cannot reach the controller's localhost
    # dashboard mirror. Use a separate report-only URL so dashboard deep links can
    # still point at the local mirror without poisoning {frontend_url}.
    _envargs+=(--env "BENCHMARK_FRONTEND_URL=")
    # Report-card / RCA agent links must outlive the ephemeral dashboard mirror.
    # Always-on prod viewer rehydrates archived runs via findAgentAcrossRuns.
    [ "$DASHBOARD" = "1" ] && _envargs+=( --env "BENCHMARK_REPORT_FRONTEND_URL=https://roselabs.ai" )
    # The patch is only part of the request: uncompressed current bootstrap
    # helpers plus a compressed patch exceeded the provider body ceiling. Pack
    # every non-entrypoint file losslessly; preserve the original guest paths,
    # patch digests, and execution provenance after checksum-verified unpacking.
    _boot_payload_args=()
    _boot_entrypoint_args=()
    for _boot_pair in "${_boot_file_args[@]}"; do
        [ "$_boot_pair" = "--file-local" ] && continue
        case "${_boot_pair%%=*}" in
            /cloudbench-boot.sh|/cloudbench-status-server.py|/cloudbench-isolated-generation.py)
                _boot_entrypoint_args+=(--file-local "$_boot_pair") ;;
            *) _boot_payload_args+=(--file-local "$_boot_pair") ;;
        esac
    done
    _boot_payload_file="$OUT_DIR/cloudbench-boot-payload.json.gz"
    _boot_payload_sha256="$(python3 "$CLOUDBENCH_GUEST_BOOT_PAYLOAD_SCRIPT" pack \
        "$_boot_payload_file" "${_boot_payload_args[@]}")" || exit 1
    _boot_file_args=("${_boot_entrypoint_args[@]}"
        --file-local "/cloudbench-boot-payload.py=$CLOUDBENCH_GUEST_BOOT_PAYLOAD_SCRIPT"
        --file-local "/cloudbench-boot-payload.json.gz=$_boot_payload_file")
    _envargs+=(
        --env CLOUDBENCH_BOOT_PAYLOAD_FILE=/cloudbench-boot-payload.json.gz
        --env "CLOUDBENCH_BOOT_PAYLOAD_SHA256=$_boot_payload_sha256")
    boot_config_payload_guard() {  # <--file-local pairs...>
    # flyctl base64-encodes each --file-local payload into the machine-config
    # update body (4 bytes per 3 bytes of file). Fly rejects an oversized body
    # with a generic error, so measure first and name the offender.
    local total=0 largest=0 largest_path="" pair guest_path host_path bytes
    local ceiling="${CLOUDBENCH_BOOT_CONFIG_MAX_BYTES:-900000}"
    for pair in "$@"; do
        case "$pair" in --file-local) continue ;; esac
        guest_path="${pair%%=*}"
        host_path="${pair#*=}"
        [ "$host_path" != "$pair" ] || continue
        [ -f "$host_path" ] || continue
        bytes="$(wc -c < "$host_path")"
        bytes=$(( (bytes + 2) / 3 * 4 ))
        total=$(( total + bytes ))
        if [ "$bytes" -gt "$largest" ]; then
            largest="$bytes"
            largest_path="$guest_path"
        fi
    done
    [ "$total" -le "$ceiling" ] && return 0
    echo "❌ boot-launch: machine-config payload is ${total} encoded bytes, over the ${ceiling}-byte ceiling." >&2
    echo "   largest entry: ${largest_path} (${largest} encoded bytes)" >&2
    echo "   Fly rejects an oversized machine update with 'request body too large'." >&2
    echo "   Shrink the workspace delta, or raise CLOUDBENCH_BOOT_CONFIG_MAX_BYTES only after" >&2
    echo "   confirming the provider actually accepts a body that size." >&2
    return 1
}

# The boot script lives on the /data volume (staged into the snapshot). flyctl
    # --command word-splits, so only a simple `bash <path>` works (an inline shell
    # pipeline is lost) — hence a staged file, not an inline base64 command.
    #
    # CRITICAL: wait for the clone's snapshot volume to be MOUNTABLE before the
    # update. `machine update --command` restarts the machine to apply config; if
    # /data is not yet mounted (snapshot still restoring) the boot script's first
    # write to /data/bench.log fails and it exits 1 (observed: fleet clones cycled
    # boot→exit1 with an empty log while a settled box worked). Pure storage-ready
    # poll — no ssh.
    _sr_ts="$(date +%s)"
    while ! machine_storage_ready "$mid"; do
        [ $(( $(date +%s) - _sr_ts )) -ge "${CLOUDBENCH_READY_TIMEOUT:-600}" ] && { echo "❌ boot-launch: $mid storage not mountable in time" >&2; exit 1; }
        sleep 5
    done
    # Inject the boot script into the box via the machine config (--file-local) so
    # it needs NO snapshot/image staging — deterministic on every fresh clone and
    # always the CURRENT script — then run it as the --command. Written to a rootfs
    # path (not the /data volume, whose mount can race the config write).
    # Fail loudly and specifically BEFORE spending a provider round trip. A
    # generic `request body too large` after retries is indistinguishable from a
    # transient provider fault and silently killed a whole campaign.
    if [ "${CLOUDBENCH_BOOT_TRANSPORT:-config}" = staged ]; then
        # Reuse the exact boot payload/environment and all BOOT_LAUNCH evidence
        # handling. The helper admits only already matching inert Machines.
        printf '%s\0' "${_envargs[@]}" "${_boot_file_args[@]}" | \
            python3 "$CLOUDBENCH_RUNTIME_SCRIPT_ROOT/cloudbench-staged-boot.py" \
                --app "$APP" --machine "$mid" --run-token "$RUN_LOG_TOKEN" \
                --output "$OUT_DIR/staged-boot" \
                --vm-size "$CLOUDBENCH_POOL_BOOT_VM_SIZE" \
                --vm-memory "$CLOUDBENCH_POOL_BOOT_VM_MEMORY" \
                --ready-seconds "${CLOUDBENCH_READY_TIMEOUT:-600}" || exit 1
        printf '%s\n' "$mid" > "$POST_CONFIG_START_MARKER.tmp.$$"
        mv "$POST_CONFIG_START_MARKER.tmp.$$" "$POST_CONFIG_START_MARKER"
        stage_explicit_codex_auth /cloudbench-codex-auth.py || exit 1
    else
    boot_config_payload_guard "${_boot_file_args[@]}" || exit 1
    # Cross-workstream admission label: run-bench-fleet counts live labelled primaries
    # against the production pooler (demo) and delegating-guest (REAL/SIM) ceilings.
    _lane_args=(--metadata "rose_cloudbench_lane=$(cloudbench_guest_lane)")
    echo "🚀 boot-launch: injecting boot script + setting env/command on $mid (no ssh) ..."
    _upd=0
    _update_log="$OUT_DIR/cloudbench-boot-update.log"
    : > "$_update_log"
    # Fly reserves replacement CPU even for a config-only update on a stopped
    # Machine. Bound those provider mutations across the fleet; the separate
    # boot-config barrier still releases all guest starts together afterward.
    acquire_boot_config_update_slot || exit 1
    if BOOT_UPDATE_MACHINE_ID="$mid" \
        BOOT_UPDATE_HOST_UNRESPONSIVE_MARKER="$OUT_DIR/boot-config-host-unresponsive" \
        boot_update_with_capacity_recovery "$_update_log" \
          flyctl machine update "$mid" -a "$APP" "${_pool_shape_args[@]}" "${_envargs[@]}" \
          "${_lane_args[@]}" "${_boot_file_args[@]}" \
          --command "$_boot_command" --skip-health-checks --skip-start --yes; then
        _upd=1
    fi
    # boot_update_with_capacity_recovery records whether every native attempt
    # was joined; an unjoined interruption keeps its lease fenced.
    release_boot_config_update_slot
    if [ "$_upd" = 1 ] && [ "${#_pool_shape_args[@]}" -gt 0 ]; then
        _expected_kind="${CLOUDBENCH_POOL_BOOT_VM_SIZE%%-*}"
        _expected_cpus="${CLOUDBENCH_POOL_BOOT_VM_SIZE##*-}"
        _expected_cpus="${_expected_cpus%x}"
        _shape_verified=0
        for _shape_attempt in 1 2 3 4 5; do
            _actual_shape="$(FLY machines list -a "$APP" --json 2>/dev/null \
                | CLOUDBENCH_SHAPE_MACHINE="$mid" python3 -c '
import json, os, sys
try:
    machine = next(m for m in json.load(sys.stdin)
                   if m.get("id") == os.environ["CLOUDBENCH_SHAPE_MACHINE"])
    guest = machine["config"]["guest"]
    print(machine["state"], guest["cpu_kind"], guest["cpus"], guest["memory_mb"])
except Exception:
    print("")
' 2>/dev/null)" || _actual_shape=""
            if [ "$_actual_shape" = "stopped $_expected_kind $_expected_cpus $CLOUDBENCH_POOL_BOOT_VM_MEMORY" ]; then
                _shape_verified=1
                break
            fi
            sleep 2
        done
        if [ "$_shape_verified" != 1 ]; then
            echo "❌ claimed-pool VM resize was not provider-verified before start" >&2
            _upd=0
        fi
    fi
    [ "$_upd" = 1 ] || {
        echo "❌ boot-launch: could not set machine env/command after retries." >&2
        echo "─── final Fly update error ───" >&2
        tail -30 "$_update_log" 2>/dev/null | sed 's/^/   /' >&2 || true
        # The machine never received the boot command, so no guest process can
        # exist and no guest cleanup acknowledgement can ever be produced.
        # Record that durably: without it the fleet quarantines this owner
        # forever waiting for an acknowledgement nothing is able to send, and
        # the clone keeps running and billing with no sanctioned cleanup path.
        printf '%s\n' "$mid" > "$OUT_DIR/boot-config-unapplied" 2>/dev/null || true
        exit 1
    }
    rm -f "$_update_log"
    if [ -n "${CLOUDBENCH_BOOT_CONFIG_BARRIER:-}" ]; then
        mkdir -p "$CLOUDBENCH_BOOT_CONFIG_BARRIER/ready"
        : > "$CLOUDBENCH_BOOT_CONFIG_BARRIER/ready/$mid"
        _config_barrier_deadline=$((SECONDS + ${CLOUDBENCH_BOOT_CONFIG_BARRIER_WAIT_SECONDS:-1800}))
        while [ ! -f "$CLOUDBENCH_BOOT_CONFIG_BARRIER/release" ]; do
            if [ "$SECONDS" -ge "$_config_barrier_deadline" ]; then
                echo "❌ boot config barrier release timed out for $mid" >&2
                exit 1
            fi
            sleep 0.2
        done
    fi
    # The update above is explicitly `--skip-start`, so every child must submit
    # a post-barrier start mutation. Never let the shared inventory suppress it:
    # a generation published just before the update can still say `started`
    # after the provider has committed the Machine to `stopped`. The bounded,
    # idempotent start is the transition request; the data-plane health probe
    # below is the post-request proof that this exact Machine really booted.
    _start_log="$OUT_DIR/cloudbench-boot-start.log"
    : > "$_start_log"
    _start_ok=0
    for _s in $(seq 1 "${CLOUDBENCH_BOOT_START_ATTEMPTS:-4}"); do
        if _with_timeout "${CLOUDBENCH_BOOT_START_TIMEOUT:-60}" \
              flyctl machine start "$mid" -a "$APP" >> "$_start_log" 2>&1; then
            _start_ok=1
            break
        fi
        sleep $(( _s * 2 ))
    done
    if [ "$_start_ok" = 1 ]; then
        printf '%s\n' "$mid" > "$POST_CONFIG_START_MARKER.tmp.$$"
        mv "$POST_CONFIG_START_MARKER.tmp.$$" "$POST_CONFIG_START_MARKER"
        rm -f "$_start_log"
    else
        # An update can converge while every start request is rejected. Retain
        # the diagnostic and let the existing data-plane/current-run log proof
        # below decide whether this configured guest actually booted.
        echo "⚠️ boot-launch: post-config start ACK unavailable for $mid; checking the current guest over the data plane." >&2
    fi
    stage_explicit_codex_auth /cloudbench-codex-auth.py || {
        echo "❌ explicit Codex auth staging failed before benchmark setup" >&2
        exit 1
    }
    if [ "$_start_ok" = 1 ]; then
        echo "✅ boot-launch: $mid post-config start accepted — booting into the driver (polling over the data plane)."
    fi
    fi

else
# ── 1. Start the warm machine + wait until it is start+ssh-ready ────────────
# Generous timeout: ~10s warm, minutes on a cold image pull. Gate on BOTH the Fly
# machine state AND a trivial ssh echo (start != ssh-reachable).
echo "▶️  Starting warm machine $mid ..."
READY_TIMEOUT="${CLOUDBENCH_READY_TIMEOUT:-600}"   # 10 min ceiling for a cold pull.
start_ts="$(date +%s)"
last_start_ts=0
if machine_storage_ready "$mid"; then
    request_machine_start "$mid" || true
    last_start_ts="$start_ts"
else
    echo "⏳ Machine storage is still provisioning; waiting until it is mountable ..."
fi
gone_streak=0
while :; do
    if ssh_ready "$mid"; then break; fi
    st="$(machine_state "$mid")"
    # `machine_state` returns "gone" on ANY transient `fly machines list` miss or
    # error — and right after a clone the list is eventually-consistent, so a
    # just-created machine can flicker "gone" for a poll or two. Only treat it as
    # truly destroyed after several CONSECUTIVE gone reads; a real teardown stays
    # gone, a race recovers. (A first-read bail was killing fresh fleet clones.)
    if [ "$st" = "gone" ]; then
        gone_streak=$((gone_streak + 1))
        if [ "$gone_streak" -ge 6 ]; then
            echo "❌ Machine $mid disappeared while starting (6 consecutive gone reads)." >&2
            exit 1
        fi
        sleep 5
        continue
    fi
    gone_streak=0
    # Once clone storage is mountable, request start immediately and retry every
    # ~20s for ordinary transient start failures. Never ask Fly to start while
    # the attached snapshot volume is still restoring.
    now="$(date +%s)"
    case "$st" in
        started|starting) : ;;
        *)
            if machine_storage_ready "$mid" \
                && { [ "$last_start_ts" -eq 0 ] || [ $((now - last_start_ts)) -ge 20 ]; }; then
                request_machine_start "$mid" >/dev/null 2>&1 || true
                last_start_ts="$now"
            fi
            ;;
    esac
    if [ $((now - start_ts)) -ge "$READY_TIMEOUT" ]; then
        echo "❌ Machine $mid did not become start+ssh-ready within ${READY_TIMEOUT}s (state=$st)." >&2
        exit 1
    fi
    sleep 5
done
echo "✅ Machine started + ssh-ready ($mid)"

# Warm machines can retain a detached driver from an interrupted local
# controller. Clear it before touching the shared /data/repo checkout.
echo "🧹 Clearing stale on-box benchmark driver..."
ssh_read "$mid" "stale_pat='/data/[c]loudbench-run.sh|/tmp/[r]b.sh|benchmarks/[r]un_benchmark.py|[r]un_benchmark.py|scripts/[r]un.sh --benchmark|http.server $REMOTE_DASH_PORT|[g]it -C $REMOTE_REPO fetch|[i]ndex-pack.*fetch-pack'; pkill -TERM -f \"\$stale_pat\" 2>/dev/null || true; sleep 2; pkill -KILL -f \"\$stale_pat\" 2>/dev/null || true; rm -f '$REMOTE_REPO/.context/cloudbench/report-card.json' '$REMOTE_REPO/.context/cloudbench/run.json' 2>/dev/null || true; rm -f '$REMOTE_REPO/.git/index.lock' '$REMOTE_REPO/.git/'*.lock '$REMOTE_REPO/.git/refs/heads/'*.lock 2>/dev/null || true; git config --global --add safe.directory '$REMOTE_REPO' 2>/dev/null || true" >/dev/null 2>&1 || true

# ── 2. Deliver + launch the on-box driver DETACHED ──────────────────────────
# Upload the LOCAL cloudbench-run.sh, local git diff, and a small invocation
# wrapper, then launch DETACHED with setsid so the driver survives the ssh
# session closing. Do not embed these payloads in `ssh -C` argv: the local patch
# can be large, and oversized SSH commands fail before /tmp/rb.sh is written.
# (ssh -C returns 4294967295 when the remote backgrounds a process — so we never
# hold the session open; we poll /data/bench.log below.)
if [ ! -f "$CLOUDBENCH_GUEST_RUN_SCRIPT" ]; then
    echo "❌ Missing controller-owned cloudbench-run.sh." >&2
    exit 1
fi
for helper_path in \
    "$CLOUDBENCH_GUEST_PROCESS_IDENTITY_SCRIPT" \
    "$CLOUDBENCH_GUEST_FETCH_REF_SCRIPT" \
    "$CLOUDBENCH_GUEST_SYNC_DEPS_SCRIPT" \
    "$CLOUDBENCH_GUEST_SYNC_PRISMA_SCRIPT" \
    "$CLOUDBENCH_GUEST_CURRENT_RUN_ARTIFACT_SCRIPT" \
    "$CLOUDBENCH_GUEST_PREPARE_PATCH_SCRIPT" \
    "$CLOUDBENCH_GUEST_STATUS_SERVER" \
    "$CLOUDBENCH_GUEST_BENCHMARK_TARGET_SCRIPT" \
    "$CLOUDBENCH_GUEST_CATALOG_SCRIPT" \
    "$CLOUDBENCH_GUEST_EXACT_SESSION_CLEANUP_SCRIPT" \
    "$CLOUDBENCH_GUEST_RECOVERY_SCRIPT" \
    "$CLOUDBENCH_GUEST_ENV_HELPER" \
    "$CLOUDBENCH_GUEST_SEED_BUDGET_LIB"; do
    [ -s "$helper_path" ] || { echo "❌ Missing controller-owned guest helper: $helper_path" >&2; exit 1; }
done
if [ "${CLOUDBENCH_REQUIRE_EXECUTION_PROVENANCE:-0}" = "1" ]; then
    [ -s "$CLOUDBENCH_GUEST_EXECUTION_PROVENANCE_SCRIPT" ] \
        && [ -s "$CLOUDBENCH_EXECUTION_PROVENANCE_FILE" ] || {
        echo "❌ Missing controller-owned guest execution provenance bundle" >&2
        exit 1
    }
fi

# Proxy the box BACKEND (not its frontend) to the Mac. The local archive frontend
# talks to a local archive API which proxies live agent reads here with the
# benchmark API key — RLS-free, single-origin, no CORS. (flyctl proxy of the box
# frontend was fragile AND RLS-blocked; see agent_link_server.py.)
# LIVE_BACKEND_PORT/URL + CLOUDBENCH_API_KEY are now set once before the launch
# branch (shared by boot-launch + the post-launch proxy code).
CONTROLLER_GITHUB_TOKEN="$(cloudbench_controller_github_token)"
[ -n "$CONTROLLER_GITHUB_TOKEN" ] || { echo "❌ No current controller GitHub token available." >&2; exit 1; }
CONTROLLER_GITHUB_TOKEN_B64="$(printf '%s' "$CONTROLLER_GITHUB_TOKEN" | base64 | tr -d '\n')"

WRAPPER_LOCAL="$(mktemp)"
STAGED_LOCAL_FILES+=("$WRAPPER_LOCAL")
{
    echo "set -e"
    echo 'publish_driver_state() {'
    echo '    state="$1"'
    echo '    state_tmp="/data/cloudbench-driver.state.tmp.$$"'
    echo '    printf "%s\n" "$state" > "$state_tmp" && mv -f "$state_tmp" /data/cloudbench-driver.state'
    echo '}'
    echo "chmod +x /data/cloudbench-run.sh"
    echo "export REF=$(printf '%q' "$BENCH_REF")"
    echo "export CLOUDBENCH_GITHUB_TOKEN_B64=$(printf '%q' "$CONTROLLER_GITHUB_TOKEN_B64")"
    echo "export CLOUDBENCH_FETCH_REF_SCRIPT=/data/cloudbench-fetch-ref.sh"
    echo "export CLOUDBENCH_SYNC_DEPS_SCRIPT=/data/cloudbench-sync-deps.sh"
    echo "export CLOUDBENCH_SYNC_PRISMA_SCRIPT=/data/cloudbench-sync-prisma-client.sh"
    echo "export CLOUDBENCH_NGROK_INSTALL_SCRIPT=/data/cloudbench-install-ngrok.sh"
    echo "export CLOUDBENCH_CURRENT_RUN_ARTIFACT_SCRIPT=/data/cloudbench-current-run-artifact.py"
    echo "export CLOUDBENCH_PREPARE_PATCH_SCRIPT=/data/cloudbench-prepare-patch.sh"
    echo "export CLOUDBENCH_SEED_BUDGET_LIB=/data/cloudbench-seed-budget.sh"
    echo "export CLOUDBENCH_STATUS_SERVER_SCRIPT=/data/cloudbench-status-server.py"
    echo "export CLOUDBENCH_BENCHMARK_TARGET_SCRIPT=/data/cloudbench-benchmark-target.py"
    echo "export CLOUDBENCH_CATALOG_SCRIPT=/data/cloudbench_catalog.py"
    echo "export CLOUDBENCH_ENV_HELPER=/data/cloudbench-env.sh"
    echo "export CLOUDBENCH_EXACT_SESSION_CLEANUP_SCRIPT=/data/cloudbench-exact-session-cleanup.py"
    echo "export CLOUDBENCH_GUEST_RECOVERY_SCRIPT=/data/cloudbench-guest-recovery.py"
    if [ "${CLOUDBENCH_REQUIRE_EXECUTION_PROVENANCE:-0}" = "1" ]; then
        echo "export CLOUDBENCH_EXECUTION_PROVENANCE_SCRIPT=/data/cloudbench-execution-provenance.py"
        echo "export CLOUDBENCH_EXECUTION_PROVENANCE_FILE=/data/cloudbench-execution-provenance.json"
        echo "export CLOUDBENCH_REQUIRE_EXECUTION_PROVENANCE=1"
    else
        echo "unset CLOUDBENCH_EXECUTION_PROVENANCE_SCRIPT CLOUDBENCH_EXECUTION_PROVENANCE_FILE"
        echo "export CLOUDBENCH_REQUIRE_EXECUTION_PROVENANCE=0"
    fi
    echo "export CLOUDBENCH_RUN_TOKEN=$(printf '%q' "$RUN_LOG_TOKEN")"
    echo "unset CODEX_AUTH_PATH"
    echo "export CLOUDBENCH_CODEX_AUTH_HELPER=/data/cloudbench-codex-auth.py"
    echo "export CLOUDBENCH_CODEX_AUTH_SHA256=$(printf '%q' "$CODEX_AUTH_SHA256")"
    echo "export CLOUDBENCH_CODEX_AUTH_MACHINE_ID=$(printf '%q' "$mid")"
    echo "export CLOUDBENCH_START_BARRIER=$(printf '%q' "${CLOUDBENCH_START_BARRIER:-}")"
    echo "export CLOUDBENCH_BARRIER_TOKEN=$(printf '%q' "${CLOUDBENCH_BARRIER_TOKEN:-}")"
    echo "export CLOUDBENCH_START_BARRIER_WAIT_SECONDS=$(printf '%q' "${CLOUDBENCH_START_BARRIER_WAIT_SECONDS:-$RUN_TIMEOUT}")"
    echo "export CLOUDBENCH_FIRST_RUN_STACK_WAIT_SECONDS=$(printf '%q' "${CLOUDBENCH_FIRST_RUN_STACK_WAIT_SECONDS:-2160}")"
    echo "export WMH_MODEL_NAME=$(printf '%q' "$WMH_MODEL_NAME")"
    echo "export WMH_ENGINE=$(printf '%q' "$WMH_ENGINE")"
    echo "export WMH_ROSE_POOL=$(printf '%q' "$WMH_ROSE_POOL")"
    echo "export WMH_CONTEXT_TOKENS=$(printf '%q' "$WMH_CONTEXT_TOKENS")"
    echo "export WMH_EXECUTION_POLICY=$(printf '%q' "$WMH_EXECUTION_POLICY")"
    echo "export BENCH_TASKS_B64=$(printf '%q' "$TASKS_CSV_B64")"
    echo "export BENCH_MAX_CONCURRENCY=$(printf '%q' "$BENCH_MAX_CONCURRENCY")"
    echo "export BENCH_SIMULATE=$(printf '%q' "$BENCH_SIMULATE")"
    echo "export BENCH_DASHPORT=$(printf '%q' "$REMOTE_DASH_PORT")"
    echo "export CONDUCTOR_WORKSPACE_NAME=$(printf '%q' "$RUN_WORKSPACE_NAME")"
    echo "export BENCHMARK_FAST_MODE_CACHE=$(printf '%q' "${BENCHMARK_FAST_MODE_CACHE:-}")"
    if [ "${BENCHMARK_DEMO_CACHE_READ_ONLY:-}" = 1 ]; then
        echo "export CLOUDBENCH_FAST_CACHE_READ_ONLY=1"
    else
        echo "unset CLOUDBENCH_FAST_CACHE_READ_ONLY"
    fi
    echo "export BENCHMARK_WALL_CLOCK_BACKSTOP_SECONDS=$(printf '%q' "$BENCHMARK_WALL_CLOCK_BACKSTOP_SECONDS")"
    echo "export BENCHMARK_CLAUDE_CODE_CACHE_RATCHET_WARN_ONLY=$(printf '%q' "${BENCHMARK_CLAUDE_CODE_CACHE_RATCHET_WARN_ONLY:-}")"
    echo "export ROSE_EXCLUDE_ANTHROPIC_FAMILY=$(printf '%q' "${ROSE_EXCLUDE_ANTHROPIC_FAMILY:-}")"
    echo "export BENCHMARK_PEAK_FLY_MACHINES=$(printf '%q' "$OBSERVED_PEAK_FLY_MACHINES")"
    echo "export BENCHMARK_VM_USD_PER_HOUR=$(printf '%q' "$VM_USD_PER_HOUR")"
    echo "export CLOUDBENCH_INFRA_PROBE=$(printf '%q' "${CLOUDBENCH_INFRA_PROBE:-0}")"
    echo "export CLOUDBENCH_GUEST_AUTOSCALER_POLL_SECONDS=$(printf '%q' "${CLOUDBENCH_GUEST_AUTOSCALER_POLL_SECONDS:-}")"
    echo "export CLOUDBENCH_EXPECTED_GUEST_TEMPORAL_NAMESPACE=$(printf '%q' "${CLOUDBENCH_EXPECTED_GUEST_TEMPORAL_NAMESPACE:-}")"
    echo "export CLOUDBENCH_COMPUTE_TOKEN_AUTHORITY_URL=$(printf '%q' "$(cloudbench_compute_token_authority_url)")"
    echo "unset BENCHMARK_FRONTEND_URL"
    if [ "$DASHBOARD" = "1" ]; then
        # Persistent FE deep links for report cards / RCA evidence. The local
        # dashboard mirror is for live monitoring only and dies with the stack.
        echo "export BENCHMARK_REPORT_FRONTEND_URL=$(printf '%q' "https://roselabs.ai")"
    else
        echo "unset BENCHMARK_REPORT_FRONTEND_URL"
    fi
    echo "unset LOCAL_PATCH_B64"
    if [ -n "$LOCAL_PATCH_FILE" ]; then
        echo "export LOCAL_PATCH_FILE=/tmp/cloudbench-local.patch"
        echo "export LOCAL_PATCH_SHA256=$(printf '%q' "$LOCAL_PATCH_SHA256")"
    else
        echo "unset LOCAL_PATCH_FILE LOCAL_PATCH_SHA256"
    fi
    echo "rm -f $(printf '%q' "$REMOTE_TMP_SCRIPT")"
    echo 'driver_child=""'
    echo 'forward_driver_shutdown() {'
    echo '    [ -z "$driver_child" ] || kill -TERM "$driver_child" 2>/dev/null || true'
    echo '}'
    echo 'trap forward_driver_shutdown HUP INT TERM'
    echo 'set +e'
    echo 'bash /data/cloudbench-run.sh &'
    echo 'driver_child=$!'
    echo 'driver_pid_tmp="/data/cloudbench-driver.pid.tmp.$$"'
    echo 'printf "%s\n" "$driver_child" > "$driver_pid_tmp" && mv -f "$driver_pid_tmp" /data/cloudbench-driver.pid'
    echo 'publish_driver_state running'
    echo 'wait "$driver_child"'
    echo 'driver_rc=$?'
    echo 'if kill -0 "$driver_child" 2>/dev/null; then wait "$driver_child"; driver_rc=$?; fi'
    echo 'set -e'
    echo 'rm -f /data/cloudbench-driver.pid'
    echo 'publish_driver_state exited'
    echo 'exit "$driver_rc"'
} > "$WRAPPER_LOCAL"

# Upload the driver/wrapper/patch, truncate the log, launch detached.
echo ""
echo "📡 Launching the on-box driver DETACHED (logs → $REMOTE_LOG) ..."
echo "   tasks=[$TASKS_DISPLAY] ref=${BENCH_REF:-<HEAD>} simulate=$BENCH_SIMULATE workspace=$RUN_WORKSPACE_NAME"
# The launch ssh drops (4294967295) once it backgrounds, and can drop BEFORE it
# even truncates the log — leaving the PREVIOUS run's ::CLOUDBENCH-DONE:: in place
# so the poll below would exit instantly on a stale marker. So do it in VERIFIED
# steps: (a) reset+stamp the log, (b) upload/stage the driver, wrapper, and patch,
# (c) launch appending after the stamp — each retried until confirmed.
_ok=0
LOG_RESET_ATTEMPTS="${CLOUDBENCH_LOG_RESET_ATTEMPTS:-20}"
for _ in $(seq 1 "$LOG_RESET_ATTEMPTS"); do
    o="$(ssh_read "$mid" "rm -f /data/bench.log.generation; printf '%s\n' 'RUNSTAMP-$RUN_LOG_TOKEN' > '$REMOTE_LOG'; grep -q 'RUNSTAMP-$RUN_LOG_TOKEN' '$REMOTE_LOG' && echo STAMPED")"
    printf '%s' "$o" | grep -q STAMPED && { _ok=1; break; }; sleep 3
done
[ "$_ok" = 1 ] || { echo "❌ could not reset the on-box log after retries"; exit 1; }
_ok=0
stage_err="$(mktemp)"
STAGED_LOCAL_FILES+=("$stage_err")
# Stage the driver + wrapper (+ patch) as separate sftp puts. (A tar-in-one-upload
# variant was tried to cut SSH round-trips but proved flaky on reused pool boxes;
# reliability of the staging step matters more than ~30s, so we keep the puts.)
STAGE_ATTEMPTS="${CLOUDBENCH_STAGE_ATTEMPTS:-20}"
for _ in $(seq 1 "$STAGE_ATTEMPTS"); do
    : > "$stage_err"
    ssh_read "$mid" "rm -f /data/cloudbench-run.sh /data/process-identity.py /data/cloudbench-codex-auth.py /data/cloudbench-install-ngrok.sh /data/cloudbench-fetch-ref.sh /data/cloudbench-sync-deps.sh /data/cloudbench-sync-prisma-client.sh /data/cloudbench-current-run-artifact.py /data/cloudbench-prepare-patch.sh /data/cloudbench-status-server.py /data/cloudbench-benchmark-target.py /data/cloudbench_catalog.py /data/cloudbench-execution-provenance.py /data/cloudbench-execution-provenance.json /data/cloudbench-exact-session-cleanup.py /data/cloudbench-guest-recovery.py /data/cloudbench-env.sh /data/cloudbench-seed-budget.sh '$REMOTE_TMP_SCRIPT' /tmp/cloudbench-local.patch" >/dev/null 2>&1 || true
    provenance_stage_ok=1
    if [ "${CLOUDBENCH_REQUIRE_EXECUTION_PROVENANCE:-0}" = "1" ]; then
        FLY ssh sftp put -a "$APP" --machine "$mid" -q -m 0755 \
            "$CLOUDBENCH_GUEST_EXECUTION_PROVENANCE_SCRIPT" /data/cloudbench-execution-provenance.py >"$stage_err" 2>&1 \
            && FLY ssh sftp put -a "$APP" --machine "$mid" -q -m 0644 \
                "$CLOUDBENCH_EXECUTION_PROVENANCE_FILE" /data/cloudbench-execution-provenance.json >>"$stage_err" 2>&1 \
            || provenance_stage_ok=0
    fi
    if [ "$provenance_stage_ok" = "1" ] \
        && FLY ssh sftp put -a "$APP" --machine "$mid" -q -m 0755 "$CLOUDBENCH_GUEST_RUN_SCRIPT" /data/cloudbench-run.sh >>"$stage_err" 2>&1 \
        && FLY ssh sftp put -a "$APP" --machine "$mid" -q -m 0755 "$CLOUDBENCH_GUEST_PROCESS_IDENTITY_SCRIPT" /data/process-identity.py >>"$stage_err" 2>&1 \
        && FLY ssh sftp put -a "$APP" --machine "$mid" -q -m 0755 "$CLOUDBENCH_GUEST_CODEX_AUTH_SCRIPT" /data/cloudbench-codex-auth.py >>"$stage_err" 2>&1 \
        && FLY ssh sftp put -a "$APP" --machine "$mid" -q -m 0755 "$CLOUDBENCH_GUEST_FETCH_REF_SCRIPT" /data/cloudbench-fetch-ref.sh >>"$stage_err" 2>&1 \
        && FLY ssh sftp put -a "$APP" --machine "$mid" -q -m 0755 "$CLOUDBENCH_GUEST_SYNC_DEPS_SCRIPT" /data/cloudbench-sync-deps.sh >>"$stage_err" 2>&1 \
        && FLY ssh sftp put -a "$APP" --machine "$mid" -q -m 0755 "$CLOUDBENCH_GUEST_SYNC_PRISMA_SCRIPT" /data/cloudbench-sync-prisma-client.sh >>"$stage_err" 2>&1 \
        && FLY ssh sftp put -a "$APP" --machine "$mid" -q -m 0755 "$CLOUDBENCH_GUEST_NGROK_INSTALL_SCRIPT" /data/cloudbench-install-ngrok.sh >>"$stage_err" 2>&1 \
        && FLY ssh sftp put -a "$APP" --machine "$mid" -q -m 0755 "$CLOUDBENCH_GUEST_CURRENT_RUN_ARTIFACT_SCRIPT" /data/cloudbench-current-run-artifact.py >>"$stage_err" 2>&1 \
        && FLY ssh sftp put -a "$APP" --machine "$mid" -q -m 0755 "$CLOUDBENCH_GUEST_PREPARE_PATCH_SCRIPT" /data/cloudbench-prepare-patch.sh >>"$stage_err" 2>&1 \
        && FLY ssh sftp put -a "$APP" --machine "$mid" -q -m 0755 "$CLOUDBENCH_GUEST_STATUS_SERVER" /data/cloudbench-status-server.py >>"$stage_err" 2>&1 \
        && FLY ssh sftp put -a "$APP" --machine "$mid" -q -m 0755 "$CLOUDBENCH_GUEST_BENCHMARK_TARGET_SCRIPT" /data/cloudbench-benchmark-target.py >>"$stage_err" 2>&1 \
        && FLY ssh sftp put -a "$APP" --machine "$mid" -q -m 0755 "$CLOUDBENCH_GUEST_CATALOG_SCRIPT" /data/cloudbench_catalog.py >>"$stage_err" 2>&1 \
        && FLY ssh sftp put -a "$APP" --machine "$mid" -q -m 0755 "$CLOUDBENCH_GUEST_EXACT_SESSION_CLEANUP_SCRIPT" /data/cloudbench-exact-session-cleanup.py >>"$stage_err" 2>&1 \
        && FLY ssh sftp put -a "$APP" --machine "$mid" -q -m 0755 "$CLOUDBENCH_GUEST_RECOVERY_SCRIPT" /data/cloudbench-guest-recovery.py >>"$stage_err" 2>&1 \
        && FLY ssh sftp put -a "$APP" --machine "$mid" -q -m 0755 "$CLOUDBENCH_GUEST_ENV_HELPER" /data/cloudbench-env.sh >>"$stage_err" 2>&1 \
        && FLY ssh sftp put -a "$APP" --machine "$mid" -q -m 0755 "$CLOUDBENCH_GUEST_SEED_BUDGET_LIB" /data/cloudbench-seed-budget.sh >>"$stage_err" 2>&1 \
        && FLY ssh sftp put -a "$APP" --machine "$mid" -q -m 0755 "$WRAPPER_LOCAL" "$REMOTE_TMP_SCRIPT" >>"$stage_err" 2>&1; then
        if [ -n "$LOCAL_PATCH_FILE" ]; then
            FLY ssh sftp put -a "$APP" --machine "$mid" -q -m 0644 "$LOCAL_PATCH_FILE" /tmp/cloudbench-local.patch >>"$stage_err" 2>&1 || { sleep 3; continue; }
        else
            ssh_read "$mid" "rm -f /tmp/cloudbench-local.patch" >/dev/null 2>&1 || true
        fi
        o="$(ssh_read "$mid" "test -x /data/cloudbench-run.sh && grep -q cloudbench-run '$REMOTE_TMP_SCRIPT' && echo WROTE" 2>>"$stage_err")"
    else
        o=""
    fi
    printf '%s' "$o" | grep -q WROTE && { _ok=1; break; }; sleep 3
done
[ "$_ok" = 1 ] || {
    echo "❌ could not stage the on-box driver after retries"
    echo "─── staging error tail ───"
    tail -80 "$stage_err" 2>/dev/null | sed 's/^/   /' || true
    exit 1
}
# Launch the detached driver, and VERIFY it actually took — retry if not. At
# fleet width the launch ssh sometimes lands during a Fly API rate-limit window
# and the driver dies right after the launcher's RUNSTAMP marker, before its first
# step (observed: 16/30 boxes idle with only RUNSTAMP in the log). A single
# fire-and-forget launch (|| true) with a one-shot pgrep that only warned left
# those boxes hung until the barrier's hour-long timeout. Re-launching is SAFE:
# the wrapper self-deletes ($REMOTE_TMP_SCRIPT rm -f + exec), so on a box whose
# driver is already running the wrapper file is gone and the re-launch is a no-op;
# it only actually re-fires on boxes where the wrapper died before exec'ing.
# Start a tiny status HTTP server serving /data (which holds bench.log) so the
# controller can poll progress over the Fly DATA PLANE via `flyctl proxy`
# (WireGuard) instead of `flyctl ssh console` (rate-limited Machines API). One
# idempotent ssh (kill any stale server first) in its OWN call — bundling it into
# the driver-launch ssh regressed the launch (0/30 drivers progressed past
# RUNSTAMP), so keep them as the separate calls validated on the smoke. Bound to
# the box's private 6PN address, reachable only through the authenticated proxy.
STATUS_PROXY_PID=""
# LOCAL_STATUS_PORT was selected once above and is shared by both launch paths.
FLY ssh console -a "$APP" --machine "$mid" -C "bash -c \"rm -f /data/cloudbench-driver.pid /data/cloudbench-shutdown-${RUN_LOG_TOKEN}.request /data/cloudbench-driver-clean-${RUN_LOG_TOKEN}.ack; printf 'booting\\n' > /data/cloudbench-driver.state.tmp; mv -f /data/cloudbench-driver.state.tmp /data/cloudbench-driver.state; pkill -f 'cloudbench-status-server.py.*--port ${REMOTE_STATUS_PORT}' 2>/dev/null; sleep 1; setsid python3 /data/cloudbench-status-server.py --port ${REMOTE_STATUS_PORT} --directory /data --barrier '${CLOUDBENCH_START_BARRIER:-}' --run-token '${RUN_LOG_TOKEN}' >/dev/null 2>&1 < /dev/null &\"" >/dev/null 2>&1 || true

launch_attempts="${CLOUDBENCH_DRIVER_LAUNCH_ATTEMPTS:-4}"
_ok=0
for _la in $(seq 1 "$launch_attempts"); do
    FLY ssh console -a "$APP" --machine "$mid" -C "bash -c \"setsid bash '$REMOTE_TMP_SCRIPT' >> '$REMOTE_LOG' 2>&1 < /dev/null &\"" >/dev/null 2>&1 || true
    sleep "${CLOUDBENCH_LAUNCH_SETTLE_SECONDS:-5}"
    # Confirmed = the driver process is alive. A failed/rate-limited probe returns
    # empty (not RUNNING) and simply drives another attempt — never a false OK.
    o="$(ssh_read "$mid" "pgrep -f 'cloudbench-run.sh|/tmp/rb.sh' >/dev/null 2>&1 && echo RUNNING" 2>/dev/null)"
    if printf '%s' "$o" | grep -q RUNNING; then _ok=1; break; fi
    if [ "$_la" -lt "$launch_attempts" ]; then
        echo "   ⚠️ driver not confirmed running (attempt $_la/$launch_attempts) — re-launching after backoff..."
        sleep $(( _la * 4 + (RANDOM % 4) ))
    fi
done
if [ "$_ok" = 1 ]; then echo "✅ On-box driver launched + confirmed running."; else echo "   ⚠️ driver-running check inconclusive after $launch_attempts attempts; polling anyway (the poll loop will detect a dead driver)."; fi
stage_explicit_codex_auth /data/cloudbench-codex-auth.py || {
    echo "❌ explicit Codex auth staging failed before benchmark launch" >&2
    exit 1
}

fi  # end launch: boot-launch vs legacy ssh path

# Bring up the DATA-PLANE status proxy: one flyctl proxy (WireGuard tunnel) whose
# ongoing traffic never touches the Machines API. The poll loop reads bench.log
# over http://127.0.0.1:$LOCAL_STATUS_PORT through it, so 30 boxes polling every
# few seconds no longer saturate Fly's control-plane rate limit.
status_proxy_lifecycle_response_accepted() {
    cloudbench_status_proxy_lifecycle_response_accepted "$1"
}

start_data_plane_proxy() {  # <local-port> <remote-port> <host> <log> <pid-var> <label> [timeout]
    cloudbench_start_data_plane_proxy "$@"
}

publish_status_proxy_port() {
    local port="$1" tmp="$OUT_DIR/status-proxy.port.tmp.$$"
    case "$port" in ''|*[!0-9]*) return 1 ;; esac
    printf '%s\n' "$port" > "$tmp" || return 1
    mv "$tmp" "$OUT_DIR/status-proxy.port"
}

start_leased_data_plane_proxy() {  # <preferred> <port-var> <remote-port> <host> <log> <pid-var> <label> [timeout]
    local preferred="$1" port_var="$2" remote_port="$3" host="$4" log_file="$5"
    local pid_var="$6" label="$7" proxy_timeout="${8:-${CLOUDBENCH_DATA_PROXY_READY_TIMEOUT:-180}}"
    local port rc collision_count=0
    for _rotation in $(seq 1 25); do
        claim_local_port "$preferred" "$port_var" || {
            echo "❌ could not lease a local $label-proxy port" >&2
            return 1
        }
        port="${!port_var}"
        if start_data_plane_proxy "$port" "$remote_port" "$host" "$log_file" "$pid_var" "$label" "$proxy_timeout"; then
            if [ "$label" = "status" ]; then
                publish_status_proxy_port "$port" || {
                    cloudbench_proxy_stop "$pid_var" || return 1
                    release_local_port_lease "$port"
                    return 1
                }
            fi
            if [ "$collision_count" -gt 0 ]; then
                printf '[%s] %s proxy recovered after %s local bind collision(s); using localhost:%s\n' \
                    "$(date -u +%H:%M:%S)" "$label" "$collision_count" "$port" >> "$log_file"
            fi
            return 0
        else
            rc=$?
        fi
        release_local_port_lease "$port"
        if [ "$rc" -ne 98 ]; then
            return "$rc"
        fi
        collision_count=$((collision_count + 1))
        preferred=$((port + 1))
    done
    echo "❌ $label proxy exhausted local port rotation after $collision_count bind collisions" >&2
    return 1
}

# Fleet children already receive the controller's provider-authoritative keyed
# Machine record. Prefer its 6PN address: a newly cloned Machine can be started
# and reachable before Fly's derived .internal hostname appears in DNS. Direct
# maintenance runs have no fleet inventory owner and retain the hostname path.
REMOTE_STATUS_HOST="${mid}.vm.${APP}.internal"
if [ -n "$FLEET_MACHINE_ID" ]; then
    REMOTE_STATUS_HOST="$(_machine_record_field "$mid" private_ip 2>/dev/null || true)"
    [ -n "$REMOTE_STATUS_HOST" ] || {
        echo "❌ Fleet machine $mid has no provider-authoritative private IP for data-plane proxies." >&2
        exit 1
    }
fi
start_leased_data_plane_proxy "$((LOCAL_DASH_PORT + 3))" LOCAL_STATUS_PORT \
    "$REMOTE_STATUS_PORT" "$REMOTE_STATUS_HOST" "$OUT_DIR/cloudbench-status-proxy.log" \
    STATUS_PROXY_PID status || exit 1
echo "🛰️  status proxy: 127.0.0.1:$LOCAL_STATUS_PORT → fly:$REMOTE_STATUS_PORT (data plane; no Machines-API polling)"

# ── 3a. Proxy the box BACKEND to the Mac so running rows open a live view ────
# The local archive frontend renders benchmark agents by reading a local archive
# API that proxies live GETs here with the benchmark API key (bypassing RLS).
if [ "$DASHBOARD" = "1" ] || [ "$NEEDS_IMESSAGE_RELAY" = "1" ]; then
        REMOTE_BACKEND_HOST="$REMOTE_STATUS_HOST"
        start_leased_data_plane_proxy "$((LOCAL_DASH_PORT + 1))" LIVE_BACKEND_PORT \
            "$REMOTE_BACKEND_PORT" "$REMOTE_BACKEND_HOST" "$OUT_DIR/cloudbench-backend-proxy.log" \
            PROXY_PID backend || exit 1
        LIVE_BACKEND_URL="http://localhost:$LIVE_BACKEND_PORT"
        echo "🌐 Live backend proxy: $LIVE_BACKEND_URL → fly:$REMOTE_BACKEND_PORT"
        # Publish the live upstream so the DURABLE batch dashboard resolver can
        # serve THIS bench's agents mid-run (before run.json is saved locally).
        # machine_id + app let the resolver SSH-pull the running agent directly
        # from the box if the local flyctl proxy dies (a known Fly flakiness).
        printf '{"upstream_url":"%s","upstream_api_key":"%s","upstream_user_id":"%s","machine_id":"%s","app":"%s"}\n' \
            "$LIVE_BACKEND_URL" "$CLOUDBENCH_API_KEY" "$CLOUDBENCH_RUNNER_USER_ID" "$mid" "$APP" \
            > "$OUT_DIR/.upstream.json" 2>/dev/null || true
fi

# ── 3b. Bridge the exact benchmark backend to this Mac's Messages app ──────
# The backend/worker run inside Fly, but AppleScript must execute on macOS. For
# the live iMessage task only, run a fail-closed local relay through the exact
# machine-pinned backend proxy. It uses the installed Rose user's encrypted
# session and the current branch's IMessageSender implementation.
IMESSAGE_RELAY_LOG="$OUT_DIR/cloudbench-imessage-relay.log"
IMESSAGE_RELAY_MARKERS="$OUT_DIR/cloudbench-imessage-relay-markers.json"
if [ "$NEEDS_IMESSAGE_RELAY" = "1" ]; then
    if [ "$(uname -s)" != "Darwin" ]; then
        echo "❌ Live message-person benchmark requires a macOS controller for Apple Messages." >&2
        exit 1
    fi
    if [ -z "$LIVE_BACKEND_URL" ]; then
        echo "❌ Could not allocate the run-scoped backend proxy required by the iMessage relay." >&2
        exit 1
    fi
    RELAY_ENTRY="$ROOT_DIR/mac-app/scripts/cloudbench-imessage-relay.ts"
    RELAY_TSX="$ROOT_DIR/mac-app/node_modules/.bin/tsx"
    [ -f "$RELAY_ENTRY" ] || { echo "❌ Missing $RELAY_ENTRY" >&2; exit 1; }
    [ -x "$RELAY_TSX" ] || { echo "❌ Missing executable $RELAY_TSX" >&2; exit 1; }
    rm -f "$IMESSAGE_RELAY_LOG" "$IMESSAGE_RELAY_MARKERS"
    # Auto-login credentials for the benchmark user. If the installed Rose app
    # has no usable session, the relay signs in (as the expected user) via the
    # dev SMS OTP bypass instead of failing the run. Overridable via env.
    IMESSAGE_RELAY_AUTOLOGIN_PHONE="${CLOUDBENCH_IMESSAGE_AUTOLOGIN_PHONE:-+19729777432}"
    IMESSAGE_RELAY_AUTOLOGIN_OTP="${CLOUDBENCH_IMESSAGE_AUTOLOGIN_OTP:-181818}"
    (
        cd "$ROOT_DIR/mac-app" || exit 1
        BENCHMARK_IMESSAGE_API_KEY="$CLOUDBENCH_API_KEY" \
        "$RELAY_TSX" "$RELAY_ENTRY" \
            --base-url "$LIVE_BACKEND_URL" \
            --expected-user-id "$CLOUDBENCH_RUNNER_USER_ID" \
            --expected-phone "$IMESSAGE_RELAY_EXPECTED_PHONE" \
            --expected-message "$IMESSAGE_RELAY_EXPECTED_MESSAGE" \
            --marker-file "$IMESSAGE_RELAY_MARKERS" \
            --timeout-seconds "$RUN_TIMEOUT" \
            --auto-login-phone "$IMESSAGE_RELAY_AUTOLOGIN_PHONE" \
            --auto-login-otp "$IMESSAGE_RELAY_AUTOLOGIN_OTP"
    ) > "$IMESSAGE_RELAY_LOG" 2>&1 &
    IMESSAGE_RELAY_PID=$!
    echo "📨 Starting authenticated Mac iMessage relay (pid=$IMESSAGE_RELAY_PID) ..."
    # The relay establishes its heartbeat by polling this clone's backend, which
    # only serves after the on-box stack finishes booting (checkout → env → deps
    # refresh → credential sync → services) — the same multi-minute timeline the
    # fleet already budgets for reaching the synchronized start barrier. Wait for
    # that full window rather than a fixed 180s, which was shorter than a cold
    # backend boot and made message-person exit before the barrier (aborting the
    # whole group). The relay's own run deadline (--timeout-seconds) is unchanged.
    RELAY_HEARTBEAT_WAIT_SECONDS="${CLOUDBENCH_START_BARRIER_WAIT_SECONDS:-900}"
    RELAY_READY="0"
    for _ in $(seq 1 "$RELAY_HEARTBEAT_WAIT_SECONDS"); do
        if grep -q 'bridge heartbeat established' "$IMESSAGE_RELAY_LOG" 2>/dev/null; then
            RELAY_READY="1"
            break
        fi
        relay_driver_health="$(curl --noproxy '*' -sS --max-time 3 -o /dev/null -w '%{http_code}' \
            "http://127.0.0.1:$LOCAL_STATUS_PORT/driver-health" 2>/dev/null || true)"
        if [ "$relay_driver_health" = "410" ]; then
            echo "❌ remote benchmark driver exited before relay heartbeat." >&2
            tail -80 "$IMESSAGE_RELAY_LOG" 2>/dev/null | sed 's/^/   /' || true
            exit 1
        fi
        if ! kill -0 "$IMESSAGE_RELAY_PID" 2>/dev/null; then
            echo "❌ Mac iMessage relay exited before establishing its heartbeat." >&2
            tail -80 "$IMESSAGE_RELAY_LOG" 2>/dev/null | sed 's/^/   /' || true
            exit 1
        fi
        sleep 1
    done
    if [ "$RELAY_READY" != "1" ]; then
        echo "❌ Mac iMessage relay did not establish a heartbeat within ${RELAY_HEARTBEAT_WAIT_SECONDS} seconds." >&2
        tail -80 "$IMESSAGE_RELAY_LOG" 2>/dev/null | sed 's/^/   /' || true
        exit 1
    fi
    echo "✅ Authenticated Mac iMessage relay is polling this benchmark backend."
fi

# ── 3. Mirror the live dashboard to the Mac (URL printed; no auto-open) ─────
# The on-box driver writes $CONTEXT_DIR/report-card.json. We mirror that JSON to
# a local static dashboard instead of using `flyctl proxy`; proxy can connect to
# the wrong internal address or reset while the machine is healthy, which leaves
# Chrome blank even though the remote report card is valid.
if [ "$DASHBOARD" = "1" ]; then
    echo ""
    echo "🖥️  Serving live dashboard mirror on localhost:$LOCAL_DASH_PORT ..."
    DASH_DIR="$OUT_DIR/cloudbench-live"
    if [ -f "$DASH_DIR/agent-link-server.pid" ]; then
        old_dash_pid="$(cat "$DASH_DIR/agent-link-server.pid" 2>/dev/null || true)"
        [ -n "$old_dash_pid" ] && kill "$old_dash_pid" 2>/dev/null || true
    fi
    # Reap any archive-frontend Vite left over from a prior run so viewers never
    # accumulate across runs (the user's "no zombie workers").
    stop_live_archive_frontend
    for old_port_pid in $(lsof -tiTCP:"$LOCAL_DASH_PORT" -sTCP:LISTEN 2>/dev/null || true); do
        kill "$old_port_pid" 2>/dev/null || true
    done
    sleep 1
    rm -rf "$DASH_DIR"
    mkdir -p "$DASH_DIR"
    cp -f "$ROOT_DIR/agents/benchmarks/dashboard.html" "$DASH_DIR/dashboard.html" 2>/dev/null || true
python3 - "$DASH_DIR/report-card.json" "$BENCH_SIMULATE" "$OBSERVED_PEAK_FLY_MACHINES" "${BENCH_TASKS[@]}" <<'PY'
import json
import sys

path = sys.argv[1]
simulate = sys.argv[2] == "1"
peak = int(sys.argv[3])
names = sys.argv[4:]
card = {
    "run_id": "starting",
    "elapsed_s": 0,
    "world_model_mode": "simulate" if simulate else "real",
    "tasks": {"total": len(names), "running": 0, "completed": 0, "queued": len(names)},
    "results": {"passed": 0, "failed": 0, "transient": 0, "success_rate": 0},
    "cost": {"agents_llm_usd": 0, "wmh_grounding_usd": 0 if simulate else None, "total_usd": 0, "fast_cache_hit_rate": None},
    "infra": {"peak_machines": peak, "wmh_served": simulate},
    "metadata": {"tokens_in": 0, "tokens_out": 0},
    "per_task": [
        {
            "name": name,
            "status": "queued",
            "duration_s": None,
            "cost_usd": None,
            "agent_url": None,
            "tokens_in": 0,
            "tokens_out": 0,
        }
        for name in names
    ],
}
with open(path, "w") as f:
    json.dump(card, f)
    f.write("\n")
PY
    python3 "$ROOT_DIR/agents/benchmarks/agent_link_server.py" \
        --root "$DASH_DIR" \
        --host 127.0.0.1 \
        --port "$LOCAL_DASH_PORT" \
        --repo-root "$ROOT_DIR" \
        --context-dir "$ROOT_DIR/.context" \
        --frontend-dir "$ROOT_DIR/front-end" \
        --run-json "$OUT_DIR/run.json" \
        --preferred-archive-port "$((LOCAL_DASH_PORT + 10))" \
        --upstream-url "$LIVE_BACKEND_URL" \
        --upstream-api-key "$CLOUDBENCH_API_KEY" \
        --upstream-user-id "$CLOUDBENCH_RUNNER_USER_ID" \
        > "$DASH_DIR/server.log" 2>&1 &
    DASHBOARD_PID=$!
    printf '%s\n' "$DASHBOARD_PID" > "$DASH_DIR/agent-link-server.pid"
    (
        expected_total="${#BENCH_TASKS[@]}"
        expected_names_b64="$(printf '%s\n' "${BENCH_TASKS[@]}" | base64 | tr -d '\n')"
        while :; do
            tmp="$(mktemp)"
            # Boot-launch already has a machine-pinned data-plane proxy. Reuse
            # it for the live card too: an SSH read every second per bench was
            # 30 control-plane sessions/second at daily width and the final one
            # could remain hung after DONE while the controller tried to exit.
            if {
                if [ "${CLOUDBENCH_BOOT_LAUNCH:-0}" = "1" ]; then
                    # The parent can rotate its proxy after this mirror forks.
                    # Consume its published current port on every observation.
                    mirror_status_port=""
                    if [ -f "$OUT_DIR/status-proxy.port" ] && [ ! -L "$OUT_DIR/status-proxy.port" ]; then
                        mirror_status_port="$(cat "$OUT_DIR/status-proxy.port" 2>/dev/null || true)"
                    fi
                    case "$mirror_status_port" in
                        ''|*[!0-9]*) false ;;
                        *)
                            [ "$mirror_status_port" -gt 0 ] && [ "$mirror_status_port" -le 65535 ] \
                                && curl -fsS --max-time 6 \
                                    "http://127.0.0.1:$mirror_status_port/repo/.context/cloudbench/report-card.json"
                            ;;
                    esac
                else
                    ssh_read "$mid" "cat '$REMOTE_REPO/.context/cloudbench/report-card.json' 2>/dev/null"
                fi
            } > "$tmp" 2>/dev/null \
                && python3 -m json.tool "$tmp" >/dev/null 2>&1 \
                && python3 - "$tmp" "$expected_total" "$LOCAL_DASH_PORT" "$expected_names_b64" <<'PY' >/dev/null 2>&1
import base64
import json
import sys
from urllib.parse import parse_qs, urlparse

card = json.load(open(sys.argv[1]))
expected_total = int(sys.argv[2])
dashboard_port = sys.argv[3]
expected_names = {n for n in base64.b64decode(sys.argv[4]).decode().splitlines() if n}
tasks = card.get("tasks") or {}
per_task = card.get("per_task") or []
card_names = {str(row.get("name") or "") for row in per_task}
# Only publish a card that is actually THIS run: matching task count AND the exact
# task names. Otherwise a prior run's card with the same task count would slip in
# during the boot window and the dashboard would deep-link the wrong (stale) agent.
if tasks.get("total") == expected_total and len(per_task) == expected_total and card_names == expected_names:
    for row in per_task:
        url = row.get("agent_url")
        if not url:
            continue
        try:
            agent_id = (parse_qs(urlparse(url).query).get("agent-id") or [""])[0]
        except Exception:
            agent_id = ""
        if agent_id:
            row["agent_url"] = f"http://localhost:{dashboard_port}/open-agent?agent-id={agent_id}"
    with open(sys.argv[1], "w") as f:
        json.dump(card, f)
        f.write("\n")
    raise SystemExit(0)
raise SystemExit(1)
PY
            then
                # An old proxy response may arrive after replacement was published.
                if [ "${CLOUDBENCH_BOOT_LAUNCH:-0}" != "1" ] \
                    || { [ ! -L "$OUT_DIR/status-proxy.port" ] \
                        && [ "$mirror_status_port" = "$(cat "$OUT_DIR/status-proxy.port" 2>/dev/null || true)" ]; }; then
                    mv "$tmp" "$DASH_DIR/report-card.json"
                else
                    rm -f "$tmp"
                fi
            else
                rm -f "$tmp"
            fi
            sleep 1
        done
    ) &
    DASHBOARD_MIRROR_PID=$!
    DASH_URL="http://localhost:$LOCAL_DASH_PORT/dashboard.html"
    # Give the local server a moment, then open Chrome (macOS/best-effort).
    for _ in $(seq 1 20); do
        curl -fsS "$DASH_URL" >/dev/null 2>&1 && break
        sleep 1
    done
    # --no-open keeps the per-bench dashboard+viewer SERVING (so the batch
    # dashboard's "open agent" links resolve) but suppresses the auto-open —
    # run-bench-fleet opens ONE aggregated dashboard for the whole batch instead.
    if [ "${NO_OPEN:-0}" = "1" ]; then
        echo "   dashboard live (batch controller opens the aggregate): $DASH_URL"
    elif command -v open >/dev/null 2>&1; then
        echo "   view: $DASH_URL (or use the in-app Benchmarks tab)"
    else
        echo "   dashboard live (open manually): $DASH_URL"
    fi
fi

# ── 4. Poll /data/bench.log for the DONE marker (retry-wrapped ssh reads) ───
echo ""
if [ "$WATCHDOG_MODE" = "progress" ]; then
    echo "⏳ Polling $REMOTE_LOG for $DONE_MARKER (Polar semantic-inactivity watchdog ${POLAR_PROGRESS_STALL_SECONDS}s after guest contract attestation; no subsequent wall-clock cap)..."
else
    echo "⏳ Polling $REMOTE_LOG for $DONE_MARKER (hard timeout ${RUN_TIMEOUT}s)..."
fi
SSH_LOG="$(mktemp)"
BENCH_LOG_CHUNK_FILE="$(mktemp)"
BENCH_LOG_HEADERS_FILE="$(mktemp)"
BENCH_LOG_GENERATION_FILE="$(mktemp)"
BENCH_LOG_PROGRESS_FILE="$(mktemp)"
BENCH_PROGRESS_STATE_FILE="$(mktemp)"
: > "$BENCH_LOG_GENERATION_FILE"
: > "$BENCH_LOG_PROGRESS_FILE"
: > "$BENCH_PROGRESS_STATE_FILE"
BENCH_LOG_HAS_MORE="0"
BENCH_LOG_RESET="0"
BENCH_LOG_CHUNKS_READ="0"
FINISHED="0"; BENCH_EXIT=""; TIMED_OUT="0"
# Read the on-box bench.log only over the DATA-PLANE status proxy (HTTP over the
# WireGuard tunnel — zero Machines-API cost). Never fall back to SSH from inside
# this hard-deadline loop: a stopped box left flyctl SSH hung for hours, and 30
# simultaneous fallbacks recreate the exact API burst this path eliminated.
read_bench_log() {
    local offset="${1:-}" limit="${2:-${CLOUDBENCH_LOG_CHUNK_BYTES:-262144}}"
    local anchor="${3:-}" generation="${4:-}"
    local headers="${BENCH_LOG_HEADERS_FILE:-/dev/null}"
    BENCH_LOG_READ_EXIT=1
    BENCH_LOG_REQUEST_OFFSET="${offset:-0}"
    cloudbench_proxy_alive STATUS_PROXY_PID || return 1
    if [ -z "$offset" ]; then
        offset="$(wc -c < "$SSH_LOG" | tr -d ' ')"
    fi
    [[ "$offset" =~ ^[0-9]+$ ]] || return 2
    BENCH_LOG_REQUEST_OFFSET="$offset"
    [[ "$limit" =~ ^[1-9][0-9]*$ ]] || return 2
    [ "$limit" -le 262144 ] || return 2
    if [ -z "$anchor" ]; then
        if [ "$offset" = "0" ]; then
            anchor="e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
        else
            anchor="$(tail -c 4096 "$SSH_LOG" | python3 -S -c \
                'import hashlib, sys; print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())')"
        fi
    fi
    [[ "$anchor" =~ ^[0-9a-f]{64}$ ]] || return 2
    if [ -z "$generation" ] && [ -n "${BENCH_LOG_GENERATION_FILE:-}" ]; then
        generation="$(cat "$BENCH_LOG_GENERATION_FILE" 2>/dev/null || true)"
    fi
    [ -z "$generation" ] || [[ "$generation" =~ ^[0-9a-f]{32}$ ]] || return 2
    local curl_exit=0
    curl --noproxy '*' -sS --max-time 6 -D "$headers" \
        -H "X-Cloudbench-Log-Anchor: $anchor" \
        -H "X-Cloudbench-Log-Generation: $generation" \
        "http://127.0.0.1:$LOCAL_STATUS_PORT/bench.log?offset=$offset&limit=$limit" \
        2>/dev/null || curl_exit=$?
    BENCH_LOG_READ_EXIT="$curl_exit"
    return "$curl_exit"
}
cloudbench_response_header() {  # <name> <header-file>
    awk -F ':' -v wanted="$1" '
        tolower($1) == tolower(wanted) {
            value = $0
            sub(/^[^:]*:[[:space:]]*/, "", value)
            sub(/\r$/, "", value)
        }
        END { print value }
    ' "$2"
}
cloudbench_response_status() {  # <header-file>
    awk '/^HTTP\// { value = $2 } END { print value }' "$1" | tr -d '\r'
}
cloudbench_store_log_generation() {  # <generation>
    local generation="$1" temporary="${BENCH_LOG_GENERATION_FILE}.tmp.$$"
    [[ "$generation" =~ ^[0-9a-f]{32}$ ]] || return 1
    printf '%s\n' "$generation" > "$temporary" \
        && mv -f "$temporary" "$BENCH_LOG_GENERATION_FILE"
}
refresh_bench_log_checked() {  # [maximum bounded chunks]
    local max_chunks="${1:-1}" limit="${CLOUDBENCH_LOG_CHUNK_BYTES:-262144}"
    local chunks=0 offset status body_size range server_size server_generation server_continuity known_generation
    local range_start range_end range_total expected_size next_offset
    local reset_pending=0 reset_seen=0 reset_tmp first_line
    [[ "$max_chunks" =~ ^[1-9][0-9]*$ ]] || return 2
    [[ "$limit" =~ ^[1-9][0-9]*$ ]] || return 2
    [ "$max_chunks" -le 128 ] || return 2
    [ "$limit" -le 262144 ] || return 2
    BENCH_LOG_HAS_MORE="0"
    BENCH_LOG_RESET="0"
    BENCH_LOG_CHUNKS_READ="0"
    : > "$BENCH_LOG_PROGRESS_FILE"
    while [ "$chunks" -lt "$max_chunks" ]; do
        if [ "$reset_pending" = "1" ]; then
            offset="0"
        else
            offset="$(wc -c < "$SSH_LOG" | tr -d ' ')"
        fi
        : > "$BENCH_LOG_CHUNK_FILE"
        : > "$BENCH_LOG_HEADERS_FILE"
        if ! read_bench_log "$offset" "$limit" > "$BENCH_LOG_CHUNK_FILE"; then
            # curl can leave a response prefix after a timeout/reset. Keep it in
            # scratch; the last validated cumulative log remains byte-identical.
            return 1
        fi
        status="$(cloudbench_response_status "$BENCH_LOG_HEADERS_FILE")"
        body_size="$(wc -c < "$BENCH_LOG_CHUNK_FILE" | tr -d ' ')"
        server_size="$(cloudbench_response_header X-Cloudbench-Log-Size "$BENCH_LOG_HEADERS_FILE")"
        server_generation="$(cloudbench_response_header X-Cloudbench-Log-Generation "$BENCH_LOG_HEADERS_FILE")"
        server_continuity="$(cloudbench_response_header X-Cloudbench-Log-Continuity "$BENCH_LOG_HEADERS_FILE")"
        known_generation="$(cat "$BENCH_LOG_GENERATION_FILE" 2>/dev/null || true)"
        [[ "$server_generation" =~ ^[0-9a-f]{32}$ ]] || return 1
        [ "$server_continuity" = "1" ] || return 1
        case "$status" in
            204)
                [ "$reset_pending" = "0" ] || return 1
                case "$server_size" in ''|*[!0-9]*) return 1 ;; esac
                [ "$server_size" = "$offset" ] && [ "$body_size" = "0" ] || return 1
                [ -z "$known_generation" ] \
                    || [ "$known_generation" = "$server_generation" ] || return 1
                [ -n "$known_generation" ] \
                    || cloudbench_store_log_generation "$server_generation" || return 1
                BENCH_LOG_HAS_MORE="0"
                return 0
                ;;
            206)
                range="$(cloudbench_response_header Content-Range "$BENCH_LOG_HEADERS_FILE")"
                if [[ ! "$range" =~ ^bytes\ ([0-9]+)-([0-9]+)/([0-9]+)$ ]]; then
                    return 1
                fi
                range_start="${BASH_REMATCH[1]}"
                range_end="${BASH_REMATCH[2]}"
                range_total="${BASH_REMATCH[3]}"
                [ "$range_start" = "$offset" ] || return 1
                [ "$range_end" -ge "$range_start" ] || return 1
                [ "$range_total" -gt "$range_end" ] || return 1
                expected_size=$((range_end - range_start + 1))
                [ "$body_size" -eq "$expected_size" ] || return 1
                [ "$body_size" -le "$limit" ] || return 1
                [ -z "$known_generation" ] \
                    || [ "$known_generation" = "$server_generation" ] || return 1
                if [ "$offset" = "0" ]; then
                    IFS= read -r first_line < "$BENCH_LOG_CHUNK_FILE" || true
                    [ "$first_line" = "RUNSTAMP-$RUN_LOG_TOKEN" ] || return 1
                    reset_tmp="${SSH_LOG}.reset.$$"
                    if ! cp "$BENCH_LOG_CHUNK_FILE" "$reset_tmp" \
                        || ! mv -f "$reset_tmp" "$SSH_LOG"; then
                        rm -f "$reset_tmp" 2>/dev/null || true
                        return 1
                    fi
                    [ "$reset_pending" = "0" ] || BENCH_LOG_RESET="1"
                    reset_pending=0
                elif ! cat "$BENCH_LOG_CHUNK_FILE" >> "$SSH_LOG"; then
                    return 1
                fi
                cat "$BENCH_LOG_CHUNK_FILE" >> "$BENCH_LOG_PROGRESS_FILE" || return 1
                cloudbench_store_log_generation "$server_generation" || return 1
                chunks=$((chunks + 1))
                BENCH_LOG_CHUNKS_READ="$chunks"
                next_offset=$((range_end + 1))
                if [ "$next_offset" -lt "$range_total" ]; then
                    BENCH_LOG_HAS_MORE="1"
                else
                    BENCH_LOG_HAS_MORE="0"
                    return 0
                fi
                ;;
            409)
                [ "$reset_seen" = "0" ] || return 1
                case "$server_size" in ''|*[!0-9]*) return 1 ;; esac
                [ "$offset" -gt 0 ] && [ "$body_size" = "0" ] || return 1
                cloudbench_store_log_generation "$server_generation" || return 1
                : > "$BENCH_LOG_PROGRESS_FILE"
                reset_pending=1
                reset_seen=1
                ;;
            *)
                return 1
                ;;
        esac
    done
    return 0
}
record_bench_log_read_failure() {
    # Keep only bounded response metadata, never an unvalidated body or headers
    # that could contain credentials. This diagnostic cannot acknowledge a run.
    [ -n "${OUT_DIR:-}" ] || return 0
    python3 - "$OUT_DIR/remote-logs/bench-log-read-failures.json" \
        "$BENCH_LOG_HEADERS_FILE" "$BENCH_LOG_CHUNK_FILE" \
        "${BENCH_LOG_READ_EXIT:-1}" "${BENCH_LOG_REQUEST_OFFSET:-0}" <<'PY'
import datetime
import json
import pathlib
import sys

destination, headers_path, chunk_path, curl_exit, offset = sys.argv[1:]
headers = {}
status = ""
for line in pathlib.Path(headers_path).read_text(errors="replace").splitlines():
    if line.startswith("HTTP/"):
        parts = line.split()
        status = parts[1] if len(parts) > 1 else ""
        headers = {}
    elif ":" in line:
        name, value = line.split(":", 1)
        if name.lower() in {"content-range", "x-cloudbench-log-generation", "x-cloudbench-log-continuity"}:
            headers[name.lower()] = value.strip()[:256]
path = pathlib.Path(destination)
try:
    prior = json.loads(path.read_text())
except (OSError, ValueError):
    prior = []
if not isinstance(prior, list):
    prior = []
record = {
    "observed_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    "request_offset": int(offset),
    "curl_exit": int(curl_exit),
    "http_status": status,
    "received_bytes": pathlib.Path(chunk_path).stat().st_size,
    "content_range": headers.get("content-range", ""),
    "generation": headers.get("x-cloudbench-log-generation", ""),
    "continuity": headers.get("x-cloudbench-log-continuity", ""),
}
path.parent.mkdir(parents=True, exist_ok=True)
temporary = path.with_suffix(".tmp")
temporary.write_text(json.dumps([*prior[-19:], record], indent=2) + "\n")
temporary.replace(path)
PY
}
refresh_bench_log() {  # [maximum bounded chunks]
    local refresh_exit=0
    refresh_bench_log_checked "${1:-1}" || refresh_exit=$?
    if [ "$refresh_exit" -ne 0 ]; then
        record_bench_log_read_failure || true
    fi
    return "$refresh_exit"
}
refresh_bench_log_to_eof() {
    local max_chunks="${CLOUDBENCH_TERMINAL_LOG_MAX_CHUNKS:-128}"
    case "$max_chunks" in ''|*[!0-9]*|0) max_chunks=128 ;; esac
    [ "$max_chunks" -le 128 ] || max_chunks=128
    refresh_bench_log "$max_chunks" || return $?
    if [ "$BENCH_LOG_HAS_MORE" != "0" ]; then
        echo "❌ terminal bench.log exceeded bounded catch-up capacity" >&2
        return 1
    fi
}
status_proxy_transport_healthy() {
    local health_code
    cloudbench_proxy_alive STATUS_PROXY_PID || return 1
    # flyctl proxy can survive while its lazy DNS/GraphQL setup is wedged. PID
    # liveness alone is therefore not a transport contract. Both 204 (driver
    # alive) and 410 (server reachable, driver not yet/already gone) prove that
    # the tunnel reaches the authenticated on-box status service. 425 is the
    # explicit pre-launch lifecycle state while boot checkout is still running.
    health_code="$(curl --noproxy '*' -sS --max-time 3 -o /dev/null -w '%{http_code}' \
        "http://127.0.0.1:$LOCAL_STATUS_PORT/driver-health" 2>/dev/null || true)"
    status_proxy_lifecycle_response_accepted "$health_code"
}
ensure_status_proxy() {
    if ! status_proxy_transport_healthy; then
        cloudbench_proxy_stop STATUS_PROXY_PID || return 1
        STATUS_PROXY_PID=""
        release_local_port_lease "$LOCAL_STATUS_PORT"
        start_leased_data_plane_proxy "$LOCAL_STATUS_PORT" LOCAL_STATUS_PORT \
            "$REMOTE_STATUS_PORT" "$REMOTE_STATUS_HOST" "$OUT_DIR/cloudbench-status-proxy.log" \
            STATUS_PROXY_PID status 30
    fi
}
probe_driver_health() {
    local health_code
    health_code="$(curl -sS --max-time 3 -o /dev/null -w '%{http_code}' \
        "http://127.0.0.1:$LOCAL_STATUS_PORT/driver-health" 2>/dev/null || true)"
    case "$health_code" in
        204) return 0 ;;
        410) return 10 ;;
        *) return 20 ;;
    esac
}
recover_terminal_marker_after_dead_driver() {
    # A driver can finish and append its tokenized DONE marker between a failed
    # bench.log GET and the following health probe. A 410 proves only that the
    # driver is gone; it does not prove that no terminal result was durably
    # written. Reconnect and refetch before classifying the run as infra.
    local attempts="${CLOUDBENCH_DEAD_DRIVER_FINAL_READ_ATTEMPTS:-5}"
    local retry_sleep="${CLOUDBENCH_DEAD_DRIVER_FINAL_READ_SLEEP_SECONDS:-1}"
    local attempt
    case "$attempts" in ''|*[!0-9]*|0) attempts=5 ;; esac
    [ "$attempts" -le 5 ] || attempts=5
    case "$retry_sleep" in ''|*[!0-9]*) retry_sleep=1 ;; esac
    [ "$retry_sleep" -le 1 ] || retry_sleep=1
    for attempt in $(seq 1 "$attempts"); do
        ensure_status_proxy >/dev/null 2>&1 || true
        if cloudbench_collect_terminal_log; then
            if [ -n "$CURRENT_TERMINAL_EXIT" ]; then
                FINISHED="1"
                BENCH_EXIT="$CURRENT_TERMINAL_EXIT"
                return 0
            fi
        fi
        if [ "$attempt" -lt "$attempts" ] && [ "$retry_sleep" != "0" ]; then
            sleep "$retry_sleep"
        fi
    done
    return 1
}
probe_machine_liveness() {  # 0=started, 10=explicitly not running, 20=unknown
    local machines state
    machines="$(_with_timeout 10 flyctl machines list -a "$APP" --json 2>/dev/null)" || return 20
    state="$(printf '%s' "$machines" | MACHINE_ID="$mid" python3 -c '
import json, os, sys
try:
    machines = json.load(sys.stdin)
except Exception:
    raise SystemExit(2)
matches = [item for item in machines if item.get("id") == os.environ["MACHINE_ID"]]
if len(matches) != 1:
    print("absent" if not matches else "ambiguous")
else:
    print(matches[0].get("state") or "unknown")
' 2>/dev/null)" || return 20
    case "$state" in
        started) return 0 ;;
        stopped|stopping|destroyed|destroying|absent) return 10 ;;
        *) return 20 ;;
    esac
}
poll_start="$(date +%s)"
last_size="0"
last_change="$poll_start"
last_probe="$poll_start"
last_meaningful_progress="$poll_start"
progress_attested="0"
progress_barrier_ready="0"
progress_barrier_released="0"
terminal_pending_exit=""
terminal_pending_since=""
terminal_read_failures="0"
backlog_bytes="0"
backlog_active="0"
backlog_failures="0"
log_read_failures="0"
BENCH_LOG_CHUNKS_PER_POLL="${CLOUDBENCH_LOG_CHUNKS_PER_POLL:-4}"
case "$BENCH_LOG_CHUNKS_PER_POLL" in ''|*[!0-9]*|0) BENCH_LOG_CHUNKS_PER_POLL=4 ;; esac
[ "$BENCH_LOG_CHUNKS_PER_POLL" -le 4 ] || BENCH_LOG_CHUNKS_PER_POLL=4
# Every accepted chunk strictly advances the validated offset, so a backlog is
# bounded by bytes, not by a chunk count: the 51-agent mass-agent terminal
# burst is ~33.5 MiB and tripped the former 128 x 256 KiB cap on every copy
# (descend-full69-20261023 P8), truncating the guest's own FATAL lines. The
# ceiling matches the guest's 512 MiB runtime-evidence bound; a backlog that
# stops advancing still fails after BENCH_LOG_BACKLOG_MAX_FAILURES retries.
BENCH_LOG_BACKLOG_MAX_BYTES="${CLOUDBENCH_LOG_BACKLOG_MAX_BYTES:-536870912}"
case "$BENCH_LOG_BACKLOG_MAX_BYTES" in ''|*[!0-9]*|0) BENCH_LOG_BACKLOG_MAX_BYTES=536870912 ;; esac
[ "$BENCH_LOG_BACKLOG_MAX_BYTES" -le 536870912 ] || BENCH_LOG_BACKLOG_MAX_BYTES=536870912
BENCH_LOG_BACKLOG_MAX_FAILURES="${CLOUDBENCH_LOG_BACKLOG_MAX_FAILURES:-5}"
case "$BENCH_LOG_BACKLOG_MAX_FAILURES" in ''|*[!0-9]*|0) BENCH_LOG_BACKLOG_MAX_FAILURES=5 ;; esac
[ "$BENCH_LOG_BACKLOG_MAX_FAILURES" -le 5 ] || BENCH_LOG_BACKLOG_MAX_FAILURES=5
BENCH_LOG_READ_MAX_FAILURES="${CLOUDBENCH_LOG_READ_MAX_FAILURES:-5}"
case "$BENCH_LOG_READ_MAX_FAILURES" in ''|*[!0-9]*|0) BENCH_LOG_READ_MAX_FAILURES=5 ;; esac
[ "$BENCH_LOG_READ_MAX_FAILURES" -le 5 ] || BENCH_LOG_READ_MAX_FAILURES=5
BENCH_LOG_TERMINAL_MAX_FAILURES="${CLOUDBENCH_LOG_TERMINAL_MAX_FAILURES:-5}"
case "$BENCH_LOG_TERMINAL_MAX_FAILURES" in ''|*[!0-9]*|0) BENCH_LOG_TERMINAL_MAX_FAILURES=5 ;; esac
[ "$BENCH_LOG_TERMINAL_MAX_FAILURES" -le 5 ] || BENCH_LOG_TERMINAL_MAX_FAILURES=5
BENCH_LOG_TERMINAL_WAIT_SECONDS="${CLOUDBENCH_CHILD_TERM_SECONDS:-30}"
case "$BENCH_LOG_TERMINAL_WAIT_SECONDS" in ''|*[!0-9]*|0) BENCH_LOG_TERMINAL_WAIT_SECONDS=30 ;; esac
[ "$BENCH_LOG_TERMINAL_WAIT_SECONDS" -le 30 ] || BENCH_LOG_TERMINAL_WAIT_SECONDS=30
driver_absent=0
DRIVER_DIED="0"
# Set when the poll loop declares infrastructure failure while the driver may
# still be running (lost or unusable data plane, or a Machine that is gone).
# No guest will seal runtime evidence unprompted, so the post-loop collector
# must not wait the whole wall-clock backstop for that seal.
PRETERMINAL_INFRA_FAILURE="0"
# The detached on-box driver occasionally dies at launch (an early kill/crash
# before its first STEP — seen at fleet width when the Fly API is rate-limited).
# It then never writes the DONE marker, so a poll loop that only watches for DONE
# or the hard timeout would spin the FULL RUN_TIMEOUT while the
# fleet's synchronized-start barrier waits on this box — one flaky launch stalling
# the whole batch for an hour. When the log stops growing, verify the driver
# process is still alive; if it's gone with no DONE marker, stop promptly and
# report a bring-up (infra) failure so the fleet controller excludes this box fast.
DRIVER_STALL_SECONDS="${CLOUDBENCH_DRIVER_STALL_SECONDS:-210}"
# A finite terminal artifact burst can be much larger than one chunk. Drain
# known backlog at wire speed; fail only when it exceeds the byte ceiling or
# stops advancing. Sets BACKLOG_DECISION to idle|drain|retry|exceeded|stuck.
cloudbench_bench_log_backlog_step() {  # <refresh-ok 0|1> <bytes appended by this refresh>
    local refresh_ok="$1" appended="$2"
    [[ "$appended" =~ ^[0-9]+$ ]] || appended=0
    if [ "$refresh_ok" = "1" ]; then
        if [ "$BENCH_LOG_HAS_MORE" = "1" ]; then
            backlog_active="1"
            backlog_failures="0"
        else
            backlog_active="0"
            backlog_bytes="0"
            backlog_failures="0"
        fi
    elif [ "$BENCH_LOG_HAS_MORE" = "1" ]; then
        backlog_active="1"
    fi
    BACKLOG_DECISION="idle"
    [ "$backlog_active" = "1" ] || return 0
    backlog_bytes=$((backlog_bytes + appended))
    if [ "$backlog_bytes" -gt "$BENCH_LOG_BACKLOG_MAX_BYTES" ]; then
        BACKLOG_DECISION="exceeded"
        return 0
    fi
    if [ "$refresh_ok" = "1" ]; then
        BACKLOG_DECISION="drain"
        return 0
    fi
    backlog_failures=$((backlog_failures + 1))
    if [ "$backlog_failures" -ge "$BENCH_LOG_BACKLOG_MAX_FAILURES" ]; then
        BACKLOG_DECISION="stuck"
    else
        BACKLOG_DECISION="retry"
    fi
}
while :; do
    now="$(date +%s)"
    # Pull only bounded append-only chunks over the data plane. The local file is
    # the complete validated accumulator used for progress, DONE, and artifacts;
    # response prefixes from failed transfers never enter it.
    # Restart a tunnel that dies after startup in the parent shell, so the new
    # PID remains owned and reapable.
    ensure_status_proxy >/dev/null 2>&1 || true
    log_refresh_ok="0"
    log_size_before="$(wc -c < "$SSH_LOG" | tr -d ' ')"
    refresh_bench_log "$BENCH_LOG_CHUNKS_PER_POLL" 2>/dev/null \
        && log_refresh_ok="1"
    log_size_after="$(wc -c < "$SSH_LOG" | tr -d ' ')"
    if [ "$BENCH_LOG_RESET" = "1" ] || [ "$log_size_after" -lt "$log_size_before" ]; then
        log_bytes_appended="$log_size_after"
    else
        log_bytes_appended=$((log_size_after - log_size_before))
    fi
    if [ "${CLOUDBENCH_BOOT_LAUNCH:-0}" = "1" ] \
       && [ "${_start_ok:-1}" = "0" ] && [ "$log_refresh_ok" = "1" ] \
       && [ -s "$SSH_LOG" ] && cloudbench_proxy_alive STATUS_PROXY_PID; then
        # refresh_bench_log accepted this exact RUNSTAMP with the bounded log
        # continuity protocol. A dead lifecycle never acknowledges boot.
        _start_health="$(curl --noproxy '*' -sS --max-time 3 -o /dev/null -w '%{http_code}' \
            "http://127.0.0.1:$LOCAL_STATUS_PORT/driver-health" 2>/dev/null || true)"
        case "$_start_health" in
            204|425)
                if cloudbench_proxy_alive STATUS_PROXY_PID; then
                    printf '%s\n' "$mid" > "$POST_CONFIG_START_MARKER.tmp.$$"
                    mv "$POST_CONFIG_START_MARKER.tmp.$$" "$POST_CONFIG_START_MARKER"
                    _start_ok=1
                    echo "✅ boot-launch: $mid current guest verified after post-config start ACK rejection."
                fi
                ;;
        esac
    fi
    # A later chunk can fail after earlier chunks were already validated and
    # committed. Consume that bounded delta even when the overall refresh asks
    # the next poll to retry; otherwise a semantic line can be skipped forever.
    if [ -s "$BENCH_LOG_PROGRESS_FILE" ]; then
        if ! progress_update="$(cloudbench_update_progress_state \
            "$BENCH_PROGRESS_STATE_FILE" "$BENCH_LOG_PROGRESS_FILE" \
            "$RUN_LOG_TOKEN" "$WATCHDOG_TASK" "$WATCHDOG_BUDGET" \
            "$BENCH_LOG_RESET" 2>/dev/null)"; then
            echo "❌ validated bench.log delta could not update bounded progress state -- infrastructure failure" >&2
            DRIVER_DIED="1"; PRETERMINAL_INFRA_FAILURE="1"; BENCH_EXIT="1"
            break
        fi
        if ! cloudbench_apply_progress_update "$progress_update" "$now"; then
            echo "❌ bounded progress state returned an invalid update -- infrastructure failure" >&2
            DRIVER_DIED="1"; PRETERMINAL_INFRA_FAILURE="1"; BENCH_EXIT="1"
            break
        fi
    fi
    if [ "$BENCH_LOG_CHUNKS_READ" -gt 0 ]; then
        if [ "$BENCH_LOG_RESET" = "1" ]; then
            last_size="0"
        fi
        cur_size="$(wc -c < "$SSH_LOG" | tr -d ' ')"
        if [ "$cur_size" != "$last_size" ]; then
            # Show only the newest progress lines to keep the console readable.
            tail -3 "$SSH_LOG" 2>/dev/null | sed 's/^/   │ /' || true
            last_size="$cur_size"
            last_change="$now"
        fi
    fi
    # A box waiting AT the synchronized-start barrier legitimately produces NO
    # output. Persisted incremental state must pause the lease on every EOF poll,
    # not just on the one poll that first accepted the "barrier ready" line.
    if [ "$progress_barrier_ready" = "1" ] \
       && [ "$progress_barrier_released" != "1" ]; then
        last_change="$now"
        [ "$WATCHDOG_MODE" = "progress" ] && last_meaningful_progress="$now"
    fi
    cloudbench_bench_log_backlog_step "$log_refresh_ok" "$log_bytes_appended"
    case "$BACKLOG_DECISION" in
        drain) continue ;;
        retry)
            sleep 1
            continue
            ;;
        exceeded)
            echo "❌ bench.log backlog exceeded ${BENCH_LOG_BACKLOG_MAX_BYTES} bytes before EOF -- infrastructure failure" >&2
            DRIVER_DIED="1"; PRETERMINAL_INFRA_FAILURE="1"; BENCH_EXIT="1"
            break
            ;;
        stuck)
            echo "❌ bench.log backlog could not advance after ${BENCH_LOG_BACKLOG_MAX_FAILURES} bounded retries -- infrastructure failure" >&2
            DRIVER_DIED="1"; PRETERMINAL_INFRA_FAILURE="1"; BENCH_EXIT="1"
            break
            ;;
    esac
    # A failed first/EOF read provides no current durable state. Never let a
    # healthy but temporarily unreadable guest fall through to a benchmark
    # deadline classification. Retry only a fixed number of times, then report
    # the transport/contract failure as infrastructure.
    if cloudbench_log_read_gate "$log_refresh_ok"; then
        log_read_gate_rc="0"
    else
        log_read_gate_rc="$?"
    fi
    case "$log_read_gate_rc" in
        0) ;;
        10)
            sleep 1
            continue
            ;;
        20)
            echo "❌ bench.log could not be read after ${BENCH_LOG_READ_MAX_FAILURES} bounded retries -- infrastructure failure" >&2
            DRIVER_DIED="1"; PRETERMINAL_INFRA_FAILURE="1"; BENCH_EXIT="1"
            break
            ;;
        *)
            echo "❌ invalid bench.log read-gate state -- infrastructure failure" >&2
            DRIVER_DIED="1"; PRETERMINAL_INFRA_FAILURE="1"; BENCH_EXIT="1"
            break
            ;;
    esac
    # DONE belongs to the benchmark result, but the driver and boot supervisor
    # append cleanup evidence after it. Wait for the exact driver lifecycle to
    # become terminal, then perform one bounded EOF catch-up before collection.
    #
    # Infra probes and DEMO --skip-autoscaler fleets are different:
    # cloudbench-run.sh finish() emits DONE then the boot entrypoint holds the
    # process for controller collection ("holding for controller collection").
    # Waiting for driver-health 410 then races that intentional hold into
    # "driver did not exit within … window" (FINISHED=0 → exit 1 → cleanup 125
    # CHILDFAIL) even when the artifact is a clean PASS. Accept token-bound
    # DONE immediately.
    if [ -n "$terminal_pending_exit" ]; then
        if cloudbench_skip_held_driver_teardown_race; then
            CURRENT_TERMINAL_EXIT="$terminal_pending_exit"
            FINISHED="1"
            BENCH_EXIT="$CURRENT_TERMINAL_EXIT"
            break
        fi
        probe_driver_health; terminal_health_rc=$?
        if [ "$terminal_health_rc" = "10" ]; then
            if cloudbench_collect_terminal_log; then
                FINISHED="1"
                BENCH_EXIT="$CURRENT_TERMINAL_EXIT"
                break
            else
                terminal_collect_rc="$?"
            fi
            if [ "$terminal_collect_rc" = "20" ]; then
                echo "❌ complete terminal bench.log omitted the token-bound DONE marker -- infrastructure failure" >&2
                DRIVER_DIED="1"; BENCH_EXIT="1"
                break
            fi
            terminal_read_failures=$((terminal_read_failures + 1))
            if [ "$terminal_read_failures" -ge "$BENCH_LOG_TERMINAL_MAX_FAILURES" ]; then
                echo "❌ could not collect complete terminal bench.log after ${BENCH_LOG_TERMINAL_MAX_FAILURES} bounded attempts -- infrastructure failure" >&2
                DRIVER_DIED="1"; BENCH_EXIT="1"
                break
            fi
            sleep 1
            continue
        fi
        if [ $((now - terminal_pending_since)) -ge "$BENCH_LOG_TERMINAL_WAIT_SECONDS" ]; then
            echo "❌ driver did not exit within the bounded terminal log catch-up window" >&2
            DRIVER_DIED="1"; BENCH_EXIT="1"
            break
        fi
        sleep 1
        continue
    fi
    # Read current durable state before every deadline decision so a result or
    # semantic event landing on the boundary wins the race with teardown.
    if [ "$WATCHDOG_MODE" = "absolute" ] \
       && cloudbench_watchdog_expired "$WATCHDOG_MODE" "$now" "$poll_start" \
            "$last_meaningful_progress" "$RUN_TIMEOUT" "$POLAR_PROGRESS_STALL_SECONDS"; then
        echo "⏱️  Hard timeout (${RUN_TIMEOUT}s) reached — capturing partial log + stopping."
        TIMED_OUT="1"
        break
    fi
    if [ "$WATCHDOG_MODE" = "progress" ]; then
        if [ "$progress_attested" != "1" ]; then
            # Local metadata is only a candidate policy: --ref/patch can change
            # the guest catalog.  Until the exact guest task+budget declaration
            # is observed, fail closed to the historical bring-up wall clock.
            if cloudbench_watchdog_expired "absolute" "$now" "$poll_start" \
                "$last_meaningful_progress" "$RUN_TIMEOUT" "$POLAR_PROGRESS_STALL_SECONDS"; then
                echo "⏱️  Hard timeout (${RUN_TIMEOUT}s) reached before the guest attested the Polar step-budget contract — capturing partial log + stopping."
                TIMED_OUT="1"
                break
            fi
        elif cloudbench_watchdog_expired "$WATCHDOG_MODE" "$now" "$poll_start" \
            "$last_meaningful_progress" "$RUN_TIMEOUT" "$POLAR_PROGRESS_STALL_SECONDS"; then
            echo "⏱️  Polar benchmark made no semantic progress for ${POLAR_PROGRESS_STALL_SECONDS}s — capturing partial log + stopping."
            TIMED_OUT="1"
            break
        fi
    fi
    # A quiet log is not proof of death: npm, pg_restore, stack startup, and a real
    # benchmark can all run silently for minutes. Once the quiet threshold is hit,
    # ask the authenticated data-plane status service whether the driver PID still
    # exists. This keeps dead-driver detection fast without killing valid quiet work.
    if [ $((now - last_change)) -ge "$DRIVER_STALL_SECONDS" ]; then
        driver_health="unknown"
        if cloudbench_proxy_alive STATUS_PROXY_PID; then
            for _health_attempt in $(seq 1 5); do
                probe_driver_health; health_rc=$?
                [ "$health_rc" = "0" ] && { driver_health="alive"; break; }
                [ "$health_rc" = "10" ] && { driver_health="dead"; break; }
                sleep 1
            done
            if [ "$driver_health" = "dead" ]; then
                if recover_terminal_marker_after_dead_driver; then
                    echo "✅ recovered durable terminal marker after the on-box driver exited."
                    break
                fi
                echo "❌ on-box driver confirmed dead after ${DRIVER_STALL_SECONDS}s without progress -- bring-up (infra) failure; stopping this box so the fleet can proceed."
                DRIVER_DIED="1"; BENCH_EXIT="1"
                break
            fi
        fi
        if [ "$driver_health" = "unknown" ]; then
            probe_machine_liveness; machine_rc=$?
            if [ "$machine_rc" = "10" ]; then
                echo "❌ Fly machine is explicitly no longer running after ${DRIVER_STALL_SECONDS}s without progress -- infrastructure failure; stopping this box so the fleet can abort promptly."
                DRIVER_DIED="1"; PRETERMINAL_INFRA_FAILURE="1"; BENCH_EXIT="1"
                break
            fi
        fi
        # Transport errors and non-contract HTTP statuses are UNKNOWN, not proof
        # of death. The per-box barrier/run timeout remains the bounded detector.
        last_change="$now"
    fi
    # Bash defers a trap until a foreground child exits. Wait on the poll
    # sleep instead, so a cancellation reaches the EXIT trap at once and its
    # authenticated guest shutdown leaves while the status proxy is alive.
    sleep "$(( ${CLOUDBENCH_POLL_INTERVAL:-15} + (RANDOM % 6) ))" &
    POLL_SLEEP_PID=$!
    wait "$POLL_SLEEP_PID" 2>/dev/null || true
    POLL_SLEEP_PID=""
done

# Preserve the complete remote driver and service logs before the EXIT trap
# stops/destroys the machine. Console progress intentionally shows only a tail;
# these artifacts are the authoritative failure evidence.
# Cancellation produces its run record during shutdown. Spend the existing
# cleanup window before extracting artifacts, then drain the sealed log once.
# Keep TIMED_OUT set: a recovered cancellation record is still infrastructure
# failure. The EXIT trap reuses this result instead of granting another window.
# A pre-terminal infrastructure failure is the same situation: the driver may
# still be running, so request the bounded authenticated shutdown before
# waiting for a seal. Its verdict stays infrastructure failure either way.
if { [ "$TIMED_OUT" = "1" ] || [ "${PRETERMINAL_INFRA_FAILURE:-0}" = "1" ]; } \
    && [ -n "${FLEET_MACHINE_ID:-}" ]; then
    GUEST_SHUTDOWN_RESULT=1
    if confirm_guest_shutdown; then
        GUEST_SHUTDOWN_RESULT=0
        if [ "$TIMED_OUT" = "1" ] && cloudbench_collect_terminal_log; then
            FINISHED=1
            BENCH_EXIT="$CURRENT_TERMINAL_EXIT"
        fi
    fi
fi
mkdir -p "$OUT_DIR/remote-logs"
cp -f "$SSH_LOG" "$OUT_DIR/remote-logs/cloudbench-driver.log" 2>/dev/null || true
if [ "${CLOUDBENCH_BOOT_LAUNCH:-0}" = "1" ] && ! cloudbench_skip_held_driver_teardown_race; then
    if [ "$TIMED_OUT" = "1" ] && [ "${GUEST_SHUTDOWN_RESULT:-1}" != "0" ]; then
        echo "❌ timed-out guest shutdown unconfirmed; retaining runtime evidence owner -- infrastructure failure" >&2
        exit 70
    fi
    # Without a delivered shutdown nothing will seal the runtime evidence; do
    # not hold the job "running" for the wall-clock backstop. The EXIT trap
    # reuses GUEST_SHUTDOWN_RESULT and the fleet natively stops the guest.
    if [ "${PRETERMINAL_INFRA_FAILURE:-0}" = "1" ] && [ "${GUEST_SHUTDOWN_RESULT:-1}" != "0" ]; then
        echo "❌ guest shutdown unconfirmed after a pre-terminal infrastructure failure; retaining runtime evidence owner -- infrastructure failure" >&2
        exit 70
    fi
    # The driver waits for run.sh's stopped/clean receipt before ACK; the boot
    # supervisor then seals exited. Read raw logs only across that boundary,
    # through the existing data plane, before the EXIT trap destroys the guest.
    # Agent-filtered run JSON rows are capped and cannot replace these files.
    if ! cloudbench_collect_runtime_evidence "$OUT_DIR/remote-logs" "$LOCAL_STATUS_PORT" \
        "$RUN_LOG_TOKEN" "${FLEET_MACHINE_ID:-$mid}" \
        "${CLOUDBENCH_RUNTIME_EVIDENCE_SECONDS:-${BENCHMARK_WALL_CLOCK_BACKSTOP_SECONDS:-7200}}"
    then
        echo "❌ complete terminal runtime evidence could not be verified -- infrastructure failure" >&2
        # Keep the worker/stack logs of a failed stack teardown before the
        # EXIT trap retires the guest. Diagnostic only: the failure stands.
        cloudbench_collect_failed_runtime_evidence "$OUT_DIR/remote-logs" "$LOCAL_STATUS_PORT" \
            "$RUN_LOG_TOKEN" "${FLEET_MACHINE_ID:-$mid}" \
            "${CLOUDBENCH_FAILED_RUNTIME_EVIDENCE_SECONDS:-300}" \
            || echo "⚠️  failed-cleanup runtime evidence is unavailable (stack did not record a failed teardown)" >&2
        exit 70
    fi
fi
if [ "${CLOUDBENCH_BOOT_LAUNCH:-0}" != "1" ]; then
    for remote_log_name in stack.log services.json logs/backend.log logs/worker.log logs/research.log wmh-serve-log.txt guest-diagnostics.jsonl; do
        local_log_name="$(printf '%s' "$remote_log_name" | tr '/' '-')"
        ssh_read "$mid" "cat '$REMOTE_REPO/.context/cloudbench/$remote_log_name' 2>/dev/null" \
            > "$OUT_DIR/remote-logs/$local_log_name" 2>/dev/null || true
        [ -s "$OUT_DIR/remote-logs/$local_log_name" ] \
            || rm -f "$OUT_DIR/remote-logs/$local_log_name" 2>/dev/null || true
    done
fi

# ── 5. Retrieve report-card.json + newest runs/*.json directly from the box ──
# The bench.log already contains the report card / run record between markers as
# a fallback, but fetch the on-disk files directly for fidelity while the machine
# is still up (it is stopped by the EXIT trap AFTER this).
mkdir -p "$ROOT_DIR/.context"
CARD_OUT="$OUT_DIR/cloudbench-report-card.json"
RUN_OUT="$OUT_DIR/cloudbench-run.json"
RUN_CONTEXT_DIR="$OUT_DIR/cloudbench-runs/$RUN_WORKSPACE_NAME"
mkdir -p "$RUN_CONTEXT_DIR"
if [ "$NEEDS_IMESSAGE_RELAY" = "1" ] && [ -f "$IMESSAGE_RELAY_LOG" ]; then
    cp -f "$IMESSAGE_RELAY_LOG" "$RUN_CONTEXT_DIR/imessage-relay.log" 2>/dev/null || true
fi

if [ "${CLOUDBENCH_BOOT_LAUNCH:-0}" = "1" ]; then
    # The sealed runtime capture is already collected with exact ownership,
    # byte counts and hashes. Driver log transport can truncate a multi-MiB
    # JSON string, so terminal run records must come from that complete file.
    # Keep the marker path only for the existing held-driver teardown fixture.
    # Never re-enter Machines-API SSH after DONE.
    CARD_JSON="$(awk "/$REPORT_BEGIN/{f=1;next} /$REPORT_END/{f=0} f" "$SSH_LOG" 2>/dev/null)"
    if cloudbench_skip_held_driver_teardown_race; then
        RUN_JSON="$(awk "/$RESULT_BEGIN/{f=1;next} /$RESULT_END/{f=0} f" "$SSH_LOG" 2>/dev/null | grep -av '^run_file:')"
    else
        RUN_JSON="$(cat "$OUT_DIR/remote-logs/runtime-evidence/run.json")" || {
            echo "❌ sealed runtime result is unavailable -- infrastructure failure" >&2
            exit 70
        }
    fi
else
    CARD_JSON="$(ssh_read "$mid" "cat '$REMOTE_REPO/.context/cloudbench/report-card.json' 2>/dev/null" 2>/dev/null || true)"
    if [ -z "$CARD_JSON" ]; then
        CARD_JSON="$(awk "/$REPORT_BEGIN/{f=1;next} /$REPORT_END/{f=0} f" "$SSH_LOG" 2>/dev/null)"
    fi
    RUN_JSON="$(ssh_read "$mid" "cat '$REMOTE_REPO/.context/cloudbench/run.json' 2>/dev/null" 2>/dev/null || true)"
    if [ -z "$RUN_JSON" ]; then
        RUN_JSON="$(awk "/$RESULT_BEGIN/{f=1;next} /$RESULT_END/{f=0} f" "$SSH_LOG" 2>/dev/null | grep -av '^run_file:')"
    fi
fi

RUN_IDENTITY_OK="0"
if [ -n "$RUN_JSON" ]; then
    candidate_run="$(mktemp)"
    printf '%s\n' "$RUN_JSON" > "$candidate_run"
    validation_args=()
    for task_name in "${BENCH_TASKS[@]}"; do
        validation_args+=(--expected-task "$task_name")
    done
    expected_world_model_mode="real"
    [ "$BENCH_SIMULATE" = "1" ] && expected_world_model_mode="simulate"
    validation_args+=(--expected-world-model-mode "$expected_world_model_mode")
    if [ "${CLOUDBENCH_REQUIRE_EXECUTION_PROVENANCE:-0}" = "1" ]; then
        validation_args+=(
            --expected-execution-provenance-file "$CLOUDBENCH_EXECUTION_PROVENANCE_FILE"
        )
    fi
    if python3 "$CLOUDBENCH_RESULT_SCRIPT" "$candidate_run" "${validation_args[@]}"; then
        if [ "${CLOUDBENCH_BOOT_LAUNCH:-0}" = "1" ] && ! cloudbench_skip_held_driver_teardown_race; then
            if ! python3 - "$candidate_run" "$OUT_DIR/remote-logs/runtime-evidence/run.json" \
                "$OUT_DIR/runtime-evidence.pending" "$RUN_LOG_TOKEN" "${FLEET_MACHINE_ID:-$mid}" <<'PY'
import json
import os
import sys
from pathlib import Path
candidate, captured, pending, run_token, machine = sys.argv[1:]
assert json.loads(Path(candidate).read_bytes()) == json.loads(Path(captured).read_bytes()), "runtime evidence belongs to a different result"
intent = Path(pending)
for path in (intent, intent.with_name("runtime-evidence.owner.json")):
    assert path.is_file() and not path.is_symlink()
    assert json.loads(path.read_text()) == {"version": 1, "run_token": run_token, "machine_id": machine}
intent.unlink()
descriptor = os.open(intent.parent, os.O_RDONLY)
try:
    os.fsync(descriptor)
finally:
    os.close(descriptor)
PY
            then
                echo "❌ raw runtime evidence does not match the terminal result -- infrastructure failure" >&2
                exit 70
            fi
        fi
        RUN_IDENTITY_OK="1"
    else
        echo "❌ Rejected stale or mismatched cloud benchmark artifact."
        cp -f "$candidate_run" "$OUT_DIR/rejected-run.json" 2>/dev/null || true
        RUN_JSON=""
    fi
    rm -f "$candidate_run"
fi

echo ""
echo "════════════════════ REPORT CARD ════════════════════"
if [ -n "$CARD_JSON" ]; then
    echo "$CARD_JSON" | python3 -m json.tool 2>/dev/null || echo "$CARD_JSON"
    echo "$CARD_JSON" > "$CARD_OUT" 2>/dev/null && echo "" && echo "💾 Saved report card: $CARD_OUT"
    echo "$CARD_JSON" > "$RUN_CONTEXT_DIR/report-card.json" 2>/dev/null && echo "💾 Saved run-scoped report card: $RUN_CONTEXT_DIR/report-card.json"
    echo "$CARD_JSON" > "$OUT_DIR/report-card.json" 2>/dev/null || true
else
    echo "⚠️  No report card retrieved."
fi
echo "══════════════════════════════════════════════════════"

PASS_RATE=""
if [ -n "$RUN_JSON" ]; then
    echo "$RUN_JSON" > "$RUN_OUT" 2>/dev/null && echo "💾 Saved run record: $RUN_OUT"
    echo "$RUN_JSON" > "$RUN_CONTEXT_DIR/run.json" 2>/dev/null && echo "💾 Saved run-scoped record: $RUN_CONTEXT_DIR/run.json"
    echo "$RUN_JSON" > "$OUT_DIR/run.json" 2>/dev/null || true
    # The viewer is run-scoped and reaped on exit ("otherwise dead"). Opt in with
    # CLOUDBENCH_PERSIST_ARCHIVE=1 to leave a static archive up for post-run browsing;
    # otherwise re-spin one from the saved run.json when needed:
    #   python agents/benchmarks/archive_frontend.py .context/run.json \
    #     --frontend-dir front-end --context-dir .context --api-port <p> --frontend-port <p+1>
    if [ "${CLOUDBENCH_PERSIST_ARCHIVE:-0}" = "1" ]; then
        start_local_archive_frontend
    fi
    echo ""
    echo "──────────────────── RUN SUMMARY ────────────────────"
    PASS_RATE="$(python3 -c 'import json,sys
try:
    d=json.load(open(sys.argv[1]))
    s=d.get("summary",{})
    print(f"passed={s.get(\"passed\")} failed={s.get(\"failed\")} skipped={s.get(\"skipped\",0)} pass_rate={s.get(\"pass_rate\")} dur={s.get(\"total_duration_seconds\")}s cost_cents={s.get(\"total_cost_cents\")}")
    for t in d.get("tasks",[]):
        print(f"  task={t.get(\"name\")} passed={t.get(\"passed\")} mode={t.get(\"world_model_mode\")} dur={t.get(\"duration_seconds\")}s agent={t.get(\"agent_id\")}")
    print("PASS_RATE_VALUE=", s.get("pass_rate"))
except Exception as e:
    print("could not parse run json:", e)' "$RUN_OUT" 2>/dev/null | sed 's/^/   /')"
    echo "$PASS_RATE"
    echo "─────────────────────────────────────────────────────"
fi

echo ""
echo "🏁 benchmark exit code (run_benchmark.py --ci): ${BENCH_EXIT:-unknown}   (finished=$FINISHED, timed_out=$TIMED_OUT)"

OUTCOME_OK="0"
IMESSAGE_RELAY_OK="1"
if [ "$NEEDS_IMESSAGE_RELAY" = "1" ]; then
    IMESSAGE_RELAY_OK="0"
    if grep -q 'complete queue_id=' "$IMESSAGE_RELAY_LOG" 2>/dev/null; then
        IMESSAGE_RELAY_OK="1"
    else
        echo "❌ Missing confirmed completion from the local Mac iMessage relay." >&2
        tail -80 "$IMESSAGE_RELAY_LOG" 2>/dev/null | sed 's/^/   /' || true
    fi
fi
RUN_PASS_RATE="$(printf '%s' "$PASS_RATE" | grep -oE 'PASS_RATE_VALUE= [0-9.]+' | awk '{print $2}' || true)"
RUN_PASS_OK="0"
if [ "$RUN_IDENTITY_OK" = "1" ] && [ -s "$RUN_OUT" ]; then
    validation_args=()
    for task_name in "${BENCH_TASKS[@]}"; do
        validation_args+=(--expected-task "$task_name")
    done
    expected_world_model_mode="real"
    [ "$BENCH_SIMULATE" = "1" ] && expected_world_model_mode="simulate"
    validation_args+=(--expected-world-model-mode "$expected_world_model_mode")
    if [ "${CLOUDBENCH_REQUIRE_EXECUTION_PROVENANCE:-0}" = "1" ]; then
        validation_args+=(
            --expected-execution-provenance-file "$CLOUDBENCH_EXECUTION_PROVENANCE_FILE"
        )
    fi
    # Strict pass only: Claude Code credential SKIPs must not count as PASS.
    # (epoch-2 daily masked image-handling / files-in-sub-agents that way.)
    if python3 "$CLOUDBENCH_RESULT_SCRIPT" "$RUN_OUT" "${validation_args[@]}" --require-pass; then
        RUN_PASS_OK="1"
    fi
fi
cloudbench_outcome_ok
echo "🎯 result contract: identity=$RUN_IDENTITY_OK pass=$RUN_PASS_OK relay=$IMESSAGE_RELAY_OK benchmark_exit=${BENCH_EXIT:-unknown} (ok=$OUTCOME_OK)"

rm -f "$SSH_LOG" "$BENCH_LOG_CHUNK_FILE" "$BENCH_LOG_HEADERS_FILE" \
    "$BENCH_LOG_GENERATION_FILE" "$BENCH_LOG_PROGRESS_FILE" \
    "$BENCH_PROGRESS_STATE_FILE"

# stop_on_exit (EXIT trap) STOPS the machine (kept + volume retained) + kills the
# local dashboard proxy.
[ "$OUTCOME_OK" = "1" ] && exit 0
exit 1
