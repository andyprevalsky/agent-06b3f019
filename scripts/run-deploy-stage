#!/usr/bin/env bash
# Time one /deploy gate, tee its output, and append an atomic JSONL stage record.
set -uo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TIMING_SCRIPT="$ROOT_DIR/scripts/deploy_stage.py"
STAGE_RUNNER="$ROOT_DIR/scripts/run_deploy_stage.py"
RUN_ROOT="${DEPLOY_RUN_ROOT:-$ROOT_DIR/.context/deploy-runs}"
CURRENT_RUN_FILE="$RUN_ROOT/current"

usage() {
    echo "usage: scripts/run-deploy-stage --start [--run-id ID]" >&2
    echo "       scripts/run-deploy-stage STAGE [--reuse-passed] [--lane-scoped-reuse] -- COMMAND [ARG ...]" >&2
    echo "       scripts/run-deploy-stage --summary" >&2
    echo "       scripts/run-deploy-stage --finish" >&2
    echo "       scripts/run-deploy-stage --history" >&2
    echo "       scripts/run-deploy-stage --wait --since EPOCH [--timeout S] [--stall-seconds S] STAGE [STAGE ...]" >&2
}

if [ "${1:-}" = "--start" ]; then
    shift
    if [ "${1:-}" = "--run-id" ]; then
        [ "$#" -eq 2 ] || { usage; exit 2; }
        RUN_ID="$2"
    else
        [ "$#" -eq 0 ] || { usage; exit 2; }
        RUN_ID="$(date -u +%Y%m%d-%H%M%S)-$$"
    fi
    [[ "$RUN_ID" =~ ^[A-Za-z0-9._-]+$ ]] && [ "$RUN_ID" != "." ] && [ "$RUN_ID" != ".." ] || {
        echo "invalid deploy run id: $RUN_ID" >&2
        exit 2
    }
    RUN_DIR="$RUN_ROOT/$RUN_ID"
    if ! python3 "$TIMING_SCRIPT" lifecycle-start \
        --run-root "$RUN_ROOT" \
        --run-id "$RUN_ID" \
        --started-at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --started-epoch "$(python3 -c 'import time; print(time.time())')" \
        --git-sha "$(git rev-parse HEAD)" \
        --branch "$(git branch --show-current)"; then
        echo "failed to initialize deploy timing run" >&2
        exit 1
    fi
    echo "Deploy timing run: $RUN_ID"
    echo "Artifacts: $RUN_DIR"
    exit 0
fi

if [ "${1:-}" = "--history" ]; then
    [ "$#" -eq 1 ] || { usage; exit 2; }
    python3 "$TIMING_SCRIPT" history --run-root "$RUN_ROOT"
    exit $?
fi

if [ "${1:-}" = "--wait" ]; then
    # Event wake: block until the named stages write their finish receipts.
    shift
    [ "$#" -gt 0 ] || { usage; exit 2; }
    exec python3 "$ROOT_DIR/scripts/deploy_stage_wait.py" --run-root "$RUN_ROOT" "$@"
fi

if [ ! -f "$CURRENT_RUN_FILE" ]; then
    echo "no active deploy timing run; start one with: bash scripts/run-deploy-stage --start" >&2
    exit 2
fi
RUN_ID="$(sed -n '1p' "$CURRENT_RUN_FILE")"
[[ "$RUN_ID" =~ ^[A-Za-z0-9._-]+$ ]] && [ "$RUN_ID" != "." ] && [ "$RUN_ID" != ".." ] || {
    echo "invalid active deploy run id" >&2
    exit 2
}
RUN_DIR="$RUN_ROOT/$RUN_ID"

if [ "${1:-}" = "--summary" ]; then
    [ "$#" -eq 1 ] || { usage; exit 2; }
    python3 "$TIMING_SCRIPT" summary --run-dir "$RUN_DIR"
    exit $?
fi

if [ "${1:-}" = "--finish" ]; then
    [ "$#" -eq 1 ] || { usage; exit 2; }
    python3 "$TIMING_SCRIPT" lifecycle-finish \
        --run-root "$RUN_ROOT" \
        --run-id "$RUN_ID"
    FINALIZE_EXIT=$?
    python3 "$TIMING_SCRIPT" summary --run-dir "$RUN_DIR"
    SUMMARY_EXIT=$?
    if [ "$FINALIZE_EXIT" -ne 0 ]; then
        exit "$FINALIZE_EXIT"
    fi
    exit "$SUMMARY_EXIT"
fi

STAGE="${1:-}"
[[ "$STAGE" =~ ^[A-Za-z0-9._-]+$ ]] || { usage; exit 2; }
shift
REUSE_PASSED=""
LANE_SCOPED_REUSE=""
# Either flag, in any order, before the `--` separator.
while :; do
    case "${1:-}" in
        --reuse-passed) REUSE_PASSED="--reuse-passed"; shift ;;
        --lane-scoped-reuse) LANE_SCOPED_REUSE="--lane-scoped-reuse"; shift ;;
        *) break ;;
    esac
done
[ "${1:-}" = "--" ] || { usage; exit 2; }
shift
[ "$#" -gt 0 ] || { usage; exit 2; }
exec python3 "$STAGE_RUNNER" --run-root "$RUN_ROOT" $REUSE_PASSED $LANE_SCOPED_REUSE "$STAGE" -- "$@"
