#!/usr/bin/env bash
# Dispatch the catalog's Pre-Deploy selection through the production Benchmark
# Hub, execute it on the isolated cloud fleet, and require the visible Hub run
# to finish with every task passing.
#
# Task set comes from `agents/benchmarks/select_predeploy_benches.py` (same
# algorithm as `run-predeploy-local`, surface=cloud so local-only canaries are
# excluded) — existing smoke always; last-3-eligibility-pass gate for added
# canaries/path extras only (predeploy/worktree attempts excluded); then
# category floor + path-triggered depth, hard capped at 20.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"
SELECTOR_SCRIPT="$ROOT_DIR/agents/benchmarks/select_predeploy_benches.py"
PREDEPLOY_BENCH_CAP="${PREDEPLOY_BENCH_CAP:-20}"
# Hard ceiling — launchers document a max of 20; refuse env overrides that
# would silently expand the predeploy set beyond the scream budget.
if [ "$PREDEPLOY_BENCH_CAP" -gt 20 ]; then
    echo "⚠️  PREDEPLOY_BENCH_CAP=$PREDEPLOY_BENCH_CAP exceeds hard ceiling 20; clamping to 20" >&2
    PREDEPLOY_BENCH_CAP=20
fi

read_predeploy_selection() {
    local format="${1:-names-and-report}"
    PREDEPLOY_BENCH_CAP="$PREDEPLOY_BENCH_CAP" \
        python3 "$SELECTOR_SCRIPT" \
            --catalog "$ROOT_DIR/agents/benchmarks/tasks.json" \
            --surface cloud \
            --cap "$PREDEPLOY_BENCH_CAP" \
            --format "$format" \
            --repo-root "$ROOT_DIR"
}

read_predeploy_tasks() {
    read_predeploy_selection names
}

if [ "${1:-}" = "--list" ]; then
    read_predeploy_tasks
    exit 0
fi
if [ "$#" -ne 0 ]; then
    echo "usage: scripts/run-predeploy-cloud [--list]" >&2
    exit 2
fi

PREDEPLOY_TASKS=()
SELECTION_OUTPUT="$(read_predeploy_selection names-and-report)"
printf '%s\n' "$SELECTION_OUTPUT"
while IFS= read -r task; do
    [ -n "$task" ] && PREDEPLOY_TASKS+=("$task")
done < <(
    printf '%s\n' "$SELECTION_OUTPUT" \
        | sed -n '/^---PREDEPLOY_BENCH_NAMES---$/,/^---END_PREDEPLOY_BENCH_NAMES---$/p' \
        | sed '1d;$d'
)
[ "${#PREDEPLOY_TASKS[@]}" -gt 0 ] || { echo "no predeploy benchmark tasks selected" >&2; exit 1; }
if [ "${#PREDEPLOY_TASKS[@]}" -ge "$PREDEPLOY_BENCH_CAP" ]; then
    echo "🚨 PREDEPLOY BENCH COUNT AT HARD CAP: ${#PREDEPLOY_TASKS[@]}/$PREDEPLOY_BENCH_CAP" >&2
fi

run_predeploy_stage() {
    local label="$1"
    shift
    printf '::rca-stage::%s\n' "$label"
    "$@"
}

echo "🧪 Verifying concurrent cloud benchmark workstream isolation..."
run_predeploy_stage "cloud benchmark environment contract" \
    bash "$ROOT_DIR/scripts/tests/cloudbench-env.test.sh"
run_predeploy_stage "mandatory autoscale contract" \
    bash "$ROOT_DIR/scripts/tests/cloudbench-acceptance-autoscale.test.sh"
run_predeploy_stage "focused cloud lifecycle regression" \
    "$ROOT_DIR/agents/venv/bin/python" -m pytest -q \
    "$ROOT_DIR/agents/benchmarks/cloudbench_dependency_sync_test.py" \
    -k 'data_plane_proxies_retry_machine_dns_and_restart_if_lost or status_polled_over_data_plane_proxy_not_ssh or cloud_runner_avoids_live_run_port_collisions or fleet_barrier_reads_the_authoritative_rotated_status_port or production_only_cloud_route'
run_predeploy_stage "cloud multi-workstream concurrency regression" \
    bash "$ROOT_DIR/scripts/tests/cloudbench-multi-workstream.test.sh"

# Opt-in digest-bound SUSPENDED warm pool (scripts/cloudbench-warm-pool.py).
# Reports how many pool members match the donor's current image digest and
# this checkout's dependency fingerprint plus the pool's idle cost, and hands
# the pool name to the fleet. Off by default. The consumption boundary is
# `cloudbench-warm-pool.py claim --out <bench-out>` (resume + health/digest
# checks + `<bench-out>/warm-pool-claim.json`, `transport: running-guest`,
# exit 3 = no match → clone) and `release <id> --out <bench-out>` (re-suspend
# healthy members, destroy the rest); both are regression-tested offline in
# scripts/tests/cloudbench-warm-pool.test.py. The fleet's per-run boot-config
# transport (machine update + cold boot) still restarts a resumed member, so
# the memory-snapshot saving is realized only once provision_primary_machine
# in scripts/run-bench-fleet consumes that claim receipt with a running-guest
# transport in scripts/run-bench-cloud (CLOUDBENCH_BOOT_TRANSPORT=warm-resume).
if [ -n "${DEPLOY_WARM_POOL_NAME:-}" ]; then
    printf '::rca-stage::%s\n' "deploy warm pool status"
    mkdir -p "$ROOT_DIR/.context/predeploy-runs"
    if "$ROOT_DIR/agents/venv/bin/python" "$ROOT_DIR/scripts/cloudbench-warm-pool.py" status \
        --pool "$DEPLOY_WARM_POOL_NAME" --receipt "$ROOT_DIR/.context/predeploy-runs/warm-pool-status.json"; then
        export CLOUDBENCH_WARM_POOL_NAME="$DEPLOY_WARM_POOL_NAME"
    else
        echo "⚠️  warm pool status unavailable; the fleet clones as usual" >&2
    fi
fi

HUB_URL="${HUB_URL:-https://navi-j9a9.onrender.com}"
HUB_USER_ID="${HUB_USER_ID:-1f85ff25-6e29-4c1b-8739-f917bd101a30}"
HUB_POLLER_BIN="${HUB_POLLER_BIN:-$ROOT_DIR/scripts/run-bench-hub-poller}"
printf '::rca-stage::%s\n' "Benchmark Hub credentials"
if [ -z "${BACKEND_API_KEY:-}" ]; then
    BACKEND_API_KEY="$(grep -E '^BACKEND_API_KEY=' "$ROOT_DIR/back-end/.env" 2>/dev/null | head -1 | cut -d= -f2- | tr -d '\"')"
fi
[ -n "${BACKEND_API_KEY:-}" ] || { echo "BACKEND_API_KEY not found" >&2; exit 1; }

head_sha="$(git rev-parse --short HEAD)"
scope="deploy-predeploy-${head_sha}-$(date -u +%Y%m%d%H%M%S)-$$"
payload="$(python3 - "$scope" "${PREDEPLOY_TASKS[@]}" <<'PY'
import json
import sys

print(json.dumps({"scope": sys.argv[1], "task_names": sys.argv[2:]}))
PY
)"

printf '::rca-stage::%s\n' "Benchmark Hub request submission"
response="$(curl -fsS -X POST "$HUB_URL/api/benchmarks/run-requests" \
    -H "X-API-Key: $BACKEND_API_KEY" \
    -H "X-User-Id: $HUB_USER_ID" \
    -H "Content-Type: application/json" \
    -d "$payload")"
read -r request_id run_id < <(printf '%s' "$response" | python3 -c '
import json, sys
request = json.load(sys.stdin)["request"]
print(request["id"], request["runId"])
')
[ -n "$request_id" ] && [ -n "$run_id" ] || { echo "Hub did not return a linked run" >&2; exit 1; }

echo "☁️  Pre-Deploy cloud request: $request_id"
echo "📊 Benchmarks → Runs: $run_id"
echo "🧪 Tasks (${#PREDEPLOY_TASKS[@]}): ${PREDEPLOY_TASKS[*]}"

# The Hub poller launches the cloud fleet with --wait: the actual fleet is in
# its own session, while the poller waits on an atomic exit-status rendezvous.
# SIGKILL/session reclamation of this predeploy process therefore cannot bypass
# fleet cleanup. For cooperative SIGINT/SIGTERM, still walk the descendant tree
# so cleanup starts immediately instead of leaving the detached run to finish.
_kill_descendants() {
    local pid="$1" child
    for child in $(pgrep -P "$pid" 2>/dev/null); do _kill_descendants "$child"; done
    kill -TERM "$pid" 2>/dev/null || true
}
POLLER_PID=""
_teardown_poller() {
    [ -n "$POLLER_PID" ] || return 0
    _kill_descendants "$POLLER_PID"
    for _ in $(seq 1 45); do kill -0 "$POLLER_PID" 2>/dev/null || break; sleep 1; done
}
trap '_teardown_poller; exit 130' INT
trap '_teardown_poller; exit 143' TERM

printf '::rca-stage::%s\n' "Benchmark Hub cloud fleet execution"
HUB_URL="$HUB_URL" \
HUB_USER_ID="$HUB_USER_ID" \
BACKEND_API_KEY="$BACKEND_API_KEY" \
HUB_CLAIM_SCOPE="$scope" \
HUB_SKIP_CATALOG_EXPORT=1 \
BENCHMARK_CLAUDE_CODE_CACHE_RATCHET_WARN_ONLY=1 \
BENCHMARK_ATTEMPT_SUITE=predeploy \
BENCHMARK_COUNTS_FOR_DEPLOY_ELIGIBILITY=0 \
"$HUB_POLLER_BIN" --once &
POLLER_PID=$!
wait "$POLLER_PID"
trap - INT TERM

printf '::rca-stage::%s\n' "Benchmark Hub result verification"
final="$(curl -fsS "$HUB_URL/api/benchmarks/runs/$run_id" \
    -H "X-API-Key: $BACKEND_API_KEY" \
    -H "X-User-Id: $HUB_USER_ID")"
mkdir -p "$ROOT_DIR/.context/predeploy-runs"
printf '%s\n' "$final" > "$ROOT_DIR/.context/predeploy-runs/$request_id.json"
python3 - "$ROOT_DIR/.context/predeploy-runs/$request_id.json" "${PREDEPLOY_TASKS[@]}" <<'PY'
import json
import sys

expected = sys.argv[2:]
with open(sys.argv[1]) as handle:
    payload = json.load(handle)
run = payload.get("run") or {}
dispatch = run.get("dispatch") or {}
tasks = run.get("tasks") or []
by_name = {task.get("name"): task for task in tasks}

errors = []
if dispatch.get("status") != "completed":
    errors.append(f"dispatch status={dispatch.get('status')!r}")
if set(by_name) != set(expected):
    errors.append(f"task set mismatch: expected={expected!r} actual={list(by_name)!r}")
for name in expected:
    task = by_name.get(name) or {}
    if task.get("passed") is not True or task.get("status") != "passed":
        errors.append(f"{name}: status={task.get('status')!r} passed={task.get('passed')!r}")
if errors:
    print("Pre-Deploy cloud gate failed:", file=sys.stderr)
    for error in errors:
        print(f"- {error}", file=sys.stderr)
    raise SystemExit(1)

print(f"✅ Pre-Deploy cloud gate: {len(expected)}/{len(expected)} passed")
for name in expected:
    task = by_name[name]
    duration = task.get("duration_seconds")
    suffix = f" ({duration:.1f}s)" if isinstance(duration, (int, float)) else ""
    print(f"   ✅ {name}{suffix}")
PY
