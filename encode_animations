#!/usr/bin/env bash

set -euo pipefail

# encode_animations
# Usage: ./encode_animations /absolute/path/to/base
# Example:
#   ./encode_animations /Users/you/project/public/navi-conversations-animation
#
# This will look for:
#   /Users/you/project/public/navi-conversations-animation-master.mov
#   /Users/you/project/public/navi-conversations-animation-hevc.mov
#
# And produce:
#   /Users/you/project/public/navi-conversations-animation.webm  (VP9 + alpha preserved)
#   /Users/you/project/public/navi-conversations-animation.mp4   (HEVC rewrapped, hvc1)

if ! command -v ffmpeg >/dev/null 2>&1; then
  echo "Error: ffmpeg is not installed or not in PATH." >&2
  exit 1
fi

if [[ $# -ne 1 ]]; then
  echo "Usage: $0 /absolute/path/to/base (without -master or -hevc)" >&2
  exit 1
fi

BASE_PATH="$1"

# Normalize path (resolve to absolute if relative was provided)
if [[ "$BASE_PATH" != /* ]]; then
  BASE_PATH="$(cd "$(dirname "$BASE_PATH")" && pwd)/$(basename "$BASE_PATH")"
fi

MASTER_INPUT="${BASE_PATH}-master.mov"
HEVC_INPUT="${BASE_PATH}-hevc.mov"
WEBM_OUTPUT="${BASE_PATH}.webm"
MP4_OUTPUT="${BASE_PATH}.mp4"

if [[ ! -f "$MASTER_INPUT" ]]; then
  echo "Error: master input not found: $MASTER_INPUT" >&2
  exit 1
fi

if [[ ! -f "$HEVC_INPUT" ]]; then
  echo "Error: HEVC input not found: $HEVC_INPUT" >&2
  echo "Aborting per requirement: no -hevc file present." >&2
  exit 1
fi

echo "Encoding WebM VP9 (preserve alpha, same resolution) from: $MASTER_INPUT"
# Notes:
# - libvpx-vp9 supports alpha via yuva420p. Disable alt-ref for alpha support.
# - Not specifying scale keeps source resolution.
ffmpeg -y -hide_banner -loglevel error \
  -i "$MASTER_INPUT" \
  -vf format=yuva420p \
  -c:v libvpx-vp9 \
  -pix_fmt yuva420p \
  -auto-alt-ref 0 \
  -b:v 0 -crf 28 -row-mt 1 \
  "$WEBM_OUTPUT"

echo "Rewrapping HEVC to MP4 with hvc1 tag from: $HEVC_INPUT"
ffmpeg -y -hide_banner -loglevel error \
  -i "$HEVC_INPUT" \
  -c:v copy \
  -tag:v hvc1 \
  -movflags +faststart \
  "$MP4_OUTPUT"

echo "Done. File sizes:"

# Print sizes for all files matching the provided base path pattern
BASE_DIR="$(dirname "$BASE_PATH")"
BASE_NAME="$(basename "$BASE_PATH")"

shopt -s nullglob
MATCHES=("$BASE_DIR/$BASE_NAME".*)
if (( ${#MATCHES[@]} )); then
  ls -lh "${MATCHES[@]}"
else
  echo "No files matched: $BASE_DIR/$BASE_NAME.*"
fi

