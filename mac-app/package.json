{
  "name": "rose-desktop",
  "productName": "Rose",
  "version": "1.1.34",
  "engines": {
    "node": "20.10.0"
  },
  "description": "Rose - Integration Data Uploader",
  "repository": {
    "type": "git",
    "url": "https://github.com/andyprevalsky/navi-whisper-lux.git"
  },
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "MAC_APP_PORT=${MAC_APP_PORT:-5174} && tsc -p tsconfig.main.json && concurrently \"tsc -p tsconfig.main.json --watch\" \"vite\" \"wait-on http://localhost:$MAC_APP_PORT && electron .\"",
    "build": "vite build && tsc -p tsconfig.main.json && electron-builder",
    "build:vite": "vite build && tsc -p tsconfig.main.json",
    "postinstall": "node -e \"const v=require('electron/package.json').version;require('child_process').execSync('npx --yes node-gyp rebuild --target='+v+' --arch='+process.arch+' --dist-url=https://electronjs.org/headers',{cwd:'node_modules/better-sqlite3',stdio:'inherit'})\"",
    "type-check": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "map-domains": "tsx scripts/map-domains.ts",
    "test": "vitest run",
    "test:structural": "tsx tests/structural/layer-deps.test.ts",
    "test:watch": "vitest",
    "test:blackbox": "bash scripts/run-blackbox-tests.sh"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/supabase-js": "^2.38.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.90.11",
    "@whiskeysockets/baileys": "^6.7.17",
    "better-sqlite3": "^11.10.0",
    "bplist-parser": "^0.3.2",
    "class-variance-authority": "^0.7.1",
    "classic-level": "^1.4.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7",
    "glob": "^13.0.3",
    "lucide-react": "^0.263.1",
    "node-mac-contacts": "^1.7.2",
    "puppeteer-core": "^24.36.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.9.6",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/dotenv": "^6.1.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/ui": "2.1.9",
    "autoprefixer": "^10.4.14",
    "concurrently": "^8.2.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.9.1",
    "electron-reloader": "^1.2.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "25.0.1",
    "msw": "2.13.4",
    "postcss": "^8.4.24",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.1",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.57.2",
    "vite": "^5.0.0",
    "vitest": "2.1.9",
    "wait-on": "^7.2.0"
  },
  "overrides": {
    "node-mac-contacts": {
      "node-addon-api": "^8.0.0"
    }
  },
  "build": {
    "appId": "com.rose.desktop",
    "productName": "Rose",
    "artifactName": "${productName}-mac.${ext}",
    "afterSign": "scripts/notarize.js",
    "afterAllArtifactBuild": "scripts/staple-dmg.js",
    "protocols": {
      "name": "Rose",
      "schemes": [
        "roselabs"
      ]
    },
    "publish": {
      "provider": "generic",
      "url": "https://kzlurqihzaolhzsbkctf.supabase.co/storage/v1/object/public/Releases/mac/latest"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icons/app.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "identity": "Rose Ai Labs, Inc. (P3HATASMP9)",
      "notarize": false
    },
    "files": [
      "dist/main/**/*",
      "dist/ui/**/*",
      "assets/**/*",
      "package.json",
      ".env.production"
    ]
  }
}
