          "FindAllTool": {
            "description": "Tool for discovering entities on the open internet matching specific criteria using natural language queries.\n\nThis tool uses Parallel AI's Find All API to search for entities (companies, people, etc.)\nthat match your criteria. The API converts your natural language objective into structured\nmatch conditions and returns matched candidates with details, reasoning, and citations.\n\nPricing: Total cost = fixed cost + (cost per match \u00d7 number of matches)\n- preview: $0.15 fixed + $0.00/match (testing only, ~10 candidates)\n- base: $0.25 fixed + $0.03/match (broad queries, many matches expected)\n- core: $2.00 fixed + $0.15/match (specific queries, moderate matches) [DEFAULT]\n- pro: $10.00 fixed + $1.00/match (highly specific, rare matches)\n\nExample: \"Find all portfolio companies of Khosla Ventures founded after 2020\"",
            "properties": {
              "tool": {
                "const": "find_all",
                "title": "Tool",
                "type": "string"
              },
              "objective": {
                "description": "Natural language description of entities to find. Be specific about criteria, sources, and context. Examples: 'Find all portfolio companies of Khosla Ventures founded after 2020', 'Find all AI startups in San Francisco that raised Series A in 2024'. Maximum 5000 characters. TIP: Start with 'preview' generator to test your query and estimate match count before running full search.",
                "maxLength": 5000,
                "title": "Objective",
                "type": "string"
              },
              "generator": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/GeneratorEnum"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": "core",
                "description": "Generator type determining quality and cost. Choose based on query specificity and expected match count:\n- 'preview' ($0.15 fixed, $0/match): Testing queries with ~10 candidates. Always test here first.\n- 'base' ($0.25 fixed, $0.03/match): Broad queries expecting many matches (e.g., 'companies in healthcare'). Best for <20 matches where low fixed cost matters.\n- 'core' ($2.00 fixed, $0.15/match) [DEFAULT]: Specific queries with moderate matches (e.g., 'healthcare companies using AI for diagnostics'). Best for 20-50 matches.\n- 'pro' ($10.00 fixed, $1.00/match): Highly specific queries with rare matches (e.g., 'Series A healthcare AI companies with FDA-approved products'). Best when you need the most thorough search.\nNote: For >50 matches, per-match cost dominates. Consider generator choice carefully."
              },
              "match_limit": {
                "anyOf": [
                  {
                    "maximum": 100,
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": 10,
                "description": "Maximum number of matched entities to return. Range: 1-100. Default: 10. Cost impact: Higher limits increase total cost (fixed cost + per-match cost \u00d7 matches found). Example costs for 50 matches: base=$1.75, core=$9.50, pro=$60.00. Consider using 'preview' generator first to estimate match count.",
                "title": "Match Limit"
              }
            },
            "required": [
              "tool",
              "objective",
              "generator",
              "match_limit"
            ],
            "title": "FindAllTool",
            "type": "object",
            "additionalProperties": false
          },
          "GeneratorEnum": {
            "description": "Generator types for Find All operations with pricing.",
            "enum": [
              "preview",
              "base",
              "core",
              "pro"
            ],
            "title": "GeneratorEnum",
            "type": "string"
          },
