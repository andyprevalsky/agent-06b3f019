              "message": {
                "description": "User-visible markdown text explaining the question, blocker, or FYI.",
                "title": "Message",
                "type": "string"
              },
              "is_question": {
                "default": true,
                "description": "True to block workflow until the user responds (clarification/approval). False to send a non-blocking FYI (e.g., sharing the plan).",
                "title": "Is Question",
                "type": "boolean"
              }
            },
