          "SetPlanTool": {
            "description": "Set or update the execution plan using the two-axis planning framework.\n\nPlanning operates on two orthogonal axes:\n1. Reducing uncertainty (ambiguity, unknown constraints, unknown strategy)\n2. Reducing remaining work (executing known steps once the world is understood)\n\nUse explicit dependency graph to define execution order.",
            "properties": {
              "tool": {
                "const": "set_plan",
                "title": "Tool",
                "type": "string"
              },
              "title": {
                "description": "Short title for the plan.",
                "title": "Title",
                "type": "string"
              },
              "content": {
                "description": "Plan content as markdown text.",
                "title": "Content",
                "type": "string"
              },
              "tasks": {
                "description": "List of task descriptions. Index position defines task ID (0, 1, 2...).",
                "items": {
                  "type": "string"
                },
                "title": "Tasks",
                "type": "array"
              },
              "dependencies": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "REQUIRED for sequential/causally-dependent tasks. Task dependency graph where keys are task indices (as strings) and values are predecessor indices that must complete first. ONLY use null/{} for truly independent parallel tasks. Sequential chain: {'1': ['0'], '2': ['1'], '3': ['2']}. Fan-in: {'3': ['0', '1', '2']}.",
                "title": "Dependencies"
              },
              "join": {
                "description": "How to combine task results:\n- 'all' (AND): All tasks must complete; results are merged.\n- 'any' (OR): First successful task satisfies the goal.\nUse 'any' when uncertainty > decomposability (hypotheses). Use 'all' when decomposability >= uncertainty.",
                "enum": [
                  "all",
                  "any"
                ],
                "title": "Join",
                "type": "string"
              }
            },
            "required": [
              "tool",
              "title",
              "content",
              "tasks",
              "dependencies",
              "join"
            ],
            "title": "SetPlanTool",
            "type": "object",
            "additionalProperties": false
          },
