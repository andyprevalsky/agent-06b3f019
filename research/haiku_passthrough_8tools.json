          "SearchX402BazaarTool": {
            "description": "Search the x402 Bazaar for available paid API services.\n\nThe x402 Bazaar is a discovery layer for paid APIs using the x402 protocol.\nReturns a list of available services with their pricing, capabilities, and schemas.\nUse this to find services that can help accomplish tasks, then use pay_for_x402_bazaar_service to call them.\n\nNOTE: Our own services are automatically filtered out to prevent self-calls.",
            "properties": {
              "tool": {
                "const": "search_x402_bazaar",
                "title": "Tool",
                "type": "string"
              },
              "max_price_cents": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Maximum price in cents willing to pay per API call. Services costing more than this will be filtered out. Example: 100 = $1.00, 50 = $0.50, 10 = $0.10",
                "title": "Max Price Cents"
              },
              "keyword": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Optional keyword to filter services by description or resource URL. Examples: 'weather', 'price', 'news', 'data'",
                "title": "Keyword"
              }
            },
            "required": [
