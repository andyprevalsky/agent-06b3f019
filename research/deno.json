{
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true,
    "proseWrap": "preserve",
    "semiColons": true,
    "include": [
      "supabase/functions/",
      "benchmarks/",
      "domains/",
      "providers/",
      "utils/",
      "shared/",
      "scripts/",
      "tests/",
      "domains/",
      "providers/",
      "utils/"
    ],
    "exclude": [
      "node_modules/",
      "browser-use-repo/"
    ]
  },
  "lint": {
    "include": [
      "supabase/functions/",
      "benchmarks/",
      "domains/",
      "providers/",
      "utils/",
      "shared/",
      "scripts/",
      "tests/",
      "domains/",
      "providers/",
      "utils/"
    ],
    "exclude": [
      "node_modules/",
      "browser-use-repo/"
    ],
    "rules": {
      "tags": ["recommended"],
      "include": [
        "ban-untagged-todo",
        "no-throw-literal",
        "no-eval",
        "eqeqeq",
        "guard-for-in",
        "no-self-compare"
      ],
      "exclude": [
        "no-explicit-any"
      ]
    }
  }
}
